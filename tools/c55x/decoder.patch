+template<size_t N> void substitute(char (&string)[N], const char *token, const char *fmt, ...) {
+ char replacement[1024];va_list args;va_start(args,fmt);
+ int n=vsnprintf(replacement,sizeof(replacement),fmt,args);va_end(args);
+ if(n<0 || (size_t)n>=sizeof(replacement)){fprintf(stderr,"replacement bounds\n");exit(6);}
+ std::string result(string);size_t cursor=0;
+ while((cursor=result.find(token,cursor))!=std::string::npos){
+  result.replace(cursor,strlen(token),replacement);cursor+=strlen(replacement);
+ }
+ if(result.size()>=N){fprintf(stderr,"syntax bounds\n");exit(7);}
+ memcpy(string,result.c_str(),result.size()+1);
 }
 
