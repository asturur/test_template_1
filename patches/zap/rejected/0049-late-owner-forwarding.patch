+// Compare and prioritize BOTH physical owners before selecting the active one.
+// The read pointer must not precede source matching or priority resolution.
+// Bit16 is the RF fallback, also resolved before owner selection. Shared live
+// producer/commit words feed one wide datapath per operand after this narrow mux.
+genvar forward_port;
+generate
+        for (forward_port = 0; forward_port < 4; forward_port = forward_port + 1)
+        begin : g_owner_forward
+                assign owner0_match[forward_port] = get_source_match(
+                        operand_slot0_index[6*forward_port +: 6],
+                        operand_slot0_pending[3*forward_port +: 3],
+                        operand_slot0_control[CONTROL_W-16+4*forward_port +: 4]);
+                assign owner1_match[forward_port] = get_source_match(
+                        operand_slot1_index[6*forward_port +: 6],
+                        operand_slot1_pending[3*forward_port +: 3],
+                        operand_slot1_control[CONTROL_W-16+4*forward_port +: 4]);
+                assign owner0_select[forward_port] = prioritize_source(owner0_match[forward_port]);
+                assign owner1_select[forward_port] = prioritize_source(owner1_match[forward_port]);
+                assign operand_select[forward_port] = operand_read_slot ?
+                        owner1_select[forward_port] : owner0_select[forward_port];
+        end
+endgenerate
+
+assign o_alu_source_value_nxt = get_register_value(
+        operand_alu_source_ff[31:0], operand_select[0], operand_rd_data_0,
+        operand_pc_plus_8_ff, operand_force32align_ff);
+assign o_shift_source_value_nxt = get_register_value(
+        operand_shift_source_ff[31:0], operand_select[1], operand_rd_data_1,
+        operand_pc_plus_8_ff, 1'd0);
+assign o_shift_length_value_nxt = get_register_value(
+        operand_shift_length_ff[31:0], operand_select[2], operand_rd_data_2,
