+                     (o_data_wb_cyc && o_data_wb_stb && o_data_wb_we))) |
                    (o_instr_wb_stb & o_instr_wb_cyc & ~i_instr_wb_ack);
 
 assign o_data_wb_adr_check =  {postalu1_address_ff[31:2], 2'd0};
