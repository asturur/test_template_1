-//
-// TLB management unit for the ZAP processor. The TLB units use single cycle
-// clearing memories since TLBs are shallow.
-//
-
-
-module zap_tlb #(
-
-parameter logic [31:0] LPAGE_TLB_ENTRIES   = 32'd8,
-parameter logic [31:0] SPAGE_TLB_ENTRIES   = 32'd8,
-parameter logic [31:0] SECTION_TLB_ENTRIES = 32'd8,
-parameter logic [31:0] FPAGE_TLB_ENTRIES   = 32'd8,
-parameter logic [31:0] CPSR_MODE           = 32'd4
-
-) (
-
-// Clock and reset.
-input   logic            i_clk,
-input   logic            i_reset,
-
-// From cache FSM (processor)
-input   logic    [31:0]  i_address,
-input   logic    [31:0]  i_address_check,
-input   logic            i_wr_check,
-input   wire             i_request_rd,
-input   wire             i_request_wr,
-input   logic            i_rd_check,
-input   logic    [31:0]  i_address_nxt,
-
-// Hold input
-input   logic            i_hold,
-
-// CPSR, SR, DAC register.
-input   logic    [CPSR_MODE:0] i_cpsr,
-input   logic    [1:0]   i_sr,
-input   logic    [31:0]  i_dac_reg,
-input   logic    [31:0]  i_baddr,
-
-// From CP15.
-input   logic            i_mmu_en,
-input   logic            i_inv,
-
-// To cache FSM.
-output  logic    [31:0]  o_phy_addr,
-output  logic    [7:0]   o_fsr,
-output  logic    [7:0]   o_external_fsr,
-output  logic    [31:0]  o_far,
-output  logic            o_fault,
-output  logic            o_bufferable,
-output  logic            o_cacheable,
-output  logic            o_busy,
-output  logic            o_walk_pending,
-output  wire             o_lookup_wait,
-output  logic [31:0] o_checked_va, o_checked_lookup,
-output  logic o_checked_rd, o_checked_wr, o_checked_mmu,
-output  logic [CPSR_MODE:0] o_checked_cpsr,
-output  logic [1:0] o_checked_sr,
-output  logic [31:0] o_checked_dac, o_checked_baddr,
-input   logic            i_idle,
-
-// Wishbone memory interface - Needs to go through some OR gates.
-output logic             o_wb_stb_nxt,
-output logic             o_wb_cyc_nxt,
-output logic [31:0]      o_wb_adr_nxt,
-output logic             o_wb_wen_nxt,
-output logic [3:0]       o_wb_sel_nxt,
-input  logic [31:0]      i_wb_dat,
-output logic [31:0]      o_wb_dat_nxt,
-input  logic             i_wb_ack,
-input  logic             i_wb_err
-
-);
-
-// ----------------------------------------------------------------------------
-
-assign o_wb_dat_nxt = 32'd0;
-
-`include "zap_localparams.svh"
-`include "zap_defines.svh"
-
-logic [`ZAP_SECTION_TLB_WDT-1:0]     setlb_wdata, setlb_rdata, setlb_rdata_pre;
-logic [`ZAP_LPAGE_TLB_WDT-1:0]       lptlb_wdata, lptlb_rdata, lptlb_rdata_pre;
-logic [`ZAP_SPAGE_TLB_WDT-1:0]       sptlb_wdata, sptlb_rdata, sptlb_rdata_pre;
-logic [`ZAP_FPAGE_TLB_WDT-1:0]       fptlb_wdata, fptlb_rdata, fptlb_rdata_pre;
-
-logic                            sptlb_wen, lptlb_wen, setlb_wen;
-logic                            sptlb_ren, lptlb_ren, setlb_ren;
-logic                            sptlb_ren_pre, lptlb_ren_pre, setlb_ren_pre;
-logic                            fptlb_ren, fptlb_ren_pre, fptlb_wen;
-logic                            walk;
-logic [7:0]                      fsr;
-logic [31:0]                     far;
-logic                            cacheable, bufferable;
-logic [31:0]                     phy_addr;
-logic [31:0]                     tlb_address;
-logic                            u0, u1, u2, u3, u4, u5;
-logic                            unused;
-
-// The checker and RAM result are registered independently of the current
-// request. A miss or fault may be consumed only by its owning address/context.
-// Recovery clocks the existing lookup stages even when the CPU is stalled;
-// no RAM/check stage is removed to shorten the miss handshake.
-logic walk_active;
-logic [1:0] refill_settle;
-wire result_owned = o_checked_va[31:10] == i_address[31:10] &&
-                    o_checked_lookup[31:10] == i_address[31:10] &&
-                    o_checked_mmu == i_mmu_en && o_checked_cpsr == i_cpsr &&
-                    o_checked_sr == i_sr && o_checked_dac == i_dac_reg &&
-                    o_checked_baddr == i_baddr && o_checked_rd == i_request_rd &&
-                    o_checked_wr == i_request_wr;
-wire install = setlb_wen || lptlb_wen || sptlb_wen || fptlb_wen;
-logic walk_was_active, walk_cancelled;
-logic [31:0] walk_baddr;
-wire accept_install = !walk_cancelled && !i_inv && i_mmu_en && walk_baddr == i_baddr;
-always_ff @(posedge i_clk) begin
-    if (i_reset) begin
-        walk_was_active <= 0;
-        walk_cancelled <= 0;
-        walk_baddr <= 0;
-    end else begin
-        walk_was_active <= walk_active;
-        if (walk_active && !walk_was_active) begin
-            walk_baddr <= i_baddr;
-            walk_cancelled <= i_inv || !i_mmu_en;
-        end else if (walk_active && (i_inv || !i_mmu_en || walk_baddr != i_baddr)) begin
-            walk_cancelled <= 1;
-        end
-    end
-end
-wire result_ready = result_owned && refill_settle == 0 && !i_inv;
-wire recover_lookup = i_mmu_en && i_idle && !walk_active && !result_ready;
-wire lookup_enable = !i_hold || recover_lookup || install || refill_settle != 0;
-wire [31:0] lookup_address = recover_lookup ? i_address : i_address_nxt;
-wire [31:0] check_address = recover_lookup ? i_address : i_address_check;
-wire walker_idle = i_idle && (!i_mmu_en || result_ready);
-
-always_ff @(posedge i_clk) begin
-    if (i_reset) refill_settle <= 0;
-    else if (install || i_inv) refill_settle <= 3;
-    else if (lookup_enable && refill_settle != 0) refill_settle <= refill_settle - 1'b1;
-end
-
-// The checked permission is valid throughout its 1KiB subpage. Reusing that
-// token for adjacent instructions preserves the resident one-clock fetch path.
-assign o_phy_addr = i_mmu_en ? {phy_addr[31:10], i_address[9:0]} : i_address;
-assign o_lookup_wait = i_mmu_en && i_idle && !result_ready;
-assign o_busy = walk_active || o_lookup_wait;
-
-// ----------------------------------------------------------------------------
-
-function automatic [31:0] max ( input [31:0] a, b, c, d );
-             if ( a >= b && a >= c && a >= d )                max = a;
-        else if ( b >= a && b >= c && b >= d )                max = b;
-        else if ( c >= a && c >= b && c >= d )                max = c;
-        else                                                  max = d;
-endfunction
-
-// U0 generation.
-generate  // Quartus 17 compat: explicit generate
-if      ( 10+$clog2(FPAGE_TLB_ENTRIES) == 11 )
-begin: l_two_fp
-        assign u0 = i_address_nxt[11];
-end
-else
-begin: l_more_than_two_fp
-        assign u0 = 1'd0;
-end
-
-// U1 generation.
-if      ( 12+$clog2(SPAGE_TLB_ENTRIES) == 13 )
-begin: l_two_sp
-        assign u1 = |i_address_nxt[15:13];
-end
-else if ( 12+$clog2(SPAGE_TLB_ENTRIES) == 14 )
-begin: l_four_sp
-        assign u1 = |i_address_nxt[15:14];
-end
-else if ( 12+$clog2(SPAGE_TLB_ENTRIES) == 15 )
-begin: l_eight_sp
-        assign u1 = i_address_nxt[15];
-end
-else
-begin: l_more_than_eight_sp
-        assign u1 = 1'd0;
-end
-
-// U2 generation
-if      ( 16+$clog2(LPAGE_TLB_ENTRIES) == 17 )
-begin: l_two_lp
-        assign u2 = |i_address_nxt[19:17];
-end
-else if ( 16+$clog2(LPAGE_TLB_ENTRIES) == 18 )
-begin: l_four_lp
-        assign u2 = |i_address_nxt[19:18];
-end
-else if ( 16+$clog2(LPAGE_TLB_ENTRIES) == 19 )
-begin: l_eight_lp
-        assign u2 = i_address_nxt[19];
-end
-else
-begin: l_more_than_eight_lp
-        assign u2 = 1'd0;
-end
-
-///////////////////////////////////////////////////////////////////////////////
-
-// U3 generation.
-if      ( 10+$clog2(FPAGE_TLB_ENTRIES) == 11 )
-begin: l_two_fp_tlb
-        assign u3 = tlb_address[11];
-end
-else
-begin: l_more_than_two_fp_tlb
-        assign u3 = 1'd0;
-end
-
-// U4 generation
-if      ( 12+$clog2(SPAGE_TLB_ENTRIES) == 13 )
-begin: l_two_sp_tlb
-        assign u4 = |tlb_address[15:13];
-end
-else if ( 12+$clog2(SPAGE_TLB_ENTRIES) == 14 )
-begin: l_four_sp_tlb
-        assign u4 = |tlb_address[15:14];
-end
-else if ( 12+$clog2(SPAGE_TLB_ENTRIES) == 15 )
-begin: l_eight_sp_tlb
-        assign u4 = tlb_address[15];
-end
-else
-begin: l_more_than_eight_sp_tlb
-        assign u4 = 1'd0;
-end
-
-// U5 generation.
-if      ( 16+$clog2(LPAGE_TLB_ENTRIES) == 17 )
-begin: l_two_lp_tlb
-        assign u5 = |tlb_address[19:17];
-end
-else if ( 16+$clog2(LPAGE_TLB_ENTRIES) == 18 )
-begin: l_four_lp_tlb
-        assign u5 = |tlb_address[19:18];
-end
-else if ( 16+$clog2(LPAGE_TLB_ENTRIES) == 19 )
-begin: l_eight_lp_tlb
-        assign u5 = tlb_address[19];
-end
-else
-begin: l_more_than_eight_lp_tlb
-        assign u5 = 1'd0;
-end
-
-// -----------------------------------------------------------------------------
-
-localparam [31:0] W = max (
-        20+$clog2(SECTION_TLB_ENTRIES),
-        16+$clog2(LPAGE_TLB_ENTRIES),
-        12+$clog2(SPAGE_TLB_ENTRIES),
-        10+$clog2(FPAGE_TLB_ENTRIES)
-);
-
-assign unused = |{i_address_nxt[9:0], tlb_address[9:0], i_address_nxt[31:W],
-                       tlb_address[31:W], u0, u1, u2, u3, u4, u5,
-                       setlb_rdata, sptlb_rdata, lptlb_rdata, fptlb_rdata,
-                       setlb_ren, sptlb_ren, lptlb_ren, fptlb_ren
-                       };
-
-// ----------------------------------------------------------------------------
-
-zap_mem_inv_block #(.WIDTH(`ZAP_SECTION_TLB_WDT), .DEPTH(SECTION_TLB_ENTRIES))
-u_section_tlb (
-.i_clk          (i_clk),
-.i_reset        (i_reset),
-.i_clken        (lookup_enable),
-
-.i_wdata        (setlb_wdata),
-.i_wen          (setlb_wen && accept_install),
-
-.i_inv          (i_inv | !i_mmu_en),
-
-.i_raddr        (lookup_address[`ZAP_VA__SECTION_INDEX]),
-.i_waddr        (tlb_address[`ZAP_VA__SECTION_INDEX]),
-
-.o_rdata        (setlb_rdata),
-.o_rdav         (setlb_ren),
-
-.o_rdata_pre    (setlb_rdata_pre),
-.o_rdav_pre     (setlb_ren_pre)
-);
-
-// ----------------------------------------------------------------------------
-
-zap_mem_inv_block #(.WIDTH(`ZAP_LPAGE_TLB_WDT), .DEPTH(LPAGE_TLB_ENTRIES))
-u_lpage_tlb   (
-.i_clk          (i_clk),
-.i_reset        (i_reset),
-.i_clken        (lookup_enable),
-
-.i_wdata        (lptlb_wdata),
-.i_wen          (lptlb_wen && accept_install),
-
-.i_inv          (i_inv | !i_mmu_en),
-
-.i_raddr        (lookup_address[`ZAP_VA__LPAGE_INDEX]),
-.i_waddr        (tlb_address[`ZAP_VA__LPAGE_INDEX]),
-
-.o_rdata        (lptlb_rdata),
-.o_rdav         (lptlb_ren),
-
-.o_rdata_pre    (lptlb_rdata_pre),
-.o_rdav_pre     (lptlb_ren_pre)
-);
-
-// ----------------------------------------------------------------------------
-
-zap_mem_inv_block #(.WIDTH(`ZAP_SPAGE_TLB_WDT), .DEPTH(SPAGE_TLB_ENTRIES))
-u_spage_tlb   (
-.i_clk          (i_clk),
-.i_reset        (i_reset),
-.i_clken        (lookup_enable),
-
-.i_wdata        (sptlb_wdata),
-.i_wen          (sptlb_wen && accept_install),
-
-.i_inv          (i_inv | !i_mmu_en),
-
-.i_raddr        (lookup_address[`ZAP_VA__SPAGE_INDEX]),
-.i_waddr        (tlb_address[`ZAP_VA__SPAGE_INDEX]),
-
-.o_rdata        (sptlb_rdata),
-.o_rdav         (sptlb_ren),
-
-.o_rdata_pre    (sptlb_rdata_pre),
-.o_rdav_pre     (sptlb_ren_pre)
-);
-
-// ----------------------------------------------------------------------------
-
-zap_mem_inv_block #(.WIDTH(`ZAP_FPAGE_TLB_WDT), .DEPTH(FPAGE_TLB_ENTRIES))
-u_fpage_tlb (
-.i_clk          (i_clk),
-.i_reset        (i_reset),
-.i_clken        (lookup_enable),
-
-.i_wdata        (fptlb_wdata),
-.i_wen          (fptlb_wen && accept_install),
-
-.i_inv          (i_inv | !i_mmu_en),
-
-.i_raddr        (lookup_address[`ZAP_VA__FPAGE_INDEX]),
-.i_waddr        (tlb_address[`ZAP_VA__FPAGE_INDEX]),
-
-.o_rdata        (fptlb_rdata),
-.o_rdav         (fptlb_ren),
-
-.o_rdata_pre    (fptlb_rdata_pre),
-.o_rdav_pre     (fptlb_ren_pre)
-);
-
-// ----------------------------------------------------------------------------
-
-zap_tlb_check #(
-.LPAGE_TLB_ENTRIES(LPAGE_TLB_ENTRIES),
-.SPAGE_TLB_ENTRIES(SPAGE_TLB_ENTRIES),
-.SECTION_TLB_ENTRIES(SECTION_TLB_ENTRIES),
-.FPAGE_TLB_ENTRIES(FPAGE_TLB_ENTRIES),
-.CPSR_MODE(ZAP_CPSR_MODE)
-)
-u_zap_tlb_check (
-.i_clk          (i_clk),
-.i_clkena       (lookup_enable),
-
-.i_mmu_en       (i_mmu_en),
-.i_va           (check_address),
-.i_rd           (i_rd_check),
-.i_wr           (i_wr_check),
-
-.i_cpsr         (i_cpsr),
-.i_sr           (i_sr),
-.i_dac_reg      (i_dac_reg),
-
-.i_sptlb_rdata  (sptlb_rdata_pre),
-.i_sptlb_rdav   (sptlb_ren_pre),
-
-.i_lptlb_rdata  (lptlb_rdata_pre),
-.i_lptlb_rdav   (lptlb_ren_pre),
-
-.i_setlb_rdata  (setlb_rdata_pre),
-.i_setlb_rdav   (setlb_ren_pre),
-
-.i_fptlb_rdata  (fptlb_rdata_pre),
-.i_fptlb_rdav   (fptlb_ren_pre),
-
-.o_walk         (walk),
-.o_external_fsr (o_external_fsr),
-.o_fsr          (fsr),
-.o_far          (far),
-.o_cacheable    (cacheable),
-.o_bufferable   (bufferable),
-.o_phy_addr     (phy_addr)
-
-);
-
-assign o_walk_pending = walk;
-assign o_checked_va = far;
-logic [31:0] lookup_addr_st1, lookup_addr_st2;
-always_ff @(posedge i_clk) begin
- if (i_reset) begin lookup_addr_st1 <= 0; lookup_addr_st2 <= 0; o_checked_lookup <= 0; end
- else if (lookup_enable) begin
-  lookup_addr_st1 <= lookup_address; lookup_addr_st2 <= lookup_addr_st1;
-  o_checked_lookup <= lookup_addr_st2;
- end
-end
-always_ff @(posedge i_clk) if (lookup_enable) begin
- o_checked_rd <= i_rd_check; o_checked_wr <= i_wr_check; o_checked_mmu <= i_mmu_en;
- o_checked_cpsr <= i_cpsr; o_checked_sr <= i_sr; o_checked_dac <= i_dac_reg; o_checked_baddr <= i_baddr;
-end
-
-// ----------------------------------------------------------------------------
-
-zap_tlb_fsm #(
-.LPAGE_TLB_ENTRIES      (LPAGE_TLB_ENTRIES),
-.SPAGE_TLB_ENTRIES      (SPAGE_TLB_ENTRIES),
-.SECTION_TLB_ENTRIES    (SECTION_TLB_ENTRIES),
-.FPAGE_TLB_ENTRIES      (FPAGE_TLB_ENTRIES)
-) u_zap_tlb_fsm (
-.i_clk          (i_clk),
-.i_reset        (i_reset),
-.i_mmu_en       (i_mmu_en),
-.i_baddr        (i_baddr),
-.i_address      (i_address),
-.i_walk         (walk),
-.i_fsr          (fsr),
-.i_far          (far),
-.i_cacheable    (cacheable),
-.i_bufferable   (bufferable),
-.i_phy_addr     (phy_addr),
-
-.i_idle         (walker_idle),
-.o_fsr          (o_fsr),
-.o_far          (o_far),
-.o_fault        (o_fault),
-.o_phy_addr     (),
-.o_cacheable    (o_cacheable),
-.o_bufferable   (o_bufferable),
-.o_busy         (walk_active),
-
-.o_setlb_wdata  (setlb_wdata),
-.o_setlb_wen    (setlb_wen),
-
-.o_sptlb_wdata  (sptlb_wdata),
-.o_sptlb_wen    (sptlb_wen),
-
-.o_lptlb_wdata  (lptlb_wdata),
-.o_lptlb_wen    (lptlb_wen),
-
-.o_fptlb_wdata  (fptlb_wdata),
-.o_fptlb_wen    (fptlb_wen),
-
-.o_address      (tlb_address),
-.o_wb_wen       (o_wb_wen_nxt),
-
-/* verilator lint_off PINCONNECTEMPTY */
-.o_wb_cyc       (),
-.o_wb_stb       (),
-.o_wb_sel       (),
-.o_wb_adr       (),
-/* verilator lint_on PINCONNECTEMPTY */
-
-.i_wb_dat       (i_wb_dat),
-.i_wb_ack       (i_wb_ack),
-.i_wb_err       (i_wb_err),
-
-.o_wb_sel_nxt   (o_wb_sel_nxt),
-.o_wb_cyc_nxt   (o_wb_cyc_nxt),
-.o_wb_stb_nxt   (o_wb_stb_nxt),
-.o_wb_adr_nxt   (o_wb_adr_nxt)
-);
-
-// ----------------------------------------------------------------------------
-
-endgenerate
-endmodule : zap_tlb
