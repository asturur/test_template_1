-function automatic [31:0] adapt_cache_data (
-        input [$clog2(CACHE_LINE) - 3:0] shift,
-        input [CACHE_LINE*8-1:0]         data
-);
-        localparam [31:0] W = $clog2(CACHE_LINE) + 3;
