+    pc_nxt[32] = pc_nxt_tmp[32];
+
+    // FCSE
+    if (pc_nxt_tmp[31:25] == 0) begin
+      pc_nxt[31:25] = i_cpu_pid[6:0];
+    end else begin
+      pc_nxt[31:25] = pc_nxt_tmp[31:25];
+    end
+
+    // Lower bit of PC is always zero.
+    pc_nxt[24:0] = {pc_nxt_tmp[24:1], 1'd0};
+
+  end : pc_control_tree
