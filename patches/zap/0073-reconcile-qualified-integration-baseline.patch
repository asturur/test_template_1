+    pc_shelve_nxt = pc_shelve_ff;
+    pc_nxt_tmp    = pc_ff;
+    pc_nxt        = pc_ff;
+    pc_del_nxt    = pc_del_ff;
+    pc_del2_nxt   = pc_del2_ff;
+    pc_del3_nxt   = pc_del3_ff;
+    o_pred        = 33'd0;
+
+    // ====================================
+    // Code Section
+    // ====================================
