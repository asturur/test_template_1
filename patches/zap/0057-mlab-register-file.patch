+// One write and one unregistered read; five physical read replicas per writer.
+module zap_register_mlab (
+    input  wire        clk,
+    input  wire        we,
+    input  wire [ 5:0] waddr,
+    input  wire [ 5:0] raddr,
+    input  wire [31:0] data,
+    output wire [31:0] q
+);
+`ifdef ALTERA_RESERVED_QIS
+    `define NGAGE_RF_VENDOR
+`elsif SYNTHESIS
+    `define NGAGE_RF_VENDOR
+`endif
+`ifdef NGAGE_RF_VENDOR
+    altdpram #(
+        .width                             (32),
+        .widthad                           (6),
+        .numwords                          (64),
+        .intended_device_family            ("Cyclone V"),
+        .ram_block_type                    ("MLAB"),
+        .indata_reg                        ("INCLOCK"),
+        .wraddress_reg                     ("INCLOCK"),
+        .wrcontrol_reg                     ("INCLOCK"),
+        .rdaddress_reg                     ("UNREGISTERED"),
+        .rdcontrol_reg                     ("UNREGISTERED"),
+        .outdata_reg                       ("UNREGISTERED"),
+        .indata_aclr                       ("OFF"),
+        .wraddress_aclr                    ("OFF"),
+        .wrcontrol_aclr                    ("OFF"),
+        .rdaddress_aclr                    ("OFF"),
+        .rdcontrol_aclr                    ("OFF"),
+        .outdata_aclr                      ("OFF"),
+        .read_during_write_mode_mixed_ports("DONT_CARE")
+    ) ram (
+        .inclock       (clk),
+        .inclocken     (1'b1),
+        .outclock      (1'b0),
+        .outclocken    (1'b1),
+        .aclr          (1'b0),
+        .wren          (we),
+        .rden          (1'b1),
+        .byteena       (1'b1),
+        .wraddressstall(1'b0),
+        .rdaddressstall(1'b0),
+        .wraddress     (waddr),
+        .data          (data),
+        .rdaddress     (raddr),
+        .q             (q)
+    );
+`else
+    (* ramstyle="MLAB, no_rw_check" *)reg [31:0] words            [0:63];
+    reg        previous_we;
+    reg [ 5:0] previous_address;
+    always @(posedge clk) begin
+        if (we) words[waddr] <= data;
+        previous_we      <= we;
+        previous_address <= waddr;
+    end
+    // Poison active and just-committed collisions; RF bypass must cover both.
+    assign q = ((we && waddr==raddr) || (previous_we && previous_address==raddr)) ? 32'bx : words[raddr];
+`endif
+    `undef NGAGE_RF_VENDOR
+endmodule
