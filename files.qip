# SDRAM controller (jtframe_sdram64, self-contained)
set_global_assignment -name VERILOG_FILE rtl/sdram/jtframe_sdram64.v
set_global_assignment -name VERILOG_FILE rtl/sdram/jtframe_sdram64_bank.v
set_global_assignment -name VERILOG_FILE rtl/sdram/jtframe_sdram64_init.v
set_global_assignment -name VERILOG_FILE rtl/sdram/jtframe_sdram64_latch.v
set_global_assignment -name VERILOG_FILE rtl/sdram/jtframe_sdram64_rfsh.v
