# Inactive instruction-only DDR cache (replaced by the shared flash cache).
# set_global_assignment -name VERILOG_FILE rtl/jtframe/ngage_jtframe_romrq_lcache.v
# set_global_assignment -name VERILOG_FILE rtl/ngage_ddr_rom_cache.v

