# N-Gage MiSTer core — Quartus source file list

# Top-level
set_global_assignment -name SYSTEMVERILOG_FILE Template.sv
set_global_assignment -name SDC_FILE Template.sdc

# PLL (104 MHz system + SDRAM clock)
set_global_assignment -name QIP_FILE rtl/pll.qip

# N-Gage core modules
set_global_assignment -name VERILOG_FILE rtl/ngage_mister.v
set_global_assignment -name VERILOG_FILE rtl/ngage_reset_gate.v
set_global_assignment -name VERILOG_FILE rtl/ngage_sdram_adapter.v
set_global_assignment -name VERILOG_FILE rtl/ngage_sdram_arbiter.v
set_global_assignment -name VERILOG_FILE rtl/ngage_board.v
set_global_assignment -name VERILOG_FILE rtl/ngage_upp.v
set_global_assignment -name VERILOG_FILE rtl/ngage_upp_peripherals.v
set_global_assignment -name VERILOG_FILE rtl/ngage_uem.v
set_global_assignment -name VERILOG_FILE rtl/ngage_adsp.v
set_global_assignment -name VERILOG_FILE rtl/ngage_lrb2.v
set_global_assignment -name VERILOG_FILE rtl/ngage_mjoelner.v
set_global_assignment -name VERILOG_FILE rtl/ngage_sparse_regs.v
set_global_assignment -name VERILOG_FILE rtl/ngage_icu.v
set_global_assignment -name VERILOG_FILE rtl/ngage_icu_extra.v
set_global_assignment -name VERILOG_FILE rtl/ngage_timers.v
set_global_assignment -name VERILOG_FILE rtl/ngage_nos_io.v
set_global_assignment -name VERILOG_FILE rtl/ngage_mdi_stub.v
set_global_assignment -name VERILOG_FILE rtl/ngage_cbus_uem.v
set_global_assignment -name VERILOG_FILE rtl/ngage_gpio_loopback.v
set_global_assignment -name VERILOG_FILE rtl/ngage_boot_regs.v
set_global_assignment -name VERILOG_FILE rtl/ngage_trace_sink.v
set_global_assignment -name VERILOG_FILE rtl/ngage_bram_be.v
set_global_assignment -name VERILOG_FILE rtl/ngage_descramble.v
set_global_assignment -name VERILOG_FILE rtl/ngage_flash_read_decode.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_cflash.sv
set_global_assignment -name VERILOG_FILE rtl/ngage_am29n643_state.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_codeflash.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_dirty_tracker.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_sd_sector.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_save_sector_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_save_header.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_save_manager.sv
set_global_assignment -name VERILOG_FILE rtl/ngage_modem.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_cpu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_rom_map.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_ddr_lanes.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_ddr_adapter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_ddr_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_loader.sv

# ARM920-shaped cache is the development default; FPGA fit/timing remain unverified.
set_global_assignment -name VERILOG_MACRO "NGAGE_ASSOC_EXPERIMENT=1"
# Associative cache RTL.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/tlb_bus_gate.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/write_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_tags.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_lines.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_bank.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_transfer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_refill.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_maintenance.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_access.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/zap_dcache_adapter.sv

