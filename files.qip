# N-Gage MiSTer core — Quartus source file list

# Header includes used by the patched ZAP sources.
set_global_assignment -name SEARCH_PATH rtl/arm

# Top-level
set_global_assignment -name SYSTEMVERILOG_FILE Template.sv
set_global_assignment -name SDC_FILE Template.sdc

# PLL (78 MHz system; SDRAM pin clock is forwarded through DDIO)
set_global_assignment -name QIP_FILE rtl/pll.qip

# Request IO-cell placement for the falling-edge SDRAM input capture.
# Actual placement and setup/hold closure must be checked in Fitter/TimeQuest.
set_instance_assignment -name FAST_INPUT_REGISTER ON -to {SDRAM_DQ[*]}

# N-Gage core modules
# DDR observation collector only; diagnostic video/font are not compiled.
set_global_assignment -name VERILOG_FILE rtl/ngage_debug_monitor.v
set_global_assignment -name VERILOG_FILE rtl/ngage_bram.v
set_global_assignment -name VERILOG_FILE rtl/ngage_bundle_gate.v
set_global_assignment -name VERILOG_FILE rtl/ngage_mister.v
set_global_assignment -name VERILOG_FILE rtl/ngage_lcd_display.v
# Legacy LCD-only frontend; production uses general channels + fast stream.
# set_global_assignment -name VERILOG_FILE rtl/ngage_lcd_dma.v
set_global_assignment -name VERILOG_FILE rtl/ngage_keypad.v
set_global_assignment -name VERILOG_FILE rtl/ngage_keys.v
set_global_assignment -name VERILOG_FILE rtl/ngage_diagnostics.v
set_global_assignment -name VERILOG_FILE rtl/ngage_diag_ddr.v
set_global_assignment -name VERILOG_FILE rtl/ngage_diag_text_ddr.v
set_global_assignment -name VERILOG_FILE rtl/ngage_reset_gate.v
set_global_assignment -name VERILOG_FILE rtl/ngage_sdram_clock.v
set_global_assignment -name VERILOG_FILE rtl/ngage_sdram_adapter.v
set_global_assignment -name VERILOG_FILE rtl/ngage_sdram_arbiter.v
set_global_assignment -name VERILOG_FILE rtl/ngage_dma_route.v
set_global_assignment -name VERILOG_FILE rtl/ngage_dma_engine.v
set_global_assignment -name VERILOG_FILE rtl/ngage_dma_channels.v
set_global_assignment -name VERILOG_FILE rtl/ngage_lcd_stream.v
set_global_assignment -name VERILOG_FILE rtl/ngage_dma_ram_mux.v
set_global_assignment -name VERILOG_FILE rtl/ngage_mmc_host.v
set_global_assignment -name VERILOG_FILE rtl/ngage_mmc_card.v
set_global_assignment -name VERILOG_FILE rtl/ngage_mmc_dpram.v
set_global_assignment -name VERILOG_FILE rtl/ngage_mmc_hps.v
set_global_assignment -name VERILOG_FILE rtl/ngage_board.v
set_global_assignment -name VERILOG_FILE rtl/ngage_upp.v
set_global_assignment -name VERILOG_FILE rtl/ngage_upp_peripherals.v
set_global_assignment -name VERILOG_FILE rtl/ngage_simif.v
# Synthetic no-PIN GSM card; original NOS owns initialization and readiness.
set_global_assignment -name VERILOG_FILE rtl/ngage_test_sim.v
set_global_assignment -name VERILOG_FILE rtl/ngage_uem.v
set_global_assignment -name VERILOG_FILE rtl/ngage_adsp.v
set_global_assignment -name VERILOG_FILE rtl/ngage_adsp_bootstrap_tx.v
set_global_assignment -name VERILOG_FILE rtl/ngage_adsp_diagnostic.v
set_global_assignment -name VERILOG_FILE rtl/ngage_aic23.v
set_global_assignment -name VERILOG_FILE rtl/ngage_lrb2.v
set_global_assignment -name VERILOG_FILE rtl/ngage_mjoelner.v
set_global_assignment -name VERILOG_FILE rtl/ngage_sparse_regs.v
set_global_assignment -name VERILOG_FILE rtl/ngage_icu.v
set_global_assignment -name VERILOG_FILE rtl/ngage_icu_extra.v
set_global_assignment -name VERILOG_FILE rtl/ngage_timers.v
set_global_assignment -name VERILOG_FILE rtl/ngage_nos_io.v
# Legacy announcement-only comparison; not in production.
# set_global_assignment -name VERILOG_FILE rtl/ngage_mdi_stub.v
set_global_assignment -name VERILOG_FILE rtl/ngage_upp_dsp_peer.v
set_global_assignment -name VERILOG_FILE rtl/ngage_upp_mdi.v
set_global_assignment -name VERILOG_FILE rtl/ngage_upp_euart.v
set_global_assignment -name VERILOG_FILE rtl/ngage_cbus_uem.v
set_global_assignment -name VERILOG_FILE rtl/ngage_gpio_loopback.v
set_global_assignment -name VERILOG_FILE rtl/ngage_boot_regs.v
set_global_assignment -name VERILOG_FILE rtl/ngage_trace_sink.v
set_global_assignment -name VERILOG_FILE rtl/ngage_bram_be.v
set_global_assignment -name VERILOG_FILE rtl/ngage_descramble.v
set_global_assignment -name VERILOG_FILE rtl/ngage_flash_read_decode.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_cflash.sv
set_global_assignment -name VERILOG_FILE rtl/ngage_am29n643_state.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_codeflash.sv
# Inactive bitmap tracker; selected bulk profile uses ordered dirty queue.
# set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_dirty_tracker.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_sd_sector.sv
set_global_assignment -name VERILOG_FILE rtl/ngage_save_sector_bridge.v
# Retired NGA header; production mounts raw VHD sectors.
# set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_save_header.sv
# Retired NGA mount/save harness; raw manager below owns slots 0/1.
# set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_save_manager.sv
set_global_assignment -name VERILOG_FILE rtl/ngage_ordered_dirty_queue.v
set_global_assignment -name VERILOG_FILE rtl/ngage_raw_save_manager.v
set_global_assignment -name VERILOG_FILE rtl/ngage_ddr_stream.v
set_global_assignment -name VERILOG_FILE rtl/ngage_ddr_stream_legacy.v
# Unconnected legacy modem model; production semi-real NOS is separate.
# set_global_assignment -name VERILOG_FILE rtl/ngage_modem.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_cpu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_rom_map.sv
# Scalar DDR fallback only; production uses the stream transport.
# set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_ddr_lanes.sv
set_global_assignment -name VERILOG_FILE rtl/ngage_ddr_adapter.v
set_global_assignment -name VERILOG_FILE rtl/ngage_ddr_arbiter.v
set_global_assignment -name VERILOG_FILE rtl/ngage_service_loader.v
# Temporarily disabled compatibility packages. Re-enable with the QSF macro.
# set_global_assignment -name VERILOG_FILE rtl/ngage_nos_overlay.v

# Production ARM920T cache and 64-entry instruction/data TLBs.
# ARM920T cache/MMU RTL.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/tlb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/tlb_bank.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/tlb_bus_gate.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/write_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_tags.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_lines.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_bank.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_transfer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_refill.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_maintenance.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_access.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm920/cache_adapter.sv

