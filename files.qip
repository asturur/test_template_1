# N-Gage MiSTer core — Quartus source file list

# Top-level
set_global_assignment -name SYSTEMVERILOG_FILE Template.sv
set_global_assignment -name SDC_FILE Template.sdc

# PLL (104 MHz system + SDRAM clock)
set_global_assignment -name QIP_FILE rtl/pll.qip

# N-Gage core modules
set_global_assignment -name VERILOG_FILE rtl/ngage_mister.v
set_global_assignment -name VERILOG_FILE rtl/ngage_board.v
set_global_assignment -name VERILOG_FILE rtl/ngage_bram_be.v
set_global_assignment -name VERILOG_FILE rtl/ngage_descramble.v
set_global_assignment -name VERILOG_FILE rtl/ngage_modem.v
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ngage_cpu.sv

# ZAP ARM920T CPU: patched copy in rtl/arm (upstream + patches/zap, see rtl/arm/README.md)
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_top.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_fetch_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_predecode_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_predecode_uop_sequencer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_predecode_coproc.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_decode_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_decode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_issue_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_shifter_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_shifter_multiply.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_shifter_shift.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_alu_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_postalu_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_memory_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_writeback.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_register_file.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_cp15_cb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_mode16_decoder_main.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_mode16_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_decompile.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_btb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_cache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_cache_fsm.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_cache_tag_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_dcache.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_dcache_fsm.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_tlb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_tlb_fsm.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_tlb_check.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_wb_merger.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_sync_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_ram_simple.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/arm/zap_ram_simple_ben.sv
