    `define IS `LC.u_zap_issue_main
    `define IW `LC.u_zap_writeback
    task issue_sample;
      begin
        if(windows==2 && (mt_cycles<6000 || (`IS.operand_valid==0 && `LC.decode_condition_code!=15)))$display("ISSUE_EDGE edge=%0d ret=%0d rpc=%h fetch=%0d fpc=%h fifo=%0d qpc=%h mode=%0d mpc=%h pre=%0d ppc=%h dec=%0d dpc=%h oval=%0d opc=%h full=%0d push=%0d pop=%0d lock=%0d ll=%0d sl=%0d stall=%0d data=%0d code=%0d shstall=%0d destall=%0d iqstall=%0d clrwb=%0d clralu=%0d clrdec=%0d issue=%0d ipc=%h sh=%0d spc=%h alu=%0d apc=%h p1=%0d p1pc=%h p2=%0d p2pc=%h comp=%0d compfault=%0d offer=%0d rd=%0d wr=%0d ack=%0d selected=%h head=%0d tail=%0d source0=%h source1=%h source2=%h source3=%0d oload=%0d ostore=%0d mempc=%h memvalid=%0d memload=%0d rfwen=%0d rfb=%0d ireq=%0d iack=%0d iaddr=%h",cycles,retire,retire_pc,`LC.fetch_valid,`LC.fetch_pc_plus_8_ff-8,`LC.fifo_valid,`LC.fifo_pc_plus_8-8,`LC.mode16_valid,`LC.mode16_pc_plus_8_ff-8,`LC.predecode_val,`LC.predecode_pc_plus_8-8,`LC.decode_condition_code!=15,`LC.decode_pc_plus_8_ff-8,`IS.operand_valid,`IS.operand_pc_plus_8_ff-8,`IS.o_stall_from_issue,`IS.operand_push,`IS.operand_pop,`IS.lock,`IS.load_lock,`IS.shift_lock,`IS.stall,`LC.data_stall,`LC.code_stall,`LC.stall_from_shifter,`LC.stall_from_decode,`LC.stall_from_issue,`LC.clear_from_writeback,`LC.clear_from_alu,`LC.clear_from_decode,`LC.issue_condition_code_ff!=15,`LC.issue_pc_plus_8_ff-8,`LC.shifter_condition_code_ff!=15,`LC.shifter_pc_plus_8_ff-8,`LC.alu_dav_ff,`LC.alu_pc_plus_8_ff-8,`LC.postalu1_dav_ff,`LC.postalu1_pc_plus_8_ff-8,`LC.postalu_dav_ff,`LC.postalu_pc_plus_8_ff-8,`LC.completion_valid,`LC.completion_fault,`LA.rd||`LA.wr,`LA.rd,`LA.wr,`LA.request_ack,load_selected_pc,`IS.u_operand_read.head_valid,`IS.u_operand_read.tail_valid,`IS.operand_alu_source_ff,`IS.operand_shift_source_ff,`IS.operand_shift_length_ff,`IS.operand_mem_srcdest_index_ff,`IS.operand_mem_load_ff,`IS.operand_mem_store_ff,`LC.memory_pc_plus_8_ff-8,`LC.memory_dav_ff,`LC.memory_mem_load_ff,`LC.rf_wen,`LC.rf_wr_addr_b,`LC.o_instr_wb_stb,`LC.i_instr_wb_ack,`LC.o_instr_wb_adr);
        if(windows==2 && (`LC.clear_from_alu || `LC.clear_from_decode || `LC.clear_from_writeback || `IW.shelve_ff))
          $display("REDIRECT_EDGE edge=%0d alupc=%h aclr=%0d dclr=%0d wclr=%0d code=%0d data=%0d shelve=%0d saved=%h atarget=%h dtarget=%h pc0=%h pc1=%h pc2=%h pc3=%h ireq=%0d iack=%0d iaddr=%h",cycles,`LC.alu_pc_plus_8_ff-8,`LC.clear_from_alu,`LC.clear_from_decode,`LC.clear_from_writeback,`LC.code_stall,`LC.data_stall,`IW.shelve_ff,`IW.pc_shelve_ff,`IW.i_pc_from_alu,`IW.i_pc_from_decode,`IW.pc_ff,`IW.pc_del_ff,`IW.pc_del2_ff,`IW.pc_del3_ff,`LC.o_instr_wb_stb,`LC.i_instr_wb_ack,`LC.o_instr_wb_adr);
      end
    endtask
