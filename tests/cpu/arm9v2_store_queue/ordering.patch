+    // Post a sequence of mixed-width stores to a cold line. A dependent
+    // load must wait for them before starting its line refill.
+    ldr r11,=0x0a006400
+    ldr r4,=0x11223344
+    mov r5,#0xa8
+    mov r6,#0x3c
+    str r4,[r11]
+    strb r5,[r11,#2]
+    strh r6,[r11]
+    ldr r9,[r11]
+    ldr r10,=0x11a8003c
+    cmp r9,r10
+    bne fail
+
+    // Drain a pending write to a second cold line using CP15's barrier.
+    str r4,[r11,#32]
+    mcr p15,0,r4,c7,c10,4
+    ldr r9,[r11,#32]
+    cmp r9,r4
+    bne fail
+
     // Read-allocate both ways before dirtying them. With W enabled the
     // donor can post a store miss without installing a line.
     ldr r11,=0x0a008000
