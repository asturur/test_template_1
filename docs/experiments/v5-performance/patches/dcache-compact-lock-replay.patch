+"""Summarize timer-control and earlier lock-valid path families."""
+import csv
+import json
+from pathlib import Path
+
+
+stage = Path(__file__).resolve().parent
+root = stage.parents[2]
+cohorts = {'timer': {13: 45824513460, 43: 45824520116, 31337: 45824525843},
+           'old_valid_only': {13: 45720741046, 43: 45720741108, 31337: 45720741271}}
+signals = ('o_lock_any', 'o_lock_owner', 'o_lock_return', 'o_reg_idx[')
+report = {}
+for group, seeds in cohorts.items():
+    report[group] = {}
+    for seed, run in seeds.items():
+        model = root / f'build/timing-audit-{run}/output_files/timing/resident-store/104'
+        corners = {}
+        report[group][seed] = {'run': run, 'corners': corners}
+        for source in sorted(model.glob('corner-*/setup.csv')):
+            with source.open() as handle:
+                reader = csv.reader(handle)
+                header = next(reader)
+                paths = list(reader)
+            assert len(paths) == 1000 and header == ['rank', 'slack_ns', 'data_delay_ns', 'logic_levels', 'from', 'to']
+            name = (source.parent / 'operating-condition.txt').read_text().splitlines()[0].split()[1]
+            samples = {}
+            corners[name] = {'file': str(source.relative_to(root)), 'families': samples}
+            for signal in signals:
+                matches = [path for path in paths if '|u_zap_cache_fsm|' in path[-1] and
+                           path[-1].split('|')[-1].startswith(signal)]
+                # Current generated hierarchy includes the type name on the FSM node.
+                matches += [path for path in paths if '|ngage2_zap_dcache_fsm:u_zap_cache_fsm|' in path[-1] and
+                            path[-1].split('|')[-1].startswith(signal)]
+                if matches:
+                    worst = min(matches, key=lambda path: float(path[1]))
+                    samples[signal] = {'count': len(matches), 'rank': int(worst[0]), 'slack_ns': float(worst[1]),
+                                       'data_ns': float(worst[2]), 'cell_levels': int(worst[3]),
+                                       'from': worst[-2], 'to': worst[-1]}
+        assert len(corners) == 4, model
+
+for group, seeds in report.items():
+    print(group)
+    for seed, data in seeds.items():
+        for corner, facts in data['corners'].items():
+            if '_slow_' not in corner:
+                continue
+            print(seed, corner, {key: (value['rank'], value['slack_ns'], value['count'])
+                                         for key, value in facts['families'].items()})
+(stage / 'routes.json').write_text(json.dumps(report, indent=2) + '\n')
