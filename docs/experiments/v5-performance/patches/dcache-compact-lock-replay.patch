@@ -0,0 +1,25 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/dcache-compact-lock
+base=build/sim/v5-104-timer-write-prepare
+out=build/sim/v5-104-dcache-compact-lock
+original=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed
+mixed="$out/mixed"
+overlap="$out/coexistence"
+mkdir -p "$overlap"
+python3 -B "$area/mixed.py"
+cp "$base/coexistence/stress-timer.hex" "$overlap/stress-timer.hex"
+docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD:/work" -w /work --entrypoint sh jotego/simulator:arm64 \
+  -ec "sh '$mixed/build.sh'
+'$mixed/obj/Vtb' +upp_stress '+compare_trace=$mixed/traffic.log' > '$mixed/replay.log'"
+cmp "$base/mixed/traffic.log" "$mixed/traffic.log"
+grep '^PASS ' "$mixed/replay.log"
+docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD:/work" -v "$PWD/$overlap/stress-timer.hex:/work/$original/stress.hex:ro" -w /work \
+  --entrypoint "/work/$mixed/obj/Vtb" jotego/simulator:arm64 \
+  +upp_stress "+compare_trace=$overlap/candidate.trace" > "$overlap/candidate.log"
+cmp "$base/coexistence/candidate.trace" "$overlap/candidate.trace"
+grep '^PASS ' "$overlap/candidate.log" > "$overlap/candidate.pass"
+cmp "$base/coexistence/candidate.pass" "$overlap/candidate.pass"
+cat "$overlap/candidate.pass"
diff --git a/scratch/v5-fit-loop/dcache-compact-lock/prepare-directed.py b/scratch/v5-fit-loop/dcache-compact-lock/prepare-directed.py
new file mode 100644
index 0000000..447fa34
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-compact-lock/prepare-directed.py
@@ -0,0 +1,184 @@
+"""Run exact retained, candidate legacy and compact FSMs in the same fixture."""
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-dcache-compact-lock/directed')
+out.mkdir(parents=True, exist_ok=True)
+ref = (stage / 'reference/rtl/arm9v2/arm925t_phone.v').read_text()
+match = re.search(r'^module ngage2_zap_dcache_fsm \(.*?^endmodule$', ref, re.M | re.S)
+assert match
+(out / 'reference.v').write_text(match[0].replace('ngage2_zap_dcache_fsm', 'reference_zap_dcache_fsm') + '\n')
+bench = (stage / 'reference/tests/cpu/arm9v2_board/background_load_lock_tb.v').read_text()
+
+
+def edit(before, after):
+    global bench
+    assert bench.count(before) == 1, before
+    bench = bench.replace(before, after)
+
+
+edit('  reg [5:0] destination = 0;', '''  reg [5:0] destination = 0, owner_hold = 0, owner_advance = 0;
+  reg owner_move = 0, victim_valid = 0, victim_dirty = 0, abort_refill = 0;
+  reg [45:0] victim_tag = 0;
+  wire [131:0] reference_lock_state, legacy_lock_state, compact_lock_state;
+  wire [31:0] legacy_data, compact_data;
+  wire [6:0] legacy_handshake, compact_handshake;
+  wire owner, lock_return, wb_write;
+  wire [5:0] legacy_tag, compact_tag;
+  integer compare_cycles = 0, return_installs = 0, cache_aborts = 0;''')
+edit('  ngage2_zap_dcache_fsm #(', '  reference_zap_dcache_fsm #(')
+edit('      .i_lock_owner_hold(destination),\n      .i_lock_owner_advance(destination),\n      .i_lock_owner_move(1\'b0),', '''      .i_lock_owner_hold(owner_hold),
+      .i_lock_owner_advance(owner_advance),
+      .i_lock_owner_move(owner_move),
+      .o_lock_owner(owner),
+      .o_lock_return(lock_return),''')
+edit("      .i_cache_tag_dirty(1'b0),\n      .i_cache_tag(46'b0),\n      .i_cache_tag_valid(1'b0),", """      .i_cache_tag_dirty(victim_dirty),
+      .i_cache_tag(victim_tag),
+      .i_cache_tag_valid(victim_valid),""")
+edit("      .o_wb_stb_ff(wb_stb),", """      .o_wb_stb_ff(wb_stb),
+      .o_wb_wen_ff(wb_write),""")
+marker = '  always #5 clk = !clk;'
+start = bench.index('  reference_zap_dcache_fsm #(')
+end = bench.index('  );', start) + len('  );')
+inst = bench[start:end]
+outputs = {'bitmap': (131, 68), 'returned': (67, 4), 'lock_valid': (3, 3),
+           'owner': (2, 2), 'lock_return': (1, 1), 'wb_stb': (0, 0)}
+checked = {'idle': 6, 'fill': 5, 'ack': 4, 'error': 3, 'wb_write': 2}
+# The tag is checked independently with its full six-bit width.
+decl = '''  assign reference_lock_state = {bitmap, returned, lock_valid, owner, lock_return, wb_stb};
+  always @(negedge clk) begin
+    #0.1;
+    if (reference_lock_state !== legacy_lock_state || reference_lock_state !== compact_lock_state ||
+        {idle, fill, ack, error, wb_write} !== legacy_handshake[6:2] ||
+        {idle, fill, ack, error, wb_write} !== compact_handshake[6:2] ||
+        lock_tag !== legacy_tag || lock_tag !== compact_tag ||
+        (|returned && (returned_data !== legacy_data || returned_data !== compact_data)))
+      $fatal(1, "Lock owner, bitmap, data or handshake diverged at %t", $time);
+    if (!reset) compare_cycles = compare_cycles + 1;
+  end
+'''
+copies = []
+for leg, opt in (('legacy', ''), ('compact', ",\n      .COMPACT_LOCK(1'b1)")):
+    copy = inst.replace('reference_zap_dcache_fsm', 'ngage2_zap_dcache_fsm')
+    copy = copy.replace('.LOCK_SPLIT(1)', f'.LOCK_SPLIT(1){opt}').replace(') cache (', f') {leg} (')
+    for signal, (top, bottom) in outputs.items():
+        slc = str(top) if top == bottom else f'{top}:{bottom}'
+        copy, count = re.subn(r'(\.o_\w+\()' + signal + r'(\))',
+                              rf'\g<1>{leg}_lock_state[{slc}]\g<2>', copy)
+        assert count == 1, signal
+    for signal, bit in checked.items():
+        copy, count = re.subn(r'(\.o_\w+\()' + signal + r'(\))',
+                              rf'\g<1>{leg}_handshake[{bit}]\g<2>', copy)
+        assert count == 1, signal
+    copies.append(copy.replace('(returned_data)', f'({leg}_data)').replace('(lock_tag)', f'({leg}_tag)'))
+edit(marker, '\n\n'.join([*copies, decl, marker]))
+edit('      destination = tag;\n      read = 1;', '''      destination = tag;
+      owner_hold = tag ^ 6'h3f;
+      owner_advance = tag;
+      owner_move = 1;
+      read = 1;''')
+edit('        $fatal(1, "Wrong miss owner %0d", tag);\n      read = 0;', '''        $fatal(1, "Wrong miss owner %0d", tag);
+      if (!owner || lock_return)
+        $fatal(1, "Advance must admit the new tag while the held tag stays unlocked");
+      read = 0;''')
+edit('        wb_ack  = 1;\n        tick;', '''        owner_hold = tag;
+        owner_advance = tag ^ 6'h3f;
+        owner_move = beat[0];
+        wb_ack = !abort_refill || beat != critical;
+        wb_error = abort_refill && beat == critical;
+        tick;''')
+edit('        wb_ack = 0;\n        tick;', '''        if (beat <= critical && (owner !== !owner_move || !lock_return))
+          $fatal(1, "Held and advancing owners did not use the registered return edge");
+        wb_ack = 0;
+        wb_error = 0;
+        tick;
+        if (beat >= critical && (owner || lock_return))
+          $fatal(1, "Returned destination remained locked");''')
+edit('  initial begin\n    repeat (2) tick;', '''  task simultaneous;
+    input [5:0] incoming;
+    begin
+      reset = 1;
+      tick;
+      reset = 0;
+      // Force an IDLE register image with a coincident old return. Natural
+      // refill traffic clears the owner before IDLE, so test priority here.
+      force cache.lock_ff = 64'h80;
+      force cache.o_lock_any = 1'b1;
+      force cache.o_lock_tag = 6'd7;
+      force cache.o_reg_idx = 64'h80;
+      force legacy.g_bitmap_lock.lock_ff = 64'h80;
+      force legacy.o_lock_any = 1'b1;
+      force legacy.o_lock_tag = 6'd7;
+      force legacy.o_reg_idx = 64'h80;
+      force compact.o_lock_any = 1'b1;
+      force compact.o_lock_tag = 6'd7;
+      force compact.o_reg_idx = 64'h80;
+      force compact.g_compact_lock.return_ff = 1'b1;
+      #0.5;
+      release cache.lock_ff;
+      release cache.o_lock_any;
+      release cache.o_lock_tag;
+      release cache.o_reg_idx;
+      release legacy.g_bitmap_lock.lock_ff;
+      release legacy.o_lock_any;
+      release legacy.o_lock_tag;
+      release legacy.o_reg_idx;
+      release compact.o_lock_any;
+      release compact.o_lock_tag;
+      release compact.o_reg_idx;
+      release compact.g_compact_lock.return_ff;
+      owner_hold = 7;
+      owner_advance = incoming;
+      owner_move = 1;
+      destination = incoming;
+      read = 1;
+      #1;
+      if (!cache.lock_set_nxt) $fatal(1, "Synthetic simultaneous new install did not settle");
+      tick;
+      if (!lock_valid || lock_tag !== incoming || !owner || lock_return !== (incoming == 7))
+        $fatal(1, "Simultaneous old return and new install lost the incoming owner");
+      read = 0;
+      return_installs = return_installs + 1;
+    end
+  endtask
+
+  initial begin
+    repeat (2) tick;''')
+edit('    $display("PASS background load tags', '''    victim_valid = 1;
+    victim_dirty = 1;
+    victim_tag = {27'h501800, 19'b0};
+    start_miss(6'd58, 32'h0a030000, 3'd7);
+    for (tag = 0; tag < 8; tag = tag + 1) begin
+      while (!wb_stb) tick;
+      if (!wb_write || !lock_valid || |returned)
+        $fatal(1, "Aliasing dirty victim lost its new fill owner");
+      wb_ack = 1;
+      tick;
+      wb_ack = 0;
+      tick;
+    end
+    victim_valid = 0;
+    victim_dirty = 0;
+    abort_refill = 1;
+    drain_fill(6'd58, 3'd7);
+    cache_aborts = cache_aborts + 1;
+    abort_refill = 0;
+
+    start_miss(6'd28, 32'h0a044000, 3'd0);
+    while (!wb_stb) tick;
+    wb_ack = 1;
+    reset = 1;
+    tick;
+    if (lock_valid || bitmap || returned || owner || lock_return)
+      $fatal(1, "Reset did not take precedence over the returning fill");
+    wb_ack = 0;
+    reset = 0;
+
+    simultaneous(6'd7);
+    simultaneous(6'd54);
+    $display("PASS compact lock comparison cycles=%0d simultaneous=%0d cached_errors=%0d",
+             compare_cycles, return_installs, cache_aborts);
+    $display("PASS background load tags''')
+(out / 'tb.v').write_text(bench)
diff --git a/scratch/v5-fit-loop/dcache-compact-lock/prepare-state-proof.py b/scratch/v5-fit-loop/dcache-compact-lock/prepare-state-proof.py
new file mode 100644
index 0000000..51f5e14
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-compact-lock/prepare-state-proof.py
@@ -0,0 +1,135 @@
+"""Build an Icarus miter from the exact retained and candidate FSM modules."""
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+work = Path('build/sim/v5-104-dcache-compact-lock/state-proof')
+work.mkdir(parents=True, exist_ok=True)
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+
+
+def extract_module(leg, name):
+    netlist = (stage / leg / rtl).read_text()
+    return re.search(rf'^module {name} \(.*?^endmodule$', netlist, re.M | re.S)[0]
+
+
+name = 'ngage2_zap_dcache_fsm'
+reference = extract_module('reference', name)
+candidate = extract_module('source', name)
+region = extract_module('reference', 'ngage2_refill_region')
+assert region == extract_module('source', 'ngage2_refill_region')
+(work / 'region.v').write_text(region)
+for name, source in (('reference', reference), ('trial', candidate)):
+    (work / f'{name}.v').write_text(source.replace('module ngage2_zap_dcache_fsm (', f'module {name}_fsm ('))
+
+states = {
+    'IDLE': ('i_rd i_wr i_cache_inv i_cache_clean i_line_req i_align_fault i_fault i_busy '
+             'post_stream i_cache_en i_cacheable i_wt i_post_full post_eligible i_cache_hit '
+             'i_cache_tag_valid cache_dirty victim_alias').split(),
+    'UNCACHEABLE': ['i_wb_ack', 'i_wb_err'],
+    'UNCACHEABLE_PREPARE': [],
+    'CLEAN_SINGLE': ['writeback_next_valid', 'defer_writeback', 'keep_more', 'wait1_ff'],
+    'FETCH_SINGLE': ['take', 'beat_inc_ok', 'beat_cur_ok'],
+    'INVALIDATE': ['i_cache_inv_done'],
+    'CLEAN': ['i_cache_clean_done'],
+    'UNLOCK_REG': ['o_writeback_busy', 'wr', 'i_rd', 'i_wr'],
+    'LINEOP': ['i_line_done_tr'],
+    'UNC_DONE': [],
+    'UNLOCK_WR': ['keep_more', 'wait1_ff'],
+    'RELOOKUP0': [],
+    'RELOOKUP1': [],
+    'RELOOKUP2': [],
+}
+terms = sorted({term for branch in states.values() for term in branch})
+indices = {name: int(index) for name, index in re.findall(r"localparam \[3:0\] (\w+) = 4'd(\d+);", reference)
+           if name in states}
+assert sorted(indices.values()) == list(range(len(states)))
+assert len(re.findall(r'\bstate_ff(?:\[IDLE\])? <= ', reference)) == 3
+assert set(re.findall(r'\bstate_ff\[(\w+)\]: begin', reference)) == states.keys()
+assert reference.count('state_nxt = state_ff;') == 1
+
+tb = ["""
+`timescale 1ns/1ps
+module tb;
+    reg clk = 0;
+    reg reset = 1;
+    reg [13:0] current_state;
+    reg [13:0] hypothetical_next;
+    reg [13:0] reached;
+    integer checks = 0;
+    integer mask, state;
+    integer admissions = 0;
+    reference_fsm #(.CACHE_LINE(32), .CACHE_SIZE(16384), .WAYS(2), .HALF_WRITEBACK(1), .FLAT_ACK(1))
+        ref_dut (.i_clk(clk), .i_reset(reset), .i_reg_idx_bin(6'd0));
+    trial_fsm #(.COMPACT_LOCK(1), .CACHE_LINE(32), .CACHE_SIZE(16384), .WAYS(2), .HALF_WRITEBACK(1), .FLAT_ACK(1))
+        trial_dut (.i_clk(clk), .i_reset(reset), .i_reg_idx_bin(6'd0));
+
+    task pulse;
+        begin
+            #1 clk = 1;
+            #1 clk = 0;
+        end
+    endtask
+
+    task check_next_state;
+        begin
+            #1;
+            if ((^ref_dut.state_nxt === 1'bx) || (ref_dut.state_nxt == 0) ||
+                ((ref_dut.state_nxt & (ref_dut.state_nxt - 14'd1)) != 0))
+                $fatal(1, "Non-one-hot next state for %h mask %h: %h", current_state, mask, ref_dut.state_nxt);
+            if (trial_dut.state_nxt !== ref_dut.state_nxt)
+                $fatal(1, "Different next state for %h mask %h", current_state, mask);
+            if (trial_dut.lock_set_nxt !== ref_dut.lock_set_nxt)
+                $fatal(1, "Changed lock admission for state %h mask %h", current_state, mask);
+            if (ref_dut.lock_set_nxt) begin
+                if (!ref_dut.state_ff[ref_dut.IDLE] ||
+                    !(ref_dut.state_nxt[ref_dut.FETCH_SINGLE] || ref_dut.state_nxt[ref_dut.CLEAN_SINGLE]))
+                    $fatal(1, "Lock install did not start a read fill");
+                if (ref_dut.state_nxt[ref_dut.CLEAN_SINGLE] && !ref_dut.victim_alias)
+                    $fatal(1, "Read install must lead directly to fetch after dirty writeback");
+                admissions = admissions + 1;
+            end
+            if (ref_dut.state_ff[ref_dut.CLEAN_SINGLE] && !ref_dut.defer_writeback &&
+                !(ref_dut.state_nxt[ref_dut.CLEAN_SINGLE] || ref_dut.state_nxt[ref_dut.FETCH_SINGLE]))
+                $fatal(1, "Aliasing writeback can bypass its fill");
+            reached = reached | ref_dut.state_nxt;
+            checks = checks + 1;
+        end
+    endtask
+"""]
+tb.extend(f'    reg {term} = 0;\n' for term in terms)
+tb.append('    initial begin\n')
+for term in terms:
+    for dut in ('ref_dut', 'trial_dut'):
+        tb.append(f'        force {dut}.{term} = {term};\n')
+tb.append("""
+        pulse;
+        if (ref_dut.state_ff !== 14'd1 || trial_dut.state_ff !== 14'd1)
+            $fatal(1, "Cold reset failed");
+        reset = 0;
+        force ref_dut.state_ff = current_state;
+        force trial_dut.state_ff = current_state;
+""")
+for state, state_terms in states.items():
+    tb.extend((f'        current_state = 14\'d{1 << indices[state]};\n',
+               '        reached = 0;\n',
+               f'        for (mask = 0; mask < {1 << len(state_terms)}; mask = mask + 1) begin\n'))
+    tb.extend(f'            {term} = mask[{index}];\n' for index, term in enumerate(state_terms))
+    tb.append('            check_next_state;\n        end\n')
+    tb.extend(f'        {term} = 0;\n' for term in state_terms)
+    tb.append(f'        $display("TRANSITION {state} controls={1 << len(state_terms)} successors=%h", reached);\n')
+tb.append("""
+        release ref_dut.state_ff;
+        release trial_dut.state_ff;
+        reset = 1;
+        pulse;
+        if (ref_dut.state_ff !== 14'd1 || trial_dut.state_ff !== 14'd1 ||
+            ref_dut.o_lock_any !== 1'b0 || trial_dut.o_lock_any !== 1'b0)
+            $fatal(1, "Warm reset failed");
+        $display("PASS next_state_cases=%0d lock_admission_cases=%0d resets=2", checks, admissions);
+        $finish;
+    end
+endmodule
+""")
+(work / 'tb.sv').write_text(''.join(tb))
