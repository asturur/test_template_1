@@ -0,0 +1,47 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/dcache-compact-lock
+out=build/sim/v5-104-dcache-compact-lock/board
+fixture=tests/cpu/arm9v2_board
+mkdir -p "$out"
+arm-none-eabi-gcc -c -mcpu=arm920t -marm -DEXPECTED_CTYPE=0x0514a14a -DASSOC_WAYS=2 \
+    -DSECTION_INDEX_TEST "$area/reference/$fixture/contract.S" -o "$out/guest.o"
+arm-none-eabi-ld -T "$area/reference/sim/programs/link.ld" "$out/guest.o" -o "$out/guest.elf"
+arm-none-eabi-objcopy -O binary "$out/guest.elf" "$out/guest.bin"
+python3 -B - "$out" <<'PY'
+from pathlib import Path
+import struct
+import sys
+
+out = Path(sys.argv[1])
+words = struct.iter_unpack('<I', (out / 'guest.bin').read_bytes())
+(out / 'guest.hex').write_text(''.join(f'{word:08x}\n' for (word,) in words))
+PY
+
+for leg in reference source; do
+    mkdir -p "$out/$leg"
+    docker run --rm --pull=never --network none --platform linux/arm64 \
+        -v "$PWD/$area/$leg:/work:ro" -v "$PWD/$out:/results" -w /work \
+        --entrypoint sh jotego/simulator:arm64 -ec '
+        out=/results/$1
+        verilator --binary --timing --assert -j 2 \
+            -Wno-fatal -Wno-lint -DNGAGE_ARM9V2 --top-module contract --Mdir "$out/obj" \
+            rtl/ngage_cpu.sv rtl/ngage_upp.v rtl/arm9v2/arm925t_phone.v \
+            rtl/arm9v2/upstream/sim/stubs/*.sv tests/cpu/arm9v2_board/contract.v > "$out/build.log" 2>&1
+        for burst in 0 1; do
+            for wait in 0 5; do
+                log="$out/burst-$burst-wait-$wait.log"
+                "$out/obj/Vcontract" +program=/results/guest.hex "+wait=$wait" "+burst=$burst" \
+                    +half-writeback +section-reads=2 > "$log" 2>&1
+                grep -E "^(PASS|LINES|ASSOC|SECTION|DATA_FAULT|REFILL_FAULT) " "$log" > "${log%.log}.trace"
+                grep -q "^PASS " "$log"
+            done
+        done' board "$leg"
+done
+for burst in 0 1; do
+    for wait in 0 5; do
+        name=burst-$burst-wait-$wait.trace
+        cmp "$out/reference/$name" "$out/source/$name"
+        grep '^PASS ' "$out/source/$name"
+    done
+done
diff --git a/scratch/v5-fit-loop/dcache-compact-lock/check-lock-update.v b/scratch/v5-fit-loop/dcache-compact-lock/check-lock-update.v
new file mode 100644
index 0000000..6d08c5a
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-compact-lock/check-lock-update.v
@@ -0,0 +1,36 @@
+`timescale 1ns / 1ps
+
+module check_lock_update;
+    reg valid, install;
+    reg [5:0] held_tag, incoming_tag;
+    reg [63:0] returned;
+    wire [63:0] previous = valid ? 64'd1 << held_tag : 64'd0;
+    wire [63:0] bitmap = (previous & ~returned) | (install ? 64'd1 << incoming_tag : 64'd0);
+    wire next_valid = install || (valid && !returned[held_tag]);
+    wire [5:0] next_tag = install ? incoming_tag : held_tag;
+    integer old_idx, new_idx, return_idx, mode, coverage = 0;
+
+    initial begin
+        for (mode = 0; mode < 4; mode = mode + 1) begin
+            {valid, install} = mode[1:0];
+            for (old_idx = 0; old_idx < 64; old_idx = old_idx + 1) begin
+                held_tag = old_idx[5:0];
+                for (new_idx = 0; new_idx < 64; new_idx = new_idx + 1) begin
+                    incoming_tag = new_idx[5:0];
+                    for (return_idx = 0; return_idx <= 64; return_idx = return_idx + 1) begin
+                        returned = 64'd1 << return_idx;
+                        #1;
+                        if (next_valid !== (|bitmap))
+                            $fatal(1, "scalar valid differs from bitmap nonempty");
+                        if (!(valid && install && !returned[held_tag] && held_tag != incoming_tag) &&
+                            bitmap !== (next_valid ? 64'd1 << next_tag : 64'd0))
+                            $fatal(1, "single-owner tag differs from bitmap");
+                        coverage = coverage + 1;
+                    end
+                end
+            end
+        end
+        $display("PASS scalar valid equals bitmap nonempty over %0d transitions", coverage);
+        $finish;
+    end
+endmodule
