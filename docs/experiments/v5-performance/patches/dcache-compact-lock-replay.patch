+++ b/scratch/v5-fit-loop/dcache-compact-lock/record.py
@@ -0,0 +1,117 @@
+"""Record the exact compact D-cache lock source, transition tests and replays."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shlex
+
+
+stage = Path(__file__).resolve().parent
+root = stage.parents[2]
+out = root / 'build/sim/v5-104-dcache-compact-lock'
+timer = root / 'build/sim/v5-104-timer-write-prepare'
+rtls = ('rtl/arm9v2/arm925t_phone.v', 'tools/gen_arm9v2_phone.py')
+netlist = rtls[0]
+base = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+base_tree = '0ccd13d8cd502bc14d3b89c6431ff0ebe4745612'
+patch = stage / 'dcache-compact-lock.patch'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def read_json(path):
+    return json.loads(path.read_bytes())
+
+
+def passes(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+def fingerprint(manifest, suffix):
+    records = [shlex.split(line) for line in manifest.read_text().splitlines()
+               if line.startswith('S ') and line.endswith(f'{suffix}"')]
+    (record,) = records
+    return record[-2]
+
+
+source = {name: digest(stage / 'source' / name) for name in rtls}
+reference = {name: digest(stage / 'reference' / name) for name in rtls}
+assert source[netlist] != reference[netlist]
+assert reference[netlist] == '4aa8037c0051b43819de2dc9d9f96322ea2e2bb2d91c82df1383ad6840d5d37e'
+proof = passes(out / 'state-proof/run.log')
+formula = passes(out / 'directed/formula.log')
+directed = passes(out / 'directed/directed.log')
+old_fixture = passes(out / 'directed/source.log')
+assert proof == ['PASS next_state_cases=262203 lock_admission_cases=576 resets=2']
+assert formula == ['PASS scalar valid equals bitmap nonempty over 1064960 transitions']
+assert 'cycles=1281 simultaneous=2 cached_errors=1' in directed[0]
+assert 'fills=66 returns=66 hits_under_miss=64' in directed[1]
+assert 'fills=65 returns=65 hits_under_miss=64' in old_fixture[0]
+assert old_fixture == passes(out / 'directed/reference.log')
+
+mixer = out / 'mixed'
+finger = fingerprint(mixer / 'obj/Vtb__verFiles.dat', netlist)
+assert digest(mixer / 'source' / netlist) == source[netlist]
+control_hashes = read_json(timer / 'mixed/source-hashes.json')
+candidate_hashes = read_json(mixer / 'source-hashes.json')
+assert len(control_hashes) == 114 and control_hashes.keys() == candidate_hashes.keys()
+assert {key for key in control_hashes if control_hashes[key] != candidate_hashes[key]} == {netlist}
+assert candidate_hashes[netlist] == source[netlist] and control_hashes[netlist] == reference[netlist]
+
+replays = {}
+for name, trace, log, events, clocks in (
+    ('normal', 'mixed/traffic.log', 'mixed/replay.log', 171496, 1201547),
+    ('timer_overlap', 'coexistence/candidate.trace', 'coexistence/candidate.log', 171497, 1201528),
+):
+    traffic = out / trace
+    assert digest(traffic) == digest(timer / trace)
+    assert len(traffic.read_bytes().splitlines()) == events
+    pass_rows = passes(out / log)
+    assert pass_rows == passes(timer / log)
+    assert any(f'cycles={clocks} reads=4 writes=1' in row for row in pass_rows)
+    replays[name] = {'events': events, 'cycles': clocks, 'traffic_sha256': digest(traffic), 'passes': pass_rows}
+
+board = {}
+for burst in (0, 1):
+    for wait in (0, 5):
+        profile = f'burst-{burst}-wait-{wait}.trace'
+        expected = out / 'board/reference' / profile
+        observed = out / 'board/source' / profile
+        assert digest(observed) == digest(expected) == digest(timer / 'board/source' / profile)
+        assert len(passes(observed)) == 1
+        board[profile] = {'sha256': digest(observed), 'pass': passes(observed)[0]}
+assert fingerprint(out / 'board/source/obj/Vcontract__verFiles.dat', netlist) == finger
+retained_finger = fingerprint(out / 'board/reference/obj/Vcontract__verFiles.dat', netlist)
+assert retained_finger != finger
+
+work = out / 'qualification-final'
+workload = {}
+for kind, key, expected in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = work / f'{kind}.json'
+    control = read_json(timer / 'qualification' / f'{kind}.json')
+    rows = read_json(receipt)
+    assert rows['status'] == control['status'] == 'PASS'
+    assert rows['netlist_sha256'] == source[netlist] and control['netlist_sha256'] == reference[netlist]
+    assert rows['rows'] == control['rows']
+    assert sum(len(row['candidate'][key]) for row in rows['rows']) == expected
+    assert digest(work / f'{kind}-candidate-cpu.v') == source[netlist]
+    assert fingerprint(work / f'obj-{kind}/Vtb__verFiles.dat', f'{kind}-candidate-cpu.v') == finger
+    workload[kind] = {'count': expected, 'upstream_receipt_sha256': digest(receipt)}
+native = rows['rows'][0]['candidate']
+workload['native']['cycles'] = [frame['clocks'] for frame in native['frames']]
+workload['native']['guest_result_sha256'] = native['output_sha256']
+
+report = {'status': 'PASS', 'base': base, 'base_tree': base_tree,
+          'design_patch_sha256': digest(patch),
+          'fixture_patch_sha256': digest(stage / 'dcache-compact-lock-replay.patch'),
+          'source_sha256': source, 'reference_sha256': reference,
+          'stock_sha256': digest(root / 'build/arm9v2-assoc/stock-pinned.v'),
+          'simulator': (out / 'image.id').read_text().strip(),
+          'compiled_candidate_fingerprint': finger, 'compiled_reference_fingerprint': retained_finger,
+          'state_proof': proof, 'original_exhaustive_formula': formula, 'original_directed': old_fixture,
+          'paired_fsm': directed, 'paired_fsm_fixture_sha256': digest(out / 'directed/tb.v'),
+          'board': board, 'workload': workload, 'physical_input_count': len(candidate_hashes),
+          'physical_replays': replays,
+          'routed_baseline_census_sha256': digest(stage / 'routes.json')}
+(stage / 'qualification.json').write_text(json.dumps(report, indent=2) + '\n')
diff --git a/scratch/v5-fit-loop/dcache-compact-lock/replay.py b/scratch/v5-fit-loop/dcache-compact-lock/replay.py
