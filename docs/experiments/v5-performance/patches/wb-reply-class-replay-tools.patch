+"""Enable both reply rails in the frozen physical SDRAM qualification fixtures."""
+import difflib
+
+
+def wire_reply_rails(bench):
+    changes = [
+        ('.sdram_ack(csack),', '.sdram_ack(csack_rails),'),
+        ('ngage_sdram_arbiter #(.CPU_BLOCK_WRITES(1))',
+         'ngage_sdram_arbiter #(.CPU_BLOCK_WRITES(1),.SPLIT_ACK(1))'),
+        ('.cpu_ack(csack),', '.cpu_ack(csack_rails),'),
+        ('.mem_ack(sack),', '.mem_ack(sack_rails),'),
+        ('.ack(sack),', '.ack(sack_rails),'),
+        ('wire cswe,csreq,csack,dsreq,dsack,swe,sreq;wire sack;',
+         'wire cswe,csreq,dsreq,dsack,swe,sreq;\n'
+         ' wire [1:0] csack_rails, sack_rails;\n'
+         ' wire csack = |csack_rails, sack = |sack_rails;'),
+        ('assign sack=sack_model;', 'assign sack_rails = {sack_model && swrite, sack_model && !swrite};'),
+        ('ngage_mister #(.ENABLE_DEBUGGER(1),', 'ngage_mister #(.ENABLE_DEBUGGER(1),.SPLIT_SDRAM_ACK(1),'),
+        ("ngage_sdram_stream #(.WIDE_PORT(1), .SCRUB_BYTES(25'd32))",
+         "ngage_sdram_stream #(.WIDE_PORT(1), .SCRUB_BYTES(25'd32), .SPLIT_ACK(1))"),
+    ]
+    for old, new in changes:
+        assert bench.count(old) == 1, old
+        bench = bench.replace(old, new)
+    return bench
+
+
+coverage = '''
+    integer physical_write_replies = 0, donor_write_replies = 0, donor_common_replies = 0;
+    integer donor_line_replies = 0;
+    always @(posedge clk) begin
+        if (csack_rails[1]) physical_write_replies++;
+        if (dut.board.upp.cpu_inside.cpu.donor_ack[1]) donor_write_replies++;
+        if (dut.board.upp.cpu_inside.cpu.donor_ack[0]) begin
+            donor_common_replies++;
+            if (dut.board.upp.cpu_inside.cpu.refill.state == 2'd1) donor_line_replies++;
+        end
+    end
+    final begin
+        $display("REPLY_CLASS physical_cpu_write=%0d donor_write=%0d donor_common=%0d donor_line=%0d",
+                 physical_write_replies, donor_write_replies, donor_common_replies, donor_line_replies);
+    end
+'''
+
+
+def add_coverage(bench):
+    return bench.rsplit('endmodule', 1)[0] + coverage + 'endmodule\n'
+
+
+def fixture_patch(old, new, label):
+    return ''.join(difflib.unified_diff(old.splitlines(keepends=True), new.splitlines(keepends=True),
+                                       'a/' + label, 'b/' + label))
