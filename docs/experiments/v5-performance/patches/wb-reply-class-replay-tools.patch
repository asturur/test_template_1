+"""Stage the exact candidate and fixture from the frozen mixed-pin replay."""
+from argparse import ArgumentParser
+from pathlib import Path
+from shutil import copy2, copytree
+from subprocess import run
+
+
+parser = ArgumentParser()
+parser.add_argument('fixture', type=Path)
+args = parser.parse_args()
+candidate = Path(__file__).resolve().parents[2]
+repo = candidate.parents[3]
+ref_dir = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+reference = repo / ref_dir
+relative_out = Path('build/reply-class/mixed')
+out = candidate / relative_out
+out.mkdir()
+copytree(reference / 'source', out / 'source')
+for file in ('image.hex', 'program.hex', 'stress.hex'):
+    copy2(reference / file, out / file)
+for file in ('rtl/ngage_cpu.sv', 'rtl/ngage_sdram_arbiter.v', 'rtl/ngage_sdram_stream.v',
+             'rtl/ngage_upp.v', 'rtl/ngage_board.v', 'rtl/ngage_mister.v',
+             'rtl/arm9v2/arm925t_phone.v'):
+    copy2(candidate / file, out / 'source' / file)
+(out / 'build.sh').write_text((reference / 'build.sh').read_text().replace(str(ref_dir), str(relative_out)))
+run(['patch', '-p1', '-i', str(args.fixture.resolve())], cwd=out / 'source', check=True)
