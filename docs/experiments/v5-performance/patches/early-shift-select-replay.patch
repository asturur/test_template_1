+                  $fatal(1, "Overflow phase %0d refilled %0d lines", assoc_phase, assoc_fills);
+                default: $fatal(1, "Unexpected cache diagnostic phase");
+              endcase
+              $display(
+                  "ASSOC phase=%0d ways=%0d clocks=%0d write_words=%0d fills=%0d empty_groups=%0d",
+                  assoc_phase, assoc_ways, cycle - assoc_started, assoc_words, assoc_fills,
+                  assoc_empty_groups);
+            end
+          end
+          32'hf0000000: begin
+`ifdef NGAGE_STORE_LIST_CONTRACT
+            if (store_device_count != 2) $fatal(1,"Store list did not complete both uncached writes");
+`endif
+`ifdef NGAGE_BLOCK_PREDICATE_TEST
+            if (predicate_irq_seen != 1 || predicate_irq_returned != 1 || predicate_held == 0)
+              $fatal(1,"Incomplete predicate coverage irq=%0d returned=%0d held=%0d",
+                     predicate_irq_seen, predicate_irq_returned, predicate_held);
+            $display("PREDICATE_CONTRACT skips=%0d extra=%0d collapsed=%0d held=%0d irq=%0d retried=%0d",
+                     predicate_skips, predicate_extras, predicate_combined, predicate_held,
+                     predicate_irq_seen, predicate_irq_returned);
+`endif
+`ifdef NGAGE_PAIRED_LDM_TEST
+            if (pair_checks != LAST_PAIR_PHASE) $fatal(1, "Incomplete paired LDM check");
+`endif
+            if (expected_icache_bytes != 0 && (icache_checks != 5 || icache_ways != 2 ||
+                icache_sets * icache_ways * 32 != expected_icache_bytes || icache_index_sets != icache_sets))
+              $fatal(1, "I-cache capacity or index verification failed");
+            if (expected_section_reads != 0 && section_checks != 2)
+              $fatal(1, "Both section-index phases must complete");
+            if (capacity_markers != 2 || ram[14'h2400] != 32'h0a009000)
+              $fatal(
+                  1,
+                  "D-cache capacity/upper index clean failed, RAM=%h markers=%d",
+                  ram[14'h2400],
+                  capacity_markers
+              );
+            if (burst_enable != 0 ? ram_lines < 512 || rom_lines == 0 : rejected_lines == 0)
+              $fatal(1, "Line transport was not exercised");
+            if (device_wdata != 32'h50415353 || scalar_faults != 1 || refill_faults == 0 ||
+                prefetch_aborts != 1 + icr_pabt_checks || translation_walks == 0 ||
+                        irq_writes != irq_expected + flow_irq_seen || fiq_writes != 2 || swap_beats != 2 || clean_writes != 1 ||
+                        ram[0] != 32'h55667788)
+              $fatal(
+                  1,
+                  "Guest result=%h scalar_faults=%0d refill_faults=%0d IRQ=%0d FIQ=%0d SWP=%0d clean=%0d RAM0=%h",
+                  device_wdata,
+                  scalar_faults,
+                  refill_faults,
+                  irq_writes,
+                  fiq_writes,
+                  swap_beats,
+                  clean_writes,
+                  ram[0]
+              );
+`ifdef NGAGE_MULTIPLY_SCHEDULE_TEST
+            if (early_smull == 0) $fatal(1, "Early SMULL path was not exercised");
+            $display("SMULL early=%0d wb_operand=%0d", early_smull, early_smull_w_operand);
+`endif
+            $display(
+                "PASS cycles=%0d scalar_wait_cycles=%0d swp_beats=%0d clean_writes=%0d walks=%0d prefetch_aborts=%0d",
+                cycle, wait_words, swap_beats, clean_writes, translation_walks, prefetch_aborts);
+            $display("LINES ram=%0d rom=%0d rejected=%0d resident_capacity_bytes=16384", ram_lines,
+                     rom_lines, rejected_lines);
+            $finish;
+          end
+          default: $fatal(1, "Unexpected device write %h", device_address);
+        endcase
+      end
+
+      if (swap_beats == 1 && !lock) $fatal(1, "SWPB lock dropped between beats");
+      if (ram_accept) begin
+        if (observe_sections && !ram_write && (ram_address == 32'h0a004400 || ram_address == 32'h0a006000))
+          section_reads <= section_reads + 1;
+        if (verify_resident && !ram_write)
+          $fatal(1, "Capacity check accessed scalar RAM at %h PC=%h", ram_address, pc);
+        if (!ram_write && ram_address == 32'h0a0042c0) translation_walks <= translation_walks + 1;
+        if (lock) begin
+          if (ram_address[31:2] != 30'h02800000 || (ram_write != (swap_beats == 1)) ||
+                    (ram_write && (ram_be != 4'b0010 || ram_wdata[15:8] != 8'haa)))
+            $fatal(
+                1,
+                "Bad swap beat address=%h write=%b be=%h data=%h",
+                ram_address,
+                ram_write,
+                ram_be,
+                ram_wdata
+            );
+          swap_beats <= swap_beats + 1;
+        end
+        ram_pending <= 1;
+        ram_delay <= wait_cycles + 1;
+        ram_index <= ram_address[15:2];
+        ram_saved_write <= ram_write;
+        ram_saved_data <= ram_wdata;
+        ram_saved_be <= ram_be;
+      end else if (ram_ack) begin
+        ram_pending <= 0;
+        if (ram_saved_write) begin
+          if (assoc_phase && assoc_phase <= 5) begin
+            assoc_words <= assoc_words + 1;
+            if (ram_saved_be != 15) $fatal(1, "Writeback used partial byte lanes");
+          end
+          for (lane = 0; lane < 4; lane = lane + 1)
+          if (ram_saved_be[lane]) ram[ram_index][lane*8+:8] <= ram_saved_data[lane*8+:8];
+          if (ram_index == 0 && ram_saved_data == 32'h55667788 && ram_saved_be == 15)
+            clean_writes <= clean_writes + 1;
+        end
+      end else if (ram_pending) ram_delay <= ram_delay - 1;
+    end
+
+  initial begin
+    if (!$value$plusargs("program=%s", program_file) || !$value$plusargs("wait=%d", wait_cycles))
+      $fatal(1, "Specify the guest image and wait profile");
+    if (!$value$plusargs("burst=%d", burst_enable)) burst_enable = 1;
+    if (!$value$plusargs("section-reads=%d", expected_section_reads)) expected_section_reads = 0;
+    if ($value$plusargs("icache-bytes=%d", expected_icache_bytes)) begin
+      ram[14'h07f8] = 32'he3a00001;  // mov r0,#1; bx lr
+      ram[14'h07f9] = 32'he12fff1e;
+      ram[14'h0ff8] = 32'he3a00002;
+      ram[14'h0ff9] = 32'he12fff1e;
+      ram[14'h17f8] = 32'he3a00003;
+      ram[14'h17f9] = 32'he12fff1e;
+    end
+    $readmemh(program_file, rom);
+    repeat (4) @(negedge clk);
+    reset = 0;
+  end
+`define EXEC_S cpu.u_arm925t.u_zap.g_arm9.u_arm9_core.u_execute
+  wire direct_shift_sample = `EXEC_S.i_valid && `EXEC_S.i_reg_shift &&
+      `EXEC_S.i_kind == 0 && !`EXEC_S.i_thumb && !`EXEC_S.prepared;
+  integer held_shift = 0, accepted_shift = 0, forwarded_rs = 0;
+  always @(posedge clk) if (!reset && direct_shift_sample) begin
+    if (`EXEC_S.s_wait[2] && !`EXEC_S.accept) held_shift <= held_shift + 1;
+    if (`EXEC_S.accept) begin
+      accepted_shift <= accepted_shift + 1;
+      if (`EXEC_S.s_load_hit && `EXEC_S.i_load_owner[1] && `EXEC_S.i_forward_match[10])
+        forwarded_rs <= forwarded_rs + 1;
+    end
+  end
+  final
+    $display("DIRECT_SHIFT_CONTRACT held=%0d accepted=%0d forwarded_rs=%0d",
+             held_shift, accepted_shift, forwarded_rs);
+endmodule
