+#!/bin/sh
+set -eu
+
+name=${1:?specify a fresh run name}
+case "$name" in
+    *[!A-Za-z0-9_.-]*) echo "Invalid run name: $name" >&2; exit 2 ;;
+esac
+out=build/sim/arm9v2/contract-"$name"
+mkdir -p build/sim/arm9v2
+mkdir "$out"
+fixture=tests/cpu/arm9v2_board
+netlist=${ARM9V2_NETLIST:-rtl/arm9v2/arm925t_phone.v}
+cpu_wrapper=${ARM9V2_CPU_WRAPPER:-rtl/ngage_cpu.sv}
+section_reads=
+case "${ARM9V2_SECTION_INDEX:-}" in
+    direct) section_reads=8 ;;
+    xor) section_reads=2 ;;
+    '') ;;
+    *) echo 'ARM9V2_SECTION_INDEX must be direct or xor' >&2; exit 2 ;;
+esac
+set --
+if [ -n "${ARM9V2_ASSOC_WAYS:-}" ]; then set -- "$@" "-DASSOC_WAYS=$ARM9V2_ASSOC_WAYS"; fi
+if [ -n "$section_reads" ]; then set -- "$@" -DSECTION_INDEX_TEST; fi
+multiply_define=
+if [ "${ARM9V2_MULTIPLY_TEST:-0}" = 1 ]; then set -- "$@" -DMULTIPLY_SCHEDULE_TEST; fi
+if [ "${ARM9V2_SMULL_COVERAGE:-0}" = 1 ]; then multiply_define=-DNGAGE_MULTIPLY_SCHEDULE_TEST; fi
+if [ "${ARM9V2_REGISTER_SHIFT_TEST:-0}" = 1 ]; then set -- "$@" -DREGISTER_SHIFT_TEST; fi
+predicate_define=
+if [ "${ARM9V2_BLOCK_PREDICATE_TEST:-0}" = 1 ]; then
+    set -- "$@" -DBLOCK_PREDICATE_TEST
+    predicate_define=-DNGAGE_BLOCK_PREDICATE_TEST
+fi
+load_use_define=
+if [ "${ARM9V2_LOAD_USE_TEST:-0}" = 1 ]; then
+    set -- "$@" -DLOAD_USE_TEST
+    load_use_define=-DNGAGE_LOAD_USE_TEST
+fi
+if [ "${ARM9V2_LOAD_WAW_TEST:-0}" = 1 ]; then set -- "$@" -DLOAD_WAW_TEST; fi
+mac_timing_define=
+if [ "${ARM9V2_MAC_TIMING_TEST:-0}" = 1 ]; then
+    set -- "$@" -DMAC_TIMING_TEST
+    mac_timing_define=-DNGAGE_MAC_TIMING_TEST
+fi
+icache_restart_define=
+icache_restart_early=
+icache_hum_define=
+case "${ARM9V2_ICACHE_HUM_TEST:-0}" in
+    1)
+        set -- "$@" -DHIT_UNDER_MISS_TEST
+        icache_hum_define=-DNGAGE_IC_HUM_CONTRACT
+        ;;
+    control) set -- "$@" -DHIT_UNDER_MISS_TEST ;;
+    guarantee) icache_hum_define=-DNGAGE_IC_HUM_CONTRACT ;;
+esac
+if [ "${ARM9V2_ICACHE_RESTART_TEST:-0}" = 1 ]; then
+    set -- "$@" -DICACHE_RESTART_TEST
+    icache_restart_define=-DNGAGE_IC_RESTART_CONTRACT
+fi
+if [ "${ARM9V2_ICACHE_RESTART_EARLY:-0}" = 1 ]; then
+    icache_restart_early=-DNGAGE_IC_RESTART_EARLY
+fi
+control_flow_define=
+if [ "${ARM9V2_CONTROL_FLOW_TEST:-0}" = 1 ]; then
+    set -- "$@" -DCONTROL_FLOW_TEST
+    control_flow_define=-DNGAGE_CONTROL_FLOW_CONTRACT
+fi
+store_list_define=
+if [ "${ARM9V2_STORE_LIST_TEST:-0}" = 1 ]; then
+    set -- "$@" -DSTORE_LIST_TEST
+    store_list_define=-DNGAGE_STORE_LIST_CONTRACT
+fi
+paired_ldm_define=
+issue_ldm_define=
+stale_hint_define=
+if [ "${ARM9V2_PAIRED_LDM_TEST:-0}" = 1 ]; then
+    set -- "$@" -DPAIRED_LDM_TEST
+    paired_ldm_define=-DNGAGE_PAIRED_LDM_TEST
+fi
+if [ "${ARM9V2_ISSUE_LDM_TEST:-0}" = 1 ]; then
+    set -- "$@" -DPAIRED_LDM_TEST -DISSUE_LDM_TEST
+    paired_ldm_define=-DNGAGE_PAIRED_LDM_TEST
+    issue_ldm_define=-DNGAGE_ISSUE_LDM_TEST
+    if [ "${ARM9V2_ISSUE_LDM_FORCE_STALE:-0}" = 1 ]; then
+        stale_hint_define=-DNGAGE_ISSUE_LDM_STALE_HINT_TEST
+    fi
+fi
+case "${ARM9V2_ICACHE_BYTES:-}" in
+    16384|32768) set -- "$@" -DICACHE_INDEX_TEST ;;
+    '') ;;
+    *) echo 'ARM9V2_ICACHE_BYTES must be 16384 or 32768' >&2; exit 2 ;;
+esac
+arm-none-eabi-gcc -c -mcpu=arm920t -marm "-DEXPECTED_CTYPE=${ARM9V2_CTYPE:-0x0514a14a}" "$@" "$fixture/contract.S" -o "$out/guest.o"
+arm-none-eabi-ld -T sim/programs/link.ld "$out/guest.o" -o "$out/guest.elf"
+arm-none-eabi-objcopy -O binary "$out/guest.elf" "$out/guest.bin"
+python3 - "$out" <<'PY'
+from pathlib import Path
+import struct
+import sys
+
+out = Path(sys.argv[1])
+words = struct.iter_unpack('<I', (out / 'guest.bin').read_bytes())
+(out / 'guest.hex').write_text(''.join(f'{word:08x}\n' for (word,) in words))
+PY
+image=jotego/simulator:arm64
+simulation() {
+    docker run --rm --pull=never --network none --platform linux/arm64 \
+        -v "$PWD:/work" -w /work --entrypoint "$@"
+}
+simulation verilator "$image" --binary --timing --assert -j 2 \
+    -Wno-fatal -Wno-lint -DNGAGE_ARM9V2 ${paired_ldm_define:+"$paired_ldm_define"} ${issue_ldm_define:+"$issue_ldm_define"} ${stale_hint_define:+"$stale_hint_define"} ${predicate_define:+"$predicate_define"} \
+    ${load_use_define:+"$load_use_define"} ${mac_timing_define:+"$mac_timing_define"} ${multiply_define:+"$multiply_define"} ${store_list_define:+"$store_list_define"} \
+    ${control_flow_define:+"$control_flow_define"} -I"$fixture" --top-module contract --Mdir "$out/obj" \
+    ${icache_restart_define:+"$icache_restart_define"} ${icache_restart_early:+"$icache_restart_early"} ${icache_hum_define:+"$icache_hum_define"} \
+    "$cpu_wrapper" rtl/ngage_upp.v "$netlist" \
+    rtl/arm9v2/upstream/sim/stubs/*.sv "$fixture/contract.v" > "$out/build.log" 2>&1
+for burst in 0 1; do
+    for wait in 0 5; do
+        log="$out/burst-$burst-wait-$wait.log"
+        set --
+        if [ "${ARM9V2_LOAD_USE_TEST:-0}" = 1 ]; then
+            begin_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "load_use_word_add" {print $1}')
+            end_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "load_use_trace_end" {print $1}')
+            set -- "$@" "+load-use-begin=$begin_pc" "+load-use-end=$end_pc"
+        fi
+        if [ "${ARM9V2_MAC_TIMING_TEST:-0}" = 1 ]; then
+            begin_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "mac_timing_mla_result" {print $1}')
+            end_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "mac_timing_end" {print $1}')
+            set -- "$@" "+mac-timing-begin=$begin_pc" "+mac-timing-end=$end_pc"
+        fi
+        if [ "${ARM9V2_ICACHE_RESTART_TEST:-0}" = 1 ]; then
+            begin_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "icr_test_begin" {print $1}')
+            end_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "icr_test_end" {print $1}')
+            set -- "$@" "+icr-begin=$begin_pc" "+icr-end=$end_pc" +ic-trace
+            if [ "${ARM9V2_ICACHE_HUM_TEST:-0}" = 1 ]; then set -- "$@" +hum-trace; fi
+            if [ "${ARM9V2_NO_LINE_GUARANTEE:-0}" = 1 ]; then set -- "$@" +no-line-guarantee; fi
+        fi
+        if [ "${ARM9V2_CONTROL_FLOW_TEST:-0}" = 1 ]; then
+            begin_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "flow_test_begin" {print $1}')
+            end_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "flow_test_end" {print $1}')
+            irq_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "flow_thumb_bx_lr" {print $1}')
+            return_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "flow_thumb_after_bx" {print $1}')
+            set -- "$@" "+flow-begin=$begin_pc" "+flow-end=$end_pc" "+flow-irq=$irq_pc" "+flow-return=$return_pc" +flow-trace +flow-stages
+        fi
+        if [ "${ARM9V2_STORE_LIST_TEST:-0}" = 1 ]; then
+            begin_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "store_timing_scalar2" {print $1}')
+            end_pc=$(arm-none-eabi-nm "$out/guest.elf" | awk '$3 == "store_timing_device_end" {print $1}')
+            set -- "$@" "+store-timing-begin=$begin_pc" "+store-timing-end=$end_pc"
+        fi
+        if [ "${ARM9V2_HALF_WRITEBACK:-0}" = 1 ]; then set -- +half-writeback; fi
+        if [ -n "$section_reads" ]; then set -- "$@" "+section-reads=$section_reads"; fi
+        if [ -n "${ARM9V2_ICACHE_BYTES:-}" ]; then set -- "$@" "+icache-bytes=$ARM9V2_ICACHE_BYTES"; fi
+        if [ "${ARM9V2_ISSUE_LDM_HINT:-0}" = 1 ]; then set -- "$@" +paired-address-hint; fi
+        if [ "${ARM9V2_ISSUE_LDM_FORCE_STALE:-0}" = 1 ]; then set -- "$@" +paired-stale-address-hint; fi
+        simulation "/work/$out/obj/Vcontract" "$image" "+program=$out/guest.hex" "+wait=$wait" "+burst=$burst" "$@" > "$log" 2>&1
+        grep -E '^(PASS|LINES|ASSOC|SECTION|ICACHE|PAIR|PREDICATE_CONTRACT|SMULL) ' "$log"
+    done
+done
