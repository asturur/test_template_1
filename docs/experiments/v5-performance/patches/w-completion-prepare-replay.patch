+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/w-completion-prepare
+out=build/sim/v5-104-w-completion-prepare
+base=build/sim/v5-104-refill-payload-combined
+guest_source=build/sim/v5-104-sdram-block-payload
+guest_path=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed/stress.hex
+mixed="$out/mixed"
+image=jotego/simulator:arm64
+mkdir -p "$out/coexistence" "$out/block-guest"
+python3 -B "$area/mixed.py"
+
+docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD:/work" -w /work --entrypoint sh "$image" -ec "sh '$mixed/build.sh'
+'$mixed/obj/Vtb' +upp_stress '+compare_trace=$mixed/traffic.log' > '$mixed/replay.log'"
+cmp "$base/mixed/traffic.log" "$mixed/traffic.log"
+grep '^PASS ' "$mixed/replay.log"
+
+docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD:/work" -v "$PWD/$guest_source/coexistence/stress-timer.hex:/work/$guest_path:ro" \
+  -w /work --entrypoint "/work/$mixed/obj/Vtb" "$image" \
+  +upp_stress "+compare_trace=$out/coexistence/candidate.trace" > "$out/coexistence/candidate.log"
+cmp "$base/coexistence/candidate.trace" "$out/coexistence/candidate.trace"
+grep '^PASS ' "$out/coexistence/candidate.log"
+
+docker run --rm --pull=never --network none --platform linux/arm64 -v "$PWD:/work" \
+  -v "$PWD/$guest_source/block-guest/block-guest.hex:/work/$guest_path:ro" -w /work \
+  --entrypoint "/work/$mixed/obj/Vtb" "$image" +upp_stress \
+  "+compare_trace=$out/block-guest/source.trace" > "$out/block-guest/source.log"
+cmp "$base/block-guest/source.trace" "$out/block-guest/source.trace"
+awk '$1 == "Q" && $3 == "110" && ($4 == "001740" || $4 == "001744")' "$out/block-guest/source.trace"
+wc -l "$out/block-guest/source.trace"
+grep '^PASS ' "$out/block-guest/source.log"
diff --git a/scratch/v5-fit-loop/w-completion-prepare/prepare-hold.py b/scratch/v5-fit-loop/w-completion-prepare/prepare-hold.py
new file mode 100644
index 0000000..a7c59b1
--- /dev/null
+++ b/scratch/v5-fit-loop/w-completion-prepare/prepare-hold.py
@@ -0,0 +1,29 @@
+"""Match both exact legs against the timer's measured PCM phase after CPU Hold."""
+from pathlib import Path
+
+
+build = Path('build/sim')
+base = build / 'v5-104-refill-payload-combined/mixed'
+candidate = build / 'v5-104-w-completion-prepare/mixed'
+out = candidate.parent / 'hold'
+out.mkdir(parents=True, exist_ok=True)
+bench = 'source/tests/phone/mmc_mister/tb.v'
+source = (base / bench).read_text()
+assert source == (candidate / bench).read_text()
+needle = "sample_hash !== 32'h175ee178"
+assert source.count(needle) == 1
+# The original no-hold pin fixture expects independently fixed PCM phase.
+# A verified compare of a warm hold uses the same baseline PCM witness.
+source = source.replace(needle, "sample_hash !== ($test$plusargs(\"hold\") ? 32'h015ec64f : 32'h175ee178)")
+patched = out / 'tb.v'
+patched.write_text(source)
+for label, leg in (('reference', base), ('trial', candidate)):
+    command = (leg / 'build.sh').read_text()
+    old_bench = str(leg / bench)
+    old_object = str(leg / 'obj')
+    old_log = str(leg / 'build.log')
+    assert all(command.count(text) == 1 for text in (old_bench, old_object, old_log))
+    command = command.replace(old_bench, str(patched))
+    command = command.replace(old_object, str(out / f'{label}-obj'))
+    command = command.replace(old_log, str(out / f'{label}-build.log'))
+    (out / f'{label}-build.sh').write_text(command)
