index 0000000..d6a7caa
--- /dev/null
+++ b/scratch/v5-fit-loop/w-completion-prepare/routes.py
@@ -0,0 +1,70 @@
+"""Capture the sampled W completion, destination wait, and right operand routes."""
+import csv
+import json
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+base = 'ab75a622a80a5aedae347f63ae195f3da965815a'
+runs = {13: 45879015397, 43: 45879019116, 31337: 45879022396}
+
+
+def logic_nodes(path):
+    return [line.split(';')[-2].strip().removesuffix('|combout')
+            for line in path.splitlines() if '|combout' in line and 'CELL' in line]
+
+
+witnesses = {}
+for seed, run in runs.items():
+    directory = Path(f'build/timing-audit-{run}/output_files')
+    manifest = json.loads((directory / 'resident-fit-manifest.json').read_bytes())
+    assert manifest['actual_commit'] == base and manifest['seed'] == seed
+    assert manifest['physical_cpu_mhz'] == 104 and manifest['debugger'] is False
+    corners = {}
+    for corner in sorted((directory / 'timing/resident-store/104').glob('corner-*')):
+        with (corner / 'setup.csv').open() as handle:
+            rows = list(csv.DictReader(handle))
+        assert len(rows) == 1000
+        chunks = re.split(r'(?m)^Path #(\d+): Setup slack is ', (corner / 'setup.rpt').read_text(errors='replace'))
+        nodes = {int(rank): logic_nodes(detail) for rank, detail in zip(chunks[1::2], chunks[2::2], strict=True)}
+        assert len(nodes) == 100
+        detailed = [{**row, 'cells': nodes[int(row['rank'])]} for row in rows if int(row['rank']) in nodes]
+        completion = [row for row in detailed if any('|complete_class' in cell for cell in row['cells'])]
+        w_valid = [row for row in completion if row['from'].endswith('|w[541]')]
+        right_operand = [row for row in detailed
+                         if (end := re.search(r'\|ngage2_arm9v2_execute:[^|]+\|a\[(\d+)\]', row['to']))
+                         and 218 <= int(end[1]) <= 249]
+        w_tag_wait = [row for row in detailed
+                      if any('|s_wait_w_nohit' in cell for cell in row['cells'])]
+        corners[corner.name] = {
+            'sampled_paths': len(rows), 'detailed_paths': len(detailed),
+            'leading_paths': detailed[:3], 'complete_class': completion,
+            'w_valid_through_complete_class': w_valid,
+            'execute_right_operand': right_operand, 'same_destination_wait': w_tag_wait,
