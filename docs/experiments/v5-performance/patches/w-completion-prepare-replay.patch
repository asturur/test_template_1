diff --git a/scratch/v5-fit-loop/w-completion-prepare/complete-miter.sv b/scratch/v5-fit-loop/w-completion-prepare/complete-miter.sv
new file mode 100644
index 0000000..e38dc41
--- /dev/null
+++ b/scratch/v5-fit-loop/w-completion-prepare/complete-miter.sv
@@ -0,0 +1,64 @@
+`timescale 1ns/1ps
+module tb;
+    reg clk = 0, reset = 1;
+    reg [8:0] next_packet = 0;
+    reg [10:0] live_flags = 0;
+    wire [3:0] old_result[0:3], new_result[0:3];
+
+    for (genvar variant = 0; variant < 4; variant++) begin : modes
+        reference_completion #(.W_CLASS(variant >> 1), .COMPLETE_FLAT(variant & 1)) old_dut (
+            clk, reset, next_packet, live_flags, old_result[variant][2:0], old_result[variant][3]
+        );
+        trial_completion #(.W_CLASS(variant >> 1), .COMPLETE_FLAT(variant & 1)) new_dut (
+            clk, reset, next_packet, live_flags, new_result[variant][2:0], new_result[variant][3]
+        );
+    end
+
+    integer comparisons = 0;
+    reg [31:0] random_bits = 32'h31891fa3;
+
+    task compare;
+        #1;
+        for (integer mode = 0; mode < 4; mode++) begin
+            if (old_result[mode] !== new_result[mode])
+                $fatal(1, "W completion mode=%0d next=%b live=%b old=%b new=%b",
+                       mode, next_packet, live_flags, old_result[mode], new_result[mode]);
+            comparisons++;
+        end
+    endtask
+
+    task clock_edge;
+        compare;
+        clk = 1;
+        compare;
+        clk = 0;
+    endtask
+
+    initial begin
+        clk = 1;
+        compare;
+        clk = 0;
+        reset = 0;
+        for (integer packet = 0; packet < 512; packet++) begin
+            next_packet = packet[8:0];
+            clock_edge;
+            for (integer flags = 0; flags < 2048; flags++) begin
+                live_flags = flags[10:0];
+                compare;
+            end
+        end
+        for (integer index = 0; index < 4096; index++) begin
+            random_bits ^= random_bits << 13;
+            random_bits ^= random_bits >> 17;
+            random_bits ^= random_bits << 5;
+            next_packet = random_bits[8:0];
+            live_flags = random_bits[23:13];
+            if (index % 4 == 0) next_packet[index % 9] = 1'bx;
+            if (index % 3 == 0) live_flags[index % 11] = 1'bx;
+            reset = index % 63 == 0;
+            clock_edge;
+        end
+        $display("PASS exact W completion comparisons=%0d static_packets=512 live_patterns=2048 four_state=4096", comparisons);
+        $finish;
+    end
+endmodule
diff --git a/scratch/v5-fit-loop/w-completion-prepare/prepare-proof.py b/scratch/v5-fit-loop/w-completion-prepare/prepare-proof.py
new file mode 100644
index 0000000..c2f2e25
--- /dev/null
+++ b/scratch/v5-fit-loop/w-completion-prepare/prepare-proof.py
@@ -0,0 +1,89 @@
+"""Extract the exact original/prepared classification logic and W sampling statements."""
+from pathlib import Path
+import re
+
+
+area = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-w-completion-prepare/proof')
+out.mkdir(parents=True, exist_ok=True)
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+
+
+def interval(source, start, stop):
+    begin = source.index(start)
+    return source[begin:source.index(stop, begin)]
+
+
+def core(leg):
+    source = (area / leg / rtl).read_text()
+    return re.search(r'^module ngage2_arm9v2_core \(.*?^endmodule$', source, re.M | re.S)[0]
+
+
+reference, trial = map(core, ('reference', 'source'))
+for name, start, stop in (
+    ('packed W class', '\tfunction automatic [5:0] w_cls_of;', '\t(* dont_retime *) reg [541:0] m;'),
+    ('W owner and memory state selection', '\t\tm_next = m;', '\t\tnext_check_record ='),
+    ('live reply and retry', '\tassign w_exception =', '\t(* dont_retime *) reg [5:1] rf_static_class;'),
+    ('writeback exceptions and valid', '\t\twb_complete = complete_class[0];', '\t\twb_flags = w[430-:32];'),
+    ('architectural flush', '\t\twb_redirect =', '\t\t\tm <= 1\'sb0;'),
+    ('decode-to-execute ordering', '    wire d_advanced_load_writer;', '    wire s_may_write_flags ='),
+):
+    assert interval(trial, start, stop) == interval(reference, start, stop), name
+
+start = '\twire fast_pc_hit ='
+finish = '\twire [23:0] advance_tag;'
+old_condition = interval(reference, start, finish)
+new_condition = interval(trial, '    // These selects follow the same owner', finish)
+stamp = re.search(r'            w_completion_eligible <= w_completion_of\([^;]+\);', trial)[0]
+assert 'w_next[541]' in stamp and 'memory_state_next' in stamp and 'w_cls_next[3]' in stamp
+assert '            w_completion_eligible <= 0;' in trial
+assert new_condition.count('if ((request_done && resp_err) && w_blkwb)') == 2
+
+for label, condition, update in (
+    ('reference', old_condition, ''),
+    ('trial', new_condition, stamp),
+):
+    reset_selects = 'w_completion_eligible <= 0;' if update else ''
+    wrapper = f"""
+module {label}_completion #(parameter W_CLASS = 1, COMPLETE_FLAT = 1) (
+    input clk, i_reset,
+    input [8:0] next_packet,
+    input [10:0] live,
+    output reg [2:0] complete_class,
+    output wire done
+);
+    reg _sv2v_0 = 0;
+    reg [541:0] w, w_next;
+    reg [5:0] w_cls;
+    wire [5:0] w_cls_next = {{next_packet[7:5], 3'b0}};
+    reg [3:0] memory_state;
+    wire [3:0] memory_state_next = next_packet[3:0];
+    wire w_exception = w_cls[5], w_cp = w_cls[4], w_swp = w_cls[3];
+    wire w_pc_load = 1, w_waited = 0;
+    wire wb_flush, i_dc_lock_any, cp_finished, w_locked, request_done, retry;
+    wire resp_err, w_mem_immediate, i_data_short_hit, defer_load, w_blkwb;
+    assign {{wb_flush, i_dc_lock_any, cp_finished, w_locked, request_done, retry,
+             resp_err, w_mem_immediate, i_data_short_hit, defer_load, w_blkwb}} = live;
+    assign done = !w[541] || complete_class[1];
+{condition}
+    always @* begin
+        w_next = 0;
+        w_next[541] = next_packet[8];
+        w_next[535] = next_packet[4];
+    end
+    always @(posedge clk) begin
+        if (i_reset) begin
+            w <= 0;
+            w_cls <= 0;
+            memory_state <= 0;
+            {reset_selects}
+        end else begin
+            w <= w_next;
+            w_cls <= w_cls_next;
+            memory_state <= memory_state_next;
+            {update}
+        end
+    end
+endmodule
+"""
+    (out / f'{label}.v').write_text(wrapper)
