@@ -0,0 +1,25 @@
+"""Attach the legacy-count observer and prepare long MMC transfer cases."""
+from pathlib import Path
+
+
+stage = Path(__file__).resolve().parent
+fixture = 'tests/phone/mmc_host/data_tb.v'
+reference = (stage/'reference'/fixture).read_text()
+observer = (stage/'count-observer.vh').read_text()
+entry = '    always @(posedge clk)begin cycles'
+assert reference.count(entry) == reference.count('$finish;') == 1
+candidate = reference.replace(entry, observer+entry, 1).replace('$finish;',
+    '$display("COUNT checked reads=%0d writes=%0d group_crossings=%0d", '
+    'count_reads, count_writes, count_crossings); $finish;')
+(stage/'source'/fixture).write_text(candidate)
+
+for name, bench in [('source', candidate), ('reference', reference)]:
+    marker = '        $display("PASS MMC host data peer'
+    assert bench.count(marker) == 1
+    long_test = bench.replace(marker, '        tx_case(4096,21,0,0,0,6);\n'
+                              '        rx_case(4096,22,0,0,9);\n'+marker)
+    long_test = long_test.replace('[8191:0]', '[32799:0]').replace('[8190:0]', '[32798:0]')
+    long_test = long_test.replace("8192'h11021", "32800'h11021")
+    out = Path('build/sim/v5-104-lane13-mmc-combined/mmc') / name / 'sim/unit-mmc-host'
+    out.mkdir(parents=True, exist_ok=True)
+    (out/'long_tb.v').write_text(long_test)
