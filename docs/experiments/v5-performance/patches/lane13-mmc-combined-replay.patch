+++ b/scratch/v5-fit-loop/lane13-mmc-combined/preflight.py
@@ -0,0 +1,71 @@
+"""Check each private lane 13 tree against the retained production fit inputs."""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+repo = stage.parents[2]
+private = stage / 'dispatch-20261126'
+provenance = json.loads((private / 'prepare.json').read_text())
+output = private / 'preflight'
+output.mkdir(exist_ok=True)
+controls = {13: 45771268571, 43: 45771267820, 31337: 45771266151}
+
+
+def git(*args, env=None):
+    return subprocess.check_output(['git', '-C', str(repo), *args], env=env)
+
+
+root_objects = Path(git('rev-parse', '--path-format=absolute', '--git-path', 'objects').decode().strip())
+alternate_objects = [root_objects]
+for trial in ('mmc-count-prepare', 'wb-reply-class'):
+    alternate = stage.parent / trial / 'dispatch-20261126/objects'
+    if alternate.is_dir():
+        alternate_objects.append(alternate)
+env = os.environ | {
+    'GIT_OBJECT_DIRECTORY': str(private / 'objects'),
+    'GIT_ALTERNATE_OBJECT_DIRECTORIES': os.pathsep.join(map(str, alternate_objects)),
+}
+
+
+def source_hashes(commit, paths):
+    return {name: sha256(git('show', f'{commit}:{name}', env=env)).hexdigest() for name in paths}
+
+
+retained = provenance['retained']
+reference = json.loads((repo / f'build/timing-audit-{controls[13]}/output_files/resident-fit-manifest.json').read_text())
+selected = {name: digest for name, digest in reference['compiled_source_sha256'].items() if name != 'Template.qsf'}
+assert source_hashes(retained, selected) == selected
+for leg, candidate in provenance['candidates'].items():
+    commit = candidate['sha']
+    expected = source_hashes(commit, selected)
+    changed = sorted(name for name in selected if selected[name] != expected[name])
+    assert changed == candidate['changes_since_retained']
+    assert {name: expected[name] for name in changed} == candidate['file_sha256']
+    qsf_bytes = git('show', f'{commit}:Template.qsf', env=env)
+    assert qsf_bytes == git('show', f'{retained}:Template.qsf', env=env)
+    for seed, run in controls.items():
+        control_path = repo / f'build/timing-audit-{run}/output_files/resident-fit-manifest.json'
+        control = json.loads(control_path.read_text())
+        check = {name: digest for name, digest in control['compiled_source_sha256'].items() if name != 'Template.qsf'}
+        assert check == selected
+        assert git('rev-parse', f"{control['actual_commit']}^{{tree}}", env=env).decode().strip() == provenance['retained_tree']
+        assert int(control['seed']) == seed and control['physical_cpu_mhz'] == 104 and not control['debugger']
+        qsf = output / f'{leg}-{seed}.qsf'
+        qsf.write_bytes(qsf_bytes)
+        for tool, option, value in (('seed', '--seed', str(seed)), ('debug', '--enabled', 'false')):
+            subprocess.run(['python3', '-B', str(stage / f'source/tools/set_quartus_{tool}.py'),
+                            str(qsf), option, value], cwd=output, check=True, stdout=subprocess.PIPE)
+        effective_qsf = qsf.read_text().replace('LAST_QUARTUS_VERSION "17.0.2 Standard Edition"',
+                                              'LAST_QUARTUS_VERSION "17.0.2 Lite Edition"')
+        qsf.write_text(effective_qsf)
+        assert effective_qsf == control['effective_qsf']
+        receipt = {'candidate': commit, 'parent': candidate['parent'], 'seed': seed,
+                   'control_run': run, 'physical_cpu_mhz': 104, 'debugger': False,
+                   'expected_changed_inputs': changed, 'expected_effective_qsf': effective_qsf,
+                   'compiled_source_sha256': expected}
+        (output / f'{leg}-{seed}.json').write_text(json.dumps(receipt, indent=2) + '\n')
+        print(f'PASS {leg} seed {seed}, {len(expected)} selected source files and effective QSF')
diff --git a/scratch/v5-fit-loop/lane13-mmc-combined/record-qualification.py b/scratch/v5-fit-loop/lane13-mmc-combined/record-qualification.py
new file mode 100644
index 0000000..af1fe56
--- /dev/null
+++ b/scratch/v5-fit-loop/lane13-mmc-combined/record-qualification.py
@@ -0,0 +1,151 @@
+"""Verify and summarize the combined MMC and lane 13 replay results."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+private = stage / 'dispatch-20261126'
+out = Path('build/sim/v5-104-lane13-mmc-combined')
+work = out / 'qualification'
+retained_work = stage.parent / 'prepared-wb-write-data/candidate'
+retained_mixed = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+prepared = json.loads((private / 'prepare.json').read_text())
+stack = prepared['candidates']['keep-mmc']
+changes = stack['file_sha256']
+
+
+def digest(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def trace_digest(rows):
+    return sha256(json.dumps(rows, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+
+
+def match(trial, retained):
+    assert trial.read_bytes() == retained.read_bytes(), trial
+    return digest(trial)
+
+
+def compile_sources(manifest, prefix):
+    lines = manifest.read_text().splitlines()
+    records = [record.groups() for line in lines
+               if (record := re.fullmatch(r'S .*?"([^"]+)" "([^"]+)"', line))]
+    checked = {}
+    for path, sha in changes.items():
+        [(fingerprint, selected)] = [(code, source) for code, source in records
+                                     if source == path or source.endswith(f'/{path}')]
+        assert selected == f'{prefix}/{path}', (manifest, selected)
+        if selected.startswith('/frozen/'):
+            host_path = Path(selected.removeprefix('/frozen/'))
+        else:
+            host_path = Path(selected)
+        assert digest(host_path) == sha
+        checked[path] = {'sha256': sha, 'verilator_fingerprint': fingerprint}
+    return checked
+
+
+receipt = {'status': 'PASS', 'trees': prepared,
+           'private_preparation_sha256': digest(private / 'prepare.json'),
+           'replay_patch_sha256': digest(stage / 'lane13-mmc-combined-replay.patch'),
+           'simulator_image': 'jotego/simulator:arm64',
+           'simulator_image_identity': (out / 'image.id').read_text().strip()}
+assert all(digest(stage / 'source' / name) == sha for name, sha in changes.items())
+
+preflight = {}
+for leg, expected in prepared['candidates'].items():
+    preflight[leg] = {}
+    for seed in (13, 43, 31337):
+        proof = private / 'preflight' / f'{leg}-{seed}.json'
+        manifest = json.loads(proof.read_text())
+        assert manifest['candidate'] == expected['sha'] and manifest['parent'] == expected['parent']
+        assert len(manifest['compiled_source_sha256']) == 132
+        assert manifest['expected_changed_inputs'] == expected['changes_since_retained']
+        assert manifest['physical_cpu_mhz'] == 104 and not manifest['debugger']
+        preflight[leg][seed] = {'control_run': manifest['control_run'], 'selected_sources': 132,
+                                'preflight_sha256': digest(proof)}
+receipt['production_preflight'] = preflight
+
+directed = []
+for keypad in (0, 1):
+    base = out / 'directed'
+    trial = base / f'trial-{keypad}.trace'
+    digest_match = match(trial, base / f'reference-{keypad}.trace')
+    lines = trial.read_text().splitlines()
+    replies = int(re.search(r'replies=(\d+)', lines[-1])[1])
+    directed.append({'keypad_enabled': bool(keypad), 'replies': replies,
+                     'trace_records': len(lines), 'trace_sha256': digest_match})
+assert sum(row['replies'] for row in directed) == 614
+assert sum(row['trace_records'] for row in directed) == 4070
+receipt['directed_lane13'] = {'configurations': directed,
+                              'fixture_sha256': digest(stage / 'source/tests/phone/upp_lane13/tb.sv')}
+
+mmc = out / 'mmc'
+pass_sha = match(mmc / 'source.pass', mmc / 'reference.pass')
+outcomes = (mmc / 'source.pass').read_text().splitlines()
+assert len(outcomes) == 6 and 'cases=30 clocks=258366' in outcomes[-1]
+observer = re.search(r'^COUNT checked reads=(\d+) writes=(\d+) group_crossings=(\d+)$',
+                     (mmc / 'source.log').read_text(), re.MULTILINE)
+reads, writes, crossings = map(int, observer.groups())
+assert (reads, writes, crossings) == (1307, 1309, 1278)
+receipt['directed_mmc'] = {'clocks_4kib': 258366, 'group_crossings': crossings,
+                           'count_reads': reads, 'count_writes': writes,
+                           'pass_sha256': pass_sha, 'matched_tests': outcomes}
+
+for kind, count in (('fixed', 15), ('native', 1)):
+    trial_file = work / f'{kind}.json'
+    control_file = retained_work / f'{kind}.json'
+    trial = json.loads(trial_file.read_text())
+    control = json.loads(control_file.read_text())
+    assert trial['status'] == control['status'] == 'PASS'
+    for name, sha in changes.items():
+        assert trial['source_sha256'][Path(name).name] == sha
+    for key in ('netlist_sha256', 'wrapper_sha256', 'ddr_stream_sha256', 'dma_channels_sha256'):
+        assert trial[key] == control[key]
+    assert trial['source_sha256']['ngage_upp.v'] == control['upp_sha256']
+    assert len(trial['rows']) == len(control['rows']) == count
+    controls = {row['candidate']['case']: row['candidate'] for row in control['rows']}
+    rows = []
+    for row in trial['rows']:
+        candidate = row['candidate']
+        case = candidate['case']
+        assert row['control'] == candidate == controls[case]
+        result = {'case': case, 'architectural_sha256': trace_digest(candidate['architecture']),
+                  'valid_write_trace_sha256': trace_digest(candidate['wb_writes'])}
+        if kind == 'fixed':
+            assert len(candidate['windows']) == 7
+            assert 'Guest output check rejected payload' in (work / f'{case}-00-0-wrong.log').read_text()
+            assert (work / f'{case}-00-1.log').is_file()
+            result.update(window_cycles=[window['cycles'] for window in candidate['windows']],
+                          median_cycles=candidate['median'], repeat_and_negative_output_check=True)
+        else:
+            assert len(candidate['frames']) == 4
+            result.update(frame_cycles=[frame['clocks'] for frame in candidate['frames']],
+                          output_sha256=candidate['output_sha256'])
+        rows.append(result)
+    receipt[kind] = {
+        'retained_receipt_sha256': digest(control_file),
+        'candidate_receipt_sha256': digest(trial_file),
+        'compiled_changes': compile_sources(work / f'obj-{kind}/Vtb__verFiles.dat', f'/frozen/{stage.relative_to(stage.parents[2])}/source'),
+        'rows': rows,
+    }
+
+mixed = out / 'mixed'
+trial_sources = json.loads((mixed / 'source-hashes.json').read_text())
+control_sources = json.loads((retained_mixed / 'source-hashes.json').read_text())
+assert trial_sources.keys() == control_sources.keys() and len(trial_sources) == 114
+assert {name: sha for name, sha in trial_sources.items() if sha != control_sources[name]} == changes
+traffic = mixed / 'traffic.log'
+mixed_sha = match(traffic, retained_mixed / 'traffic.log')
+events = len(traffic.read_bytes().splitlines())
+passes = [line for line in (mixed / 'replay.log').read_text().splitlines() if line.startswith('PASS ')]
+clocks = int(re.search(r'cycles=(\d+)', next(line for line in passes if 'persisted512bytes' in line))[1])
+assert len(passes) == 4 and (events, clocks) == (171496, 1201547)
+receipt['physical_mixed'] = {'clocks': clocks, 'events': events, 'trace_sha256': mixed_sha,
+                             'source_count': len(trial_sources), 'matched_tests': passes,
+                             'compiled_changes': compile_sources(mixed / 'obj/Vtb__verFiles.dat', f'{mixed}/source')}
+assert receipt['fixed']['compiled_changes'] == receipt['native']['compiled_changes'] == receipt['physical_mixed']['compiled_changes']
+(stage / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print('PASS combined lane 13, 4 KiB MMC, 105 fixed windows, four native frames and 171496 pin-model events')
