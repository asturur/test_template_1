@@ -0,0 +1,116 @@
+"""Prepare both lane 13 candidates with isolated Git indexes and objects."""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+repo = stage.parents[2]
+private = stage / 'dispatch-20261126'
+objects = private / 'objects'
+objects.mkdir(parents=True, exist_ok=True)
+catalog = repo / 'docs/experiments/v5-performance/patches'
+retained = '11c4a0c32983cc9aba89cae986684558583a33f2'
+mmc_candidate = '9a02faffc870156e8df2eb74b8c9db141bdb570e'
+retained_tree_id = '8406276acdc60d658e189d09d31b0699217717ba'
+mmc_file = 'rtl/ngage_mmc_host.v'
+lane_file = 'rtl/ngage_upp_peripherals.v'
+patches = {
+    'mmc-count-prepare.patch': '96f4747b20c7b6557fc26587dabfc5a759adabb0ee5f6431abbb19474623eeb4',
+    'lane13-register-sources.patch': '314eb584bdfd3b42cd7d21dde32232f068c39c8694dff25b024cd062730005bc',
+}
+verified = {
+    mmc_file: 'b13acfef39ede0231b563198b221bf5ec8d428bf2c12e339f6a27bec2b751c73',
+    lane_file: '5189d7da1cd75052e0075af9a7966dc39399939446163529a86f89ca325f986f',
+}
+
+
+def git(*args, env=None):
+    return subprocess.check_output(['git', '-C', str(repo), *args], env=env)
+
+
+alternates = [git('rev-parse', '--path-format=absolute', '--git-path', 'objects').decode().strip()]
+for trial in ('mmc-count-prepare', 'wb-reply-class'):
+    alternate = stage.parent / trial / 'dispatch-20261126/objects'
+    if alternate.is_dir():
+        alternates.append(str(alternate))
+
+
+def git_env(index):
+    return os.environ | {
+        'GIT_OBJECT_DIRECTORY': str(objects),
+        'GIT_ALTERNATE_OBJECT_DIRECTORIES': os.pathsep.join(alternates),
+        'GIT_INDEX_FILE': str(private / f'index-{index}'),
+    }
+
+
+def tree(ref, env):
+    return git('rev-parse', f'{ref}^{{tree}}', env=env).decode().strip()
+
+
+def changed_paths(before, after, env):
+    raw = git('diff', '--name-only', '-z', before, after, env=env)
+    return [path.decode() for path in raw.split(b'\0') if path]
+
+
+def apply_patch(name, env):
+    patch = catalog / name
+    assert sha256(patch.read_bytes()).hexdigest() == patches[name], name
+    git('apply', '--cached', '--check', str(patch), env=env)
+    git('apply', '--cached', str(patch), env=env)
+
+
+def commit(tree_id, parent, message, env):
+    ref = git('commit-tree', tree_id, '-p', parent, '-m', message, env=env).decode().strip()
+    assert git('rev-parse', f'{ref}^', env=env).decode().strip() == parent
+    return ref
+
+
+verify = git_env('stack-proof')
+retained_tree = tree(retained, verify)
+assert retained_tree == retained_tree_id
+mmc_tree = tree(mmc_candidate, verify)
+assert changed_paths(retained, mmc_candidate, verify) == [mmc_file]
+git('read-tree', retained, env=verify)
+apply_patch('mmc-count-prepare.patch', verify)
+assert git('write-tree', env=verify).decode().strip() == mmc_tree
+apply_patch('lane13-register-sources.patch', verify)
+stack_tree = git('write-tree', env=verify).decode().strip()
+assert changed_paths(retained, stack_tree, verify) == [mmc_file, lane_file]
+
+restore = commit(retained_tree, mmc_candidate, 'revert: restore retained 104 MHz tree', verify)
+assert tree(restore, verify) == retained_tree
+assert changed_paths(mmc_candidate, restore, verify) == [mmc_file]
+(private / 'restore.sha').write_text(restore + '\n')
+
+results = {}
+for name, parent in (('keep-mmc', mmc_candidate), ('retained', restore)):
+    env = git_env(name)
+    git('read-tree', parent, env=env)
+    apply_patch('lane13-register-sources.patch', env)
+    candidate_tree = git('write-tree', env=env).decode().strip()
+    candidate = commit(candidate_tree, parent, 'perf: separate GPIO and EUART responses', env)
+    assert changed_paths(parent, candidate, env) == [lane_file]
+    paths = changed_paths(retained, candidate, env)
+    assert paths == ([mmc_file, lane_file] if name == 'keep-mmc' else [lane_file])
+    if name == 'keep-mmc':
+        assert candidate_tree == stack_tree
+    checks = {}
+    for path in paths:
+        committed = sha256(git('show', f'{candidate}:{path}', env=env)).hexdigest()
+        staged = sha256((stage / 'source' / path).read_bytes()).hexdigest()
+        assert committed == staged == verified[path], path
+        checks[path] = committed
+    (private / f'{name}.sha').write_text(candidate + '\n')
+    results[name] = {'sha': candidate, 'parent': parent, 'tree': candidate_tree,
+                     'changes_since_parent': [lane_file], 'changes_since_retained': paths,
+                     'file_sha256': checks}
+
+receipt = {'retained': retained, 'retained_tree': retained_tree,
+           'mmc_candidate': mmc_candidate, 'mmc_tree': mmc_tree,
+           'restore': restore, 'restore_parent': mmc_candidate,
+           'patch_sha256': patches, 'candidates': results}
+(private / 'prepare.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print(json.dumps(receipt, indent=2))
diff --git a/scratch/v5-fit-loop/lane13-mmc-combined/preflight.py b/scratch/v5-fit-loop/lane13-mmc-combined/preflight.py
