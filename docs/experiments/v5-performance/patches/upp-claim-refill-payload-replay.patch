+++ b/scratch/v5-fit-loop/upp-claim-refill-payload/stage.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/upp-claim-refill-payload
+private="$area/dispatch-20261126"
+prior=scratch/v5-fit-loop/refill-payload-after-a-only/dispatch-20261126
+base=ab75a622a80a5aedae347f63ae195f3da965815a
+candidate=$(cat "$private/claim-on-two-cut.sha")
+mkdir -p "$area/reference" "$area/source"
+(
+    export GIT_OBJECT_DIRECTORY="$PWD/$private/objects"
+    export GIT_ALTERNATE_OBJECT_DIRECTORIES="$(cat "$private/alternate-objects.txt")"
+    test "$(git rev-parse "$candidate^")" = "$base"
+    test "$(cat "$prior/published.sha")" = "$base"
+    for leg in reference source; do
+        tree="$base"
+        if [ "$leg" = source ]; then tree="$candidate"; fi
+        git archive "$tree" Template.sv rtl tools files.qip .rules.verible_format tests sim/programs/link.ld \
+            | tar -x -C "$area/$leg"
+        python3 -B "$area/$leg/tools/gen_arm9v2_phone.py" --stock build/arm9v2-assoc/stock-pinned.v --check
+    done
+)
+cp "$area/source/rtl/ngage_cpu.sv" "$area/ngage_cpu.sv"
diff --git a/scratch/v5-fit-loop/upp-claim-refill-payload/record.py b/scratch/v5-fit-loop/upp-claim-refill-payload/record.py
new file mode 100644
index 0000000..cd5a21e
--- /dev/null
+++ b/scratch/v5-fit-loop/upp-claim-refill-payload/record.py
@@ -0,0 +1,136 @@
+"""Seal the exact UPP and refill/SDRAM composition and replays."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import os
+
+
+stage = Path(__file__).resolve().parent
+repo = stage.parents[2]
+out = Path('build/sim/v5-104-upp-claim-refill-payload')
+control = Path('build/sim/v5-104-refill-payload-combined')
+solo = stage.parent / 'upp-claim-presence'
+private = stage / 'dispatch-20261126'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def fingerprint(manifest, path):
+    [row] = [shlex.split(line) for line in manifest.read_text().splitlines()
+             if line.startswith('S ') and shlex.split(line)[-1].endswith(path)]
+    return row[-2]
+
+
+def match(left, right):
+    assert left.read_bytes() == right.read_bytes(), (left, right)
+    return digest(left)
+
+
+def passes(path):
+    return re.findall(r'^PASS .+$', path.read_text(), re.M)
+
+
+preflight_file = private / 'prepare.json'
+preflight = load(preflight_file)
+assert preflight['status'] == 'PASS'
+standalone = load(solo / 'qualification.json')
+previous = load(stage.parent / 'refill-payload-combined/qualification.json')
+assert previous['status'] == standalone['status'] == 'PASS'
+assert preflight['proof_sha256'] == digest(solo / 'qualification.json')
+assert preflight['design_patch_sha256'] == digest(solo / 'upp-claim-presence.patch')
+variant = preflight['variants']['claim-on-two-cut']
+paths = variant['sha256_from_timer']
+source, wrapper, arbiter = 'rtl/ngage_upp_peripherals.v', 'rtl/ngage_cpu.sv', 'rtl/ngage_sdram_arbiter.v'
+assert set(paths) == {source, wrapper, arbiter, 'Template.sv'}
+assert paths[source] == standalone['source_sha256']
+assert {name: value for name, value in paths.items() if name != source} == previous['source_sha256']
+context = os.environ | {'GIT_OBJECT_DIRECTORY': preflight['private_objects'],
+                        'GIT_ALTERNATE_OBJECT_DIRECTORIES': preflight['alternate_objects']}
+for name, digest_hex in paths.items():
+    data = subprocess.check_output(['git', '-C', str(repo), 'show', f"{variant['sha']}:{name}"], env=context)
+    assert data == (stage / 'source' / name).read_bytes()
+    assert sha256(data).hexdigest() == digest_hex
+
+mixed = out / 'mixed'
+old_mixed = control / 'mixed'
+manifest = load(mixed / 'source-hashes.json')
+baseline = load(old_mixed / 'source-hashes.json')
+assert manifest.keys() == baseline.keys() and len(manifest) == 114
+assert {name: value for name, value in manifest.items() if value != baseline[name]} == {source: paths[source]}
+assert all(digest(mixed / 'source' / name) == expected for name, expected in manifest.items())
+compiled = {name: fingerprint(mixed / 'obj/Vtb__verFiles.dat', name) for name in (source, wrapper, arbiter)}
+assert all(fingerprint(out / 'hold/trial-obj/Vtb__verFiles.dat', name) == compiled[name] for name in compiled)
+assert fingerprint(out / 'hold/reference-obj/Vtb__verFiles.dat', source) != compiled[source]
+for name in (wrapper, arbiter):
+    assert fingerprint(out / 'hold/reference-obj/Vtb__verFiles.dat', name) == compiled[name]
+
+physical = {}
+for mode, suffix, log, old_trace in (
+    ('normal', 'mixed/traffic.log', 'mixed/replay.log', control / 'mixed/traffic.log'),
+    ('timer_overlap', 'coexistence/candidate.trace', 'coexistence/candidate.log',
+     control / 'coexistence/candidate.trace'),
+    ('cpu_block_eviction', 'block-guest/source.trace', 'block-guest/source.log', control / 'block-guest/source.trace'),
+    ('warm_hold', 'hold/trial.trace', 'hold/trial.log', out / 'hold/reference.trace'),
+):
+    trace = out / suffix
+    payload_log = out / log
+    trace_sha = match(trace, old_trace)
+    lines = passes(payload_log)
+    count = len(trace.read_bytes().splitlines())
+    if mode == 'warm_hold':
+        assert count == 171518 and lines == passes(out / 'hold/reference.log')
+        assert trace_sha == standalone['physical']['mmc_hps_warm_hold']['sha256']
+    else:
+        original = previous['physical_replays'][mode]
+        assert count == original['events'] and trace_sha == original['traffic_sha256'] and lines == original['passes']
+    physical[mode] = {'count': count, 'trace_sha256': trace_sha, 'passes': lines}
+block_lines = [line.split() for line in (out / 'block-guest/source.trace').read_text().splitlines()
+               if re.match(r'Q \d+ 110 (001740|001744) ', line)]
+assert block_lines == previous['physical_replays']['cpu_block_eviction']['cpu_block_commands']
+physical['cpu_block_eviction']['writes'] = block_lines
+
+workload = {}
+for kind, windows, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt_file = out / f'qualification/{kind}.json'
+    reference_file = control / f'qualification/{kind}.json'
+    trial, retained = [load(path) for path in (receipt_file, reference_file)]
+    assert trial['status'] == retained['status'] == 'PASS' and trial['rows'] == retained['rows']
+    assert trial['wrapper_sha256'] == retained['wrapper_sha256'] == paths[wrapper]
+    assert trial['source_sha256'] == {**retained['source_sha256'], Path(source).name: paths[source]}
+    assert trial['source_sha256'][Path(arbiter).name] == paths[arbiter]
+    verfiles = out / f'qualification/obj-{kind}/Vtb__verFiles.dat'
+    for path in (source, arbiter):
+        assert fingerprint(verfiles, path) == compiled[path]
+    assert fingerprint(verfiles, Path(wrapper).name) == compiled[wrapper]
+    assert sum(len(row['candidate'][windows]) for row in trial['rows']) == count
+    workload[kind] = {'matched': count, 'receipt_sha256': digest(receipt_file)}
+    if kind == 'fixed':
+        cases = [row['candidate']['case'] for row in trial['rows']]
+        assert len(set(cases)) == 15
+        for case in cases:
+            assert (out / f'qualification/{case}-00-1.log').is_file()
+            assert 'Guest output check rejected payload' in (out / f'qualification/{case}-00-0-wrong.log').read_text()
+        workload[kind].update(repeated_cases=15, rejected_negative_controls=15)
+    else:
+        view = trial['rows'][0]['candidate']
+        workload[kind].update(frame_clocks=[frame['clocks'] for frame in view['frames']],
+                              guest_output_sha256=view['output_sha256'])
+
+summary = {
+    'status': 'PASS', 'base': variant['parent'], 'candidate': variant['sha'], 'tree': variant['tree'],
+    'source_sha256': paths, 'compiled_fingerprints': compiled, 'physical': physical, 'workload': workload,
+    'preflight_sha256': digest(preflight_file), 'standalone_qualification_sha256': digest(solo / 'qualification.json'),
+    'mixed_source_count': len(manifest), 'image': (out / 'image.id').read_text().strip(),
+    'helper_patch_sha256': digest(stage / 'upp-claim-refill-payload-replay.patch'),
+}
+(stage / 'qualification.json').write_text(json.dumps(summary, indent=2) + '\n')
+print('PASS combined source identities, exact fixed/native, regular/overlap/eviction/hold pin replays')
diff --git a/scratch/v5-fit-loop/upp-claim-refill-payload/replay.py b/scratch/v5-fit-loop/upp-claim-refill-payload/replay.py
