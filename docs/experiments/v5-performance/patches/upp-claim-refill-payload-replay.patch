@@ -0,0 +1,197 @@
+"""Prepare exact timer and two-cut claim presence lineages without refs."""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+standalone = area.parent / 'upp-claim-presence'
+prior = area.parent / 'refill-payload-after-a-only/dispatch-20261126'
+private = area / 'dispatch-20261126'
+objects = private / 'objects'
+objects.mkdir(parents=True, exist_ok=True)
+timer = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+public = 'ab75a622a80a5aedae347f63ae195f3da965815a'
+timer_runs = {13: 45824513460, 43: 45824520116, 31337: 45824525843}
+pair_runs = {13: 45879015397, 43: 45879019116, 31337: 45879022396}
+changed = 'rtl/ngage_upp_peripherals.v'
+patch = standalone / 'upp-claim-presence.patch'
+proof_path = standalone / 'qualification.json'
+
+
+def sha(data):
+    return sha256(data).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+alternates = os.pathsep.join(dict.fromkeys(
+    [str(prior / 'objects'), *(prior / 'alternate-objects.txt').read_text().strip().split(os.pathsep)]))
+assert all(Path(path).is_absolute() and Path(path).is_dir() for path in alternates.split(os.pathsep))
+(private / 'alternate-objects.txt').write_text(alternates + '\n')
+
+
+def env(label):
+    return os.environ | {'GIT_OBJECT_DIRECTORY': str(objects), 'GIT_ALTERNATE_OBJECT_DIRECTORIES': alternates,
+                         'GIT_INDEX_FILE': str(private / f'index-{label}')}
+
+
+def git(*args, context):
+    return subprocess.check_output(['git', '-C', str(root), *args], env=context)
+
+
+def revision(value, context):
+    return git('rev-parse', value, context=context).decode().strip()
+
+
+def tree(value, context):
+    return revision(f'{value}^{{tree}}', context)
+
+
+def file_hash(value, path, context):
+    return sha(git('show', f'{value}:{path}', context=context))
+
+
+def paths(before, after, context):
+    return git('diff', '--name-only', before, after, context=context).decode().splitlines()
+
+
+def commit(tree_id, parent, description, context):
+    timestamp = int(git('show', '-s', '--format=%ct', parent, context=context)) + 1
+    date = f'@{timestamp} +0000'
+    metadata = context | {'GIT_AUTHOR_DATE': date, 'GIT_COMMITTER_DATE': date}
+    value = git('commit-tree', tree_id, '-p', parent, '-m', description, context=metadata).decode().strip()
+    assert revision(f'{value}^', context) == parent and tree(value, context) == tree_id
+    return value
+
+
+proof = load(proof_path)
+assert proof['status'] == 'PASS' and proof['base'] == timer
+assert sha(patch.read_bytes()) == proof['design_patch_sha256']
+prior_proof_file = prior / 'prepare.json'
+prior_proof = load(prior_proof_file)
+pair = prior_proof['variants']['two-cut-on-timer']
+assert (prior / 'published.sha').read_text().strip() == pair['sha'] == public
+assert set(pair['source_sha256']) == {'Template.sv', 'rtl/ngage_sdram_arbiter.v', 'rtl/ngage_cpu.sv'}
+prep = env('verify')
+assert tree(timer, prep) == proof['base_tree']
+assert tree(public, prep) == pair['tree']
+assert set(paths(timer, public, prep)) == set(pair['source_sha256'])
+assert file_hash(public, changed, prep) == file_hash(timer, changed, prep) == proof['reference_sha256']
+for name, expected in pair['source_sha256'].items():
+    assert file_hash(public, name, prep) == expected
+
+restore = commit(proof['base_tree'], public, '''revert: restore timer-only 104 MHz tree
+
+Preserve the measured timer control before fitting the UPP claim
+qualification change independently of refill and SDRAM capture.''', prep)
+assert set(paths(public, restore, prep)) == set(pair['source_sha256'])
+assert git('diff', '--quiet', timer, restore, context=prep) == b''
+(private / 'restore.sha').write_text(restore + '\n')
+
+variants = {}
+for label, parent in (('claim-on-timer', restore), ('claim-on-two-cut', public)):
+    context = env(label)
+    git('read-tree', parent, context=context)
+    git('apply', '--cached', '--check', str(patch), context=context)
+    git('apply', '--cached', str(patch), context=context)
+    candidate_tree = git('write-tree', context=context).decode().strip()
+    if parent == restore:
+        assert candidate_tree == proof['candidate_tree']
+    candidate = commit(candidate_tree, parent, 'perf(upp): decouple claim presence from priority', context)
+    assert paths(parent, candidate, context) == [changed]
+    assert file_hash(candidate, changed, context) == proof['source_sha256']
+    git('merge-base', '--is-ancestor', public, candidate, context=context)
+    expected = {changed: proof['source_sha256']}
+    if parent == public:
+        expected |= pair['source_sha256']
+    assert sorted(paths(timer, candidate, context)) == sorted(expected)
+    assert {name: file_hash(candidate, name, context) for name in expected} == expected
+    assert sha((area / 'source' / changed).read_bytes()) == proof['source_sha256']
+    assert git('show', f'{candidate}:.github/workflows/ci_build.yml', context=context) == git(
+        'show', f'{timer}:.github/workflows/ci_build.yml', context=context)
+    (private / f'{label}.sha').write_text(candidate + '\n')
+    variants[label] = {'sha': candidate, 'parent': parent, 'tree': candidate_tree, 'paths_since_parent': [changed],
+                       'sha256_from_timer': expected, 'production': {}}
+
+tools = ('set_quartus_seed', 'set_quartus_debug', 'record_fit_inputs')
+for label, variant in variants.items():
+    context = env(label)
+    candidate = variant['sha']
+    for seed, old_run in timer_runs.items():
+        timer_dir = root / f'build/timing-audit-{old_run}/output_files'
+        timer_manifest = load(timer_dir / 'resident-fit-manifest.json')
+        assert timer_manifest['actual_commit'] == timer
+        assert timer_manifest['seed'] == seed and timer_manifest['physical_cpu_mhz'] == 104
+        assert not timer_manifest['debugger']
+        control = timer_manifest
+        control_run = old_run
+        control_origin = 'archived timer fit'
+        if label == 'claim-on-two-cut':
+            control_run = pair_runs[seed]
+            path = root / f'build/timing-audit-{control_run}/output_files/resident-fit-manifest.json'
+            control_origin = 'archived two-cut fit'
+            if not path.is_file():
+                control_origin = 'sealed two-cut preflight'
+                path = prior / f'preflight/two-cut-on-timer/{seed}/output_files/resident-fit-manifest.json'
+                expected_preflight = pair['production'][str(seed)]['manifest_sha256']
+                assert sha(path.read_bytes()) == expected_preflight
+            control = load(path)
+            assert control['actual_commit'] == public
+            assert {key: value for key, value in control['compiled_source_sha256'].items()
+                    if value != timer_manifest['compiled_source_sha256'][key]} == pair['source_sha256']
+        selected = control['compiled_source_sha256']
+        assert len(selected) == 133 and selected[changed] == proof['reference_sha256']
+        seed_dir = private / 'preflight' / label / str(seed)
+        outputs = seed_dir / 'output_files'
+        outputs.mkdir(parents=True, exist_ok=True)
+        graph = (timer_dir / 'source-graph.txt').read_text()
+        assert {line.removeprefix('SOURCE /project/') for line in graph.splitlines()
+                if line.startswith('SOURCE ')} == selected.keys()
+        (outputs / 'source-graph.txt').write_text(graph)
+        for name in (*selected, *(f'tools/{tool}.py' for tool in tools)):
+            assert not Path(name).is_absolute() and '..' not in Path(name).parts
+            target = seed_dir / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(git('show', f'{candidate}:{name}', context=context))
+        local = os.environ | {'GITHUB_SHA': candidate}
+        for key in ('GITHUB_STEP_SUMMARY', 'GITHUB_RUN_ID'):
+            local.pop(key, None)
+        for tool, *args in (
+            ('set_quartus_seed', 'Template.qsf', '--seed', str(seed)),
+            ('set_quartus_debug', 'Template.qsf', '--enabled', 'false'),
+        ):
+            subprocess.run(['python3', '-B', f'tools/{tool}.py', *args],
+                           cwd=seed_dir, env=local, check=True, stdout=subprocess.PIPE)
+        qsf = seed_dir / 'Template.qsf'
+        qsf.write_bytes(qsf.read_bytes().replace(b'LAST_QUARTUS_VERSION "17.0.2 Standard Edition"\r\n',
+                                                 b'LAST_QUARTUS_VERSION "17.0.2 Lite Edition"\n'))
+        subprocess.run(['python3', '-B', 'tools/record_fit_inputs.py'],
+                       cwd=seed_dir, env=local, check=True, stdout=subprocess.PIPE)
+        manifest_file = outputs / 'resident-fit-manifest.json'
+        actual = load(manifest_file)
+        assert actual['actual_commit'] == candidate
+        actual_sources = actual['compiled_source_sha256']
+        assert actual_sources.keys() == selected.keys()
+        delta = {path: value for path, value in actual_sources.items() if value != selected[path]}
+        assert delta == {changed: proof['source_sha256']}
+        assert all(actual[key] == control[key] for key in control.keys() - {'actual_commit', 'compiled_source_sha256'})
+        variant['production'][seed] = {'control_run': control_run, 'control_source': control_origin,
+                                       'seed': seed, 'debugger': actual['debugger'], 'mhz': actual['physical_cpu_mhz'],
+                                       'selected_source_count': len(selected), 'delta': delta,
+                                       'manifest_sha256': sha(manifest_file.read_bytes())}
+        print(f'PASS {label} seed {seed}: exact 104 MHz, DDR debug off, sole UPP source delta', flush=True)
+
+receipt = {'status': 'PASS', 'public_parent': public, 'timer': timer, 'restore': restore,
+           'private_objects': str(objects), 'alternate_objects': alternates,
+           'proof_sha256': sha(proof_path.read_bytes()), 'design_patch_sha256': sha(patch.read_bytes()),
+           'variants': variants}
+(private / 'prepare.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print('Restore', restore)
+for label, data in variants.items():
+    print(label, data['sha'], data['tree'])
