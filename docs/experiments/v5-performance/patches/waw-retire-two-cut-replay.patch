+"""Capture the sampled W completion, destination wait, and right operand routes."""
+import csv
+import json
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+base = 'ab75a622a80a5aedae347f63ae195f3da965815a'
+runs = {13: 45879015397, 43: 45879019116, 31337: 45879022396}
+
+
+def logic_nodes(path):
+    return [line.split(';')[-2].strip().removesuffix('|combout')
+            for line in path.splitlines() if '|combout' in line and 'CELL' in line]
+
+
+witnesses = {}
+for seed, run in runs.items():
+    directory = Path(f'build/timing-audit-{run}/output_files')
+    manifest = json.loads((directory / 'resident-fit-manifest.json').read_bytes())
+    assert manifest['actual_commit'] == base and manifest['seed'] == seed
+    assert manifest['physical_cpu_mhz'] == 104 and manifest['debugger'] is False
+    corners = {}
+    for corner in sorted((directory / 'timing/resident-store/104').glob('corner-*')):
+        with (corner / 'setup.csv').open() as handle:
+            rows = list(csv.DictReader(handle))
+        assert len(rows) == 1000
+        chunks = re.split(r'(?m)^Path #(\d+): Setup slack is ', (corner / 'setup.rpt').read_text(errors='replace'))
+        nodes = {int(rank): logic_nodes(detail) for rank, detail in zip(chunks[1::2], chunks[2::2], strict=True)}
+        assert len(nodes) == 100
+        detailed = [{**row, 'cells': nodes[int(row['rank'])]} for row in rows if int(row['rank']) in nodes]
+        completion = [row for row in detailed if any('|complete_class' in cell for cell in row['cells'])]
+        w_valid = [row for row in completion if row['from'].endswith('|w[541]')]
+        right_operand = [row for row in detailed
+                         if (end := re.search(r'\|ngage2_arm9v2_execute:[^|]+\|a\[(\d+)\]', row['to']))
+                         and 218 <= int(end[1]) <= 249]
+        w_tag_wait = [row for row in detailed
+                      if any('|s_wait_w_nohit' in cell for cell in row['cells'])]
+        corners[corner.name] = {
+            'sampled_paths': len(rows), 'detailed_paths': len(detailed),
+            'leading_paths': detailed[:3], 'complete_class': completion,
+            'w_valid_through_complete_class': w_valid,
+            'execute_right_operand': right_operand, 'same_destination_wait': w_tag_wait,
+        }
+    assert len(corners) == 4
+    witnesses[seed] = {'run': run, 'corners': corners}
+
+for corner, slack in (('corner-1', '-2.006'), ('corner-2', '-1.994')):
+    path = witnesses[13]['corners'][corner]['leading_paths'][0]
+    assert path['from'].endswith('|w[541]') and path['to'].endswith('|a[241]') and path['slack_ns'] == slack
+    assert any('|complete_class[0]' in cell for cell in path['cells'])
+    assert any('|ready_if_hit' in cell for cell in path['cells'])
+for corner, slack in (('corner-1', '-2.636'), ('corner-2', '-2.570')):
+    path = witnesses[43]['corners'][corner]['leading_paths'][0]
+    assert path['from'].endswith('|w[93]') and path['to'].endswith('|a[239]') and path['slack_ns'] == slack
+    assert any('|s_wait_w_nohit' in cell for cell in path['cells'])
+    assert any('|ready_if_nohit' in cell for cell in path['cells'])
+hot_third = witnesses[13]['corners']['corner-1']['leading_paths'][2]
+assert hot_third['from'].endswith('|o_forward_grant[25]') and hot_third['to'].endswith('|a[233]')
+assert any('|operand1_nw' in cell for cell in hot_third['cells'])
+cold_third = witnesses[13]['corners']['corner-2']['leading_paths'][2]
+assert cold_third['from'].endswith('|w[527]') and cold_third['to'].endswith('|a[233]')
+assert any('|direct_reg_shift' in cell for cell in cold_third['cells'])
+
+summary = (Path(f'build/timing-audit-{runs[13]}/output_files/Template.sta.summary').read_text()
+           .split('Type  : Setup', 2)[1])
+assert 'Slack : -2.006' in summary and 'TNS   : -2674.880' in summary
+(stage / 'routes.json').write_text(json.dumps({'base': base, 'seeds': witnesses}, indent=2) + '\n')
+print('PASS four-corner sampled W completion, right operand, and same-destination routes')
+
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+old, trial = [(stage / leg / rtl).read_text() for leg in ('reference', 'source')]
+for signal in ('load_trust', 'w_same_writer', 's_wait_w_nohit', 'done_forward', 'wb_valid',
+               'ready_if_hit', 'ready_if_nohit', 'backend_ready'):
+    pattern = rf'\b{signal}\s*=(?!\s*=)(.*?);'
+    original, new = [re.findall(pattern, candidate, re.S) for candidate in (old, trial)]
+    assert original and original == new, signal
+trust = re.search(r'\bload_trust = ([^;]*);', trial)[1]
+assert 'wb_valid' not in trust and 'i_data_short_trust' in trust
+assert old.count('!(load_trust && wb_valid && request_done && !retry && !resp_err)') == 1
+assert 's_wait_w_nohit && (WAW_WAIT_RETIRE ||' in trial
+assert re.search(r'parameter WAW_WAIT_RETIRE\s*=\s*1\x27b0;', trial)
+assert trial.count(".WAW_WAIT_RETIRE(1'b1)") == 1
+print('PASS targeted direct hit-order release and persistent completion/no-hit source equations')
diff --git a/scratch/v5-fit-loop/waw-retire-two-cut/prepare-fit.py b/scratch/v5-fit-loop/waw-retire-two-cut/prepare-fit.py
new file mode 100644
index 0000000..3c2a767
--- /dev/null
+++ b/scratch/v5-fit-loop/waw-retire-two-cut/prepare-fit.py
@@ -0,0 +1,250 @@
+"""Prepare both private conservative W load guard histories and verify the production source manifests."""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+d_area = area.parent / 'd-completion-merger'
+prior = d_area / 'followup-20261126'
+private = area / 'followup-20261126'
+objects = private / 'objects'
+objects.mkdir(parents=True, exist_ok=True)
+combined = area.parent / 'waw-retire-d-beat'
+base = 'ab75a622a80a5aedae347f63ae195f3da965815a'
+public_d = '0c64862ebd8c5c85830a931c7f68b6b429a32076'
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+changed = [rtl, generator]
+design = area / 'waw-retire-two-cut.patch'
+
+
+def sha(data):
+    return sha256(data).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+alternates = os.pathsep.join(dict.fromkeys(
+    [str(prior / 'objects'), *(prior / 'alternate-objects.txt').read_text().strip().split(os.pathsep)]))
+assert all(Path(path).is_absolute() and Path(path).is_dir() for path in alternates.split(os.pathsep))
+(private / 'alternate-objects.txt').write_text(alternates + '\n')
+
+
+def env_for(label):
+    return os.environ | {'GIT_OBJECT_DIRECTORY': str(objects), 'GIT_ALTERNATE_OBJECT_DIRECTORIES': alternates,
+                         'GIT_INDEX_FILE': str(private / f'index-{label}')}
+
+
+def git(*args, env, data=None):
+    return subprocess.check_output(['git', '-C', str(root), *args], env=env, input=data)
+
+
+def revision(value, env):
+    return git('rev-parse', value, env=env).decode().strip()
+
+
+def tree(value, env):
+    return revision(f'{value}^{{tree}}', env)
+
+
+def files(before, after, env):
+    return git('diff', '--name-only', before, after, env=env).decode().splitlines()
+
+
+def blob(rev, path, env):
+    return git('show', f'{rev}:{path}', env=env)
+
+
+def commit(tree_id, parent, message, env):
+    timestamp = int(git('show', '-s', '--format=%ct', parent, env=env)) + 1
+    date = f'@{timestamp} +0000'
+    result = git('commit-tree', tree_id, '-p', parent, '-m', message,
+                 env=env | {'GIT_AUTHOR_DATE': date, 'GIT_COMMITTER_DATE': date}).decode().strip()
+    assert revision(f'{result}^', env) == parent and tree(result, env) == tree_id
+    return result
+
+
+def modules(source):
+    return {match[1]: match[0] for match in re.finditer(rb'^module (\w+) .*?^endmodule', source, re.M | re.S)}
+
+
+def replace_once(text, old, new):
+    assert text.count(old) == 1, old
+    return text.replace(old, new, 1)
+
+
+def combine_generator(base_blob, waw, d_source):
+    waw_fun = re.search(rb'^def wait_for_w_load_retirement\(phone\):.*?(?=^def )', waw, re.M | re.S)[0]
+    d_fun = re.search(rb'^def prepare_data_cache_beats\(phone\):.*?(?=^def )', d_source, re.M | re.S)[0]
+    waw_call = b'    generated = wait_for_w_load_retirement(generated)\n'
+    d_call = b'    if not args.hinted_ldm:\n        generated = prepare_data_cache_beats(generated)\n'
+    assert replace_once(replace_once(waw, waw_fun, b''), waw_call, b'') == base_blob
+    assert replace_once(replace_once(d_source, d_fun, b''), d_call, b'') == base_blob
+    merged = replace_once(d_source, b'def prepare_data_cache_beats(phone):',
+                          waw_fun + b'def prepare_data_cache_beats(phone):')
+    call_anchor = b'    generated = split_execute_readiness(generated)\n'
+    merged = replace_once(merged, call_anchor, call_anchor + waw_call)
+    assert replace_once(replace_once(merged, d_fun, b''), d_call, b'') == waw
+    return merged
+
+
+proof = load(area / 'staged-source.json')
+d_proof = load(d_area / 'qualification.json')
+dispatch = load(prior / 'dispatch.json')
+assert proof['status'] == 'STAGED' and d_proof['status'] == 'PASS' and proof['base'] == base
+assert dispatch['candidate'] == public_d == (prior / 'published.sha').read_text().strip()
+assert sha(design.read_bytes()) == proof['design_patch_sha256']
+common = env_for('verify')
+assert tree(base, common) == proof['base_tree']
+assert tree(public_d, common) == d_proof['tree'] == dispatch['tree']
+assert revision(f'{public_d}^', common) == d_proof['base']
+assert tree(d_proof['base'], common) == proof['base_tree']
+assert files(base, public_d, common) == changed
+for path in changed:
+    assert sha(blob(base, path, common)) == proof['reference_sha256'][path] == d_proof['reference_sha256'][path]
+    assert sha(blob(public_d, path, common)) == d_proof['source_sha256'][path]
+
+restore = commit(proof['base_tree'], public_d, 'revert: restore the measured two-cut RTL', common)
+assert files(public_d, restore, common) == changed and not files(base, restore, common)
+(private / 'restore.sha').write_text(restore + '\n')
+variants = {}
+for label, parent in (('waw-on-two-cut', restore), ('waw-on-d', public_d)):
+    env = env_for(label)
+    git('read-tree', parent, env=env)
+    if parent == restore:
+        git('apply', '--cached', '--check', str(design), env=env)
+        git('apply', '--cached', str(design), env=env)
+    else:
+        git('apply', '--cached', '--check', f'--include={rtl}', str(design), env=env)
+        git('apply', '--cached', f'--include={rtl}', str(design), env=env)
+        waw_generator = (area / 'source' / generator).read_bytes()
+        assert sha(waw_generator) == proof['source_sha256'][generator]
+        merged = combine_generator(blob(base, generator, env), waw_generator, blob(public_d, generator, env))
+        digest = git('hash-object', '-w', '--stdin', env=env, data=merged).decode().strip()
+        git('update-index', '--cacheinfo', f'100755,{digest},{generator}', env=env)
+    candidate_tree = git('write-tree', env=env).decode().strip()
+    if parent == restore:
+        assert candidate_tree == proof['candidate_tree']
+    candidate = commit(candidate_tree, parent, 'perf(cpu): wait for older same-destination W load retirement', env)
+    assert files(parent, candidate, env) == changed
+    assert files(base, candidate, env) == changed
+    git('diff', '--check', parent, candidate, env=env)
+    git('merge-base', '--is-ancestor', public_d, candidate, env=env)
+    assert blob(candidate, '.github/workflows/ci_build.yml', env) == blob(base, '.github/workflows/ci_build.yml', env)
+    exact = {path: sha(blob(candidate, path, env)) for path in changed}
+    if parent == restore:
+        assert exact == proof['source_sha256']
+    else:
+        waw_cpu = (area / 'source' / rtl).read_bytes()
+        assert sha(waw_cpu) == proof['source_sha256'][rtl]
+        original, d_edit, waw_edit, both = map(modules, (blob(base, rtl, env), blob(public_d, rtl, env),
+                                                       waw_cpu, blob(candidate, rtl, env)))
+        assert original.keys() == d_edit.keys() == waw_edit.keys() == both.keys()
+        assert {name for name in original if original[name] != waw_edit[name]} == {
+            b'ngage2_arm9v2_core', b'ngage2_zap_top',
+        }
+        for name in original:
+            expected = d_edit[name]
+            if name == b'ngage2_arm9v2_core':
+                expected = waw_edit[name]
+            elif name == b'ngage2_zap_top':
+                marker = b".LOAD_FORMATTED(1'b1),\n"
+                opt_in = b"\t\t\t\t.WAW_WAIT_RETIRE(1'b1),\n"
+                assert replace_once(waw_edit[name], opt_in, b'') == original[name]
+                expected = replace_once(expected, marker, marker + opt_in)
+            assert both[name] == expected, name
+        (private / 'waw-on-d.patch').write_bytes(git('diff', '--binary', parent, candidate, env=env))
+        for leg, rev in (('reference', parent), ('source', candidate)):
+            target = combined / leg
+            target.mkdir(parents=True, exist_ok=True)
+            archive = git('archive', rev, 'Template.sv', 'rtl', 'tools', 'files.qip',
+                          '.rules.verible_format', 'tests', 'sim/programs/link.ld', env=env)
+            subprocess.run(['tar', '-x', '-C', str(target)], check=True, input=archive)
+        (combined / 'ngage_cpu.sv').write_bytes((combined / 'source/rtl/ngage_cpu.sv').read_bytes())
+    (private / f'{label}.sha').write_text(candidate + '\n')
+    variants[label] = {'sha': candidate, 'parent': parent, 'tree': candidate_tree,
+                       'paths_since_parent': changed, 'sha256_from_two_cut': exact, 'production': {}}
+
+tools = ('set_quartus_seed', 'set_quartus_debug', 'record_fit_inputs')
+for label, variant in variants.items():
+    env = env_for(label)
+    candidate = variant['sha']
+    for seed, upstream in dispatch['runs'].items():
+        base_run = upstream['control_run']
+        base_dir = root / f'build/timing-audit-{base_run}/output_files'
+        control = load(base_dir / 'resident-fit-manifest.json')
+        assert control['actual_commit'] == base
+        original = control
+        run = base_run
+        origin = 'routed two-cut control'
+        if label == 'waw-on-d':
+            run = upstream['id']
+            path = root / f'build/timing-audit-{run}/output_files/resident-fit-manifest.json'
+            origin = 'routed D-beat control'
+            if not path.is_file():
+                origin = 'sealed D-beat control preflight'
+                path = prior / f'preflight/d-beat-on-two-cut/{seed}/output_files/resident-fit-manifest.json'
+                assert sha(path.read_bytes()) == upstream['candidate_preflight_manifest_sha256']
+            control = load(path)
+            assert control['actual_commit'] == public_d
+            control_inputs = control['compiled_source_sha256']
+            assert control_inputs.keys() == original['compiled_source_sha256'].keys()
+            assert {name: value for name, value in control_inputs.items()
+                    if value != original['compiled_source_sha256'][name]} == {rtl: d_proof['source_sha256'][rtl]}
+        selected = control['compiled_source_sha256']
+        assert int(seed) == control['seed'] and control['physical_cpu_mhz'] == 104 and control['debugger'] is False
+        assert len(selected) == 133 and generator not in selected
+        run_dir = private / 'preflight' / label / seed
+        outputs = run_dir / 'output_files'
+        outputs.mkdir(parents=True, exist_ok=True)
+        graph = (base_dir / 'source-graph.txt').read_text()
+        assert {line.removeprefix('SOURCE /project/') for line in graph.splitlines()
+                if line.startswith('SOURCE ')} == selected.keys()
+        (outputs / 'source-graph.txt').write_text(graph)
+        for name in (*selected, *(f'tools/{tool}.py' for tool in tools)):
+            assert not Path(name).is_absolute() and '..' not in Path(name).parts
+            target = run_dir / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(blob(candidate, name, env))
+        local = os.environ | {'GITHUB_SHA': candidate}
+        for name in ('GITHUB_STEP_SUMMARY', 'GITHUB_RUN_ID'):
+            local.pop(name, None)
+        for tool, *arguments in (('set_quartus_seed', 'Template.qsf', '--seed', seed),
+                                  ('set_quartus_debug', 'Template.qsf', '--enabled', 'false')):
+            subprocess.run(['python3', '-B', f'tools/{tool}.py', *arguments],
+                           cwd=run_dir, env=local, check=True, stdout=subprocess.PIPE)
+        qsf = run_dir / 'Template.qsf'
+        qsf.write_bytes(qsf.read_bytes().replace(b'LAST_QUARTUS_VERSION "17.0.2 Standard Edition"\r\n',
+                                                 b'LAST_QUARTUS_VERSION "17.0.2 Lite Edition"\n'))
+        subprocess.run(['python3', '-B', 'tools/record_fit_inputs.py'],
+                       cwd=run_dir, env=local, check=True, stdout=subprocess.PIPE)
+        preflight = outputs / 'resident-fit-manifest.json'
+        actual = load(preflight)
+        assert actual['actual_commit'] == candidate
+        inputs = actual['compiled_source_sha256']
+        assert inputs.keys() == selected.keys()
+        delta = {name: value for name, value in inputs.items() if value != selected[name]}
+        assert delta == {rtl: variant['sha256_from_two_cut'][rtl]}
+        assert all(actual[key] == control[key]
+                   for key in control.keys() - {'actual_commit', 'compiled_source_sha256', 'github_run_id'})
+        variant['production'][seed] = {'control_run': run, 'control_origin': origin, 'mhz': actual['physical_cpu_mhz'],
+                                       'debugger': actual['debugger'], 'source_count': len(inputs),
+                                       'delta': delta, 'manifest_sha256': sha(preflight.read_bytes())}
+        print(f'PASS {label} seed {seed} at 104 MHz DDR debug off, exact 133-input manifest', flush=True)
+
+receipt = {'status': 'PASS', 'production_qualified': 'preflight', 'two_cut': base, 'public_parent': public_d, 'restore': restore,
+           'private_objects': str(objects), 'alternate_objects': alternates,
+           'staged_source_sha256': sha((area / 'staged-source.json').read_bytes()),
+           'design_patch_sha256': sha(design.read_bytes()), 'stack_patch_sha256': sha((private / 'waw-on-d.patch').read_bytes()),
+           'variants': variants}
+(private / 'prepare.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print('Restore', restore)
+for label, value in variants.items():
+    print(label, value['sha'], value['tree'])
