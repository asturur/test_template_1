@@ -0,0 +1,186 @@
+"""Verify production opt-in and record exact measured W load-order cost."""
+import argparse
+import json
+from hashlib import sha256
+from pathlib import Path
+import re
+import shlex
+
+
+parser = argparse.ArgumentParser()
+parser.add_argument('configuration', choices=('standalone', 'stacked'))
+args = parser.parse_args()
+area = Path(__file__).resolve().parent
+stacked = args.configuration == 'stacked'
+standalone = Path('build/sim') / f'v5-104-{area.name}'
+stage = area.parent / 'waw-retire-d-beat' if stacked else area
+out = Path('build/sim') / f'v5-104-{stage.name}'
+control = Path('build/sim') / ('v5-104-d-completion-merger' if stacked else 'v5-104-refill-payload-combined')
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def sha(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def match(trial, reference):
+    assert trial.read_bytes() == reference.read_bytes(), (trial, reference)
+    return sha(trial)
+
+
+def fields(path, prefix):
+    [line] = [line for line in path.read_text().splitlines() if line.startswith(prefix)]
+    return {key: int(value) for key, value in re.findall(r'(\w+)=(-?\d+)', line)}
+
+
+def assert_active(log, d_beat=False):
+    rows = log.read_text().splitlines()
+    assert rows.count('WAW_ELAB enabled=1') == 1, log
+    if d_beat:
+        assert rows.count('CCH_PREP enabled=1') == 1, log
+
+
+def compiled(manifest, path):
+    [line] = [shlex.split(line) for line in manifest.read_text().splitlines()
+              if line.startswith('S ') and shlex.split(line)[-1].endswith(path)]
+    return line[-2]
+
+
+private = area / 'followup-20261126'
+prepare = load(private / 'prepare.json')
+lineage = prepare['variants']['waw-on-d' if stacked else 'waw-on-two-cut']
+source = {path: sha(stage / 'source' / path) for path in (rtl, generator)}
+before = {path: sha(stage / 'reference' / path) for path in (rtl, generator)}
+assert source == lineage['sha256_from_two_cut']
+if stacked:
+    assert before == load(area.parent / 'd-completion-merger/qualification.json')['source_sha256']
+else:
+    assert before == load(area / 'staged-source.json')['reference_sha256']
+guard = fields(standalone / 'guard-proof/run.log', 'PASS WAW guard ')
+assert guard == {'vectors': 128, 'same_destination_fault_cases': 32, 'changed_vectors': 1, 'no_writer_cases': 64}
+
+boards = {}
+for burst in (0, 1):
+    for wait in (0, 5):
+        key = f'burst-{burst}-wait-{wait}'
+        ref = out / 'board/reference' / key
+        new = out / 'board/source' / key
+        assert_active(new.with_suffix('.log'))
+        new_dir = out / 'directed/source' / key
+        old_dir = out / 'directed/reference' / key
+        old_waw = fields(old_dir.with_suffix('.log'), 'WAW_PASS ')
+        new_waw = fields(new_dir.with_suffix('.log'), 'WAW_PASS ')
+        assert_active(new_dir.with_suffix('.log'))
+        for result in (old_waw, new_waw):
+            assert result['issued'] == result['retired'] == 64
+            assert result['fault'] == result['follower'] == 1
+        assert old_waw['stalls'] == 0 and new_waw['stalls'] == new_waw['opportunities'] > 0
+        boards[key] = {'normal_trace_sha256': match(new.with_suffix('.trace'), ref.with_suffix('.trace')),
+                       'ordered_retire_sha256': match(new_dir.with_suffix('.ordered'), old_dir.with_suffix('.ordered')),
+                       'reference': old_waw, 'guard': new_waw,
+                       'clock_delta': new_waw['clocks'] - old_waw['clocks']}
+
+mixed = out / 'mixed'
+new_sources = load(mixed / 'source-hashes.json')
+old_sources = load(control / 'mixed/source-hashes.json')
+assert len(new_sources) == 114 and new_sources.keys() == old_sources.keys()
+assert all(sha(mixed / 'source' / path) == digest for path, digest in new_sources.items())
+assert {path: digest for path, digest in new_sources.items() if digest != old_sources[path]} == {rtl: source[rtl]}
+fingerprint = compiled(mixed / 'obj/Vtb__verFiles.dat', rtl)
+assert compiled(out / 'hold/trial-obj/Vtb__verFiles.dat', rtl) == fingerprint
+for area_name in ('board', 'directed'):
+    assert compiled(out / area_name / 'source/obj/Vcontract__verFiles.dat', rtl) == fingerprint
+
+physical = {}
+for label, trace, reference, count, cycles in (
+    ('normal', 'mixed/traffic.log', control / 'mixed/traffic.log', 171496, 1201547),
+    ('timer_mmc_lcd', 'coexistence/candidate.trace', control / 'coexistence/candidate.trace', 171497, 1201528),
+    ('cpu_block_eviction', 'block-guest/source.trace', control / 'block-guest/source.trace', 172060, 1204706),
+    ('warm_hold', 'hold/trial.trace', out / 'hold/reference.trace', 171518, 1203504),
+):
+    path = out / trace
+    log = mixed / 'replay.log' if label == 'normal' else path.with_suffix('.log')
+    assert_active(log, d_beat=stacked)
+    assert len(path.read_bytes().splitlines()) == count
+    assert f'persisted512bytes+PIOreadback cycles={cycles}' in log.read_text()
+    physical[label] = {'records': count, 'clocks': cycles, 'trace_sha256': match(path, reference)}
+assert match(out / 'hold/reference.pass', out / 'hold/trial.pass')
+warm = load(area.parent / 'd-completion-merger/qualification.json')['physical']['warm_hold']['sha256']
+assert physical['warm_hold']['trace_sha256'] == warm
+
+receipts = {}
+for kind, field, width, ncases, cycle_key in (
+    ('fixed', 'windows', 7, 15, 'cycles'), ('native', 'frames', 4, 1, 'clocks'),
+):
+    old_path = standalone / 'retained' / f'{kind}.json'
+    trial_path = out / 'candidate' / f'{kind}.json'
+    pre_waw = load(old_path)
+    post_waw = load(trial_path)
+    strict_control = load(control / 'qualification' / f'{kind}.json')
+    assert pre_waw['status'] == post_waw['status'] == strict_control['status'] == 'PASS'
+    assert post_waw['netlist_sha256'] == source[rtl] and strict_control['netlist_sha256'] == before[rtl]
+    for key in ('wrapper_sha256', 'ddr_stream_sha256', 'dma_channels_sha256'):
+        assert post_waw[key] == strict_control[key], key
+    selected = strict_control['source_sha256'] | {'ngage_dma_channels.v': strict_control['dma_channels_sha256']}
+    assert pre_waw['source_sha256'] == post_waw['source_sha256'] == selected
+    assert len(pre_waw['rows']) == len(post_waw['rows']) == len(strict_control['rows']) == ncases
+    if stacked:
+        standalone_result = load(standalone / 'candidate' / f'{kind}.json')
+        assert standalone_result['rows'] == post_waw['rows']
+    netlist = f'{kind}-candidate-cpu.v'
+    assert sha(out / 'candidate' / netlist) == source[rtl]
+    assert compiled(out / f'candidate/obj-{kind}/Vtb__verFiles.dat', f'/work/{netlist}') == fingerprint
+    rows = {}
+    for pre_row, post_row, strict_row in zip(pre_waw['rows'], post_waw['rows'], strict_control['rows'], strict=True):
+        pre, post = (row['candidate'] for row in (pre_row, post_row))
+        assert {key: value for key, value in pre.items() if key != 'waw'} == strict_row['candidate']
+        assert pre_row['control'] == post_row['control'] == strict_row['candidate']
+        assert pre['case'] == post['case'] and pre['architecture'] == post['architecture']
+        assert len(pre[field]) == len(post[field]) == width
+        assert len(pre['waw']) == len(post['waw']) == len(post['wb_writes']) == width
+        name = pre['case']
+        assert_active(out / f'candidate/{name}-00-0.log', d_beat=stacked)
+        if kind == 'fixed':
+            assert_active(out / f'candidate/{name}-00-1.log', d_beat=stacked)
+            for leg in (standalone / 'retained', out / 'candidate'):
+                assert 'Guest output check rejected payload' in (leg / f'{name}-00-0-wrong.log').read_text()
+        ordered = [(entry['writes'], f"{entry['ordered_hash']:016x}") for entry in pre['waw']]
+        assert ordered == [(entry['writes'], f"{entry['ordered_hash']:016x}") for entry in post['waw']]
+        old_cycles = [entry[cycle_key] for entry in pre[field]]
+        new_cycles = [entry[cycle_key] for entry in post[field]]
+        delta = [new - old for old, new in zip(old_cycles, new_cycles, strict=True)]
+        timed = [x['write_hash'] == y['write_hash'] for x, y in zip(pre['wb_writes'], post['wb_writes'], strict=True)]
+        rows[name] = {'cycle_delta': delta, 'reference_cycles': old_cycles, 'guard_cycles': new_cycles,
+                      'reference_median': pre['median'], 'guard_median': post['median'],
+                      'median_delta': post['median'] - pre['median'],
+                      'median_delta_pct': 100 * (post['median'] - pre['median']) / pre['median'],
+                      'reference_same_edge_accepts': [entry['accepted'] for entry in pre['waw']],
+                      'guard_extra_holds': [entry['blocked'] for entry in post['waw']],
+                      'matched_ordered_writes': ordered, 'matched_cycle_stamped_write_hashes': timed}
+        if kind == 'native':
+            assert pre['output_sha256'] == post['output_sha256']
+            rows[name].update(total_delta=sum(delta), total_delta_pct=100 * sum(delta) / sum(old_cycles),
+                              output_sha256=post['output_sha256'])
+    receipts[kind] = {'count': width * ncases, 'reference_receipt_sha256': sha(old_path),
+                      'guard_receipt_sha256': sha(trial_path), 'rows': rows}
+
+summary = {'status': 'PASS', 'production_waw_wait_retire': True, 'candidate': lineage['sha'], 'base': lineage['parent'],
+           'tree': lineage['tree'], 'stacked_on_d_beat': stacked, 'compare_sha256': before, 'source_sha256': source,
+           'design_patch_sha256': sha(private / 'waw-on-d.patch' if stacked else area / 'waw-retire-two-cut.patch'),
+           'replay_patch_sha256': sha(area / 'waw-retire-two-cut-replay.patch'),
+           'simulator': (out / 'image.id').read_text().strip(), 'guard_proof': guard, 'boards': boards,
+           'compiled_cpu_fingerprint': fingerprint, 'physical': physical, 'workloads': receipts,
+           'routed_baseline_routes_sha256': sha(area / 'routes.json'), 'production_preflight': lineage['production'],
+           'candidate_routed': False}
+(stage / 'qualification.json').write_text(json.dumps(summary, indent=2) + '\n')
+print(f'PASS {args.configuration}: active W guard precise abort, 105 fixed, four native, and four pin modes')
+for name, result in receipts['fixed']['rows'].items():
+    if result['median_delta']:
+        print(name, result['reference_median'], result['guard_median'], f"{result['median_delta_pct']:+.4f}%")
+native = receipts['native']['rows']['native']
+print('native', sum(native['reference_cycles']), sum(native['guard_cycles']), f"{native['total_delta_pct']:+.4f}%")
