+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/waw-retire-two-cut
+both=scratch/v5-fit-loop/waw-retire-d-beat
+mkdir -p "$both" build/sim/v5-104-waw-retire-d-beat
+for file in architectural_trace.vh wb-write-trace.vh waw-census.vh board-waw.vh waw-observer.sv; do
+    cp "$area/$file" "$both/"
+done
+for file in replay.py mixed.py pins.sh prepare-hold.py hold.sh board.sh directed.sh prepare-directed.py; do
+    sed -e 's/waw-retire-two-cut/waw-retire-d-beat/g' \
+        -e 's/v5-104-refill-payload-combined/v5-104-d-completion-merger/g' "$area/$file" > "$both/$file"
+done
+python3 -B - "$both" <<'PY'
+from pathlib import Path
+import sys
+p = Path(sys.argv[1]) / 'replay.py'
+s = p.read_text()
+needle = "    if '--assert' not in options:"
+assert s.count(needle) == 1
+s = s.replace(needle, "    options.append(frozen(stage.parent / 'd-completion-merger/beat-observer.sv'))\n" + needle)
+needle = "    assert code == 0, log"
+assert s.count(needle) == 1
+s = s.replace(needle, needle + "\n    assert 'CCH_PREP enabled=1' in log.read_text(), log")
+p.write_text(s)
+PY
