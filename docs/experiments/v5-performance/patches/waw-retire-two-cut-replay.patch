diff --git a/scratch/v5-fit-loop/waw-retire-two-cut/architectural_trace.vh b/scratch/v5-fit-loop/waw-retire-two-cut/architectural_trace.vh
new file mode 100644
index 0000000..88b6546
--- /dev/null
+++ b/scratch/v5-fit-loop/waw-retire-two-cut/architectural_trace.vh
@@ -0,0 +1,69 @@
+`define RESUPP dut.board.upp.cpu_inside
+`define RESZAP `RESUPP.cpu.u_arm925t.u_zap
+`define RESCORE `RESZAP.g_arm9.u_arm9_core
+`define RESFETCH `RESCORE.u_front_decode.u_fetch
+
+reg [31:0] res_begin, res_end;
+integer res_window = 0;
+integer res_retired, res_data, res_mmio, res_recover;
+reg res_active = 0;
+reg [63:0] res_retire_hash, res_data_hash, res_mmio_hash;
+localparam [63:0] RES_INITIAL = 64'hcbf29ce484222325;
+initial begin
+    if (!$value$plusargs("begin_pc=%h", res_begin) || !$value$plusargs("end_pc=%h", res_end))
+        $fatal(1, "Missing architectural digest window");
+end
+
+function automatic [63:0] res_mix(input [63:0] digest, input [63:0] data);
+    res_mix = (digest ^ data) * 64'h00000100000001b3;
+endfunction
+
+always @(posedge clk) if (!reset) begin
+    if (retire && retire_pc == res_begin) begin
+        res_active = 1;
+        res_retired = 0;
+        res_data = 0;
+        res_mmio = 0;
+        res_recover = 0;
+        res_retire_hash = RES_INITIAL;
+        res_data_hash = RES_INITIAL;
+        res_mmio_hash = RES_INITIAL;
+    end else if (retire && retire_pc == res_end && res_active) begin
+        $display("RES_ARCH window=%0d retired=%0d data=%0d mmio=%0d recover=%0d retire_hash=%016x data_hash=%016x mmio_hash=%016x",
+                 res_window, res_retired, res_data, res_mmio, res_recover,
+                 res_retire_hash, res_data_hash, res_mmio_hash);
+        res_window++;
+        res_active = 0;
+    end else if (res_active) begin
+        if (`RESCORE.wb_complete) begin
+            res_retired++;
+            res_retire_hash = res_mix(res_retire_hash, {`RESCORE.w[526:495], `RESCORE.w[494:463]});
+            res_retire_hash = res_mix(res_retire_hash, {25'b0, exceptions, `RESCORE.cpsr_next});
+            if (`RESCORE.wb_valid) begin
+                if (`RESCORE.wb_tag0 != 6'd16)
+                    res_retire_hash = res_mix(res_retire_hash, {26'b0, `RESCORE.wb_tag0, `RESCORE.wb_data0});
+                if (`RESCORE.wb_pair && `RESCORE.wb_tag1 != 6'd16)
+                    res_retire_hash = res_mix(res_retire_hash, {25'b0, 1'b1, `RESCORE.wb_tag1, `RESCORE.wb_data1});
+            end
+        end
+        if (`RESZAP.o_dbg_d_done) begin
+            res_data++;
+            res_data_hash = res_mix(res_data_hash, {26'b0, `RESZAP.data_err, `RESZAP.o_dbg_d_we,
+                                                   `RESZAP.o_dbg_d_sel, `RESZAP.o_dbg_d_va});
+            res_data_hash = res_mix(res_data_hash, {32'b0, `RESZAP.o_dbg_d_we ?
+                                                   `RESZAP.o_dbg_d_wdata : `RESZAP.o_dbg_d_rdata});
+        end
+        if (`RESUPP.master_cyc && `RESUPP.master_stb && !`RESUPP.master_code &&
+            (`RESUPP.slow_ack || `RESUPP.slow_error)) begin
+            res_mmio++;
+            res_mmio_hash = res_mix(res_mmio_hash, {26'b0, `RESUPP.slow_error, `RESUPP.master_we,
+                                                   `RESUPP.master_sel, `RESUPP.master_address});
+            res_mmio_hash = res_mix(res_mmio_hash, {32'b0, `RESUPP.master_we ?
+                                                   `RESUPP.master_data : `RESUPP.slow_read_data});
+        end
+    end
+end
+`undef RESFETCH
+`undef RESCORE
+`undef RESZAP
+`undef RESUPP
diff --git a/scratch/v5-fit-loop/waw-retire-two-cut/wb-write-trace.vh b/scratch/v5-fit-loop/waw-retire-two-cut/wb-write-trace.vh
new file mode 100644
index 0000000..e4ee4c7
--- /dev/null
+++ b/scratch/v5-fit-loop/waw-retire-two-cut/wb-write-trace.vh
@@ -0,0 +1,98 @@
+`define WC dut.board.upp.cpu_inside.cpu
+`define WZ `WC.u_arm925t.u_zap
+`define WD `WZ.l_generate_with_cache_mmu.u_data_cache
+`define WM `WZ.l_merger_for_core_with_cache_mmu.u_zap_wb_merger
+wire obs_bus_on = `WM.o_wb_cyc && `WM.o_wb_stb;
+wire obs_write = obs_bus_on && `WM.o_wb_wen;
+wire obs_ack = obs_bus_on && `WM.i_wb_ack && !`WM.i_wb_err;
+wire obs_err = obs_bus_on && `WM.i_wb_err;
+wire obs_native = obs_write && `WC.wb_write_block;
+wire [3:0] obs_owner = `WM.o_dbg_data_owner ? `WD.state_ff : 4'b0;
+wire [7:0] obs_ctl = {`WM.o_wb_cti, `WM.o_wb_sel, obs_native};
+wire [31:0] obs_adr = `WM.o_wb_adr;
+wire [31:0] obs_data = `WM.o_wb_dat;
+wire [127:0] obs_block = obs_native ? `WC.wb_block_data : 128'b0;
+wire [199:0] obs_payload = {obs_adr, obs_ctl, obs_data, obs_block};
+wire [2:0] obs_source = {obs_native, `WD.u_zap_cache_fsm.state_ff[`WD.u_zap_cache_fsm.CLEAN_SINGLE], `WM.o_dbg_data_owner};
+
+integer wbt_window = 0;
+integer wbt_clock, wbt_writes, wbt_stalls, wbt_read_acks, wbt_write_acks, wbt_errors;
+integer wbt_read_to_write, wbt_write_next_changed, wbt_owner_changes;
+integer wbt_tag_changed, wbt_cch_changed, wbt_native_changed, wbt_post_changed, wbt_unc_changed;
+integer wbt_tag, wbt_cch, wbt_native, wbt_post, wbt_unc;
+reg wbt_active = 0;
+reg wbt_prev_read_ack, wbt_prev_write_ack, wbt_prev_stalled;
+reg [3:0] wbt_prev_owner;
+reg [199:0] wbt_prev_payload;
+reg [63:0] wbt_digest;
+
+always @(posedge clk) if (!reset) begin
+    if (retire && retire_pc == res_begin) begin
+        wbt_active = 1;
+        wbt_clock = 0;
+        wbt_writes = 0; wbt_stalls = 0; wbt_read_acks = 0; wbt_write_acks = 0; wbt_errors = 0;
+        wbt_read_to_write = 0; wbt_write_next_changed = 0; wbt_owner_changes = 0;
+        wbt_tag_changed = 0; wbt_cch_changed = 0; wbt_native_changed = 0;
+        wbt_post_changed = 0; wbt_unc_changed = 0;
+        wbt_tag = 0; wbt_cch = 0; wbt_native = 0; wbt_post = 0; wbt_unc = 0;
+        wbt_prev_read_ack = 0; wbt_prev_write_ack = 0; wbt_prev_stalled = 0;
+        wbt_prev_owner = 0; wbt_prev_payload = 0;
+        wbt_digest = RES_INITIAL;
+    end else if (retire && retire_pc == res_end && wbt_active) begin
+        $display("RES_WB window=%0d offer=%0d stall=%0d read_ack=%0d write_ack=%0d write_error=%0d read_to_write=%0d changed_after_write_ack=%0d owner_changes=%0d tag=%0d evict_scalar=%0d evict_native=%0d post=%0d unc=%0d tag_changed=%0d evict_scalar_changed=%0d evict_native_changed=%0d post_changed=%0d unc_changed=%0d write_hash=%016x",
+                 wbt_window,wbt_writes,wbt_stalls,wbt_read_acks,wbt_write_acks,wbt_errors,
+                 wbt_read_to_write,wbt_write_next_changed,wbt_owner_changes,
+                 wbt_tag,wbt_cch,wbt_native,wbt_post,wbt_unc,wbt_tag_changed,
+                 wbt_cch_changed,wbt_native_changed,wbt_post_changed,wbt_unc_changed,wbt_digest);
+        wbt_window++;
+        wbt_active = 0;
+    end else if (wbt_active) begin
+        wbt_clock++;
+        if (obs_ack && !obs_write) wbt_read_acks++;
+        if (wbt_prev_stalled && !obs_write) $fatal(1, "write withdrawn while stalled");
+        if (obs_write) begin
+            wbt_writes++;
+            if (wbt_prev_stalled && obs_payload !== wbt_prev_payload)
+                $fatal(1, "stalled write changed payload");
+            if (obs_ack) begin
+                wbt_write_acks++;
+                case (obs_owner)
+                    4'b0010: wbt_tag++;
+                    4'b1000: wbt_post++;
+                    4'b0001: if (obs_native) wbt_native++; else if (obs_source[1]) wbt_cch++; else wbt_unc++;
+                    default: $fatal(1, "unexpected write owner %b", obs_owner);
+                endcase
+            end else if (obs_err) wbt_errors++;
+            else wbt_stalls++;
+            if (wbt_prev_read_ack) wbt_read_to_write++;
+            if (wbt_prev_write_ack) begin
+                if (wbt_prev_owner != obs_owner) wbt_owner_changes++;
+                if (obs_payload[159:0] != wbt_prev_payload[159:0]) begin
+                    wbt_write_next_changed++;
+                    if (wbt_prev_owner == obs_owner)
+                        case (obs_owner)
+                            4'b0010: wbt_tag_changed++;
+                            4'b1000: wbt_post_changed++;
+                            4'b0001: if (obs_native) wbt_native_changed++; else if (obs_source[1]) wbt_cch_changed++; else wbt_unc_changed++;
+                            default: ;
+                        endcase
+                end
+            end
+            wbt_digest = res_mix(wbt_digest, {obs_adr, wbt_clock[21:0], obs_ctl, obs_ack, obs_err});
+            wbt_digest = res_mix(wbt_digest, {31'b0, `WC.wb_lock, obs_data});
+            if (obs_native) begin
+                wbt_digest = res_mix(wbt_digest, obs_block[63:0]);
+                wbt_digest = res_mix(wbt_digest, obs_block[127:64]);
+            end
+        end
+        wbt_prev_read_ack = obs_ack && !obs_write;
+        wbt_prev_write_ack = obs_ack && obs_write;
+        wbt_prev_stalled = obs_write && !obs_ack && !obs_err;
+        wbt_prev_owner = obs_owner;
+        wbt_prev_payload = obs_payload;
+    end
+end
+`undef WM
+`undef WD
+`undef WZ
+`undef WC
diff --git a/scratch/v5-fit-loop/waw-retire-two-cut/waw-census.vh b/scratch/v5-fit-loop/waw-retire-two-cut/waw-census.vh
new file mode 100644
index 0000000..f1edcfd
--- /dev/null
+++ b/scratch/v5-fit-loop/waw-retire-two-cut/waw-census.vh
@@ -0,0 +1,53 @@
+`define WAW_CORE dut.board.upp.cpu_inside.cpu.u_arm925t.u_zap.g_arm9.u_arm9_core
+`define WAW_EXEC `WAW_CORE.u_execute
+
+// Preserve every execute admission term except the experimental W-order guard.
+wire waw_can_release = `WAW_CORE.s_wait_w_nohit && `WAW_CORE.w_load_hit &&
+    `WAW_CORE.wb_valid && `WAW_CORE.request_done && !`WAW_CORE.retry && !`WAW_CORE.resp_err;
+wire waw_opportunity = waw_can_release && `WAW_EXEC.i_valid && `WAW_EXEC.s_admit_common &&
+    (!`WAW_EXEC.a_valid || `WAW_EXEC.a_finish_hit) &&
+    (!`WAW_EXEC.s_needs_w || !`WAW_EXEC.i_self_dep || `WAW_EXEC.i_load_trust) &&
+    !`WAW_EXEC.i_flush && !`WAW_EXEC.o_redirect;
+
+integer waw_window = 0;
+integer waw_opportunities, waw_accepted, waw_blocked, waw_faults, waw_writes;
+reg waw_active = 0;
+reg [63:0] waw_ordered_write_hash;
+
+always @(posedge clk) if (!reset) begin
+    if (retire && retire_pc == res_begin) begin
+        waw_active = 1;
+        waw_opportunities = 0;
+        waw_accepted = 0;
+        waw_blocked = 0;
+        waw_faults = 0;
+        waw_writes = 0;
+        waw_ordered_write_hash = RES_INITIAL;
+    end else if (retire && retire_pc == res_end && waw_active) begin
+        $display("WAW_ORDER window=%0d opportunities=%0d accepted=%0d blocked=%0d same_w_faults=%0d writes=%0d ordered_hash=%016x",
+                 waw_window, waw_opportunities, waw_accepted, waw_blocked, waw_faults,
+                 waw_writes, waw_ordered_write_hash);
+        waw_window++;
+        waw_active = 0;
+    end else if (waw_active) begin
+        if (waw_opportunity) begin
+            if (!`WAW_CORE.wb_complete || !`WAW_CORE.done)
+                $fatal(1, "Trusted W load opportunity did not retire");
+            waw_opportunities++;
+            waw_accepted += `WAW_EXEC.accept;
+            waw_blocked += !`WAW_EXEC.accept;
+        end
+        waw_faults += `WAW_CORE.s_wait_w_nohit && `WAW_CORE.wb_dabt;
+        if (obs_write && obs_ack) begin
+            waw_writes++;
+            waw_ordered_write_hash = res_mix(waw_ordered_write_hash, {24'b0, obs_ctl, obs_adr});
+            waw_ordered_write_hash = res_mix(waw_ordered_write_hash, {25'b0, obs_source, obs_owner, obs_data});
+            if (obs_native) begin
+                waw_ordered_write_hash = res_mix(waw_ordered_write_hash, obs_block[63:0]);
+                waw_ordered_write_hash = res_mix(waw_ordered_write_hash, obs_block[127:64]);
+            end
+        end
+    end
+end
+`undef WAW_EXEC
+`undef WAW_CORE
diff --git a/scratch/v5-fit-loop/waw-retire-two-cut/board-waw.vh b/scratch/v5-fit-loop/waw-retire-two-cut/board-waw.vh
new file mode 100644
index 0000000..3cbff63
--- /dev/null
+++ b/scratch/v5-fit-loop/waw-retire-two-cut/board-waw.vh
@@ -0,0 +1,89 @@
+`define WAW_CORE cpu.u_arm925t.u_zap.g_arm9.u_arm9_core
+`define WAW_EXEC `WAW_CORE.u_execute
+
+reg [31:0] waw_start, waw_stop, waw_fault_pc, waw_follower_pc;
+integer waw_wait_for_retirement;
+integer waw_first_cycle = -1, waw_retired = 0, waw_issued = 0;
+integer waw_opportunity_count = 0, waw_stall_count = 0;
+integer waw_fault_seen = 0, waw_fault_same_order = 0, waw_follower_seen = 0;
+reg [31:0] waw_previous_w, waw_previous_s;
+reg waw_release_held = 0;
+
+initial begin
+    if (!$value$plusargs("waw-start=%h", waw_start) ||
+        !$value$plusargs("waw-stop=%h", waw_stop) ||
+        !$value$plusargs("waw-fault=%h", waw_fault_pc) ||
+        !$value$plusargs("waw-follower=%h", waw_follower_pc) ||
+        !$value$plusargs("waw-conservative=%d", waw_wait_for_retirement))
+        $fatal(1, "Missing WAW test addresses");
+end
+
+wire [31:0] waw_w_pc = `WAW_CORE.w[526:495];
+wire [31:0] waw_s_pc = `WAW_CORE.d_pc;
+wire waw_s_in_range = waw_s_pc >= waw_start && waw_s_pc < waw_stop;
+wire waw_w_in_range = waw_w_pc >= waw_start && waw_w_pc < waw_stop;
+wire waw_release_opportunity = `WAW_CORE.s_wait_w_nohit && `WAW_CORE.w_load_hit &&
+    `WAW_CORE.wb_valid && `WAW_CORE.request_done && !`WAW_CORE.retry && !`WAW_CORE.resp_err &&
+    `WAW_EXEC.i_valid && `WAW_EXEC.s_admit_common &&
+    (!`WAW_EXEC.a_valid || `WAW_EXEC.a_finish_hit) &&
+    (!`WAW_EXEC.s_needs_w || !`WAW_EXEC.i_self_dep || `WAW_EXEC.i_load_trust) &&
+    !`WAW_EXEC.i_flush && !`WAW_EXEC.o_redirect;
+
+always @(posedge clk) if (!reset) begin
+    if (waw_release_held &&
+        (`WAW_CORE.w[541] && waw_w_pc == waw_previous_w ||
+         !`WAW_EXEC.accept || waw_s_pc != waw_previous_s))
+        $fatal(1, "Deferred WAW packet did not accept on the next edge");
+    waw_release_held <= 0;
+    if (waw_s_in_range && waw_release_opportunity) begin
+        if (!`WAW_CORE.wb_complete || !`WAW_CORE.done ||
+            `WAW_EXEC.accept !== (waw_wait_for_retirement == 0))
+            $fatal(1, "Unexpected trusted-load admission at %h", waw_s_pc);
+        waw_opportunity_count <= waw_opportunity_count + 1;
+        if (waw_wait_for_retirement != 0) begin
+            waw_stall_count <= waw_stall_count + 1;
+            waw_release_held <= 1;
+            waw_previous_w <= waw_w_pc;
+            waw_previous_s <= waw_s_pc;
+        end
+        $display("WAW_OPPORTUNITY cycle=%0d older=%h younger=%h stall=%b",
+                 cycle, waw_w_pc, waw_s_pc, !`WAW_EXEC.accept);
+    end
+    if (`WAW_EXEC.accept && waw_s_in_range) begin
+        if (waw_s_pc != waw_start + 4*waw_issued) $fatal(1, "WAW issue duplicated or reordered");
+        waw_issued <= waw_issued + 1;
+    end
+    if (`WAW_CORE.wb_complete && waw_w_in_range) begin
+        if (waw_w_pc != waw_start + 4*waw_retired || !`WAW_CORE.wb_valid || !`WAW_CORE.wb_pair ||
+            `WAW_CORE.wb_tag1 != 9 || `WAW_CORE.wb_data1 !== (waw_retired[0] ? 32'h62 : 32'h37))
+            $fatal(1, "WAW load retired out of order or with wrong value: %h data %h",
+                   waw_w_pc, `WAW_CORE.wb_data1);
+        if (waw_retired == 0) waw_first_cycle <= cycle;
+        waw_retired <= waw_retired + 1;
+        $display("WAW_RETIRED %h %h", waw_w_pc, `WAW_CORE.wb_data1);
+    end
+    if (`WAW_CORE.wb_complete && waw_w_pc == waw_fault_pc) begin
+        if (!`WAW_CORE.wb_dabt || `WAW_CORE.wb_valid || `WAW_EXEC.accept)
+            $fatal(1, "Faulting older writer did not flush younger execution");
+        waw_fault_seen <= waw_fault_seen + 1;
+        waw_fault_same_order <= waw_fault_same_order + `WAW_CORE.s_wait_w_nohit;
+    end
+    if (`WAW_CORE.wb_complete && waw_w_pc == waw_follower_pc) begin
+        if (waw_fault_seen != 1 || !`WAW_CORE.wb_valid || !`WAW_CORE.wb_pair ||
+            `WAW_CORE.wb_tag1 != 4 || `WAW_CORE.wb_data1 !== 0)
+            $fatal(1, "Wrong fault follower after %0d aborts: valid=%b load=%h",
+                   waw_fault_seen, `WAW_CORE.wb_valid, `WAW_CORE.wb_data1);
+        waw_follower_seen <= waw_follower_seen + 1;
+    end
+    if (`WAW_CORE.wb_complete && waw_w_pc == waw_stop) begin
+        if (waw_retired != 64 || waw_issued != 64 || waw_opportunity_count == 0 ||
+            waw_fault_seen != 1 || waw_follower_seen != 1)
+            $fatal(1, "Missing WAW coverage: issued=%0d retired=%0d opportunities=%0d faults=%0d follows=%0d",
+                   waw_issued, waw_retired, waw_opportunity_count, waw_fault_seen, waw_follower_seen);
+        $display("WAW_PASS clocks=%0d issued=%0d retired=%0d opportunities=%0d stalls=%0d fault=%0d fault_same_order=%0d follower=%0d",
+                 cycle-waw_first_cycle, waw_issued, waw_retired, waw_opportunity_count, waw_stall_count,
+                 waw_fault_seen, waw_fault_same_order, waw_follower_seen);
+    end
+end
+`undef WAW_EXEC
+`undef WAW_CORE
diff --git a/scratch/v5-fit-loop/waw-retire-two-cut/waw-observer.sv b/scratch/v5-fit-loop/waw-retire-two-cut/waw-observer.sv
new file mode 100644
index 0000000..6780c98
--- /dev/null
+++ b/scratch/v5-fit-loop/waw-retire-two-cut/waw-observer.sv
@@ -0,0 +1,20 @@
+module production_waw_order_observer (
+    input wire clk,
+    input wire reset,
+    input wire enabled,
+    input wire wait_hit,
+    input wire wait_nohit
+);
+    initial begin
+        if (!enabled) $fatal(1, "Production conservative W ordering is inactive");
+        $display("WAW_ELAB enabled=1");
+    end
+    always @(posedge clk)
+        if (!reset && wait_hit !== wait_nohit)
+            $fatal(1, "Production W ordering depends on hit release");
+endmodule
+
+bind ngage2_arm9v2_core production_waw_order_observer test_waw_order (
+    .clk(i_clk), .reset(i_reset), .enabled(WAW_WAIT_RETIRE),
+    .wait_hit(s_wait_w_hit), .wait_nohit(s_wait_w_nohit)
+);
diff --git a/scratch/v5-fit-loop/waw-retire-two-cut/directed.sh b/scratch/v5-fit-loop/waw-retire-two-cut/directed.sh
new file mode 100644
index 0000000..61c90c5
--- /dev/null
+++ b/scratch/v5-fit-loop/waw-retire-two-cut/directed.sh
@@ -0,0 +1,57 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/waw-retire-two-cut
+out=build/sim/v5-104-waw-retire-two-cut/directed
+fixture=$area/reference/tests/cpu/arm9v2_board
+python3 -B "$area/prepare-directed.py"
+cp "$area/waw-observer.sv" "$out/"
+arm-none-eabi-gcc -c -mcpu=arm920t -marm -DEXPECTED_CTYPE=0x0514a14a -DASSOC_WAYS=2 \
+  -DSECTION_INDEX_TEST -I "$fixture" "$out/guest.S" -o "$out/guest.o"
+arm-none-eabi-ld -T "$area/reference/sim/programs/link.ld" "$out/guest.o" -o "$out/guest.elf"
+arm-none-eabi-objcopy -O binary "$out/guest.elf" "$out/guest.bin"
+python3 -B - "$out" <<'PY'
+from pathlib import Path
+import struct
+import sys
+
+out = Path(sys.argv[1])
+words = struct.iter_unpack('<I', (out / 'guest.bin').read_bytes())
+(out / 'guest.hex').write_text(''.join(f'{word:08x}\n' for (word,) in words))
+PY
+entry() { arm-none-eabi-nm "$out/guest.elf" | awk -v "name=$1" '$3 == name { print $1 }'; }
+for leg in reference source; do
+  flag=0
+  if [ "$leg" = source ]; then flag=1; fi
+  mkdir -p "$out/$leg"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$area/$leg:/work:ro" -v "$PWD/$out:/results" -w /work \
+    --entrypoint sh jotego/simulator:arm64 -ec '
+      out=/results/$1
+      observer=
+      if [ "$1" = source ]; then observer=/results/waw-observer.sv; fi
+      shift
+      verilator --binary --timing --assert -j 2 -Wno-fatal -Wno-lint -DNGAGE_ARM9V2 \
+        --top-module contract --Mdir "$out/obj" rtl/ngage_cpu.sv rtl/ngage_upp.v \
+        rtl/arm9v2/arm925t_phone.v rtl/arm9v2/upstream/sim/stubs/*.sv \
+        /results/contract.v $observer > "$out/build.log" 2>&1
+      for burst in 0 1; do
+        for wait in 0 5; do
+          log="$out/burst-$burst-wait-$wait.log"
+          "$out/obj/Vcontract" +program=/results/guest.hex "+wait=$wait" "+burst=$burst" \
+            +half-writeback +section-reads=2 "$@" > "$log" 2>&1
+          grep "^PASS " "$log"
+          grep "^WAW_PASS " "$log"
+          grep "^WAW_RETIRED " "$log" > "${log%.log}.ordered"
+        done
+      done
+    ' directed "$leg" "+waw-conservative=$flag" "+waw-start=$(entry waw_begin)" \
+      "+waw-stop=$(entry waw_end)" "+waw-fault=$(entry waw_fault)" "+waw-follower=$(entry waw_fault_follower)" \
+      > "$out/$leg.pass"
+done
+for burst in 0 1; do
+  for wait in 0 5; do
+    name=burst-$burst-wait-$wait.ordered
+    cmp "$out/reference/$name" "$out/source/$name"
+  done
+done
+cat "$out/reference.pass" "$out/source.pass"
