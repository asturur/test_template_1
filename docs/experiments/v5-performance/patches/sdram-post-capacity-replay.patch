index 0000000..7f49db1
--- /dev/null
+++ b/scratch/v5-fit-loop/sdram-post-capacity/mixed.py
@@ -0,0 +1,30 @@
+"""Stage the retained mixed board replay with only the candidate stream replaced."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shutil
+
+
+stage = Path(__file__).resolve().parent
+base = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+trial = Path('build/sim/v5-104-sdram-post-capacity-pin-mixed/mixed')
+trial.mkdir(parents=True)
+for name in ('source', 'build.sh', 'stress.hex', 'image.hex', 'program.hex'):
+    original = base / name
+    if original.is_dir():
+        shutil.copytree(original, trial / name)
+    else:
+        shutil.copyfile(original, trial / name)
+
+netlist = 'rtl/ngage_sdram_stream.v'
+shutil.copyfile(stage / 'source' / netlist, trial / 'source' / netlist)
+hashes = json.loads((base / 'source-hashes.json').read_text())
+assert netlist in hashes
+for name, reference in hashes.items():
+    file = trial / 'source' / name
+    actual = sha256((file if file.is_file() else Path(name)).read_bytes()).hexdigest()
+    assert (actual != reference) == (name == netlist), name
+    hashes[name] = actual
+(trial / 'source-hashes.json').write_text(json.dumps(hashes, indent=2) + '\n')
+build = trial / 'build.sh'
+build.write_text(build.read_text().replace(str(base), str(trial)))
diff --git a/scratch/v5-fit-loop/sdram-post-capacity/post_capacity_tb.v b/scratch/v5-fit-loop/sdram-post-capacity/post_capacity_tb.v
new file mode 100644
index 0000000..f8b0a39
--- /dev/null
+++ b/scratch/v5-fit-loop/sdram-post-capacity/post_capacity_tb.v
@@ -0,0 +1,78 @@
+`timescale 1ns / 1ps
+
+module post_capacity_tb;
+    reg clk = 0;
+    always #5 clk = !clk;
+
+    reg cold = 1, req = 0, write_block = 0, command_ready = 1;
+    reg [24:0] address = 0;
+    reg [31:0] data = 0;
+    reg [ 3:0] byte_enable = 0;
+    reg [127:0] block_data = 0;
+    wire owner_ready, ack, command, command_write;
+    wire [24:2] command_address;
+    wire [127:0] command_data;
+    wire [15:0] command_bytes;
+
+    ngage_sdram_stream #(.SCRUB_BYTES(25'd16)) stream (
+        .clk(clk), .cold(cold), .phone_reset(1'b0), .lock(1'b0),
+        .owner_ready(owner_ready), .grant_read(1'b0), .grant_addr(25'd0),
+        .req(req), .we(1'b1), .write_block(write_block),
+        .block_data(block_data), .addr(address), .din(data), .be(byte_enable),
+        .ack(ack), .dout(), .line_req(1'b0), .line_short(1'b0),
+        .line_addr(25'd0), .line_ready(), .line_valid(), .line_data(), .line_last(),
+        .mem_req(command), .mem_we(command_write), .mem_line(), .mem_short(),
+        .mem_addr(command_address), .mem_wdata(command_data), .mem_wbe(command_bytes),
+        .scrub_done(), .mem_ready(1'b1), .mem_cmd_ready(command_ready),
+        .mem_busy(1'b0), .mem_valid(1'b0), .mem_rdata(32'd0)
+    );
+
+    initial begin
+        @(negedge clk);
+        cold = 0;
+        wait (owner_ready);
+        @(negedge clk);
+        command_ready = 0;
+        req = 1;
+        address = 25'h104;
+        data = 32'h89ab_cdef;
+        byte_enable = 4'b0110;
+        #1;
+        if (!ack || command) $fatal(1, "empty slot did not capture without scheduler ready");
+
+        @(negedge clk);
+        req = 0;
+        @(negedge clk);
+        req = 1;
+        write_block = 1;
+        address = 25'h120;
+        block_data = 128'h19_28_37_46_55_64_73_82_91_a0_bf_ce_dd_ec_fb_0a;
+        #1;
+        if (ack || command) $fatal(1, "a full slot acknowledged while the scheduler stalled");
+
+        @(negedge clk);
+        command_ready = 1;
+        #1;
+        if (ack || !command || !command_write || command_address !== (25'h104 >> 2) ||
+            command_data !== {4{32'h89ab_cdef}} || command_bytes !== 16'h0060)
+            $fatal(1, "dequeue did not preserve the first payload or changed upstream ACK");
+
+        @(negedge clk);
+        #1;
+        if (!ack || !command || !command_write || command_address !== (25'h120 >> 2) ||
+            command_data !== block_data || command_bytes !== 16'hffff)
+            $fatal(1, "held successor did not use the original direct command path");
+
+        @(negedge clk);
+        req = 0;
+        #1;
+        if (ack || command) $fatal(1, "accepted packet replayed after release");
+        $display("PASS posted capacity, full-slot backpressure and ordered scalar/block writes");
+        $finish;
+    end
+
+    initial begin
+        #200;
+        $fatal(1, "posted-capacity check timed out");
+    end
+endmodule
