+`define LIVE_CORE dut.board.upp.cpu_inside.cpu.u_arm925t.u_zap.g_arm9.u_arm9_core
+`define LIVE_EXEC `LIVE_CORE.u_execute
+integer live_a, live_a_rn, live_a_rm, live_a_flags, live_a_cmp, live_a_dp, live_a_mem;
+integer live_s, live_s_rs, live_s_shift, live_union;
+wire live_a_trigger = `LIVE_EXEC.finish && `LIVE_EXEC.a_load_hit && (|`LIVE_EXEC.a_wait_for_w);
+wire live_s_trigger = `LIVE_EXEC.accept && `LIVE_EXEC.s_load_hit && `LIVE_EXEC.s_needs_w;
+wire live_a_dp_hit = live_a_trigger && `LIVE_EXEC.o_condition_pass &&
+                     `LIVE_EXEC.a[327-:4] == `LIVE_EXEC.DP;
+
+always @(posedge clk) if (!reset) begin
+    if (retire && retire_pc == res_begin) begin
+        live_a = 0;
+        live_a_rn = 0;
+        live_a_rm = 0;
+        live_a_flags = 0;
+        live_a_cmp = 0;
+        live_a_dp = 0;
+        live_a_mem = 0;
+        live_s = 0;
+        live_s_rs = 0;
+        live_s_shift = 0;
+        live_union = 0;
+    end else if (retire && retire_pc == res_end && res_active) begin
+        $display("LIVE_LOAD a=%0d a_rn=%0d a_rm=%0d a_flags=%0d a_cmp=%0d a_dp=%0d a_mem=%0d s=%0d s_rs=%0d s_shift=%0d union_count=%0d",
+            live_a, live_a_rn, live_a_rm, live_a_flags, live_a_cmp, live_a_dp, live_a_mem,
+            live_s, live_s_rs, live_s_shift, live_union);
+    end else if (res_active && !(retire && retire_pc == res_begin)) begin
+        if (live_a_trigger) begin
+            live_a++;
+            live_a_rn += `LIVE_EXEC.a_wait_for_w[0];
+            live_a_rm += `LIVE_EXEC.a_wait_for_w[1];
+            live_a_flags += live_a_dp_hit && `LIVE_EXEC.will_write_flags;
+            live_a_cmp += live_a_dp_hit && `LIVE_EXEC.will_write_flags && `LIVE_EXEC.a[153-:4] == 4'ha;
+            live_a_dp += live_a_dp_hit;
+            live_a_mem += `LIVE_EXEC.o_memory;
+        end
+        if (live_s_trigger) begin
+            live_s++;
+            live_s_rs += `LIVE_EXEC.s_wait_for_w[2] && `LIVE_EXEC.i_early[2] &&
+                         `LIVE_EXEC.direct_reg_shift;
+            live_s_shift += `LIVE_EXEC.i_reg_shift || `LIVE_EXEC.agu_scaled;
+        end
+        live_union += live_a_trigger || live_s_trigger;
+    end
+end
+`undef LIVE_EXEC
+`undef LIVE_CORE
