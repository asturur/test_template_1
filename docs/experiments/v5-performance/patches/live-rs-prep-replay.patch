--- /dev/null
+++ b/scratch/v5-fit-loop/live-rs-prep/post-capacity-census.vh
@@ -0,0 +1,28 @@
+// Observe the retained one-slot stream without changing the handshake.
+integer post_direct = 0;
+integer post_queue_empty = 0;
+integer post_replace = 0;
+integer post_blocked = 0;
+integer post_blocked_starts = 0;
+integer post_blocked_blocks = 0;
+reg post_blocked_prev = 0;
+wire post_offer = bridge.scalar && bridge.we && !bridge.lock;
+wire post_offer_blocked = post_offer && bridge.pending && !bridge.mem_cmd_ready;
+always @(posedge bridge.clk) begin
+    if (post_offer) begin
+        if (bridge.direct_post) post_direct = post_direct + 1;
+        else if (!bridge.pending) post_queue_empty = post_queue_empty + 1;
+        else if (bridge.take_pending) post_replace = post_replace + 1;
+        else begin
+            post_blocked = post_blocked + 1;
+            if (!post_blocked_prev) post_blocked_starts = post_blocked_starts + 1;
+            if (bridge.write_block) post_blocked_blocks = post_blocked_blocks + 1;
+        end
+    end
+    post_blocked_prev <= post_offer_blocked;
+end
+final begin
+    $display("POST_CAPACITY direct=%0d queued_empty=%0d replaced=%0d blocked_cycles=%0d blocked_offers=%0d blocked_block_cycles=%0d",
+             post_direct, post_queue_empty, post_replace, post_blocked,
+             post_blocked_starts, post_blocked_blocks);
+end
