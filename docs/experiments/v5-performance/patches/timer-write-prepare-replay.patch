@@ -0,0 +1,53 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/timer-write-prepare
+out=build/sim/v5-104-timer-write-prepare/original
+deck=${1:?supply a pinned original timer instruction deck directory}
+mkdir -p "$out"
+cp "$deck/app.hex" "$deck/boot.hex" "$deck/inputs.json" "$out"
+arm-none-eabi-gcc -c -mcpu=arm920t -marm "$area/source/tests/phone/timer_original/program.S" -o "$out/program.o"
+arm-none-eabi-ld -T "$area/source/sim/programs/link.ld" "$out/program.o" -o "$out/program.elf"
+arm-none-eabi-objcopy -O binary "$out/program.elf" "$out/program.bin"
+cmp "$out/program.bin" "$deck/program.bin"
+cp "$deck/program.hex" "$out/"
+python3 -B - "$out" <<'PY'
+from hashlib import sha256
+import json
+from pathlib import Path
+import sys
+
+out = Path(sys.argv[1])
+inputs = json.loads((out / 'inputs.json').read_text())
+assert inputs['rom_sha256'] == '26ca1dd937e299fd4ec3ad65a25d395743ae2149311c3d753cbeb5437673dbc5'
+assert inputs['instruction_substitutions'] == []
+hashes = {'app.hex': '3b543ab996682f64c3c248a96b7b15f6b4f2e69f0d920b6e83e004c1161dcfab',
+          'boot.hex': 'bd62363f2eca7c9ec5fe4884b6471330434b251a2a283eb36d21df6d5aedb8e2'}
+for name, expected in hashes.items():
+    raw = b''.join(int(word, 16).to_bytes(4, 'little') for word in (out / name).read_text().split())
+    assert sha256(raw).hexdigest() == expected, name
+program = b''.join(int(word, 16).to_bytes(4, 'little') for word in (out / 'program.hex').read_text().split())
+assert (out / 'program.bin').read_bytes().ljust(8192, b'\0') == program
+PY
+sed 's@scratch/ngage2-integration/timer-flow-2026-11-11/original/@/inputs/@g' \
+  "$area/source/tests/phone/timer_original/tb.v" > "$out/tb.v"
+for leg in reference source; do
+  mkdir -p "$out/$leg"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$area/$leg:/work:ro" -v "$PWD/$out:/inputs" -w /work \
+    --entrypoint sh jotego/simulator:arm64 -ec '
+      out=/inputs/$1
+      for div in 3 4; do
+        verilator --binary --timing --assert -j 2 -GDIV="$div" -DNGAGE_RUNTIME_TRACE \
+          -Wno-fatal -Wno-lint -Irtl/arm --top-module tb --Mdir "$out/obj-$div" \
+          rtl/ngage_cpu.sv rtl/arm/*.sv rtl/ngage_bram.v rtl/arm920/*.sv rtl/ngage_timers.v \
+          /inputs/tb.v > "$out/build-$div.log" 2>&1
+        for wait_clocks in 0 3; do
+          log="$out/run-$div-$wait_clocks.log"
+          "$out/obj-$div/Vtb" +ngage-compact-trace "+wait=$wait_clocks" > "$log" 2>&1
+          grep "^PASS " "$log"
+        done
+      done
+    ' original "$leg" > "$out/$leg.pass"
+done
+cmp "$out/reference.pass" "$out/source.pass"
+cat "$out/source.pass"
diff --git a/scratch/v5-fit-loop/timer-write-prepare/record.py b/scratch/v5-fit-loop/timer-write-prepare/record.py
new file mode 100644
index 0000000..8a89811
--- /dev/null
+++ b/scratch/v5-fit-loop/timer-write-prepare/record.py
@@ -0,0 +1,174 @@
+"""Verify the prepared timer-write qualification against the retained replays."""
+import csv
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+root = stage.parents[2]
+out = Path('build/sim/v5-104-timer-write-prepare')
+retained = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+controls = stage.parent / 'prepared-wb-write-data/candidate'
+changed = ('rtl/ngage_timers.v', 'rtl/ngage_upp.v', 'rtl/ngage_upp_peripherals.v')
+
+
+def digest(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def match(left, right):
+    assert left.read_bytes() == right.read_bytes(), left
+    return digest(left)
+
+
+def git(*args):
+    return subprocess.check_output(['git', *args], text=False)
+
+
+def pass_lines(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+def trace_digest(rows):
+    return sha256(json.dumps(rows, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+
+
+tree = git('rev-parse', '11c4a0c^{tree}').decode().strip()
+assert tree == git('rev-parse', 'e9552bd^{tree}').decode().strip()
+rtl = {file: digest(stage / 'source' / file) for file in changed}
+reference_rtl = {name: sha256(git('show', f'11c4a0c:{name}')).hexdigest() for name in changed}
+assert reference_rtl == {name: digest(stage / 'reference' / name) for name in changed}
+receipt = {
+    'status': 'PASS',
+    'baseline': git('rev-parse', '11c4a0c').decode().strip(),
+    'baseline_tree': tree,
+    'design_patch_sha256': digest(stage / 'timer-write-prepare.patch'),
+    'fixture_patch_sha256': digest(stage / 'timer-write-prepare-replay.patch'),
+    'candidate_rtl_sha256': rtl,
+    'retained_rtl_sha256': reference_rtl,
+    'simulator': (out / 'image.id').read_text().strip(),
+}
+
+
+def selected_sources(manifest, prefix):
+    lines = manifest.read_text().splitlines()
+    records = [entry.groups() for line in lines
+               if (entry := re.fullmatch(r'S .*?"([^"]+)" "([^"]+)"', line))]
+    verified = {}
+    for name, sha in rtl.items():
+        [(fingerprint, source)] = [(a, b) for a, b in records if b.endswith(f'/{name}') or b == name]
+        assert source == f'{prefix}/{name}'
+        assert digest(Path(source.removeprefix('/frozen/'))) == sha
+        verified[name] = {'sha256': sha, 'verilator_fingerprint': fingerprint}
+    return verified
+
+
+directed = out / 'directed'
+trace = directed / 'source.trace'
+checks = pass_lines(trace)
+assert len(checks) == 1 and 'decode=8192 responses=6025 clocks=41235' in checks[0]
+rows = len(trace.read_bytes().splitlines())
+assert rows == 8397
+receipt['directed'] = {'decode_cases': 8192, 'responses': 6025, 'clocks': 41235,
+                       'trace_records': rows, 'trace_sha256': match(trace, directed / 'reference.trace')}
+units = out / 'units'
+receipt['timer_units'] = {'trace_sha256': match(units / 'source.pass', units / 'reference.pass'),
+                          'matched_tests': pass_lines(units / 'source.pass'),
+                          'timer_icu_conformance': pass_lines(units / 'conformance.log')}
+assert len(receipt['timer_units']['matched_tests']) == 9
+assert len(receipt['timer_units']['timer_icu_conformance']) == 1
+original = out / 'original'
+receipt['original_timer_instructions'] = {
+    'input_manifest_sha256': digest(original / 'inputs.json'),
+    'pass_sha256': match(original / 'source.pass', original / 'reference.pass'),
+    'matched_profiles': pass_lines(original / 'source.pass'),
+}
+assert len(receipt['original_timer_instructions']['matched_profiles']) == 4
+
+board = []
+for burst in (0, 1):
+    for wait in (0, 5):
+        trace = f'burst-{burst}-wait-{wait}.trace'
+        file = out / 'board/source' / trace
+        [summary] = pass_lines(file)
+        board.append({'burst': burst, 'wait': wait, 'pass': summary,
+                      'trace_sha256': match(file, out / 'board/reference' / trace)})
+receipt['board_contract'] = board
+
+results = out / 'qualification'
+for kind, count in (('fixed', 15), ('native', 1)):
+    path = results / f'{kind}.json'
+    old_path = controls / f'{kind}.json'
+    trial = json.loads(path.read_text())
+    old = json.loads(old_path.read_text())
+    assert trial['status'] == old['status'] == 'PASS'
+    assert all(trial['source_sha256'][Path(name).name] == sha for name, sha in rtl.items())
+    for key in ('netlist_sha256', 'wrapper_sha256', 'ddr_stream_sha256', 'dma_channels_sha256'):
+        assert trial[key] == old[key]
+    assert len(trial['rows']) == len(old['rows']) == count
+    old_rows = {row['candidate']['case']: row['candidate'] for row in old['rows']}
+    rows = []
+    for row in trial['rows']:
+        case = row['candidate']
+        name = case['case']
+        assert row['control'] == case == old_rows[name]
+        item = {'case': name, 'architectural_sha256': trace_digest(case['architecture']),
+                'valid_write_trace_sha256': trace_digest(case['wb_writes'])}
+        if kind == 'fixed':
+            assert len(case['windows']) == 7
+            assert 'Guest output check rejected payload' in (results / f'{name}-00-0-wrong.log').read_text()
+            assert (results / f'{name}-00-1.log').is_file()
+            item.update(window_cycles=[point['cycles'] for point in case['windows']],
+                        median_cycles=case['median'], repeat_and_negative_output_check=True)
+        else:
+            assert len(case['frames']) == 4
+            item.update(frame_cycles=[frame['clocks'] for frame in case['frames']],
+                        output_sha256=case['output_sha256'])
+        rows.append(item)
+    receipt[kind] = {
+        'source_checks': selected_sources(results / f'obj-{kind}/Vtb__verFiles.dat',
+                                          f'/frozen/{stage.relative_to(root)}/source'),
+        'candidate_receipt_sha256': digest(path),
+        'retained_receipt_sha256': digest(old_path),
+        'rows': rows,
+    }
+
+mixed = out / 'mixed'
+new_hashes = json.loads((mixed / 'source-hashes.json').read_text())
+old_hashes = json.loads((retained / 'source-hashes.json').read_text())
+assert new_hashes.keys() == old_hashes.keys()
+assert {name: sha for name, sha in new_hashes.items() if sha != old_hashes[name]} == rtl
+both = out / 'coexistence'
+for test, logfile, trace, reference, count, clocks in (
+    ('physical_mixed', mixed / 'replay.log', mixed / 'traffic.log', retained / 'traffic.log', 171496, 1201547),
+    ('timer_mmc_lcd_coexistence', both / 'candidate.log', both / 'candidate.trace', both / 'retained.trace', 171497, 1201528),
+):
+    checks = pass_lines(logfile)
+    assert len(checks) == 4 and f'cycles={clocks}' in checks[-1]
+    assert len(trace.read_bytes().splitlines()) == count
+    receipt[test] = {'trace_sha256': match(trace, reference), 'events': count, 'clocks': clocks, 'checks': checks}
+receipt['physical_mixed']['source_count'] = len(new_hashes)
+receipt['physical_mixed']['source_checks'] = selected_sources(mixed / 'obj/Vtb__verFiles.dat', f'{mixed}/source')
+assert receipt['fixed']['source_checks'] == receipt['native']['source_checks'] == receipt['physical_mixed']['source_checks']
+receipt['timer_mmc_lcd_coexistence']['stress_sha256'] = digest(both / 'stress-timer.hex')
+
+report = json.loads(Path('docs/evidence/v5-104-retained-sweep.json').read_text())
+census = []
+for control in sorted(report['ranked'], key=lambda row: row['seed']):
+    row = {'seed': control['seed'], 'run': control['run']}
+    for tag, path in (('hot', 'corner-1'), ('cold', 'corner-2')):
+        directory = Path(f"build/timing-audit-{control['run']}/output_files/timing/resident-store/104/{path}")
+        with (directory / 'setup.csv').open() as source:
+            paths = [row for row in csv.DictReader(source)
+                     if '|ngage_timers:timers|g_timer[' in row['to'] and '.count[' in row['to']
+                     and float(row['slack_ns']) < -1.5]
+        row[tag] = {'below_minus_1_5_ns': len(paths),
+                    'from_reset_drain': sum('reset_drain' in route['from'] for route in paths),
+                    'worst_ns': min((float(route['slack_ns']) for route in paths), default=None)}
+    census.append(row)
+receipt['retained_timer_count_paths'] = census
+(stage / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print('PASS prepared timer packets, original instructions, fixed/native workloads, physical and timer/MMC/LCD pin traces')
