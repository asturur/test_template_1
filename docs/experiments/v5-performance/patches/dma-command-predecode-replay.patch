diff --git a/scratch/v5-fit-loop/dma-command-predecode/architectural_trace.vh b/scratch/v5-fit-loop/dma-command-predecode/architectural_trace.vh
new file mode 100644
index 0000000..88b6546
--- /dev/null
+++ b/scratch/v5-fit-loop/dma-command-predecode/architectural_trace.vh
@@ -0,0 +1,69 @@
+`define RESUPP dut.board.upp.cpu_inside
+`define RESZAP `RESUPP.cpu.u_arm925t.u_zap
+`define RESCORE `RESZAP.g_arm9.u_arm9_core
+`define RESFETCH `RESCORE.u_front_decode.u_fetch
+
+reg [31:0] res_begin, res_end;
+integer res_window = 0;
+integer res_retired, res_data, res_mmio, res_recover;
+reg res_active = 0;
+reg [63:0] res_retire_hash, res_data_hash, res_mmio_hash;
+localparam [63:0] RES_INITIAL = 64'hcbf29ce484222325;
+initial begin
+    if (!$value$plusargs("begin_pc=%h", res_begin) || !$value$plusargs("end_pc=%h", res_end))
+        $fatal(1, "Missing architectural digest window");
+end
+
+function automatic [63:0] res_mix(input [63:0] digest, input [63:0] data);
+    res_mix = (digest ^ data) * 64'h00000100000001b3;
+endfunction
+
+always @(posedge clk) if (!reset) begin
+    if (retire && retire_pc == res_begin) begin
+        res_active = 1;
+        res_retired = 0;
+        res_data = 0;
+        res_mmio = 0;
+        res_recover = 0;
+        res_retire_hash = RES_INITIAL;
+        res_data_hash = RES_INITIAL;
+        res_mmio_hash = RES_INITIAL;
+    end else if (retire && retire_pc == res_end && res_active) begin
+        $display("RES_ARCH window=%0d retired=%0d data=%0d mmio=%0d recover=%0d retire_hash=%016x data_hash=%016x mmio_hash=%016x",
+                 res_window, res_retired, res_data, res_mmio, res_recover,
+                 res_retire_hash, res_data_hash, res_mmio_hash);
+        res_window++;
+        res_active = 0;
+    end else if (res_active) begin
+        if (`RESCORE.wb_complete) begin
+            res_retired++;
+            res_retire_hash = res_mix(res_retire_hash, {`RESCORE.w[526:495], `RESCORE.w[494:463]});
+            res_retire_hash = res_mix(res_retire_hash, {25'b0, exceptions, `RESCORE.cpsr_next});
+            if (`RESCORE.wb_valid) begin
+                if (`RESCORE.wb_tag0 != 6'd16)
+                    res_retire_hash = res_mix(res_retire_hash, {26'b0, `RESCORE.wb_tag0, `RESCORE.wb_data0});
+                if (`RESCORE.wb_pair && `RESCORE.wb_tag1 != 6'd16)
+                    res_retire_hash = res_mix(res_retire_hash, {25'b0, 1'b1, `RESCORE.wb_tag1, `RESCORE.wb_data1});
+            end
+        end
+        if (`RESZAP.o_dbg_d_done) begin
+            res_data++;
+            res_data_hash = res_mix(res_data_hash, {26'b0, `RESZAP.data_err, `RESZAP.o_dbg_d_we,
+                                                   `RESZAP.o_dbg_d_sel, `RESZAP.o_dbg_d_va});
+            res_data_hash = res_mix(res_data_hash, {32'b0, `RESZAP.o_dbg_d_we ?
+                                                   `RESZAP.o_dbg_d_wdata : `RESZAP.o_dbg_d_rdata});
+        end
+        if (`RESUPP.master_cyc && `RESUPP.master_stb && !`RESUPP.master_code &&
+            (`RESUPP.slow_ack || `RESUPP.slow_error)) begin
+            res_mmio++;
+            res_mmio_hash = res_mix(res_mmio_hash, {26'b0, `RESUPP.slow_error, `RESUPP.master_we,
+                                                   `RESUPP.master_sel, `RESUPP.master_address});
+            res_mmio_hash = res_mix(res_mmio_hash, {32'b0, `RESUPP.master_we ?
+                                                   `RESUPP.master_data : `RESUPP.slow_read_data});
+        end
+    end
+end
+`undef RESFETCH
+`undef RESCORE
+`undef RESZAP
+`undef RESUPP
diff --git a/scratch/v5-fit-loop/dma-command-predecode/replay.py b/scratch/v5-fit-loop/dma-command-predecode/replay.py
new file mode 100644
index 0000000..3a32a7d
--- /dev/null
+++ b/scratch/v5-fit-loop/dma-command-predecode/replay.py
@@ -0,0 +1,178 @@
+"""Replay DMA programming predecode against the frozen 104 MHz execute control."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import statistics
+import subprocess
+import sys
+
+parser = argparse.ArgumentParser()
+parser.add_argument('kind', choices=('fixed', 'native'))
+parser.add_argument('--case', action='append')
+parser.add_argument('--workers', type=int, default=3)
+parser.add_argument('--output', default='replay')
+args = parser.parse_args()
+kind = args.kind
+stage = Path(__file__).resolve().parent
+repo = stage.parents[2]
+work = stage / args.output
+work.mkdir(exist_ok=True)
+baseline_name = 'v5-104-all-four-ram-candidate'
+fixed = repo / 'build/sim/payload-clocks' / baseline_name
+native = repo / 'build/sim/polycount' / baseline_name
+timing_baseline = repo / 'scratch/refill-issue-739d3bd'
+d_stage = stage / 'ngage_cpu.sv'
+candidate = stage / 'source/rtl/arm9v2/arm925t_phone.v'
+image = 'jotego/simulator:arm64'
+docker = ['docker', 'run', '--rm', '--pull=never', '--network', 'none', '--platform', 'linux/arm64',
+          '-v', f'{work}:/work', '-v', f'{repo}:/frozen:ro', '-w', '/work', '--entrypoint']
+sys.path.insert(0, str(repo / 'tests/cpu/arm9v2_board'))
+from payload_clocks import qualified_inputs
+
+
+def frozen(path):
+    return '/frozen/' + str(path.relative_to(repo))
+
+
+def run(options, entrypoint, log):
+    with log.open('w') as handle:
+        return subprocess.run(docker + [entrypoint, image] + options, stdout=handle,
+                              stderr=subprocess.STDOUT, check=False).returncode
+
+
+def build():
+    compiled_netlist = work / f'{kind}-candidate-cpu.v'
+    compiled_netlist.write_bytes(candidate.read_bytes())
+    ref = fixed if kind == 'fixed' else native / 'i16'
+    bench = (ref / 'tb.v').read_text()
+    observer = (stage / 'architectural_trace.vh').read_text()
+    (work / f'{kind}.sv').write_text(bench.rsplit('endmodule', 1)[0] + observer + '\nendmodule\n')
+    command = next(line for line in (ref / 'mmc3-nos64/Vtb__verFiles.dat').read_text().splitlines()
+                   if line.startswith('C '))
+    options = shlex.split(command.removeprefix('C "').removesuffix('"'))
+    net_hits, wrapper_hits, bench_hits = 0, 0, 0
+    for i, option in enumerate(options):
+        if option == 'rtl/ngage_cpu.sv':
+            options[i] = frozen(d_stage)
+            wrapper_hits += 1
+        elif option in {'rtl/ngage_ddr_stream.v', 'rtl/ngage_upp.v', 'rtl/ngage_dma_channels.v'}:
+            options[i] = frozen(stage / 'source' / option)
+        elif option.startswith('/work/') and option.endswith(('/arm925t_phone.v', '/arm925t-i16.v')):
+            options[i] = '/work/' + compiled_netlist.name
+            net_hits += 1
+        elif option.startswith('/work/') and option.endswith('/tb.v'):
+            options[i] = f'/work/{kind}.sv'
+            bench_hits += 1
+        elif option.startswith('/work/') and option.endswith(('.v', '.sv')):
+            options[i] = option.replace('/work/', '/frozen/', 1)
+        elif option.startswith('-Irtl/'):
+            options[i] = '-I' + frozen(timing_baseline / 'leg' / option[2:])
+        elif option.endswith(('.v', '.sv')):
+            source = timing_baseline / 'leg' / option
+            assert source.is_file(), source
+            options[i] = frozen(source)
+    assert net_hits == wrapper_hits == bench_hits == 1, (net_hits, wrapper_hits, bench_hits)
+    options[options.index('--Mdir') + 1] = f'obj-{kind}'
+    options.insert(0, '-I'+frozen(timing_baseline / 'leg'))
+    options[options.index('-j') + 1] = '3'
+    log = work / f'build-{kind}.log'
+    assert run(options, 'verilator', log) == 0, log
+    compiled = (work / f'obj-{kind}/Vtb__verFiles.dat').read_text().splitlines()
+    assert any(line.startswith('S ') and line.endswith('/dma-command-predecode/source/rtl/ngage_ddr_stream.v\"') for line in compiled)
+    for changed in ('ngage_upp.v', 'ngage_dma_channels.v'):
+        assert any(line.startswith('S ') and line.endswith(f'/dma-command-predecode/source/rtl/{changed}"') for line in compiled), changed
+    for source in (f'{kind}.sv', compiled_netlist.name):
+        assert any(line.startswith('S ') and line.endswith(f'"/work/{source}"') for line in compiled), source
+    for cache in (work / f'obj-{kind}').glob('*.gch'):
+        cache.unlink()
+
+
+def scan(log, prefix, hex_fields=False):
+    rows = []
+    for line in log.read_text().splitlines():
+        if line.startswith(prefix):
+            pairs = re.findall(r'(\w+)=(-?[0-9a-f]+)', line)
+            rows.append({k: int(v, 16 if hex_fields and k.endswith('_hash') else 10) for k, v in pairs})
+    return rows
+
+
+def digest(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def execute(profile, case, attempt=0, wrong=False):
+    delay, thumb = profile
+    inputs = ['+ngage-compact-trace', '+no-board-log',
+              '+extension=' + frozen(repo / 'build/firmware/nem4-factory/extension.bin')]
+    suffix = f'{delay}{thumb}-{attempt}{"-wrong" if wrong else ""}'
+    if kind == 'fixed':
+        name = case['name']
+        inputs += ['+core=' + frozen(fixed / f'{name}-{wrong}.bin'), '+cdrive=' + frozen(fixed / 'cdrive.bin'),
+                   f'+begin_pc={case["begin"]:x}', f'+end_pc={case["end"]:x}',
+                   f'+payload_base={case["payload_base"]:x}', f'+helper_base={case["helper_base"]:x}']
+    else:
+        name = 'native'
+        result = work / f'native-{suffix}.bin'
+        inputs += ['+core=' + frozen(native / 'core.bin'), '+cdrive=' + frozen(native / 'cdrive.bin'),
+                   '+snapshot=' + frozen(native / 'snapshot.bin'), f'+results=/work/native-{suffix}',
+                   '+begin_pc=68', '+end_pc=6c', '+done_pc=80', '+fail_pc=84']
+    log = work / f'{name}-{suffix}.log'
+    code = run(inputs, f'/work/obj-{kind}/Vtb', log)
+    if wrong:
+        assert code != 0 and 'Guest output check rejected payload' in log.read_text(), log
+        return None
+    assert code == 0, log
+    architecture = scan(log, 'RES_ARCH ', hex_fields=True)
+    if kind == 'fixed':
+        windows = scan(log, 'PAYLOAD_RESULT ')
+        assert len(architecture) == len(windows) == 7, log
+        assert len(scan(log, 'PAYLOAD_PASS ')) == 1
+        for actual, expect in zip(windows, case['windows'], strict=True):
+            assert actual['payload_ops'] == expect['payload_retire_proxy']
+            assert actual['helper_ops'] == expect['helper_retire_proxy']
+        return dict(profile=profile, case=name, windows=windows, architecture=architecture,
+                    median=statistics.median(x['cycles'] for x in windows[2:]))
+    frames = scan(log, 'POLY_FRAME ')
+    assert len(architecture) == len(frames) == 4, log
+    assert len(scan(log, 'PASS_POLYCOUNT ')) == 1
+    assert digest(result) == digest(native / 'i16/result.bin')
+    return dict(profile=profile, case=name, frames=frames, architecture=architecture,
+                output_sha256=digest(result), median=statistics.median(f['clocks'] for f in frames[1:]))
+
+
+def architectural_work(row):
+    return [{k:v for k,v in entry.items() if k != 'recover'} for entry in row['architecture']]
+
+control = json.loads((stage.parent/'execute-ready'/'replay'/f'{kind}.json').read_text())
+assert control['status'] == 'PASS'
+assert control['ddr_stream_sha256'] == digest(stage/'source/rtl/ngage_ddr_stream.v')
+reference = {r['candidate']['case']:r['candidate'] for r in control['rows']}
+
+build()
+rows=[]
+with ThreadPoolExecutor(max_workers=args.workers) as pool:
+    cases = [None] if kind=='native' else [case for case in qualified_inputs()
+                                            if not args.case or case['name'] in args.case]
+    if kind=='fixed':
+        assert len(cases)==(len(args.case) if args.case else 15)
+        cases.sort(key=lambda r:r['name']!='sega-scan')
+    for case in cases:
+        primary = pool.submit(execute, (0,0), case)
+        repeat = pool.submit(execute, (0,0), case, attempt=1) if kind=='fixed' else None
+        wrong = pool.submit(execute,(0,0),case,wrong=True) if kind=='fixed' else None
+        trial=primary.result()
+        if repeat:
+            assert trial==repeat.result() and wrong.result() is None
+        name=trial['case']
+        expected = {**reference[name], 'profile': (0,0)}
+        assert trial == expected, (name, trial, expected)
+        rows.append(dict(candidate=trial, control=expected))
+        print(name, trial['median'], flush=True)
+(work/f'{kind}.json').write_text(json.dumps(dict(status='PASS', netlist_sha256=digest(candidate),
+                                                wrapper_sha256=digest(d_stage), ddr_stream_sha256=digest(stage / 'source/rtl/ngage_ddr_stream.v'),
+                                                dma_channels_sha256=digest(stage / 'source/rtl/ngage_dma_channels.v'),
+                                                upp_sha256=digest(stage / 'source/rtl/ngage_upp.v'), rows=rows),indent=2)+'\n')
diff --git a/scratch/v5-fit-loop/dma-command-predecode/prepare-mixed.py b/scratch/v5-fit-loop/dma-command-predecode/prepare-mixed.py
new file mode 100644
index 0000000..73c9c12
--- /dev/null
+++ b/scratch/v5-fit-loop/dma-command-predecode/prepare-mixed.py
@@ -0,0 +1,42 @@
+from pathlib import Path
+import hashlib
+import importlib.util
+import json
+import sys
+import subprocess
+
+tag = sys.argv[1]
+assert tag in ('dma-command-predecode-control-pin', 'dma-command-predecode-pin')
+p = Path('tests/phone/upp_ddr_ram/prepare.py')
+spec = importlib.util.spec_from_file_location('prepare_mixed',p)
+fixture = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(fixture)
+fixture.OUT = Path(f'build/sim/v5-104-more-ram-{tag}-mixed')
+fixture.OUT.mkdir(parents=True, exist_ok=False)
+fixture.prepare_mixed()
+
+stage = Path(__file__).resolve().parent
+base = stage / 'source'
+changed = {'ngage_upp.v', 'ngage_dma_channels.v'}
+mixed = fixture.OUT/'mixed'
+source = mixed/'source'
+for path in sorted((source/'rtl').rglob('*')):
+    if path.is_file():
+        rel=path.relative_to(source)
+        name = str(path.relative_to(source/'rtl'))
+        if tag.endswith('-control-pin') and name in changed:
+            path.write_bytes(subprocess.check_output(['git','show',f'fc7b513:{rel}']))
+        else:
+            path.write_bytes((base/rel).read_bytes())
+
+testbench = source/'tests/phone/mmc_mister/tb.v'
+body = testbench.read_text()
+observer = (stage/'sdram-pin-trace.vh').read_text()
+testbench.write_text(body.rsplit('endmodule', 1)[0] + observer + '\nendmodule\n')
+
+file_hashes = json.loads((mixed/'source-hashes.json').read_text())
+for file in sorted(source.rglob('*')):
+    if file.is_file():
+        file_hashes[str(file.relative_to(source))] = hashlib.sha256(file.read_bytes()).hexdigest()
+(mixed/'source-hashes.json').write_text(json.dumps(file_hashes, indent=2)+'\n')
+print(f'Prepared mixed {tag} with only {changed} against execute-ready')
diff --git a/scratch/v5-fit-loop/dma-command-predecode/sdram-pin-trace.vh b/scratch/v5-fit-loop/dma-command-predecode/sdram-pin-trace.vh
new file mode 100644
index 0000000..a47a0fb
--- /dev/null
+++ b/scratch/v5-fit-loop/dma-command-predecode/sdram-pin-trace.vh
@@ -0,0 +1,35 @@
+    integer trace_file = 0;
+    integer sys_edge = 0, pin_edge = 0;
+    string trace_path;
+    initial if ($value$plusargs("compare_trace=%s", trace_path)) begin
+        trace_file = $fopen(trace_path, "w");
+        if (!trace_file) $fatal(1, "Could not open transaction trace");
+    end
+    final if (trace_file) $fclose(trace_file);
+
+    always @(posedge clk) begin
+        sys_edge = sys_edge + 1;
+        if (trace_file) begin
+            if (dma_cmd_valid)
+                $fwrite(trace_file,"D %0d %b %h %h %h\n",sys_edge,{dma_cmd_ready,dma_cmd_write},dma_cmd_addr,dma_cmd_data,dma_cmd_be);
+            if (dma_rsp_valid)
+                $fwrite(trace_file,"R %0d %b %h\n",sys_edge,dma_rsp_error,dma_rsp_data);
+            if (pin_req && pin_cmd_ready)
+                $fwrite(trace_file,"Q %0d %b %h %h %h\n",sys_edge,{pin_we,pin_line,pin_short},pin_address,
+                        pin_we ? pin_write_data : 128'b0,pin_we ? pin_write_mask : 16'b0);
+            if (cpu_ram_accept || merge_accept || csack || merge_ack)
+                $fwrite(trace_file,"O %0d %b %h %h\n",sys_edge,{bus_lock,cpu_ram_accept,merge_accept,csack,merge_ack,hold_scalar},
+                        csack ? csread : 32'b0,merge_ack ? merge_rdata : 32'b0);
+            if (shared_line_valid)
+                $fwrite(trace_file,"L %0d %b %h\n",sys_edge,shared_line_last,shared_line_data);
+            if (pin_valid) $fwrite(trace_file,"V %0d %h\n",sys_edge,pin_read_data);
+            if (hps_read || hps_write)
+                $fwrite(trace_file,"H %0d %b %h %h\n",sys_edge,{hps_read,hps_write,hps_ack},hps_lba,hps_count);
+        end
+    end
+    always @(posedge pin_clk) begin
+        pin_edge = pin_edge + 1;
+        if (trace_file && ((!cs_n && {ras_n,cas_n,we_n} != 3'b111) || |controller.sdram_dq_oe))
+            $fwrite(trace_file,"P %0d %b %h %h %h %h\n",pin_edge,{cke,cs_n,ras_n,cas_n,we_n,dqmh,dqml},
+                    bank,pin_a,controller.sdram_dq_oe,pin_out & controller.sdram_dq_oe);
+    end
diff --git a/scratch/v5-fit-loop/dma-command-predecode/preflight.py b/scratch/v5-fit-loop/dma-command-predecode/preflight.py
new file mode 100644
index 0000000..318b0ee
--- /dev/null
+++ b/scratch/v5-fit-loop/dma-command-predecode/preflight.py
@@ -0,0 +1,48 @@
+from hashlib import sha256
+from pathlib import Path
+import json
+import subprocess
+
+stage = Path(__file__).resolve().parent
+source = stage / "source"
+parent = "fc7b51349ed5a95baba0f8396185ab9d2efebce4"
+candidate = (stage / "candidate.sha").read_text().strip()
+changed = {"rtl/ngage_upp.v", "rtl/ngage_dma_channels.v"}
+runs = {43: 45301331404, 13: 45301335032, 31337: 45301339080}
+
+def git(*args):
+    return subprocess.check_output(["git", *args])
+
+assert git("rev-parse", candidate+"^").decode().strip() == parent
+for seed, run in runs.items():
+    receipt = json.loads(Path(f"build/timing-audit-{run}/output_files/resident-fit-manifest.json").read_text())
+    assert receipt["actual_commit"].startswith("c492853")
+    assert int(receipt["seed"]) == seed and receipt["physical_cpu_mhz"] == 104 and not receipt["debugger"]
+    qsf = stage / f"preflight-{seed}.qsf"
+    qsf.write_bytes(git("show", f"{candidate}:Template.qsf"))
+    subprocess.run(["python3", str(source/"tools/set_quartus_seed.py"), str(qsf), "--seed", str(seed)], cwd=stage, check=True)
+    subprocess.run(["python3", str(source/"tools/set_quartus_debug.py"), str(qsf), "--enabled", "false"], cwd=stage, check=True)
+    raw = qsf.read_bytes()
+    assert git("show", f"{parent}:Template.qsf") == git("show", f"{candidate}:Template.qsf")
+    # Quartus rewrites only its version string when compiling this project.
+    effective = raw.replace(
+        b'LAST_QUARTUS_VERSION "17.0.2 Standard Edition"',
+        b'LAST_QUARTUS_VERSION "17.0.2 Lite Edition"',
+    )
+    qsf.write_bytes(effective)
+    assert receipt["effective_qsf"] == qsf.read_text()
+    selected = {name: value for name, value in receipt["compiled_source_sha256"].items() if name != "Template.qsf"}
+    for name, digest in selected.items():
+        assert sha256(git("show", f"{parent}:{name}")).hexdigest() == digest, name
+    expected = {name: sha256(git("show", f"{candidate}:{name}")).hexdigest() for name in selected}
+    assert {name for name in selected if selected[name] != expected[name]} == changed
+    for name in changed:
+        assert sha256((source/name).read_bytes()).hexdigest() == expected[name]
+
+    (stage/f"fit-inputs-{seed}.json").write_text(json.dumps({
+        "public_parent": parent, "candidate": candidate, "control":receipt["actual_commit"],
+        "control_run":run, "seed":seed,"physical_cpu_mhz":104,"debugger":False,
+        "expected_changed_inputs":sorted(changed), "expected_effective_qsf":qsf.read_text(),
+        "compiled_source_sha256":expected,
+    },indent=2)+"\n")
+    print(f"PASS seed {seed}, {len(selected)} selected files, two verified RTL changes")
