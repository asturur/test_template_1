+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/sdram-block-payload
+out=build/sim/v5-104-sdram-block-payload/stream
+model=build/sim/unit-hardware-boot-real-sdram/mt48lc16m16a2-verilator.v
+mkdir -p "$out"
+python3 -B "$area/prepare-stream.py"
+for leg in reference source; do
+  base="$area/$leg"
+  test="$out/$leg-stream.sv"
+  # Reuse the pinned physical MT48LC16M16A2 pin model and the 104 MHz timer corner.
+  docker run --rm --pull=never --network none --platform linux/arm64 -v "$PWD:/work" \
+    -w /work --entrypoint verilator jotego/simulator:arm64 --binary --timing --assert -j 2 \
+    -Wno-fatal -Wno-lint --top-module stream_tb -GSYS_HZ=104000000 --Mdir "$out/$leg" \
+    "$base/rtl/ngage_sdram_stream.v" "$base/rtl/sdram/ngage_sdram_scheduler.v" \
+    "$base/rtl/ngage_sdram_arbiter.v" "$base/rtl/ngage_sdram_clock.v" \
+    "$base/tests/phone/sdram/ddio_model.v" "$test" "$model" > "$out/$leg.build.log" 2>&1
+  docker run --rm --pull=never --network none --platform linux/arm64 -v "$PWD:/work" \
+    -w /work --entrypoint "/work/$out/$leg/Vstream_tb" jotego/simulator:arm64 > "$out/$leg.log"
+  grep -E '^SCRUB PASS|^REFRESH PASS|^PASS stream' "$out/$leg.log" > "$out/$leg.pass"
+done
+cmp "$out/reference.pass" "$out/source.pass"
+cat "$out/source.pass"
