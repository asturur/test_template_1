+"""Seal SDRAM block-data production opt-in, scope and qualification evidence."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shlex
+
+
+stage = Path(__file__).resolve().parent
+root = stage.parents[2]
+out = root / 'build/sim/v5-104-sdram-block-payload'
+timer = root / 'build/sim/v5-104-timer-write-prepare'
+rtl = 'rtl/ngage_sdram_arbiter.v'
+top = 'Template.sv'
+bench = 'tests/phone/mmc_mister/tb.v'
+base = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+tree = '0ccd13d8cd502bc14d3b89c6431ff0ebe4745612'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def read_json(path):
+    return json.loads(path.read_bytes())
+
+
+def marked(path, *prefixes):
+    return [row for row in path.read_text().splitlines() if row.startswith(prefixes)]
+
+
+def fingerprint(path, suffix):
+    matches = [shlex.split(line) for line in path.read_text().splitlines()
+               if line.startswith('S ') and line.endswith(f'{suffix}"')]
+    (match,) = matches
+    return match[-2]
+
+
+def validate_activation(path):
+    assert path.read_text().count('.PRECAPTURE_BLOCK_DATA(1)') == 1, path
+
+
+sources = {name: digest(stage / 'source' / name) for name in (rtl, top)}
+reference = {name: digest(stage / 'reference' / name) for name in (rtl, top)}
+assert all(reference[name] != sources[name] for name in (rtl, top))
+validate_activation(stage / 'source' / top)
+validate_activation(out / 'mixed/source' / bench)
+validate_activation(out / 'stream/source-stream.sv')
+assert digest(out / 'mixed/source' / rtl) == sources[rtl]
+
+miter = marked(out / 'arbiter/miter.log', 'PASS ')
+assert miter == [
+    'PASS cold tentative X, qualified capture and canceled block',
+    'PASS arbiter cycles=65543 blocks=3107 contention=1314 locked=1830 acknowledged=2924 held=2928 canceled=183 speculative=56305',
+]
+stream = marked(out / 'stream/source.log', 'SCRUB PASS', 'REFRESH PASS', 'PASS ')
+assert stream == marked(out / 'stream/reference.log', 'SCRUB PASS', 'REFRESH PASS', 'PASS ')
+assert 'bytes=16777216' in stream[0]
+assert len([row for row in stream if row.startswith('PASS stream pending block')]) == 1
+assert len([row for row in stream if row.startswith('PASS stream locked block')]) == 1
+
+mixed = out / 'mixed'
+fp = fingerprint(mixed / 'obj/Vtb__verFiles.dat', rtl)
+assert fp == fingerprint(out / 'stream/source/Vstream_tb__verFiles.dat', rtl)
+ref_fp = fingerprint(out / 'stream/reference/Vstream_tb__verFiles.dat', rtl)
+assert ref_fp != fp
+hashes = read_json(mixed / 'source-hashes.json')
+baseline_hashes = read_json(timer / 'mixed/source-hashes.json')
+assert len(hashes) == 114 and hashes.keys() == baseline_hashes.keys()
+assert {name for name in hashes if hashes[name] != baseline_hashes[name]} == {rtl, bench}
+assert hashes[rtl] == sources[rtl] and baseline_hashes[rtl] == reference[rtl]
+
+work = {}
+for kind, key, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    result = read_json(receipt)
+    baseline = read_json(timer / f'qualification/{kind}.json')
+    assert result['status'] == baseline['status'] == 'PASS'
+    assert result['rows'] == baseline['rows']
+    assert result['netlist_sha256'] == baseline['netlist_sha256']
+    assert sum(len(row['candidate'][key]) for row in result['rows']) == count
+    assert result['source_sha256'][Path(rtl).name] == sources[rtl]
+    validate_activation(out / f'qualification/{kind}.sv')
+    assert fingerprint(out / f'qualification/obj-{kind}/Vtb__verFiles.dat', rtl) == fp
+    work[kind] = {'count': count, 'receipt_sha256': digest(receipt)}
+native = result['rows'][0]['candidate']
+work['native']['cycles'] = [frame['clocks'] for frame in native['frames']]
+work['native']['guest_output_sha256'] = native['output_sha256']
+
+pins = {}
+for name, control, observed, log, count, cycles in (
+    ('normal', timer / 'mixed/traffic.log', 'mixed/traffic.log', 'mixed/replay.log', 171496, 1201547),
+    ('timer_overlap', timer / 'coexistence/candidate.trace', 'coexistence/candidate.trace',
+     'coexistence/candidate.log', 171497, 1201528),
+    ('cpu_block_eviction', out / 'block-guest/reference.trace', 'block-guest/source.trace',
+     'block-guest/source.log', 172060, 1204706),
+):
+    path = out / observed
+    assert digest(path) == digest(control)
+    traffic = path.read_text().splitlines()
+    assert len(traffic) == count
+    passes = marked(out / log, 'PASS ')
+    assert len(passes) == 4 and f'cycles={cycles} reads=4 writes=1' in passes[-1]
+    pins[name] = {'events': count, 'cycles': cycles, 'traffic_sha256': digest(path), 'passes': passes}
+    full_blocks = [row.split() for row in traffic if row.startswith('Q ') and row.split()[2] == '110']
+    assert len(full_blocks) == (4 if name == 'cpu_block_eviction' else 2)
+    if name == 'cpu_block_eviction':
+        assert full_blocks[2:] == [
+            ['Q', '1202872', '110', '001740', '66180deb65160ad2641407b9631204a0', 'ffff'],
+            ['Q', '1202874', '110', '001744', '6a201a4f691e1736681c141d671a1104', 'ffff'],
+        ]
+        pins[name]['cpu_block_commands'] = full_blocks[2:]
+
+pins['cpu_block_eviction']['guest_sha256'] = digest(out / 'block-guest/block-guest.hex')
+receipt = {'status': 'PASS', 'base': base, 'base_tree': tree, 'source_sha256': sources,
+           'reference_sha256': reference, 'compiled_arbiter_fingerprint': fp,
+           'reference_arbiter_fingerprint': ref_fp,
+           'design_patch_sha256': digest(stage / 'sdram-block-payload.patch'),
+           'fixture_patch_sha256': digest(stage / 'sdram-block-payload-replay.patch'),
+           'routes_sha256': digest(stage / 'routes.json'),
+           'simulator': (out / 'image.id').read_text().strip(), 'mixed_sources': len(hashes),
+           'directed_four_state_miter': miter, 'stream_pin_directed': stream,
+           'workload': work, 'physical_replays': pins}
+(stage / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
