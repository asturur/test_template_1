@@ -0,0 +1,25 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/sdram-block-payload
+base=build/sim/v5-104-timer-write-prepare
+out=build/sim/v5-104-sdram-block-payload
+original=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed
+mixed="$out/mixed"
+overlap="$out/coexistence"
+mkdir -p "$overlap"
+python3 -B "$area/mixed.py"
+cp "$base/coexistence/stress-timer.hex" "$overlap/stress-timer.hex"
+docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD:/work" -w /work --entrypoint sh jotego/simulator:arm64 \
+  -ec "sh '$mixed/build.sh'
+'$mixed/obj/Vtb' +upp_stress '+compare_trace=$mixed/traffic.log' > '$mixed/replay.log'"
+cmp "$base/mixed/traffic.log" "$mixed/traffic.log"
+grep '^PASS ' "$mixed/replay.log"
+docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD:/work" -v "$PWD/$overlap/stress-timer.hex:/work/$original/stress.hex:ro" -w /work \
+  --entrypoint "/work/$mixed/obj/Vtb" jotego/simulator:arm64 \
+  +upp_stress "+compare_trace=$overlap/candidate.trace" > "$overlap/candidate.log"
+cmp "$base/coexistence/candidate.trace" "$overlap/candidate.trace"
+grep '^PASS ' "$overlap/candidate.log" > "$overlap/candidate.pass"
+cmp "$base/coexistence/candidate.pass" "$overlap/candidate.pass"
+cat "$overlap/candidate.pass"
diff --git a/scratch/v5-fit-loop/sdram-block-payload/prepare-arbiter.py b/scratch/v5-fit-loop/sdram-block-payload/prepare-arbiter.py
new file mode 100644
index 0000000..f340dba
--- /dev/null
+++ b/scratch/v5-fit-loop/sdram-block-payload/prepare-arbiter.py
@@ -0,0 +1,160 @@
+"""Make a three-way payload/owner differential from the exact timer arbiter."""
+from pathlib import Path
+
+
+area = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-sdram-block-payload/arbiter')
+out.mkdir(parents=True, exist_ok=True)
+src = (area / 'reference/rtl/ngage_sdram_arbiter.v').read_text()
+assert src.count('module ngage_sdram_arbiter #(') == 1
+(out / 'reference.v').write_text(src.replace('module ngage_sdram_arbiter #(', 'module reference_arbiter #('))
+inputs = {
+    'clk': 1, 'reset': 1, 'cpu_lock': 1, 'cpu_req': 1, 'cpu_we': 1, 'cpu_addr': 25,
+    'cpu_data': 32, 'cpu_write_block': 1, 'cpu_block_data': 128, 'cpu_be': 4,
+    'dma_req': 1, 'dma_we': 1, 'dma_addr': 25, 'dma_data': 32, 'dma_be': 4,
+    'mem_ack': 1, 'mem_rdata': 32,
+}
+outputs = {
+    'cpu_ack': 1, 'cpu_rdata': 32, 'dma_ack': 1, 'dma_rdata': 32, 'mem_req': 1,
+    'mem_we': 1, 'mem_addr': 25, 'mem_data': 32, 'mem_write_block': 1,
+    'mem_block_data': 128, 'mem_be': 4, 'cpu_accept': 1, 'dma_accept': 1, 'mem_lock': 1,
+}
+def width(bits):
+    return '' if bits == 1 else f'[{bits - 1}:0] '
+
+tb = ["`timescale 1ns/1ps\nmodule tb;\n"]
+for name, bits in inputs.items():
+    tb.append(f'    reg {width(bits)}{name} = 0;\n')
+for leg in ('original', 'default_mode', 'production'):
+    for name, bits in outputs.items():
+        tb.append(f'    wire {width(bits)}{leg}_{name};\n')
+    name = 'reference_arbiter' if leg == 'original' else 'ngage_sdram_arbiter'
+    opt = ', .PRECAPTURE_BLOCK_DATA(1)' if leg == 'production' else ''
+    ports = [f'        .{name}({name})' for name in inputs]
+    ports.extend(f'        .{name}({leg}_{name})' for name in outputs)
+    tb.append(f'    {name} #(.CPU_BLOCK_WRITES(1){opt}) {leg} (\n')
+    tb.append(',\n'.join(ports) + '\n    );\n')
+signals = [name for name in outputs if name != 'mem_block_data']
+for leg in ('original', 'default_mode', 'production'):
+    nb = sum(outputs[k] for k in signals)
+    tb.append(f'    wire [{nb - 1}:0] {leg}_visible = {{\n')
+    tb.append(',\n'.join(f'        {leg}_{name}' for name in signals) + '\n    };\n')
+tb.append('''
+    reg [31:0] rng = 32'h99652a8f;
+    integer cycles = 0, blocks = 0, contention = 0, locked = 0, acked = 0;
+    integer stalled = 0, canceled = 0, speculative = 0, iteration;
+    reg had_blocks, new_block, hold_block;
+    reg [127:0] captured, offered;
+    function [31:0] next_random;
+        input [31:0] value;
+        reg [31:0] mixed;
+        begin
+            mixed = value ^ (value << 13);
+            mixed = mixed ^ (mixed >> 17);
+            next_random = mixed ^ (mixed << 5);
+        end
+    endfunction
+
+    task compare;
+        begin
+            if (original_visible !== default_mode_visible ||
+                original_visible !== production_visible ||
+                original_mem_block_data !== default_mode_mem_block_data)
+                $fatal(1, "Changed arbitration/output behavior in cycle %0d", cycles);
+            if (original_mem_req && original_mem_write_block) begin
+                if (original_mem_block_data !== production_mem_block_data)
+                    $fatal(1, "Changed valid CPU block payload");
+            end
+        end
+    endtask
+
+    task tick;
+        begin
+            #2;
+            compare;
+            had_blocks = original_mem_req && original_mem_write_block;
+            new_block = original_cpu_accept && cpu_we && cpu_write_block;
+            hold_block = had_blocks && !reset && !mem_ack;
+            captured = production_mem_block_data;
+            offered = cpu_block_data;
+            if (new_block) begin
+                blocks = blocks + 1;
+                if (dma_req) contention = contention + 1;
+                if (cpu_lock) locked = locked + 1;
+            end
+            if (had_blocks && !reset && mem_ack && original_cpu_ack) acked = acked + 1;
+            if (hold_block && offered != captured) stalled = stalled + 1;
+            if (had_blocks && reset && !original_cpu_ack) canceled = canceled + 1;
+            clk = 1;
+            #2;
+            compare;
+            if (new_block && (!production_mem_req || !production_mem_write_block ||
+                              production_mem_block_data !== offered))
+                $fatal(1, "Grant did not capture current payload");
+            if (hold_block && (production_mem_block_data !== captured || !production_mem_req))
+                $fatal(1, "Live CPU bus changed a held block");
+            if (!(production_mem_req && production_mem_write_block) &&
+                original_mem_block_data !== production_mem_block_data)
+                speculative = speculative + 1;
+            clk = 0;
+            cycles = cycles + 1;
+        end
+    endtask
+
+    initial begin
+        reset = 1;
+        tick;
+        // An unknown CPU payload after cold reset must stay unobservable.
+        reset = 0;
+        cpu_block_data = {128{1'bx}};
+        tick;
+        if (production_mem_req || production_mem_block_data !== {128{1'bx}})
+            $fatal(1, "Tentative cold data was consumed or was not captured");
+        cpu_req = 1;
+        cpu_write_block = 1;
+        tick;
+        if (!production_mem_req || production_mem_write_block)
+            $fatal(1, "A CPU read promoted background data to a valid block");
+        cpu_req = 0;
+        mem_ack = 1;
+        tick;
+
+        // A later block owns its current word, not the tentative X or the
+        // live CPU inputs while it is held and canceled.
+        cpu_req = 1;
+        cpu_we = 1;
+        cpu_block_data = 128'h51c310de_7a5bece0_dead91aa_89ecd123;
+        mem_ack = 0;
+        tick;
+        cpu_req = 0;
+        cpu_block_data = {128{1'bx}};
+        tick;
+        reset = 1;
+        mem_ack = 1;
+        tick;
+        if (production_mem_req || production_cpu_ack || production_dma_ack)
+            $fatal(1, "A canceled block was visible after reset");
+        $display("PASS cold tentative X, qualified capture and canceled block");
+        for (iteration = 0; iteration < 65536; iteration = iteration + 1) begin
+            rng = next_random(rng);
+            {cpu_req, dma_req, cpu_lock, cpu_we, dma_we, cpu_write_block, mem_ack} = rng[6:0];
+            reset = rng[15:11] == 0;
+            {cpu_be, dma_be} = rng[31:24];
+            cpu_addr = rng[24:0];
+            dma_addr = ~rng[24:0];
+            cpu_data = rng ^ 32'h9c8d4a00;
+            dma_data = rng ^ 32'h9960b112;
+            mem_rdata = rng ^ 32'hcdefde89;
+            cpu_block_data = {rng, ~rng, rng ^ 32'hf001ca4e, rng ^ 32'h028f0f75};
+            tick;
+        end
+        if (blocks < 100 || contention < 100 || locked < 100 || acked < 100 ||
+            stalled < 100 || canceled < 10 || speculative < 100)
+            $fatal(1, "Insufficient ownership, stall, ACK or reset exercises");
+        $display("PASS arbiter cycles=%0d blocks=%0d contention=%0d locked=%0d acknowledged=%0d held=%0d canceled=%0d speculative=%0d",
+                 cycles, blocks, contention, locked, acked, stalled, canceled, speculative);
+        $finish;
+    end
+endmodule
+''')
+(out / 'tb.v').write_text(''.join(tb))
diff --git a/scratch/v5-fit-loop/sdram-block-payload/prepare-block-guest.py b/scratch/v5-fit-loop/sdram-block-payload/prepare-block-guest.py
new file mode 100644
index 0000000..1d256ff
--- /dev/null
+++ b/scratch/v5-fit-loop/sdram-block-payload/prepare-block-guest.py
@@ -0,0 +1,102 @@
+"""Append a real ARM write-back cache eviction to the frozen timer-overlap guest."""
+from pathlib import Path
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+base = Path('build/sim/v5-104-timer-write-prepare/coexistence/stress-timer.S')
+out = Path('build/sim/v5-104-sdram-block-payload/block-guest')
+out.mkdir(parents=True, exist_ok=True)
+guest = base.read_text()
+marker = ' ldr r0,=0x0a000100\n put r0,0,0x50415353\n'
+assert guest.count(marker) == 1
+# Divert only the final success store. Keep every earlier instruction,
+# symbol and literal at its original address for the cycle-sensitive PCM phase.
+hook = ' ldr r0,=0x0a000100\n ldr r3,=0x50415353\n b block_guest\n'
+guest = guest.replace(marker, hook)
+guest += """
+.ltorg
+block_guest:
+ // Dirty and evict both 16-byte halves through the real D-cache.
+ mov r12,#91
+ ldr r4,=0x0a008000
+ ldr r5,=0x00000c02
+ str r5,[r4]
+ ldr r5,=0x0a000c0e
+ str r5,[r4,#0x280]
+ mcr p15,0,r4,c2,c0,0
+ mov r4,#1
+ mcr p15,0,r4,c3,c0,0
+ mcr p15,0,r4,c8,c7,0
+ mrc p15,0,r11,c1,c0,0
+ orr r4,r11,#0xd
+ mcr p15,0,r4,c1,c0,0
+ nop
+ nop
+ nop
+ ldr r8,=0x0a005d00
+ ldr r5,[r8]
+ ldr r5,=0x631204a0
+ ldr r6,=0x01020319
+ mov r7,#0
+block_fill:
+ str r5,[r8,r7]
+ add r5,r5,r6
+ add r7,r7,#4
+ cmp r7,#32
+ bne block_fill
+ // Source different lines in the same set so the real cache chooses
+ // the 32-byte dirty victim and the writeback path emits both blocks.
+ add r10,r8,#0x2000
+ mov r1,#8
+block_evict:
+ ldr r4,[r10]
+ add r10,r10,#0x2000
+ subs r1,r1,#1
+ bne block_evict
+ mcr p15,0,r8,c7,c6,1
+ ldr r5,=0x631204a0
+ mov r7,#0
+block_check:
+ ldr r4,[r8,r7]
+ cmp r4,r5
+ bne block_fail
+ add r5,r5,r6
+ add r7,r7,#4
+ cmp r7,#32
+ bne block_check
+ mcr p15,0,r11,c1,c0,0
+ nop
+ nop
+ nop
+ ldr r0,=0x0a000100
+ put r0,0,0x50415353
+ b park
+block_fail:
+ mcr p15,0,r11,c1,c0,0
+ nop
+ nop
+ nop
+ b fail
+"""
+src = out / 'block-guest.S'
+obj = src.with_suffix('.o')
+elf = src.with_suffix('.elf')
+binary = src.with_suffix('.bin')
+src.write_text(guest)
+for argv in (
+    ['arm-none-eabi-gcc', '-c', '-mcpu=arm920t', '-marm', src, '-o', obj],
+    ['arm-none-eabi-ld', '-T', area / 'reference/sim/programs/link.ld', obj, '-o', elf],
+    ['arm-none-eabi-objcopy', '-O', 'binary', elf, binary],
+):
+    subprocess.run(argv, check=True)
+raw = binary.read_bytes()
+original = base.with_suffix('.bin').read_bytes()
+changed = [offset for offset in range(0, len(original), 4)
+           if original[offset:offset + 4] != raw[offset:offset + 4]]
+assert len(changed) == 1, changed
+assert raw[changed[0] + 3] == 0xea  # Sole changed instruction is the hook.
+assert len(raw) % 4 == 0 and len(raw) <= 8192
+src.with_suffix('.hex').write_text(''.join(
+    f'{int.from_bytes(raw[i:i+4], "little"):08x}\n' for i in range(0, len(raw), 4)
+))
diff --git a/scratch/v5-fit-loop/sdram-block-payload/prepare-stream.py b/scratch/v5-fit-loop/sdram-block-payload/prepare-stream.py
new file mode 100644
index 0000000..06873e4
--- /dev/null
+++ b/scratch/v5-fit-loop/sdram-block-payload/prepare-stream.py
@@ -0,0 +1,83 @@
+"""Exercise captured block copies under posted and locked physical drains."""
+from pathlib import Path
+
+
+area = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-sdram-block-payload/stream')
+out.mkdir(parents=True, exist_ok=True)
+fixture = (area / 'reference/tests/phone/sdram/stream_tb.sv').read_text()
+marker = '  wire [ 24:2] addr_mem;'
+assert fixture.count(marker) == 1
+fixture = fixture.replace(marker, '''  reg hold_commands = 0;
+  wire raw_cmd_ready;
+  assign cmd_ready_mem = raw_cmd_ready && !hold_commands;
+''' + marker)
+assert fixture.count('.cmd_ready(cmd_ready_mem)') == 1
+fixture = fixture.replace('.cmd_ready(cmd_ready_mem)', '.cmd_ready(raw_cmd_ready)')
+marker = '    while (busy_mem) @(negedge clk);\n    if (queued || accepted != issued'
+assert fixture.count(marker) == 1
+fixture = fixture.replace(marker, '''    // Deny the physical command slot and post a block into the stream
+    // pending queue. Reset the arbiter and change its live payload first.
+    wait (stream.drained);
+    @(negedge clk);
+    hold_commands = 1;
+    cpu_write_block = 1;
+    cpu_block_data = 128'ha0918283_74050405_26f71819_18293a4b;
+    cpu_transfer(1, BASE, cpu_block_data[31:0], 4'hf, 0);
+    if (!stream.pending || !stream.pending_block ||
+        stream.pending_block_data !== 128'ha0918283_74050405_26f71819_18293a4b)
+      $fatal(1, "Acknowledged block did not enter pending storage");
+    cpu_write_block = 0;
+    cpu_block_data = 128'hdeafbabe_feadfedc_003399cc_08070605;
+    phone_reset = 1;
+    repeat (3) @(negedge clk);
+    if (!stream.pending || !stream.pending_block ||
+        stream.pending_block_data !== 128'ha0918283_74050405_26f71819_18293a4b)
+      $fatal(1, "Reset/live input corrupted the accepted pending block");
+    hold_commands = 0;
+    wait (stream.drained);
+    @(negedge clk);
+    phone_reset = 0;
+    cpu_transfer(0, BASE, 0, 0, 32'h18293a4b);
+    cpu_transfer(0, BASE+4, 0, 0, 32'h26f71819);
+    cpu_transfer(0, BASE+8, 0, 0, 32'h74050405);
+    cpu_transfer(0, BASE+12, 0, 0, 32'ha0918283);
+    $display("PASS stream pending block survives cold-payload changes and logical reset drain");
+
+    // Verify a non-postable block uses the held arbiter payload and ACKs
+    // after all physical writes, even if SWP's live lock is withdrawn.
+    wait (stream.drained);
+    @(negedge clk);
+    lock = 1;
+    cpu_req = 1;
+    cpu_we = 1;
+    cpu_addr = BASE+16;
+    cpu_mask = 4'hf;
+    cpu_write_block = 1;
+    cpu_block_data = 128'h9c271827_8167a9c7_b931e74a_ffac0382;
+    do @(posedge clk); while (!cpu_grant);
+    @(negedge clk);
+    lock = 0;
+    cpu_write_block = 0;
+    cpu_block_data = 128'h99551a09_2476bf02_5a1c01a0_101295a2;
+    @(posedge clk);
+    if (!packet_lock || !stream.lock_write || cpu_ack ||
+        data_mem !== 128'h9c271827_8167a9c7_b931e74a_ffac0382)
+      $fatal(1, "A locked block lost its grant data or was posted");
+    do @(posedge clk); while (!cpu_ack);
+    if (busy_mem) $fatal(1, "Locked block acknowledged before pin completion");
+    @(negedge clk);
+    cpu_req = 0;
+    cpu_transfer(0, BASE+16, 0, 0, 32'hffac0382);
+    cpu_transfer(0, BASE+20, 0, 0, 32'hb931e74a);
+    cpu_transfer(0, BASE+24, 0, 0, 32'h8167a9c7);
+    cpu_transfer(0, BASE+28, 0, 0, 32'h9c271827);
+    $display("PASS stream locked block holds payload and ACKs after pin drain");
+''' + marker)
+for leg in ('reference', 'source'):
+    text = fixture
+    if leg == 'source':
+        marker = '.CPU_BLOCK_WRITES(1)'
+        assert text.count(marker) == 1
+        text = text.replace(marker, marker + ', .PRECAPTURE_BLOCK_DATA(1)')
+    (out / f'{leg}-stream.sv').write_text(text)
