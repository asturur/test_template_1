+++ b/scratch/v5-fit-loop/sdram-block-payload/mixed.py
@@ -0,0 +1,33 @@
+"""Use the validated timer-only pin deck with production block payload capture."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shutil
+
+
+stage = Path(__file__).resolve().parent
+base = Path('build/sim/v5-104-timer-write-prepare/mixed')
+trial = Path('build/sim/v5-104-sdram-block-payload/mixed')
+rtl = 'rtl/ngage_sdram_arbiter.v'
+bench = 'tests/phone/mmc_mister/tb.v'
+
+trial.mkdir(parents=True, exist_ok=True)
+shutil.copytree(base / 'source', trial / 'source', dirs_exist_ok=True)
+for name in ('stress.hex', 'image.hex', 'program.hex'):
+    shutil.copyfile(base / name, trial / name)
+shutil.copyfile(stage / 'source' / rtl, trial / 'source' / rtl)
+test = trial / 'source' / bench
+text = test.read_text()
+assert text.count('.CPU_BLOCK_WRITES(1)') == 1
+test.write_text(text.replace('.CPU_BLOCK_WRITES(1)', '.CPU_BLOCK_WRITES(1), .PRECAPTURE_BLOCK_DATA(1)'))
+
+hashes = json.loads((base / 'source-hashes.json').read_text())
+assert len(hashes) == 114 and {rtl, bench} <= hashes.keys()
+for name, reference in hashes.items():
+    if name.startswith('rtl/'):
+        assert sha256((stage / 'reference' / name).read_bytes()).hexdigest() == reference, name
+    actual = sha256((trial / 'source' / name).read_bytes()).hexdigest()
+    assert (actual != reference) == (name in (rtl, bench)), name
+    hashes[name] = actual
+(trial / 'source-hashes.json').write_text(json.dumps(hashes, indent=2) + '\n')
+(trial / 'build.sh').write_text((base / 'build.sh').read_text().replace(str(base), str(trial)))
