+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/sdram-block-payload
+base=build/sim/v5-104-timer-write-prepare/mixed
+out=build/sim/v5-104-sdram-block-payload
+original=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed
+python3 -B "$area/prepare-block-guest.py"
+for leg in reference source; do
+  if [ "$leg" = reference ]; then executable="$base/obj/Vtb"; else executable="$out/mixed/obj/Vtb"; fi
+  docker run --rm --pull=never --network none --platform linux/arm64 -v "$PWD:/work" \
+    -v "$PWD/$out/block-guest/block-guest.hex:/work/$original/stress.hex:ro" -w /work \
+    --entrypoint "/work/$executable" jotego/simulator:arm64 \
+    +upp_stress "+compare_trace=$out/block-guest/$leg.trace" > "$out/block-guest/$leg.log"
+  grep '^PASS ' "$out/block-guest/$leg.log" > "$out/block-guest/$leg.pass"
+done
+cmp "$out/block-guest/reference.trace" "$out/block-guest/source.trace"
+cmp "$out/block-guest/reference.pass" "$out/block-guest/source.pass"
+wc -l "$out/block-guest/source.trace"
+awk '$1 == "Q" && $3 == "110" && ($4 == "001740" || $4 == "001744")' "$out/block-guest/source.trace"
+cat "$out/block-guest/source.pass"
