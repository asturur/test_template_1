+"""Count the exact SDRAM arbiter block-payload setup endpoint family."""
+import csv
+import json
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+root = stage.parents[2]
+runs = {13: 45824513460, 43: 45824520116, 31337: 45824525843}
+pattern = re.compile(r'\|ngage_sdram_arbiter:ram_arbiter\|mem_block_data\[\d+\](?:~\S+)?$')
+report = {}
+for seed, run in runs.items():
+    model = root / f'build/timing-audit-{run}/output_files/timing/resident-store/104'
+    corners = {}
+    report[seed] = {'run': run, 'corners': corners}
+    for here in sorted(model.glob('corner-*/setup.csv')):
+        name = (here.parent / 'operating-condition.txt').read_text().splitlines()[0].split()[1]
+        with here.open() as input_file:
+            rows = list(csv.DictReader(input_file))
+        assert len(rows) == 1000 and len(rows[0]) == 6
+        matches = [row for row in rows if pattern.search(row['to'])]
+        facts = {'source_file': str(here.relative_to(root)), 'paths': len(matches),
+                 'negative': sum(float(row['slack_ns']) < 0 for row in matches),
+                 'below_minus_1p5': sum(float(row['slack_ns']) < -1.5 for row in matches)}
+        if matches:
+            facts['worst'] = min(matches, key=lambda row: float(row['slack_ns']))
+        corners[name] = facts
+        worst = facts.get('worst', {}).get('slack_ns', 'none')
+        print(seed, name, facts['negative'], facts['below_minus_1p5'], worst)
+    assert len(corners) == 4
+(stage / 'routes.json').write_text(json.dumps(report, indent=2) + '\n')
