diff --git a/tests/cpu/arm9v2_board/prepare_wb_data_contract.py b/tests/cpu/arm9v2_board/prepare_wb_data_contract.py
new file mode 100644
index 0000000..abaff33
--- /dev/null
+++ b/tests/cpu/arm9v2_board/prepare_wb_data_contract.py
@@ -0,0 +1,131 @@
+#!/usr/bin/env python3
+"""Extend the checked board guest with write-error and dirty-eviction probes."""
+import argparse
+from pathlib import Path
+
+
+def edit(text, old, new):
+    if text.count(old) != 1:
+        raise ValueError(f"Missing unique contract site {old!r}")
+    return text.replace(old, new)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("out", type=Path)
+    args = parser.parse_args()
+    fixture = Path(__file__).resolve().parent
+    args.out.mkdir(parents=True, exist_ok=True)
+    asm = (fixture / "contract.S").read_text()
+    asm = edit(asm, "    msr cpsr_c,#0x13", """    // A rejected scalar store must not be acknowledged as a write.
+    mov r6,#0
+    str r4,[r7,#36]
+    cmp r6,#1
+    bne fail
+
+    msr cpsr_c,#0x13""")
+    asm = edit(asm, "    // Read-allocate both ways before dirtying them.", """    // Miss stores queue distinct strobes and data before the drain.
+    ldr r9,=0x0a006380
+    ldr r4,=0xaaa5126c
+    str r4,[r9]
+    strh r4,[r9,#6]
+    strb r4,[r9,#9]
+    mcr p15,0,r4,c7,c10,4
+    ldr r5,[r9]
+    cmp r5,r4
+    bne fail
+    ldrh r5,[r9,#6]
+    mov r4,r4,lsl #16
+    mov r4,r4,lsr #16
+    cmp r5,r4
+    bne fail
+    ldrb r5,[r9,#9]
+    cmp r5,#0x6c
+    bne fail
+
+    // Dirty both halves with distinct words; force eviction by reading two
+    // other ways of this set. The peer checks backing RAM before any clean.
+    ldr r9,=0x0a003000
+    ldr r4,[r9]
+    ldr r4,=0x94756123
+    mov r5,#0
+1:  str r4,[r9,r5]
+    add r4,r4,#1
+    add r5,r5,#4
+    cmp r5,#32
+    bne 1b
+    add r10,r9,#0x2000
+    add r11,r10,#0x2000
+    ldr r4,[r10]
+    ldr r4,[r11]
+    ldr r4,[r10]
+    ldr r4,[r11]
+    mov r5,#1
+    str r5,[r7,#20]
+
+    // Read-allocate both ways before dirtying them.""")
+    (args.out / "contract.S").write_text(asm)
+
+    bench = (fixture / "contract.v").read_text()
+    bench = edit(bench, "  wire [31:0] line_addr;", """  wire [31:0] line_addr;
+  wire block_write;
+  wire [127:0] block_data;
+  reg ram_saved_block;
+  reg [127:0] ram_saved_block_data;
+  integer write_errors = 0, eviction_checks = 0, native_blocks = 0, word_in_block;""")
+    bench = edit(bench, "      .wb_write_data(wdata),", """      .wb_write_data(wdata),
+      .wb_write_block(block_write),
+      .wb_block_data(block_data),""")
+    bench = edit(bench, """  always @(posedge clk)
+    if (!reset) begin
+      cycle <= cycle + 1;""", """  always @(posedge clk)
+    if (reset) begin
+      ram_pending <= 0;
+      slow_delay <= 0;
+    end else begin
+      cycle <= cycle + 1;""")
+    bench = edit(bench, "cycle == 180000", "cycle == 400000")
+    bench = edit(bench, "device_address == 32'h0c000020 ||",
+                 "device_address == 32'h0c000020 || device_address == 32'h0c000024 ||")
+    bench = edit(bench, "      if (device_error && device_address == 32'h1008) begin", """      if (device_error && device_address == 32'h0c000024) begin
+        if (device_code || !device_write) $fatal(1, "Wrong rejected write packet");
+        write_errors <= write_errors + 1;
+      end
+      if (device_error && device_address == 32'h1008) begin""")
+    bench = edit(bench, "          32'hf0000000: begin", """          32'h0c000014: begin
+            for (word_in_block = 0; word_in_block < 8; word_in_block = word_in_block + 1)
+              if (ram[14'h0c00 + word_in_block] !== 32'h94756123 + word_in_block)
+                $fatal(1, "Dirty eviction mismatch at word %0d", word_in_block);
+            eviction_checks <= eviction_checks + 1;
+          end
+          32'hf0000000: begin
+            if (write_errors != 1 || eviction_checks != 1)
+              $fatal(1, "Missing rejected write or dirty eviction");
+`ifdef NGAGE_BLOCK_WRITEBACK
+            if (native_blocks == 0) $fatal(1, "No native eviction block accepted");
+`else
+            if (native_blocks != 0) $fatal(1, "Unexpected native eviction block");
+`endif
+            check_wb_data();""")
+    bench = edit(bench, "        ram_saved_data <= ram_wdata;", """        ram_saved_data <= ram_wdata;
+        ram_saved_block <= ram_write && block_write;
+        ram_saved_block_data <= block_data;
+        if (ram_write && block_write && (ram_address[3:0] != 0 || ram_be != 4'hf))
+          $fatal(1, "Misaligned or masked native write");""")
+    bench = edit(bench, "            assoc_words <= assoc_words + 1;",
+                 "            assoc_words <= assoc_words + (ram_saved_block ? 4 : 1);")
+    bench = edit(bench, """          for (lane = 0; lane < 4; lane = lane + 1)
+          if (ram_saved_be[lane]) ram[ram_index][lane*8+:8] <= ram_saved_data[lane*8+:8];""", """          if (ram_saved_block) begin
+            native_blocks <= native_blocks + 1;
+            for (lane = 0; lane < 4; lane = lane + 1)
+              ram[ram_index+lane] <= ram_saved_block_data[lane*32+:32];
+          end else begin
+            for (lane = 0; lane < 4; lane = lane + 1)
+              if (ram_saved_be[lane]) ram[ram_index][lane*8+:8] <= ram_saved_data[lane*8+:8];
+          end""")
+    bench = edit(bench, "\nendmodule", "\n`include \"wb_data_contract_observe.vh\"\nendmodule")
+    (args.out / "contract.v").write_text(bench)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/cpu/arm9v2_board/run-wb-data-contract.sh b/tests/cpu/arm9v2_board/run-wb-data-contract.sh
new file mode 100644
index 0000000..4d71cd9
--- /dev/null
+++ b/tests/cpu/arm9v2_board/run-wb-data-contract.sh
@@ -0,0 +1,71 @@
+#!/bin/sh
+# Run from the project root with ARM GNU binutils and the installed Jotego image.
+set -eu
+reference=${1:?provide the retained a846b87 arm925t_phone.v}
+out=${2:-build/sim/wb-data-contract}
+fixture=tests/cpu/arm9v2_board
+mkdir -p "$(dirname "$out")"
+mkdir "$out"
+python3 -B "$fixture/prepare_wb_data_contract.py" "$out"
+cp "$reference" "$out/reference.v"
+arm-none-eabi-gcc -c -mcpu=arm920t -marm -DASSOC_WAYS=2 -DSECTION_INDEX_TEST \
+    -I"$fixture" "$out/contract.S" -o "$out/guest.o"
+arm-none-eabi-ld -T sim/programs/link.ld "$out/guest.o" -o "$out/guest.elf"
+arm-none-eabi-objcopy -O binary "$out/guest.elf" "$out/guest.bin"
+python3 - "$out" <<'PY'
+from pathlib import Path
+from struct import iter_unpack
+import sys
+out = Path(sys.argv[1])
+words = iter_unpack('<I', (out/'guest.bin').read_bytes())
+(out/'guest.hex').write_text(''.join(f'{word:08x}\n' for (word,) in words))
+PY
+
+docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD:/work" -w /work --entrypoint sh jotego/simulator:arm64 -euc '
+out=$1
+fixture=$2
+ulimit -c 0
+for mode in word block; do
+    block=
+    if [ "$mode" = block ]; then block=-DNGAGE_BLOCK_WRITEBACK; fi
+    for leg in reference candidate; do
+        source=$out/reference.v
+        if [ "$leg" = candidate ]; then source=rtl/arm9v2/arm925t_phone.v; fi
+        stem="$out/$mode-$leg"
+        verilator --binary --timing --assert -j 2 -Wno-fatal -Wno-lint \
+            -DNGAGE_ARM9V2 $block --top-module contract --Mdir "$stem-obj" \
+            -I"$fixture" rtl/ngage_cpu.sv rtl/ngage_upp.v "$source" \
+            rtl/arm9v2/upstream/sim/stubs/*.sv "$out/contract.v" > "$stem-build.log" 2>&1
+        for burst in 0 1; do
+            for wait in 0 5; do
+                name="$stem-burst$burst-wait$wait"
+                "$stem-obj/Vcontract" "+program=$out/guest.hex" "+burst=$burst" "+wait=$wait" +section-reads=2 +half-writeback > "$name.log" 2>&1 || {
+                    tail -20 "$name.log"
+                    exit 1
+                }
+                grep -E "^(WB_DATA|PASS|LINES|ASSOC|SECTION|DATA_FAULT|REFILL_FAULT) " "$name.log" > "$name.trace"
+            done
+        done
+        reset_log="$stem-reset"
+        "$stem-obj/Vcontract" "+program=$out/guest.hex" +burst=1 +wait=5 \
+            +section-reads=2 +half-writeback +reset-in-write > "$reset_log.log" 2>&1 || {
+                tail -20 "$reset_log.log"
+                exit 1
+            }
+        grep -E "^(WB_DATA|PASS|LINES|ASSOC|SECTION|DATA_FAULT|REFILL_FAULT) " \
+            "$reset_log.log" > "$reset_log.trace"
+    done
+    cmp "$out/$mode-reference-reset.trace" "$out/$mode-candidate-reset.trace"
+    printf "%s reset " "$mode"
+    grep "^WB_DATA " "$out/$mode-candidate-reset.trace"
+    for burst in 0 1; do
+        for wait in 0 5; do
+            profile="burst$burst-wait$wait"
+            cmp "$out/$mode-reference-$profile.trace" "$out/$mode-candidate-$profile.trace"
+            printf "%s %s " "$mode" "$profile"
+            grep "^WB_DATA " "$out/$mode-candidate-$profile.trace"
+        done
+    done
+done
+' sh "$out" "$fixture"
diff --git a/tests/cpu/arm9v2_board/wb_data_contract_observe.vh b/tests/cpu/arm9v2_board/wb_data_contract_observe.vh
new file mode 100644
index 0000000..2491bd2
--- /dev/null
+++ b/tests/cpu/arm9v2_board/wb_data_contract_observe.vh
@@ -0,0 +1,109 @@
+`define WZ cpu.u_arm925t.u_zap
+`define WD `WZ.l_generate_with_cache_mmu.u_data_cache
+`define WM `WZ.l_merger_for_core_with_cache_mmu.u_zap_wb_merger
+wire         obs_valid = `WM.o_wb_cyc && `WM.o_wb_stb;
+wire         obs_write = obs_valid && `WM.o_wb_wen;
+wire         obs_ack = obs_valid && `WM.i_wb_ack && !`WM.i_wb_err;
+wire         obs_error = obs_valid && `WM.i_wb_err;
+wire [  3:0] obs_owner = `WM.o_dbg_data_owner ? `WD.state_ff : 4'd0;
+wire [  7:0] obs_ctl = {`WM.o_wb_cti, `WM.o_wb_sel, block_write};
+wire [127:0] obs_block = block_write ? block_data : 128'd0;
+wire [200:0] obs_payload = {lock, address, obs_ctl, wdata, obs_block};
+wire         eviction = `WD.u_zap_cache_fsm.state_ff[`WD.u_zap_cache_fsm.CLEAN_SINGLE];
+reg stalled = 0, prev_ack = 0, prev_write = 0, prev_eob = 0;
+reg [200:0] previous_payload;
+reg [  3:0] previous_owner;
+integer offer_clocks = 0, stall_clocks = 0, read_acks = 0, write_acks = 0, wr_errors = 0;
+integer tag_acks = 0, scalar_evict_acks = 0, block_evict_acks = 0, posted_acks = 0;
+integer read_to_write = 0, write_changed = 0, tag_changed = 0, owner_changes = 0;
+integer last_beat_handoffs = 0, stalled_resets = 0;
+reg [63:0] write_hash = 64'hcbf29ce484222325;
+
+function automatic [63:0] hash_write;
+    input [63:0] h, value;
+    hash_write = (h ^ value) * 64'h00000100000001b3;
+endfunction
+
+always @(posedge clk)
+    if (reset) begin
+        stalled  = 0;
+        prev_ack = 0;
+    end else begin
+        if (obs_ack && !obs_write) read_acks++;
+        if (prev_ack && prev_eob && obs_valid && previous_owner != obs_owner) last_beat_handoffs++;
+        if (stalled && (!obs_write || obs_payload !== previous_payload))
+            $fatal(1, "Changed write packet before completion at %h", address);
+        if (obs_write) begin
+            offer_clocks++;
+            if (!obs_ack && !obs_error) stall_clocks++;
+            if (obs_error) wr_errors++;
+            if (obs_ack) begin
+                write_acks++;
+                if (obs_owner == 4'b0010) tag_acks++;
+                if (obs_owner == 4'b1000) posted_acks++;
+                if (obs_owner == 4'b0001 && eviction) begin
+                    if (block_write) block_evict_acks++;
+                    else scalar_evict_acks++;
+                end
+            end
+            if (prev_ack && !prev_write) read_to_write++;
+            if (prev_ack && prev_write) begin
+                if (obs_payload[159:0] !== previous_payload[159:0]) write_changed++;
+                if (previous_owner != obs_owner) owner_changes++;
+                else if (obs_owner == 4'b0010 && obs_payload[159:128] !== previous_payload[159:128])
+                    tag_changed++;
+            end
+            write_hash =
+                hash_write(write_hash, {address, cycle[21:0], obs_ctl, obs_ack, obs_error});
+            write_hash = hash_write(write_hash, {31'd0, lock, wdata});
+            if (block_write) begin
+                write_hash = hash_write(write_hash, block_data[63:0]);
+                write_hash = hash_write(write_hash, block_data[127:64]);
+            end
+        end
+        stalled          = obs_write && !obs_ack && !obs_error;
+        prev_ack         = obs_ack;
+        prev_eob         = obs_ctl[7:5] == 3'b111;
+        prev_write       = obs_write;
+        previous_owner   = obs_owner;
+        previous_payload = obs_payload;
+    end
+
+// Reset the modeled peer after it captures a stalled write and restart
+// the checked guest. Neither old nor new request ownership may survive.
+initial
+    if ($test$plusargs("reset-in-write")) begin
+        @(negedge reset);
+        wait (ram_pending && ram_saved_write && !ram_ack && stalled);
+        @(negedge clk);
+        stalled_resets++;
+        reset = 1;
+        repeat (6) @(negedge clk);
+        if (obs_valid || ram_pending) $fatal(1, "Reset left an owned write");
+        reset = 0;
+    end
+
+task check_wb_data;
+    begin
+        if (!tag_acks || !tag_changed || !stall_clocks || !posted_acks || !wr_errors)
+            $fatal(
+                1,
+                "Incomplete write census tag=%0d changed=%0d stalls=%0d post=%0d errs=%0d",
+                tag_acks,
+                tag_changed,
+                stall_clocks,
+                posted_acks,
+                wr_errors
+            );
+        if ($test$plusargs("reset-in-write") && stalled_resets != 1)
+            $fatal(1, "Stalled write reset did not fire");
+        $display(
+            "WB_DATA offer=%0d stalled=%0d read_ack=%0d write_ack=%0d write_error=%0d tag=%0d evict_scalar=%0d evict_native=%0d post=%0d read_to_write=%0d changed=%0d tag_changed=%0d owner_changes=%0d last_beat_handoffs=%0d stalled_resets=%0d hash=%h",
+            offer_clocks, stall_clocks, read_acks, write_acks, wr_errors, tag_acks,
+            scalar_evict_acks, block_evict_acks, posted_acks, read_to_write, write_changed,
+            tag_changed, owner_changes, last_beat_handoffs, stalled_resets, write_hash);
+    end
+endtask
+`undef WM
+`undef WD
+`undef WZ
