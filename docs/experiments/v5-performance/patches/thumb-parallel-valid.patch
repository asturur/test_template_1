+        end else begin : g_normal_valid
+            assign selected_valid = read_valid_bit;
+        end
+    endgenerate
+\tassign o_hit = ((VALID_BIT ? selected_valid :""")
+    modules[fetch_id], modules[predict_id] = fetch, predict
+    return header + ''.join(modules)
