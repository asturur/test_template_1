+                    $fatal(1, "Trusted W-load completion changed at %h", d_pc);
+`endif
+        end
+        else begin : g_full_ack
+            assign s_wait_w_hit = s_wait_w_nohit &&
+                !(load_trust && wb_valid && request_done && !retry && !resp_err);
+        end
+    endgenerate''')
