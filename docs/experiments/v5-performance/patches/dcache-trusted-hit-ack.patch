+            // Evaluate wb_valid for a successful response. Using wb_valid
+            // directly here would also bring the uncached ACK back in through
+            // writeback completion and data-abort qualification.
+            wire wb_complete_on_success = w[541] && !wb_flush &&
+                (w_exception ? !i_dc_lock_any :
+                 w_cp ? cp_finished :
+                 memory_state == 4'd6 ? !w_locked && !w_swp :
+                 (memory_state == 4'd0 || memory_state == 4'd1) &&
+                 (!w[535] || w_mem_immediate || fast_pc_hit));
+            wire wb_valid_on_success = wb_restore ||
+                (wb_complete_on_success && w[540] &&
+                 memory_state != 4'd10 && !w_cls_ref[5]);
+            assign s_wait_w_hit = s_wait_w_nohit &&
+                !(load_trust && load_success && wb_valid_on_success);
+`ifndef SYNTHESIS
+            always @(posedge i_clk)
+                if (!i_reset && load_trust &&
+                    {load_success, load_success && wb_valid_on_success} !==
