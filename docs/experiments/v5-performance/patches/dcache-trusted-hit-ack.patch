+               '''    assign o_hit_ack_fast = (state_ff[IDLE] && !i_align_fault && i_cache_en &&
+        i_hit_ok && i_tlb_hit_ready && !(i_wr && i_post_full)) || hum_ack;
+    assign o_ack_fast = o_hit_ack_fast || state_ff[UNC_DONE];
+`ifndef SYNTHESIS
+    always @(posedge i_clk)
+        if (!i_reset && state_ff[UNC_DONE] && o_live_trust)
+            $fatal(1, "Uncached D-cache completion marked as a trusted hit");
+`endif''')
+    modules[slots['zap_dcache_fsm']] = fsm
+
+    cache = ports(modules[slots['zap_dcache']], 'o_prepared_write_data',
+                  ['output wire o_hit_ack_fast'])
+    cache = edit(cache, '\t\t.o_ack_fast(o_ack_fast),',
+                 '\t\t.o_ack_fast(o_ack_fast),\n\t\t.o_hit_ack_fast(o_hit_ack_fast),')
+    modules[slots['zap_dcache']] = cache
+
+    core = ports(modules[slots['arm9v2_core']], 'o_dbg_fetch',
+                 ['input wire i_data_hit_ack_fast'])
+    core = edit(core, "\tparameter [0:0] HIVECS = 1'd0;",
+                "\tparameter [0:0] HIVECS = 1'd0;\n    parameter TRUSTED_HIT_ACK = 1'b0;")
+    core = edit(core, '''    wire s_wait_w_hit = s_wait_w_nohit &&
