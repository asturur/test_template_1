@@ -0,0 +1,21 @@
+// Included by the pin peer and directed FIFO schedule.
+wire [31:0] reference_mask, reference_data;
+wire reference_busy, reference_rx_ready, reference_tx_ready;
+wire [3:0] reference_irq;
+wire reference_clk, reference_cmd, reference_cmd_oe, reference_dat, reference_dat_oe;
+mmc_host_fifo_reference #(.DIV(DIV), .RESP_WAIT(12), .TIMEOUT_LOG2(10), .FIFO_DEPTH(FIFO_DEPTH)) reference (
+    .clk(clk), .reset(reset), .acc(acc), .we(we), .wr(wr), .rd(rd), .off(off), .be(be), .wdata(wdata),
+    .rmask(reference_mask), .rdata(reference_data), .busy(reference_busy),
+    .rx_ready(reference_rx_ready), .tx_ready(reference_tx_ready), .irq(reference_irq),
+    .mmc_clk(reference_clk), .cmd_o(reference_cmd), .cmd_oe(reference_cmd_oe), .cmd_i(cmd_i),
+    .dat_o(reference_dat), .dat_oe(reference_dat_oe), .dat_i(dat_i)
+);
+
+always @(posedge clk) begin
+    if (!reset && ({rmask, rdata, busy, rx_ready, tx_ready, irq, mmc_clk, cmd_oe, dat_oe} !==
+            {reference_mask, reference_data, reference_busy, reference_rx_ready, reference_tx_ready,
+             reference_irq, reference_clk, reference_cmd_oe, reference_dat_oe} ||
+            (cmd_oe && cmd_o !== reference_cmd) || (dat_oe && dat_o !== reference_dat)))
+        $fatal(1, "MMC FIFO diverged at %t data=%08x/%08x busy=%b/%b IRQ=%b/%b",
+            $time, rdata, reference_data, busy, reference_busy, irq, reference_irq);
+end
diff --git a/tests/phone/mmc_host/run-fifo.sh b/tests/phone/mmc_host/run-fifo.sh
new file mode 100755
index 0000000000000000000000000000000000000000..f4afb50373d21124c1da30d7129585c1007b0968
--- /dev/null
+++ b/tests/phone/mmc_host/run-fifo.sh
@@ -0,0 +1,43 @@
+#!/bin/sh
+set -eu
+cd "$(dirname "$0")/../../.."
+out=${MMC_FIFO_OUT:-build/sim/mmc-host-fifo}
+mkdir -p "$out"
+git show 739d3bd:rtl/ngage_mmc_host.v > "$out/register-host.v"
+sed 's/^module ngage_mmc_host #(/module mmc_host_fifo_reference #(/' \
+    "$out/register-host.v" > "$out/reference.v"
+python3 - "$out" <<'PY'
+from pathlib import Path
+import sys
+
+source = Path("rtl/ngage_bram.v").read_text()
+old = "b_q[lane*BYTE_WIDTH+:BYTE_WIDTH] <= we_b[lane] ?"
+new = ("b_q[lane*BYTE_WIDTH+:BYTE_WIDTH] <= "
+       "(we_a[lane] && addr_a == addr_b) ? {BYTE_WIDTH{1'bx}} : we_b[lane] ?")
+assert source.count(old) == 1
+Path(sys.argv[1], "poison_bram.v").write_text(source.replace(old, new))
+
+# Add the comparator to a local copy of the ordinary data bench.
+source = Path("tests/phone/mmc_host/data_tb.v").read_text()
+anchor = "    always @(posedge clk)begin cycles<=cycles+1;"
+assert source.count(anchor) == 1
+monitor = '''    `include "fifo_reference.vh"
+    // Let the register model sample a mask transition before leaving reset.
+    initial begin #1; be = 0; #1; be = 15; end
+'''
+Path(sys.argv[1], "data_fifo_tb.v").write_text(source.replace(anchor, monitor + anchor))
+
+PY
+for config in '2 16' '3 16' '4 16' '12 8'; do
+    set -- $config
+    exe="$out/data-$1-$2"
+    iverilog -g2012 -Itests/phone/mmc_host -s tb \
+        -Ptb.DIV="$1" -Ptb.FIFO_DEPTH="$2" -o "$exe" \
+        rtl/ngage_mmc_host.v "$out/reference.v" "$out/poison_bram.v" "$out/data_fifo_tb.v"
+    vvp "$exe" > "$exe.log"
+    grep '^PASS MMC host data ' "$exe.log"
+done
+iverilog -g2012 -Itests/phone/mmc_host -s fifo_banks_tb -o "$out/banks" \
+    rtl/ngage_mmc_host.v "$out/reference.v" "$out/poison_bram.v" tests/phone/mmc_host/fifo_banks_tb.sv
+vvp "$out/banks" > "$out/banks.log"
+grep '^PASS MMC FIFO ' "$out/banks.log"
