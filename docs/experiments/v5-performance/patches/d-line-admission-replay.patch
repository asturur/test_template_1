+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/d-line-admission
+out=build/sim/v5-104-d-line-admission/lcd-phase
+model=build/sim/v5-104-timer-write-prepare/mixed/source
+mkdir -p "$out"
+docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$area:/trial:ro" -v "$PWD/$model:/model:ro" -v "$PWD/$out:/results" -w /results \
+    --entrypoint sh jotego/simulator:arm64 -ec '
+    for staged in 0 1; do
+        dir=obj-$staged
+        verilator --binary --timing --assert -j 2 -Wno-fatal -Wno-lint \
+            --top-module lcd_phase --Mdir "$dir" -GSTAGED="$staged" \
+            /trial/lcd-phase.sv /trial/source/rtl/ngage_cpu.sv \
+            /trial/source/rtl/ngage_sdram_line_mux.v /trial/source/rtl/ngage_sdram_stream.v \
+            /trial/source/rtl/sdram/ngage_sdram_scheduler.v /trial/source/rtl/ngage_sdram_clock.v \
+            /model/tests/phone/sdram/ddio_model.v \
+            /model/build/sim/unit-hardware-boot-real-sdram/mt48lc16m16a2-verilator.v \
+            > "$staged.build.log" 2>&1
+        "$dir/Vlcd_phase" > "$staged.log" 2>&1
+        grep "^PASS " "$staged.log"
+    done'
diff --git a/scratch/v5-fit-loop/d-line-admission/record.py b/scratch/v5-fit-loop/d-line-admission/record.py
new file mode 100644
index 0000000..e917323
--- /dev/null
+++ b/scratch/v5-fit-loop/d-line-admission/record.py
@@ -0,0 +1,209 @@
+"""Seal the registered D-cache line admission proof and replay."""
+from collections import Counter
+import csv
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-d-line-admission')
+control = Path('build/sim/v5-104-timer-write-prepare')
+source = 'rtl/ngage_cpu.sv'
+cpu = 'rtl/arm9v2/arm925t_phone.v'
+base = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+base_tree = '0ccd13d8cd502bc14d3b89c6431ff0ebe4745612'
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def exact(left, right):
+    assert left.read_bytes() == right.read_bytes(), (left, right)
+    return digest(left)
+
+
+def fingerprint(manifest, path):
+    [row] = [shlex.split(line) for line in manifest.read_text().splitlines()
+             if line.startswith('S ') and shlex.split(line)[-1].endswith(path)]
+    return row[-2]
+
+
+design = stage / 'd-line-admission.patch'
+fixture = stage / 'd-line-admission-replay.patch'
+stat = subprocess.check_output(['git', 'apply', '--numstat', str(design)], text=True)
+assert [line.split('\t')[-1] for line in stat.splitlines()] == [source]
+trial_ref = stage / 'reference'
+trial_source = stage / 'source'
+reference_sha = digest(trial_ref / source)
+wrapper_sha = exact(trial_source / source, stage / 'ngage_cpu.sv')
+cpu_sha = exact(trial_ref / cpu, trial_source / cpu)
+source_text = (trial_source / source).read_text()
+assert ".REGISTERED_D_LINE_OFFER(1'b1)" in source_text and '$test$plusargs' not in source_text
+candidate_tree = (stage / 'design-tree.sha').read_text().strip()
+assert re.fullmatch(r'[0-9a-f]{40}', candidate_tree)
+
+timing = {}
+for seed, run in ((13, 45824513460), (43, 45824520116), (31337, 45824525843)):
+    outputs = Path(f'build/timing-audit-{run}/output_files')
+    manifest = load(outputs / 'resident-fit-manifest.json')
+    assert manifest['actual_commit'] == base and manifest['seed'] == seed
+    assert manifest['physical_cpu_mhz'] == 104 and manifest['debugger'] is False
+    assert len(manifest['compiled_source_sha256']) == 133
+    assert manifest['compiled_source_sha256'][source] == reference_sha
+    assert manifest['compiled_source_sha256'][cpu] == cpu_sha
+    corners = {}
+    for path in sorted((outputs / 'timing/resident-store/104').glob('corner-*/setup.csv')):
+        with path.open() as handle:
+            rows = list(csv.DictReader(handle))
+        related = [row for row in rows if '|o_wb_line_candidate' in row['from']]
+        scheduler = [row for row in rows if '|ngage_sdram_scheduler:' in row['to']]
+        assert len(rows) == 1000
+        assert not any(row in scheduler or 'line_ram_address' in row['to'] for row in related)
+        corners[path.parent.name] = {'line_candidate_launches': len(related), 'worst_launch': related[0] if related else None,
+                                     'worst_setup': rows[0], 'worst_scheduler_setup': scheduler[0] if scheduler else None}
+        if seed == 13 and path.parent.name == 'corner-1':
+            assert rows[33]['slack_ns'] == '-1.716' and rows[33]['from'].endswith('|o_phy_addr[29]')
+            assert rows[33]['to'].endswith('|o_wb_line_candidate')
+            report = path.with_name('setup.rpt').read_text(errors='replace')
+            detail = report.split('Path #18:', 1)[1].split('Path #19:', 1)[0]
+            assert all(f'|{name}' in detail for name in ('line_req~1', 'bus_live~3', 'bus_access~2',
+                                                       'fast_cancel~0', 'mem_req~1', 'response_dma~2', 'reserved~1'))
+            corners[path.parent.name]['shared_scalar_reservation'] = rows[17]
+            corners[path.parent.name]['upstream_d_tlb_classification'] = rows[33]
+    assert len(corners) == 4
+    timing[seed] = {'run': run, 'selected_sources': 133, 'corners': corners}
+
+old_mixed = control / 'mixed'
+mixed = out / 'mixed'
+manifest = load(mixed / 'source-hashes.json')
+old_manifest = load(old_mixed / 'source-hashes.json')
+assert len(manifest) == 114 and manifest.keys() == old_manifest.keys()
+assert {path: sha for path, sha in manifest.items() if sha != old_manifest[path]} == {source: wrapper_sha}
+assert all(digest(mixed / 'source' / path) == sha for path, sha in manifest.items())
+compiled = fingerprint(mixed / 'obj/Vtb__verFiles.dat', source)
+assert fingerprint(out / 'board/source/obj/Vcontract__verFiles.dat', source) == compiled
+assert fingerprint(out / 'board/reference/obj/Vcontract__verFiles.dat', source) != compiled
+
+physical = {}
+for mode, trace, witness, log, count, clocks in (
+    ('normal', mixed / 'traffic.log', old_mixed / 'traffic.log', mixed / 'replay.log', 171496, 1201547),
+    ('timer_mmc_lcd', out / 'coexistence/candidate.trace', control / 'coexistence/candidate.trace',
+     out / 'coexistence/candidate.log', 171497, 1201528),
+):
+    assert len(trace.read_bytes().splitlines()) == count
+    assert f'persisted512bytes+PIOreadback cycles={clocks} reads=4 writes=1' in log.read_text()
+    assert 'PASS native LCD grants=4576 completed=4576' in log.read_text()
+    physical[mode] = {'cycles': clocks, 'events': count, 'trace_sha256': exact(trace, witness)}
