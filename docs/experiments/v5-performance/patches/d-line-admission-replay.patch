@@ -0,0 +1,20 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/d-line-admission
+out=build/sim/v5-104-d-line-admission/coexistence
+retained=build/sim/v5-104-timer-write-prepare/mixed
+candidate=build/sim/v5-104-d-line-admission/mixed
+python3 -B "$area/prepare-coexistence.py"
+guest_path=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed/stress.hex
+for leg in retained candidate; do
+  if [ "$leg" = retained ]; then replay=$retained; else replay=$candidate; fi
+  docker run --rm --pull=never --network none --platform linux/arm64 -v "$PWD:/work" \
+    -v "$PWD/$out/stress-timer.hex:/work/$guest_path:ro" -w /work \
+    --entrypoint "/work/$replay/obj/Vtb" jotego/simulator:arm64 \
+    +upp_stress "+compare_trace=$out/$leg.trace" > "$out/$leg.log"
+  grep '^PASS ' "$out/$leg.log" > "$out/$leg.pass"
+done
+cmp "$out/retained.trace" "$out/candidate.trace"
+cmp "$out/retained.pass" "$out/candidate.pass"
+wc -l "$out/candidate.trace"
+cat "$out/candidate.pass"
diff --git a/scratch/v5-fit-loop/d-line-admission/prepare-coexistence.py b/scratch/v5-fit-loop/d-line-admission/prepare-coexistence.py
new file mode 100644
index 0000000..a49a5ed
--- /dev/null
+++ b/scratch/v5-fit-loop/d-line-admission/prepare-coexistence.py
@@ -0,0 +1,51 @@
+"""Insert a one-shot timer into the active physical MMC/LCD replay."""
+from pathlib import Path
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-d-line-admission/coexistence')
+out.mkdir(parents=True, exist_ok=True)
+base = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+guest = (base / 'stress.S').read_text()
+marker = ' // Read/copy/partial-write round trips while LCD DMA and PCM are active.'
+assert guest.count(marker) == 1
+guest = guest.replace(marker, ''' // Timer4 must expire with both transfers still active.
+ mov r12,#83
+ ldr r0,=0x0c120a80
+ put r0,4,1
+ put r0,0x10,13
+timer4_wait:
+ ldr r4,[r0,#8]
+ tst r4,#1
+ beq timer4_wait
+ ldr r4,[r8,#0x18]
+ tst r4,#4
+ beq fail
+ ldr r1,=0x0c120348
+ ldr r4,[r1]
+ cmp r4,#0
+ beq fail
+ put r0,4,0
+ put r0,8,0
+ ldr r4,[r0,#8]
+ tst r4,#1
+ bne fail
+
+''' + marker)
+assembly = out / 'stress-timer.S'
+obj = assembly.with_suffix('.o')
+elf = assembly.with_suffix('.elf')
+binary = assembly.with_suffix('.bin')
+assembly.write_text(guest)
+for command in (
+    ['arm-none-eabi-gcc', '-c', '-mcpu=arm920t', '-marm', assembly, '-o', obj],
+    ['arm-none-eabi-ld', '-T', stage / 'source/sim/programs/link.ld', obj, '-o', elf],
+    ['arm-none-eabi-objcopy', '-O', 'binary', elf, binary],
+):
+    subprocess.run(command, check=True)
+raw = binary.read_bytes()
+assert len(raw) % 4 == 0 and len(raw) <= 8192
+assembly.with_suffix('.hex').write_text(''.join(
+    f'{int.from_bytes(raw[i:i+4], "little"):08x}\n' for i in range(0, len(raw), 4)
+))
diff --git a/scratch/v5-fit-loop/d-line-admission/architectural_trace.vh b/scratch/v5-fit-loop/d-line-admission/architectural_trace.vh
new file mode 100644
index 0000000..88b6546
--- /dev/null
+++ b/scratch/v5-fit-loop/d-line-admission/architectural_trace.vh
@@ -0,0 +1,69 @@
+`define RESUPP dut.board.upp.cpu_inside
+`define RESZAP `RESUPP.cpu.u_arm925t.u_zap
+`define RESCORE `RESZAP.g_arm9.u_arm9_core
+`define RESFETCH `RESCORE.u_front_decode.u_fetch
+
+reg [31:0] res_begin, res_end;
+integer res_window = 0;
+integer res_retired, res_data, res_mmio, res_recover;
+reg res_active = 0;
+reg [63:0] res_retire_hash, res_data_hash, res_mmio_hash;
+localparam [63:0] RES_INITIAL = 64'hcbf29ce484222325;
+initial begin
+    if (!$value$plusargs("begin_pc=%h", res_begin) || !$value$plusargs("end_pc=%h", res_end))
+        $fatal(1, "Missing architectural digest window");
+end
+
+function automatic [63:0] res_mix(input [63:0] digest, input [63:0] data);
+    res_mix = (digest ^ data) * 64'h00000100000001b3;
+endfunction
+
+always @(posedge clk) if (!reset) begin
+    if (retire && retire_pc == res_begin) begin
+        res_active = 1;
+        res_retired = 0;
+        res_data = 0;
+        res_mmio = 0;
+        res_recover = 0;
+        res_retire_hash = RES_INITIAL;
+        res_data_hash = RES_INITIAL;
+        res_mmio_hash = RES_INITIAL;
+    end else if (retire && retire_pc == res_end && res_active) begin
+        $display("RES_ARCH window=%0d retired=%0d data=%0d mmio=%0d recover=%0d retire_hash=%016x data_hash=%016x mmio_hash=%016x",
+                 res_window, res_retired, res_data, res_mmio, res_recover,
+                 res_retire_hash, res_data_hash, res_mmio_hash);
+        res_window++;
+        res_active = 0;
+    end else if (res_active) begin
+        if (`RESCORE.wb_complete) begin
+            res_retired++;
+            res_retire_hash = res_mix(res_retire_hash, {`RESCORE.w[526:495], `RESCORE.w[494:463]});
+            res_retire_hash = res_mix(res_retire_hash, {25'b0, exceptions, `RESCORE.cpsr_next});
+            if (`RESCORE.wb_valid) begin
+                if (`RESCORE.wb_tag0 != 6'd16)
+                    res_retire_hash = res_mix(res_retire_hash, {26'b0, `RESCORE.wb_tag0, `RESCORE.wb_data0});
+                if (`RESCORE.wb_pair && `RESCORE.wb_tag1 != 6'd16)
+                    res_retire_hash = res_mix(res_retire_hash, {25'b0, 1'b1, `RESCORE.wb_tag1, `RESCORE.wb_data1});
+            end
+        end
+        if (`RESZAP.o_dbg_d_done) begin
+            res_data++;
+            res_data_hash = res_mix(res_data_hash, {26'b0, `RESZAP.data_err, `RESZAP.o_dbg_d_we,
+                                                   `RESZAP.o_dbg_d_sel, `RESZAP.o_dbg_d_va});
+            res_data_hash = res_mix(res_data_hash, {32'b0, `RESZAP.o_dbg_d_we ?
+                                                   `RESZAP.o_dbg_d_wdata : `RESZAP.o_dbg_d_rdata});
+        end
+        if (`RESUPP.master_cyc && `RESUPP.master_stb && !`RESUPP.master_code &&
+            (`RESUPP.slow_ack || `RESUPP.slow_error)) begin
+            res_mmio++;
+            res_mmio_hash = res_mix(res_mmio_hash, {26'b0, `RESUPP.slow_error, `RESUPP.master_we,
+                                                   `RESUPP.master_sel, `RESUPP.master_address});
+            res_mmio_hash = res_mix(res_mmio_hash, {32'b0, `RESUPP.master_we ?
+                                                   `RESUPP.master_data : `RESUPP.slow_read_data});
+        end
+    end
+end
+`undef RESFETCH
+`undef RESCORE
+`undef RESZAP
+`undef RESUPP
diff --git a/scratch/v5-fit-loop/d-line-admission/wb-write-trace.vh b/scratch/v5-fit-loop/d-line-admission/wb-write-trace.vh
new file mode 100644
index 0000000..e4ee4c7
--- /dev/null
+++ b/scratch/v5-fit-loop/d-line-admission/wb-write-trace.vh
@@ -0,0 +1,98 @@
+`define WC dut.board.upp.cpu_inside.cpu
+`define WZ `WC.u_arm925t.u_zap
+`define WD `WZ.l_generate_with_cache_mmu.u_data_cache
+`define WM `WZ.l_merger_for_core_with_cache_mmu.u_zap_wb_merger
+wire obs_bus_on = `WM.o_wb_cyc && `WM.o_wb_stb;
+wire obs_write = obs_bus_on && `WM.o_wb_wen;
+wire obs_ack = obs_bus_on && `WM.i_wb_ack && !`WM.i_wb_err;
+wire obs_err = obs_bus_on && `WM.i_wb_err;
+wire obs_native = obs_write && `WC.wb_write_block;
+wire [3:0] obs_owner = `WM.o_dbg_data_owner ? `WD.state_ff : 4'b0;
+wire [7:0] obs_ctl = {`WM.o_wb_cti, `WM.o_wb_sel, obs_native};
+wire [31:0] obs_adr = `WM.o_wb_adr;
+wire [31:0] obs_data = `WM.o_wb_dat;
+wire [127:0] obs_block = obs_native ? `WC.wb_block_data : 128'b0;
+wire [199:0] obs_payload = {obs_adr, obs_ctl, obs_data, obs_block};
+wire [2:0] obs_source = {obs_native, `WD.u_zap_cache_fsm.state_ff[`WD.u_zap_cache_fsm.CLEAN_SINGLE], `WM.o_dbg_data_owner};
+
+integer wbt_window = 0;
+integer wbt_clock, wbt_writes, wbt_stalls, wbt_read_acks, wbt_write_acks, wbt_errors;
+integer wbt_read_to_write, wbt_write_next_changed, wbt_owner_changes;
+integer wbt_tag_changed, wbt_cch_changed, wbt_native_changed, wbt_post_changed, wbt_unc_changed;
+integer wbt_tag, wbt_cch, wbt_native, wbt_post, wbt_unc;
+reg wbt_active = 0;
+reg wbt_prev_read_ack, wbt_prev_write_ack, wbt_prev_stalled;
+reg [3:0] wbt_prev_owner;
+reg [199:0] wbt_prev_payload;
+reg [63:0] wbt_digest;
+
+always @(posedge clk) if (!reset) begin
+    if (retire && retire_pc == res_begin) begin
+        wbt_active = 1;
+        wbt_clock = 0;
+        wbt_writes = 0; wbt_stalls = 0; wbt_read_acks = 0; wbt_write_acks = 0; wbt_errors = 0;
+        wbt_read_to_write = 0; wbt_write_next_changed = 0; wbt_owner_changes = 0;
+        wbt_tag_changed = 0; wbt_cch_changed = 0; wbt_native_changed = 0;
+        wbt_post_changed = 0; wbt_unc_changed = 0;
+        wbt_tag = 0; wbt_cch = 0; wbt_native = 0; wbt_post = 0; wbt_unc = 0;
+        wbt_prev_read_ack = 0; wbt_prev_write_ack = 0; wbt_prev_stalled = 0;
+        wbt_prev_owner = 0; wbt_prev_payload = 0;
+        wbt_digest = RES_INITIAL;
+    end else if (retire && retire_pc == res_end && wbt_active) begin
+        $display("RES_WB window=%0d offer=%0d stall=%0d read_ack=%0d write_ack=%0d write_error=%0d read_to_write=%0d changed_after_write_ack=%0d owner_changes=%0d tag=%0d evict_scalar=%0d evict_native=%0d post=%0d unc=%0d tag_changed=%0d evict_scalar_changed=%0d evict_native_changed=%0d post_changed=%0d unc_changed=%0d write_hash=%016x",
+                 wbt_window,wbt_writes,wbt_stalls,wbt_read_acks,wbt_write_acks,wbt_errors,
+                 wbt_read_to_write,wbt_write_next_changed,wbt_owner_changes,
+                 wbt_tag,wbt_cch,wbt_native,wbt_post,wbt_unc,wbt_tag_changed,
+                 wbt_cch_changed,wbt_native_changed,wbt_post_changed,wbt_unc_changed,wbt_digest);
+        wbt_window++;
+        wbt_active = 0;
+    end else if (wbt_active) begin
+        wbt_clock++;
+        if (obs_ack && !obs_write) wbt_read_acks++;
+        if (wbt_prev_stalled && !obs_write) $fatal(1, "write withdrawn while stalled");
+        if (obs_write) begin
+            wbt_writes++;
+            if (wbt_prev_stalled && obs_payload !== wbt_prev_payload)
+                $fatal(1, "stalled write changed payload");
+            if (obs_ack) begin
+                wbt_write_acks++;
+                case (obs_owner)
+                    4'b0010: wbt_tag++;
+                    4'b1000: wbt_post++;
+                    4'b0001: if (obs_native) wbt_native++; else if (obs_source[1]) wbt_cch++; else wbt_unc++;
+                    default: $fatal(1, "unexpected write owner %b", obs_owner);
+                endcase
+            end else if (obs_err) wbt_errors++;
+            else wbt_stalls++;
+            if (wbt_prev_read_ack) wbt_read_to_write++;
+            if (wbt_prev_write_ack) begin
+                if (wbt_prev_owner != obs_owner) wbt_owner_changes++;
+                if (obs_payload[159:0] != wbt_prev_payload[159:0]) begin
+                    wbt_write_next_changed++;
+                    if (wbt_prev_owner == obs_owner)
+                        case (obs_owner)
+                            4'b0010: wbt_tag_changed++;
+                            4'b1000: wbt_post_changed++;
+                            4'b0001: if (obs_native) wbt_native_changed++; else if (obs_source[1]) wbt_cch_changed++; else wbt_unc_changed++;
+                            default: ;
+                        endcase
+                end
+            end
+            wbt_digest = res_mix(wbt_digest, {obs_adr, wbt_clock[21:0], obs_ctl, obs_ack, obs_err});
+            wbt_digest = res_mix(wbt_digest, {31'b0, `WC.wb_lock, obs_data});
+            if (obs_native) begin
+                wbt_digest = res_mix(wbt_digest, obs_block[63:0]);
+                wbt_digest = res_mix(wbt_digest, obs_block[127:64]);
+            end
+        end
+        wbt_prev_read_ack = obs_ack && !obs_write;
+        wbt_prev_write_ack = obs_ack && obs_write;
+        wbt_prev_stalled = obs_write && !obs_ack && !obs_err;
+        wbt_prev_owner = obs_owner;
+        wbt_prev_payload = obs_payload;
+    end
+end
+`undef WM
+`undef WD
+`undef WZ
+`undef WC
diff --git a/scratch/v5-fit-loop/d-line-admission/directed.sh b/scratch/v5-fit-loop/d-line-admission/directed.sh
new file mode 100644
index 0000000..464c229
--- /dev/null
+++ b/scratch/v5-fit-loop/d-line-admission/directed.sh
@@ -0,0 +1,15 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/d-line-admission
+out=build/sim/v5-104-d-line-admission/miter
+python3 -B "$area/prepare-miter.py"
+docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$out:/results" -w /results --entrypoint sh jotego/simulator:arm64 -ec '
+    for settings in "1 1 1" "1 0 1" "1 1 0" "0 1 1"; do
+        set -- $settings
+        tag=enable-$1-scalar-$2-stage-$3
+        iverilog -g2012 -s tb -Ptb.ENABLE="$1" -Ptb.REGISTERED="$2" -Ptb.STAGED="$3" \
+            -o "$tag" tb.sv retained.v trial.v > "$tag.build.log" 2>&1
+        vvp "$tag" > "$tag.log"
+        grep "^PASS " "$tag.log"
+    done'
diff --git a/scratch/v5-fit-loop/d-line-admission/prepare-miter.py b/scratch/v5-fit-loop/d-line-admission/prepare-miter.py
new file mode 100644
index 0000000..711a37a
--- /dev/null
+++ b/scratch/v5-fit-loop/d-line-admission/prepare-miter.py
@@ -0,0 +1,53 @@
+"""Compare the exact retained and candidate refill modules at their interfaces."""
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-d-line-admission/miter')
+out.mkdir(parents=True, exist_ok=True)
+rtl = 'rtl/ngage_cpu.sv'
+
+
+def wrapper(leg):
+    return (stage / leg / rtl).read_text()
+
+
+def refill(source):
+    return re.search(r'^module ngage_arm9v2_refill\s+#\(.*?^endmodule$', source, re.M | re.S)[0]
+
+
+old, new = (wrapper(leg) for leg in ('reference', 'source'))
+retained, candidate = refill(old), refill(new)
+assert retained.split('    always @(posedge clk) begin\n        if (reset) begin', 1)[1].split(
+    '    // synthesis translate_off', 1)[0] == candidate.split(
+        '    always @(posedge clk) begin\n        if (reset) begin', 1)[1].split(
+            '    // synthesis translate_off', 1)[0]
+for message in ('Donor changed the owned line burst', 'Guaranteed line returned an error',
+                'Line rejected after data', 'Bad board line framing'):
+    assert next(line for line in retained.splitlines() if message in line) in candidate
+ports = re.compile(r'^    (input|output)\s+wire\s*(\[[^]]+\])?\s*(\w+)\s*,?$', re.M)
+assert ports.findall(retained) == ports.findall(candidate)[:-1]
+assert ports.findall(candidate)[-1] == ('input', '', 'cpu_code')
+bench = (stage / 'refill-directed.sv').read_text()
+connections, declarations = [], []
+for label, module in (('retained', retained), ('trial', candidate)):
+    name = f'{label}_refill'
+    (out / f'{label}.v').write_text(module.replace('module ngage_arm9v2_refill', f'module {name}'))
+    mappings = []
+    for direction, width, port in ports.findall(module):
+        target = port
+        if direction == 'output':
+            target = f'{label}_{port}'
+            declarations.append(f'    wire {width} {target};\n')
+        mappings.append(f'        .{port}({target})')
+    port_map = ',\n'.join(mappings)
+    registered_offer = ', .REGISTERED_D_LINE_OFFER(STAGED)' if label == 'trial' else ''
+    connections.append(f'''    {name} #(
+        .ENABLE(ENABLE), .REGISTERED_SCALAR_PEER(REGISTERED){registered_offer}
+    ) {label} (
+{port_map}
+    );
+''')
+assert bench.count('    // Exact adapters') == 1
+(out / 'tb.sv').write_text(bench.replace('    // Exact adapters', ''.join(declarations + connections)))
diff --git a/scratch/v5-fit-loop/d-line-admission/refill-directed.sv b/scratch/v5-fit-loop/d-line-admission/refill-directed.sv
new file mode 100644
index 0000000..12157fa
--- /dev/null
+++ b/scratch/v5-fit-loop/d-line-admission/refill-directed.sv
@@ -0,0 +1,418 @@
+`timescale 1ns / 1ps
+
+module tb;
+    parameter ENABLE = 1;
+    parameter REGISTERED = 1;
+    parameter STAGED = 1;
+    localparam [2:0] BURST = 3'b010, END_BEAT = 3'b111;
+    reg clk = 0, reset = 1;
+    reg cpu_cyc = 0, cpu_lock = 0, cpu_write = 0;
+    reg cpu_code = 0;
+    reg stage_edge = 0;
+    integer staged_offers = 0, held_offers = 0, resets_pending = 0;
+    reg [31:0] cpu_address = 0;
+    reg [3:0] cpu_sel = 15;
+    reg [2:0] cpu_cti = END_BEAT;
+    reg [1:0] cpu_bte = 0;
+    wire cpu_line_candidate = !cpu_write && cpu_sel == 15 && cpu_cti == BURST &&
+                              cpu_bte == 0 && cpu_address[4:0] == 0 && cpu_address[31:24] == 8'h0a;
+    reg wb_ack = 0, wb_error = 0;
+    reg [31:0] wb_data = 0;
+    reg line_ready = 0, line_reject = 0, line_valid = 0;
+    reg line_wide = 0, line_last = 0, line_error = 0, line_no_late_error = 0;
+    reg [63:0] line_data = 0;
+    // Exact adapters
+
+    integer comparisons = 0, line_cases = 0, failed_lines = 0;
+    integer narrow_pop = 0, wide_pop = 0, withheld_line = 0, withheld_scalar = 0;
+    integer scalar_reads = 0, scalar_writes = 0, scalar_errors = 0;
+    integer halfwords = 0, retired = 0;
+    reg model_failed, model_guaranteed;
+    reg [31:0] staged_words [0:7];
+    reg [15:0] staged_half;
+    reg [31:0] prng = 32'h3b6ad275;
+    reg [31:0] line_base = 32'h0a000200;
+    integer sample;
+
+    function [31:0] advance_random;
+        input [31:0] previous;
+        reg [31:0] value;
+        begin
+            value = previous ^ (previous << 13);
+            value = value ^ (value >> 17);
+            advance_random = value ^ (value << 5);
+        end
+    endfunction
+
+    task compare_ports;
+        begin
+            if ({retained_cpu_ack, retained_cpu_error, retained_cpu_no_late_error, retained_cpu_data,
+                 retained_wb_cyc, retained_wb_lock, retained_line_req && !stage_edge, retained_line_addr} !==
+                {trial_cpu_ack, trial_cpu_error, trial_cpu_no_late_error, trial_cpu_data,
+                 trial_wb_cyc, trial_wb_lock, trial_line_req, trial_line_addr})
+                $fatal(1, "Refill interface differed at check %0d", comparisons);
+            if ({retained.state, retained.consumed, retained.received, retained.failed} !==
+                {trial.state, trial.consumed, trial.received, trial.failed})
+                $fatal(1, "Refill state differed at check %0d", comparisons);
+            comparisons = comparisons + 1;
+        end
+    endtask
+
+    task cycle;
+        begin
+            #2;
+            compare_ports;
+            clk = 1;
+            stage_edge = 0;
+            #2;
+            compare_ports;
+            clk = 0;
+            #1;
+        end
+    endtask
+
+    task publish_line;
+        input guaranteed_reply;
+        begin
+            halfwords = 0;
+            retired = 0;
+            model_failed = 0;
+            model_guaranteed = guaranteed_reply;
+            line_base = line_base + 32;
+            cpu_address = line_base;
+            cpu_cti = BURST;
+            cpu_cyc = 1;
+            cpu_write = 0;
+            cpu_lock = 0;
+            line_no_late_error = guaranteed_reply;
+            cpu_code = line_cases[0];
+            if (STAGED && !cpu_code) begin
+                line_ready = 0;
+                stage_edge = 1;
+                #1;
+                if (!retained_line_req || trial_line_req || trial_wb_cyc || trial_cpu_ack)
+                    $fatal(1, "D candidate bypassed its capture clock or leaked to scalar");
+                cycle;
+                if (!trial_line_req || trial_line_addr != line_base)
+                    $fatal(1, "D offer was not published immediately after its capture");
+                staged_offers = staged_offers + 1;
+                repeat (line_cases % 4) begin
+                    cycle;
+                    held_offers = held_offers + 1;
+                    if (!trial_line_req || trial_line_addr != line_base)
+                        $fatal(1, "D offer was not held through downstream backpressure");
+                end
+            end
+            line_ready = 1;
+            #1;
+            if (!retained_line_req || retained_wb_cyc)
+                $fatal(1, "LINE offer leaked to scalar bus");
+            cycle;
+            line_ready = 0;
+            if (retained.state != 1) $fatal(1, "LINE offer did not establish ownership");
+        end
+    endtask
+
+    task line_step;
+        reg expect_ack, expect_error;
+        begin
+            cpu_address = line_base + 4 * retired;
+            cpu_cti = retired == 7 ? END_BEAT : BURST;
+            #1;
+            expect_ack = !model_failed && (halfwords / 2 > retired);
+            expect_error = model_failed;
+            if ({retained_cpu_ack, retained_cpu_error, retained_cpu_no_late_error} !==
+                {expect_ack, expect_error, expect_ack && model_guaranteed})
+                $fatal(1, "Unexpected LINE handshake at received=%0d retired=%0d", halfwords, retired);
+            if (expect_ack && retained_cpu_data !== staged_words[retired])
+                $fatal(1, "Assembled word differed at %h", cpu_address);
+            if (line_valid) begin
+                if (line_wide) begin
+                    if (expect_ack) wide_pop = wide_pop + 1;
+                    staged_words[halfwords / 2] = line_data[31:0];
+                    staged_words[halfwords / 2 + 1] = line_data[63:32];
+                    halfwords = halfwords + 4;
+                end else begin
+                    if (halfwords % 2 != 0) begin
+                        if (expect_ack) narrow_pop = narrow_pop + 1;
+                        staged_words[halfwords / 2] = {line_data[15:0], staged_half};
+                    end else staged_half = line_data[15:0];
+                    halfwords = halfwords + 1;
+                end
+                if (line_error) model_failed = 1;
+            end
+            if (expect_ack || expect_error) retired = retired + 1;
+            cycle;
+        end
+    endtask
+
+    task run_line;
+        input integer layout, error_at;
+        input gaps;
+        integer steps;
+        begin
+            publish_line(error_at < 0);
+            steps = 0;
+            while (retired < 8 && steps < 100) begin
+                prng = advance_random(prng);
+                line_valid = halfwords < 16 && !model_failed && (!gaps || |prng[1:0]);
+                line_wide = layout == 1 || (layout == 2 && (halfwords == 0 || halfwords == 8));
+                line_error = line_valid && error_at >= 0 && halfwords + (line_wide ? 4 : 1) > error_at;
+                line_last = line_error || halfwords + (line_wide ? 4 : 1) == 16;
+                line_data = {prng ^ 32'h63a92b21, prng};
+                line_step;
+                steps = steps + 1;
+            end
+            if (retired != 8 || retained.state != 0 || model_failed != (error_at >= 0))
+                $fatal(1, "LINE did not finish layout=%0d error_at=%0d retired=%0d state=%0d failed=%0d",
+                       layout, error_at, retired, retained.state, model_failed);
+            line_valid = 0;
+            line_last = 0;
+            line_error = 0;
+            cpu_cyc = 0;
+            line_cases = line_cases + 1;
+            if (model_failed) failed_lines = failed_lines + 1;
+            cycle;
+        end
+    endtask
+
+    task cancel_live_line;
+        input integer phase;
+        begin
+            publish_line(0);
+            line_valid = 1;
+            line_wide = phase != 1;
+            line_error = phase == 2;
+            line_last = line_error;
+            line_data = 64'h10203040a0b0c0d0;
+            line_step;
+            line_valid = 0;
+            cpu_cyc = 0;
+            #1;
+            compare_ports;
+            if (retained_cpu_ack || retained_cpu_error || retained_wb_cyc || retained_line_req)
+                $fatal(1, "LINE response outlived same-edge CYC withdrawal");
+            withheld_line = withheld_line + 1;
+            cpu_cyc = 1;
+            #1;
+            if ({retained_cpu_ack, retained_cpu_error} !== {phase == 0, phase == 2})
+                $fatal(1, "LINE response did not follow restored CYC");
+            reset = 1;
+            cpu_cyc = 0;
+            cycle;
+            reset = 0;
+            line_last = 0;
+            line_error = 0;
+            if (retained.state != 0 || trial.state != 0)
+                $fatal(1, "Reset left a live LINE owner");
+            cycle;
+        end
+    endtask
+
+    task scalar_reply;
+        input writes, rejects_with_error;
+        begin
+            cpu_cyc = 1;
+            cpu_write = writes;
+            cpu_lock = writes;
+            cpu_address = 32'h0c000010;
+            cpu_cti = END_BEAT;
+            wb_ack = !rejects_with_error;
+            wb_error = rejects_with_error;
+            wb_data = rejects_with_error ? 32'hd47aec10 : 32'h54b04d98;
+            #1;
+            compare_ports;
+            if (!retained_wb_cyc || retained_wb_lock != writes ||
+                retained_cpu_ack != (!REGISTERED && !rejects_with_error) ||
+                retained_cpu_error != (!REGISTERED && rejects_with_error) ||
+                retained_cpu_no_late_error || retained_cpu_data != wb_data)
+                $fatal(1, "Unexpected first scalar offer");
+            if (REGISTERED) cycle;
+            #1;
+            if (retained_cpu_ack != !rejects_with_error || retained_cpu_error != rejects_with_error)
+                $fatal(1, "Scalar peer did not acknowledge its registered owner");
+            cpu_cyc = 0;
+            #1;
+            compare_ports;
+            if (retained_cpu_ack || retained_cpu_error || retained_wb_cyc)
+                $fatal(1, "Scalar response outlived same-edge CYC withdrawal");
+            withheld_scalar = withheld_scalar + 1;
+            cpu_cyc = 1;
+            cycle;
+            wb_ack = 0;
+            wb_error = 0;
+            cpu_cyc = 0;
+            cpu_write = 0;
+            cpu_lock = 0;
+            cycle;
+            if (writes) scalar_writes = scalar_writes + 1;
+            else scalar_reads = scalar_reads + 1;
+            if (rejects_with_error) scalar_errors = scalar_errors + 1;
+        end
+    endtask
+
+    task rejected_line;
+        integer word;
+        begin
+            publish_line(1);
+            line_reject = 1;
+            cycle;
+            line_reject = 0;
+            if (retained.state != 2 || !retained_wb_cyc || retained_cpu_no_late_error)
+                $fatal(1, "Rejected LINE did not immediately hand the packet to scalar");
+            for (word = 0; word < 8; word = word + 1) begin
+                cpu_address = line_base + 4 * word;
+                cpu_cti = word == 7 ? END_BEAT : BURST;
+                wb_ack = 0;
+                cycle;
+                wb_data = 32'hdf110000 | word;
+                wb_ack = 1;
+                #1;
+                if (!retained_cpu_ack || retained_cpu_error || retained_cpu_no_late_error ||
+                    retained_cpu_data != wb_data)
+                    $fatal(1, "Scalar fallback did not deliver the rejected LINE word");
+                cycle;
+            end
+            wb_ack = 0;
+            cpu_cyc = 0;
+            if (retained.state != 0) $fatal(1, "Fallback burst did not release scalar ownership");
+            cycle;
+        end
+    endtask
+
+    task cancel_scalar;
+        begin
+            // Let the registered peer capture an offer, then drop CYC
+            // across the clock carrying the now-unowned error.
+            cpu_cyc = 1;
+            cpu_address = 32'h0c000020;
+            cpu_cti = END_BEAT;
+            cycle;
+            cpu_cyc = 0;
+            wb_error = 1;
+            cycle;
+            if (retained_cpu_ack || retained_cpu_error || retained_wb_cyc || retained.scalar_offered)
+                $fatal(1, "Canceled scalar transaction retained the previous owner");
+            wb_error = 0;
+            withheld_scalar = withheld_scalar + 1;
+            cycle;
+            scalar_reply(0, 0);
+        end
+    endtask
+
+
+    task clock_uncompared;
+        begin
+            #2;
+            clk = 1;
+            #2;
+            clk = 0;
+            #1;
+        end
+    endtask
+
+    task contact_and_reset;
+        begin
+            cpu_code = 0;
+            cpu_address = 32'h0a040000;
+            cpu_cti = BURST;
+            cpu_cyc = 1;
+            cpu_lock = 1;
+            line_ready = 1;
+            #1;
+            if (trial_line_req || !trial_wb_cyc || !trial_wb_lock)
+                $fatal(1, "An already locked CPU cannot capture a native D line");
+            // Remove the unaccepted locked offer before the sampling edge.
+            cpu_lock = 0;
+            #1;
+            if (!retained_line_req || trial_line_req || trial_wb_cyc)
+                $fatal(1, "Always-ready D offer was not delayed exactly one edge");
+            clock_uncompared;
+            if (retained.state != 1 || trial.state != 0 || !trial_line_req)
+                $fatal(1, "Incorrect first disposition of always-ready D offer");
+
+            // A younger SWP lock cannot overtake the earlier, owned D line.
+            cpu_lock = 1;
+            #1;
+            if (!trial_line_req || trial_wb_lock || trial_wb_cyc)
+                $fatal(1, "Younger SWP interfered with pending D-line owner");
+            clock_uncompared;
+            if (trial.state != 1 || trial_line_req || trial_wb_lock)
+                $fatal(1, "Pending D owner did not grant with younger SWP held");
+            reset = 1;
+            cpu_cyc = 0;
+            cpu_lock = 0;
+            cycle;
+            reset = 0;
+
+            // Publish another D offer, then abort transport before ready.
+            cpu_cyc = 1;
+            line_ready = 0;
+            clock_uncompared;
+            if (!trial_line_req) $fatal(1, "No D offer to cancel with reset");
+            reset = 1;
+            cpu_cyc = 0;
+            line_ready = 1;
+            #1;
+            if (trial_line_req || trial_wb_cyc || trial_cpu_ack)
+                $fatal(1, "Reset failed to withdraw a pending D-line offer");
+            cycle;
+            resets_pending = resets_pending + 1;
+            reset = 0;
+            cpu_code = 1;
+            cpu_cyc = 1;
+            cpu_address = 32'h0a060000;
+            line_ready = 0;
+            #1;
+            if (!trial_line_req || trial_line_addr != cpu_address)
+                $fatal(1, "First I line after reset failed direct admission");
+            cpu_cyc = 0;
+            #1;
+            if (trial_line_req || trial_wb_cyc) $fatal(1, "Withdrawn I offer reached the board");
+            cycle;
+            line_ready = 0;
+        end
+    endtask
+
+    initial begin
+        clock_uncompared;
+        reset = 0;
+        cycle;
+        scalar_reply(0, 0);
+        scalar_reply(0, 1);
+        scalar_reply(1, 0);
+        scalar_reply(1, 1);
+        cancel_scalar;
+        if (ENABLE) begin
+            run_line(0, -1, 0);
+            run_line(1, -1, 0);
+            run_line(2, -1, 0);
+            run_line(0, 0, 0);
+            run_line(0, 15, 0);
+            run_line(1, 4, 0);
+            run_line(1, 12, 0);
+            run_line(2, 5, 0);
+            for (sample = 0; sample < 96; sample = sample + 1) begin
+                prng = advance_random(prng);
+                run_line(sample % 3, sample % 2 == 0 ? int'(prng[3:0]) : -1, 1);
+            end
+            rejected_line;
+            if (STAGED) contact_and_reset;
+            cancel_live_line(0);
+            cancel_live_line(1);
+            cancel_live_line(2);
+            run_line(0, -1, 0);
+            if (line_cases != 105 || failed_lines != 53 ||
+                narrow_pop == 0 || wide_pop == 0 || withheld_line != 3)
+                $fatal(1, "LINE directed coverage incomplete");
+        end
+        $display("PASS refill interface enable=%0d registered=%0d comparisons=%0d line=%0d errors=%0d narrow_pop=%0d wide_pop=%0d line_withdraw=%0d scalar_withdraw=%0d reads=%0d writes=%0d scalar_errors=%0d",
+                 ENABLE, REGISTERED, comparisons, line_cases, failed_lines, narrow_pop, wide_pop,
+                 withheld_line, withheld_scalar, scalar_reads, scalar_writes, scalar_errors);
+        if (STAGED && ENABLE && (staged_offers < 46 || held_offers < 46 || resets_pending != 1))
+            $fatal(1, "The registered D contact coverage was incomplete");
+        $display("PASS offer selection enabled=%0d staged=%0d D=%0d held=%0d pending_reset=%0d",
+                 ENABLE, STAGED, staged_offers, held_offers, resets_pending);
+        $finish;
+    end
+endmodule
diff --git a/scratch/v5-fit-loop/d-line-admission/lcd-phase.sv b/scratch/v5-fit-loop/d-line-admission/lcd-phase.sv
new file mode 100644
index 0000000..b325a73
--- /dev/null
+++ b/scratch/v5-fit-loop/d-line-admission/lcd-phase.sv
@@ -0,0 +1,192 @@
+`timescale 1ns/1ps
+
+// RAM-only board ingress using the retained preview/hold equations. The
+// production line mux, stream, scheduler, DDIO and pin model follow it.
+module lcd_phase;
+    parameter STAGED = 0;
+    reg clk = 0;
+    reg cold = 1;
+    always #(500000000.0/104000000) clk = ~clk;
+
+    reg d_request = 0, lcd_request = 0;
+    reg [31:0] d_address = 32'h0a000000;
+    reg [2:0] d_cti = 3'b010;
+    wire d_ack, d_error, trusted, d_line_req, d_line_ready, wb_cyc, wb_lock;
+    wire [31:0] d_data, d_line_addr;
+    wire ram_req, ram_short, ram_ready, ram_valid, ram_last;
+    wire [24:0] ram_addr;
+    wire [15:0] ram_data;
+    wire d_mux_ready, d_mux_valid, d_mux_last, lcd_ready, lcd_valid, lcd_last;
+    reg [1:0] ram_state = 0;
+    reg [24:0] held_address;
+    localparam IDLE = 0, ISSUE = 1, RECEIVE = 2;
+    wire preview = d_line_req && d_line_ready;
+    wire ram_offer = ram_state == ISSUE || preview;
+    assign d_line_ready = !cold && ram_state == IDLE;
+    always @(posedge clk) begin
+        if (cold) ram_state <= IDLE;
+        else case (ram_state)
+            IDLE: if (preview) begin
+                held_address <= d_line_addr[24:0];
+                ram_state <= d_mux_ready ? RECEIVE : ISSUE;
+            end
+            ISSUE: if (d_mux_ready) ram_state <= RECEIVE;
+            RECEIVE: if (d_mux_valid && d_mux_last) ram_state <= IDLE;
+            default: ram_state <= IDLE;
+        endcase
+    end
+
+    ngage_arm9v2_refill #(.ENABLE(1), .REGISTERED_SCALAR_PEER(1),
+                         .REGISTERED_D_LINE_OFFER(STAGED)) refill (
+        .clk(clk), .reset(cold), .cpu_cyc(d_request), .cpu_lock(1'b0),
+        .cpu_line_candidate(d_request && d_address[4:0] == 0),
+        .cpu_address(d_address), .cpu_write(1'b0), .cpu_sel(4'hf),
+        .cpu_cti(d_cti), .cpu_bte(2'b0), .cpu_ack(d_ack), .cpu_error(d_error),
+        .cpu_no_late_error(trusted), .cpu_data(d_data), .wb_cyc(wb_cyc), .wb_lock(wb_lock),
+        .wb_ack(1'b0), .wb_error(1'b0), .wb_data(32'b0), .line_req(d_line_req), .line_addr(d_line_addr),
+        .line_ready(d_line_ready), .line_no_late_error(d_line_ready), .line_reject(1'b0),
+        .line_valid(ram_state == RECEIVE && d_mux_valid), .line_data({48'b0, ram_data}),
+        .line_wide(1'b0), .line_last(d_mux_last), .line_error(1'b0), .cpu_code(1'b0)
+    );
+    ngage_sdram_line_mux #(.LCD_LINE_BYTES(16)) mux (
+        .clk(clk), .reset(cold), .cpu_lock(wb_lock), .scalar_waiting(1'b0), .scalar_accept(1'b0),
+        .scalar_active(1'b0), .hold_scalar(), .cpu_req(ram_offer),
+        .cpu_addr(ram_state == ISSUE ? held_address : d_line_addr[24:0]),
+        .cpu_ready(d_mux_ready), .cpu_valid(d_mux_valid), .cpu_last(d_mux_last),
+        .lcd_req(lcd_request), .lcd_addr(25'h20), .lcd_ready(lcd_ready),
+        .lcd_valid(lcd_valid), .lcd_last(lcd_last), .ram_req(ram_req), .ram_short(ram_short),
+        .ram_addr(ram_addr), .ram_ready(ram_ready), .ram_valid(ram_valid), .ram_last(ram_last)
+    );
+
+    wire mem_req, mem_we, mem_line, mem_short, ready, command_ready, busy, valid, scrub_done;
+    wire [24:2] mem_address;
+    wire [127:0] mem_data;
+    wire [15:0] mem_mask;
+    wire [31:0] read_data;
+    ngage_sdram_stream #(.SCRUB_BYTES(25'd64)) stream (
+        .clk(clk), .cold(cold), .phone_reset(cold), .lock(1'b0), .owner_ready(),
+        .grant_read(1'b0), .grant_addr(25'b0), .req(1'b0), .we(1'b0), .write_block(1'b0),
+        .block_data(128'b0), .addr(25'b0), .din(32'b0), .be(4'b0), .ack(), .dout(),
+        .line_req(ram_req), .line_short(ram_short), .line_addr(ram_addr), .line_ready(ram_ready),
+        .line_valid(ram_valid), .line_data(ram_data), .line_last(ram_last), .scrub_done(scrub_done),
+        .mem_req(mem_req), .mem_we(mem_we), .mem_line(mem_line), .mem_short(mem_short),
+        .mem_addr(mem_address), .mem_wdata(mem_data), .mem_wbe(mem_mask),
+        .mem_ready(ready), .mem_cmd_ready(command_ready), .mem_busy(busy),
+        .mem_valid(valid), .mem_rdata(read_data)
+    );
+    wire pin_clk, cke, cs_n, ras_n, cas_n, we_n, dqml, dqmh;
+    wire [1:0] bank;
+    wire [12:0] pin_addr;
+    wire [15:0] pin_out, pin_in;
+    tri [15:0] unused_dq;
+    ngage_sdram_clock clock_pin (.clk(clk), .sdram_clk(pin_clk));
+    assign #5.5 pin_in = memory.Dq_reg;
+    ngage_sdram_scheduler #(.CLK_HZ(104000000)) controller (
+        .clk(clk), .init(cold), .ready(ready), .req(mem_req), .busy(busy), .cmd_ready(command_ready),
+        .we(mem_we), .line(mem_line), .read_short(mem_short), .addr(mem_address),
+        .wdata(mem_data), .wbe(mem_mask), .rvalid(valid), .rword(), .rdata(read_data),
+        .sdram_cke(cke), .sdram_cs_n(cs_n), .sdram_ras_n(ras_n), .sdram_cas_n(cas_n), .sdram_we_n(we_n),
+        .sdram_ba(bank), .sdram_a(pin_addr), .sdram_dqml(dqml), .sdram_dqmh(dqmh),
+        .sdram_dq_o(pin_out), .sdram_dq_i(pin_in)
+    );
+    mt48lc16m16a2 memory (
+        .Dq_write(pin_out), .Clk(pin_clk), .Cke(cke), .Dq(unused_dq), .Addr(pin_addr), .Ba(bank),
+        .Cs_n(cs_n), .Ras_n(ras_n), .Cas_n(cas_n), .We_n(we_n), .Dqm({dqmh, dqml}),
+        .downloading(1'b0), .VS(1'b0), .frame_cnt(32'b0)
+    );
+
+    integer tick = 0, refresh_stamp = 0, refresh_count = 0;
+    always @(posedge clk) tick <= tick + 1;
+    always @(posedge pin_clk)
+        if (scrub_done && {cs_n, ras_n, cas_n, we_n} == 4'b0001) begin
+            refresh_stamp = tick;
+            refresh_count++;
+        end
+
+    task automatic trial(input integer sample, d_offset, lcd_offset);
+        integer anchor, cpu_grant, lcd_grant, first, last, d_words, lcd_halfwords, overlaps, refresh_at_open;
+        reg d_beat, lcd_beat, lcd_take;
+        @(negedge clk);
+        wait (refresh_count != 0);
+        anchor = refresh_stamp;
+        // Each pair starts after a refresh. Every tested prior phase has
+        // retired, and refresh precharged all banks for both design legs.
+        if (tick > anchor + 2) begin
+            wait (refresh_stamp != anchor);
+            anchor = refresh_stamp;
+        end
+        @(negedge clk);
+        cpu_grant = -1;
+        lcd_grant = -1;
+        first = -1;
+        last = -1;
+        d_words = 0;
+        lcd_halfwords = 0;
+        overlaps = 0;
+        refresh_at_open = refresh_count;
+        d_address = 32'h0a000000;
+        d_cti = 3'b010;
+        while ((d_words < 8 || lcd_halfwords < 8) && tick < anchor + 850) begin
+            if (tick == anchor + d_offset) d_request = 1;
+            if (tick == anchor + lcd_offset) lcd_request = 1;
+            @(posedge clk);
+            if (d_error || wb_cyc) $fatal(1, "Native D line escaped to scalar/error");
+            if (ram_offer && d_mux_ready) begin
+                if (cpu_grant >= 0 || ram_addr != 0 || ram_short)
+                    $fatal(1, "D line wrong address/ownership");
+                cpu_grant = tick;
+            end
+            lcd_take = lcd_request && lcd_ready;
+            if (lcd_take) begin
+                if (lcd_grant >= 0 || ram_addr != 25'h20 || !ram_short)
+                    $fatal(1, "LCD line wrong address/ownership");
+                lcd_grant = tick;
+            end
+            if (ram_offer && lcd_request) overlaps++;
+            d_beat = d_ack;
+            lcd_beat = lcd_valid;
+            if (d_beat) begin
+                if (d_data !== {16'(16'hda01 + 2*d_words), 16'(16'hda00 + 2*d_words)} ||
+                    !trusted || cpu_grant < 0)
+                    $fatal(1, "Unexpected D word %0d data=%h", d_words, d_data);
+                if (d_words == 0) first = tick;
+                if (d_words == 7) last = tick;
+            end
+            if (lcd_beat && (ram_data !== 16'(16'h1cd0 + lcd_halfwords) ||
+                             lcd_last != (lcd_halfwords == 7) || lcd_grant < 0))
+                $fatal(1, "Unexpected LCD halfword %0d data=%h", lcd_halfwords, ram_data);
+            @(negedge clk);
+            if (d_beat) begin
+                d_words++;
+                if (d_words == 8) d_request = 0;
+                else begin
+                    d_address = d_address + 4;
+                    if (d_words == 7) d_cti = 3'b111;
+                end
+            end
+            if (lcd_take) lcd_request = 0;
+            if (lcd_beat) lcd_halfwords++;
+        end
+        if (d_words != 8 || lcd_halfwords != 8)
+            $fatal(1, "Service timeout sample=%0d tick=%0d D=%0d LCD=%0d", sample, tick-anchor, d_words, lcd_halfwords);
+        $display("PHASE sample=%0d d_offset=%0d lcd_offset=%0d cpu_grant=%0d first=%0d last=%0d lcd_grant=%0d overlap=%0d refresh=%0d",
+                 sample, d_offset, lcd_offset, cpu_grant-anchor, first-anchor, last-anchor,
+                 lcd_grant-anchor, overlaps, refresh_count-refresh_at_open);
+    endtask
+
+    initial begin
+        repeat (5) @(negedge clk);
+        cold = 0;
+        wait (scrub_done);
+        @(negedge clk);
+        for (integer word = 0; word < 16; word++) memory.Bank0[word] = 16'(16'hda00 + word);
+        for (integer word = 0; word < 8; word++) memory.Bank0[word+16] = 16'(16'h1cd0 + word);
+        for (integer refresh_phase = 0; refresh_phase < 3; refresh_phase++)
+            for (integer phase = -4; phase <= 7; phase++)
+                trial(12*refresh_phase+phase+4,
+                      refresh_phase == 0 ? 35 : refresh_phase == 1 ? 744 : 754,
+                      (refresh_phase == 0 ? 35 : refresh_phase == 1 ? 744 : 754) + phase);
+        $display("PASS LCD and D native phase sweep staged=%0d samples=36", STAGED);
+        $finish;
+    end
+endmodule
diff --git a/scratch/v5-fit-loop/d-line-admission/lcd-phase.sh b/scratch/v5-fit-loop/d-line-admission/lcd-phase.sh
