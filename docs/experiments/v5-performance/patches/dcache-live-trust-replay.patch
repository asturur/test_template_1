diff --git a/scratch/v5-fit-loop/dcache-live-trust/board.sh b/scratch/v5-fit-loop/dcache-live-trust/board.sh
new file mode 100644
index 0000000..7147d30
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-live-trust/board.sh
@@ -0,0 +1,47 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/dcache-live-trust
+out=build/sim/v5-104-dcache-live-trust/board
+fixture=tests/cpu/arm9v2_board
+mkdir -p "$out"
+arm-none-eabi-gcc -c -mcpu=arm920t -marm -DEXPECTED_CTYPE=0x0514a14a -DASSOC_WAYS=2 \
+    -DSECTION_INDEX_TEST "$area/reference/$fixture/contract.S" -o "$out/guest.o"
+arm-none-eabi-ld -T "$area/reference/sim/programs/link.ld" "$out/guest.o" -o "$out/guest.elf"
+arm-none-eabi-objcopy -O binary "$out/guest.elf" "$out/guest.bin"
+python3 -B - "$out" <<'PY'
+from pathlib import Path
+import struct
+import sys
+
+out = Path(sys.argv[1])
+words = struct.iter_unpack('<I', (out / 'guest.bin').read_bytes())
+(out / 'guest.hex').write_text(''.join(f'{word:08x}\n' for (word,) in words))
+PY
+
+for leg in reference source; do
+    mkdir -p "$out/$leg"
+    docker run --rm --pull=never --network none --platform linux/arm64 \
+        -v "$PWD/$area/$leg:/work:ro" -v "$PWD/$out:/results" -w /work \
+        --entrypoint sh jotego/simulator:arm64 -ec '
+        out=/results/$1
+        verilator --binary --timing --assert -j 2 \
+            -Wno-fatal -Wno-lint -DNGAGE_ARM9V2 --top-module contract --Mdir "$out/obj" \
+            rtl/ngage_cpu.sv rtl/ngage_upp.v rtl/arm9v2/arm925t_phone.v \
+            rtl/arm9v2/upstream/sim/stubs/*.sv tests/cpu/arm9v2_board/contract.v > "$out/build.log" 2>&1
+        for burst in 0 1; do
+            for wait in 0 5; do
+                log="$out/burst-$burst-wait-$wait.log"
+                "$out/obj/Vcontract" +program=/results/guest.hex "+wait=$wait" "+burst=$burst" \
+                    +half-writeback +section-reads=2 > "$log" 2>&1
+                grep -E "^(PASS|LINES|ASSOC|SECTION|DATA_FAULT|REFILL_FAULT) " "$log" > "${log%.log}.trace"
+                grep -q "^PASS " "$log"
+            done
+        done' board "$leg"
+done
+for burst in 0 1; do
+    for wait in 0 5; do
+        name=burst-$burst-wait-$wait.trace
+        cmp "$out/reference/$name" "$out/source/$name"
+        grep '^PASS ' "$out/source/$name"
+    done
+done
diff --git a/scratch/v5-fit-loop/dcache-live-trust/mixed.py b/scratch/v5-fit-loop/dcache-live-trust/mixed.py
new file mode 100644
index 0000000..f1acd42
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-live-trust/mixed.py
@@ -0,0 +1,34 @@
+"""Stage the frozen physical-SDRAM replay with the isolated D-cache RTL."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shutil
+
+
+stage = Path(__file__).resolve().parent
+base = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+trial = Path('build/sim/v5-104-dcache-live-trust/mixed')
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+peer = 'tests/phone/upp_ddr_ram/peer.v'
+
+trial.mkdir(parents=True, exist_ok=True)
+shutil.copytree(base / 'source', trial / 'source', dirs_exist_ok=True)
+for name in ('stress.hex', 'image.hex', 'program.hex'):
+    shutil.copyfile(base / name, trial / name)
+(trial / 'source' / peer).parent.mkdir(parents=True, exist_ok=True)
+shutil.copyfile(stage / 'source' / peer, trial / 'source' / peer)
+shutil.copyfile(stage / 'source' / rtl, trial / 'source' / rtl)
+
+hashes = json.loads((base / 'source-hashes.json').read_text())
+assert rtl in hashes and peer in hashes
+for name, reference in hashes.items():
+    if name.startswith('rtl/'):
+        assert sha256((stage / 'reference' / name).read_bytes()).hexdigest() == reference, name
+    actual = sha256((trial / 'source' / name).read_bytes()).hexdigest()
+    assert (actual != reference) == (name == rtl), name
+    hashes[name] = actual
+(trial / 'source-hashes.json').write_text(json.dumps(hashes, indent=2) + '\n')
+
+build = (base / 'build.sh').read_text().replace(str(base), str(trial))
+build = build.replace(f' {peer} ', f' {trial}/source/{peer} ')
+(trial / 'build.sh').write_text(build)
diff --git a/scratch/v5-fit-loop/dcache-live-trust/replay.py b/scratch/v5-fit-loop/dcache-live-trust/replay.py
new file mode 100644
index 0000000..be168c0
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-live-trust/replay.py
@@ -0,0 +1,182 @@
+"""Replay D-cache live trust against the retained 104 MHz control."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import statistics
+import subprocess
+import sys
+
+parser = argparse.ArgumentParser()
+parser.add_argument('kind', choices=('fixed', 'native'))
+parser.add_argument('--case', action='append')
+parser.add_argument('--workers', type=int, default=3)
+parser.add_argument('--output', default='replay')
+args = parser.parse_args()
+kind = args.kind
+stage = Path(__file__).resolve().parent
+repo = stage.parents[2]
+work = repo / 'build/sim/v5-104-dcache-live-trust' / args.output
+work.mkdir(parents=True, exist_ok=True)
+baseline_name = 'v5-104-all-four-ram-candidate'
+fixed = repo / 'build/sim/payload-clocks' / baseline_name
+native = repo / 'build/sim/polycount' / baseline_name
+timing_baseline = repo / 'scratch/refill-issue-739d3bd'
+d_stage = stage / 'ngage_cpu.sv'
+candidate = stage / 'source/rtl/arm9v2/arm925t_phone.v'
+image = 'jotego/simulator:arm64'
+docker = ['docker', 'run', '--rm', '--pull=never', '--network', 'none', '--platform', 'linux/arm64',
+          '-v', f'{work}:/work', '-v', f'{repo}:/frozen:ro', '-w', '/work', '--entrypoint']
+sys.path.insert(0, str(stage / 'source/tests/cpu/arm9v2_board'))
+import payload_clocks
+payload_clocks.OUT = repo / "build/sim"
+from payload_clocks import qualified_inputs
+
+
+def frozen(path):
+    return '/frozen/' + str(path.relative_to(repo))
+
+
+def run(options, entrypoint, log):
+    with log.open('w') as handle:
+        return subprocess.run(docker + [entrypoint, image] + options, stdout=handle,
+                              stderr=subprocess.STDOUT, check=False).returncode
+
+
+def build():
+    compiled_netlist = work / f'{kind}-candidate-cpu.v'
+    compiled_netlist.write_bytes(candidate.read_bytes())
+    ref = fixed if kind == 'fixed' else native / 'i16'
+    bench = (ref / 'tb.v').read_text()
+    observer = (stage / 'architectural_trace.vh').read_text() + (stage / 'wb-write-trace.vh').read_text()
+    (work / f'{kind}.sv').write_text(bench.rsplit('endmodule', 1)[0] + observer + '\nendmodule\n')
+    command = next(line for line in (ref / 'mmc3-nos64/Vtb__verFiles.dat').read_text().splitlines()
+                   if line.startswith('C '))
+    options = shlex.split(command.removeprefix('C "').removesuffix('"'))
+    net_hits, wrapper_hits, bench_hits = 0, 0, 0
+    for i, option in enumerate(options):
+        if option == 'rtl/ngage_cpu.sv':
+            options[i] = frozen(d_stage)
+            wrapper_hits += 1
+        elif option in {'rtl/ngage_ddr_stream.v', 'rtl/ngage_upp.v', 'rtl/ngage_dma_channels.v', 'rtl/ngage_upp_peripherals.v', 'rtl/ngage_keypad.v', 'rtl/ngage_upp_euart.v'}:
+            options[i] = frozen(stage / 'source' / option)
+        elif option.startswith('/work/') and option.endswith(('/arm925t_phone.v', '/arm925t-i16.v')):
+            options[i] = '/work/' + compiled_netlist.name
+            net_hits += 1
+        elif option.startswith('/work/') and option.endswith('/tb.v'):
+            options[i] = f'/work/{kind}.sv'
+            bench_hits += 1
+        elif option.startswith('/work/') and option.endswith(('.v', '.sv')):
+            options[i] = option.replace('/work/', '/frozen/', 1)
+        elif option.startswith('-Irtl/'):
+            options[i] = '-I' + frozen(timing_baseline / 'leg' / option[2:])
+        elif option.endswith(('.v', '.sv')):
+            source = timing_baseline / 'leg' / option
+            assert source.is_file(), source
+            options[i] = frozen(source)
+    assert net_hits == wrapper_hits == bench_hits == 1, (net_hits, wrapper_hits, bench_hits)
+    options[options.index('--Mdir') + 1] = f'obj-{kind}'
+    options.insert(0, '-I'+frozen(timing_baseline / 'leg'))
+    options[options.index('-j') + 1] = '3'
+    log = work / f'build-{kind}.log'
+    assert run(options, 'verilator', log) == 0, log
+    compiled = (work / f'obj-{kind}/Vtb__verFiles.dat').read_text().splitlines()
+    assert any(line.startswith('S ') and line.endswith('/dcache-live-trust/source/rtl/ngage_ddr_stream.v\"') for line in compiled)
+    for changed in ('ngage_upp.v', 'ngage_dma_channels.v', 'ngage_upp_peripherals.v', 'ngage_keypad.v', 'ngage_upp_euart.v'):
+        assert any(line.startswith('S ') and line.endswith(f'/dcache-live-trust/source/rtl/{changed}"') for line in compiled), changed
+    for source in (f'{kind}.sv', compiled_netlist.name):
+        assert any(line.startswith('S ') and line.endswith(f'"/work/{source}"') for line in compiled), source
+    for cache in (work / f'obj-{kind}').glob('*.gch'):
+        cache.unlink()
+
+
+def scan(log, prefix, hex_fields=False):
+    rows = []
+    for line in log.read_text().splitlines():
+        if line.startswith(prefix):
+            pairs = re.findall(r'(\w+)=(-?[0-9a-f]+)', line)
+            rows.append({k: int(v, 16 if hex_fields and k.endswith('_hash') else 10) for k, v in pairs})
+    return rows
+
+
+def digest(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def execute(profile, case, attempt=0, wrong=False):
+    delay, thumb = profile
+    inputs = ['+ngage-compact-trace', '+no-board-log',
+              '+extension=' + frozen(repo / 'build/firmware/nem4-factory/extension.bin')]
+    suffix = f'{delay}{thumb}-{attempt}{"-wrong" if wrong else ""}'
+    if kind == 'fixed':
+        name = case['name']
+        inputs += ['+core=' + frozen(fixed / f'{name}-{wrong}.bin'), '+cdrive=' + frozen(fixed / 'cdrive.bin'),
+                   f'+begin_pc={case["begin"]:x}', f'+end_pc={case["end"]:x}',
+                   f'+payload_base={case["payload_base"]:x}', f'+helper_base={case["helper_base"]:x}']
+    else:
+        name = 'native'
+        result = work / f'native-{suffix}.bin'
+        inputs += ['+core=' + frozen(native / 'core.bin'), '+cdrive=' + frozen(native / 'cdrive.bin'),
+                   '+snapshot=' + frozen(native / 'snapshot.bin'), f'+results=/work/native-{suffix}',
+                   '+begin_pc=68', '+end_pc=6c', '+done_pc=80', '+fail_pc=84']
+    log = work / f'{name}-{suffix}.log'
+    code = run(inputs, f'/work/obj-{kind}/Vtb', log)
+    if wrong:
+        assert code != 0 and 'Guest output check rejected payload' in log.read_text(), log
+        return None
+    assert code == 0, log
+    architecture = scan(log, 'RES_ARCH ', hex_fields=True)
+    wb_writes = scan(log, 'RES_WB ', hex_fields=True)
+    assert len(wb_writes) == len(architecture)
+    if kind == 'fixed':
+        windows = scan(log, 'PAYLOAD_RESULT ')
+        assert len(architecture) == len(windows) == 7, log
+        assert len(scan(log, 'PAYLOAD_PASS ')) == 1
+        for actual, expect in zip(windows, case['windows'], strict=True):
+            assert actual['payload_ops'] == expect['payload_retire_proxy']
+            assert actual['helper_ops'] == expect['helper_retire_proxy']
+        return dict(profile=profile, case=name, windows=windows, architecture=architecture, wb_writes=wb_writes,
+                    median=statistics.median(x['cycles'] for x in windows[2:]))
+    frames = scan(log, 'POLY_FRAME ')
+    assert len(architecture) == len(frames) == 4, log
+    assert len(scan(log, 'PASS_POLYCOUNT ')) == 1
+    assert digest(result) == digest(native / 'i16/result.bin')
+    return dict(profile=profile, case=name, frames=frames, architecture=architecture, wb_writes=wb_writes,
+                output_sha256=digest(result), median=statistics.median(f['clocks'] for f in frames[1:]))
+
+
+def architectural_work(row):
+    return [{k:v for k,v in entry.items() if k != 'recover'} for entry in row['architecture']]
+
+control = json.loads((stage.parent/'prepared-wb-write-data'/'candidate'/f'{kind}.json').read_text())
+assert control['status'] == 'PASS'
+assert control['ddr_stream_sha256'] == digest(stage/'source/rtl/ngage_ddr_stream.v')
+reference = {r['candidate']['case']:r['candidate'] for r in control['rows']}
+
+build()
+rows=[]
+with ThreadPoolExecutor(max_workers=args.workers) as pool:
+    cases = [None] if kind=='native' else [case for case in qualified_inputs()
+                                            if not args.case or case['name'] in args.case]
+    if kind=='fixed':
+        assert len(cases)==(len(args.case) if args.case else 15)
+        cases.sort(key=lambda r:r['name']!='sega-scan')
+    for case in cases:
+        primary = pool.submit(execute, (0,0), case)
+        repeat = pool.submit(execute, (0,0), case, attempt=1) if kind=='fixed' else None
+        wrong = pool.submit(execute,(0,0),case,wrong=True) if kind=='fixed' else None
+        trial=primary.result()
+        if repeat:
+            assert trial==repeat.result() and wrong.result() is None
+        name=trial['case']
+        expected = {**reference[name], 'profile': (0,0)}
+        assert trial == expected, (name, trial, expected)
+        rows.append(dict(candidate=trial, control=expected))
+        print(name, trial['median'], flush=True)
+(work/f'{kind}.json').write_text(json.dumps(dict(status='PASS', netlist_sha256=digest(candidate),
+                                                wrapper_sha256=digest(d_stage), ddr_stream_sha256=digest(stage / 'source/rtl/ngage_ddr_stream.v'),
+                                                dma_channels_sha256=digest(stage / 'source/rtl/ngage_dma_channels.v'),
+                                                source_sha256={name:digest(stage / 'source/rtl' / name) for name in ('ngage_upp.v','ngage_upp_peripherals.v','ngage_upp_euart.v','ngage_keypad.v')}, rows=rows),indent=2)+'\n')
diff --git a/scratch/v5-fit-loop/dcache-live-trust/prepare-proof.py b/scratch/v5-fit-loop/dcache-live-trust/prepare-proof.py
new file mode 100644
index 0000000..89d6fec
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-live-trust/prepare-proof.py
@@ -0,0 +1,151 @@
+"""Build an Icarus miter from the exact retained and candidate FSM modules."""
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+work = Path('build/sim/v5-104-dcache-live-trust/proof')
+work.mkdir(parents=True, exist_ok=True)
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+
+
+def extract_module(leg, name):
+    netlist = (stage / leg / rtl).read_text()
+    return re.search(rf'^module {name} \(.*?^endmodule$', netlist, re.M | re.S)[0]
+
+
+name = 'ngage2_zap_dcache_fsm'
+reference = extract_module('reference', name)
+candidate = extract_module('source', name)
+region = extract_module('reference', 'ngage2_refill_region')
+assert region == extract_module('source', 'ngage2_refill_region')
+(work / 'region.v').write_text(region)
+before = '(state_nxt[IDLE] || hum_slot_nxt) && !(o_fill_busy && !fill_busy_nxt)'
+after = 'hum_slot_nxt || (state_nxt[IDLE] && !o_fill_busy)'
+assert candidate.replace('\t\t\t// The fill slot implies next fill busy. One-hot IDLE excludes it.\n', '').replace(
+    after, before) == reference
+for name, source in (('reference', reference), ('trial', candidate)):
+    (work / f'{name}.v').write_text(source.replace('module ngage2_zap_dcache_fsm (', f'module {name}_fsm ('))
+
+states = {
+    'IDLE': ('i_rd i_wr i_cache_inv i_cache_clean i_line_req i_align_fault i_fault i_busy '
+             'post_stream i_cache_en i_cacheable i_wt i_post_full post_eligible i_cache_hit '
+             'i_cache_tag_valid cache_dirty victim_alias').split(),
+    'UNCACHEABLE': ['i_wb_ack', 'i_wb_err'],
+    'UNCACHEABLE_PREPARE': [],
+    'CLEAN_SINGLE': ['writeback_next_valid', 'defer_writeback', 'keep_more', 'wait1_ff'],
+    'FETCH_SINGLE': ['take', 'beat_inc_ok', 'beat_cur_ok'],
+    'INVALIDATE': ['i_cache_inv_done'],
+    'CLEAN': ['i_cache_clean_done'],
+    'UNLOCK_REG': ['o_writeback_busy', 'wr', 'i_rd', 'i_wr'],
+    'LINEOP': ['i_line_done_tr'],
+    'UNC_DONE': [],
+    'UNLOCK_WR': ['keep_more', 'wait1_ff'],
+    'RELOOKUP0': [],
+    'RELOOKUP1': [],
+    'RELOOKUP2': [],
+}
+trust_terms = ['o_fill_busy', 'lookup_ready_nxt', 'line_safe_nxt', 'fill_visible_ff', 'victim_safe_nxt']
+terms = sorted({term for branch in states.values() for term in branch} | set(trust_terms))
+indices = {name: int(index) for name, index in re.findall(r"localparam \[3:0\] (\w+) = 4'd(\d+);", reference)
+           if name in states}
+assert sorted(indices.values()) == list(range(len(states)))
+assert len(re.findall(r'\bstate_ff(?:\[IDLE\])? <= ', reference)) == 3
+assert set(re.findall(r'\bstate_ff\[(\w+)\]: begin', reference)) == states.keys()
+assert reference.count('state_nxt = state_ff;') == 1
+
+tb = ["""
+`timescale 1ns/1ps
+module tb;
+    reg clk = 0;
+    reg reset = 1;
+    reg [13:0] current_state;
+    reg [13:0] hypothetical_next;
+    reg [13:0] reached;
+    integer checks = 0;
+    integer mask, state;
+    integer trust_checks = 0;
+    reg expected;
+    reference_fsm #(.CACHE_LINE(32), .CACHE_SIZE(16384), .WAYS(2), .HALF_WRITEBACK(1), .FLAT_ACK(1))
+        ref_dut (.i_clk(clk), .i_reset(reset), .i_reg_idx_bin(6'd0));
+    trial_fsm #(.CACHE_LINE(32), .CACHE_SIZE(16384), .WAYS(2), .HALF_WRITEBACK(1), .FLAT_ACK(1))
+        trial_dut (.i_clk(clk), .i_reset(reset), .i_reg_idx_bin(6'd0));
+
+    task pulse;
+        begin
+            #1 clk = 1;
+            #1 clk = 0;
+        end
+    endtask
+
+    task check_next_state;
+        begin
+            #1;
+            if ((^ref_dut.state_nxt === 1'bx) || (ref_dut.state_nxt == 0) ||
+                ((ref_dut.state_nxt & (ref_dut.state_nxt - 14'd1)) != 0))
+                $fatal(1, "Non-one-hot next state for %h mask %h: %h", current_state, mask, ref_dut.state_nxt);
+            if (trial_dut.state_nxt !== ref_dut.state_nxt)
+                $fatal(1, "Different next state for %h mask %h", current_state, mask);
+            reached = reached | ref_dut.state_nxt;
+            checks = checks + 1;
+        end
+    endtask
+"""]
+tb.extend(f'    reg {term} = 0;\n' for term in terms)
+tb.append('    initial begin\n')
+for term in terms:
+    for dut in ('ref_dut', 'trial_dut'):
+        tb.append(f'        force {dut}.{term} = {term};\n')
+tb.append("""
+        pulse;
+        if (ref_dut.state_ff !== 14'd1 || trial_dut.state_ff !== 14'd1 ||
+            ref_dut.o_live_trust !== 1'b1 || trial_dut.o_live_trust !== 1'b1)
+            $fatal(1, "Cold reset failed");
+        reset = 0;
+        force ref_dut.state_ff = current_state;
+        force trial_dut.state_ff = current_state;
+""")
+for state, state_terms in states.items():
+    tb.extend((f'        current_state = 14\'d{1 << indices[state]};\n',
+               '        reached = 0;\n',
+               f'        for (mask = 0; mask < {1 << len(state_terms)}; mask = mask + 1) begin\n'))
+    tb.extend(f'            {term} = mask[{index}];\n' for index, term in enumerate(state_terms))
+    tb.append('            check_next_state;\n        end\n')
+    tb.extend(f'        {term} = 0;\n' for term in state_terms)
+    tb.append(f'        $display("TRANSITION {state} controls={1 << len(state_terms)} successors=%h", reached);\n')
+tb.append("""
+        current_state = 14'd1;
+        force ref_dut.state_nxt = hypothetical_next;
+        force trial_dut.state_nxt = hypothetical_next;
+        for (state = 0; state < 14; state = state + 1) begin
+            hypothetical_next = 14'd1 << state;
+            for (mask = 0; mask < 32; mask = mask + 1) begin
+""")
+tb.extend(f'                {term} = mask[{index}];\n' for index, term in enumerate(trust_terms))
+tb.append("""
+                #1;
+                if (ref_dut.hum_slot_nxt && !ref_dut.fill_busy_nxt)
+                    $fatal(1, "Hit-under-miss slot without a fill");
+                if (hypothetical_next[0] && ref_dut.fill_busy_nxt)
+                    $fatal(1, "Next IDLE overlapping a fill");
+                expected = (hypothetical_next[0] || ref_dut.hum_slot_nxt) &&
+                           !(o_fill_busy && !ref_dut.fill_busy_nxt);
+                pulse;
+                if (ref_dut.o_live_trust !== expected || trial_dut.o_live_trust !== expected)
+                    $fatal(1, "Trust sample differed for state %0d controls %h", state, mask);
+                trust_checks = trust_checks + 1;
+            end
+        end
+        release ref_dut.state_ff;
+        release trial_dut.state_ff;
+        reset = 1;
+        pulse;
+        if (ref_dut.state_ff !== 14'd1 || trial_dut.state_ff !== 14'd1 ||
+            ref_dut.o_live_trust !== 1'b1 || trial_dut.o_live_trust !== 1'b1)
+            $fatal(1, "Warm reset failed");
+        $display("PASS next_state_cases=%0d trust_clock_cases=%0d resets=2", checks, trust_checks);
+        $finish;
+    end
+endmodule
+""")
+(work / 'tb.sv').write_text(''.join(tb))
diff --git a/scratch/v5-fit-loop/dcache-live-trust/routes.py b/scratch/v5-fit-loop/dcache-live-trust/routes.py
new file mode 100644
index 0000000..2fabf9e
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-live-trust/routes.py
