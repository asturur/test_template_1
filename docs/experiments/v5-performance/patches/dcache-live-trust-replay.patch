+"""Count retained D-cache live-trust endpoints in the independent setup exports."""
+import csv
+import json
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+report = json.loads(Path('docs/evidence/v5-104-retained-sweep.json').read_text())
+rows = []
+for control in sorted(report['ranked'], key=lambda row:row['seed']):
+    run, seed = control['run'], control['seed']
+    base = Path(f'build/timing-audit-{run}/output_files/timing')
+    corners = sorted((base / 'resident-store/104').glob('corner-*/setup.csv'))
+    assert len(corners) == 4, base
+    for csv_path in corners:
+        with csv_path.open() as handle:
+            paths = list(csv.DictReader(handle))
+        assert len(paths) == 1000, csv_path
+        corner = re.search(r'^display_name: (.+)$',
+                           (csv_path.parent / 'operating-condition.txt').read_text(), re.MULTILINE)[1]
+        for path in paths:
+            if '|ngage2_zap_dcache_fsm:u_zap_cache_fsm|o_live_trust' in path['to']:
+                rows.append({'seed': seed, 'run': run, 'corner': corner, **path})
+
+for row in rows:
+    print(row['seed'], row['corner'], row['rank'], row['slack_ns'], row['from'].rsplit('|', 1)[-1])
+(stage / 'retained-trust-routes.json').write_text(json.dumps({
+    'scope': 'Ten retained seeds, four top-1000 setup path exports per seed',
+    'source': report['source'],
+    'paths': rows,
+}, indent=2)+'\n')
