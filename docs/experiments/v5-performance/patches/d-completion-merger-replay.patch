@@ -0,0 +1,181 @@
+"""Seal the prepared D-cache beat and exact production replays."""
+import argparse
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+
+
+parser = argparse.ArgumentParser()
+parser.add_argument('configuration', choices=('standalone', 'stacked'))
+args = parser.parse_args()
+area = Path(__file__).resolve().parent
+stacked = args.configuration == 'stacked'
+trial = area.parent / ('d-completion-w-prepare' if stacked else 'd-completion-merger')
+base_out = Path('build/sim') / ('v5-104-w-completion-prepare' if stacked else 'v5-104-refill-payload-combined')
+out = Path('build/sim') / f'v5-104-{trial.name}'
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+paths = [rtl, generator]
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def match(trial, control):
+    assert trial.read_bytes() == control.read_bytes(), (trial, control)
+    return digest(trial)
+
+
+def fingerprint(manifest, path):
+    [row] = [shlex.split(line) for line in manifest.read_text().splitlines()
+             if line.startswith('S ') and shlex.split(line)[-1].endswith(path)]
+    return row[-2]
+
+
+def observed(path):
+    lines = path.read_text().splitlines()
+    assert lines.count('CCH_PREP enabled=1') == 1, path
+    [coverage] = [line for line in lines if line.startswith('CCH_PREP clean_hold=')]
+    counts = {name: int(value) for name, value in re.findall(r'(\w+)=(\d+)', coverage)}
+    assert len(counts) == 10
+    return counts
+
+
+def modules(source):
+    return {match[1]: match[0] for match in re.finditer(rb'^module (\w+) .*?^endmodule', source, re.M | re.S)}
+
+
+prepare = load(area / 'followup-20261126/prepare.json')
+label = 'd-beat-on-w' if stacked else 'd-beat-on-two-cut'
+lineage = prepare['variants'][label]
+staging = load(area / 'staged-source.json')
+w_proof = load(area.parent / 'w-completion-prepare/qualification.json')
+expected_before = w_proof['source_sha256'] if stacked else staging['reference_sha256']
+for path in paths:
+    assert digest(trial / 'source' / path) == lineage['sha256_from_two_cut'][path]
+    assert digest(trial / 'reference' / path) == expected_before[path]
+old_modules, new_modules = [modules((trial / leg / rtl).read_bytes()) for leg in ('reference', 'source')]
+assert old_modules.keys() == new_modules.keys()
+assert {name for name in old_modules if old_modules[name] != new_modules[name]} == {
+    b'ngage2_zap_dcache_fsm', b'ngage2_zap_dcache', b'ngage2_zap_top',
+}
+hinted = match(trial / 'hinted/source' / rtl, trial / 'hinted/reference' / rtl)
+assert b'PREPARE_BEAT' not in (trial / 'hinted/source' / rtl).read_bytes()
+
+geometry = (out / 'arithmetic.log').read_text().strip()
+assert geometry == 'PASS prepared clean/fetch register geometry checks=61440'
+error_log = out / 'beat-errors/replay.log'
+[errors] = [line for line in error_log.read_text().splitlines() if line.startswith('PASS ')]
+assert errors.startswith('PASS clean_acks=8 clean_errors=7 fetch_acks=24 fetch_errors=8 late_errors=12 comparisons=')
+
+boards = {}
+for phase in ('normal', 'abort_alignment'):
+    suite = {}
+    for burst in (0, 1):
+        for wait in (0, 5):
+            profile = f'burst-{burst}-wait-{wait}.trace'
+            if phase == 'normal':
+                ref = out / 'board/reference' / profile
+                trial_path = out / 'board/source' / profile
+            else:
+                ref = out / 'board/trusted-waw' / f'reference-{profile}'
+                trial_path = out / 'board/trusted-waw' / f'source-{profile}'
+            data = trial_path.read_text()
+            assert 'swp_beats=2 clean_writes=1 walks=2 prefetch_aborts=1' in data
+            suite[profile] = {'trace_sha256': match(trial_path, ref),
+                              'coverage': observed(trial_path.with_suffix('.log')),
+                              'cycles': int(re.search(r'^PASS cycles=(\d+)', data, re.M)[1])}
+    boards[phase] = suite
+
+for mode in ('word', 'block'):
+    suite = {}
+    for profile in ('burst0-wait0', 'burst0-wait5', 'burst1-wait0', 'burst1-wait5', 'reset'):
+        ref = out / 'wb-data' / f'{mode}-reference-{profile}.trace'
+        trial_path = out / 'wb-data' / f'{mode}-candidate-{profile}.trace'
+        coverage = observed(trial_path.with_suffix('.log'))
+        assert coverage['clean_advance'] and coverage['clean_end'] and coverage['clean_hold']
+        assert bool(coverage['native_end']) == (mode == 'block')
+        assert coverage['resets'] == int(profile == 'reset')
+        [data] = [line for line in trial_path.read_text().splitlines() if line.startswith('WB_DATA ')]
+        assert f"stalled_resets={int(profile == 'reset')}" in data
+        suite[profile] = {'trace_sha256': match(trial_path, ref), 'census': data, 'coverage': coverage}
+    boards[mode] = suite
+
+mixed = out / 'mixed'
+manifest = load(mixed / 'source-hashes.json')
+original = load(base_out / 'mixed/source-hashes.json')
+assert manifest.keys() == original.keys() and len(manifest) == 114
+assert {name: value for name, value in manifest.items()
+        if value != original[name]} == {rtl: lineage['sha256_from_two_cut'][rtl]}
+assert all(digest(mixed / 'source' / name) == sha for name, sha in manifest.items())
+compiled = fingerprint(mixed / 'obj/Vtb__verFiles.dat', rtl)
+assert fingerprint(out / 'board/source/obj/Vcontract__verFiles.dat', rtl) == compiled
+assert fingerprint(out / 'board/reference/obj/Vcontract__verFiles.dat', rtl) != compiled
+assert fingerprint(out / 'hold/trial-obj/Vtb__verFiles.dat', rtl) == compiled
+for mode in ('word', 'block'):
+    assert fingerprint(out / f'wb-data/{mode}-candidate-obj/Vcontract__verFiles.dat', rtl) == compiled
+
+physical = {}
+for label, name, control, count, cycles in (
+    ('normal', 'mixed/traffic.log', base_out / 'mixed/traffic.log', 171496, 1201547),
+    ('timer_mmc_lcd', 'coexistence/candidate.trace', base_out / 'coexistence/candidate.trace', 171497, 1201528),
+    ('cpu_block_eviction', 'block-guest/source.trace', base_out / 'block-guest/source.trace', 172060, 1204706),
+    ('warm_hold', 'hold/trial.trace', out / 'hold/reference.trace', 171518, 1203504),
+):
+    trace = out / name
+    log = mixed / 'replay.log' if label == 'normal' else trace.with_suffix('.log')
+    assert len(trace.read_bytes().splitlines()) == count
+    assert f'persisted512bytes+PIOreadback cycles={cycles}' in log.read_text()
+    physical[label] = {'events': count, 'clocks': cycles, 'sha256': match(trace, control), 'coverage': observed(log)}
+assert match(out / 'hold/reference.pass', out / 'hold/trial.pass')
+assert physical['warm_hold']['sha256'] == load(area.parent / 'upp-claim-refill-payload/qualification.json')['physical']['warm_hold']['trace_sha256']
+assert physical['cpu_block_eviction']['coverage']['native_end'] == 1
+
+workloads = {}
+for kind, field, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    result, old = [load(path) for path in (receipt, base_out / f'qualification/{kind}.json')]
+    assert result['status'] == old['status'] == 'PASS' and result['rows'] == old['rows']
+    assert result['netlist_sha256'] == lineage['sha256_from_two_cut'][rtl] and old['netlist_sha256'] == expected_before[rtl]
+    assert result['wrapper_sha256'] == old['wrapper_sha256'] and result['source_sha256'] == old['source_sha256']
+    copied = out / f'qualification/{kind}-candidate-cpu.v'
+    assert digest(copied) == result['netlist_sha256']
+    assert fingerprint(out / f'qualification/obj-{kind}/Vtb__verFiles.dat', f'/work/{copied.name}') == compiled
+    assert sum(len(row['candidate'][field]) for row in result['rows']) == count
+    workloads[kind] = {'count': count, 'receipt_sha256': digest(receipt), 'coverage': {}}
+    for row in result['rows']:
+        case = row['candidate']['case']
+        workloads[kind]['coverage'][case] = observed(out / f'qualification/{case}-00-0.log')
+        if kind == 'fixed':
+            assert observed(out / f'qualification/{case}-00-1.log') == workloads[kind]['coverage'][case]
+            assert 'Guest output check rejected payload' in (out / f'qualification/{case}-00-0-wrong.log').read_text()
+    if kind == 'fixed':
+        assert len(workloads[kind]['coverage']) == 15
+        workloads[kind].update(repeated=15, wrong_output_checks=15)
+    else:
+        native = result['rows'][0]['candidate']
+        frame_cycles = [x['clocks'] for x in native['frames']]
+        assert frame_cycles == [14391395, 14467552, 14346201, 14303223]
+        workloads[kind].update(frame_cycles=frame_cycles, output_sha256=native['output_sha256'])
+
+private = area / 'followup-20261126'
+stack_patch = private / 'd-beat-on-w.patch'
+replay_patch = area / 'd-completion-merger-replay.patch'
+summary = {'status': 'PASS', 'production_prepare_beat': True, 'candidate': lineage['sha'], 'base': lineage['parent'],
+           'tree': lineage['tree'], 'design_patch_sha256': digest(stack_patch if stacked else area / 'd-completion-merger.patch'),
+           'replay_patch_sha256': digest(replay_patch), 'reference_sha256': expected_before,
+           'source_sha256': lineage['sha256_from_two_cut'], 'unchanged_hinted_ldm_sha256': hinted,
+           'numeric_checks': geometry, 'paired_cch_error_edges': errors, 'boards': boards, 'workloads': workloads,
+           'physical': physical, 'mixed_source_count': len(manifest), 'compiled_cpu_fingerprint': compiled,
+           'simulator_image': (out / 'image.id').read_text().strip(),
+           'routes_sha256': digest(area / 'routes.json'), 'production_preflight': lineage['production'],
+           'candidate_routed': False}
+(trial / 'qualification.json').write_text(json.dumps(summary, indent=2) + '\n')
+print(f'PASS {args.configuration} active prepared D-cache beat directed, workloads and physical pin replay')
diff --git a/scratch/v5-fit-loop/d-completion-merger/prepare-fit.py b/scratch/v5-fit-loop/d-completion-merger/prepare-fit.py
new file mode 100644
index 0000000..fe1c992
--- /dev/null
+++ b/scratch/v5-fit-loop/d-completion-merger/prepare-fit.py
@@ -0,0 +1,241 @@
+"""Prepare both private prepared D-cache beat histories and verify the production source manifests."""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+w_area = area.parent / 'w-completion-prepare'
+prior = area.parent / 'w-completion-upp/dispatch-20261126'
+private = area / 'followup-20261126'
+objects = private / 'objects'
+objects.mkdir(parents=True, exist_ok=True)
+combined = area.parent / 'd-completion-w-prepare'
+base = 'ab75a622a80a5aedae347f63ae195f3da965815a'
+public_w = 'e2249e46c0bd47ab85539cff9416a51214c1ea05'
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+changed = [rtl, generator]
+design = area / 'd-completion-merger.patch'
+
+
+def sha(data):
+    return sha256(data).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+alternates = os.pathsep.join(dict.fromkeys(
+    [str(prior / 'objects'), *(prior / 'alternate-objects.txt').read_text().strip().split(os.pathsep)]))
+assert all(Path(path).is_absolute() and Path(path).is_dir() for path in alternates.split(os.pathsep))
+(private / 'alternate-objects.txt').write_text(alternates + '\n')
+
+
+def env_for(label):
+    return os.environ | {'GIT_OBJECT_DIRECTORY': str(objects), 'GIT_ALTERNATE_OBJECT_DIRECTORIES': alternates,
+                         'GIT_INDEX_FILE': str(private / f'index-{label}')}
+
+
+def git(*args, env, data=None):
+    return subprocess.check_output(['git', '-C', str(root), *args], env=env, input=data)
+
+
+def revision(value, env):
+    return git('rev-parse', value, env=env).decode().strip()
+
+
+def tree(value, env):
+    return revision(f'{value}^{{tree}}', env)
+
+
+def files(before, after, env):
+    return git('diff', '--name-only', before, after, env=env).decode().splitlines()
+
+
+def blob(rev, path, env):
+    return git('show', f'{rev}:{path}', env=env)
+
+
+def commit(tree_id, parent, message, env):
+    timestamp = int(git('show', '-s', '--format=%ct', parent, env=env)) + 1
+    date = f'@{timestamp} +0000'
+    result = git('commit-tree', tree_id, '-p', parent, '-m', message,
+                 env=env | {'GIT_AUTHOR_DATE': date, 'GIT_COMMITTER_DATE': date}).decode().strip()
+    assert revision(f'{result}^', env) == parent and tree(result, env) == tree_id
+    return result
+
+
+def modules(source):
+    return {match[1]: match[0] for match in re.finditer(rb'^module (\w+) .*?^endmodule', source, re.M | re.S)}
+
+
+def replace_once(text, old, new):
+    assert text.count(old) == 1, old
+    return text.replace(old, new, 1)
+
+
+def combine_generator(base_blob, d_source, w_source):
+    d_function = re.search(rb'^def prepare_data_cache_beats\(phone\):.*?(?=^def )', d_source, re.M | re.S)[0]
+    w_function = re.search(rb'^def prepare_w_completion\(phone\):.*?(?=^def )', w_source, re.M | re.S)[0]
+    d_call = b'    if not args.hinted_ldm:\n        generated = prepare_data_cache_beats(generated)\n'
+    w_call = b'    else:\n        generated = prepare_w_completion(generated)\n'
+    assert replace_once(replace_once(d_source, d_function, b''), d_call, b'') == base_blob
+    assert replace_once(replace_once(w_source, w_function, b''), w_call, b'') == base_blob
+    anchor = b'    generated = prepare_wishbone_write_data(generated)\n'
+    merged = replace_once(replace_once(w_source, b'def main():', d_function + b'def main():'),
+                          anchor, anchor + d_call)
+    assert replace_once(replace_once(merged, w_function, b''), w_call, b'') == d_source
+    return merged
+
+
+proof = load(area / 'staged-source.json')
+w_proof = load(w_area / 'qualification.json')
+dispatch = load(prior / 'dispatch.json')
+assert proof['status'] == 'STAGED' and w_proof['status'] == 'PASS' and proof['base'] == w_proof['base'] == base
+assert dispatch['candidate'] == public_w == (prior / 'published.sha').read_text().strip()
+assert sha(design.read_bytes()) == proof['design_patch_sha256']
+common = env_for('verify')
+assert tree(base, common) == proof['base_tree']
+assert tree(public_w, common) == w_proof['candidate_tree'] == dispatch['tree']
+assert tree(revision(f'{public_w}^', common), common) == proof['base_tree']
+assert files(base, public_w, common) == changed
+for path in changed:
+    assert sha(blob(base, path, common)) == proof['reference_sha256'][path] == w_proof['reference_sha256'][path]
+    assert sha(blob(public_w, path, common)) == w_proof['source_sha256'][path]
+
+restore = commit(proof['base_tree'], public_w, 'revert: restore the measured two-cut RTL', common)
+assert files(public_w, restore, common) == changed and not files(base, restore, common)
+(private / 'restore.sha').write_text(restore + '\n')
+variants = {}
+for label, parent in (('d-beat-on-two-cut', restore), ('d-beat-on-w', public_w)):
+    env = env_for(label)
+    git('read-tree', parent, env=env)
+    if parent == restore:
+        git('apply', '--cached', '--check', str(design), env=env)
+        git('apply', '--cached', str(design), env=env)
+    else:
+        git('apply', '--cached', '--check', f'--include={rtl}', str(design), env=env)
+        git('apply', '--cached', f'--include={rtl}', str(design), env=env)
+        d_generator = (area / 'source' / generator).read_bytes()
+        assert sha(d_generator) == proof['source_sha256'][generator]
+        merged = combine_generator(blob(base, generator, env), d_generator, blob(public_w, generator, env))
+        digest = git('hash-object', '-w', '--stdin', env=env, data=merged).decode().strip()
+        git('update-index', '--cacheinfo', f'100755,{digest},{generator}', env=env)
+    candidate_tree = git('write-tree', env=env).decode().strip()
+    if parent == restore:
+        assert candidate_tree == proof['candidate_tree']
+    candidate = commit(candidate_tree, parent, 'perf(cpu): prepare D-cache Wishbone beat boundaries', env)
+    assert files(parent, candidate, env) == changed
+    assert files(base, candidate, env) == changed
+    git('diff', '--check', parent, candidate, env=env)
+    git('merge-base', '--is-ancestor', public_w, candidate, env=env)
+    assert blob(candidate, '.github/workflows/ci_build.yml', env) == blob(base, '.github/workflows/ci_build.yml', env)
+    exact = {path: sha(blob(candidate, path, env)) for path in changed}
+    if parent == restore:
+        assert exact == proof['source_sha256']
+    else:
+        d_rtl = (area / 'source' / rtl).read_bytes()
+        assert sha(d_rtl) == proof['source_sha256'][rtl]
+        original, w_edit, d_edit, both = map(modules, (blob(base, rtl, env), blob(public_w, rtl, env),
+                                                    d_rtl, blob(candidate, rtl, env)))
+        assert original.keys() == w_edit.keys() == d_edit.keys() == both.keys()
+        w_changed = {name for name in original if original[name] != w_edit[name]}
+        d_changed = {name for name in original if original[name] != d_edit[name]}
+        assert w_changed == {b'ngage2_arm9v2_core'}
+        assert d_changed == {b'ngage2_zap_dcache', b'ngage2_zap_dcache_fsm', b'ngage2_zap_top'}
+        for name in original:
+            assert both[name] == (d_edit[name] if name in d_changed else w_edit[name]), name
+        (private / 'd-beat-on-w.patch').write_bytes(git('diff', '--binary', parent, candidate, env=env))
+        for leg, rev in (('reference', parent), ('source', candidate)):
+            target = combined / leg
+            target.mkdir(parents=True, exist_ok=True)
+            archive = git('archive', rev, 'Template.sv', 'rtl', 'tools', 'files.qip',
+                          '.rules.verible_format', 'tests', 'sim/programs/link.ld', env=env)
+            subprocess.run(['tar', '-x', '-C', str(target)], check=True, input=archive)
+        (combined / 'ngage_cpu.sv').write_bytes((combined / 'source/rtl/ngage_cpu.sv').read_bytes())
+    (private / f'{label}.sha').write_text(candidate + '\n')
+    variants[label] = {'sha': candidate, 'parent': parent, 'tree': candidate_tree,
+                       'paths_since_parent': changed, 'sha256_from_two_cut': exact, 'production': {}}
+
+tools = ('set_quartus_seed', 'set_quartus_debug', 'record_fit_inputs')
+for label, variant in variants.items():
+    env = env_for(label)
+    candidate = variant['sha']
+    for seed, upstream in dispatch['runs'].items():
+        base_run = upstream['control_run']
+        base_dir = root / f'build/timing-audit-{base_run}/output_files'
+        control = load(base_dir / 'resident-fit-manifest.json')
+        assert control['actual_commit'] == base
+        original = control
+        run = base_run
+        origin = 'routed two-cut control'
+        if label == 'd-beat-on-w':
+            run = upstream['id']
+            path = root / f'build/timing-audit-{run}/output_files/resident-fit-manifest.json'
+            origin = 'routed W control'
+            if not path.is_file():
+                origin = 'sealed W control preflight'
+                path = prior / f'preflight/w-on-two-cut/{seed}/output_files/resident-fit-manifest.json'
+                assert sha(path.read_bytes()) == upstream['candidate_preflight_manifest_sha256']
+            control = load(path)
+            assert control['actual_commit'] == public_w
+            control_inputs = control['compiled_source_sha256']
+            assert control_inputs.keys() == original['compiled_source_sha256'].keys()
+            assert {name: value for name, value in control_inputs.items()
+                    if value != original['compiled_source_sha256'][name]} == {rtl: w_proof['source_sha256'][rtl]}
+        selected = control['compiled_source_sha256']
+        assert int(seed) == control['seed'] and control['physical_cpu_mhz'] == 104 and control['debugger'] is False
+        assert len(selected) == 133 and generator not in selected
+        run_dir = private / 'preflight' / label / seed
+        outputs = run_dir / 'output_files'
+        outputs.mkdir(parents=True, exist_ok=True)
+        graph = (base_dir / 'source-graph.txt').read_text()
+        assert {line.removeprefix('SOURCE /project/') for line in graph.splitlines()
+                if line.startswith('SOURCE ')} == selected.keys()
+        (outputs / 'source-graph.txt').write_text(graph)
+        for name in (*selected, *(f'tools/{tool}.py' for tool in tools)):
+            assert not Path(name).is_absolute() and '..' not in Path(name).parts
+            target = run_dir / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(blob(candidate, name, env))
+        local = os.environ | {'GITHUB_SHA': candidate}
+        for name in ('GITHUB_STEP_SUMMARY', 'GITHUB_RUN_ID'):
+            local.pop(name, None)
+        for tool, *arguments in (('set_quartus_seed', 'Template.qsf', '--seed', seed),
+                                  ('set_quartus_debug', 'Template.qsf', '--enabled', 'false')):
+            subprocess.run(['python3', '-B', f'tools/{tool}.py', *arguments],
+                           cwd=run_dir, env=local, check=True, stdout=subprocess.PIPE)
+        qsf = run_dir / 'Template.qsf'
+        qsf.write_bytes(qsf.read_bytes().replace(b'LAST_QUARTUS_VERSION "17.0.2 Standard Edition"\r\n',
+                                                 b'LAST_QUARTUS_VERSION "17.0.2 Lite Edition"\n'))
+        subprocess.run(['python3', '-B', 'tools/record_fit_inputs.py'],
+                       cwd=run_dir, env=local, check=True, stdout=subprocess.PIPE)
+        preflight = outputs / 'resident-fit-manifest.json'
+        actual = load(preflight)
+        assert actual['actual_commit'] == candidate
+        inputs = actual['compiled_source_sha256']
+        assert inputs.keys() == selected.keys()
+        delta = {name: value for name, value in inputs.items() if value != selected[name]}
+        assert delta == {rtl: variant['sha256_from_two_cut'][rtl]}
+        assert all(actual[key] == control[key]
+                   for key in control.keys() - {'actual_commit', 'compiled_source_sha256', 'github_run_id'})
+        variant['production'][seed] = {'control_run': run, 'control_origin': origin, 'mhz': actual['physical_cpu_mhz'],
+                                       'debugger': actual['debugger'], 'source_count': len(inputs),
+                                       'delta': delta, 'manifest_sha256': sha(preflight.read_bytes())}
+        print(f'PASS {label} seed {seed} at 104 MHz DDR debug off, exact 133-input manifest', flush=True)
+
+receipt = {'status': 'PASS', 'production_qualified': 'preflight', 'two_cut': base, 'public_parent': public_w, 'restore': restore,
+           'private_objects': str(objects), 'alternate_objects': alternates,
+           'staged_source_sha256': sha((area / 'staged-source.json').read_bytes()),
+           'design_patch_sha256': sha(design.read_bytes()), 'stack_patch_sha256': sha((private / 'd-beat-on-w.patch').read_bytes()),
+           'variants': variants}
+(private / 'prepare.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print('Restore', restore)
+for label, value in variants.items():
+    print(label, value['sha'], value['tree'])
