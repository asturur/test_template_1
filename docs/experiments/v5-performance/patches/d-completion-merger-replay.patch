@@ -0,0 +1,59 @@
+module prepared_d_cache_observer (
+    input wire clk,
+    input wire reset,
+    input wire enabled,
+    input wire clean,
+    input wire fetch,
+    input wire take,
+    input wire native_write,
+    input wire error_reply,
+    input wire strobe_before,
+    input wire strobe_after
+);
+    integer clean_hold = 0;
+    integer clean_advance = 0;
+    integer clean_end = 0;
+    integer native_advance = 0;
+    integer native_end = 0;
+    integer fetch_hold = 0;
+    integer fetch_advance = 0;
+    integer fetch_end = 0;
+    integer ack_errors = 0;
+    integer active_resets = 0;
+    initial begin
+        if (!enabled) $fatal(1, "D-cache beat preparation must be active");
+        $display("CCH_PREP enabled=1");
+    end
+    always @(posedge clk) begin
+        if (reset && (clean || fetch)) active_resets <= active_resets + 1;
+        if (!reset && clean && strobe_before) begin
+            if (!take && strobe_after) clean_hold <= clean_hold + 1;
+            if (take && strobe_after) begin
+                clean_advance <= clean_advance + 1;
+                if (native_write) native_advance <= native_advance + 1;
+            end
+            if (take && !strobe_after) begin
+                clean_end <= clean_end + 1;
+                if (native_write) native_end <= native_end + 1;
+            end
+        end
+        if (!reset && fetch && strobe_before) begin
+            if (!take && strobe_after) fetch_hold <= fetch_hold + 1;
+            if (take && strobe_after) fetch_advance <= fetch_advance + 1;
+            if (take && !strobe_after) fetch_end <= fetch_end + 1;
+        end
+        if (!reset && (clean || fetch) && take && error_reply)
+            ack_errors <= ack_errors + 1;
+    end
+    final
+        $display("CCH_PREP clean_hold=%0d clean_advance=%0d clean_end=%0d native_advance=%0d native_end=%0d fetch_hold=%0d fetch_advance=%0d fetch_end=%0d errors=%0d resets=%0d",
+                 clean_hold, clean_advance, clean_end, native_advance, native_end, fetch_hold,
+                 fetch_advance, fetch_end, ack_errors, active_resets);
+endmodule
+
+bind ngage2_zap_dcache_fsm prepared_d_cache_observer test_prepared_beat (
+    .clk(i_clk), .reset(i_reset), .enabled(PREPARE_BEAT != 0),
+    .clean(state_ff[CLEAN_SINGLE]), .fetch(state_ff[FETCH_SINGLE]),
+    .take(take), .native_write(block_beat), .error_reply(i_wb_err),
+    .strobe_before(o_wb_stb_ff), .strobe_after(o_wb_stb_nxt)
+);
diff --git a/scratch/v5-fit-loop/d-completion-merger/beat-errors.sv b/scratch/v5-fit-loop/d-completion-merger/beat-errors.sv
new file mode 100644
index 0000000..0628cd9
--- /dev/null
+++ b/scratch/v5-fit-loop/d-completion-merger/beat-errors.sv
@@ -0,0 +1,135 @@
+`timescale 1ns/1ps
+module prepared_cch_errors;
+    reg clk = 0;
+    reg reset = 1;
+    reg read_request = 0;
+    reg ack = 0;
+    reg err = 0;
+    reg block_enable = 0;
+    reg [31:0] address = 0;
+    reg [1:0] dirty_halves = 0;
+    wire [45:0] cache_tag = {address[31:5], 19'b0};
+    integer clean_acks = 0, clean_errors = 0, fetch_acks = 0, fetch_errors = 0;
+    integer late_errors = 0, comparisons = 0;
+
+`define CCH_PORTS \
+        .i_clk(clk), .i_reset(reset), .i_rd(read_request), .i_wr(1'b0), \
+        .i_address(address), .i_address_check(address), .i_phy_addr(address), \
+        .i_va(address), .i_cache_en(1'b1), .i_cacheable(1'b1), \
+        .i_cache_tag_valid(1'b1), .i_cache_tag_dirty(1'b1), .i_cache_tag(cache_tag), \
+        .i_cache_victim_halves(dirty_halves), .i_cache_hit(1'b0), .i_hit_ok(1'b1), \
+        .i_cache_line(256'h99112233_a4556677_88888888_f9999999_dd999999_ee883377_cc337788_88552233), \
+        .i_ben(4'hf), .i_reg_idx(64'h8), .i_reg_idx_bin(6'd3), \
+        .i_block_enable(block_enable), .i_wb_ack(ack), .i_wb_err(err), \
+        .i_wb_dat(32'h1122_3344)
+    reference_cch #(.CACHE_SIZE(16384), .WAYS(2), .CACHE_LINE(32), .HALF_WRITEBACK(1)) old_dut (
+        `CCH_PORTS
+    );
+    ngage2_zap_dcache_fsm #(.CACHE_SIZE(16384), .WAYS(2), .CACHE_LINE(32), .HALF_WRITEBACK(1), .PREPARE_BEAT(1)) new_dut (
+        `CCH_PORTS
+    );
+`undef CCH_PORTS
+
+    task compare;
+        begin
+            comparisons++;
+            if ({old_dut.state_ff, old_dut.state_nxt, old_dut.adr_ctr_ff, old_dut.adr_ctr_nxt,
+                 old_dut.o_wb_cyc_nxt, old_dut.o_wb_stb_nxt, old_dut.o_wb_adr_nxt, old_dut.o_wb_sel_nxt,
+                 old_dut.o_wb_dat_nxt, old_dut.o_wb_wen_nxt, old_dut.o_wb_cti_nxt,
+                 old_dut.o_wb_cyc_ff, old_dut.o_wb_stb_ff, old_dut.o_wb_adr_ff, old_dut.o_wb_sel_ff,
+                 old_dut.o_wb_dat_ff, old_dut.o_wb_wen_ff, old_dut.o_wb_cti_ff,
+                 old_dut.o_fill_busy_nxt, old_dut.o_writeback_busy, old_dut.o_wb_line_candidate_nxt,
+                 old_dut.o_ack, old_dut.o_err, old_dut.o_err2}
+                !==
+                {new_dut.state_ff, new_dut.state_nxt, new_dut.adr_ctr_ff, new_dut.adr_ctr_nxt,
+                 new_dut.o_wb_cyc_nxt, new_dut.o_wb_stb_nxt, new_dut.o_wb_adr_nxt, new_dut.o_wb_sel_nxt,
+                 new_dut.o_wb_dat_nxt, new_dut.o_wb_wen_nxt, new_dut.o_wb_cti_nxt,
+                 new_dut.o_wb_cyc_ff, new_dut.o_wb_stb_ff, new_dut.o_wb_adr_ff, new_dut.o_wb_sel_ff,
+                 new_dut.o_wb_dat_ff, new_dut.o_wb_wen_ff, new_dut.o_wb_cti_ff,
+                 new_dut.o_fill_busy_nxt, new_dut.o_writeback_busy, new_dut.o_wb_line_candidate_nxt,
+                 new_dut.o_ack, new_dut.o_err, new_dut.o_err2})
+                $fatal(1, "CCH comparison differs on edge %0d", comparisons);
+        end
+    endtask
+
+    task pulse;
+        begin
+            #4 compare();
+            #1 clk = 1;
+            #4 compare();
+            #1 clk = 0;
+        end
+    endtask
+
+    task late_error;
+        begin
+            ack = 0;
+            err = 1;
+            #1;
+            if (old_dut.take || new_dut.take) $fatal(1, "Late error found an unowned beat");
+            late_errors++;
+            pulse();
+            err = 0;
+        end
+    endtask
+
+    task exercise(input use_block, input [31:0] base, input [1:0] mask);
+        integer beat, clean_count;
+        begin
+            reset = 1;
+            read_request = 0;
+            address = base;
+            block_enable = use_block;
+            dirty_halves = mask;
+            pulse();
+            reset = 0;
+            read_request = 1;
+            pulse();
+            read_request = 0;
+            if (!new_dut.state_ff[new_dut.CLEAN_SINGLE] || new_dut.o_wb_stb_ff)
+                $fatal(1, "Entry into unissued dirty writeback was missed");
+            late_error();
+            clean_count = (mask == 2'b11 ? 2 : 1) * (use_block ? 1 : 4);
+            for (beat = 0; beat < clean_count; beat = beat + 1) begin
+                if (!new_dut.o_wb_stb_ff || !new_dut.o_wb_wen_ff)
+                    $fatal(1, "Expected held clean beat %0d", beat);
+                pulse(); // Confirm the same packet survives a stalled clock.
+                err = beat == 0 || beat == clean_count - 1;
+                ack = !err;
+                if (err) clean_errors++; else clean_acks++;
+                pulse();
+                err = 0;
+                ack = 0;
+            end
+            if (!new_dut.state_ff[new_dut.FETCH_SINGLE] || new_dut.o_wb_stb_ff)
+                $fatal(1, "Clean completion failed to enter a fresh fill");
+            late_error();
+            for (beat = 0; beat < 8; beat = beat + 1) begin
+                if (!new_dut.o_wb_stb_ff || new_dut.o_wb_wen_ff)
+                    $fatal(1, "Expected held fetch beat %0d", beat);
+                pulse();
+                err = beat == 3 || beat == 7;
+                ack = !err;
+                if (err) fetch_errors++; else fetch_acks++;
+                pulse();
+                err = 0;
+                ack = 0;
+            end
+            if (!new_dut.state_ff[new_dut.UNLOCK_REG] || new_dut.o_wb_stb_ff)
+                $fatal(1, "Fill completion did not release the bus");
+            late_error();
+        end
+    endtask
+
+    initial begin
+        exercise(0, 32'h0a00_3000, 2'b11);
+        exercise(0, 32'h0aff_ffe0, 2'b10);
+        exercise(1, 32'h0a00_3000, 2'b11);
+        exercise(1, 32'h0aff_ffe0, 2'b10);
+        if (clean_acks != 8 || clean_errors != 7 || fetch_acks != 24 || fetch_errors != 8 || late_errors != 12)
+            $fatal(1, "Error acceptance coverage differs");
+        $display("PASS clean_acks=%0d clean_errors=%0d fetch_acks=%0d fetch_errors=%0d late_errors=%0d comparisons=%0d",
+                 clean_acks, clean_errors, fetch_acks, fetch_errors, late_errors, comparisons);
+        $finish;
+    end
+endmodule
