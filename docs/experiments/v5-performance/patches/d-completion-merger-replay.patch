+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/d-completion-merger
+both=scratch/v5-fit-loop/d-completion-w-prepare
+mkdir -p "$both" build/sim/v5-104-d-completion-w-prepare
+cp "$area/architectural_trace.vh" "$area/wb-write-trace.vh" "$area/beat-observer.sv" "$both/"
+for file in replay.py mixed.py pins.sh prepare-hold.py hold.sh board.sh board-phase.sh check-generator.sh board-write.sh prepare-eviction-reset.py; do
+    sed -e 's/d-completion-merger/d-completion-w-prepare/g' \
+        -e 's/v5-104-refill-payload-combined/v5-104-w-completion-prepare/g' "$area/$file" > "$both/$file"
+done
