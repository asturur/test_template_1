+"""Identify SDRAM ACK to cache and merger timing paths on the two-cut source."""
+import csv
+import json
+from pathlib import Path
+import re
+
+
+area = Path(__file__).resolve().parent
+base = 'ab75a622a80a5aedae347f63ae195f3da965815a'
+audit_runs = {13: 45879015397, 43: 45879019116, 31337: 45879022396}
+audit = {}
+for seed, run in audit_runs.items():
+    outputs = Path(f'build/timing-audit-{run}/output_files')
+    manifest = json.loads((outputs / 'resident-fit-manifest.json').read_bytes())
+    assert (manifest['actual_commit'], manifest['physical_cpu_mhz'], manifest['debugger'], manifest['seed']) == (
+        base, 104, False, seed)
+    corners = {}
+    for corner in sorted((outputs / 'timing/resident-store/104').glob('corner-*')):
+        with (corner / 'setup.csv').open() as csv_file:
+            paths = {int(path['rank']): path for path in csv.DictReader(csv_file)}
+        chunks = re.split(r'(?m)^Path #(\d+): Setup slack is ', (corner / 'setup.rpt').read_text(errors='replace'))
+        details = dict(zip(map(int, chunks[1::2]), chunks[2::2], strict=True))
+        assert len(paths) == 1000 and len(details) == 100
+        families = {name: [] for name in ('code_strobe', 'data_strobe', 'other')}
+        for rank, detail in details.items():
+            path = paths[rank]
+            cells = [line.split(';')[-2].strip().removesuffix('|combout')
+                     for line in detail.splitlines() if '|combout' in line and 'CELL' in line]
+            if not any(re.search(r'\|phone_sdram\|ack(?:~|$)', cell) for cell in cells):
+                continue
+            if not re.search(r'\|ngage2_zap_wb_merger:[^|]+\|o_wb_adr\[\d+\]$', path['to']):
+                continue
+            if any('u_code_cache' in cell and 'o_wb_stb_nxt' in cell for cell in cells):
+                name = 'code_strobe'
+            elif any('u_data_cache' in cell and 'o_wb_stb_nxt' in cell for cell in cells):
+                name = 'data_strobe'
+            else:
+                name = 'other'
+            assert not (name == 'code_strobe' and any('u_data_cache' in cell and 'o_wb_stb_nxt' in cell
+                                                       for cell in cells))
+            families[name].append({**path, 'cells': cells})
+        corners[corner.name] = {'total_ranked': len(paths), 'detailed': len(details), 'paths': families,
+                                'counts_below_minus_1_5': {name: sum(float(row['slack_ns']) < -1.5 for row in rows)
+                                                           for name, rows in families.items()}}
+    assert len(corners) == 4
+    audit[seed] = {'run': run, 'corners': corners}
+
+for corner, slack, start in (('corner-1', '-1.978', 'state.WRITE_LOCKED'), ('corner-2', '-1.984', 'seen')):
+    entry = audit[13]['corners'][corner]
+    assert not entry['paths']['code_strobe']
+    first = entry['paths']['data_strobe'][0]
+    assert first['rank'] == '2' and first['slack_ns'] == slack and first['from'].endswith(f'|{start}')
+    assert first['to'].endswith('|o_wb_adr[9]')
+    assert any('|u_zap_cache_fsm|take~' in cell for cell in first['cells'])
+    assert any('|u_zap_cache_fsm|o_wb_cyc_nxt~' in cell for cell in first['cells'])
+for corner, count in (('corner-1', 23), ('corner-2', 25)):
+    entry = audit[43]['corners'][corner]
+    assert entry['counts_below_minus_1_5']['code_strobe'] == count
+    first = entry['paths']['code_strobe'][0]
+    assert first['rank'] == '2' and first['to'].endswith('|o_wb_adr[15]')
+    assert any('|refill|cpu_ack~' in cell for cell in first['cells'])
+assert all(not corner['paths']['code_strobe'] for seed in (13, 31337)
+           for corner in audit[seed]['corners'].values())
+(area / 'routes.json').write_text(json.dumps({'base': base, 'seeds': audit}, indent=2) + '\n')
+print('PASS four-corner SDRAM ACK, D/I cache strobe and merger address route audit')
