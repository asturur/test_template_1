+"""Move the existing stalled-write reset to a stalled D-cache victim write."""
+from pathlib import Path
+import sys
+
+
+out = Path(sys.argv[1])
+fixture = Path(sys.argv[2])
+header = (fixture / 'wb_data_contract_observe.vh').read_text()
+needle = 'wait (ram_pending && ram_saved_write && !ram_ack && stalled);'
+assert header.count(needle) == 1
+header = header.replace(needle, 'wait (ram_pending && ram_saved_write && !ram_ack && stalled && eviction && obs_owner[0]);')
+(out / 'wb_data_contract_observe.vh').write_text(header)
+
+bench = out / 'contract.v'
+source = bench.read_text()
+reset = '      slow_delay <= 0;\n    end else begin'
+assert source.count(reset) == 1
+tests = [
+    'cycle', 'wait_words', 'scalar_faults', 'refill_faults', 'refill_words', 'clean_writes',
+    'swap_beats', 'irq_writes', 'fiq_writes', 'irq', 'fiq', 'translation_walks', 'prefetch_aborts',
+    'section_reads', 'section_checks', 'observe_sections', 'capacity_markers', 'verify_resident',
+    'line_active', 'line_reject', 'ram_lines', 'rom_lines', 'rejected_lines',
+    'assoc_phase', 'assoc_words', 'assoc_fills', 'assoc_empty_groups',
+    'write_errors', 'eviction_checks', 'native_blocks',
+]
+reboot = '''      slow_delay <= 0;
+      // This injection happens after SWP and CP15 tests have already run.
+      // Restart their peer census and the scratch RAM for the second boot.
+      if ($test$plusargs("reset-in-write")) begin
+''' + ''.join(f'        {field} <= 0;\n' for field in tests) + '''        for (integer word = 0; word < 16384; word = word + 1) ram[word] <= 0;
+      end
+    end else begin'''
+bench.write_text(source.replace(reset, reboot))
diff --git a/scratch/v5-fit-loop/d-completion-merger/check-beat-arithmetic.py b/scratch/v5-fit-loop/d-completion-merger/check-beat-arithmetic.py
