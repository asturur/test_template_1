+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import sys
+
+area = Path(__file__).resolve().parent
+repo = area.parents[1]
+workspace = area / "leg"
+frozen = repo / "build/sim/payload-clocks/v5-104-all-four-ram-candidate"
+assert (frozen / "arm925t_phone.v").read_bytes() == (workspace / "rtl/arm9v2/arm925t_phone.v").read_bytes()
+compiler = frozen / "mmc3-nos64/Vtb__verFiles.dat"
+command = next(line for line in compiler.read_text().splitlines() if line.startswith("C "))
+argv = shlex.split(command.removeprefix('C "').removesuffix('"'))
+observer = (area / "observe.vh").read_text()
+raw = (frozen / "tb.v").read_text()
+for old, new in (
+    ("        first_clock = cycles;", "        first_clock = cycles;\n        reset_next();"),
+    ("    if (first_clock >= 0) begin", "    if (first_clock >= 0 && first_clock != cycles) observe_next();\n    if (first_clock >= 0) begin"),
+    ('            $display("PAYLOAD_RESULT', '            report_next(window);\n            $display("PAYLOAD_RESULT'),
+):
+    assert raw.count(old) == 1
+    raw = raw.replace(old, new)
+(workspace / "payload.sv").write_text(raw.rsplit("endmodule", 1)[0] + observer + "\nendmodule\n")
+for index, option in enumerate(argv):
+    if option.startswith("/work/") and option.endswith("/tb.v"):
+        argv[index] = "payload.sv"
+    elif option.startswith("/work/") and option.endswith((".sv", ".v")):
+        argv[index] = option.replace("/work/", "/frozen/", 1)
+argv[argv.index("--Mdir") + 1] = "obj-payload"
+driver = ["docker", "run", "--rm", "--pull=never", "--network", "none", "--platform", "linux/arm64",
+          "-v", f"{workspace}:/work", "-v", f"{repo}:/frozen:ro", "-w", "/work", "--entrypoint"]
+image = "jotego/simulator:arm64"
+with (area / "build-payload.log").open("w") as handle:
+    subprocess.run(driver + ["verilator", image] + argv, stdout=handle, stderr=subprocess.STDOUT, check=True)
+for path in (workspace / "obj-payload").glob("*.gch"):
+    path.unlink()
+sys.path.insert(0, str(repo / "tests/cpu/arm9v2_board"))
+from payload_clocks import qualified_inputs
+ref = {r["case"]: r for r in json.loads((frozen / "result.json").read_text())["rows"]}
+kinds = ("NEXT_DEMAND", "NEXT_ADJ", "NEXT_SLOT")
+def simulate(case):
+    name = case["name"]
+    trace = f"requests-{name}.txt"
+    log = area / f"payload-{name}.log"
+    common = "+core=/frozen/" + str((frozen / f"{name}-False.bin").relative_to(repo))
+    with log.open("w") as handle:
+        subprocess.run(driver + ["/work/obj-payload/Vtb", image, "+ngage-compact-trace", "+no-board-log", common,
+            "+extension=/frozen/build/firmware/nem4-factory/extension.bin",
+            "+cdrive=/frozen/" + str((frozen / "cdrive.bin").relative_to(repo)),
+            f'+begin_pc={case["begin"]:x}', f'+end_pc={case["end"]:x}',
+            f'+payload_base={case["payload_base"]:x}', f'+helper_base={case["helper_base"]:x}',
+            "+sdram-trace=/work/" + trace], stdout=handle, stderr=subprocess.STDOUT, check=True)
+    def stats(prefix):
+        return [dict((k, int(v)) for k, v in re.findall(r"(\w+)=(-?\d+)", line))
+                for line in log.read_text().splitlines() if line.startswith(prefix + " ")]
+    assert stats("PAYLOAD_RESULT") == ref[name]["windows"] and len(stats("PAYLOAD_PASS")) == 1
+    assert (workspace / trace).read_bytes() == (frozen / f"{name}-3-64-requests.txt").read_bytes()
+    rows = {kind: stats(kind) for kind in kinds}
+    assert len(rows["NEXT_DEMAND"]) == len(rows["NEXT_ADJ"]) == 7 and len(rows["NEXT_SLOT"]) == 28
+    return name, rows
+
+with ThreadPoolExecutor(max_workers=4) as pool:
+    result = dict(pool.map(simulate, qualified_inputs()))
+assert result.keys() == ref.keys() and len(result) == 15
+(area / "payload.json").write_text(json.dumps(result, indent=2) + "\n")
+print("PASS all 15 fixed-work traces and their 105 timed windows")
+for kind in kinds:
+    if kind == 'NEXT_SLOT':
+        continue
+    print(kind, {k: sum(w[k] for record in result.values() for w in record[kind])
+                 for k in next(iter(result.values()))[kind][0] if k not in ("interval", "idle")})
