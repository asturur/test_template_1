+from pathlib import Path
+import json
+
+area = Path(__file__).resolve().parent
+native = json.loads((area / "result.json").read_text())
+fixed = json.loads((area / "payload.json").read_text())
+modes = (0, 16, 20, 24)
+
+
+def aggregate(records):
+    totals = {}
+    for kind in ("NEXT_DEMAND", "NEXT_ADJ"):
+        rows = [row for record in records for row in record[kind]]
+        totals[kind] = {key: sum(row[key] for row in rows) for key in rows[0] if key != "interval"}
+    totals["NEXT_SLOT"] = {}
+    for mode in modes:
+        rows = [row for record in records for row in record["NEXT_SLOT"] if row["idle"] == mode]
+        totals["NEXT_SLOT"][str(mode)] = {
+            key: sum(row[key] for row in rows) for key in rows[0] if key not in ("interval", "idle")
+        }
+    return totals
+
+
+evidence = {
+    "commit": "b6d89816fb515c2bbd5cd7f868d28c05e42ea654",
+    "donor": "ngage2/5473d46",
+    "clock_hz": native["clock_hz"],
+    "cpu_netlist_sha256": native["netlist_sha256"],
+    "slot_idle_clocks": list(modes),
+    "native": {
+        "baseline_frame_and_completion_counters_match": True,
+        "output_sha256": native["output_sha256"],
+        "frames": native["frames"],
+        "rows": native["rows"],
+        "aggregate": aggregate([native["rows"]]),
+    },
+    "fixed": {
+        "baseline_timed_windows_and_third_window_sdram_request_traces_match": True,
+        "window_count": 7 * len(fixed),
+        "per_workload": {name: aggregate([rows]) for name, rows in sorted(fixed.items())},
+        "aggregate": aggregate(list(fixed.values())),
+    },
+}
+(area / "evidence.json").write_text(json.dumps(evidence, indent=2) + "\n")
+for scope in ("native", "fixed"):
+    print(scope, json.dumps(evidence[scope]["aggregate"], sort_keys=True))
