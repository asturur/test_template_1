+`define NEXT_CPU dut.board.upp.cpu_inside.cpu
+reg next_board_i;
+wire next_board_take = dut.line_req && dut.line_ready;
+always @(posedge clk)
+    if (next_board_take) next_board_i <= `NEXT_CPU.wb_code;
+wire next_take = ram_line_req && ram_line_ready && !lock;
+wire next_done = ram_line_valid && ram_line_last;
+wire next_i = next_board_take ? `NEXT_CPU.wb_code : next_board_i;
+wire [24:0] next_pa = {ram_line_addr[24:5], 5'b0};
+wire [25:0] next_successor = {1'b0, next_pa} + 26'd32;
+wire next_legal = next_pa[9:5] != 5'h1f && next_successor < 26'h1000000;
+// Compare canonical physical line offsets at logical capture and again at
+// the scheduler, covering pending posted writes as well as accepted commands.
+wire next_post = sadapter.scalar_accept && swe && (mem_write_block || |sb);
+wire next_write = sdr_req && sdr_cmd_ready && sdr_we && |sdr_wbe;
+wire next_free = !sdr_busy && sdr_cmd_ready && ram_line_ready && !ram_line_req &&
+                 !sreq && !csreq && !shared_dma_req && !lcd_fast_req &&
+                 !dut.pcm_sdram_req && !lock;
+reg next_valid [0:3], next_invalid [0:3], next_refresh [0:3], next_foreign [0:3];
+reg next_seed_i [0:3], next_replace [0:3];
+reg [24:0] next_candidate [0:3], next_saved;
+reg last_full = 0, last_legal, last_i, next_inflight = 0, next_saved_i, next_saved_legal;
+reg [24:0] last_pa;
+integer next_idle [0:3], next_best [0:3];
+integer next_demand [0:1], next_seed [0:1], next_rowend [0:1], next_aperture [0:1],
+        next_adjacency [0:3], next_adj_rowend [0:3];
+integer next_hits [0:3][0:3], next_reject_write [0:3], next_short [0:3],
+        next_refresh_hits [0:3], next_other_hits [0:3], next_killed [0:3];
+
+function integer next_threshold(input integer mode);
+    case (mode)
+        0: next_threshold = 0;
+        1: next_threshold = 16;
+        2: next_threshold = 20;
+        default: next_threshold = 24;
+    endcase
+endfunction
+
+task automatic reset_next;
+    last_full = 0; next_inflight = 0;
+    for (integer n = 0; n < 2; n++) begin
+        next_demand[n] = 0; next_seed[n] = 0; next_rowend[n] = 0; next_aperture[n] = 0;
+    end
+    for (integer mode = 0; mode < 4; mode++) begin
+        next_valid[mode] = 0;
+        next_adjacency[mode] = 0; next_adj_rowend[mode] = 0;
+        next_short[mode] = 0; next_reject_write[mode] = 0; next_killed[mode] = 0;
+        next_refresh_hits[mode] = 0; next_other_hits[mode] = 0;
+        for (integer direction = 0; direction < 4; direction++) next_hits[mode][direction] = 0;
+    end
+endtask
+
+task automatic observe_next;
+    reg coherent_hit;
+    for (integer mode = 0; mode < 4; mode++)
+        if (next_valid[mode]) begin
+            if (!next_invalid[mode] && ((next_post && sa[24:5] == next_candidate[mode][24:5]) ||
+                                       (next_write && sdr_addr[24:5] == next_candidate[mode][24:5]))) begin
+                next_invalid[mode] = 1;
+                next_killed[mode]++;
+            end
+            next_refresh[mode] |= ctrl.ref_due;
+            next_foreign[mode] |= csreq || shared_dma_req || lcd_fast_req || dut.pcm_sdram_req;
+            next_idle[mode] = next_free ? next_idle[mode] + 1 : 0;
+            if (next_idle[mode] > next_best[mode]) next_best[mode] = next_idle[mode];
+        end
+
+    if (next_take) begin
+        if (ram_line_addr[4:0] != 0 || next_inflight || next_pa >= 25'h1000000)
+            $fatal(1, "unexpected next-line census admission");
+        next_inflight = 1;
+        next_demand[next_i]++;
+        next_seed[next_i] += next_legal;
+        next_rowend[next_i] += next_pa[9:5] == 5'h1f;
+        next_aperture[next_i] += next_successor >= 26'h1000000;
+        if (last_full && {1'b0, last_pa} + 26'd32 == {1'b0, next_pa})
+            if (last_legal) next_adjacency[{last_i, next_i}]++;
+            else next_adj_rowend[{last_i, next_i}]++;
+        next_saved = next_pa; next_saved_i = next_i; next_saved_legal = next_legal;
+        for (integer mode = 0; mode < 4; mode++) begin
+            coherent_hit = 0;
+            if (next_valid[mode] && next_candidate[mode] == next_pa) begin
+                if (next_invalid[mode]) next_reject_write[mode]++;
+                else if (next_best[mode] < next_threshold(mode)) next_short[mode]++;
+                else begin
+                    coherent_hit = 1;
+                    next_hits[mode][{next_seed_i[mode], next_i}]++;
+                    next_refresh_hits[mode] += next_refresh[mode];
+                    next_other_hits[mode] += next_foreign[mode];
+                end
+            end
+            next_replace[mode] = !coherent_hit;
+            if (!coherent_hit) next_valid[mode] = 0;
+        end
+    end
+    if (next_done && next_inflight) begin
+        next_inflight = 0;
+        last_full = 1; last_pa = next_saved; last_legal = next_saved_legal; last_i = next_saved_i;
+        for (integer mode = 0; mode < 4; mode++)
+            if (next_replace[mode] && next_saved_legal) begin
+                next_valid[mode] = 1; next_invalid[mode] = 0;
+                next_refresh[mode] = 0; next_foreign[mode] = 0;
+                next_idle[mode] = 0; next_best[mode] = 0;
+                next_candidate[mode] = next_saved + 25'd32;
+                next_seed_i[mode] = next_saved_i;
+            end
+    end
+endtask
+
+task automatic report_next(input integer interval);
+    $display("NEXT_DEMAND interval=%0d d=%0d i=%0d eligible_d=%0d eligible_i=%0d rowend_d=%0d rowend_i=%0d aperture_d=%0d aperture_i=%0d",
+        interval, next_demand[0], next_demand[1], next_seed[0], next_seed[1],
+        next_rowend[0], next_rowend[1], next_aperture[0], next_aperture[1]);
+    $display("NEXT_ADJ interval=%0d dd=%0d di=%0d id=%0d ii=%0d cross_row_dd=%0d cross_row_di=%0d cross_row_id=%0d cross_row_ii=%0d",
+        interval, next_adjacency[0], next_adjacency[1], next_adjacency[2], next_adjacency[3],
+        next_adj_rowend[0], next_adj_rowend[1], next_adj_rowend[2], next_adj_rowend[3]);
+    for (integer mode = 0; mode < 4; mode++)
+        $display("NEXT_SLOT interval=%0d idle=%0d dd=%0d di=%0d id=%0d ii=%0d write_invalidations=%0d stale_matches=%0d cold_matches=%0d refresh_hits=%0d other_hits=%0d",
+            interval, next_threshold(mode), next_hits[mode][0], next_hits[mode][1],
+            next_hits[mode][2], next_hits[mode][3], next_killed[mode], next_reject_write[mode],
+            next_short[mode], next_refresh_hits[mode], next_other_hits[mode]);
+endtask
