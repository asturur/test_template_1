+from pathlib import Path
+import hashlib
+import json
+import re
+import shlex
+import subprocess
+
+area = Path(__file__).resolve().parent
+repo = area.parents[1]
+workspace = area / "leg"
+frozen = repo / "build/sim/polycount/v5-104-all-four-ram-candidate"
+assert (frozen / "arm925t-i16.v").read_bytes() == (workspace / "rtl/arm9v2/arm925t_phone.v").read_bytes()
+compiler = frozen / "i16/mmc3-nos64/Vtb__verFiles.dat"
+options = next(line for line in compiler.read_text().splitlines() if line.startswith("C "))
+argv = shlex.split(options.removeprefix('C "').removesuffix('"'))
+observer = (area / "observe.vh").read_text()
+raw = (frozen / "i16/tb.v").read_text()
+for old, new in (
+    ("        start_clock = cycles;", "        start_clock = cycles;\n        reset_next();"),
+    ("    end else if (start_clock >= 0) begin", "    end else if (start_clock >= 0) begin\n        observe_next();"),
+    ('            $display("POLY_FRAME', '            report_next(frame);\n            $display("POLY_FRAME'),
+):
+    assert raw.count(old) == 1
+    raw = raw.replace(old, new)
+(workspace / "bench.sv").write_text(raw.rsplit("endmodule", 1)[0] + observer + "\nendmodule\n")
+for index, option in enumerate(argv):
+    if option.startswith("/work/") and option.endswith("/tb.v"):
+        argv[index] = "bench.sv"
+    elif option.startswith("/work/") and option.endswith((".sv", ".v")):
+        argv[index] = option.replace("/work/", "/frozen/", 1)
+argv[argv.index("--Mdir") + 1] = "obj"
+driver = ["docker", "run", "--rm", "--pull=never", "--network", "none", "--platform", "linux/arm64",
+          "-v", f"{workspace}:/work", "-v", f"{repo}:/frozen:ro", "-w", "/work", "--entrypoint"]
+image = "jotego/simulator:arm64"
+with (area / "build.log").open("w") as handle:
+    subprocess.run(driver + ["verilator", image] + argv, stdout=handle, stderr=subprocess.STDOUT, check=True)
+for path in (workspace / "obj").glob("*.gch"):
+    path.unlink()
+inputs = {key: "/frozen/" + str((frozen / filename).relative_to(repo))
+          for key, filename in (("core", "core.bin"), ("cdrive", "cdrive.bin"), ("snapshot", "snapshot.bin"))}
+with (area / "run.log").open("w") as handle:
+    subprocess.run(driver + ["/work/obj/Vtb", image, "+ngage-compact-trace", "+no-board-log",
+        "+extension=/frozen/build/firmware/nem4-factory/extension.bin",
+        "+results=/work/polycount", "+begin_pc=68", "+end_pc=6c", "+done_pc=80", "+fail_pc=84"] +
+        [f"+{key}={path}" for key, path in inputs.items()],
+        stdout=handle, stderr=subprocess.STDOUT, check=True)
+
+lines = (area / "run.log").read_text().splitlines()
+def stats(prefix):
+    return [dict((k, int(v)) for k, v in re.findall(r"(\w+)=(-?\d+)", line))
+            for line in lines if line.startswith(prefix + " ")]
+ref = json.loads((frozen / "result.json").read_text())["results"]["i16"]
+digest = hashlib.sha256((workspace / "polycount.bin").read_bytes()).hexdigest()
+assert digest == ref["output_sha"]
+assert stats("POLY_FRAME") == ref["frames"]
+assert stats("PASS_POLYCOUNT") == [ref["completion"]]
+kinds = ("NEXT_DEMAND", "NEXT_ADJ", "NEXT_SLOT")
+rows = {kind: stats(kind) for kind in kinds}
+assert len(rows["NEXT_DEMAND"]) == len(rows["NEXT_ADJ"]) == 4 and len(rows["NEXT_SLOT"]) == 16
+netlist = hashlib.sha256((workspace/"rtl/arm9v2/arm925t_phone.v").read_bytes()).hexdigest()
+assert netlist == ref["netlist_sha"]
+results = dict(commit="b6d8981", clock_hz=104_000_000,
+               netlist_sha256=netlist, output_sha256=digest, rows=rows, frames=stats("POLY_FRAME"))
+(area / "result.json").write_text(json.dumps(results, indent=2) + "\n")
+print("PASS all four native frames, completion counters and output buffer")
