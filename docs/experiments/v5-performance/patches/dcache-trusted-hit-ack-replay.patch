+"""Stage the frozen physical-SDRAM replay with the isolated D-cache RTL."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shutil
+
+
+stage = Path(__file__).resolve().parent
+base = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+trial = Path('build/sim/v5-104-dcache-trusted-hit-ack/mixed')
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+peer = 'tests/phone/upp_ddr_ram/peer.v'
+
+trial.mkdir(parents=True, exist_ok=True)
+shutil.copytree(base / 'source', trial / 'source', dirs_exist_ok=True)
+for name in ('stress.hex', 'image.hex', 'program.hex'):
+    shutil.copyfile(base / name, trial / name)
+(trial / 'source' / peer).parent.mkdir(parents=True, exist_ok=True)
+shutil.copyfile(stage / 'source' / peer, trial / 'source' / peer)
+shutil.copyfile(stage / 'source' / rtl, trial / 'source' / rtl)
+
+hashes = json.loads((base / 'source-hashes.json').read_text())
+assert rtl in hashes and peer in hashes
+for name, reference in hashes.items():
+    if name.startswith('rtl/'):
+        assert sha256((stage / 'reference' / name).read_bytes()).hexdigest() == reference, name
+    actual = sha256((trial / 'source' / name).read_bytes()).hexdigest()
+    assert (actual != reference) == (name == rtl), name
+    hashes[name] = actual
+(trial / 'source-hashes.json').write_text(json.dumps(hashes, indent=2) + '\n')
+
+build = (base / 'build.sh').read_text().replace(str(base), str(trial))
+build = build.replace(f' {peer} ', f' {trial}/source/{peer} ')
+(trial / 'build.sh').write_text(build)
diff --git a/scratch/v5-fit-loop/dcache-trusted-hit-ack/prepare-proof.py b/scratch/v5-fit-loop/dcache-trusted-hit-ack/prepare-proof.py
new file mode 100644
index 0000000..657a51c
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-trusted-hit-ack/prepare-proof.py
@@ -0,0 +1,142 @@
+"""Extract the original and narrowed success cones for an exhaustive simulation."""
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+work = Path('build/sim/v5-104-dcache-trusted-hit-ack/proof')
+work.mkdir(parents=True, exist_ok=True)
+
+
+def module(leg, name):
+    netlist = (stage / leg / rtl).read_text()
+    return re.search(rf'^module {name} \(.*?^endmodule$', netlist, re.M | re.S)[0]
+
+
+def interval(source, first, after):
+    start = source.index(first)
+    return source[start:source.index(after, start)]
+
+
+retained = module('reference', 'ngage2_arm9v2_core')
+trial = module('source', 'ngage2_arm9v2_core')
+fsm_retained = module('reference', 'ngage2_zap_dcache_fsm')
+fsm_trial = module('source', 'ngage2_zap_dcache_fsm')
+response = interval(retained, '\tassign request =', '\talways @(posedge i_clk) begin\n\t\tlate_done')
+complete_class = interval(retained, '\talways @(*) begin : sv2v_autoblock_1', '\twire [23:0] advance_tag;')
+wb_class = interval(retained, '\t\twb_complete = complete_class[0];', '\t\twb_cfail =')
+wb_restore = re.search(r'^\s*assign wb_restore = .*?;$', retained, re.M)[0]
+exception_class = interval(retained, '\tfunction automatic [5:0] w_cls_of;', '\t(* dont_retime *) reg [5:0] w_cls;')
+success = interval(trial, '            wire load_success =', '            assign s_wait_w_hit =')
+for logic in (response, complete_class, wb_class, wb_restore, exception_class):
+    assert logic in trial
+
+original_ack = re.search(r'^\s*assign o_ack_fast = .*?;$', fsm_retained, re.M)[0]
+original_err = re.search(r'^\s*assign o_err_fast = .*?;$', fsm_retained, re.M)[0]
+assert original_err.strip() in fsm_trial
+hit_ack = re.search(r'^\s*assign o_hit_ack_fast = (.*?);$', fsm_trial, re.M | re.S)[1]
+assert 'state_ff[UNC_DONE]' not in hit_ack
+assert 'assign o_ack_fast = o_hit_ack_fast || state_ff[UNC_DONE];' in fsm_trial
+split_ack = interval(fsm_trial, '    assign o_hit_ack_fast =', '\tassign o_err_fast')
+assert fsm_trial.replace(split_ack, original_ack + '\n').replace(
+    ',\n\to_hit_ack_fast\n);\n\toutput wire o_hit_ack_fast;', '\n);') == fsm_retained
+
+signals = """`timescale 1ns/1ps
+module tb;
+    localparam REG_DONE = 1'b1, COMPLETE_FLAT = 1'b1;
+"""
+for source, names in ((retained, ('SWI', 'UND', 'SWP', 'CP', 'BLOCK')),
+                      (fsm_retained, ('IDLE', 'UNC_DONE'))):
+    for name in names:
+        signals += re.search(rf'^\s*localparam \[3:0\] {name} = .*?;$', source, re.M)[0] + '\n'
+signals += """
+    reg _sv2v_0 = 0;
+    reg [13:0] state_ff = 1;
+    reg [541:0] w = 0;
+    reg [3:0] memory_state = 0;
+    reg w_exception = 0, w_cp = 0, cp_finished = 0;
+    reg w_locked = 0, w_swp = 0, i_dc_lock_any = 0, wb_flush = 0;
+    reg w_mem_immediate = 1, fast_pc_hit = 0, w_blkwb = 0;
+    reg request_raw = 0, load_trust = 0;
+    reg late_done = 0, late_err = 0, late_err2 = 0;
+    reg i_align_fault = 0, i_cache_en = 1, i_hit_ok = 1, i_tlb_hit_ready = 1;
+    reg i_wr = 0, i_post_full = 0, hum_ack = 0, unc_err_ff = 0;
+    wire request, request_done, resp_err, resp_err2, retry, wb_restore;
+    wire i_data_ack_fast, i_data_err_fast, i_data_hit_ack_fast;
+    wire [5:0] w_cls_ref = w_cls_of(w);
+    reg [2:0] complete_class;
+    reg wb_complete, done, wb_dabt, wb_fiq, wb_irq, wb_pabt, wb_swi, wb_und;
+    reg wb_exception, wb_valid;
+    wire [31:0] resp_dat;
+    wire [31:0] late_dat = 0, i_data_wb_dat = 0;
+    wire i_data_wb_ack = 0, i_data_wb_err = 0, i_dcache_err2 = 0, defer_load = 0;
+    integer cases = 0, mask, state, op;
+"""
+fast = original_ack.replace('o_ack_fast', 'i_data_ack_fast')
+fast += original_err.replace('o_err_fast', 'i_data_err_fast') + '\n'
+fast += f'    assign i_data_hit_ack_fast = {hit_ack};\n'
+
+tests = """
+    task check;
+        begin
+            #1;
+            if (i_data_ack_fast !== (i_data_hit_ack_fast || state_ff[UNC_DONE]))
+                $fatal(1, "Full ACK changed mask=%h state=%h", mask, state_ff);
+            if (load_trust && {load_success, load_success && wb_valid_on_success} !==
+                {request_done && !retry && !resp_err,
+                 request_done && !retry && !resp_err && wb_valid})
+                $fatal(1, "Success or W validity changed mask=%h state=%h w=%h",
+                    mask, memory_state, w);
+            cases = cases + 1;
+        end
+    endtask
+
+    initial begin
+        w[541] = 1;
+        w[540] = 1;
+        w[535] = 1;
+        // Sweep both ACK sources, alignment, post-full, TLB blocking, all
+        // late-response outcomes, and stale flags without a late response.
+        for (state = 0; state < 3; state = state + 1) begin
+            state_ff = state == 0 ? 14'h001 : state == 1 ? 14'h200 : 14'h008;
+            load_trust = state != 1;
+            for (mask = 0; mask < 8192; mask = mask + 1) begin
+                {i_align_fault, i_cache_en, i_hit_ok, i_tlb_hit_ready, i_wr,
+                 i_post_full, hum_ack, unc_err_ff, request_raw, late_done,
+                 late_err, late_err2, fast_pc_hit} = mask[12:0];
+                if (state != 2) hum_ack = 0;
+                check;
+                if (state == 1 && request_raw && !late_done &&
+                    (!request_done || resp_err !== unc_err_ff || retry))
+                    $fatal(1, "Uncached ACK/error misclassified");
+            end
+        end
+
+        state_ff = 14'h001;
+        load_trust = 1;
+        late_done = 1;
+        late_err = 0;
+        late_err2 = 0;
+        // Independently force every writeback class input while a successful
+        // late response is active, including interrupt, restore and deferral.
+        for (state = 0; state < 16; state = state + 1) begin
+            memory_state = state[3:0];
+            for (op = 0; op < 3; op = op + 1) begin
+                w[8-:4] = op == 0 ? 4'd0 : op == 1 ? SWI : UND;
+                for (mask = 0; mask < 65536; mask = mask + 1) begin
+                    {w[541], w[540], w[535], w[530], w[531], w[538], w_exception,
+                     w_cp, cp_finished, w_locked, w_swp, i_dc_lock_any, wb_flush,
+                     w_mem_immediate, fast_pc_hit, w_blkwb} = mask[15:0];
+                    check;
+                end
+            end
+        end
+        $display("PASS cone_cases=%0d", cases);
+        $finish;
+    end
+endmodule
+"""
+(work / 'tb.sv').write_text(signals + exception_class + '\n' + fast + response +
+    wb_restore + '\n' + complete_class + '    always @(*) begin\n' + wb_class +
+    '    end\n' + success + tests)
diff --git a/scratch/v5-fit-loop/dcache-trusted-hit-ack/collect-receipt.py b/scratch/v5-fit-loop/dcache-trusted-hit-ack/collect-receipt.py
new file mode 100644
index 0000000..dabc28f
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-trusted-hit-ack/collect-receipt.py
@@ -0,0 +1,101 @@
+"""Verify the completed replay artifacts and collect a concise receipt."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-dcache-trusted-hit-ack')
+held_mixed = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+board = out / 'board'
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def read_json(path):
+    return json.loads(path.read_text())
+
+
+def load_workload(kind):
+    path = out / 'qualification' / f'{kind}.json'
+    result = read_json(path)
+    assert result['status'] == 'PASS'
+    compiled = out / 'qualification' / f'{kind}-candidate-cpu.v'
+    assert result['netlist_sha256'] == digest(compiled) == digest(stage / 'source' / rtl)
+    assert all(row['candidate'] == row['control'] for row in result['rows'])
+    return [row['candidate'] for row in result['rows']], digest(path)
+
+
+fixed, fixed_hash = load_workload('fixed')
+native, native_hash = load_workload('native')
+wrong_logs = list((out / 'qualification').glob('*-wrong.log'))
+assert len(fixed) == len(wrong_logs) == 15
+assert all('Guest output check rejected payload' in log.read_text() for log in wrong_logs)
+assert all(len(row['windows']) == 7 for row in fixed)
+assert len(native) == 1 and len(native[0]['frames']) == 4
+
+proof = (out / 'proof/replay.log').read_text()
+cone_cases = int(re.search(r'^PASS cone_cases=(\d+)$', proof, re.M)[1])
+assert cone_cases == 3 * 8192 + 16 * 3 * 65536
+
+profiles = [f'burst-{burst}-wait-{wait}' for burst in (0, 1) for wait in (0, 5)]
+board_results = {}
+for profile in profiles:
+    standard = board / 'source' / f'{profile}.trace'
+    phase = board / 'trusted-waw' / f'source-{profile}.trace'
+    assert digest(standard) == digest(board / 'reference' / f'{profile}.trace')
+    assert digest(phase) == digest(board / 'trusted-waw' / f'reference-{profile}.trace')
+    board_results[profile] = {
+        'standard_cycles': int(re.search(r'^PASS cycles=(\d+)', standard.read_text(), re.M)[1]),
+        'directed_cycles': int(re.search(r'^PASS cycles=(\d+)', phase.read_text(), re.M)[1]),
+        'standard_trace_sha256': digest(standard),
+        'directed_trace_sha256': digest(phase),
+    }
+
+trial_mixed = out / 'mixed'
+mixed_rtl = trial_mixed / 'source' / rtl
+manifest = read_json(trial_mixed / 'source-hashes.json')
+held_manifest = read_json(held_mixed / 'source-hashes.json')
+assert len(manifest) == len(held_manifest) == 114 and manifest.keys() == held_manifest.keys()
+assert [name for name, value in manifest.items() if value != held_manifest[name]] == [rtl]
+assert manifest[rtl] == digest(mixed_rtl) == digest(stage / 'source' / rtl)
+compiled = (trial_mixed / 'obj/Vtb__verFiles.dat').read_text().splitlines()
+assert [line.rsplit('"', 2)[1] for line in compiled if line.startswith('S ') and line.endswith(f'{rtl}"')] == [str(mixed_rtl)]
+trace = trial_mixed / 'traffic.log'
+assert digest(trace) == digest(held_mixed / 'traffic.log')
+lines = len(trace.read_bytes().splitlines())
+cycles = int(re.search(r'^PASS authored ARM .* cycles=(\d+)', (trial_mixed / 'replay.log').read_text(), re.M)[1])
+
+receipt = {
+    'status': 'PASS',
+    'base': '11c4a0c32983cc9aba89cae986684558583a33f2',
+    'patch_sha256': digest(stage / 'dcache-trusted-hit-ack.patch'),
+    'source_sha256': {name: digest(stage / 'source' / name) for name in (rtl, generator)},
+    'equivalence_cone_cases': cone_cases,
+    'board_profiles': board_results,
+    'fixed': {
+        'full_receipt_sha256': fixed_hash,
+        'measured_windows': sum(len(row['windows']) for row in fixed),
+        'median_cycles': {row['case']: row['median'] for row in fixed},
+        'wrong_output_rejections': len(wrong_logs),
+    },
+    'native': {
+        'full_receipt_sha256': native_hash,
+        'frame_cycles': [row['clocks'] for row in native[0]['frames']],
+        'wb_write_acks': sum(row['write_ack'] for row in native[0]['wb_writes']),
+        'output_sha256': native[0]['output_sha256'],
+    },
+    'mixed': {
+        'compiled_sources': len(manifest),
+        'differing_sources': [rtl],
+        'traffic_cycles': cycles,
+        'trace_records': lines,
+        'trace_sha256': digest(trace),
+    },
+}
+(stage / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
