+def isolate_live_load_shift_count(phone):
+    """Use the no-load forwarding bank to compute the fast ARM Rs count."""
+    start = phone.index('module ngage2_arm9v2_execute (')
+    end = phone.index('\nendmodule', start)
+    execute = phone[start:end]
+    execute = edit(execute, '    wire [4:0] rs_grant = s_grant[14:10];',
+                   '    wire [4:0] rs_grant = i_forward_grant[14:10];')
+    execute = edit(execute, '    wire late_w_aux_rs = !rs_m_match && rs_grant[2];',
+                   '''    wire late_w_aux_rs = !rs_m_match && rs_grant[2];
+    wire late_w_load_rs = s_wait_for_w[2];''')
+    execute = edit(execute, '(i_mw_value[71:64] & {8{rs_grant[3]}})',
+                   '(i_w_alu_data[7:0] & {8{rs_grant[3]}})')
+    execute = edit(execute, '    wire fast_reg_eligible = direct_reg_eligible && !late_w_aux_rs;',
+                   '    wire fast_reg_eligible = direct_reg_eligible && !late_w_aux_rs && !late_w_load_rs;')
+    execute = edit(execute, '        if (direct_reg_shift) begin',
+                   '''        // Prepare the fast rotate while the interlock resolves. Admission
+        // and held-count capture still check the original operand readiness.
+        if (fast_reg_eligible) begin''')
+    return phone[:start] + execute + phone[end:]
+
