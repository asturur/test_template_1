+"""Inject a passive redirect census into the checked 104 MHz runners."""
+import importlib.util
+import sys
+from pathlib import Path
+
+
+root = Path.cwd()
+stage = Path(__file__).resolve().parent
+mode = sys.argv[1]
+run_name = 'v5-104-front-rescue-census'
+pin = 'build/sim/unit-hardware-boot-real-sdram/mt48lc16m16a2-verilator.v'
+base = str(stage / 'base.v')
+wrapper = str(stage / 'ngage_cpu.sv')
+payload = root / 'tests/cpu/arm9v2_board'
+native = root / 'tests/cpu/polycount_v5'
+sys.path.insert(0, str(payload))
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def instrument(compile_phone, native_run=False):
+    def compile(out, *args, **kwargs):
+        fixture = out / 'tb.v'
+        source = fixture.read_text()
+        for before, after in (
+            ('task automatic reset_control_flow();',
+             (stage / 'rescue_observe.vh').read_text() + '\ntask automatic reset_control_flow();\n    rescue_reset();'),
+            ('    flow_matches += 1;', '    rescue_score(successor);\n    flow_matches += 1;'),
+            ('    refill_busy = `FLOW_IC.o_fill_pending', '    observe_rescue(clock);\n    refill_busy = `FLOW_IC.o_fill_pending'),
+            ('task automatic report_control_flow(input integer window);',
+             'task automatic report_control_flow(input integer window);\n    rescue_report(window);'),
+        ):
+            assert source.count(before) == 1, before
+            source = source.replace(before, after)
+        fixture.write_text(source)
+        if native_run:
+            kwargs.update(sys_clk_hz=104_000_000, divider=3)
+        return compile_phone(out, *args, **kwargs)
+    return compile
+
+
+match mode:
+    case 'fixed':
+        run = load('payload_clocks', payload / 'payload_clocks.py')
+        run.compile_phone = instrument(run.compile_phone)
+        sys.argv = [str(payload / 'payload_clocks.py'), '--name', run_name, '--sys-clk-hz', '104000000',
+                    '--config', '3:64', '--arm9v2-netlist', base, '--cpu-wrapper', wrapper,
+                    '--flash-cache-bytes', '32768', '--stream-sdram', '--block-writeback',
+                    '--control-flow-counts', '--sdram-model', pin, *sys.argv[2:]]
+        run.main()
+    case 'native':
+        sys.path.insert(0, str(native))
+        run = load('native_polycount', native / 'run.py')
+        run.compile_phone = instrument(run.compile_phone, native_run=True)
+        sys.argv = [str(native / 'run.py'), '--name', run_name, '--legs', 'i16', '--netlist', base,
+                    '--cpu-wrapper', wrapper, '--capture', 'build/sim/polycount-v5/native-qualified',
+                    '--control-flow-counts', '--pin-model', pin, *sys.argv[2:]]
+        run.main()
+    case _:
+        raise ValueError(mode)
