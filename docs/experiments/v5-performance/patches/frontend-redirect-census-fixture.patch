+"""Verify the passive observer against the all-four control and summarize opportunities."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+
+root = Path.cwd()
+stage = Path(__file__).resolve().parent
+all_four = 'v5-104-all-four-ram-candidate'
+observed = 'v5-104-front-rescue-census'
+out = root / 'build/sim'
+names = ('one_thumb', 'any_thumb', 'head', 'next', 'deeper', 'reply', 'decode', 'any_ready',
+         'direct_a', 'fall_a', 'one_line', 'any_line')
+ref_sha = sha256((stage / 'base.v').read_bytes()).hexdigest()
+
+
+def load_result(path):
+    document = json.loads((path / 'result.json').read_text())
+    assert document['status'] == 'PASS', path
+    return document
+
+
+def records(path):
+    windows = {}
+    for line in path.read_text().splitlines():
+        prefix = line.split(' ', 1)[0]
+        if prefix in ('RESCUE_WINDOW', 'RESCUE_KIND'):
+            row = {key: int(value) for key, value in re.findall(r'(\w+)=(-?\d+)', line)}
+            index = row.pop('window')
+            if prefix == 'RESCUE_WINDOW':
+                assert index not in windows
+                windows[index] = row | {'opportunities': {}}
+            else:
+                windows[index]['opportunities'][names[row.pop('kind')]] = row
+    for window in windows.values():
+        for effect in window['opportunities'].values():
+            assert 0 <= effect['front_only'] <= effect['exposed'] <= effect['retired'] <= effect['raw']
+            assert effect['front'] <= effect['elapsed']
+            assert effect['exposed'] <= effect['span2'] <= 2 * effect['exposed']
+    return windows
+
+
+def strip_profile(row):
+    return {key: val for key, val in row.items() if key != 'control_flow'}
+
+
+payload_ref_dir = out / 'payload-clocks' / all_four
+payload_dir = out / 'payload-clocks' / observed
+payload_ref, payload = [load_result(path) for path in (payload_ref_dir, payload_dir)]
+assert payload_ref['netlist_sha256'] == payload['netlist_sha256'] == ref_sha
+assert {key: val for key, val in payload_ref.items() if key != 'rows'} == {
+    key: val for key, val in payload.items() if key != 'rows'}
+assert len(payload['rows']) == len(payload_ref['rows']) == 15
+
+fixed = []
+for reference, row in zip(payload_ref['rows'], payload['rows'], strict=True):
+    assert reference == strip_profile(row), row['case']
+    case = row['case']
+    window = next(index for index in range(2, 7) if row['windows'][index]['cycles'] == row['median_clocks'])
+    log = payload_dir / f'{case}-3-64-0.log'
+    observed_windows = records(log)
+    assert observed_windows.keys() == set(range(7))
+    assert observed_windows == records(payload_dir / f'{case}-3-64-1.log')
+    traces = f'{case}-3-64-requests.txt'
+    trace_digest = sha256((payload_dir / traces).read_bytes()).hexdigest()
+    assert sha256((payload_ref_dir / traces).read_bytes()).hexdigest() == trace_digest
+    checked_inputs = {}
+    for alternative in (False, True):
+        image = f'{case}-{alternative}.bin'
+        image_digest = sha256((payload_dir / image).read_bytes()).hexdigest()
+        assert sha256((payload_ref_dir / image).read_bytes()).hexdigest() == image_digest
+        checked_inputs['bad' if alternative else 'checked'] = image_digest
+    fixed.append(dict(case=case, clocks=row['median_clocks'], selected_window=window,
+                      trace_sha256=trace_digest, input_sha256=checked_inputs, windows=observed_windows))
+
+native_ref_path = out / 'polycount' / all_four
+native_path = out / 'polycount' / observed
+native_ref, native = [load_result(path) for path in (native_ref_path, native_path)]
+for key in ('snapshot_sha', 'pin_model_sha'):
+    assert native_ref[key] == native[key]
+assert native.get('base_netlist_sha', native['results']['i16']['netlist_sha']) == ref_sha
+frames = native['results']['i16']
+assert native_ref['results']['i16'] == strip_profile(frames)
+native_windows = records(native_path / 'i16/run.log')
+assert native_windows.keys() == set(range(4))
+for frame in frames['frames']:
+    native_windows[frame['frame']]['clocks'] = frame['clocks']
+    native_windows[frame['frame']]['retired'] = frame['retired']
+native_n = sum(w['clocks'] for w in native_windows.values())
+native_totals = {
+    name: {key: sum(w['opportunities'].get(name, {}).get(key, 0) for w in native_windows.values())
+           for key in ('raw', 'retired', 'exposed', 'front_only', 'front', 'elapsed', 'span2')}
+    for name in names
+}
+evidence = dict(base='739d3bd', netlist_sha256=ref_sha,
+                cpu_wrapper_sha256=sha256((stage / 'ngage_cpu.sv').read_bytes()).hexdigest(),
+                sys_clk_hz=104_000_000, fixed=fixed,
+                native=dict(clocks=native_n, windows=native_windows, opportunities=native_totals,
+                            output_sha256=frames['output_sha']),
+                controls=dict(fixed_inputs=True, fixed_cycles_and_retired_counts=True, fixed_request_traces=True,
+                              observer_repeats_equal=True, negative_output_checks=True, native_snapshot=True,
+                              native_counters_and_frames=True, native_binary_output=True))
+(stage / 'score.json').write_text(json.dumps(evidence, separators=(',', ':')) + '\n')
+
+
+def summary(label, clocks, chances):
+    def get(name, field):
+        return chances.get(name, {}).get(field, 0)
+    print(f'{label:24s} {clocks:9,d} '
+          f"{get('one_thumb','exposed'):6,d} {get('one_line','exposed'):7,d} "
+          f"{get('any_line','exposed'):7,d} {get('any_ready','raw'):7,d} "
+          f"{get('any_ready','exposed'):7,d} {get('direct_a','exposed'):7,d} "
+          f"{get('one_line','span2') * 100 / clocks:6.3f}% {get('direct_a','exposed') * 100 / clocks:6.3f}%")
+
+
+print('Workload                    Clocks  Thumb  1 ARM   Any ARM   Ready   A/W ready  Direct A  ARM×2   A×1')
+for row in fixed:
+    summary(row['case'], row['clocks'], row['windows'][row['selected_window']]['opportunities'])
+summary('Native PolyCount (4)', native_n, native_totals)
