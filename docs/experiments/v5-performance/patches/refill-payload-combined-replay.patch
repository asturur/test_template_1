+"""Record native-refill qualification on the exact SDRAM payload candidate."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shlex
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+out = root / 'build/sim/v5-104-refill-payload-combined'
+payload_runs = root / 'build/sim/v5-104-sdram-block-payload'
+payload_path = area.parent / 'sdram-block-payload/qualification.json'
+refill_path = area.parent / 'refill-line-word-ready/qualification.json'
+prep_path = area / 'dispatch-20261126/prepare.json'
+rtl = 'rtl/ngage_cpu.sv'
+arbiter = 'rtl/ngage_sdram_arbiter.v'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def fingerprint(path, suffix):
+    rows = [shlex.split(line) for line in path.read_text().splitlines()
+            if line.startswith('S ') and line.endswith(f'{suffix}"')]
+    (row,) = rows
+    return row[-2]
+
+
+def enabled(path):
+    assert path.read_text().count('.PRECAPTURE_BLOCK_DATA(1)') == 1
+
+
+def passes(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+prep, payload, refill = (load(path) for path in (prep_path, payload_path, refill_path))
+assert all(receipt['status'] == 'PASS' for receipt in (prep, payload, refill))
+assert prep['active_timer'] == refill['base'] == payload['base']
+assert digest(payload_path) == prep['payload_qualification_sha256']
+assert digest(refill_path) == prep['refill_qualification_sha256']
+selected = prep['variants']['refill-plus-payload']
+assert selected['parent'] == prep['active_payload']
+assert {rtl: refill['candidate_sha256']} | payload['source_sha256'] == selected['hashes_from_timer']
+assert all(digest(area / 'source' / name) == value for name, value in selected['hashes_from_timer'].items())
+assert digest(area / 'ngage_cpu.sv') == refill['candidate_sha256']
+enabled(area / 'source/Template.sv')
+enabled(out / 'mixed/source/tests/phone/mmc_mister/tb.v')
+
+mix = out / 'mixed'
+fingerprints = {name: fingerprint(mix / 'obj/Vtb__verFiles.dat', name) for name in (arbiter, rtl)}
+assert fingerprints[arbiter] == payload['compiled_arbiter_fingerprint']
+assert fingerprints[rtl] == refill['compiled_wrapper_fingerprint']
+trial, baseline = (load(deck / 'source-hashes.json') for deck in (mix, payload_runs / 'mixed'))
+assert len(trial) == len(baseline) == 114 and trial.keys() == baseline.keys()
+assert {name: trial[name] for name in trial if trial[name] != baseline[name]} == {rtl: refill['candidate_sha256']}
+assert trial[arbiter] == payload['source_sha256'][arbiter]
+assert digest(mix / 'source' / rtl) == refill['candidate_sha256']
+
+workload = {}
+for kind, metric, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    result = load(receipt)
+    control = load(payload_runs / f'qualification/{kind}.json')
+    assert result['status'] == control['status'] == 'PASS'
+    assert result['rows'] == control['rows'] and result['netlist_sha256'] == control['netlist_sha256']
+    assert result['wrapper_sha256'] == refill['candidate_sha256']
+    assert result['source_sha256'][Path(arbiter).name] == payload['source_sha256'][arbiter]
+    assert sum(len(row['candidate'][metric]) for row in result['rows']) == count
+    enabled(out / f'qualification/{kind}.sv')
+    manifest = out / f'qualification/obj-{kind}/Vtb__verFiles.dat'
+    command = next(line for line in manifest.read_text().splitlines() if line.startswith('C '))
+    assert '-GLINE_REFILL=1' in command
+    assert fingerprint(manifest, arbiter) == fingerprints[arbiter]
+    assert fingerprint(manifest, '/ngage_cpu.sv') == fingerprints[rtl]
+    workload[kind] = {'count': count, 'receipt_sha256': digest(receipt)}
+native = result['rows'][0]['candidate']
+workload['native']['cycles'] = [row['clocks'] for row in native['frames']]
+workload['native']['guest_output_sha256'] = native['output_sha256']
+
+physical = {}
+for label, trace, log in (
+    ('normal', 'mixed/traffic.log', 'mixed/replay.log'),
+    ('timer_overlap', 'coexistence/candidate.trace', 'coexistence/candidate.log'),
+    ('cpu_block_eviction', 'block-guest/source.trace', 'block-guest/source.log'),
