+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/refill-payload-combined
+private="$area/dispatch-20261126"
+payload=scratch/v5-fit-loop/sdram-block-payload
+out=build/sim/v5-104-refill-payload-combined
+mkdir -p "$area/reference" "$area/source" "$out"
+for leg in reference source; do
+  if [ "$leg" = reference ]; then
+    rev=b7cf9fcef0bf2ea2c1d29ec569b3c0d0a0dcf120
+  else
+    rev=$(cat "$private/refill-plus-payload.sha")
+  fi
+  env GIT_OBJECT_DIRECTORY="$PWD/$private/objects" \
+    GIT_ALTERNATE_OBJECT_DIRECTORIES="$(cat "$private/alternate-objects.txt")" \
+    git archive "$rev" Template.sv rtl tools tests/cpu/arm9v2_board tests/cpu/spmark_payload \
+      tests/phone/upp_ddr_ram/peer.v sim/programs/link.ld | tar -x -C "$area/$leg"
+  python3 -B "$area/$leg/tools/gen_arm9v2_phone.py" --stock build/arm9v2-assoc/stock-pinned.v --check
+done
+cp "$payload/architectural_trace.vh" "$payload/wb-write-trace.vh" "$area"
+cp "$area/source/rtl/ngage_cpu.sv" "$area/ngage_cpu.sv"
