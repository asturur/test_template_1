+    control = payload['physical_replays'][label]
+    assert digest(candidate) == digest(payload_runs / trace) == control['traffic_sha256']
+    assert len(candidate.read_bytes().splitlines()) == control['events']
+    assert passes(out / log) == passes(payload_runs / log) == control['passes']
+    physical[label] = control
+
+receipt = {'status': 'PASS', 'candidate': selected['sha'], 'base': selected['parent'],
+           'tree': selected['tree'], 'source_sha256': selected['hashes_from_timer'],
+           'preflight_sha256': digest(prep_path),
+           'payload_qualification_sha256': digest(payload_path),
+           'refill_qualification_sha256': digest(refill_path), 'compiled_fingerprints': fingerprints,
+           'mixed_sources': len(trial), 'simulator': (out / 'image.id').read_text().strip(),
+           'workload': workload, 'physical_replays': physical}
+(area / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
