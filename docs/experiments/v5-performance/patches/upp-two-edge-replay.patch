+`timescale 1ns/1ps
+module tb;
+ parameter integer TIMER_CLK_DIV=1,NOS_TICK_HZ=1000,MMC_CLK_DIV=4;
+ reg clk=0,reset=1,cold=1,cpu_hold=0;
+ wire dma_reset;
+ reg discard=0;
+ always #(500000000.0/104000000) clk=~clk;
+ wire init_done,bus_lock;wire [24:0] csa,dsa;wire [31:0] csd,csread,dsread;wire [3:0] csb;wire cswe,csreq,csack,dsreq,dsack;
+ wire [24:0] sa;wire [31:0] sd;wire [3:0] sb;wire swe,sreq;
+
+ wire [31:0] sr;
+ wire sack, packet_lock, memory_owner, scrub_done;
+ wire [24:0] saved_sa=sa;
+ wire [31:0] saved_sd=sd;
+ wire [3:0] saved_sb=sb;
+ wire [31:0] da,dd;wire dr,dw;wire [3:0] db;reg [31:0] rd=0;reg rdy=0;reg [3:0] delay_count=0;reg [31:0] saved_da;wire accept=(dr||dw) && delay_count==0 && !rdy;
+ wire dirty,busy;wire [13:0] sector;wire ce,hs,vs,hb,vb;wire [11:0] rgb;
+ reg [31:0] rom[0:2047],ram[0:32767];integer i,j,cycles=0;integer dd_reads=0;
+ reg [26:0] test_keys=0;
+ wire cpu_ram_accept;
+
+ wire dma_cmd_valid,dma_cmd_write;
+ wire [31:0] dma_cmd_addr,dma_cmd_data;
+ wire [3:0] dma_cmd_be;
+ wire dma_cmd_ready,dma_rsp_valid,dma_rsp_error;
+ wire [31:0] dma_rsp_data;
+ wire local_waiting,local_valid,local_ready,local_write,local_done,local_error;
+ wire [31:0] local_addr,local_data,local_rdata;
+ wire [3:0] local_be;
+ wire fast_req,fast_accept,fast_ack,merge_req,merge_write,merge_ack,merge_accept;
+ wire [24:0] fast_addr,merge_addr;
+
+ wire pcm_req, pcm_ack, pcm_valid;
+ wire [24:0] pcm_addr;
+ wire [31:0] pcm_data;
+ wire [15:0] pcm_l, pcm_r;
+ integer pcm_reads=0, pixel_words=0, lcd_during_write=0, pcm_during_write=0;
+ integer underflows=0, overwritten_frames=0;
+ wire host_writing = outgoing && hps_ack;
+ wire signed_channels = pcm_l == 16'hf000 && pcm_r == 16'h0800;
+ reg done_irq=0;
+ always @(posedge clk) begin
+  if (pcm_ack) pcm_reads <= pcm_reads + 1;
+  if (dut.pcm_irq) done_irq <= 1;
+  if (dut.game_pcm.player.tick && !done_irq) begin
+   if (!dut.game_pcm.player.play) underflows <= underflows + 1;
+   if (dut.game_pcm.player.rq_v && !dut.game_pcm.player.f_take)
+    overwritten_frames <= overwritten_frames + 1;
+  end
+  if (dut.board.display.lcd.pixel_write) begin
+   if (dut.board.display.lcd.pixel_address !== 15'(pixel_words) ||
+       dut.board.display.lcd.pixel_data !== 32'h0abc0123)
+    $fatal(1,"rendered data or position at LCD word %0d",pixel_words);
+   pixel_words <= pixel_words + 1;
+   if (host_writing && signed_channels) lcd_during_write <= lcd_during_write + 1;
+  end
+  if (pcm_valid && host_writing && signed_channels &&
+      pixel_words > 0 && pixel_words < 18304)
+   pcm_during_write <= pcm_during_write + 1;
+ end
+
+ wire [31:0] fast_data,merge_data,merge_rdata;
+ wire [3:0] merge_be;
+ wire dswe; wire [31:0] dsd; wire [3:0] dsb;
+ wire mmc_card_reset,mmc_mount,mmc_ro,mmc_present,mmc_wp,mmc_active,mmc_fault,mmc_hps_busy;
+ wire [63:0] mmc_size;
+ wire [31:0] mmc_lba,hps_lba;wire [5:0] mmc_count,hps_count;
+ wire mmc_read,mmc_write,mmc_ack,mmc_wr,hps_read,hps_write;
+ wire [12:0] mmc_addr;wire [15:0] mmc_data,mmc_din,hps_din;
+ reg img_mount=0;reg [63:0] img_size=2560;
