+         $display("PASS production UPP DDR RAM upload=%0d/%0d NOS=%0d/%0d SWP with LCD DMA waiting=%b fetch=%b PCM hash=%h",
+                  ddr_reads[0],ddr_writes[0],ddr_reads[1],ddr_writes[1],
+                  atomic_dma_overlap,instruction_read,sample_hash);
+     end
+ endtask
+
+    integer cpu_release = -1, gpio_offers = 0, mmc_offers = 0, mmio_offers = 0;
+    integer blocked = 0, card_edges = 0, card_gap_3 = 0, card_bad_gap = 0;
+    integer card_previous = -1;
+    always @(posedge clk) if (!dut.core_reset) begin
+        if (cpu_release < 0) cpu_release <= cycles;
+        if (dut.board.upp.bus_cyc && !dut.board.upp.peripheral_packet_mature && !dut.board.upp.peripheral_early_access && !dut.board.upp.lcd_dma_claim)
+            blocked <= blocked + 1;
+        if (dut.board.upp.cpu_inside.bridge.start) begin
+            gpio_offers <= gpio_offers + (dut.board.upp.cpu_inside.cpu_bus_adr[31:12] == 20'h0c150 || dut.board.upp.cpu_inside.cpu_bus_adr[31:5] == (32'h0c120c00 >> 5));
+            mmc_offers <= mmc_offers + (dut.board.upp.cpu_inside.cpu_bus_adr[31:6] == (32'h0c120600 >> 6));
+            mmio_offers <= mmio_offers + (dut.board.upp.cpu_inside.cpu_bus_adr[31:24] == 8'h0c && dut.board.upp.cpu_inside.cpu_bus_adr[31:16] != 16'h0c03 && dut.board.upp.cpu_inside.cpu_bus_adr[31:16] != 16'h0c10);
+        end
+    end
+    always @(posedge dut.board.mmc_clk) if (!dut.core_reset) begin
+        card_edges = card_edges + 1;
+        if (card_previous >= 0) begin
+            if (cycles - card_previous == 3) card_gap_3 = card_gap_3 + 1;
+            if (cycles - card_previous < 3) card_bad_gap = card_bad_gap + 1;
+        end
+        card_previous = cycles;
+    end
+    task report_pacing;
+        begin
+            if (cpu_release < 0 || card_bad_gap != 0) $fatal(1, "invalid pacing measurement");
+            $display("PACE total=%0d guest=%0d blocked=%0d GPIO=%0d MMC=%0d MMIO=%0d card_edges=%0d card_gap_3=%0d",
+                cycles,cycles-cpu_release+1,blocked,gpio_offers,mmc_offers,mmio_offers,card_edges,card_gap_3);
+        end
+    endtask
+    integer trace_file = 0;
+    integer sys_edge = 0, pin_edge = 0;
+    string trace_path;
+    initial if ($value$plusargs("compare_trace=%s", trace_path)) begin
+        trace_file = $fopen(trace_path, "w");
+        if (!trace_file) $fatal(1, "Could not open transaction trace");
+    end
+    final if (trace_file) $fclose(trace_file);
+
+    always @(posedge clk) begin
+        sys_edge = sys_edge + 1;
+        if (trace_file) begin
+            if (dma_cmd_valid)
+                $fwrite(trace_file,"D %0d %b %h %h %h\n",sys_edge,{dma_cmd_ready,dma_cmd_write},dma_cmd_addr,dma_cmd_data,dma_cmd_be);
+            if (dma_rsp_valid)
+                $fwrite(trace_file,"R %0d %b %h\n",sys_edge,dma_rsp_error,dma_rsp_data);
+            if (pin_req && pin_cmd_ready)
+                $fwrite(trace_file,"Q %0d %b %h %h %h\n",sys_edge,{pin_we,pin_line,pin_short},pin_address,
+                        pin_we ? pin_write_data : 128'b0,pin_we ? pin_write_mask : 16'b0);
+            if (cpu_ram_accept || merge_accept || csack || merge_ack)
+                $fwrite(trace_file,"O %0d %b %h %h\n",sys_edge,{bus_lock,cpu_ram_accept,merge_accept,csack,merge_ack,hold_scalar},
+                        csack ? csread : 32'b0,merge_ack ? merge_rdata : 32'b0);
+            if (shared_line_valid)
+                $fwrite(trace_file,"L %0d %b %h\n",sys_edge,shared_line_last,shared_line_data);
+            if (pin_valid) $fwrite(trace_file,"V %0d %h\n",sys_edge,pin_read_data);
+            if (hps_read || hps_write)
+                $fwrite(trace_file,"H %0d %b %h %h\n",sys_edge,{hps_read,hps_write,hps_ack},hps_lba,hps_count);
+        end
+    end
+    always @(posedge pin_clk) begin
+        pin_edge = pin_edge + 1;
+        if (trace_file && ((!cs_n && {ras_n,cas_n,we_n} != 3'b111) || |controller.sdram_dq_oe))
+            $fwrite(trace_file,"P %0d %b %h %h %h %h\n",pin_edge,{cke,cs_n,ras_n,cas_n,we_n,dqmh,dqml},
+                    bank,pin_a,controller.sdram_dq_oe,pin_out & controller.sdram_dq_oe);
+    end
+
+endmodule
