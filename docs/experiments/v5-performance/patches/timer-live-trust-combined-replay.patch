+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/timer-live-trust-combined
+out=build/sim/v5-104-timer-live-trust-combined/original
+deck=${1:?supply a pinned original timer instruction deck directory}
+mkdir -p "$out"
+cp "$deck/app.hex" "$deck/boot.hex" "$deck/inputs.json" "$out"
+arm-none-eabi-gcc -c -mcpu=arm920t -marm "$area/source/tests/phone/timer_original/program.S" -o "$out/program.o"
+arm-none-eabi-ld -T "$area/source/sim/programs/link.ld" "$out/program.o" -o "$out/program.elf"
+arm-none-eabi-objcopy -O binary "$out/program.elf" "$out/program.bin"
+cmp "$out/program.bin" "$deck/program.bin"
+cp "$deck/program.hex" "$out/"
+python3 -B - "$out" <<'PY'
+from hashlib import sha256
+import json
+from pathlib import Path
+import sys
+
+out = Path(sys.argv[1])
+inputs = json.loads((out / 'inputs.json').read_text())
+assert inputs['rom_sha256'] == '26ca1dd937e299fd4ec3ad65a25d395743ae2149311c3d753cbeb5437673dbc5'
+assert inputs['instruction_substitutions'] == []
+hashes = {'app.hex': '3b543ab996682f64c3c248a96b7b15f6b4f2e69f0d920b6e83e004c1161dcfab',
+          'boot.hex': 'bd62363f2eca7c9ec5fe4884b6471330434b251a2a283eb36d21df6d5aedb8e2'}
+for name, expected in hashes.items():
+    raw = b''.join(int(word, 16).to_bytes(4, 'little') for word in (out / name).read_text().split())
+    assert sha256(raw).hexdigest() == expected, name
+program = b''.join(int(word, 16).to_bytes(4, 'little') for word in (out / 'program.hex').read_text().split())
+assert (out / 'program.bin').read_bytes().ljust(8192, b'\0') == program
+PY
+sed 's@scratch/ngage2-integration/timer-flow-2026-11-11/original/@/inputs/@g' \
+  "$area/source/tests/phone/timer_original/tb.v" > "$out/tb.v"
+for leg in reference source; do
+  mkdir -p "$out/$leg"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$area/$leg:/work:ro" -v "$PWD/$out:/inputs" -w /work \
+    --entrypoint sh jotego/simulator:arm64 -ec '
+      out=/inputs/$1
+      for div in 3 4; do
+        verilator --binary --timing --assert -j 2 -GDIV="$div" -DNGAGE_RUNTIME_TRACE \
+          -Wno-fatal -Wno-lint -Irtl/arm --top-module tb --Mdir "$out/obj-$div" \
+          rtl/ngage_cpu.sv rtl/arm/*.sv rtl/ngage_bram.v rtl/arm920/*.sv rtl/ngage_timers.v \
+          /inputs/tb.v > "$out/build-$div.log" 2>&1
+        for wait_clocks in 0 3; do
+          log="$out/run-$div-$wait_clocks.log"
+          "$out/obj-$div/Vtb" +ngage-compact-trace "+wait=$wait_clocks" > "$log" 2>&1
+          grep "^PASS " "$log"
+        done
+      done
+    ' original "$leg" > "$out/$leg.pass"
+done
+cmp "$out/reference.pass" "$out/source.pass"
+cat "$out/source.pass"
diff --git a/scratch/v5-fit-loop/timer-live-trust-combined/prepare-coexistence.py b/scratch/v5-fit-loop/timer-live-trust-combined/prepare-coexistence.py
new file mode 100644
index 0000000..fb2b83c
--- /dev/null
+++ b/scratch/v5-fit-loop/timer-live-trust-combined/prepare-coexistence.py
@@ -0,0 +1,51 @@
+"""Insert a one-shot timer into the active physical MMC/LCD replay."""
+from pathlib import Path
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-timer-live-trust-combined/coexistence')
+out.mkdir(parents=True, exist_ok=True)
+base = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+guest = (base / 'stress.S').read_text()
+marker = ' // Read/copy/partial-write round trips while LCD DMA and PCM are active.'
+assert guest.count(marker) == 1
+guest = guest.replace(marker, ''' // Timer4 must expire with both transfers still active.
+ mov r12,#83
+ ldr r0,=0x0c120a80
+ put r0,4,1
+ put r0,0x10,13
+timer4_wait:
+ ldr r4,[r0,#8]
+ tst r4,#1
+ beq timer4_wait
+ ldr r4,[r8,#0x18]
+ tst r4,#4
+ beq fail
+ ldr r1,=0x0c120348
+ ldr r4,[r1]
+ cmp r4,#0
+ beq fail
+ put r0,4,0
+ put r0,8,0
+ ldr r4,[r0,#8]
+ tst r4,#1
+ bne fail
+
+''' + marker)
+assembly = out / 'stress-timer.S'
+obj = assembly.with_suffix('.o')
+elf = assembly.with_suffix('.elf')
+binary = assembly.with_suffix('.bin')
+assembly.write_text(guest)
+for command in (
+    ['arm-none-eabi-gcc', '-c', '-mcpu=arm920t', '-marm', assembly, '-o', obj],
+    ['arm-none-eabi-ld', '-T', stage / 'source/sim/programs/link.ld', obj, '-o', elf],
+    ['arm-none-eabi-objcopy', '-O', 'binary', elf, binary],
+):
+    subprocess.run(command, check=True)
+raw = binary.read_bytes()
+assert len(raw) % 4 == 0 and len(raw) <= 8192
+assembly.with_suffix('.hex').write_text(''.join(
+    f'{int.from_bytes(raw[i:i+4], "little"):08x}\n' for i in range(0, len(raw), 4)
+))
