+"""Stage the frozen physical-SDRAM replay with the prepared UPP timer writes."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shutil
+
+
+stage = Path(__file__).resolve().parent
+base = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+trial = Path('build/sim/v5-104-timer-live-trust-combined/mixed')
+changed = {'rtl/arm9v2/arm925t_phone.v', 'rtl/ngage_timers.v', 'rtl/ngage_upp.v', 'rtl/ngage_upp_peripherals.v'}
+peer = 'tests/phone/upp_ddr_ram/peer.v'
+
+trial.mkdir(parents=True, exist_ok=True)
+shutil.copytree(base / 'source', trial / 'source', dirs_exist_ok=True)
+for name in ('stress.hex', 'image.hex', 'program.hex'):
+    shutil.copyfile(base / name, trial / name)
+(trial / 'source' / peer).parent.mkdir(parents=True, exist_ok=True)
+shutil.copyfile(stage / 'source' / peer, trial / 'source' / peer)
+for name in changed:
+    shutil.copyfile(stage / 'source' / name, trial / 'source' / name)
+
+hashes = json.loads((base / 'source-hashes.json').read_text())
+assert changed <= hashes.keys() and peer in hashes
+for name, reference in hashes.items():
+    if name.startswith('rtl/'):
+        assert sha256((stage / 'reference' / name).read_bytes()).hexdigest() == reference, name
+    actual = sha256((trial / 'source' / name).read_bytes()).hexdigest()
+    assert (actual != reference) == (name in changed), name
+    hashes[name] = actual
+(trial / 'source-hashes.json').write_text(json.dumps(hashes, indent=2) + '\n')
+
+build = (base / 'build.sh').read_text().replace(str(base), str(trial))
+build = build.replace(f' {peer} ', f' {trial}/source/{peer} ')
+(trial / 'build.sh').write_text(build)
