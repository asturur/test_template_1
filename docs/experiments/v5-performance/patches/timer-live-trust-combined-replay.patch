+                        '.timer_count_write(count_select), .timer_stop(stop_select),')
+assert 'select_word' not in wiring
+bench = (stage / 'timer-directed.sv').read_text()
+assert bench.count('    // Fixture wiring') == 1
+(out / 'tb.sv').write_text(bench.replace('    // Fixture wiring', wiring))
diff --git a/scratch/v5-fit-loop/timer-live-trust-combined/replay.py b/scratch/v5-fit-loop/timer-live-trust-combined/replay.py
new file mode 100644
index 0000000..bad6742
--- /dev/null
+++ b/scratch/v5-fit-loop/timer-live-trust-combined/replay.py
@@ -0,0 +1,182 @@
+"""Replay prepared UPP timer writes against the retained 104 MHz control."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import statistics
+import subprocess
+import sys
+
+parser = argparse.ArgumentParser()
+parser.add_argument('kind', choices=('fixed', 'native'))
+parser.add_argument('--case', action='append')
+parser.add_argument('--workers', type=int, default=3)
+parser.add_argument('--output', default='replay')
+args = parser.parse_args()
+kind = args.kind
+stage = Path(__file__).resolve().parent
+repo = stage.parents[2]
+work = repo / 'build/sim/v5-104-timer-live-trust-combined' / args.output
+work.mkdir(parents=True, exist_ok=True)
+baseline_name = 'v5-104-all-four-ram-candidate'
+fixed = repo / 'build/sim/payload-clocks' / baseline_name
+native = repo / 'build/sim/polycount' / baseline_name
+timing_baseline = repo / 'scratch/refill-issue-739d3bd'
+d_stage = stage / 'ngage_cpu.sv'
+candidate = stage / 'source/rtl/arm9v2/arm925t_phone.v'
+image = 'jotego/simulator:arm64'
+docker = ['docker', 'run', '--rm', '--pull=never', '--network', 'none', '--platform', 'linux/arm64',
+          '-v', f'{work}:/work', '-v', f'{repo}:/frozen:ro', '-w', '/work', '--entrypoint']
+sys.path.insert(0, str(stage / 'source/tests/cpu/arm9v2_board'))
+import payload_clocks
+payload_clocks.OUT = repo / "build/sim"
+from payload_clocks import qualified_inputs
+
+
+def frozen(path):
+    return '/frozen/' + str(path.relative_to(repo))
+
+
+def run(options, entrypoint, log):
+    with log.open('w') as handle:
+        return subprocess.run(docker + [entrypoint, image] + options, stdout=handle,
+                              stderr=subprocess.STDOUT, check=False).returncode
+
+
+def build():
+    compiled_netlist = work / f'{kind}-candidate-cpu.v'
+    compiled_netlist.write_bytes(candidate.read_bytes())
+    ref = fixed if kind == 'fixed' else native / 'i16'
+    bench = (ref / 'tb.v').read_text()
+    observer = (stage / 'architectural_trace.vh').read_text() + (stage / 'wb-write-trace.vh').read_text()
+    (work / f'{kind}.sv').write_text(bench.rsplit('endmodule', 1)[0] + observer + '\nendmodule\n')
+    command = next(line for line in (ref / 'mmc3-nos64/Vtb__verFiles.dat').read_text().splitlines()
+                   if line.startswith('C '))
+    options = shlex.split(command.removeprefix('C "').removesuffix('"'))
+    net_hits, wrapper_hits, bench_hits = 0, 0, 0
+    for i, option in enumerate(options):
+        if option == 'rtl/ngage_cpu.sv':
+            options[i] = frozen(d_stage)
+            wrapper_hits += 1
+        elif option in {'rtl/ngage_ddr_stream.v', 'rtl/ngage_upp.v', 'rtl/ngage_dma_channels.v', 'rtl/ngage_upp_peripherals.v', 'rtl/ngage_keypad.v', 'rtl/ngage_upp_euart.v', 'rtl/ngage_timers.v'}:
+            options[i] = frozen(stage / 'source' / option)
+        elif option.startswith('/work/') and option.endswith(('/arm925t_phone.v', '/arm925t-i16.v')):
+            options[i] = '/work/' + compiled_netlist.name
+            net_hits += 1
+        elif option.startswith('/work/') and option.endswith('/tb.v'):
+            options[i] = f'/work/{kind}.sv'
+            bench_hits += 1
+        elif option.startswith('/work/') and option.endswith(('.v', '.sv')):
+            options[i] = option.replace('/work/', '/frozen/', 1)
+        elif option.startswith('-Irtl/'):
+            options[i] = '-I' + frozen(timing_baseline / 'leg' / option[2:])
+        elif option.endswith(('.v', '.sv')):
+            source = timing_baseline / 'leg' / option
+            assert source.is_file(), source
+            options[i] = frozen(source)
+    assert net_hits == wrapper_hits == bench_hits == 1, (net_hits, wrapper_hits, bench_hits)
+    options[options.index('--Mdir') + 1] = f'obj-{kind}'
+    options.insert(0, '-I'+frozen(timing_baseline / 'leg'))
+    options[options.index('-j') + 1] = '3'
+    log = work / f'build-{kind}.log'
+    assert run(options, 'verilator', log) == 0, log
+    compiled = (work / f'obj-{kind}/Vtb__verFiles.dat').read_text().splitlines()
+    assert any(line.startswith('S ') and line.endswith('/timer-live-trust-combined/source/rtl/ngage_ddr_stream.v\"') for line in compiled)
+    for changed in ('ngage_upp.v', 'ngage_dma_channels.v', 'ngage_upp_peripherals.v', 'ngage_keypad.v', 'ngage_upp_euart.v', 'ngage_timers.v'):
+        assert any(line.startswith('S ') and line.endswith(f'/timer-live-trust-combined/source/rtl/{changed}"') for line in compiled), changed
+    for source in (f'{kind}.sv', compiled_netlist.name):
+        assert any(line.startswith('S ') and line.endswith(f'"/work/{source}"') for line in compiled), source
+    for cache in (work / f'obj-{kind}').glob('*.gch'):
+        cache.unlink()
+
+
+def scan(log, prefix, hex_fields=False):
+    rows = []
+    for line in log.read_text().splitlines():
+        if line.startswith(prefix):
+            pairs = re.findall(r'(\w+)=(-?[0-9a-f]+)', line)
+            rows.append({k: int(v, 16 if hex_fields and k.endswith('_hash') else 10) for k, v in pairs})
+    return rows
+
+
+def digest(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def execute(profile, case, attempt=0, wrong=False):
+    delay, thumb = profile
+    inputs = ['+ngage-compact-trace', '+no-board-log',
+              '+extension=' + frozen(repo / 'build/firmware/nem4-factory/extension.bin')]
+    suffix = f'{delay}{thumb}-{attempt}{"-wrong" if wrong else ""}'
+    if kind == 'fixed':
+        name = case['name']
+        inputs += ['+core=' + frozen(fixed / f'{name}-{wrong}.bin'), '+cdrive=' + frozen(fixed / 'cdrive.bin'),
+                   f'+begin_pc={case["begin"]:x}', f'+end_pc={case["end"]:x}',
+                   f'+payload_base={case["payload_base"]:x}', f'+helper_base={case["helper_base"]:x}']
+    else:
+        name = 'native'
+        result = work / f'native-{suffix}.bin'
+        inputs += ['+core=' + frozen(native / 'core.bin'), '+cdrive=' + frozen(native / 'cdrive.bin'),
+                   '+snapshot=' + frozen(native / 'snapshot.bin'), f'+results=/work/native-{suffix}',
+                   '+begin_pc=68', '+end_pc=6c', '+done_pc=80', '+fail_pc=84']
+    log = work / f'{name}-{suffix}.log'
+    code = run(inputs, f'/work/obj-{kind}/Vtb', log)
+    if wrong:
+        assert code != 0 and 'Guest output check rejected payload' in log.read_text(), log
+        return None
+    assert code == 0, log
+    architecture = scan(log, 'RES_ARCH ', hex_fields=True)
+    wb_writes = scan(log, 'RES_WB ', hex_fields=True)
+    assert len(wb_writes) == len(architecture)
+    if kind == 'fixed':
+        windows = scan(log, 'PAYLOAD_RESULT ')
+        assert len(architecture) == len(windows) == 7, log
+        assert len(scan(log, 'PAYLOAD_PASS ')) == 1
+        for actual, expect in zip(windows, case['windows'], strict=True):
+            assert actual['payload_ops'] == expect['payload_retire_proxy']
+            assert actual['helper_ops'] == expect['helper_retire_proxy']
+        return dict(profile=profile, case=name, windows=windows, architecture=architecture, wb_writes=wb_writes,
+                    median=statistics.median(x['cycles'] for x in windows[2:]))
+    frames = scan(log, 'POLY_FRAME ')
+    assert len(architecture) == len(frames) == 4, log
+    assert len(scan(log, 'PASS_POLYCOUNT ')) == 1
+    assert digest(result) == digest(native / 'i16/result.bin')
+    return dict(profile=profile, case=name, frames=frames, architecture=architecture, wb_writes=wb_writes,
+                output_sha256=digest(result), median=statistics.median(f['clocks'] for f in frames[1:]))
+
+
+def architectural_work(row):
+    return [{k:v for k,v in entry.items() if k != 'recover'} for entry in row['architecture']]
+
+control = json.loads((stage.parent/'prepared-wb-write-data'/'candidate'/f'{kind}.json').read_text())
+assert control['status'] == 'PASS'
+assert control['ddr_stream_sha256'] == digest(stage/'source/rtl/ngage_ddr_stream.v')
+reference = {r['candidate']['case']:r['candidate'] for r in control['rows']}
+
+build()
+rows=[]
+with ThreadPoolExecutor(max_workers=args.workers) as pool:
+    cases = [None] if kind=='native' else [case for case in qualified_inputs()
+                                            if not args.case or case['name'] in args.case]
+    if kind=='fixed':
+        assert len(cases)==(len(args.case) if args.case else 15)
+        cases.sort(key=lambda r:r['name']!='sega-scan')
+    for case in cases:
+        primary = pool.submit(execute, (0,0), case)
+        repeat = pool.submit(execute, (0,0), case, attempt=1) if kind=='fixed' else None
+        wrong = pool.submit(execute,(0,0),case,wrong=True) if kind=='fixed' else None
+        trial=primary.result()
+        if repeat:
+            assert trial==repeat.result() and wrong.result() is None
+        name=trial['case']
+        expected = {**reference[name], 'profile': (0,0)}
+        assert trial == expected, (name, trial, expected)
+        rows.append(dict(candidate=trial, control=expected))
+        print(name, trial['median'], flush=True)
+(work/f'{kind}.json').write_text(json.dumps(dict(status='PASS', netlist_sha256=digest(candidate),
+                                                wrapper_sha256=digest(d_stage), ddr_stream_sha256=digest(stage / 'source/rtl/ngage_ddr_stream.v'),
+                                                dma_channels_sha256=digest(stage / 'source/rtl/ngage_dma_channels.v'),
+                                                source_sha256={name:digest(stage / 'source/rtl' / name) for name in ('ngage_upp.v','ngage_upp_peripherals.v','ngage_upp_euart.v', 'ngage_timers.v','ngage_keypad.v')}, rows=rows),indent=2)+'\n')
diff --git a/scratch/v5-fit-loop/timer-live-trust-combined/record.py b/scratch/v5-fit-loop/timer-live-trust-combined/record.py
new file mode 100644
index 0000000..2acd055
--- /dev/null
+++ b/scratch/v5-fit-loop/timer-live-trust-combined/record.py
@@ -0,0 +1,173 @@
+"""Verify the combined timer-write and live-trust qualification against retained replays."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+root = stage.parents[2]
+out = Path('build/sim/v5-104-timer-live-trust-combined')
+retained = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+controls = stage.parent / 'prepared-wb-write-data/candidate'
+cpu = 'rtl/arm9v2/arm925t_phone.v'
+changed = (cpu, 'rtl/ngage_timers.v', 'rtl/ngage_upp.v', 'rtl/ngage_upp_peripherals.v')
+
+
+def digest(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def match(left, right):
+    assert left.read_bytes() == right.read_bytes(), left
+    return digest(left)
+
+
+def git(*args):
+    return subprocess.check_output(['git', *args], text=False)
+
+
+def pass_lines(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+def trace_digest(rows):
+    return sha256(json.dumps(rows, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+
+
+tree = git('rev-parse', '11c4a0c^{tree}').decode().strip()
+assert tree == git('rev-parse', 'e9552bd^{tree}').decode().strip()
+rtl = {file: digest(stage / 'source' / file) for file in changed}
+reference_rtl = {name: sha256(git('show', f'11c4a0c:{name}')).hexdigest() for name in changed}
+assert reference_rtl == {name: digest(stage / 'reference' / name) for name in changed}
+receipt = {
+    'status': 'PASS',
+    'baseline': git('rev-parse', '11c4a0c').decode().strip(),
+    'baseline_tree': tree,
+    'design_patch_sha256': {
+        name: digest(root / 'docs/experiments/v5-performance/patches' / f'{name}.patch')
+        for name in ('timer-write-prepare', 'dcache-live-trust')
+    },
+    'fixture_patch_sha256': digest(stage / 'timer-live-trust-combined-replay.patch'),
+    'preflight_receipt_sha256': digest(stage / 'dispatch-20261126/prepare.json'),
+    'candidate_rtl_sha256': rtl,
+    'retained_rtl_sha256': reference_rtl,
+    'simulator': (out / 'image.id').read_text().strip(),
+}
+
+
+def selected_sources(manifest, prefix, kind=None):
+    lines = manifest.read_text().splitlines()
+    records = [entry.groups() for line in lines
+               if (entry := re.fullmatch(r'S .*?"([^"]+)" "([^"]+)"', line))]
+    verified = {}
+    for name, sha in rtl.items():
+        if kind and name == cpu:
+            staged = f'{kind}-candidate-cpu.v'
+            [(fingerprint, source)] = [(fingerprint, path) for fingerprint, path in records
+                                       if path == f'/work/{staged}']
+            assert not any(path.endswith(f'/{name}') or path == name for _, path in records)
+            actual = manifest.parent.parent / staged
+        else:
+            [(fingerprint, source)] = [(fingerprint, path) for fingerprint, path in records
+                                       if path.endswith(f'/{name}') or path == name]
+            assert source == f'{prefix}/{name}'
+            actual = Path(source.removeprefix('/frozen/'))
+        assert digest(actual) == sha
+        verified[name] = {'sha256': sha, 'verilator_fingerprint': fingerprint}
+    return verified
+
+
+directed = out / 'directed'
+trace = directed / 'source.trace'
+checks = pass_lines(trace)
+assert len(checks) == 1 and 'decode=8192 responses=6025 clocks=41235' in checks[0]
+rows = len(trace.read_bytes().splitlines())
+assert rows == 8397
+receipt['directed'] = {'decode_cases': 8192, 'responses': 6025, 'clocks': 41235,
+                       'trace_records': rows, 'trace_sha256': match(trace, directed / 'reference.trace')}
+units = out / 'units'
+receipt['timer_units'] = {'trace_sha256': match(units / 'source.pass', units / 'reference.pass'),
+                          'matched_tests': pass_lines(units / 'source.pass'),
+                          'timer_icu_conformance': pass_lines(units / 'conformance.log')}
+assert len(receipt['timer_units']['matched_tests']) == 9
+assert len(receipt['timer_units']['timer_icu_conformance']) == 1
+original = out / 'original'
+receipt['original_timer_instructions'] = {
+    'input_manifest_sha256': digest(original / 'inputs.json'),
+    'pass_sha256': match(original / 'source.pass', original / 'reference.pass'),
+    'matched_profiles': pass_lines(original / 'source.pass'),
+}
+assert len(receipt['original_timer_instructions']['matched_profiles']) == 4
+
+board = []
+for burst in (0, 1):
+    for wait in (0, 5):
+        trace = f'burst-{burst}-wait-{wait}.trace'
+        file = out / 'board/source' / trace
+        [summary] = pass_lines(file)
+        board.append({'burst': burst, 'wait': wait, 'pass': summary,
+                      'trace_sha256': match(file, out / 'board/reference' / trace)})
+receipt['board_contract'] = board
+
+results = out / 'qualification'
+for kind, count in (('fixed', 15), ('native', 1)):
+    path = results / f'{kind}.json'
+    old_path = controls / f'{kind}.json'
+    trial = json.loads(path.read_text())
+    old = json.loads(old_path.read_text())
+    assert trial['status'] == old['status'] == 'PASS'
+    assert trial['netlist_sha256'] == rtl[cpu] != old['netlist_sha256']
+    assert all(trial['source_sha256'][Path(name).name] == sha for name, sha in rtl.items() if name != cpu)
+    for key in ('wrapper_sha256', 'ddr_stream_sha256', 'dma_channels_sha256'):
+        assert trial[key] == old[key]
+    assert len(trial['rows']) == len(old['rows']) == count
+    old_rows = {row['candidate']['case']: row['candidate'] for row in old['rows']}
+    rows = []
+    for row in trial['rows']:
+        case = row['candidate']
+        name = case['case']
+        assert row['control'] == case == old_rows[name]
+        item = {'case': name, 'architectural_sha256': trace_digest(case['architecture']),
+                'valid_write_trace_sha256': trace_digest(case['wb_writes'])}
+        if kind == 'fixed':
+            assert len(case['windows']) == 7
+            assert 'Guest output check rejected payload' in (results / f'{name}-00-0-wrong.log').read_text()
+            assert (results / f'{name}-00-1.log').is_file()
+            item.update(window_cycles=[point['cycles'] for point in case['windows']],
+                        median_cycles=case['median'], repeat_and_negative_output_check=True)
+        else:
+            assert len(case['frames']) == 4
+            item.update(frame_cycles=[frame['clocks'] for frame in case['frames']],
+                        output_sha256=case['output_sha256'])
+        rows.append(item)
+    receipt[kind] = {
+        'source_checks': selected_sources(results / f'obj-{kind}/Vtb__verFiles.dat',
+                                          f'/frozen/{stage.relative_to(root)}/source', kind),
+        'candidate_receipt_sha256': digest(path),
+        'retained_receipt_sha256': digest(old_path),
+        'rows': rows,
+    }
+
+mixed = out / 'mixed'
+new_hashes = json.loads((mixed / 'source-hashes.json').read_text())
+old_hashes = json.loads((retained / 'source-hashes.json').read_text())
+assert new_hashes.keys() == old_hashes.keys()
+assert {name: sha for name, sha in new_hashes.items() if sha != old_hashes[name]} == rtl
+both = out / 'coexistence'
+for test, logfile, trace, reference, count, clocks in (
+    ('physical_mixed', mixed / 'replay.log', mixed / 'traffic.log', retained / 'traffic.log', 171496, 1201547),
+    ('timer_mmc_lcd_coexistence', both / 'candidate.log', both / 'candidate.trace', both / 'retained.trace', 171497, 1201528),
+):
+    checks = pass_lines(logfile)
+    assert len(checks) == 4 and f'cycles={clocks}' in checks[-1]
+    assert len(trace.read_bytes().splitlines()) == count
+    receipt[test] = {'trace_sha256': match(trace, reference), 'events': count, 'clocks': clocks, 'checks': checks}
+receipt['physical_mixed']['source_count'] = len(new_hashes)
+receipt['physical_mixed']['source_checks'] = selected_sources(mixed / 'obj/Vtb__verFiles.dat', f'{mixed}/source')
+assert receipt['fixed']['source_checks'] == receipt['native']['source_checks'] == receipt['physical_mixed']['source_checks']
+receipt['timer_mmc_lcd_coexistence']['stress_sha256'] = digest(both / 'stress-timer.hex')
+
+(stage / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print('PASS live-trust and timer RTL, original instructions, fixed/native workloads, physical and timer/MMC/LCD pin traces')
diff --git a/scratch/v5-fit-loop/timer-live-trust-combined/prepare-fit.py b/scratch/v5-fit-loop/timer-live-trust-combined/prepare-fit.py
