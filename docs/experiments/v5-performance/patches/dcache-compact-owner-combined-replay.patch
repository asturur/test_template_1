+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/dcache-compact-owner-combined
+compact=scratch/v5-fit-loop/dcache-compact-lock
+owner=scratch/v5-fit-loop/mmc-hps-owner-timer-combined
+private="$area/dispatch-20261126"
+out=build/sim/v5-104-dcache-compact-owner-combined
+mkdir -p "$area/reference" "$area/source" "$out"
+for leg in reference source; do
+  revision=9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e
+  if [ "$leg" = source ]; then revision=$(cat "$private/compact-plus-owner.sha"); fi
+  env GIT_OBJECT_DIRECTORY="$PWD/$private/objects" \
+    GIT_ALTERNATE_OBJECT_DIRECTORIES="$(cat "$private/alternate-objects.txt")" \
+    git archive "$revision" rtl tools sys tests/phone/mmc_hps tests/cpu/arm9v2_board \
+      tests/cpu/spmark_payload tests/phone/upp_ddr_ram/peer.v sim/programs/link.ld \
+      | tar -x -C "$area/$leg"
+  python3 -B "$area/$leg/tools/gen_arm9v2_phone.py" --stock build/arm9v2-assoc/stock-pinned.v --check
+done
+cp "$owner/architectural_trace.vh" "$owner/wb-write-trace.vh" "$owner/owner-phase.vh" "$area"
+cp "$compact/check-lock-update.v" "$area"
+cp "$area/source/rtl/ngage_cpu.sv" "$area/ngage_cpu.sv"
