+      release cache.o_lock_any;
+      release cache.o_lock_tag;
+      release cache.o_reg_idx;
+      release legacy.g_bitmap_lock.lock_ff;
+      release legacy.o_lock_any;
+      release legacy.o_lock_tag;
+      release legacy.o_reg_idx;
+      release compact.o_lock_any;
+      release compact.o_lock_tag;
+      release compact.o_reg_idx;
+      release compact.g_compact_lock.return_ff;
+      owner_hold = 7;
+      owner_advance = incoming;
