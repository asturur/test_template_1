+          $fatal(1, "Returned destination remained locked");''')
+edit('  initial begin\n    repeat (2) tick;', '''  task simultaneous;
+    input [5:0] incoming;
+    begin
+      reset = 1;
+      tick;
+      reset = 0;
+      // Force an IDLE register image with a coincident old return. Natural
+      // refill traffic clears the owner before IDLE, so test priority here.
+      force cache.lock_ff = 64'h80;
+      force cache.o_lock_any = 1'b1;
+      force cache.o_lock_tag = 6'd7;
+      force cache.o_reg_idx = 64'h80;
+      force legacy.g_bitmap_lock.lock_ff = 64'h80;
+      force legacy.o_lock_any = 1'b1;
+      force legacy.o_lock_tag = 6'd7;
+      force legacy.o_reg_idx = 64'h80;
+      force compact.o_lock_any = 1'b1;
+      force compact.o_lock_tag = 6'd7;
+      force compact.o_reg_idx = 64'h80;
+      force compact.g_compact_lock.return_ff = 1'b1;
+      #0.5;
