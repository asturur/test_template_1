+"""Build a dual-instance Verilog-2001 miter around the retained HPS fixture."""
+from pathlib import Path
+import re
+
+
+area = Path(__file__).resolve().parent
+stage = area
+work = Path('build/sim/v5-104-dcache-compact-owner-combined/owner-miter')
+work.mkdir(parents=True, exist_ok=True)
+rtl = 'rtl/ngage_mmc_hps.v'
+original, trial = ((stage / leg / rtl).read_text() for leg in ('reference', 'source'))
+registers = original.split('    // Configuration-time initialization')[0].split('    reg [2:0] state;', 1)[1]
+common = ['state'] + [name.strip() for group in re.findall(r'^    reg\s+(?:\[[^]]+\]\s*)?([^;]+);$', registers, re.M)
+                     for name in group.split(',') if 'generation' not in name]
+assert not re.search(r'\b(?:generation|request_generation)\b', trial)
+for filename, module, source in (('retained.v', 'retained_hps', original), ('trial.v', 'trial_hps', trial)):
+    assert source.count('module ngage_mmc_hps (') == 1
+    (work / filename).write_text(source.replace('module ngage_mmc_hps (', f'module {module} ('))
+
+ports = dict((name, width.strip()) for width, name in
+    re.findall(r'^    output (?:wire|reg)\s+(\[[^]]+\])?\s*(\w+)\s*,?$', original, re.M))
+assert len(ports) == 15
+bench = (stage / 'reference/tests/phone/mmc_hps/tb.v').read_text()
+instance = re.search(r'^  ngage_mmc_hps dut \(.*?^  \);$', bench, re.M | re.S)[0]
+declarations = ''.join(f'  wire {width} trial_{name};\n' for name, width in ports.items())
+candidate = instance.replace('ngage_mmc_hps dut', 'trial_hps trial')
+for port in ports:
+    candidate = re.sub(rf'\.{port}\([^)]*\)', f'.{port}(trial_{port})', candidate)
+bench = bench.replace(instance, instance.replace('ngage_mmc_hps dut', 'retained_hps dut') +
+    '\n' + declarations + candidate)
+
+def pack(signals):
+    return '{\n        ' + ',\n        '.join(signals) + '\n    }'
+
+checks = f"""
+  wire public_equal =
+    {pack(f'dut.{name}' for name in ports)} === {pack(f'trial_{name}' for name in ports)};
+  wire states_equal =
+    {pack(f'dut.{name}' for name in common)} === {pack(f'trial.{name}' for name in common)};
+  integer comparison_points = 0;
+  task check_owner;
+    begin
+      if (!public_equal || !states_equal) begin
+        $display("DIFF state=%0d/%0d cancelled=%b/%b events=%b ack=%b addr=%h",
+                 dut.state, trial.state, dut.cancelled, trial.cancelled,
+                 {{init_reset, guest_reset, mount}}, h_ack, h_addr);
+        fail("owner miter changed output or state");
+      end
+      if (dut.state > 0 && dut.state <= 4 && !dut.cancelled &&
+          dut.request_generation !== dut.generation)
+        fail("live admitted owner has stale generation");
+      comparison_points = comparison_points + 1;
+    end
+  endtask
+  always @(negedge clk) begin
+    #1;
+    check_owner;
+  end
+  always @(posedge clk) begin
+    #2;
+    check_owner;
+  end
+"""
+bench = bench.replace('  reg [7:0] footer[0:511];',
+    '  reg owner_phase = 0;\n' + checks + '\n  reg [7:0] footer[0:511];')
+bench = bench.replace('    cycles = cycles + 1;\n', '    cycles = cycles + 1;\n    if (!owner_phase) begin\n', 1)
+bench = bench.replace('    stable_count = h_count;\n', '    stable_count = h_count;\n    end\n', 1)
+marker = '  initial begin\n    repeat (3) tick;'
+assert bench.count(marker) == 1
+bench = bench.replace(marker, (area / 'owner-phase.vh').read_text() + '\n' + marker)
+marker = '             copies, cycles);\n    $finish;'
+assert bench.count(marker) == 1
+bench = bench.replace(marker, '             copies, cycles);\n    test_owner_events;\n    $finish;')
+(work / 'tb.v').write_text(bench)
diff --git a/scratch/v5-fit-loop/dcache-compact-owner-combined/replay.py b/scratch/v5-fit-loop/dcache-compact-owner-combined/replay.py
