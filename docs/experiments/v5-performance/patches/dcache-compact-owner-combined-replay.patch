+"""Verify the exact active HPS owner and compact D-cache replay inputs."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shlex
+
+
+stage = Path(__file__).resolve().parent
+root = stage.parents[2]
+out = root / 'build/sim/v5-104-dcache-compact-owner-combined'
+controls = root / 'build/sim/v5-104-mmc-hps-owner-timer-combined/owner-plus-timer'
+prep = stage / 'dispatch-20261126/prepare.json'
+lock_receipt = root / 'docs/evidence/v5-104-dcache-compact-lock.json'
+hps_receipt = root / 'docs/evidence/v5-104-mmc-hps-owner-timer-combined.json'
+rtl_cpu = 'rtl/arm9v2/arm925t_phone.v'
+rtl_hps = 'rtl/ngage_mmc_hps.v'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def read_json(path):
+    return json.loads(path.read_bytes())
+
+
+def passes(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+def fingerprints(path, source_names):
+    entries = [shlex.split(line) for line in path.read_text().splitlines() if line.startswith('S ')]
+    result = {}
+    for name in source_names:
+        (entry,) = [entry for entry in entries if entry[-1].endswith(name)]
+        result[name] = entry[-2]
+    return result
+
+
+lineages = read_json(prep)
+stack = lineages['variants']['compact-plus-owner']
+lock = read_json(lock_receipt)
+hps = read_json(hps_receipt)['owner-plus-timer']
+assert digest(lock_receipt) == lineages['lock_qualification_sha256']
+assert digest(hps_receipt) == lineages['owner_qualification_sha256']
+assert stack['parent'] == hps['candidate']
+outcome = hps['verified_source_sha256'] | lock['source_sha256']
+assert all(digest(stage / 'source' / name) == value for name, value in outcome.items())
+pinned = {name: value for name, value in outcome.items() if name.startswith('rtl/')}
+assert len(pinned) == 5
+
+trial = read_json(out / 'mixed/source-hashes.json')
+reference = read_json(controls / 'mixed/source-hashes.json')
+assert len(trial) == 114 and trial.keys() == reference.keys()
+assert {name for name in trial if trial[name] != reference[name]} == {rtl_cpu}
+assert {name: trial[name] for name in pinned} == pinned
+compiled = fingerprints(out / 'mixed/obj/Vtb__verFiles.dat', pinned)
+assert compiled == hps['compiled_source_fingerprints'] | {rtl_cpu: lock['compiled_candidate_fingerprint']}
+
+hps_passes = passes(out / 'units/source.log')
+assert hps_passes == hps['native_hps_pass']
+assert fingerprints(out / 'units/source/obj/Vactual_tb__verFiles.dat', [rtl_hps])[rtl_hps] == compiled[rtl_hps]
+owner_miter = passes(out / 'owner-miter/miter.log')
+assert hps_passes[0] == owner_miter[0]
+assert owner_miter[1:] == ['PASS owner miter cases=448 wrap=49 reserved=24 random_edges=7168 compared=379781']
+assert owner_miter == passes(controls / 'owner-miter/miter.log')
+cpu_owners = passes(out / 'directed/directed.log')
+assert cpu_owners == lock['paired_fsm']
+assert passes(out / 'directed/formula.log') == lock['original_exhaustive_formula']
+
+workloads = {}
+for kind, key, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    file = out / f'qualification/{kind}.json'
+    data = read_json(file)
+    control = read_json(controls / f'qualification/{kind}.json')
+    assert data['status'] == control['status'] == 'PASS'
+    assert data['rows'] == control['rows']
+    assert sum(len(row['candidate'][key]) for row in data['rows']) == count
+    ctl = {name: data['source_sha256'][Path(name).name] for name in pinned if name != rtl_cpu}
+    assert ctl | {rtl_cpu: data['netlist_sha256']} == pinned
+    suffix = f'{kind}-candidate-cpu.v'
+    files = fingerprints(out / f'qualification/obj-{kind}/Vtb__verFiles.dat',
+                         [suffix if name == rtl_cpu else name for name in pinned])
+    files[rtl_cpu] = files.pop(suffix)
+    assert files == compiled
+    workloads[kind] = {'count': count, 'receipt_sha256': digest(file)}
+native = data['rows'][0]['candidate']
+workloads['native']['cycles'] = [frame['clocks'] for frame in native['frames']]
+workloads['native']['guest_result_sha256'] = native['output_sha256']
+
+board = {}
+for name in lock['board']:
+    trace = out / 'board/source' / name
+    ref = out / 'board/reference' / name
+    fingerprint = digest(trace)
+    assert fingerprint == digest(ref) == lock['board'][name]['sha256']
+    board[name] = {'sha256': fingerprint, 'pass': passes(trace)[0]}
+assert fingerprints(out / 'board/source/obj/Vcontract__verFiles.dat', [rtl_cpu])[rtl_cpu] == compiled[rtl_cpu]
+
+physical = {}
+for name, trace, log, events, cycles in (
+    ('normal', 'mixed/traffic.log', 'mixed/replay.log', 171496, 1201547),
+    ('timer_overlap', 'coexistence/candidate.trace', 'coexistence/candidate.log', 171497, 1201528),
+):
+    traffic = out / trace
+    note = passes(out / log)
+    assert digest(traffic) == digest(controls / trace)
+    assert len(traffic.read_bytes().splitlines()) == events
+    assert note == passes(controls / log) and f'cycles={cycles} reads=4 writes=1' in note[-1]
+    physical[name] = {'events': events, 'cycles': cycles, 'traffic_sha256': digest(traffic), 'passes': note}
+physical['timer_overlap']['guest_image_sha256'] = digest(out / 'coexistence/stress-timer.hex')
+
+receipt = {'status': 'PASS', 'candidate': stack['sha'], 'tree': stack['tree'],
+           'preflight_sha256': digest(prep), 'compact_qualification_sha256': digest(lock_receipt),
+           'owner_qualification_sha256': digest(hps_receipt), 'exact_source_sha256': outcome,
+           'compiled_source_fingerprints': compiled, 'physical_input_count': len(trial),
+           'simulator': (out / 'image.id').read_text().strip(),
+           'native_hps_pass': hps_passes, 'hps_owner_miter': owner_miter,
+           'compact_owner_directed': cpu_owners, 'board': board,
+           'workload_digest_controls': workloads, 'physical_replays': physical}
