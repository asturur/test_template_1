+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/dcache-compact-owner-combined
+out=build/sim/v5-104-dcache-compact-owner-combined
+mkdir -p "$out"
+docker image inspect -f '{{.Id}} {{.Os}}/{{.Architecture}}' jotego/simulator:arm64 > "$out/image.id"
+python3 -B "$area/replay.py" fixed --output qualification > "$out/fixed.log" 2>&1 &
+fixed=$!
+python3 -B "$area/replay.py" native --output qualification > "$out/native.log" 2>&1 &
+native=$!
+sh "$area/mixed.sh" > "$out/mixed.log" 2>&1 &
+mixed=$!
+sh "$area/board.sh" > "$out/board.log" 2>&1 &
+board=$!
+sh "$area/hps.sh" > "$out/hps.log" 2>&1 &
+hps=$!
+sh "$area/directed.sh" > "$out/directed.log" 2>&1 &
+directed=$!
+status=0
+for slot in "$fixed" "$native" "$mixed" "$board" "$hps" "$directed"; do
+  wait "$slot" || status=1
+done
+for log in fixed native mixed board hps directed; do
+  tail -6 "$out/$log.log"
+done
+exit "$status"
