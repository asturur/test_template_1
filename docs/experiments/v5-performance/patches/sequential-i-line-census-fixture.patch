+        hint_valid = 0;
+    end
+    // Current request is the I cache's owned miss. Do not count a request
+    // already selected by the I cache as a lookahead from decode.
+    if (`LA_CACHE.state_ff == `LA_CACHE.IDLE && `LA_CACHE.state_nxt == `LA_CACHE.FETCH_SINGLE) begin
+        demand_valid = `LA_FETCH.o_request && `LA_FETCH.f2[35] && !`LA_FETCH.killed;
+        demand_va = `LA_FETCH.f2[31:0];
+        demand_pa = `LA_CACHE.i_phy_addr;
+        demand_epoch = `LA_FETCH.f2[33:32];
+        demand_context = la_context;
+        demand_seq = seq_f2 && demand_va[4:0] == 0;
+        hint_to_demand = hint_valid && demand_seq && hint_target == demand_va &&
+                         hint_epoch == demand_epoch && hint_clock < cycles;
+    end
+
+    if (live_miss) begin
+        if (la_i_exposed) miss_exposed++;
+        if (`LA_FETCH.i_redirect || demand_epoch != `LA_FETCH.epoch)
+            live_miss = 0;
+        else if (`LA_CACHE.take && `LA_CACHE.o_wb_adr_ff[4:2] == demand_pa[4:2]) begin
+            hist_exposed += miss_exposed;
+            hist_ideal_exposed += la_min(miss_exposed, miss_ideal_lead);
+            hist_order_exposed += la_min(miss_exposed, miss_order_lead);
+            live_miss = 0;
+        end
+    end
+
+    if (board_claim) begin
+        prior_page = last_fill_valid && last_va[31:12] == demand_va[31:12] &&
+                     last_pa[31:12] == demand_pa[31:12] &&
+                     last_epoch == demand_epoch && last_context == demand_context;
+        same_page_seq = demand_seq && demand_va[11:0] != 0;
+        hint_match = hint_valid && hint_to_demand && prior_page && same_page_seq &&
+                     hint_target == demand_va && hint_epoch == demand_epoch &&
+                     hint_context == demand_context;
+        if (demand_valid && demand_pa[31:24] == 8'h0a &&
+            `LA_CPU.line_addr[31:5] == demand_pa[31:5] && dut.line_no_late_error) begin
+            hist_live++;
+            if (prior_page && last_va[31:5] + 27'd1 == demand_va[31:5] &&
+                last_pa[31:5] + 27'd1 == demand_pa[31:5])
+                hist_adjacency++;
+            if (demand_seq) hist_seq++;
+            else if (demand_va[4:0] == 0) hist_word0_nonseq++;
+            else hist_nonzero++;
+            if (same_page_seq) hist_seq_samepage++;
+            if (hint_match) begin
+                hist_hinted++;
+                miss_ideal_lead = 0;
+                miss_order_lead = 0;
+                if (hint_first_free >= 0) begin
+                    hist_first_free++;
+                    miss_ideal_lead = cycles - hint_first_free;
+                    hist_first_lead += miss_ideal_lead;
+                    hist_d_interposed += hint_saw_d;
+                    hist_lcd_interposed += hint_saw_lcd;
+                end else hist_no_free++;
+                if (hint_idle_run > 0) begin
+                    hist_free_run++;
+                    miss_order_lead = hint_idle_run;
+                    hist_run_lead += miss_order_lead;
+                    if (miss_order_lead > hist_max_order_lead)
+                        hist_max_order_lead = miss_order_lead;
+                end
+                live_miss = 1;
+                miss_exposed = 0;
+                hint_valid = 0;
+            end
+            last_va = demand_va; last_pa = demand_pa;
+            last_epoch = demand_epoch; last_context = demand_context;
+            last_fill_valid = 1;
+        end else last_fill_valid = 0;
+    end
+
+    if (hint_valid) begin
+        if (la_bus_free) begin
+            if (hint_first_free < 0) hint_first_free = cycles;
+            hint_idle_run++;
+        end else begin
+            hint_idle_run = 0;
+            if (hint_first_free >= 0) begin
+                hint_saw_d |= la_d_pending;
+                hint_saw_lcd |= la_lcd_pending;
+            end
+        end
+    end
+
+    // The decode input consumes a real frontend packet in the last two ARM
+    // word positions. Thumb halfwords in the same region also qualify.
+    tail_pc = `LA_FETCH.o_pc;
+    next_line = {tail_pc[31:5] + 27'd1, 5'd0};
+    if (`LA_FETCH.pop && tail_pc[4:3] == 2'b11 && !`LA_FETCH.o_predicted &&
+        !`LA_FETCH.o_fault && !`LA_FETCH.i_redirect && !la_invalidate &&
+        !(hint_valid && hint_target == next_line && hint_epoch == `LA_FETCH.epoch)) begin
+        if (tail_pc[11:5] == 7'h7f) tail_page_boundary++;
+        else begin
+            tail_hints++;
+            hint_valid = 1;
+            hint_target = next_line; hint_epoch = `LA_FETCH.epoch;
+            hint_context = la_context; hint_clock = cycles+1;
+            hint_first_free = -1; hint_idle_run = 0; hint_to_demand = 0;
+            hint_saw_d = 0; hint_saw_lcd = 0;
+        end
+    end
+endtask
+
+task automatic report_lookahead;
+    $display("LOOKAHEAD_DEMAND frame=%0d narrow=%0d adjacent=%0d sequential=%0d same_page=%0d word0_nonseq=%0d nonzero=%0d",
+        frame, hist_live, hist_adjacency, hist_seq, hist_seq_samepage, hist_word0_nonseq, hist_nonzero);
+    $display("LOOKAHEAD_HINT frame=%0d created=%0d page_boundary=%0d cancelled=%0d matched=%0d",
+        frame, tail_hints, tail_page_boundary, tail_cancelled, hist_hinted);
+    $display("LOOKAHEAD_BUS frame=%0d first_free=%0d no_free=%0d contiguous=%0d first_lead=%0d order_lead=%0d max_order=%0d d_interposed=%0d lcd_interposed=%0d",
+        frame, hist_first_free, hist_no_free, hist_free_run, hist_first_lead, hist_run_lead,
+        hist_max_order_lead, hist_d_interposed, hist_lcd_interposed);
+    $display("LOOKAHEAD_STALL frame=%0d matching_exposed=%0d ideal_exposed_bound=%0d order_exposed_bound=%0d",
+        frame, hist_exposed, hist_ideal_exposed, hist_order_exposed);
+endtask
