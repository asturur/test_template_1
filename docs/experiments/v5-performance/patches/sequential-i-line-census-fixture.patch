+function integer la_min(input integer a, b);
+    la_min = a < b ? a : b;
+endfunction
+
+task automatic reset_lookahead;
+    hist_live = 0; hist_adjacency = 0; hist_seq = 0; hist_seq_samepage = 0;
+    hist_word0_nonseq = 0; hist_nonzero = 0; tail_cancelled = 0; tail_hints = 0;
+    tail_page_boundary = 0; hist_hinted = 0; hist_first_free = 0; hist_free_run = 0;
+    hist_first_lead = 0; hist_run_lead = 0; hist_d_interposed = 0; hist_lcd_interposed = 0;
+    hist_no_free = 0; hist_exposed = 0; hist_ideal_exposed = 0; hist_order_exposed = 0;
+    hist_max_order_lead = 0;
+    live_miss = 0; demand_valid = 0; last_fill_valid = 0; hint_valid = 0;
+endtask
+
+task automatic observe_lookahead;
+    reg board_claim, same_page_seq, hint_match, prior_page;
+    reg [31:0] tail_pc, next_line;
+    board_claim = `LA_CPU.line_req && `LA_CPU.line_ready && `LA_CPU.wb_code;
+    if (la_invalidate || !`LA_IC.i_cache_en) begin
+        hint_valid = 0;
+        last_fill_valid = 0;
+    end
+    if (hint_valid && (cycles-hint_clock >= 64 || `LA_FETCH.i_redirect ||
