+    path.unlink()
+sys.path.insert(0, str(repo / "tests/cpu/arm9v2_board"))
+from payload_clocks import qualified_inputs
+ref = {r["case"]: r for r in json.loads((frozen / "result.json").read_text())["rows"]}
+kinds = ("LOOKAHEAD_DEMAND", "LOOKAHEAD_HINT", "LOOKAHEAD_BUS", "LOOKAHEAD_STALL")
+def simulate(case):
+    name = case["name"]
+    trace = f"requests-{name}.txt"
+    log = area / f"payload-{name}.log"
+    common = "+core=/frozen/" + str((frozen / f"{name}-False.bin").relative_to(repo))
+    with log.open("w") as handle:
+        subprocess.run(driver + ["/work/obj-payload/Vtb", image, "+ngage-compact-trace", "+no-board-log", common,
+            "+extension=/frozen/build/firmware/nem4-factory/extension.bin",
+            "+cdrive=/frozen/" + str((frozen / "cdrive.bin").relative_to(repo)),
+            f'+begin_pc={case["begin"]:x}', f'+end_pc={case["end"]:x}',
+            f'+payload_base={case["payload_base"]:x}', f'+helper_base={case["helper_base"]:x}',
