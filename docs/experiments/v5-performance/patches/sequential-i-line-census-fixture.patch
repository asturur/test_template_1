+argv = shlex.split(command.removeprefix('C "').removesuffix('"'))
+observer = (area / "lookahead.vh").read_text()
+observer = observer.replace("        frame,", "        window,")
+raw = (frozen / "tb.v").read_text()
+for old, new in (
+    ("        first_clock = cycles;", "        first_clock = cycles;\n        reset_lookahead();"),
+    ("    if (first_clock >= 0) begin", "    if (first_clock >= 0 && first_clock != cycles) observe_lookahead();\n    if (first_clock >= 0) begin"),
+    ('            $display("PAYLOAD_RESULT', '            report_lookahead();\n            $display("PAYLOAD_RESULT'),
+):
+    assert raw.count(old) == 1
+    raw = raw.replace(old, new)
+(workspace / "payload.sv").write_text(raw.rsplit("endmodule", 1)[0] + observer + "\nendmodule\n")
+for index, option in enumerate(argv):
