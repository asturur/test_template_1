+"""Separate preparation after a checked miss from blind early pin motion."""
+from pathlib import Path
+
+area = Path(__file__).resolve().parent
+source = (area / "lookahead.vh").read_text()
+
+def edit(text, old, new):
+    assert text.count(old) == 1, old
+    return text.replace(old, new)
+
+source = edit(source, "integer miss_ideal_lead, miss_order_lead, miss_exposed;",
+"""integer miss_ideal_lead, miss_order_lead, miss_exposed;
+integer miss_selected_clock;
+integer prep_cap, issue1_cap, issue2_cap, strict_cap;
+integer safe_matches, measure_prep, measure_issue1, measure_issue2, measure_strict;""")
+source = edit(source, "    hist_max_order_lead = 0;",
+"""    hist_max_order_lead = 0;
+    safe_matches = 0; measure_prep = 0; measure_issue1 = 0; measure_issue2 = 0;
+    measure_strict = 0;""")
+source = edit(source, "        demand_valid = `LA_FETCH.o_request",
+              "        miss_selected_clock = cycles;\n        demand_valid = `LA_FETCH.o_request")
+source = edit(source, "            hist_order_exposed += la_min(miss_exposed, miss_order_lead);",
+"""            hist_order_exposed += la_min(miss_exposed, miss_order_lead);
+            measure_prep += la_min(miss_exposed, prep_cap);
+            measure_issue1 += la_min(miss_exposed, issue1_cap);
+            measure_issue2 += la_min(miss_exposed, issue2_cap);
+            measure_strict += la_min(miss_exposed, strict_cap);""")
+source = edit(source, "                live_miss = 1;",
+"""                prep_cap = 0; issue1_cap = 0; issue2_cap = 0; strict_cap = 0;
+                // Tiny pages and small-page permission fields meet at 1 KiB.
+                // The last accepted virtual / physical mapping must match
+                // this subpage; skip hints crossing a subpage themselves.
+                if (last_va[31:10] == demand_va[31:10] &&
+                    last_pa[31:10] == demand_pa[31:10] && demand_va[9:0] != 0) begin
+                    safe_matches++;
+                    strict_cap = miss_order_lead;
+                    prep_cap = la_min(miss_order_lead, $max(0, cycles-miss_selected_clock-1));
+                    issue1_cap = la_min(miss_order_lead, $max(0, cycles-hint_clock-1));
+                    issue2_cap = la_min(miss_order_lead, $max(0, cycles-hint_clock-2));
+                end
+                live_miss = 1;""")
+source = source.replace("$max(0, cycles-miss_selected_clock-1)", "(cycles > miss_selected_clock + 1 ? cycles-miss_selected_clock-1 : 0)")
+source = source.replace("$max(0, cycles-hint_clock-1)", "(cycles > hint_clock + 1 ? cycles-hint_clock-1 : 0)")
+source = source.replace("$max(0, cycles-hint_clock-2)", "(cycles > hint_clock + 2 ? cycles-hint_clock-2 : 0)")
+source = edit(source, "        frame, hist_exposed, hist_ideal_exposed, hist_order_exposed);",
+"""        frame, hist_exposed, hist_ideal_exposed, hist_order_exposed);
+    $display("LOOKAHEAD_SPLIT frame=%0d safe_1k=%0d strict=%0d prep=%0d issue1=%0d issue2=%0d",
+        frame, safe_matches, measure_strict, measure_prep, measure_issue1, measure_issue2);""")
