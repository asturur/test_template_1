+`define LA_CPU dut.board.upp.cpu_inside.cpu
+`define LA_ZAP `LA_CPU.u_arm925t.u_zap
+`define LA_CORE `LA_ZAP.g_arm9.u_arm9_core
+`define LA_FETCH `LA_CORE.u_front_decode.u_fetch
+`define LA_IC `LA_ZAP.l_generate_with_cache_mmu.u_code_cache
+`define LA_CACHE `LA_IC.u_zap_cache_fsm
+`define LA_DC `LA_ZAP.l_generate_with_cache_mmu.u_data_cache
+
+// Reproduce F1/F2 advancement with one provenance bit only. Numerically
+// adjacent targets launched by prediction or redirect never count.
+reg seq_f1 = 0, seq_f2 = 0;
+always @(posedge clk) begin
+    if (reset || `LA_FETCH.i_redirect)
+        {seq_f1, seq_f2} <= 0;
+    else if (`LA_FETCH.advance) begin
+        seq_f2 <= seq_f1 && !`LA_FETCH.retry && !`LA_FETCH.killed;
+        seq_f1 <= !`LA_FETCH.retry && !`LA_FETCH.killed && !`LA_FETCH.predicted &&
+            `LA_FETCH.f1[35] && `LA_FETCH.f1[33:32] == `LA_FETCH.epoch &&
+            `LA_FETCH.f1[34] == `LA_FETCH.launch_thumb &&
+            `LA_FETCH.launch_pc[4:0] == 0 &&
+            `LA_FETCH.launch_pc == `LA_FETCH.f1[31:0] +
+                                    (`LA_FETCH.launch_thumb ? 32'd2 : 32'd4);
+    end
+end
+
+wire [47:0] la_context = {`LA_IC.i_mmu_en, `LA_IC.i_cache_en, `LA_IC.i_cpsr,
+    `LA_IC.i_sr, `LA_IC.i_dac_reg, `LA_CORE.o_pid[6:0]};
+wire la_invalidate = `LA_IC.i_tlb_inv || `LA_IC.i_cache_inv_req || `LA_IC.i_cache_clean_req;
+wire la_d_line = `LA_CPU.refill.state == 1 && !`LA_CPU.wb_code;
+wire la_d_pending = csreq || la_d_line || `LA_CORE.request ||
+    `LA_DC.o_writeback_busy;
+wire la_lcd_pending = lcd_fast_req || shared_dma_req;
+wire la_bus_free = !lock && !sreq && !sdr_busy && !ram_line_req && ram_line_ready &&
+    dut.line_ready && `LA_CPU.refill.state == 0 && !`LA_CPU.wb_cyc &&
+    !la_d_pending && !la_lcd_pending;
+wire la_i_exposed = !retire && !`LA_CPU.u_arm925t.dbg_wb_valid &&
+    !`LA_CPU.u_arm925t.dbg_wb_dvalid &&
+    !(`LA_CPU.u_arm925t.dbg_stall[0] || `LA_CORE.request) &&
+    !(|`LA_CPU.u_arm925t.dbg_stall[7:3]) &&
+    `LA_CPU.u_arm925t.dbg_stall[2] && `LA_CPU.u_arm925t.dbg_icache[5] && !`LA_IC.tlb_busy;
+
+integer hist_live, hist_adjacency, hist_seq, hist_seq_samepage, hist_word0_nonseq, hist_nonzero;
+integer tail_cancelled, tail_hints, tail_page_boundary;
+integer hist_hinted, hist_first_free, hist_free_run, hist_first_lead, hist_run_lead;
+integer hist_d_interposed, hist_lcd_interposed, hist_no_free, hist_exposed;
+integer hist_ideal_exposed, hist_order_exposed, hist_max_order_lead;
+reg hint_valid = 0;
+reg [31:0] hint_target;
+reg [1:0] hint_epoch;
+reg [47:0] hint_context;
+integer hint_clock, hint_first_free, hint_idle_run;
+reg hint_to_demand = 0, hint_saw_d = 0, hint_saw_lcd = 0;
+reg last_fill_valid = 0;
+reg [31:0] last_va, last_pa;
+reg [1:0] last_epoch;
+reg [47:0] last_context;
+reg demand_valid = 0, demand_seq;
+reg [31:0] demand_va, demand_pa;
+reg [1:0] demand_epoch;
+reg [47:0] demand_context;
+reg live_miss = 0;
+integer miss_ideal_lead, miss_order_lead, miss_exposed;
