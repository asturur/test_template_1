+results["sum"] = {name: {key: sum(row[key] for row in data) for key in data[0]
+                        if key not in ("frame", "max_order")} for name, data in rows.items()}
+(area / "result.json").write_text(json.dumps(results, indent=2) + "\n")
+for name, values in results["sum"].items():
+    print(name, values)
