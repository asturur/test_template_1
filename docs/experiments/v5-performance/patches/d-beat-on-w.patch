@@ -1419,6 +1419,104 @@ def prepare_wishbone_write_data(phone):
     return ''.join(modules)
 
 
+def prepare_data_cache_beats(phone):
+    """Clock D-cache beat validity alongside its count and victim mask."""
+    modules = re.split(r'(?=^module )', phone, flags=re.M)
+    slots = {part.split()[1]: i for i, part in enumerate(modules) if part.startswith('module ')}
+
+    top = slots['ngage2_zap_top']
+    modules[top] = edit(
+        modules[top],
+        '\t\t\tngage2_zap_dcache #(\n\t\t\t\t.CACHE_SIZE(DATA_CACHE_SIZE),',
+        "\t\t\tngage2_zap_dcache #(\n"
+        "\t\t\t\t.PREPARE_BEAT(DATA_CACHE_LINE == 32),\n"
+        "\t\t\t\t.CACHE_SIZE(DATA_CACHE_SIZE),")
+
+    cache = slots['ngage2_zap_dcache']
+    parameter = "\tparameter [0:0] LOCK_SPLIT = 1'b0;"
+    source = edit(modules[cache], parameter, parameter + "\n    parameter PREPARE_BEAT = 0;")
+    source = edit(source, '\tngage2_zap_dcache_fsm #(\n',
+                  '\tngage2_zap_dcache_fsm #(\n        .PREPARE_BEAT(PREPARE_BEAT),\n')
+    modules[cache] = source
+
+    fsm = slots['ngage2_zap_dcache_fsm']
+    source = edit(modules[fsm], parameter, parameter + "\n    parameter PREPARE_BEAT = 0;")
+    source = edit(source, '\twire writeback_next_valid = (take ? adr_ctr_inc : adr_ctr_ff) <= last_writeback_word;', '''
+    wire [1:0] clean_valid;
+    wire [1:0] fetch_valid;
+    generate
+        if (PREPARE_BEAT) begin : g_prepared_beat
+            // Check both strides for the counter and victim mask being installed.
+            // A live region or block-enable change can still select either stride.
+            wire [EVICT_INDEX_BITS-1:0] next_word = i_reset ? 0 : adr_ctr_nxt;
+            wire [EVICT_INDEX_BITS-1:0] next_scalar = next_word + 4'd1;
+            wire [EVICT_INDEX_BITS-1:0] next_block = next_word + 4'd4;
+            wire next_victim_high = state_ff[IDLE] ? i_cache_victim_halves[1] : victim_halves[1];
+            wire [EVICT_INDEX_BITS-1:0] scalar_last =
+                HALF_WRITEBACK && !next_victim_high ? CACHE_LINE / 8 - 1 : CACHE_LINE / 4 - 1;
+            wire [EVICT_INDEX_BITS-1:0] block_last = scalar_last - 4'd3;
+            localparam [EVICT_INDEX_BITS-1:0] FETCH_LAST = CACHE_LINE / 4 - 1;
+            reg [1:0] clean_scalar, clean_block, fetch_word;
+            always @(posedge i_clk) begin
+                clean_scalar <= {next_scalar <= scalar_last, next_word <= scalar_last};
+                clean_block <= {next_block <= block_last, next_word <= block_last};
+                fetch_word <= {next_scalar <= FETCH_LAST, next_word <= FETCH_LAST};
+            end
+            assign clean_valid = block_target ? clean_block : clean_scalar;
+            assign fetch_valid = fetch_word;
+        end else begin : g_live_beat
+            assign clean_valid = 2'b00;
+            assign fetch_valid = 2'b00;
+        end
+    endgenerate
+
+    wire writeback_live_valid = (take ? adr_ctr_inc : adr_ctr_ff) <= last_writeback_word;
+    wire fetch_live_valid = take ? beat_inc_ok : beat_cur_ok;
+    wire writeback_next_valid = PREPARE_BEAT
+        ? (take ? clean_valid[1] : clean_valid[0]) : writeback_live_valid;
+    wire fetch_next_valid = PREPARE_BEAT
+        ? (take ? fetch_valid[1] : fetch_valid[0]) : fetch_live_valid;
+    wire [31:0] clean_address_hold = clean_valid[0] ? wb_adr_cur : 32'b0;
+    wire [31:0] clean_address_next = clean_valid[1] ? wb_adr_inc : 32'b0;
+    wire [31:0] fetch_address_hold = fetch_valid[0] ? fetch_adr_cur : 32'b0;
+    wire [31:0] fetch_address_next = fetch_valid[1] ? fetch_adr_inc : 32'b0;
+`ifndef SYNTHESIS
+    always @(posedge i_clk)
+        if (!i_reset && PREPARE_BEAT) begin
+            if (state_ff[CLEAN_SINGLE] && (writeback_next_valid !== writeback_live_valid ||
+                o_wb_adr_nxt !== (writeback_live_valid ? (take ? wb_adr_inc : wb_adr_cur) : 32'b0)))
+                $fatal(1, "Prepared D-cache clean beat differs");
+            if (state_ff[FETCH_SINGLE] && (fetch_next_valid !== fetch_live_valid ||
+                o_wb_adr_nxt !== (fetch_live_valid ? (take ? fetch_adr_inc : fetch_adr_cur) : 32'b0)))
+                $fatal(1, "Prepared D-cache fetch beat differs");
+        end
+`endif'''.lstrip('\n'))
+    source = edit(source, '(state_ff[FETCH_SINGLE] && (take ? beat_inc_ok : beat_cur_ok));',
+                  '(state_ff[FETCH_SINGLE] && fetch_next_valid);')
+    source = edit(source, 'if ((take ? beat_inc_ok : beat_cur_ok)) begin', 'if (fetch_next_valid) begin')
+    for branch, following, held, successor in (
+        ('CLEAN_SINGLE', 'FETCH_SINGLE', 'wb_adr_cur', 'wb_adr_inc'),
+        ('FETCH_SINGLE', 'UNLOCK_REG', 'fetch_adr_cur', 'fetch_adr_inc'),
+    ):
+        opening = f'\t\t\tstate_ff[{branch}]: begin\n'
+        closing = f'\t\t\tstate_ff[{following}]: begin\n'
+        begin = source.index(opening)
+        end = source.index(closing, begin)
+        block = source[begin:end]
+        old_address = f'\t\t\t\t\to_wb_adr_nxt = (take ? {successor} : {held});\n'
+        block = edit(block, old_address,
+                     f'\t\t\t\t\tif (!PREPARE_BEAT)\n\t{old_address}')
+        assert block.endswith('\t\t\tend\n')
+        prefix = branch.split('_')[0].lower()
+        block = block[:-len('\t\t\tend\n')] + (
+            '                if (PREPARE_BEAT)\n'
+            f'                    o_wb_adr_nxt = take ? {prefix}_address_next : {prefix}_address_hold;\n'
+            '\t\t\tend\n')
+        source = source[:begin] + block + source[end:]
+    modules[fsm] = source
+    return ''.join(modules)
+
+
 def main():
     parser = argparse.ArgumentParser(description=__doc__)
     parser.add_argument('--stock', type=Path, help='Use the pinned Quartus-selected donor artifact')
@@ -1459,6 +1557,8 @@ def main():
         generated = prepare_w_completion(generated)
     generated = keep_wishbone_request_boundary(generated)
     generated = prepare_wishbone_write_data(generated)
+    if not args.hinted_ldm:
+        generated = prepare_data_cache_beats(generated)
     if args.check:
         if output.read_text() != generated:
             raise ValueError('Phone netlist is out of date')
