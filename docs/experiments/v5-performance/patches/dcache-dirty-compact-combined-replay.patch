+#!/bin/sh
+set -eu
+variant=${1:?supply a descriptor variant}
+phase=${2:-all}
+case "$variant" in
+  descriptor-on-timer|descriptor-plus-compact) ;;
+  *) exit 2 ;;
+esac
+area=scratch/v5-fit-loop/dcache-dirty-compact-combined
+stage=$area/$variant
+out=build/sim/v5-104-dcache-dirty-compact-combined/$variant
+image=jotego/simulator:arm64
+
+metadata_proof() {
+  python3 -B "$area/prepare-metadata-proof.py" "$variant"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$out/proof:/proof" -w /proof --entrypoint sh "$image" -ec '
+    iverilog -g2001 -s tb -o miter tb.v retained.v trial.v
+    vvp miter > miter.log
+    grep "^PASS dirty metadata lane comparisons=" miter.log'
+}
+
+lock_directed() {
+  python3 -B "$area/prepare-lock-directed.py" "$variant"
+  lock="$out/lock-directed"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$stage:/bench:ro" -v "$PWD/$lock:/results" \
+    -v "$PWD/$area/check-lock-update.v:/proof/check-lock-update.v:ro" -w /results \
+    --entrypoint sh "$image" -ec '
+    for leg in reference source; do
+      iverilog -g2001 -s background_load_lock_tb -o "$leg" "/bench/$leg/rtl/arm9v2/arm925t_phone.v" \
+        /bench/reference/tests/cpu/arm9v2_board/background_load_lock_tb.v
+      vvp "$leg" > "$leg.log"
+      grep "^PASS " "$leg.log"
+    done
+    cmp reference.log source.log
+    iverilog -g2001 -s background_load_lock_tb -o directed /bench/source/rtl/arm9v2/arm925t_phone.v reference.v tb.v
+    vvp directed > directed.log
+    grep "^PASS " directed.log
+    iverilog -g2001 -s check_lock_update -o formula /proof/check-lock-update.v
+    vvp formula > formula.log
+    grep "^PASS " formula.log'
+}
+
+physical() {
+  python3 -B "$area/mixed.py" "$variant"
+  docker image inspect -f '{{.Id}} {{.Os}}/{{.Architecture}}' "$image" > "$out/image.id"
+  mixed="$out/mixed"
+  control=build/sim/v5-104-timer-write-prepare/mixed
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD:/work" -w /work --entrypoint sh "$image" -ec "sh '$mixed/build.sh'
+'$mixed/obj/Vtb' +upp_stress '+compare_trace=$mixed/traffic.log' > '$mixed/replay.log'"
+  cmp "$control/traffic.log" "$mixed/traffic.log"
+  sh "$area/coexistence.sh" "$variant"
+}
+
+case "$phase" in
+  proof) metadata_proof; lock_directed ;;
+  board) sh "$area/board.sh" "$variant"; sh "$area/cp15-phase.sh" "$variant" ;;
+  physical) physical ;;
+  fixed|native) python3 -B "$area/replay.py" "$variant" "$phase" --output qualification ;;
+  all)
+    metadata_proof
+    lock_directed
+    sh "$area/board.sh" "$variant"
+    sh "$area/cp15-phase.sh" "$variant"
+    for kind in fixed native; do
+      python3 -B "$area/replay.py" "$variant" "$kind" --output qualification
+    done
+    physical
+    python3 -B "$area/record.py" "$variant"
+    ;;
+  *) exit 2 ;;
+esac
diff --git a/scratch/v5-fit-loop/dcache-dirty-compact-combined/record.py b/scratch/v5-fit-loop/dcache-dirty-compact-combined/record.py
