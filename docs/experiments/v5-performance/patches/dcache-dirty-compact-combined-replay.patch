index 0000000..0bb92f7
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-dirty-compact-combined/prepare-fit.py
@@ -0,0 +1,270 @@
+"""Prepare private D-cache dirty descriptor fits for either outcome of the compact-lock trial."""
+import ast
+from hashlib import sha256
+import json
+import os
+import re
+from pathlib import Path
+import subprocess
+import tarfile
+from io import BytesIO
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+catalog = root / 'docs/experiments/v5-performance'
+compact_stage = area.parent / 'dcache-compact-owner-combined/dispatch-20261126'
+active_compact = 'aaeef9ef24dc089255f7d41d0c7c4d32c2ba9179'
+active_timer = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+retained = '11c4a0c32983cc9aba89cae986684558583a33f2'
+private = area / 'dispatch-20261126'
+objects = private / 'objects'
+objects.mkdir(parents=True, exist_ok=True)
+controls = {13: 45824513460, 43: 45824520116, 31337: 45824525843}
+
+
+def git(*args, env=None):
+    return subprocess.check_output(['git', '-C', str(root), *args], env=env)
+
+
+def sha(data):
+    return sha256(data).hexdigest()
+
+
+shared_objects = git('rev-parse', '--path-format=absolute', '--git-path', 'objects').decode().strip()
+older_objects = (compact_stage / 'alternate-objects.txt').read_text().strip().split(os.pathsep)
+alternates = os.pathsep.join(dict.fromkeys([shared_objects, str(compact_stage / 'objects'), *older_objects]))
+assert all(Path(path).is_absolute() and Path(path).is_dir() for path in alternates.split(os.pathsep))
+(private / 'alternate-objects.txt').write_text(alternates + '\n')
+
+
+def context(index):
+    return os.environ | {
+        'GIT_OBJECT_DIRECTORY': str(objects),
+        'GIT_ALTERNATE_OBJECT_DIRECTORIES': alternates,
+        'GIT_INDEX_FILE': str(private / f'index-{index}'),
+    }
+
+
+def subject(revision, env):
+    return git('rev-parse', revision, env=env).decode().strip()
+
+
+def tree(revision, env):
+    return subject(f'{revision}^{{tree}}', env)
+
+
+def changes(before, after, env):
+    records = git('diff', '--name-only', '-z', before, after, env=env).split(b'\0')
+    return sorted(name.decode() for name in records if name)
+
+
+def file_hashes(revision, paths, env):
+    return {name: sha(git('show', f'{revision}:{name}', env=env)) for name in paths}
+
+
+def stage_tree(base, patches, env):
+    git('read-tree', base, env=env)
+    for patch in patches:
+        git('apply', '--cached', '--check', str(patch), env=env)
+        git('apply', '--cached', str(patch), env=env)
+    return git('write-tree', env=env).decode().strip()
+
+
+def commit(tree_id, base, message, env):
+    timestamp = int(git('show', '-s', '--format=%ct', base, env=env)) + 1
+    date = f'@{timestamp} +0000'
+    dated = env | {'GIT_AUTHOR_DATE': date, 'GIT_COMMITTER_DATE': date}
+    result = git('commit-tree', tree_id, '-p', base, '-m', message, env=dated).decode().strip()
+    assert tree(result, env) == tree_id and subject(f'{result}^', env) == base
+    return result
+
+
+def read_json(path):
+    return json.loads(path.read_text())
+
+
+entries = {entry['id']: entry for entry in read_json(catalog / 'manifest.json')}
+names = ('dcache-compact-lock', 'dcache-dirty-clean-descriptor')
+patches = {name: catalog / entries[name]['patches'][0] for name in names}
+proofs = {name: read_json(root / f'docs/evidence/v5-104-{name}.json') for name in names}
+patch_hashes = {name: sha(path.read_bytes()) for name, path in patches.items()}
+rtl, generator = 'rtl/arm9v2/arm925t_phone.v', 'tools/gen_arm9v2_phone.py'
+paths = sorted((rtl, generator))
+for name in names:
+    assert proofs[name]['status'] == 'PASS' and proofs[name]['base'] == active_timer
+    assert entries[name]['base'] == retained
+    assert patch_hashes[name] == entries[name]['sha256'][0] == proofs[name]['design_patch_sha256']
+    assert entries[name]['affected_paths'] == paths
+    assert entries[name]['measured_sha256'] == proofs[name]['source_sha256']
+compact_patch, descriptor_patch = (patches[name] for name in names)
+compact_proof, descriptor_proof = (proofs[name] for name in names)
+compact_preflight = read_json(compact_stage / 'prepare.json')['variants']['compact-on-timer']
+assert (compact_stage / 'compact-on-timer.sha').read_text().strip() == active_compact
+assert compact_preflight['sha'] == active_compact
+
+env = context('proof')
+timer_tree = tree(active_timer, env)
+assert timer_tree == compact_proof['base_tree']
+assert tree(subject(f'{active_compact}^', env), env) == timer_tree
+assert file_hashes(active_timer, paths, env) == compact_proof['reference_sha256'] == descriptor_proof['reference_sha256']
+assert file_hashes(retained, paths, env) == descriptor_proof['reference_sha256']
+assert stage_tree(active_timer, [compact_patch], env) == tree(active_compact, env)
+assert tree(active_compact, env) == compact_preflight['tree']
+assert changes(active_timer, active_compact, env) == paths
+assert file_hashes(active_compact, paths, env) == compact_proof['source_sha256']
+
+standalone = stage_tree(active_timer, [descriptor_patch], env)
+assert changes(active_timer, standalone, env) == paths
+assert file_hashes(standalone, paths, env) == descriptor_proof['source_sha256']
+
+restore = commit(timer_tree, active_compact, 'revert: restore retained timer fit tree', env)
+assert changes(active_compact, restore, env) == paths
+(private / 'restore.sha').write_text(restore + '\n')
+message = 'perf: preselect D-cache dirty-clear descriptor'
+
+def modules(revision):
+    text = git('show', f'{revision}:{rtl}', env=env).decode()
+    return {name: body for name, body in re.findall(r'^module (\w+) (\(.*?^endmodule)$', text, re.M | re.S)}
+
+
+def transforms(revision):
+    source = git('show', f'{revision}:{generator}', env=env)
+    return {node.name: ast.dump(node) for node in ast.parse(source).body
+            if isinstance(node, ast.FunctionDef) and node.name != 'main'}
+
+
+reference_modules = modules(active_timer)
+compact_modules = modules(active_compact)
+descriptor_modules = modules(standalone)
+compact_scope = {'ngage2_arm925t', 'ngage2_zap_dcache_fsm', 'ngage2_zap_dcache', 'ngage2_zap_top'}
+descriptor_scope = {'ngage2_zap_dcache_half_tag_ram'}
+assert reference_modules.keys() == compact_modules.keys() == descriptor_modules.keys()
+assert {name for name in reference_modules if compact_modules[name] != reference_modules[name]} == compact_scope
+assert {name for name in reference_modules if descriptor_modules[name] != reference_modules[name]} == descriptor_scope
+
+stock = root / 'build/arm9v2-assoc/stock-pinned.v'
+variants = {}
+for label, parent in (('descriptor-on-timer', restore), ('descriptor-plus-compact', active_compact)):
+    env = context(label)
+    candidate_tree = stage_tree(parent, [descriptor_patch], env)
+    candidate = commit(candidate_tree, parent, message, env)
+    keeps_compact = label == 'descriptor-plus-compact'
+    assert changes(parent, candidate, env) == paths
+    assert changes(active_timer, candidate, env) == paths
+    synthesized = modules(candidate)
+    expected = compact_modules if keeps_compact else reference_modules
+    assert synthesized == (expected | {name: descriptor_modules[name] for name in descriptor_scope})
+    delta_path = area / f'{label}.patch'
+    delta_path.write_bytes(git('diff', parent, candidate, '--', *paths, env=env))
+    assert stage_tree(parent, [delta_path], context('verify-patch')) == candidate_tree
+    if keeps_compact:
+        assert stage_tree(active_timer, [descriptor_patch, compact_patch], context('compose')) == candidate_tree
+        assert stage_tree(active_timer, [compact_patch, descriptor_patch], context('compose')) == candidate_tree
+        combined_transforms = transforms(candidate)
+        for independent in (active_compact, standalone):
+            assert all(combined_transforms[name] == body for name, body in transforms(independent).items())
+        assert combined_transforms.keys() == transforms(active_compact).keys() | transforms(standalone).keys()
+    else:
+        assert standalone == candidate_tree
+    hashes = file_hashes(candidate, paths, env)
+    variants[label] = {'sha': candidate, 'parent': parent, 'tree': candidate_tree,
+                       'paths_since_parent': paths, 'file_sha256': hashes,
+                       'delta_patch_sha256': sha(delta_path.read_bytes()),
+                       'changed_modules': sorted(descriptor_scope | (compact_scope if keeps_compact else set()))}
+    (private / f'{label}.sha').write_text(candidate + '\n')
+
+    included = ('rtl', 'tools', 'tests/cpu/arm9v2_board', 'tests/cpu/spmark_payload',
+                'tests/phone/upp_ddr_ram/peer.v', 'tests/phone/timers', 'sim/programs/link.ld')
+    for leg, revision in (('source', candidate), ('reference', active_timer)):
+        directory = area / label / leg
+        directory.mkdir(parents=True, exist_ok=True)
+        content = git('archive', revision, *included, env=env)
+        with tarfile.open(fileobj=BytesIO(content)) as archive:
+            archive.extractall(directory, filter='data')
+        cmd = ['python3', '-B', str(directory / generator), '--stock', str(stock)]
+        subprocess.run([*cmd, '--check'], cwd=directory, check=True)
+        subprocess.run(cmd, cwd=directory, check=True)
+        subprocess.run([*cmd, '--check'], cwd=directory, check=True)
+        assert sha((directory / rtl).read_bytes()) == file_hashes(revision, (rtl,), env)[rtl]
+    staged = area / label
+    for name, value in hashes.items():
+        assert sha((staged / 'source'/name).read_bytes()) == value, (label, name)
+    (staged / 'ngage_cpu.sv').write_bytes((staged / 'source/rtl/ngage_cpu.sv').read_bytes())
+
+production_tools = ('set_quartus_seed', 'set_quartus_debug', 'record_fit_inputs')
+for label, metadata in variants.items():
+    env = context(label)
+    candidate = metadata['sha']
+    variant_dir = private / 'preflight' / label
+    variant_dir.mkdir(parents=True, exist_ok=True)
+    metadata['production'] = {}
+    for seed, run in controls.items():
+        control_dir = root / f'build/timing-audit-{run}/output_files'
+        control = read_json(control_dir / 'resident-fit-manifest.json')
+        basenames = control['compiled_source_sha256'].keys()
+        assert control['actual_commit'] == active_timer and tree(control['actual_commit'], env) == timer_tree
+        assert control['seed'] == seed and control['physical_cpu_mhz'] == 104 and control['debugger'] is False
+        assert len(basenames) == 133 and 'Template.qsf' in basenames
+        seed_dir = variant_dir / str(seed)
+        output_dir = seed_dir / 'output_files'
+        output_dir.mkdir(parents=True, exist_ok=True)
+        source_graph = (control_dir / 'source-graph.txt').read_text()
+        graphed = {line.removeprefix('SOURCE /project/') for line in source_graph.splitlines()
+                   if line.startswith('SOURCE ')}
+        assert graphed == set(basenames), sorted(graphed ^ set(basenames))
+        (output_dir / 'source-graph.txt').write_text(source_graph)
+        for name in (*basenames, *(f'tools/{tool}.py' for tool in production_tools)):
+            assert not Path(name).is_absolute() and '..' not in Path(name).parts
+            path = seed_dir / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(git('show', f'{candidate}:{name}', env=env))
+        local_env = os.environ | {'GITHUB_SHA': candidate}
+        for name in ('GITHUB_STEP_SUMMARY', 'GITHUB_RUN_ID'):
+            local_env.pop(name, None)
+        for tool, *args in (
+            ('set_quartus_seed', 'Template.qsf', '--seed', str(seed)),
+            ('set_quartus_debug', 'Template.qsf', '--enabled', 'false'),
+        ):
+            subprocess.run(['python3', '-B', f'tools/{tool}.py', *args],
+                           cwd=seed_dir, env=local_env, check=True, stdout=subprocess.PIPE)
+        qsf = seed_dir / 'Template.qsf'
+        # Quartus on the runner rewrites the version line with LF, leaving
+        # the rest of the generated QSF at its original CRLF line endings.
+        qsf.write_bytes(qsf.read_bytes().replace(b'LAST_QUARTUS_VERSION "17.0.2 Standard Edition"\r\n',
+                                                 b'LAST_QUARTUS_VERSION "17.0.2 Lite Edition"\n'))
+        subprocess.run(['python3', '-B', 'tools/record_fit_inputs.py'],
+                       cwd=seed_dir, env=local_env, check=True, stdout=subprocess.PIPE)
+        effective = output_dir / 'resident-fit-manifest.json'
+        compiled = read_json(effective)
+        assert compiled['actual_commit'] == candidate
+        actual_hashes = compiled['compiled_source_sha256']
+        expected_delta = {rtl: metadata['file_sha256'][rtl]}
+        if label == 'descriptor-plus-compact':
+            old = compact_stage / f'preflight/compact-on-timer/{seed}/output_files/resident-fit-manifest.json'
+            compact = read_json(old)
+            assert compact['actual_commit'] == active_compact
+            assert {name for name in basenames
+                    if actual_hashes[name] != compact['compiled_source_sha256'][name]} == {rtl}
+            assert all(compact[field] == compiled[field]
+                       for field in compiled.keys() - {'actual_commit', 'compiled_source_sha256'})
+        actual_delta = {name: actual_hashes[name] for name in basenames
+                        if actual_hashes[name] != control['compiled_source_sha256'][name]}
+        assert actual_delta == expected_delta, (label, seed, actual_delta, expected_delta)
+        for field in control.keys() - {'actual_commit', 'compiled_source_sha256'}:
+            assert control[field] == compiled[field], field
+        metadata['production'][seed] = {
+            'control_run': run, 'physical_cpu_mhz': compiled['physical_cpu_mhz'],
+            'ddr_debug': compiled['debugger'], 'compiled_source_count': len(basenames),
+            'compiled_input_delta': expected_delta, 'manifest_sha256': sha(effective.read_bytes()),
+        }
+        print(f'PASS {label} seed {seed}, 104 MHz, DDR debug off, {len(basenames)} inputs', flush=True)
+
+receipt = {'status': 'PASS', 'active_timer': active_timer, 'active_compact': active_compact,
+           'timer_tree': timer_tree, 'restore': restore, 'restore_parent': active_compact,
+           'archive_patch_sha256': patch_hashes, 'pinned_donor_sha256': sha(stock.read_bytes()),
+           'private_objects': str(objects), 'alternate_objects': alternates, 'variants': variants}
+(private / 'prepare.json').write_text(json.dumps(receipt, indent=2) + '\n')
+for label, variant in variants.items():
+    print(label, variant['sha'], variant['parent'], variant['tree'])
+print('restore', restore, active_compact, timer_tree)
