+edit("      .o_wb_stb_ff(wb_stb),", """      .o_wb_stb_ff(wb_stb),
+      .o_wb_wen_ff(wb_write),""")
+marker = '  always #5 clk = !clk;'
+start = bench.index('  reference_zap_dcache_fsm #(')
+end = bench.index('  );', start) + len('  );')
+inst = bench[start:end]
+outputs = {'bitmap': (131, 68), 'returned': (67, 4), 'lock_valid': (3, 3),
+           'owner': (2, 2), 'lock_return': (1, 1), 'wb_stb': (0, 0)}
+checked = {'idle': 6, 'fill': 5, 'ack': 4, 'error': 3, 'wb_write': 2}
+# The tag is checked independently with its full six-bit width.
+decl = '''  assign reference_lock_state = {bitmap, returned, lock_valid, owner, lock_return, wb_stb};
+  always @(negedge clk) begin
+    #0.1;
+    if (reference_lock_state !== legacy_lock_state || reference_lock_state !== compact_lock_state ||
+        {idle, fill, ack, error, wb_write} !== legacy_handshake[6:2] ||
+        {idle, fill, ack, error, wb_write} !== compact_handshake[6:2] ||
+        lock_tag !== legacy_tag || lock_tag !== compact_tag ||
+        (|returned && (returned_data !== legacy_data || returned_data !== compact_data)))
+      $fatal(1, "Lock owner, bitmap, data or handshake diverged at %t", $time);
+    if (!reset) compare_cycles = compare_cycles + 1;
+  end
+'''
+copies = []
+for leg, opt in (('legacy', ''), ('compact', ",\n      .COMPACT_LOCK(1'b1)")):
+    copy = inst.replace('reference_zap_dcache_fsm', 'ngage2_zap_dcache_fsm')
+    copy = copy.replace('.LOCK_SPLIT(1)', f'.LOCK_SPLIT(1){opt if keeps_compact else ""}').replace(') cache (', f') {leg} (')
+    for signal, (top, bottom) in outputs.items():
+        slc = str(top) if top == bottom else f'{top}:{bottom}'
+        copy, count = re.subn(r'(\.o_\w+\()' + signal + r'(\))',
+                              rf'\g<1>{leg}_lock_state[{slc}]\g<2>', copy)
+        assert count == 1, signal
+    for signal, bit in checked.items():
+        copy, count = re.subn(r'(\.o_\w+\()' + signal + r'(\))',
+                              rf'\g<1>{leg}_handshake[{bit}]\g<2>', copy)
+        assert count == 1, signal
+    copies.append(copy.replace('(returned_data)', f'({leg}_data)').replace('(lock_tag)', f'({leg}_tag)'))
+edit(marker, '\n\n'.join([*copies, decl, marker]))
+edit('      destination = tag;\n      read = 1;', '''      destination = tag;
+      owner_hold = tag ^ 6'h3f;
+      owner_advance = tag;
+      owner_move = 1;
+      read = 1;''')
+edit('        $fatal(1, "Wrong miss owner %0d", tag);\n      read = 0;', '''        $fatal(1, "Wrong miss owner %0d", tag);
+      if (!owner || lock_return)
+        $fatal(1, "Advance must admit the new tag while the held tag stays unlocked");
+      read = 0;''')
+edit('        wb_ack  = 1;\n        tick;', '''        owner_hold = tag;
+        owner_advance = tag ^ 6'h3f;
+        owner_move = beat[0];
+        wb_ack = !abort_refill || beat != critical;
+        wb_error = abort_refill && beat == critical;
+        tick;''')
+edit('        wb_ack = 0;\n        tick;', '''        if (beat <= critical && (owner !== !owner_move || !lock_return))
+          $fatal(1, "Held and advancing owners did not use the registered return edge");
+        wb_ack = 0;
+        wb_error = 0;
+        tick;
+        if (beat >= critical && (owner || lock_return))
+          $fatal(1, "Returned destination remained locked");''')
+edit('  initial begin\n    repeat (2) tick;', '''  task simultaneous;
+    input [5:0] incoming;
+    begin
+      reset = 1;
+      tick;
+      reset = 0;
+      // Force an IDLE register image with a coincident old return. Natural
+      // refill traffic clears the owner before IDLE, so test priority here.
+      force cache.lock_ff = 64'h80;
+      force cache.o_lock_any = 1'b1;
+      force cache.o_lock_tag = 6'd7;
+      force cache.o_reg_idx = 64'h80;
+      force legacy.g_bitmap_lock.lock_ff = 64'h80;
+      force legacy.o_lock_any = 1'b1;
+      force legacy.o_lock_tag = 6'd7;
+      force legacy.o_reg_idx = 64'h80;
+      force compact.o_lock_any = 1'b1;
+      force compact.o_lock_tag = 6'd7;
+      force compact.o_reg_idx = 64'h80;
+      force compact.g_compact_lock.return_ff = 1'b1;
+      #0.5;
+      release cache.lock_ff;
+      release cache.o_lock_any;
+      release cache.o_lock_tag;
+      release cache.o_reg_idx;
+      release legacy.g_bitmap_lock.lock_ff;
+      release legacy.o_lock_any;
+      release legacy.o_lock_tag;
+      release legacy.o_reg_idx;
+      release compact.o_lock_any;
+      release compact.o_lock_tag;
+      release compact.o_reg_idx;
+      release compact.g_compact_lock.return_ff;
+      owner_hold = 7;
+      owner_advance = incoming;
+      owner_move = 1;
+      destination = incoming;
+      read = 1;
+      #1;
+      if (!cache.lock_set_nxt) $fatal(1, "Synthetic simultaneous new install did not settle");
+      tick;
+      if (!lock_valid || lock_tag !== incoming || !owner || lock_return !== (incoming == 7))
+        $fatal(1, "Simultaneous old return and new install lost the incoming owner");
+      read = 0;
+      return_installs = return_installs + 1;
+    end
+  endtask
+
+  initial begin
+    repeat (2) tick;''')
+edit('    $display("PASS background load tags', '''    victim_valid = 1;
+    victim_dirty = 1;
+    victim_tag = {27'h501800, 19'b0};
+    start_miss(6'd58, 32'h0a030000, 3'd7);
+    for (tag = 0; tag < 8; tag = tag + 1) begin
+      while (!wb_stb) tick;
+      if (!wb_write || !lock_valid || |returned)
+        $fatal(1, "Aliasing dirty victim lost its new fill owner");
+      wb_ack = 1;
+      tick;
+      wb_ack = 0;
+      tick;
+    end
+    victim_valid = 0;
+    victim_dirty = 0;
+    abort_refill = 1;
+    drain_fill(6'd58, 3'd7);
+    cache_aborts = cache_aborts + 1;
+    abort_refill = 0;
+
+    start_miss(6'd28, 32'h0a044000, 3'd0);
+    while (!wb_stb) tick;
+    wb_ack = 1;
+    reset = 1;
+    tick;
+    if (lock_valid || bitmap || returned || owner || lock_return)
+      $fatal(1, "Reset did not take precedence over the returning fill");
+    wb_ack = 0;
+    reset = 0;
+
+    simultaneous(6'd7);
+    simultaneous(6'd54);
+    $display("PASS compact lock comparison cycles=%0d simultaneous=%0d cached_errors=%0d",
+             compare_cycles, return_installs, cache_aborts);
+    $display("PASS background load tags''')
+if not keeps_compact:
+    bench = bench.replace('legacy.g_bitmap_lock.lock_ff', 'legacy.lock_ff')
+    bench = bench.replace("force compact.g_compact_lock.return_ff = 1'b1;", "force compact.lock_ff = 64'h80;")
