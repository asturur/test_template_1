+assert match(out / 'coexistence/stress-timer.hex', control / 'coexistence/stress-timer.hex')
+
+timing = {}
+for seed, run in ((13, 45824513460), (43, 45824520116), (31337, 45824525843)):
+    old = Path(f'build/timing-audit-{run}/output_files')
+    provenance = load(old / 'resident-fit-manifest.json')
+    assert provenance['actual_commit'] == base and provenance['seed'] == seed
+    assert provenance['physical_cpu_mhz'] == 104 and provenance['debugger'] is False
+    assert provenance['compiled_source_sha256'][rtl] == baseline_hashes[rtl]
+    corners = {}
+    for path in sorted((old / 'timing/resident-store/104').glob('corner-*/setup.csv')):
+        with path.open() as handle:
