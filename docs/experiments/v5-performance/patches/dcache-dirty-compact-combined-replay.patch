+++ b/scratch/v5-fit-loop/dcache-dirty-compact-combined/record.py
@@ -0,0 +1,178 @@
+"""Verify the dirty-clear fit witness and all matched timer-base replays."""
+import csv
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import sys
+
+
+area = Path(__file__).resolve().parent
+variant = sys.argv[1]
+assert variant in ('descriptor-on-timer', 'descriptor-plus-compact')
+stage = area / variant
+out = Path('build/sim/v5-104-dcache-dirty-compact-combined') / variant
+control = Path('build/sim/v5-104-timer-write-prepare')
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+changed = [rtl, generator]
+base = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def match(left, right):
+    assert left.read_bytes() == right.read_bytes(), (left, right)
+    return digest(left)
+
+
+def fingerprint(manifest, file):
+    rows = [shlex.split(line) for line in manifest.read_text().splitlines()
+            if line.startswith('S ') and shlex.split(line)[-1].endswith(file)]
+    (row,) = rows
+    return row[-2]
+
+
+prepare_path = area / 'dispatch-20261126/prepare.json'
+prepare = load(prepare_path)
+spec = prepare['variants'][variant]
+patch = area / f'{variant}.patch'
+assert prepare['status'] == 'PASS' and prepare['active_timer'] == base
+stats = subprocess.check_output(['git', 'apply', '--numstat', str(patch)], text=True)
+assert [line.split('\t')[-1] for line in stats.splitlines()] == changed
+candidate = {name: digest(stage / 'source' / name) for name in changed}
+baseline_hashes = {name: digest(stage / 'reference' / name) for name in changed}
+assert candidate == spec['file_sha256'] and digest(patch) == spec['delta_patch_sha256']
+descriptor_proof = load(Path('docs/evidence/v5-104-dcache-dirty-clean-descriptor.json'))
+compact_proof = load(Path('docs/evidence/v5-104-dcache-compact-lock.json'))
+assert descriptor_proof['status'] == compact_proof['status'] == 'PASS'
+assert baseline_hashes == descriptor_proof['reference_sha256'] == compact_proof['reference_sha256']
+assert (candidate == descriptor_proof['source_sha256']) == (variant == 'descriptor-on-timer')
+assert candidate != compact_proof['source_sha256']
+
+proof = out / 'proof/miter.log'
+assert 'PASS dirty metadata lane comparisons=163840' in proof.read_text()
+lock = out / 'lock-directed'
+assert match(lock / 'reference.log', lock / 'source.log')
+assert 'PASS background load tags' in (lock / 'source.log').read_text()
+label = 'compact' if variant == 'descriptor-plus-compact' else 'legacy'
+paired_summary = f'PASS {label} lock comparison cycles=1281 simultaneous=2 cached_errors=1'
+assert paired_summary in (lock / 'directed.log').read_text()
+assert 'PASS scalar valid equals bitmap nonempty over 1064960 transitions' in (lock / 'formula.log').read_text()
+
+boards = {}
+for name, modes in (('board', ('',)), ('cp15-phase', ('-normal', '-error'))):
+    rows = {}
+    for burst in (0, 1):
+        for wait in (0, 5):
+            for mode in modes:
+                profile = f'burst-{burst}-wait-{wait}{mode}'
+                filename = f'{profile}.trace'
+                trace = out / name / 'source' / filename
+                trace_sha = match(trace, out / name / 'reference' / filename)
+                lines = trace.read_text()
+                row = {'cycles': int(re.search(r'^PASS cycles=(\d+)', lines, re.M)[1]),
+                       'trace_sha256': trace_sha}
+                if mode:
+                    [end] = re.findall(r'^CLEAN_END .*$', lines, re.M)
+                    errors, count, stalls = map(int, re.search(
+                        r'^CLEAN_PHASE PASS errors=(\d+) completions=(\d+) stalled=(\d+)$', lines, re.M).groups())
+                    assert errors == (mode == '-error') and count == 1 and stalls > 0
+                    row.update(last_beat=end, errors=errors, completions=count, stalled_cycles=stalls)
+                rows[profile] = row
+    boards[name] = rows
+
+old_mixed = control / 'mixed'
+mixed = out / 'mixed'
+manifest = load(mixed / 'source-hashes.json')
+old_manifest = load(old_mixed / 'source-hashes.json')
+assert manifest.keys() == old_manifest.keys() and len(manifest) == 114
+assert {name: value for name, value in manifest.items() if value != old_manifest[name]} == {rtl: candidate[rtl]}
+assert digest(mixed / 'source' / rtl) == manifest[rtl]
+compiled_cpu = fingerprint(mixed / 'obj/Vtb__verFiles.dat', f'{mixed}/source/{rtl}')
+for board in ('board', 'cp15-phase'):
+    assert fingerprint(out / board / 'source/obj/Vcontract__verFiles.dat', rtl) == compiled_cpu
+    assert fingerprint(out / board / 'reference/obj/Vcontract__verFiles.dat', rtl) != compiled_cpu
+
+workloads = {}
+for kind, field, expected in (('fixed', 'windows', 105), ('native', 'frames', 4)):
