+++ b/scratch/v5-fit-loop/dcache-dirty-compact-combined/prepare-cp15-phase.py
@@ -0,0 +1,70 @@
+"""Add a repeated CP15 clean and one final-beat Wishbone error to the board deck."""
+from pathlib import Path
+import sys
+
+
+root = Path(__file__).resolve().parent
+variant = sys.argv[1]
+assert variant in ('descriptor-on-timer', 'descriptor-plus-compact')
+area = root / variant
+board = 'tests/cpu/arm9v2_board'
+out = Path(f'build/sim/v5-104-dcache-dirty-compact-combined/{variant}/cp15-phase')
+out.mkdir(parents=True, exist_ok=True)
+
+
+def edit(text, before, after):
+    assert text.count(before) == 1, before
+    return text.replace(before, after)
+
+
+guest = (area / 'reference' / board / 'contract.S').read_text()
+# Clean the same line again before invalidation. The backing write is
+# counted below, so an already-clear line cannot emit another burst.
+guest = edit(guest, '    mcr p15,0,r8,c7,c10,1\n',
+             '    mcr p15,0,r8,c7,c10,1\n    mcr p15,0,r8,c7,c10,1\n')
+(out / 'guest.S').write_text(guest)
+
+bench = (area / 'reference' / board / 'contract.v').read_text()
+bench = edit(bench, '  wire slow_cyc, slow_stb, slow_idle, slow_ack, slow_error;',
+             '  wire route_ack, route_error;\n  wire slow_cyc, slow_stb, slow_idle, slow_ack, slow_error;')
+bench = edit(bench, '      .master_ack(ack),\n      .master_error(error),',
+             '      .master_ack(route_ack),\n      .master_error(route_error),')
+tag = 'cpu.u_arm925t.u_zap.l_generate_with_cache_mmu.u_data_cache.u_zap_cache_tag_ram'
+inject = f"""
+  integer clean_errors = 0, initial_clean_ends = 0, clean_stalls = 0;
+  wire inject_error = $test$plusargs("maintenance-error");
+  wire initial_clean_offer = cyc && stb && write && address == 32'h0a00000c &&
+      ({tag}.state_ff == 13'd32) && cti == 3'b111;
+  wire initial_clean_last = initial_clean_offer && route_ack && ram_ack &&
+      ram_saved_write && ram_index == 14'd3;
+  wire injected_clean_error = inject_error && initial_clean_last && clean_errors == 0;
+  assign ack = route_ack && !injected_clean_error;
+  assign error = route_error || injected_clean_error;
+  always @(posedge clk) if (!reset) begin
+    if (initial_clean_offer && !ack && !error) begin
+      if ({tag}.tag_ram_clean)
+        $fatal(1, "Stalled final beat completed dirty writeback");
+      clean_stalls <= clean_stalls + 1;
+    end
+    if (initial_clean_last) begin
+      // The production merger reports successful or errored Wishbone
+      // termination to the tag controller through its existing ACK input.
+      if (!{tag}.tag_ram_clean)
+        $fatal(1, "Final Wishbone termination did not complete dirty writeback");
+      if (injected_clean_error) clean_errors <= clean_errors + 1;
+      $display("CLEAN_END cycle=%0d address=%h error=%b", cycle, address, injected_clean_error);
+      initial_clean_ends <= initial_clean_ends + 1;
+    end
+    if (device_ack && device_write && device_address == 32'hf0000000) begin
+      if (clean_errors != int'(inject_error) || initial_clean_ends != 1 || clean_stalls == 0)
+        $fatal(1, "Expected one completed writeback, an observed stall and no repeat write");
+      $display("CLEAN_PHASE PASS errors=%0d completions=%0d stalled=%0d",
+               clean_errors, initial_clean_ends, clean_stalls);
+    end
+  end
+"""
+bench = edit(bench, '  assign ram_ack = ram_pending && ram_delay == 0;\n',
+             '  assign ram_ack = ram_pending && ram_delay == 0;\n' + inject)
+bench = edit(bench, '        if (ram_saved_write) begin\n',
+             '        if (ram_saved_write && !injected_clean_error) begin\n')
+(out / 'contract.v').write_text(bench)
diff --git a/scratch/v5-fit-loop/dcache-dirty-compact-combined/prepare-metadata-proof.py b/scratch/v5-fit-loop/dcache-dirty-compact-combined/prepare-metadata-proof.py
