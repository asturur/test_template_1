@@ -0,0 +1,194 @@
+"""Run exact retained, candidate legacy and compact FSMs in the same fixture."""
+from pathlib import Path
+import re
+import sys
+
+
+area = Path(__file__).resolve().parent
+variant = sys.argv[1]
+assert variant in ('descriptor-on-timer', 'descriptor-plus-compact')
+stage = area / variant
+keeps_compact = variant == 'descriptor-plus-compact'
+out = Path(f'build/sim/v5-104-dcache-dirty-compact-combined/{variant}/lock-directed')
+out.mkdir(parents=True, exist_ok=True)
