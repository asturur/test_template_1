+        target = [row for row in rows if 'ngage2_zap_dcache_half_tag_ram' in row['to'] and 'dirty_rams' in row['to']]
+        launches = [row for row in target if 'ngage2_zap_wb_merger' in row['from'] and row['from'].endswith('|o_wb_cyc')]
+        corners[path.parent.name] = {'dirty_ram_endpoints': len(target), 'wb_cyc_paths': len(launches),
+                                    'worst_wb_cyc_path': launches[0] if launches else None}
+    assert len(corners) == 4
+    timing[seed] = {'run': run, 'corners': corners}
+lead = timing[13]['corners']['corner-1']['worst_wb_cyc_path']
+assert lead['rank'] == '1' and lead['slack_ns'] == '-2.168'
+
+summary = {'status': 'PASS', 'base': base, 'variant': variant, 'candidate': spec['sha'],
