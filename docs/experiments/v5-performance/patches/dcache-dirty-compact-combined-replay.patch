+edit('  ngage2_zap_dcache_fsm #(', '  reference_zap_dcache_fsm #(')
+edit('      .i_lock_owner_hold(destination),\n      .i_lock_owner_advance(destination),\n      .i_lock_owner_move(1\'b0),', '''      .i_lock_owner_hold(owner_hold),
+      .i_lock_owner_advance(owner_advance),
+      .i_lock_owner_move(owner_move),
