+      .o_lock_return(lock_return),''')
+edit("      .i_cache_tag_dirty(1'b0),\n      .i_cache_tag(46'b0),\n      .i_cache_tag_valid(1'b0),", """      .i_cache_tag_dirty(victim_dirty),
+      .i_cache_tag(victim_tag),
