@@ -0,0 +1,114 @@
+"""Record the exact TLB and MMC RAM replay on the qualified refill wrapper."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shlex
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+out = root / 'build/sim/v5-104-tlb-fifo-refill-combined'
+ram_runs = root / 'build/sim/v5-104-tlb-victims-mmc-fifo'
+refill_runs = root / 'build/sim/v5-104-refill-line-word-ready'
+ram_path = area.parent / 'tlb-victims-mmc-fifo/qualification.json'
+refill_path = area.parent / 'refill-line-word-ready/qualification.json'
+prep_path = area / 'dispatch-20261126/prepare.json'
+cpu = 'rtl/arm9v2/arm925t_phone.v'
+host = 'rtl/ngage_mmc_host.v'
+wrapper = 'rtl/ngage_cpu.sv'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def fingerprint(path, suffix):
+    rows = [shlex.split(line) for line in path.read_text().splitlines()
+            if line.startswith('S ') and line.endswith(f'{suffix}"')]
+    (row,) = rows
+    return row[-2]
+
+
+def passes(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+prep, ram, refill = (load(path) for path in (prep_path, ram_path, refill_path))
+assert all(receipt['status'] == 'PASS' for receipt in (prep, ram, refill))
+assert prep['active_timer'] == ram['base'] == refill['base']
+assert digest(ram_path) == prep['ram_qualification_sha256']
+assert digest(refill_path) == prep['refill_qualification_sha256']
+selected = prep['variants']['ram-plus-refill']
+assert selected['parent'] == prep['active_refill']
+assert {wrapper: refill['candidate_sha256']} | ram['source_sha256'] == selected['hashes_from_timer']
+assert all(digest(area / 'source' / name) == value for name, value in selected['hashes_from_timer'].items())
+assert digest(area / 'ngage_cpu.sv') == refill['candidate_sha256']
+
+mix = out / 'mixed'
+fingerprints = {name: fingerprint(mix / 'obj/Vtb__verFiles.dat', name) for name in (cpu, host, wrapper)}
+assert fingerprints == ram['compiled_fingerprints'] | {wrapper: refill['compiled_wrapper_fingerprint']}
+trial, baseline = (load(deck / 'source-hashes.json') for deck in (mix, refill_runs / 'mixed'))
+assert len(trial) == len(baseline) == 114 and trial.keys() == baseline.keys()
+assert {name: trial[name] for name in trial if trial[name] != baseline[name]} == {
+    name: ram['source_sha256'][name] for name in (cpu, host)}
+assert trial[wrapper] == refill['candidate_sha256']
+
+workload = {}
+for kind, metric, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    result = load(receipt)
+    control = load(refill_runs / f'qualification/{kind}.json')
+    ram_control = load(ram_runs / f'qualification/{kind}.json')
+    assert result['status'] == control['status'] == ram_control['status'] == 'PASS'
+    assert result['rows'] == control['rows'] == ram_control['rows']
+    assert result['netlist_sha256'] == ram['source_sha256'][cpu]
+    assert result['wrapper_sha256'] == refill['candidate_sha256']
+    assert result['source_sha256'][Path(host).name] == ram['source_sha256'][host]
+    assert sum(len(row['candidate'][metric]) for row in result['rows']) == count
+    manifest = out / f'qualification/obj-{kind}/Vtb__verFiles.dat'
+    command = next(line for line in manifest.read_text().splitlines() if line.startswith('C '))
+    assert '-GLINE_REFILL=1' in command
+    assert fingerprint(manifest, host) == fingerprints[host]
+    assert fingerprint(manifest, '/ngage_cpu.sv') == fingerprints[wrapper]
+    assert fingerprint(manifest, f'{kind}-candidate-cpu.v') == fingerprints[cpu]
+    workload[kind] = {'count': count, 'receipt_sha256': digest(receipt)}
+native = result['rows'][0]['candidate']
+workload['native']['cycles'] = [row['clocks'] for row in native['frames']]
+workload['native']['guest_output_sha256'] = native['output_sha256']
+
+directed = passes(out / 'directed.log')
+assert len([line for line in directed if line.startswith('PASS walker ')]) == 2
+assert len([line for line in directed if line.startswith('PASS MMC host data peer ')]) == 4
+assert any('260' in line and '939' in line for line in directed)
+assert fingerprint(out / 'directed/obj-tlb/Vwalker_tb__verFiles.dat', cpu) == fingerprints[cpu]
+board = {}
+for profile, record in refill['board_replays'].items():
+    trace = out / 'board/source' / f'{profile}.trace'
+    assert digest(trace) == record['trace_sha256']
+    assert digest(trace) == digest(out / 'board/reference' / trace.name)
+    board[profile] = record
+assert fingerprint(out / 'board/source/obj/Vcontract__verFiles.dat', wrapper) == fingerprints[wrapper]
+assert fingerprint(out / 'board/source/obj/Vcontract__verFiles.dat', cpu) == fingerprints[cpu]
+
+physical = {}
+for label, trace, log in (('normal', 'mixed/traffic.log', 'mixed/replay.log'),
+                          ('overlap', 'coexistence/candidate.trace', 'coexistence/candidate.log')):
+    candidate = out / trace
+    control = refill['physical_replays'][label]
+    assert digest(candidate) == digest(refill_runs / trace) == control['trace_sha256']
+    assert len(candidate.read_bytes().splitlines()) == control['events']
+    assert passes(out / log) == passes(refill_runs / log)
+    physical[label] = control
+
+receipt = {'status': 'PASS', 'candidate': selected['sha'], 'base': selected['parent'],
+           'tree': selected['tree'], 'source_sha256': selected['hashes_from_timer'],
+           'preflight_sha256': digest(prep_path),
+           'ram_qualification_sha256': digest(ram_path), 'refill_qualification_sha256': digest(refill_path),
+           'compiled_fingerprints': fingerprints, 'mixed_sources': len(trial),
+           'simulator': (out / 'image.id').read_text().strip(), 'workload': workload,
+           'board': board, 'directed': directed, 'physical_replays': physical}
+(area / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
