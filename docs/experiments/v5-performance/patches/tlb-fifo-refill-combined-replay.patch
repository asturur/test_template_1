@@ -0,0 +1,225 @@
+"""Prepare the TLB and MMC RAM fit for either refill outcome."""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+refill_stage = area.parent / 'refill-payload-combined/dispatch-20261126'
+active_refill = '99299836993ad77d812d314c78134ef6727d913e'
+active_timer = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+private = area / 'dispatch-20261126'
+objects = private / 'objects'
+objects.mkdir(parents=True, exist_ok=True)
+controls = {13: 45824513460, 43: 45824520116, 31337: 45824525843}
+
+
+def git(*args, env=None):
+    return subprocess.check_output(['git', '-C', str(root), *args], env=env)
+
+
+def sha(data):
+    return sha256(data).hexdigest()
+
+
+shared_objects = git('rev-parse', '--path-format=absolute', '--git-path', 'objects').decode().strip()
+older_objects = (refill_stage / 'alternate-objects.txt').read_text().strip().split(os.pathsep)
+alternates = os.pathsep.join(dict.fromkeys([shared_objects, str(refill_stage / 'objects'), *older_objects]))
+assert all(Path(path).is_absolute() and Path(path).is_dir() for path in alternates.split(os.pathsep))
+(private / 'alternate-objects.txt').write_text(alternates + '\n')
+
+
+def context(index):
+    return os.environ | {
+        'GIT_OBJECT_DIRECTORY': str(objects),
+        'GIT_ALTERNATE_OBJECT_DIRECTORIES': alternates,
+        'GIT_INDEX_FILE': str(private / f'index-{index}'),
+    }
+
+
+def subject(revision, env):
+    return git('rev-parse', revision, env=env).decode().strip()
+
+
+def tree(revision, env):
+    return subject(f'{revision}^{{tree}}', env)
+
+
+def changes(before, after, env):
+    records = git('diff', '--name-only', '-z', before, after, env=env).split(b'\0')
+    return sorted(name.decode() for name in records if name)
+
+
+def file_hashes(revision, paths, env):
+    return {name: sha(git('show', f'{revision}:{name}', env=env)) for name in paths}
+
+
+def stage_tree(base, patches, env, include=()):
+    git('read-tree', base, env=env)
+    filters = [f'--include={path}' for path in include]
+    for patch in patches:
+        git('apply', '--cached', '--check', *filters, str(patch), env=env)
+        git('apply', '--cached', *filters, str(patch), env=env)
+    return git('write-tree', env=env).decode().strip()
+
+
+def commit(tree_id, base, message, env):
+    timestamp = int(git('show', '-s', '--format=%ct', base, env=env)) + 1
+    date = f'@{timestamp} +0000'
+    dated = env | {'GIT_AUTHOR_DATE': date, 'GIT_COMMITTER_DATE': date}
+    result = git('commit-tree', tree_id, '-p', base, '-m', message, env=dated).decode().strip()
+    assert tree(result, env) == tree_id and subject(f'{result}^', env) == base
+    return result
+
+
+def read_json(path):
+    return json.loads(path.read_text())
+
+
+refill_dir = area.parent / 'refill-line-word-ready'
+refill_path = refill_dir / 'qualification.json'
+refill = read_json(refill_path)
+refill_patch = refill_dir / 'refill-line-word-ready.patch'
+assert sha(refill_patch.read_bytes()) == refill['design_patch_sha256']
+assert refill['status'] == 'PASS' and refill['base'] == active_timer
+assert (refill_stage / 'published.sha').read_text().strip() == active_refill
+refill_dispatch = read_json(refill_stage / 'dispatch.json')
+assert refill_dispatch['status'] == 'VERIFIED_DISPATCH' and refill_dispatch['candidate'] == active_refill
+assert refill['changed_source'] == 'rtl/ngage_cpu.sv'
+refill_hashes = {refill['changed_source']: refill['candidate_sha256']}
+
+ram_dir = area.parent / 'tlb-victims-mmc-fifo'
+ram_path = ram_dir / 'qualification.json'
+ram = read_json(ram_path)
+ram_patch = ram_dir / 'tlb-victims-mmc-fifo.patch'
+sealed = {name: value for value, name in (line.split(maxsplit=1) for line in
+          (ram_dir / 'SHA256SUMS').read_text().splitlines())}
+assert all(sha(path.read_bytes()) == sealed[path.name] for path in (ram_path, ram_patch))
+assert sha(ram_patch.read_bytes()) == ram['design_patch_sha256']
+assert ram['status'] == 'PASS' and ram['base'] == active_timer
+ram_hashes = ram['source_sha256']
+assert sorted(ram_hashes) == ['rtl/arm9v2/arm925t_phone.v', 'rtl/ngage_mmc_host.v', 'tools/gen_arm9v2_phone.py']
+assert {name: sha((ram_dir / 'source' / name).read_bytes()) for name in ram_hashes} == ram_hashes
+catalog = root / 'docs/experiments/v5-performance/patches'
+components = [catalog / name for name in ram['archived_patch_sha256']]
+assert {path.name: sha(path.read_bytes()) for path in components} == ram['archived_patch_sha256']
+
+env = context('proof')
+timer_tree = tree(active_timer, env)
+assert timer_tree == ram['base_tree']
+assert stage_tree(active_timer, [refill_patch], env) == tree(active_refill, env)
+assert changes(active_timer, active_refill, env) == sorted(refill_hashes)
+assert file_hashes(active_refill, refill_hashes, env) == refill_hashes
+assert file_hashes(active_refill, ram_hashes, env) == ram['reference_sha256']
+joint = stage_tree(active_timer, [ram_patch], env)
+assert joint == ram['joint_tree']
+assert joint == stage_tree(active_timer, components, env, ram_hashes)
+assert joint == stage_tree(active_timer, components[::-1], env, ram_hashes)
+
+restore = commit(timer_tree, active_refill, 'revert: restore timer-only 104 MHz tree', env)
+assert changes(active_refill, restore, env) == sorted(refill_hashes)
+(private / 'restore.sha').write_text(restore + '\n')
+message = 'perf: map TLB victims and MMC FIFO to RAM'
+variants = {}
+for label, parent in (('ram-on-timer', restore), ('ram-plus-refill', active_refill)):
+    env = context(label)
+    candidate_tree = stage_tree(parent, [ram_patch], env)
+    candidate = commit(candidate_tree, parent, message, env)
+    combined = label == 'ram-plus-refill'
+    exact_paths = refill_hashes | ram_hashes if combined else ram_hashes
+    assert changes(parent, candidate, env) == sorted(ram_hashes)
+    assert changes(active_timer, candidate, env) == sorted(exact_paths)
+    assert file_hashes(candidate, exact_paths, env) == exact_paths
+    ordered_patches = [ram_patch, refill_patch] if combined else [ram_patch]
+    assert stage_tree(active_timer, ordered_patches, context('compose')) == candidate_tree
+    variants[label] = {'sha': candidate, 'parent': parent, 'tree': candidate_tree,
+                       'paths_since_parent': sorted(ram_hashes), 'hashes_from_timer': exact_paths}
+    (private / f'{label}.sha').write_text(candidate + '\n')
+
+production_tools = ('set_quartus_seed', 'set_quartus_debug', 'record_fit_inputs')
+for label, metadata in variants.items():
+    env = context(label)
+    candidate = metadata['sha']
+    variant_dir = private / 'preflight' / label
+    variant_dir.mkdir(parents=True, exist_ok=True)
+    metadata['production'] = {}
+    for seed, run in controls.items():
+        control_dir = root / f'build/timing-audit-{run}/output_files'
+        control = read_json(control_dir / 'resident-fit-manifest.json')
+        basenames = control['compiled_source_sha256'].keys()
+        assert tree(control['actual_commit'], env) == timer_tree
+        assert control['seed'] == seed and control['physical_cpu_mhz'] == 104 and control['debugger'] is False
+        assert len(basenames) == 133 and 'Template.qsf' in basenames
+        seed_dir = variant_dir / str(seed)
+        output_dir = seed_dir / 'output_files'
+        output_dir.mkdir(parents=True, exist_ok=True)
+        source_graph = (control_dir / 'source-graph.txt').read_text()
+        graphed = {line.removeprefix('SOURCE /project/') for line in source_graph.splitlines()
+                   if line.startswith('SOURCE ')}
+        assert graphed == set(basenames), sorted(graphed ^ set(basenames))
+        (output_dir / 'source-graph.txt').write_text(source_graph)
+        for name in (*basenames, *(f'tools/{tool}.py' for tool in production_tools)):
+            assert not Path(name).is_absolute() and '..' not in Path(name).parts
+            path = seed_dir / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(git('show', f'{candidate}:{name}', env=env))
+        local_env = os.environ | {'GITHUB_SHA': candidate}
+        for name in ('GITHUB_STEP_SUMMARY', 'GITHUB_RUN_ID'):
+            local_env.pop(name, None)
+        for tool, *args in (
+            ('set_quartus_seed', 'Template.qsf', '--seed', str(seed)),
+            ('set_quartus_debug', 'Template.qsf', '--enabled', 'false'),
+        ):
+            subprocess.run(['python3', '-B', f'tools/{tool}.py', *args],
+                           cwd=seed_dir, env=local_env, check=True, stdout=subprocess.PIPE)
+        qsf = seed_dir / 'Template.qsf'
+        # Quartus on the runner rewrites the version line with LF, leaving
+        # the rest of the generated QSF at its original CRLF line endings.
+        qsf.write_bytes(qsf.read_bytes().replace(b'LAST_QUARTUS_VERSION "17.0.2 Standard Edition"\r\n',
+                                                 b'LAST_QUARTUS_VERSION "17.0.2 Lite Edition"\n'))
+        subprocess.run(['python3', '-B', 'tools/record_fit_inputs.py'],
+                       cwd=seed_dir, env=local_env, check=True, stdout=subprocess.PIPE)
+        effective = output_dir / 'resident-fit-manifest.json'
+        compiled = read_json(effective)
+        assert compiled['actual_commit'] == candidate
+        actual_hashes = compiled['compiled_source_sha256']
+        selected_run = run
+        selected_manifest = control_dir / 'resident-fit-manifest.json'
+        if label == 'ram-plus-refill':
+            prior_run = refill_dispatch['runs'][str(seed)]
+            assert prior_run['head_sha'] == active_refill
+            selected_run = prior_run['id']
+            selected_manifest = refill_stage / f'preflight/refill-on-timer/{seed}/output_files/resident-fit-manifest.json'
+        match = read_json(selected_manifest)
+        expected_parent = active_refill if label == 'ram-plus-refill' else control['actual_commit']
+        assert match['actual_commit'] == expected_parent
+        assert match['compiled_source_sha256'].keys() == basenames
+        expected_delta = {name: actual_hashes[name] for name in basenames
+                          if actual_hashes[name] != match['compiled_source_sha256'][name]}
+        assert expected_delta == {name: value for name, value in ram_hashes.items() if name in basenames}, (label, seed, expected_delta)
+        for field in control.keys() - {'actual_commit', 'compiled_source_sha256'}:
+            assert control[field] == match[field] == compiled[field], field
+        metadata['production'][seed] = {
+            'control_run': selected_run, 'control_commit': expected_parent,
+            'physical_cpu_mhz': compiled['physical_cpu_mhz'], 'ddr_debug': compiled['debugger'],
+            'compiled_source_count': len(basenames), 'compiled_input_delta': expected_delta,
+            'qsf_sha256': actual_hashes['Template.qsf'],
+            'manifest_sha256': sha(effective.read_bytes()),
+            'control_manifest_sha256': sha(selected_manifest.read_bytes()),
+        }
+        print(f'PASS {label} seed {seed}, 104 MHz, DDR debug off, {len(basenames)} inputs', flush=True)
+
+receipt = {'status': 'PASS', 'active_refill': active_refill, 'active_timer': active_timer,
+           'timer_tree': timer_tree, 'restore': restore, 'restore_parent': active_refill,
+           'refill_patch_sha256': sha(refill_patch.read_bytes()),
+           'ram_patch_sha256': sha(ram_patch.read_bytes()),
+           'refill_qualification_sha256': sha(refill_path.read_bytes()),
+           'ram_qualification_sha256': sha(ram_path.read_bytes()),
+           'private_objects': str(objects), 'alternate_objects': alternates, 'variants': variants}
+(private / 'prepare.json').write_text(json.dumps(receipt, indent=2) + '\n')
+for label, variant in variants.items():
+    print(label, variant['sha'], variant['parent'], variant['tree'])
+print('restore', restore, active_refill, timer_tree)
