+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/tlb-fifo-refill-combined
+old=scratch/v5-fit-loop/tlb-victims-mmc-fifo
+private="$area/dispatch-20261126"
+out=build/sim/v5-104-tlb-fifo-refill-combined
+mkdir -p "$area/reference" "$area/source" "$out"
+for leg in reference source; do
+  if [ "$leg" = reference ]; then
+    rev=99299836993ad77d812d314c78134ef6727d913e
+  else
+    rev=$(cat "$private/ram-plus-refill.sha")
+  fi
+  env GIT_OBJECT_DIRECTORY="$PWD/$private/objects" \
+    GIT_ALTERNATE_OBJECT_DIRECTORIES="$(cat "$private/alternate-objects.txt")" \
+    git archive "$rev" rtl tools tests/cpu/arm9v2_board tests/cpu/spmark_payload \
+      tests/phone/mmc_host tests/phone/upp_ddr_ram/peer.v tests/phone/direct_sdram \
+      tests/phone/upp_bus_bridge sim/programs/link.ld | tar -x -C "$area/$leg"
+  python3 -B "$area/$leg/tools/gen_arm9v2_phone.py" --stock build/arm9v2-assoc/stock-pinned.v --check
+done
+cp "$old/architectural_trace.vh" "$old/wb-write-trace.vh" "$area"
+cp "$old/tlb_victim_tb.sv" "$old/fifo_reference.vh" "$old/fifo_banks_tb.sv" "$area"
+cp "$area/source/rtl/ngage_cpu.sv" "$area/ngage_cpu.sv"
