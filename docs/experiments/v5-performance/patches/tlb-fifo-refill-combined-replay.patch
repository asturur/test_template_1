+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/tlb-fifo-refill-combined
+out=build/sim/v5-104-tlb-fifo-refill-combined/directed
+image=jotego/simulator:arm64
+python3 -B "$area/prepare-directed.py"
+case "${1:-all}" in
+  tlb|mmc|all) suite="${1:-all}" ;;
+  *) exit 2 ;;
+esac
+
+if [ "$suite" != mmc ]; then
+    docker run --rm --pull=never --network none --platform linux/arm64 \
+        -v "$PWD/$area:/bench:ro" -v "$PWD/$out:/results" -w /bench/source \
+        --entrypoint sh "$image" -ec '
+        verilator --binary --timing --assert -j 2 -Wno-fatal -Wno-lint \
+            --top-module walker_tb --Mdir /results/obj-tlb rtl/arm9v2/arm925t_phone.v \
+            rtl/arm9v2/upstream/sim/stubs/*.sv /results/reference_zap_tlb.v /bench/tlb_victim_tb.sv \
+            > /results/tlb-build.log 2>&1
+        /results/obj-tlb/Vwalker_tb > /results/tlb.log 2>&1
+        grep -E "^PASS walker " /results/tlb.log'
+fi
+if [ "$suite" != tlb ]; then
+    docker run --rm --pull=never --network none --platform linux/arm64 \
+        -v "$PWD/$area:/bench:ro" -v "$PWD/$out:/results" -w /results \
+        --entrypoint sh "$image" -ec '
+        rtl=/bench/source/rtl
+        iverilog -g2001 -s ngage_mmc_host -o strict "$rtl/ngage_mmc_host.v" "$rtl/ngage_bram.v"
+        for config in "2 16" "3 16" "4 16" "12 8"; do
+            set -- $config
+            tag=mmc-data-$1-$2
+            iverilog -g2012 -I/bench -s tb -Ptb.DIV="$1" -Ptb.FIFO_DEPTH="$2" -o "$tag" \
+                "$rtl/ngage_mmc_host.v" register_mmc_host.v poison_bram.v data_fifo_tb.v
+            vvp "$tag" > "$tag.log"
+            grep "^PASS MMC host data " "$tag.log"
+        done
+        iverilog -g2012 -I/bench -s fifo_banks_tb -o banks \
+            "$rtl/ngage_mmc_host.v" register_mmc_host.v poison_bram.v /bench/fifo_banks_tb.sv
+        vvp banks > banks.log
+        grep "^PASS MMC FIFO " banks.log
+        fixture=/bench/source/tests/phone/mmc_host
+        iverilog -g2001 -s tb -o cmd16 "$rtl/ngage_mmc_host.v" "$rtl/ngage_bram.v" "$fixture/cmd16_tb.v"
+        vvp cmd16 > cmd16.log
+        grep "^PASS CMD16 " cmd16.log
+        iverilog -g2001 -s integer_clock_tb -o integer "$rtl/ngage_mmc_host.v" "$rtl/ngage_bram.v" "$fixture/integer_clock_tb.v"
+        vvp integer > integer.log
+        grep "^PASS MMC integer " integer.log'
+fi
