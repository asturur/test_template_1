+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/tlb-fifo-refill-combined
+out=build/sim/v5-104-tlb-fifo-refill-combined
+mkdir -p "$out"
+docker image inspect -f '{{.Id}} {{.Os}}/{{.Architecture}}' jotego/simulator:arm64 > "$out/image.id"
+python3 -B "$area/replay.py" fixed --output qualification > "$out/fixed.log" 2>&1 &
+fixed=$!
+python3 -B "$area/replay.py" native --output qualification > "$out/native.log" 2>&1 &
+native=$!
+sh "$area/pins.sh" > "$out/pins.log" 2>&1 &
+pins=$!
+sh "$area/board.sh" > "$out/board.log" 2>&1 &
+board=$!
+sh "$area/directed.sh" > "$out/directed.log" 2>&1 &
+directed=$!
+status=0
+for slot in "$fixed" "$native" "$pins" "$board" "$directed"; do wait "$slot" || status=1; done
+for log in fixed native pins board directed; do tail -8 "$out/$log.log"; done
+exit "$status"
