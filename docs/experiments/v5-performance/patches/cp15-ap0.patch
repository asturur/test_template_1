diff --git a/tests/cpu/arm9v2_board/cp15_ap0_tb.sv b/tests/cpu/arm9v2_board/cp15_ap0_tb.sv
new file mode 100644
index 0000000..fd073c8
--- /dev/null
+++ b/tests/cpu/arm9v2_board/cp15_ap0_tb.sv
@@ -0,0 +1,255 @@
+`timescale 1ns / 1ps
+
+module cp15_ap0_case #(parameter INSTRUCTION = 0) (output bit pass);
+    bit clk, reset, cp_valid, cp_user;
+    bit [31:0] cp_word, cp_data;
+    wire [1:0] sr [0:1];
+    wire [1:0] ap0;
+    wire [31:0] cp_dac [0:1];
+    wire cp_done [0:1], cp_mmu [0:1];
+    bit clock_enable = 1, mmu = 1, rd, wr, user_mode, matrix_dac, use_cp_mmu;
+    bit [31:0] va, dac;
+    bit [95:0] small_page;
+    bit [42:0] large_page;
+    bit [37:0] section;
+    bit [47:0] fine;
+    bit [1:0] small_valid;
+    bit large_valid, section_valid, fine_valid;
+    bit [1:0] kind, desc_type, access_permissions, attributes;
+    bit [3:0] domain;
+    integer clocks, checks, held, sr_transitions;
+    integer pages_allowed, misses, translations, external_aborts, domain_faults, permission_faults;
+
+    typedef struct packed {
+        logic hit, short_hit, walk;
+        logic [31:0] walk_va;
+        logic [7:0] fsr;
+        logic [31:0] far;
+        logic cacheable, bufferable, wt;
+        logic [31:0] physical;
+    } result_t;
+    wire result_t result [0:2];
+
+`define CP_PORTS(leg) \
+    .i_clk(clk), .i_reset(reset), .i_cp_word(cp_word), .i_cp_dav(cp_valid), \
+    .i_cpsr(cp_user ? 32'h10 : 32'h13), .i_reg_rd_data(cp_data), .i_fsr(32'b0), .i_far(32'b0), \
+    .i_dcache_inv_done(1'b0), .i_icache_inv_done(1'b0), .i_dcache_clean_done(1'b0), \
+    .i_icache_clean_done(1'b0), .i_irq(1'b0), .i_fiq(1'b0), .i_dcache_writeback_busy(1'b0), \
+    .i_dcache_line_done(1'b0), .o_cp_done(cp_done[leg]), .o_sr(sr[leg]), \
+    .o_dac(cp_dac[leg]), .o_mmu_en(cp_mmu[leg])
+    old_cp15 ref_cp (`CP_PORTS(0));
+    ngage2_zap_cp15_cb new_cp (`CP_PORTS(1), .o_ap0_mode(ap0));
+`undef CP_PORTS
+
+`define GEOMETRY .SPAGE_TLB_ENTRIES(256), .SPAGE_TLB_WAYS(2), \
+    .LPAGE_TLB_ENTRIES(32), .SECTION_TLB_ENTRIES(64), .FPAGE_TLB_ENTRIES(64), \
+    .MMU_OFF_CACHEABLE(INSTRUCTION)
+`define CHECK_PORTS(leg, cp) \
+    .i_clk(clk), .i_clkena(clock_enable), .i_mmu_en(use_cp_mmu ? cp_mmu[cp] : mmu), \
+    .i_va(va), .i_rd(rd), .i_wr(wr), .i_cpsr(user_mode ? 5'h10 : 5'h13), \
+    .i_dac_reg(matrix_dac ? dac : cp_dac[cp]), \
+    .i_sptlb_rdata(small_page), .i_sptlb_rdav(small_valid), .i_lptlb_rdata(large_page), \
+    .i_lptlb_rdav(large_valid), .i_setlb_rdata(section), .i_setlb_rdav(section_valid), \
+    .i_fptlb_rdata(fine), .i_fptlb_rdav(fine_valid), .o_hit_ok(result[leg].hit), \
+    .o_hit_ok_short(result[leg].short_hit), .o_walk(result[leg].walk), \
+    .o_walk_va(result[leg].walk_va), .o_fsr(result[leg].fsr), .o_far(result[leg].far), \
+    .o_cacheable(result[leg].cacheable), .o_bufferable(result[leg].bufferable), \
+    .o_wt(result[leg].wt), .o_phy_addr(result[leg].physical)
+    old_tlb_check #(`GEOMETRY) reference (`CHECK_PORTS(0,0), .i_sr(sr[0]));
+    ngage2_zap_tlb_check #(`GEOMETRY, .AP0_PREDECODED(1'b1)) candidate (
+        `CHECK_PORTS(1,1), .i_sr(~sr[1]), .i_ap0_mode(ap0)
+    );
+    ngage2_zap_tlb_check #(`GEOMETRY) fallback (
+        `CHECK_PORTS(2,1), .i_sr(sr[1]), .i_ap0_mode(~ap0)
+    );
+`undef GEOMETRY
+`undef CHECK_PORTS
+
+    function automatic bit permitted(input bit [1:0] sr_value);
+        case (access_permissions)
+            0: case (sr_value)
+                1: permitted = !wr;
+                2: permitted = !user_mode && rd;
+                default: permitted = 0;
+            endcase
+            1: permitted = !user_mode;
+            2: permitted = !user_mode || rd;
+            3: permitted = 1;
+        endcase
+    endfunction
+
+    task automatic tick;
+        result_t old_result;
+        bit [1:0] old_sr, domain_mode;
+        bit [7:0] expected_fsr;
+        bit lookup, walk;
+        bit [3:0] reason;
+        #1;
+        old_result = result[0];
+        old_sr = sr[0];
+        domain_mode = 2'((matrix_dac ? dac : cp_dac[0]) >> (domain * 2));
+        lookup = (use_cp_mmu ? cp_mmu[0] : mmu) && (rd || wr);
+        walk = lookup && !(|small_valid || large_valid || section_valid || fine_valid);
+        expected_fsr = 0;
+        reason = 0;
+        if (lookup && !walk) begin
+            if ((kind == 0 || kind == 2) && desc_type == 0)
+                reason = kind == 2 ? 4'h5 : 4'h7;
+            else if ((kind == 0 || kind == 2) && desc_type == 3)
+                reason = kind == 2 ? 4'hc : 4'he;
+            else if (domain_mode == 0 || domain_mode == 2)
+                reason = kind == 2 ? 4'h9 : 4'hb;
+            else if (domain_mode == 1 && !permitted(old_sr))
+                reason = kind == 2 ? 4'hd : 4'hf;
+            expected_fsr = reason == 0 ? 8'b0 : {domain, reason};
+        end
+
+        clk = 1;
+        #1;
+        clocks++;
+        if (clocks > 2) begin
+            if ({cp_done[1], sr[1], cp_mmu[1], cp_dac[1]} !== {cp_done[0], sr[0], cp_mmu[0], cp_dac[0]} ||
+                ap0 !== {sr[0] == 2'b10, sr[0] == 2'b01})
+                $fatal(1, "CP15 update edge changed at %0d S/R %b", clocks, sr[0]);
+            if (old_sr != sr[0]) sr_transitions++;
+            if (result[1] !== result[0] || result[2] !== result[0])
+                $fatal(1, "TLB changed at %0d I=%b S/R=%b AP=%b type=%b domain=%b kind=%b rw=%b%b user=%b",
+                       clocks, INSTRUCTION, old_sr, access_permissions, desc_type, domain_mode,
+                       kind, rd, wr, user_mode);
+            if (clock_enable) begin
+                checks++;
+                if (result[1].fsr !== expected_fsr || result[1].walk !== walk ||
+                    result[1].far !== va || result[1].walk_va !== va)
+                    $fatal(1, "Bad fault precedence: kind=%b type=%b domain=%b S/R=%b FSR=%h expected=%h",
+                           kind, desc_type, domain_mode, old_sr, result[1].fsr, expected_fsr);
+                if (walk) misses++;
+                else if (lookup)
+                    case (reason)
+                        0: pages_allowed++;
+                        5, 7: translations++;
+                        12, 14: external_aborts++;
+                        9, 11: domain_faults++;
+                        13, 15: permission_faults++;
+                        default: $fatal(1, "unexpected fault code");
+                    endcase
+            end else begin
+                held++;
+                if (result[1] !== old_result) $fatal(1, "held lookup changed");
+            end
+        end
+        clk = 0;
+        #1;
+    endtask
+
+    task automatic descriptor(input bit [1:0] form, ap, subpage, dtype, input bit [3:0] dom);
+        bit [7:0] ap_fields;
+        kind = form;
+        domain = dom;
+        desc_type = dtype;
+        access_permissions = ap;
+        attributes = dom[1:0];
+        va = 32'h4abc0000 | ({30'b0,subpage} << 14) | ({30'b0,subpage} << 10);
+        ap_fields = {4{~ap}};
+        ap_fields[2*subpage+:2] = ap;
+        small_page = 0;
+        small_page[48*dom[0]+:48] = {va[31:20],20'h12345,dom,ap_fields,attributes,dtype};
+        large_page = {va[31:21],16'h2345,dom,ap_fields,attributes,dtype};
+        section = {va[31:26],12'h345,8'b0,ap,1'b0,dom,1'b0,attributes,dtype};
+        fine = {va[31:16],22'h45678,dom,ap,attributes,dtype};
+        small_valid = form == 0 ? (2'b01 << dom[0]) : 2'b00;
+        large_valid = form == 1;
+        section_valid = form == 2;
+        fine_valid = form == 3;
+    endtask
+
+    task automatic mcr(input bit [31:0] word, value, input bit forbidden);
+        integer edges;
+        cp_word = word;
+        cp_data = value;
+        cp_user = forbidden;
+        cp_valid = 1;
+        edges = 0;
+        do begin
+            tick();
+            edges++;
+            if (edges == 12) $fatal(1, "CP15 MCR did not complete");
+        end while (!cp_done[0]);
+        cp_valid = 0;
+        cp_user = 0;
+        repeat (2) tick();
+    endtask
+
+    initial begin
+        reset = 1;
+        repeat (3) tick();
+        reset = 0;
+        rd = 1;
+        use_cp_mmu = 1;
+        descriptor(2,0,0,2,1);
+        mcr(32'hee030f10,32'h55555555,0);
+        for (int s = 0; s < 4; s++) begin
+            // Keep a read active across the write and its first applicable edge.
+            descriptor(2,0,0,2,1);
+            mcr(32'hee010f10,32'(s[1])*256 + 32'(s[0])*512 + 1,0);
+            if (sr[0] != s[1:0] || !cp_mmu[0]) $fatal(1, "MCR failed to set S/R");
+            mcr(32'hee010f10,0,1);
+            if (sr[0] != s[1:0] || !cp_mmu[0]) $fatal(1, "user MCR changed S/R");
+
+            for (int form = 0; form < 4; form++)
+            for (int typ = 0; typ < 4; typ++)
+            for (int ap = 0; ap < 4; ap++)
+            for (int sub = 0; sub < 4; sub++)
+            for (int dom = 0; dom < 16; dom++) begin
+                descriptor(form[1:0],ap[1:0],sub[1:0],typ[1:0],dom[3:0]);
+                for (int mode = 0; mode < 4; mode++)
+                for (int user_case = 0; user_case < 2; user_case++)
+                for (int access = 0; access < (INSTRUCTION ? 2 : 4); access++) begin
+                    matrix_dac = 1;
+                    dac = 32'(mode) << (dom * 2);
+                    user_mode = user_case[0];
+                    {wr,rd} = access[1:0];
+                    tick();
+                end
+            end
+            // The checker holds the previous result across CP15 changes and
+            // then uses the new permissions on its first released edge.
+            clock_enable = 0;
+            matrix_dac = 0;
+            user_mode = 0;
+            rd = 1;
+            wr = 0;
+            descriptor(0,0,3,2,1);
+            mcr(32'hee010f10,32'(s[0])*256 + 32'(!s[1])*512 + 1,0);
+            clock_enable = 1;
+            tick();
+            small_valid = 0;
+            tick();
+            descriptor(0,0,3,3,1);
+        end
+        reset = 1;
+        repeat (3) tick();
+        reset = 0;
+        repeat (2) tick();
+        if (sr[0] != 0 || ap0 != 0 || cp_mmu[0] || !(checks && held && sr_transitions && misses &&
+            translations && external_aborts && domain_faults && permission_faults && pages_allowed))
+            $fatal(1, "reset or coverage incomplete");
+        $display("PASS CP15 AP0 instruction=%0d clocks=%0d checks=%0d held=%0d sr_changes=%0d allow=%0d miss=%0d translation=%0d external=%0d domain=%0d permission=%0d",
+                 INSTRUCTION, clocks, checks, held, sr_transitions, pages_allowed, misses, translations,
+                 external_aborts, domain_faults, permission_faults);
+        pass = 1;
+    end
+endmodule
+
+module cp15_ap0_tb;
+    wire i_pass, d_pass;
+    cp15_ap0_case #(.INSTRUCTION(1)) i_case(i_pass);
+    cp15_ap0_case d_case(d_pass);
+    initial begin
+        wait (i_pass && d_pass);
+        $finish;
+    end
+    initial begin
+        #2000000;
+        $fatal(1, "CP15 AP0 differential timed out");
+    end
+endmodule
diff --git a/tests/cpu/arm9v2_board/run-cp15-ap0.sh b/tests/cpu/arm9v2_board/run-cp15-ap0.sh
new file mode 100644
index 0000000..f346790
--- /dev/null
+++ b/tests/cpu/arm9v2_board/run-cp15-ap0.sh
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Run inside the installed jotego/simulator:arm64 image.
+set -eu
+reference=${1:?provide the c492853 reference netlist}
+candidate=rtl/arm9v2/arm925t_phone.v
+out=build/sim/unit-cp15-ap0
+mkdir -p "$out"
+sed -n -e '/^module ngage2_zap_cp15_cb (/,/^endmodule/p' \
+    -e '/^module ngage2_zap_tlb_check (/,/^endmodule/p' "$reference" |
+    sed -e 's/^module ngage2_zap_tlb_check (/module old_tlb_check (/' \
+        -e 's/^module ngage2_zap_cp15_cb (/module old_cp15 (/' > "$out/reference.v"
+verilator --binary --timing -j 2 -Wno-fatal --top-module cp15_ap0_tb \
+    --Mdir "$out/obj" "$candidate" "$out/reference.v" \
+    tests/cpu/arm9v2_board/cp15_ap0_tb.sv > "$out/build.log" 2>&1
+"$out/obj/Vcp15_ap0_tb" > "$out/run.log"
+cat "$out/run.log"
+grep -q '^PASS CP15 AP0 instruction=0 ' "$out/run.log"
+grep -q '^PASS CP15 AP0 instruction=1 ' "$out/run.log"
diff --git a/tools/gen_arm9v2_phone.py b/tools/gen_arm9v2_phone.py
index 2807de8..3837708 100644
--- a/tools/gen_arm9v2_phone.py
+++ b/tools/gen_arm9v2_phone.py
@@ -1129,6 +1129,100 @@ def split_execute_readiness(phone):
     return ''.join(parts)
 
 
+def predecode_ap0_permissions(phone):
+    """Decode CP15's AP=0 permission modes on the existing S/R update edge."""
+    parts = re.split(r'(?=^module )', phone, flags=re.M)
+    index = {part.split()[1]: i for i, part in enumerate(parts) if part.startswith('module ')}
+
+    cp15 = index['ngage2_zap_cp15_cb']
+    parts[cp15] = edit(parts[cp15], '\to_sr,\n', '\to_sr,\n\to_ap0_mode,\n')
+    parts[cp15] = edit(parts[cp15], '\toutput reg [1:0] o_sr;',
+        '''    output reg [1:0] o_sr;
+    (* dont_retime *) output reg [1:0] o_ap0_mode;''')
+    parts[cp15] = edit(parts[cp15], '\t\to_sr <= {r[1][8], r[1][9]};',
+        '''        // AP=0: S alone permits privileged reads. R alone permits
+        // read-only access in both modes. 00 and the reserved 11 deny.
+        o_sr <= {r[1][8], r[1][9]};
+        o_ap0_mode <= {r[1][8] && !r[1][9], !r[1][8] && r[1][9]};''')
+
+    core = index['ngage2_arm9v2_core']
+    parts[core] = edit(parts[core], '\to_sr,\n', '\to_sr,\n\to_ap0_mode,\n')
+    parts[core] = edit(parts[core], '\toutput wire [1:0] o_sr;',
+        '\toutput wire [1:0] o_sr;\n\toutput wire [1:0] o_ap0_mode;')
+    parts[core] = edit(parts[core], '\t\t.o_sr(o_sr),', '\t\t.o_sr(o_sr),\n\t\t.o_ap0_mode(o_ap0_mode),')
+
+    top = index['ngage2_zap_top']
+    parts[top] = edit(parts[top], '\twire [1:0] cpu_sr;', '\twire [1:0] cpu_sr, cpu_ap0_mode;')
+    parts[top] = edit(parts[top], '.o_sr(cpu_sr),', '.o_sr(cpu_sr),\n\t\t\t\t.o_ap0_mode(cpu_ap0_mode),')
+    assert parts[top].count('.i_sr(cpu_sr),') == 2
+    parts[top] = parts[top].replace('.i_sr(cpu_sr),', '.i_sr(cpu_sr),\n\t\t\t\t.i_ap0_mode(cpu_ap0_mode),')
+    for cache in ('cache', 'dcache'):
+        anchor = f'\t\t\tngage2_zap_{cache} #(\n'
+        parts[top] = edit(parts[top], anchor, anchor + "\t\t\t\t.AP0_PREDECODED(1'b1),\n")
+
+    for name in ('cache', 'dcache', 'tlb', 'tlb_check'):
+        part = index[f'ngage2_zap_{name}']
+        source = edit(parts[part], '\ti_sr,\n', '\ti_sr,\n\ti_ap0_mode,\n')
+        source = edit(source, '\tinput wire [1:0] i_sr;', '''    parameter [0:0] AP0_PREDECODED = 1'b0;
+    input wire [1:0] i_sr;
+    input wire [1:0] i_ap0_mode;''')
+        if name != 'tlb_check':
+            anchor = '\tngage2_zap_tlb_check #(\n' if name == 'tlb' else '\tngage2_zap_tlb #(\n'
+            source = edit(source, anchor, anchor + '\t\t.AP0_PREDECODED(AP0_PREDECODED),\n')
+            source = edit(source, '\t\t.i_sr(i_sr),', '\t\t.i_sr(i_sr),\n\t\t.i_ap0_mode(i_ap0_mode),')
+        parts[part] = source
+
+    check = index['ngage2_zap_tlb_check']
+    source = parts[check]
+    start = source.index('\tfunction automatic is_apsr_ok;')
+    end = source.index('\tfunction automatic [7:0] get_fsr_spage;', start)
+    source = source[:start] + '''    function automatic [1:0] decode_ap0;
+        input [1:0] sr;
+        decode_ap0 = {sr == 2'b10, sr == 2'b01};
+    endfunction
+    function automatic [3:0] ap_permissions;
+        input user;
+        input rd;
+        input wr;
+        input [1:0] ap0_mode;
+        // Preserve the distinct read/write tests, even if both are set.
+        ap_permissions = {1'b1, !user || (user && rd), !user,
+            (ap0_mode[0] && !wr) || (ap0_mode[1] && !user && rd)};
+    endfunction
+    wire [1:0] ap0_mode = AP0_PREDECODED ? i_ap0_mode : decode_ap0(i_sr);
+    wire [3:0] permitted_ap = ap_permissions(i_cpsr[ZAP_CPSR_MODE:0] == USR, i_rd, i_wr, ap0_mode);
+''' + source[end:]
+    old_inputs = '\t\tinput user;\n\t\tinput rd;\n\t\tinput wr;\n\t\tinput [1:0] sr;'
+    assert source.count(old_inputs) == 4
+    source = source.replace(old_inputs, '\t\tinput [3:0] ap_allowed;')
+    replacements = {
+        'reg [3:0] apsr;': 'reg [1:0] ap;',
+        'apsr[3:2]': 'ap',
+        '\t\t\tapsr[1:0] = sr[1:0];\n': '',
+        'is_apsr_ok(user, rd, wr, apsr) == APSR_OK': 'ap_allowed[ap]',
+        'i_cpsr[ZAP_CPSR_MODE:0] == USR, i_rd, i_wr, i_sr, i_dac_reg': 'permitted_ap, i_dac_reg',
+    }
+    for old, new in replacements.items():
+        assert source.count(old) == 4, old
+        source = source.replace(old, new)
+    source = source.replace('get_fsr_section', 'get_fsr_section_decoded')
+    source = edit(source, '\talways @(*) begin : tlb_match_logic', '''`ifndef SYNTHESIS
+    // Preserve the raw-S/R helper used by the I-cache observation fixture.
+    function automatic [7:0] get_fsr_section;
+        input user;
+        input rd;
+        input wr;
+        input [1:0] sr;
+        input [31:0] dac_reg;
+        input [19:0] tlb;
+        get_fsr_section = get_fsr_section_decoded(ap_permissions(user, rd, wr, decode_ap0(sr)), dac_reg, tlb);
+    endfunction
+`endif
+\talways @(*) begin : tlb_match_logic''')
+    parts[check] = source
+    return ''.join(parts)
+
+
 def move_fetch_payload_to_ram(phone):
     """Give the fetch queue a synchronous backing store behind its head FF."""
     start = phone.index('module ngage2_arm9v2_fetch (')
@@ -1281,6 +1375,7 @@ def main():
     generated = move_fetch_payload_to_ram(generated)
     if args.hinted_ldm:
         generated = issue_hinted_ldm(generated, edit)
+    generated = predecode_ap0_permissions(generated)
     generated = keep_wishbone_request_boundary(generated)
     if args.check:
         if output.read_text() != generated:
