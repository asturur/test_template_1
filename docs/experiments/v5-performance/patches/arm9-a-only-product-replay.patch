index 0000000..6a957dd
--- /dev/null
+++ b/scratch/v5-fit-loop/arm9-a-only-product/prepare-board.py
@@ -0,0 +1,87 @@
+"""Reuse the archived multiply guest and record its architectural writes."""
+from hashlib import sha256
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-arm9-a-only-product/board')
+out.mkdir(parents=True, exist_ok=True)
+fixture = stage / 'reference/tests/cpu/arm9v2_board'
+archive = Path('docs/experiments/v5-performance/patches/early-shift-select-replay.patch')
+assert sha256(archive.read_bytes()).hexdigest() == 'cddccf4f9b072e47a19e8168be0b57cf15491ec14699b852b60393d6fd64aa1b'
+marker = '+++ b/scratch/v5-fit-loop/early-shift-select/board-fixture/contract.S\n'
+addition = archive.read_text().split(marker, 1)[1].split('diff --git', 1)[0]
+original = '\n'.join(line[1:] for line in addition.splitlines() if line.startswith('+')) + '\n'
+basic, forwarding, abort = re.findall(r'^#ifdef MULTIPLY_SCHEDULE_TEST\n(.*?)^#endif$',
+                                     original, re.S | re.M)
+
+
+def edit(text, before, after):
+    assert text.count(before) == 1, before
+    return text.replace(before, after)
+
+
+guest = (fixture / 'contract.S').read_text()
+marker = '    ldr r8,=0x0a000000\n'
+guest = edit(guest, marker, 'mul_basic_start:\n' + basic + 'mul_basic_end:\n' + marker)
+marker = '    nop\n    nop\n    nop\n\n#ifdef SECTION_INDEX_TEST'
+guest = edit(guest, marker, '    nop\n    nop\n    nop\n\nmul_forward_start:\n' +
+             forwarding + 'mul_forward_end:\n\n#ifdef SECTION_INDEX_TEST')
+guest = edit(guest, 'data_abort:\n', 'data_abort:\n' + abort)
+(out / 'guest.S').write_text(guest)
+
+monitor = """
+`define MUL_CORE cpu.u_arm925t.u_zap.g_arm9.u_arm9_core
+`define MUL_EXECUTE `MUL_CORE.u_execute
+  reg [31:0] mul_basic_start, mul_basic_end, mul_forward_start, mul_forward_end;
+  reg [63:0] mul_digest = 64'hcbf29ce484222325;
+  integer mul_commits = 0, product_clocks = 0, early_launches = 0, early_w_operand = 0;
+  wire [31:0] mul_pc = `MUL_CORE.w[526:495];
+  wire mul_sample = (mul_pc >= mul_basic_start && mul_pc < mul_basic_end) ||
+                    (mul_pc >= mul_forward_start && mul_pc < mul_forward_end);
+  function automatic [63:0] mix_mul(input [63:0] digest, input [63:0] data);
+    mix_mul = (digest ^ data) * 64'h00000100000001b3;
+  endfunction
+  initial begin
+    if (!$value$plusargs("mul_basic_start=%h", mul_basic_start) ||
+        !$value$plusargs("mul_basic_end=%h", mul_basic_end) ||
+        !$value$plusargs("mul_forward_start=%h", mul_forward_start) ||
+        !$value$plusargs("mul_forward_end=%h", mul_forward_end))
+      $fatal(1, "Missing directed multiply window");
+  end
+  always @(posedge clk) if (!reset) begin
+    if (`MUL_EXECUTE.product_phase) product_clocks++;
+`ifdef REFERENCE_EARLY_SMULL
+    if (`MUL_EXECUTE.launch_smull) begin
+      early_launches++;
+      if (`MUL_EXECUTE.w_take) early_w_operand++;
+    end
+`endif
+    if (`MUL_CORE.wb_complete && mul_sample) begin
+      mul_commits++;
+      mul_digest = mix_mul(mul_digest, {mul_pc, `MUL_CORE.w[494:463]});
+      mul_digest = mix_mul(mul_digest, {30'b0, `MUL_CORE.wb_valid, `MUL_CORE.wb_dabt, `MUL_CORE.cpsr_next});
+      if (`MUL_CORE.wb_valid) begin
+        if (`MUL_CORE.wb_tag0 != 6'd16)
+          mul_digest = mix_mul(mul_digest, {26'b0, `MUL_CORE.wb_tag0, `MUL_CORE.wb_data0});
+        if (`MUL_CORE.wb_pair && `MUL_CORE.wb_tag1 != 6'd16)
+          mul_digest = mix_mul(mul_digest, {25'b0, 1'b1, `MUL_CORE.wb_tag1, `MUL_CORE.wb_data1});
+      end
+    end
+    if (device_ack && device_write && device_address == 32'hf0000000) begin
+      if (mul_commits == 0 || product_clocks == 0) $fatal(1, "Multiply phase was not exercised");
+`ifdef REFERENCE_EARLY_SMULL
+      if (early_launches == 0 || early_w_operand == 0)
+        $fatal(1, "Original early launch or W operand was not exercised");
+`endif
+      $display("MULTIPLY_ARCH commits=%0d digest=%016x", mul_commits, mul_digest);
+      $display("MULTIPLY_PHASE products=%0d early=%0d early_w_operand=%0d",
+               product_clocks, early_launches, early_w_operand);
+    end
+  end
+`undef MUL_EXECUTE
+`undef MUL_CORE
+"""
+bench = (fixture / 'contract.v').read_text()
+(out / 'contract.v').write_text(edit(bench, 'endmodule\n', monitor + 'endmodule\n'))
diff --git a/scratch/v5-fit-loop/arm9-a-only-product/board.sh b/scratch/v5-fit-loop/arm9-a-only-product/board.sh
