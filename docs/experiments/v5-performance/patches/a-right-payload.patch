+            if (i_instruction[27:26] == 1 && !i_instruction[25])
+                s_right_payload = {20'd0, i_instruction[11:0]};
+            else if (i_instruction[27:26] == 0 && i_instruction[22])
+                s_right_payload = {24'd0, i_instruction[11:8], i_instruction[3:0]};
+        end else if (i_kind == BLOCK)
+            s_right_payload = {{24 {i_offset[7]}}, i_offset};
+        else if (i_kind == BX || i_kind == SWP)
+            s_right_payload = operand[32+:32];
+        else if (i_kind == SUFFIX)
+            s_right_payload = {20'd0, i_instruction[10:0], 1'b0};
+
+        // The same-edge return to S's late right source overrides the
+        // instruction form. Port 1 retains the original final priority.
+        if (i_used[1] && !i_early[1] && s_wait[1] && !(|i_forward_match[4+:4])) begin
+            if (s_return_match[2]) s_right_payload = i_return_data[0+:32];
+            if (s_return_match[3]) s_right_payload = i_return_data[32+:32];
+        end
+    end
+`ifndef SYNTHESIS
+    always @(posedge i_clk)
+        if (!i_reset && RIGHT_PAYLOAD_FREE && accept && space !== 1'b1)
+            $fatal(1, "A right operand was admitted to an occupied slot");
+`endif
+''' + marker)
+    parts[execute] = source
+    return ''.join(parts)
