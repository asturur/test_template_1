+def capture_a_right_payload(phone):
+    """Use the existing A-space edge to capture its incoming right operand."""
+    parts = re.split(r'(?=^module )', phone, flags=re.M)
+    core = next(i for i, part in enumerate(parts) if part.startswith('module ngage2_arm9v2_core ('))
+    execute = next(i for i, part in enumerate(parts) if part.startswith('module ngage2_arm9v2_execute ('))
+    parts[core] = edit(parts[core], '\t\t.LATE_HOLD_STATIC(LATE_HOLD_STATIC)', '''\t\t.LATE_HOLD_STATIC(LATE_HOLD_STATIC),
+        .RIGHT_PAYLOAD_FREE(PAYLOAD_FREE && S_AGU)''')
+    source = edit(parts[execute], "\tparameter [0:0] LATE_HOLD_STATIC = 1'b1;",
+                  "\tparameter [0:0] LATE_HOLD_STATIC = 1'b1;\n    parameter [0:0] RIGHT_PAYLOAD_FREE = 1'b0;")
+    start = source.index('\t\t\tif (accept) begin\n')
+    end = source.index('\t\t\tif (o_redirect) begin\n', start)
+    admitted = source[start:end]
+    for value in (
+        'shifted', "{20'd0, i_instruction[11:0]}",
+        "{24'd0, i_instruction[11:8], i_instruction[3:0]}", '{{24 {i_offset[7]}}, i_offset}',
+        'operand[32+:32]', "{20'd0, i_instruction[10:0], 1'b0}",
+    ):
+        assignments = [line for line in admitted.splitlines(keepends=True) if line.strip() == f'a[249-:32] <= {value};']
+        [assignment] = assignments
+        admitted = edit(admitted, assignment, '')
+    admitted = edit(admitted, '1: a[249-:32] <= i_return_data[port * 32+:32];',
+                    '1: ;  // The right payload selects this return.')
+    source = source[:start] + admitted + '''            if (capture_right_payload)
+                a[249-:32] <= s_right_payload;
+''' + source[end:]
+    marker = '\talways @(posedge i_clk)\n\t\tif (i_reset || (!PAYLOAD_FREE && i_flush))'
+    source = edit(source, marker, '''    // A may capture an unused payload on a free edge. Its valid bit
+    // and all other packet fields still require actual S admission.
+    wire capture_right_payload = RIGHT_PAYLOAD_FREE ? space : accept;
+    reg [31:0] s_right_payload;
+    always @(*) begin
+        s_right_payload = shifted;
