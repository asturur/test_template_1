+"""Capture the shipped SPMark04 v1.10 torus with the original GLES renderer."""
+
+import argparse
+from collections import Counter
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+from struct import iter_unpack, pack, unpack_from
+
+from unicorn import Uc, UC_ARCH_ARM, UC_MODE_ARM, UC_HOOK_CODE, UC_HOOK_INTR
+from unicorn.arm_const import UC_ARM_REG_LR, UC_ARM_REG_PC, UC_ARM_REG_R0, UC_ARM_REG_SP, UC_CPU_ARM_926
+
+
+APP = 0x10000000
+GLES = 0x10100000
+RAM = 0x20000000
+ROM = 0x50000000
+STOP = 0x21200000
+OBJECT = RAM + 0x200
+WIDTH, HEIGHT = 176, 208
+ROM_SHA = 'be8b2ecdf5ff81f424b58838a8b93a1d1f65c0ae74890d2b96df8d5a7189b524'
+MODULE_SHA = {
+    'SPMark.app': 'f4d3819d0d7c21f6f669835d03cf9fd8c8b50aa3e0bac6975c4cbaccb09b3a4e',
+    '3DTEST.DLL': '5b918e3d10a8b4e91265325649c98c72fba7260be6cab37a102d7f50cd7eebef',
+    'libGLES_CM.dll': '3008a3900a91471200ea00b26733066aad288d589a7f48cefbfc0c6b62ebad2b',
+}
+
+
+def checked_input(path, expected):
+    data = path.read_bytes()
+    if sha256(data).hexdigest() != expected:
+        raise ValueError(f'Unexpected original input at {path}')
+    return data
+
+
+def u32(data, offset):
+    return unpack_from('<I', data, offset)[0]
+
+
+def exported_offset(data, ordinal):
+    assert 1 <= ordinal <= u32(data, 0x5c)
+    return u32(data, u32(data, 0x58) + (ordinal - 1) * 4)
+
+
+def import_slots(data):
+    imports = u32(data, 0x6c)
+    cursor = imports + 4
+    end_of_records = imports + u32(data, cursor)
+    slot = u32(data, 0x60)
+    while cursor < end_of_records:
+        name_offset, count = unpack_from('<II', data, cursor)
+        name = data[imports + name_offset:].split(b'\0', 1)[0].decode()
+        library, uid = name.split('[', 1)
+        cursor += 8
+        for _ in range(count):
+            yield library.upper(), int(uid.split(']')[0], 16), u32(data, cursor), slot
+            slot += 4
+            cursor += 4
+    assert cursor == end_of_records
+
+
+def linked_code(data, base):
+    code_start = u32(data, 0x64)
+    code_size = u32(data, 0x30)
+    image = bytearray(data[code_start:code_start + code_size])
+    assert len(image) == code_size
+    delta = base - APP
+    if delta:
+        relocation = u32(data, 0x70)
+        remaining = u32(data, relocation + 4)
+        cursor = relocation + 8
+        while remaining:
+            page, size = unpack_from('<II', data, cursor)
+            assert size >= 8 and size % 2 == 0
+            for entry, in iter_unpack('<H', data[cursor + 8:cursor + size]):
+                if entry:
+                    assert entry >> 12 in (1, 3)
+                    address = page + (entry & 0xfff)
+                    image[address:address + 4] = pack('<I', u32(image, address) + delta)
+                    remaining -= 1
+            assert remaining >= 0
+            cursor += size
+    return image
+
+
+def rom_export_table(rom, uid):
+    matches = [match.start() - 8 for match in re.finditer(re.escape(pack('<I', uid)), rom)
+               if match.start() >= 8 and u32(rom, match.start() - 8) == 0x10000079]
+    header, = matches
+    return u32(rom, header + 64) - ROM
+
+
+class Capture:
+    def __init__(self, app, gles, rom):
+        self.cpu = Uc(UC_ARCH_ARM, UC_MODE_ARM)
+        self.cpu.ctl_set_cpu_model(UC_CPU_ARM_926)
+        self.cpu.mem_map(ROM, 0x1400000)
+        self.cpu.mem_write(ROM, rom)
+        self.cpu.mem_map(APP, 0x200000)
+        self.cpu.mem_map(RAM, 0x200000)
+        self.cpu.mem_map(STOP, 0x10000)
+        self.gles = gles
+        self.code_sizes = {}
+        self.allocations = []
+        self.heap_top = RAM + 0x40000
+        self.tls = {}
+        self.services = {}
+        self.generated_code = []
+        self.draws = []
+        self.calls = Counter()
+        self.count_pcs = False
+        self.instructions = Counter()
+
+        # Emulate platform allocation and TLS. Geometry, GL state, memory
+        # routines, soft float, raster generation and drawing run as guest ARM.
+        services = {
+            ('EUSER', 35): self.allocate,
+            ('EUSER', 335): self.set_tls,
+            ('EUSER', 336): self.get_tls,
+            ('EUSER', 1650): self.sync_generated_code,
+            ('ESTLIB', 3): self.allocate,
+            ('ESTLIB', 6): lambda: 0,
+        }
+        tables = {}
+        for image, base in ((app, APP), (gles, GLES)):
+            linked = linked_code(image, base)
+            for library, uid, ordinal, slot in import_slots(image):
+                if library == 'LIBGLES_CM':
+                    address = GLES + exported_offset(gles, ordinal)
+                else:
+                    if uid not in tables:
+                        tables[uid] = rom_export_table(rom, uid)
+                    address = u32(rom, tables[uid] + 4 * (ordinal - 1))
+                    if (library, ordinal) in services:
+                        self.services[address & ~1] = services[library, ordinal]
+                linked[slot:slot + 4] = pack('<I', address)
+            self.cpu.mem_write(base, bytes(linked))
+            self.code_sizes[base] = len(linked)
+
+        self.draw_pc = GLES + exported_offset(gles, 55)
+        self.swap_pc = GLES + exported_offset(gles, 22)
+        self.cpu.hook_add(UC_HOOK_CODE, self.observe)
+        self.cpu.hook_add(UC_HOOK_INTR, self.unhandled_interrupt)
+
+    def reg(self, index):
+        return self.cpu.reg_read(UC_ARM_REG_R0 + index)
+
+    def read(self, address, size):
+        return bytes(self.cpu.mem_read(address, size))
+
+    def write_words(self, address, *words):
+        self.cpu.mem_write(address, pack(f'<{len(words)}I', *words))
+
+    def allocate(self):
+        size = self.reg(0)
+        address = self.heap_top
+        self.heap_top += (size + 7) & ~7
+        assert self.heap_top < RAM + 0x1c0000
+        self.cpu.mem_write(address, bytes(size))
+        self.allocations.append((address, size))
+        return address
+
+    def set_tls(self):
+        self.tls[self.reg(0)] = self.reg(1)
+        return 0
+
+    def get_tls(self):
+        return self.tls.get(self.reg(0), 0)
+
+    def sync_generated_code(self):
+        begin, end = self.reg(0), self.reg(1)
+        assert RAM <= begin < end < self.heap_top
+        self.generated_code.append((begin, end))
+        self.cpu.ctl_remove_cache(begin, end)
+        return 0
+
+    def observe(self, cpu, pc, _size, _data):
+        if self.count_pcs:
+            self.instructions[pc] += 1
+        if pc == self.draw_pc:
+            self.draws.append(tuple(self.reg(n) for n in range(4)))
+        if pc == self.swap_pc:
+            self.calls[pc] += 1
+        if pc in self.services:
+            self.calls[pc] += 1
+            cpu.reg_write(UC_ARM_REG_R0, self.services[pc]())
+            cpu.reg_write(UC_ARM_REG_PC, cpu.reg_read(UC_ARM_REG_LR))
+
+    def unhandled_interrupt(self, cpu, number, _data):
+        pc = cpu.reg_read(UC_ARM_REG_PC)
+        lr = cpu.reg_read(UC_ARM_REG_LR)
+        raise RuntimeError(f'Unhandled guest interrupt {number} at {pc:08x}, LR {lr:08x}')
+
+    def call(self, pc, *args):
+        for index, value in enumerate(args[:4]):
+            self.cpu.reg_write(UC_ARM_REG_R0 + index, value)
+        stack = RAM + 0x20000
+        self.cpu.reg_write(UC_ARM_REG_SP, stack)
+        if len(args) > 4:
+            self.write_words(stack, *args[4:])
+        self.cpu.reg_write(UC_ARM_REG_LR, STOP)
+        self.cpu.emu_start(pc, STOP, count=120_000_000)
+        assert self.cpu.reg_read(UC_ARM_REG_PC) == STOP
+        return self.reg(0)
+
+    def gl_call(self, ordinal, *args):
+        return self.call(GLES + exported_offset(self.gles, ordinal), *args)
+
+    def setup(self):
+        display = self.gl_call(14, 0)
+        assert display and self.gl_call(17, display, RAM, RAM + 4)
+        # Match the app's requested depth and the phone's 16-bit color.
+        # The EGL pbuffer bit replaces the native window surface.
+        self.write_words(RAM + 0x40, 0x3020, 0, 0x3025, 32, 0x3033, 1, 0x3038)
+        config = RAM + 0x100
+        assert self.gl_call(1, display, RAM + 0x40, config, 1, config + 4)
+        config_id, count = unpack_from('<II', self.read(config, 8))
+        assert config_id and count == 1
+        context = self.gl_call(3, display, config_id, 0, 0)
+        self.write_words(RAM + 0x80, 0x3057, WIDTH, 0x3056, HEIGHT, 0x3038)
+        surface = self.gl_call(4, display, config_id, RAM + 0x80)
+        assert context and surface and self.gl_call(18, display, surface, surface, context)
+        self.write_words(OBJECT + 36, display, surface)
+        self.write_words(OBJECT + 68, 0xb40000, 0)
+        self.call(APP + 0x10f4, OBJECT)
+        self.call(APP + 0x1390, OBJECT)
+        self.call(APP + 0x1bbc, OBJECT)
+        return config_id
+
+    def check_pixel_format(self, config):
+        display = u32(self.read(OBJECT + 36, 4), 0)
+        widths = []
+        for attribute in (0x3020, 0x3024, 0x3023, 0x3022, 0x3021, 0x3025):
+            assert self.gl_call(9, display, config, attribute, RAM + 0x140)
+            widths.append(u32(self.read(RAM + 0x140, 4), 0))
+        assert widths == [16, 4, 4, 4, 0, 32]
+        return dict(zip(('color_storage', 'red', 'green', 'blue', 'alpha', 'depth'), widths, strict=True))
+
+    def frame(self, index, out):
+        self.instructions.clear()
+        self.calls.clear()
+        self.draws.clear()
+        self.count_pcs = True
+        self.call(APP + 0x1e00, OBJECT, 0)
+        self.count_pcs = False
+        draw, = self.draws
+        assert draw[:3] == (4, 14400, 0x1403) and self.calls[self.swap_pc] == 1
+        object_data = self.read(OBJECT, 80)
+        assert unpack_from('<III', object_data, 56) == (2400, 14400, index + 1)
+        indices = self.read(draw[3], 14400 * 2)
+        buffers = []
+        for size, name in ((WIDTH * HEIGHT * 2, 'surface0'), (WIDTH * HEIGHT * 4, 'surface1')):
+            address, = [start for start, allocated in self.allocations if allocated == size]
+            data = self.read(address, size)
+            assert len(set(iter_unpack('<H', data))) > 1
+            buffers.append((hex(address), size, sha256(data).hexdigest()))
+            if index == 4:
+                (out / f'{name}.bin').write_bytes(data)
+        if index == 4:
+            (out / 'object.bin').write_bytes(object_data)
+            (out / 'indices.bin').write_bytes(indices)
+            check_torus(indices)
+        return dict(draw=draw, buffers=buffers, calls={hex(k): v for k, v in self.calls.items()},
+                    jit=self.generated_code.copy(), arm_instruction_callbacks=sum(self.instructions.values()),
+                    pc_with_counts=sorted(self.instructions.items()))
+
+
+def check_torus(indices):
+    vertices = [vertex for vertex, in iter_unpack('<H', indices)]
+    assert set(vertices) == set(range(2400))
+    triangles = list(zip(vertices[::3], vertices[1::3], vertices[2::3], strict=True))
+    assert len({tuple(sorted(face)) for face in triangles}) == 4800
+    edge_counts = Counter(tuple(sorted(edge)) for a, b, c in triangles for edge in ((a, b), (b, c), (c, a)))
+    assert len(edge_counts) == 7200 and set(edge_counts.values()) == {2}
+
+
+def main():
+    root = Path(__file__).resolve().parents[3]
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--payload-dir', type=Path, required=True)
+    parser.add_argument('--rom', type=Path, default=root / 'build/firmware/nem4-factory/core.bin')
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    modules = {name: checked_input(args.payload_dir / name, digest) for name, digest in MODULE_SHA.items()}
+    replay = Capture(modules['SPMark.app'], modules['libGLES_CM.dll'], checked_input(args.rom, ROM_SHA))
+    config = replay.setup()
+    args.output.mkdir(parents=True)
+    frames = []
+    for index in range(5):
+        if index == 1:
+            for name, base in (('app', APP), ('gles', GLES)):
+                (args.output / f'{name}.bin').write_bytes(replay.read(base, replay.code_sizes[base]))
+            (args.output / 'heap.bin').write_bytes(replay.read(RAM, replay.heap_top - RAM))
+        frames.append(replay.frame(index, args.output))
+        print(f"Frame {index} completed with {frames[-1]['arm_instruction_callbacks']:,} ARM callbacks", flush=True)
+    result = dict(frames=frames, config=config, pixel_format=replay.check_pixel_format(config),
+                  tls=replay.tls, allocations=replay.allocations,
+                  rom_sha=ROM_SHA, module_sha=MODULE_SHA)
+    (args.output / 'oracle.json').write_text(json.dumps(result) + '\n')
+
+
+if __name__ == '__main__':
+    main()
