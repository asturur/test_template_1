+// Simulation-only timestamps follow the A/M/W/skid packets. Verify the
+// successor at retirement, then use its earlier S->A timestamp. This excludes
+// wrong-path acceptances while retaining useful issue before W resolution.
+`ifdef NGAGE_CONTROL_FLOW_CONTRACT
+`define FLOW_CPU cpu.u_arm925t
+`else
+`define FLOW_CPU dut.board.upp.cpu_inside.cpu.u_arm925t
+`endif
+`define FLOW_ZAP `FLOW_CPU.u_zap
+`define FLOW_CORE `FLOW_ZAP.g_arm9.u_arm9_core
+`define FLOW_A `FLOW_CORE.u_execute
+`define FLOW_F `FLOW_CORE.u_front_decode.u_fetch
+`define FLOW_TLB `FLOW_IC.u_zap_tlb.u_zap_tlb_fsm
+`define FLOW_IC `FLOW_ZAP.l_generate_with_cache_mmu.u_code_cache
+
+typedef struct packed {
+    integer issued;
+    integer resolved;
+    reg [31:0] pc, ins, target;
+    reg thumb, target_thumb, direct, redirect;
+    integer issued_total, refill_total, walk_total, backend_total, front_total;
+    integer preceding_refill, preceding_walk;
+    reg [31:5] refill_line;
+    reg [31:10] walk_page;
+    reg mixed_refill, mixed_walk;
+} flow_stamp;
+
+flow_stamp flow_a, flow_m, flow_w, flow_skid, flow_branch;
+integer flow_issue_total = 0, flow_refill_total = 0, flow_walk_total = 0;
+integer flow_backend_total = 0, flow_front_total = 0;
+integer flow_gap_refill = 0, flow_gap_walk = 0;
+reg [31:5] flow_refill_line;
+reg [31:10] flow_walk_page;
+reg flow_mixed_refill = 0, flow_mixed_walk = 0;
+
+integer flow_kind, flow_pred, flow_events;
+integer flow_canceled, flow_matches;
+reg flow_active = 0, flow_pending = 0, flow_w_redirect;
+reg flow_trace, flow_trace_stages;
+integer flow_samples = 0;
+initial begin
+    flow_trace = $test$plusargs("flow-trace");
+    flow_trace_stages = $test$plusargs("flow-stages");
+end
+
+// Categories are independent of the score window and encoding mode.
+localparam integer FLOW_TAKEN = 0, FLOW_FALL = 1, FLOW_CALL = 2, FLOW_B = 3,
+                   FLOW_BX = 4, FLOW_BX_LR = 5, FLOW_MOV_LR = 6, FLOW_LDM_PC = 7,
+                   FLOW_T_BL = 8, FLOW_T_BX_LR = 9, FLOW_T_POP_PC = 10,
+                   FLOW_OTHER_PC = 11, FLOW_BX_FALL = 12, FLOW_KINDS = 13;
+localparam integer FLOW_CORRECT = 0, FLOW_WRONG = 1, FLOW_TARGET_MISS = 2, FLOW_NO_TAG_FALL = 3;
+localparam integer FLOW_BUCKETS = FLOW_KINDS * 4;
+
+integer flow_count[0:FLOW_BUCKETS-1], flow_next[0:FLOW_BUCKETS-1];
+integer flow_issue_sum[0:FLOW_BUCKETS-1], flow_resolve_sum[0:FLOW_BUCKETS-1];
+integer flow_issue_max[0:FLOW_BUCKETS-1], flow_a_redirects[0:FLOW_BUCKETS-1];
+integer flow_w_redirects[0:FLOW_BUCKETS-1], flow_refill[0:FLOW_BUCKETS-1];
+integer flow_walk[0:FLOW_BUCKETS-1], flow_backend[0:FLOW_BUCKETS-1];
+integer flow_front[0:FLOW_BUCKETS-1], flow_other_issue[0:FLOW_BUCKETS-1];
+integer flow_target_fill[0:FLOW_BUCKETS-1], flow_target_walk[0:FLOW_BUCKETS-1];
+integer flow_no_fetch_ready[0:FLOW_BUCKETS-1], flow_direct[0:FLOW_BUCKETS-1];
+integer flow_no_i_wait[0:FLOW_BUCKETS-1], flow_no_i_wait_sum[0:FLOW_BUCKETS-1];
+
+task automatic reset_control_flow();
+    flow_active = 1;
+    flow_pending = 0;
+    flow_events = 0;
+    flow_matches = 0;
+    flow_canceled = 0;
+    foreach (flow_count[i]) begin
+        flow_count[i] = 0; flow_next[i] = 0;
+        flow_issue_sum[i] = 0; flow_resolve_sum[i] = 0; flow_issue_max[i] = 0;
+        flow_a_redirects[i] = 0; flow_w_redirects[i] = 0; flow_direct[i] = 0;
+        flow_refill[i] = 0; flow_walk[i] = 0; flow_backend[i] = 0;
+        flow_front[i] = 0; flow_other_issue[i] = 0;
+        flow_target_fill[i] = 0; flow_target_walk[i] = 0;
+        flow_no_fetch_ready[i] = 0;
+        flow_no_i_wait[i] = 0; flow_no_i_wait_sum[i] = 0;
+    end
+endtask
+
+task automatic finish_control_flow(input flow_stamp successor);
+    integer bucket, elapsed, refill, walk, issued, backend, front;
+    reg [31:0] va;
+    bucket = flow_kind * 4 + flow_pred;
+    elapsed = successor.issued - flow_branch.issued;
+    issued = successor.issued_total - flow_branch.issued_total - 1;
+    refill = successor.refill_total - flow_branch.refill_total;
+    walk = successor.walk_total - flow_branch.walk_total;
+    backend = successor.backend_total - flow_branch.backend_total;
+    front = successor.front_total - flow_branch.front_total;
+    va = `FLOW_CORE.fcse(flow_branch.target);
+    if (successor.pc != flow_branch.target || successor.thumb != flow_branch.target_thumb ||
+        elapsed < 1 || issued + refill + walk + backend + front != elapsed - 1)
+        $fatal(1, "Control-flow ownership pc=%h mode=%b expected=%h/%b observed=%h/%b cycles=%0d:%0d",
+               flow_branch.pc, flow_branch.thumb, flow_branch.target, flow_branch.target_thumb,
+               successor.pc, successor.thumb, flow_branch.issued, successor.issued);
+    flow_matches += 1;
+    flow_count[bucket] += 1;
+    flow_next[bucket] += int'(elapsed == 1);
+    flow_issue_sum[bucket] += elapsed;
+    flow_resolve_sum[bucket] += successor.issued - flow_branch.resolved;
+    if (elapsed > flow_issue_max[bucket]) flow_issue_max[bucket] = elapsed;
+    flow_a_redirects[bucket] += int'(flow_branch.redirect);
+    flow_w_redirects[bucket] += int'(flow_w_redirect);
+    flow_direct[bucket] += int'(flow_branch.direct);
+    flow_refill[bucket] += refill; flow_walk[bucket] += walk;
+    flow_backend[bucket] += backend; flow_front[bucket] += front;
+    flow_other_issue[bucket] += issued;
+    // Attribute only a contiguous final no-issue interval with an
+    // unambiguous virtual line owner to this target.
+    if (!successor.mixed_refill && successor.refill_line == va[31:5])
+        flow_target_fill[bucket] += successor.preceding_refill;
+    if (!successor.mixed_walk && successor.walk_page == va[31:10])
+        flow_target_walk[bucket] += successor.preceding_walk;
+    if (refill + walk == 0) begin
+        flow_no_i_wait[bucket] += 1;
+        flow_no_i_wait_sum[bucket] += elapsed;
+    end
+    if (refill + walk + backend == 0 && front > 0)
+        flow_no_fetch_ready[bucket] += 1;
+    if (flow_pred == FLOW_CORRECT && front == elapsed - 1 && elapsed > 1 &&
+        flow_kind != FLOW_TAKEN && flow_kind != FLOW_FALL && flow_samples < 24) begin
+        flow_samples += 1;
+        $display("FLOW_DELAYED pc=%h target=%h kind=%0d direct=%b clocks=%0d", flow_branch.pc,
+                 successor.pc, flow_kind, flow_branch.direct, elapsed);
+    end
+    if (flow_trace)
+        $display("FLOW_EVENT pc=%h ins=%h thumb=%b target=%h target_thumb=%b kind=%0d pred=%0d issue=%0d resolve=%0d arrives=%0d a_redirect=%b w_redirect=%b direct=%b refill=%0d walk=%0d backend=%0d front=%0d speculative=%0d",
+                 flow_branch.pc, flow_branch.ins, flow_branch.thumb, successor.pc, successor.thumb,
+                 flow_kind, flow_pred, flow_branch.issued, flow_branch.resolved, successor.issued,
+                 flow_branch.redirect, flow_w_redirect, flow_branch.direct, refill, walk, backend,
+                 front, issued);
+    flow_pending = 0;
+endtask
+
+task automatic observe_control_flow(input integer clock);
+    flow_stamp retiring;
+    reg branch, late_target, taken, predicted, hit;
+    reg [31:0] pred_target;
+    reg [31:5] fill_owner;
+    reg [31:10] walk_owner;
+    reg refill_busy, walk_busy;
+    refill_busy = `FLOW_IC.o_fill_pending || `FLOW_IC.o_fill_done ||
+                  `FLOW_IC.u_zap_cache_fsm.state_ff == `FLOW_IC.u_zap_cache_fsm.UNCACHEABLE;
+    walk_busy = `FLOW_IC.tlb_busy;
+    fill_owner = `FLOW_IC.u_zap_cache_fsm.address[31:5];
+    walk_owner = `FLOW_TLB.address[31:10];
+    if (flow_active && flow_trace_stages)
+        $display("FLOW_STAGE c=%0d f1=%h f2=%h q=%h qv=%b push=%b fpop=%b d2v=%b s=%h sv=%b accept=%b finish=%b backend=%b dec_redirect=%b a_redirect=%b w_redirect=%b fill=%b fill_line=%h walk=%b walk_page=%h",
+                 clock, `FLOW_F.f1[31:0], `FLOW_F.f2[31:0], `FLOW_F.o_pc, `FLOW_F.o_valid,
+                 `FLOW_F.push, `FLOW_F.pop, `FLOW_CORE.u_front_decode.u_decode.d2_valid,
+                 `FLOW_CORE.d_pc, `FLOW_CORE.d_valid, `FLOW_A.accept, `FLOW_A.finish,
+                 !`FLOW_CORE.backend_ready, `FLOW_CORE.u_front_decode.o_redirect,
+                 `FLOW_CORE.a_redirect, `FLOW_CORE.wb_redirect, refill_busy, {fill_owner,5'b0},
+                 walk_busy, {walk_owner,10'b0});
+    if (`FLOW_CORE.wb_complete && flow_active) begin
+        if (`FLOW_CORE.wb_exception) begin
+            flow_canceled += int'(flow_pending);
+            flow_pending = 0;
+        end else begin
+            retiring = flow_w;
+            if (retiring.pc != `FLOW_CORE.w[526:495] || retiring.ins != `FLOW_CORE.w[494:463] ||
+                retiring.thumb != `FLOW_CORE.w[539] || retiring.issued >= clock)
+                $fatal(1, "Control-flow shadow mismatch at %h cycle=%0d", `FLOW_CORE.w[526:495], clock);
+            if (flow_pending) finish_control_flow(retiring);
+            branch = 0;
+            taken = `FLOW_CORE.w[540];
+            late_target = `FLOW_CORE.return_event;
+            case (`FLOW_CORE.w[8:5])
+                4'd3: begin
+                    branch = 1;
+                    if (!taken) flow_kind = FLOW_FALL;
+                    else if (!retiring.thumb && retiring.ins[24]) flow_kind = FLOW_CALL;
+                    else flow_kind = (retiring.ins[31:28] == 4'he ? FLOW_B : FLOW_TAKEN);
+                end
+                4'd4: begin
+                    branch = 1;
+                    if (!taken) flow_kind = FLOW_BX_FALL;
+                    else if (retiring.ins[3:0] != 14) flow_kind = FLOW_BX;
+                    else flow_kind = (retiring.thumb ? FLOW_T_BX_LR : FLOW_BX_LR);
+                end
+                4'd11: begin
+                    branch = 1;
+                    flow_kind = FLOW_T_BL;
+                end
+                default: if (late_target) begin
+                    branch = 1;
+                    if (`FLOW_CORE.w[8:5] == 6)
+                        flow_kind = (retiring.thumb ? FLOW_T_POP_PC : FLOW_LDM_PC);
+                    else if ((retiring.ins & 32'h0fffffff) == 32'h01a0f00e)
+                        flow_kind = FLOW_MOV_LR;
+                    else flow_kind = FLOW_OTHER_PC;
+                end
+            endcase
+            if (branch && `FLOW_CORE.w[536]) begin
+                flow_events += 1;
+                flow_w_redirect = `FLOW_CORE.wb_redirect;
+                if (late_target) begin
+                    retiring.target = `FLOW_CORE.return_target;
+                    retiring.target_thumb = `FLOW_CORE.return_thumb;
+                    retiring.resolved = clock;
+                end
+                if (!taken) begin
+                    retiring.target = `FLOW_CORE.w[206:175];
+                    retiring.target_thumb = retiring.thumb;
+                end
+                hit = `FLOW_CORE.w[4];
+                predicted = `FLOW_CORE.w[532];
+                pred_target = `FLOW_CORE.w[174:143];
+                if (taken && predicted && pred_target == {retiring.target[31:1], retiring.target_thumb})
+                    flow_pred = FLOW_CORRECT;
+                else if (!taken && !predicted)
+                    flow_pred = (hit ? FLOW_CORRECT : FLOW_NO_TAG_FALL);
+                else
+                    flow_pred = ((hit || predicted) ? FLOW_WRONG : FLOW_TARGET_MISS);
+                flow_pending = 1;
+                flow_branch = retiring;
+            end
+        end
+    end
+
+    if (`FLOW_A.finish) begin
+        flow_a.resolved = clock;
+        flow_a.direct = `FLOW_A.a[315];
+        flow_a.redirect = `FLOW_A.wrong_prediction;
+        flow_a.target = (`FLOW_CORE.a_kind == 11 && flow_a.direct) ?
+                        `FLOW_A.a[419:388] : `FLOW_A.actual_target;
+        flow_a.target_thumb = `FLOW_A.actual_thumb;
+    end
+    if (`FLOW_CORE.memory_state == 0 && `FLOW_CORE.done ||
+        `FLOW_CORE.memory_state == 3 ||
+        `FLOW_CORE.memory_state == 1 && `FLOW_CORE.done && `FLOW_CORE.quick_reload) begin
+        flow_w = flow_m;
+        flow_m = (`FLOW_CORE.memory_state == 0) ? flow_a : flow_skid;
+    end else if (`FLOW_CORE.memory_state == 0)
+        flow_skid = flow_a;
+
+    if (`FLOW_A.accept) begin
+        flow_a = '0;
+        flow_a.issued = clock;
+        flow_a.pc = `FLOW_CORE.d_pc;
+        flow_a.ins = `FLOW_CORE.d_instruction;
+        flow_a.thumb = `FLOW_CORE.d_thumb;
+        flow_a.issued_total = flow_issue_total;
+        flow_a.refill_total = flow_refill_total;
+        flow_a.walk_total = flow_walk_total;
+        flow_a.backend_total = flow_backend_total;
+        flow_a.front_total = flow_front_total;
+        flow_a.preceding_refill = flow_gap_refill;
+        flow_a.preceding_walk = flow_gap_walk;
+        flow_a.refill_line = flow_refill_line;
+        flow_a.walk_page = flow_walk_page;
+        flow_a.mixed_refill = flow_mixed_refill;
+        flow_a.mixed_walk = flow_mixed_walk;
+        flow_issue_total += 1;
+        flow_gap_refill = 0; flow_gap_walk = 0;
+        flow_mixed_refill = 0; flow_mixed_walk = 0;
+    end else if (`FLOW_CORE.request || `FLOW_CORE.memory_state != 0 ||
+                 `FLOW_CORE.a_a_valid && !`FLOW_A.finish ||
+                 `FLOW_CORE.d_valid && !`FLOW_A.o_ready_payload || `FLOW_CORE.d_hazard) begin
+        flow_backend_total += 1;
+    end else if (walk_busy) begin
+        flow_mixed_walk |= flow_gap_walk != 0 && flow_walk_page != walk_owner;
+        flow_walk_page = walk_owner;
+        flow_gap_walk += 1;
+        flow_walk_total += 1;
+    end else if (refill_busy) begin
+        flow_mixed_refill |= flow_gap_refill != 0 && flow_refill_line != fill_owner;
+        flow_refill_line = fill_owner;
+        flow_gap_refill += 1;
+        flow_refill_total += 1;
+    end else
+        flow_front_total += 1;
+endtask
+
+task automatic report_control_flow(input integer window);
+    $display("FLOW_WINDOW window=%0d events=%0d matched=%0d canceled=%0d pending=%0d",
+             window, flow_events, flow_matches, flow_canceled, int'(flow_pending));
+    if (flow_events != flow_matches + flow_canceled + int'(flow_pending))
+        $fatal(1, "Incomplete control-flow accounting");
+    foreach (flow_count[i]) if (flow_count[i] != 0)
+        $display("FLOW_BUCKET window=%0d kind=%0d pred=%0d n=%0d next=%0d issue_sum=%0d resolve_sum=%0d issue_max=%0d a_redirect=%0d w_redirect=%0d direct=%0d refill=%0d walk=%0d backend=%0d front=%0d other_issue=%0d target_refill=%0d target_walk=%0d front_only=%0d no_i_wait=%0d no_i_wait_sum=%0d",
+                 window, i / 4, i % 4, flow_count[i], flow_next[i], flow_issue_sum[i],
+                 flow_resolve_sum[i], flow_issue_max[i], flow_a_redirects[i], flow_w_redirects[i],
+                 flow_direct[i], flow_refill[i], flow_walk[i], flow_backend[i], flow_front[i],
+                 flow_other_issue[i], flow_target_fill[i], flow_target_walk[i],
+                 flow_no_fetch_ready[i], flow_no_i_wait[i], flow_no_i_wait_sum[i]);
+    flow_active = 0;
+endtask
+
+`undef FLOW_TLB
+`undef FLOW_F
+`undef FLOW_IC
+`undef FLOW_A
+`undef FLOW_CORE
+`undef FLOW_ZAP
+`undef FLOW_CPU
--- /dev/null
+++ b/tests/cpu/arm9v2_board/icache_hum_observe.vh
@@ -0,0 +1,152 @@
+// Simulation-only readout of resident tags and current section translations.
+`ifdef NGAGE_IC_RESTART_CONTRACT
+`define HUM_CPU cpu
+`else
+`define HUM_CPU dut.board.upp.cpu_inside.cpu
+`endif
+`define HUM_ZAP `HUM_CPU.u_arm925t.u_zap
+`define HUM_IC `HUM_ZAP.l_generate_with_cache_mmu.u_code_cache
+`define HUM_FSM `HUM_IC.u_zap_cache_fsm
+`define HUM_TAG `HUM_IC.u_zap_cache_tag_ram
+`define HUM_TLB `HUM_IC.u_zap_tlb
+`define HUM_SECTION `HUM_TLB.u_section_tlb.g_short
+`define HUM_CORE `HUM_ZAP.g_arm9.u_arm9_core
+`define HUM_FETCH `HUM_CORE.u_front_decode.u_fetch
+`define HUM_A `HUM_CORE.u_execute
+
+// 16 KiB / (2 * 32 bytes) sets. The shadow observes the actual write port.
+reg [45:0] hum_tag[2][256];
+reg [255:0] hum_valid[2];
+reg hum_monitor = 0, hum_redirect = 0, hum_trace;
+reg [31:0] hum_redirect_pc;
+reg hum_redirect_thumb;
+integer hum_fill, hum_diff, hum_trans, hum_miss, hum_victim;
+integer hum_hit, hum_same_set, hum_exposed, hum_overlap, hum_push;
+integer hum_pending, hum_pending_exposed;
+
+// Section translation is exact for these replays. A page or unavailable
+// translation stays in the unverified bucket.
+localparam integer HUM_SEC_W = 6;
+initial if (`HUM_TLB.SECTION_TLB_ENTRIES != 64 || `HUM_TAG.LINES != 256 || `HUM_TAG.WAYS != 2)
+    $fatal(1, "Unexpected TLB or cache geometry in hit-under-miss observer");
+initial hum_trace = $test$plusargs("hum-trace");
+
+task automatic reset_icache_hum();
+    hum_monitor = 1;
+    hum_fill = 0; hum_diff = 0; hum_trans = 0; hum_miss = 0; hum_victim = 0;
+    hum_hit = 0; hum_same_set = 0; hum_exposed = 0; hum_overlap = 0; hum_push = 0;
+    hum_pending = 0; hum_pending_exposed = 0;
+endtask
+
+task automatic observe_icache_hum(input integer clock);
+    reg active, demand, is_pending, backend, translated;
+    reg [31:0] wanted_pc, va, pa, descriptor;
+    reg [HUM_SEC_W-1:0] sec;
+    reg [11-HUM_SEC_W:0] sec_tag;
+    reg [7:0] set_index;
+    integer disposition, way;
+    if (!`HUM_IC.i_cache_en || `HUM_TAG.tag_ram_clear) begin
+        hum_valid[0] = '0;
+        hum_valid[1] = '0;
+    end else begin
+        if (`HUM_TAG.line_clear)
+            hum_valid[`HUM_TAG.rd_way][`HUM_TAG.rd_set] = 0;
+        if (`HUM_TAG.tag_ram_wr_en && !`HUM_TAG.i_hold)
+            for (integer w = 0; w < 2; w++)
+                if (`HUM_TAG.wr_sel[w]) begin
+                    hum_tag[w][`HUM_TAG.tag_ram_wr_addr] = `HUM_TAG.tag_ram_wr_data;
+                    hum_valid[w][`HUM_TAG.tag_ram_wr_addr] = 1;
+                end
+    end
+    active = `HUM_FSM.state_ff == `HUM_FSM.FETCH_SINGLE && `HUM_FSM.fill_no_late_error_ff &&
+             !`HUM_FSM.fill_fault_ff && !`HUM_IC.i_tlb_inv &&
+             !`HUM_IC.i_cache_inv_req && !`HUM_IC.i_cache_clean_req && `HUM_IC.i_cache_en;
+    if (!active) hum_redirect = 0;
+    if (active && `HUM_FETCH.i_redirect) begin
+        hum_redirect = 1;
+        hum_redirect_pc = `HUM_FETCH.i_redirect_target & 32'hfffffffe;
+        hum_redirect_thumb = `HUM_FETCH.i_redirect_thumb;
+    end
+    if (hum_redirect && `HUM_IC.i_rd && `HUM_FETCH.f2[31:0] == hum_redirect_pc &&
+        `HUM_FETCH.f2[34] == hum_redirect_thumb)
+        hum_redirect = 0;
+    demand = `HUM_IC.i_rd || hum_redirect;
+    is_pending = hum_redirect && !`HUM_IC.i_rd;
+    wanted_pc = is_pending ? hum_redirect_pc : `HUM_FETCH.f2[31:0];
+    va = `HUM_CORE.fcse(wanted_pc) & 32'hfffffffc;
+    if (hum_monitor && active) begin
+        hum_fill += 1;
+        if (demand && va[31:5] != `HUM_FSM.address[31:5]) begin
+            hum_diff += 1;
+            set_index = va[12:5];
+            sec = `HUM_TLB.section_index(va[31:20]);
+            {sec_tag, descriptor} = `HUM_SECTION.u_ram.g_short.mem[sec];
+            pa = `HUM_IC.i_mmu_en ? {descriptor[31:20],va[19:0]} : va;
+            translated = !`HUM_IC.i_mmu_en ||
+                         (`HUM_SECTION.u_gen.g_short.mem[sec] == {1'b1,`HUM_SECTION.gen} &&
+                          va[31:20+HUM_SEC_W] == sec_tag && descriptor[3] &&
+                          `HUM_TLB.u_zap_tlb_check.get_fsr_section(`HUM_IC.i_cpsr == 5'h10, 1'b1, 1'b0,
+                                      `HUM_IC.i_sr, `HUM_IC.i_dac_reg, descriptor[19:0]) == 0);
+            way = -1;
+            if (translated)
+                for (integer w = 0; w < 2; w++)
+                    if (hum_valid[w][set_index] && hum_tag[w][set_index] == {pa[31:5],va[31:13]})
+                        way = w;
+            backend = `HUM_A.accept || `HUM_CORE.request || `HUM_CORE.memory_state != 0 ||
+                      (`HUM_CORE.a_a_valid && !`HUM_A.finish) ||
+                      (`HUM_CORE.d_valid && !`HUM_A.o_ready_payload) || `HUM_CORE.d_hazard;
+            if (!translated) begin
+                hum_trans += 1;
+                disposition = 0;
+            end else if (way < 0) begin
+                hum_miss += 1;
+                disposition = 1;
+            end else if (set_index == `HUM_FSM.address[12:5] && way == int'(`HUM_FSM.way)) begin
+                hum_victim += 1;
+                disposition = 2;
+            end else begin
+                hum_hit += 1;
+                disposition = 3;
+                if (set_index == `HUM_FSM.address[12:5]) hum_same_set += 1;
+                if (backend || `HUM_FETCH.o_valid) hum_overlap += 1;
+                else hum_exposed += 1;
+                if (is_pending) begin
+                    hum_pending += 1;
+                    if (!backend && !`HUM_FETCH.o_valid) hum_pending_exposed += 1;
+                end
+            end
+            if (`HUM_FETCH.push && `HUM_IC.i_rd) begin
+                hum_push += 1;
+                if (translated && disposition != 3)
+                    $fatal(1, "Different-line fetch without a safe resident source");
+            end
+            if (hum_trace)
+                $display("HUM_DEMAND c=%0d pc=%h pa=%h way=%0d class=%0d pending=%b tlb=%b ack=%b push=%b backend=%b fill=%h fillway=%b beat=%b bankread=%h",
+                         clock, wanted_pc, pa, way, disposition, is_pending, translated,
+                         `HUM_IC.o_ack, `HUM_FETCH.push, backend, `HUM_FSM.address,
+                         `HUM_FSM.way, `HUM_FSM.take, `HUM_TAG.rd_set);
+        end
+    end
+endtask
+
+task automatic report_icache_hum(input integer window);
+    if (hum_diff != hum_trans + hum_miss + hum_victim + hum_hit ||
+        hum_hit != hum_exposed + hum_overlap)
+        $fatal(1, "Incomplete hit-under-miss ledger");
+    $display("HUM_WINDOW window=%0d fill=%0d different=%0d translation=%0d miss=%0d victim=%0d resident=%0d same_set=%0d exposed=%0d overlap=%0d push=%0d pending=%0d pending_exposed=%0d",
+             window, hum_fill, hum_diff, hum_trans, hum_miss, hum_victim,
+             hum_hit, hum_same_set, hum_exposed, hum_overlap, hum_push, hum_pending,
+             hum_pending_exposed);
+    hum_monitor = 0;
+endtask
+
+`undef HUM_A
+`undef HUM_FETCH
+`undef HUM_CORE
+`undef HUM_SECTION
+`undef HUM_TLB
+`undef HUM_TAG
+`undef HUM_FSM
+`undef HUM_IC
+`undef HUM_ZAP
+`undef HUM_CPU
--- /dev/null
+++ b/tests/cpu/arm9v2_board/icache_restart_observe.vh
@@ -0,0 +1,152 @@
+// Count only I-cache fills. The bridge and I-cache return words in order.
+`ifdef NGAGE_IC_RESTART_CONTRACT
+`define ICR_CPU cpu
+`else
+`define ICR_CPU dut.board.upp.cpu_inside.cpu
+`endif
+`define ICR_ZAP `ICR_CPU.u_arm925t.u_zap
+`define ICR_IC `ICR_ZAP.l_generate_with_cache_mmu.u_code_cache
+`define ICR_FSM `ICR_IC.u_zap_cache_fsm
+`define ICR_CORE `ICR_ZAP.g_arm9.u_arm9_core
+`define ICR_FETCH `ICR_CORE.u_front_decode.u_fetch
+`define ICR_A `ICR_CORE.u_execute
+
+reg icr_active = 0, icr_tracing = 0, icr_live = 0;
+reg [31:0] icr_pc, icr_phys;
+reg [1:0] icr_epoch;
+reg icr_killed;
+integer icr_start, icr_offer, icr_word, icr_ack, icr_push, icr_pop;
+integer icr_port, icr_tail;
+integer icr_exposed, icr_overlap, icr_tlb, icr_other, icr_released;
+integer icr_fills[24], icr_canceled[24], icr_early[24], icr_word_to_end[24];
+integer icr_wait_word[24], icr_exposed_tail[24], icr_overlap_tail[24], icr_tlb_tail[24];
+integer icr_other_tail[24], icr_released_tail[24], icr_board_to_cpu[24], icr_before_req[24];
+integer icr_board_to_push[24], icr_matched_pushes[24];
+
+initial icr_tracing = $test$plusargs("ic-trace");
+
+task automatic reset_icache_restart();
+    icr_active = 1;
+    icr_live = 0;
+    foreach (icr_fills[i]) begin
+        icr_fills[i] = 0; icr_canceled[i] = 0; icr_early[i] = 0;
+        icr_word_to_end[i] = 0; icr_wait_word[i] = 0; icr_exposed_tail[i] = 0;
+        icr_overlap_tail[i] = 0; icr_tlb_tail[i] = 0; icr_other_tail[i] = 0;
+        icr_released_tail[i] = 0; icr_board_to_cpu[i] = 0; icr_before_req[i] = 0;
+        icr_board_to_push[i] = 0; icr_matched_pushes[i] = 0;
+    end
+endtask
+
+task automatic observe_icache_restart(input integer clock);
+    integer bucket;
+    reg same_owner, pending_head, waiting_for_word, backend;
+    if (icr_active) begin
+        if (`ICR_FSM.state_ff == `ICR_FSM.IDLE &&
+            `ICR_FSM.state_nxt == `ICR_FSM.FETCH_SINGLE) begin
+            icr_live = 1;
+            icr_pc = `ICR_FETCH.f2[31:0];
+            icr_phys = `ICR_FSM.i_phy_addr;
+            icr_epoch = `ICR_FETCH.f2[33:32];
+            icr_killed = 0;
+            icr_start = clock;
+            icr_offer = -1; icr_word = -1; icr_ack = -1; icr_push = -1; icr_pop = -1;
+            icr_port = 0; icr_tail = 0;
+            icr_exposed = 0; icr_overlap = 0; icr_tlb = 0; icr_other = 0; icr_released = 0;
+        end
+        if (icr_live) begin
+            same_owner = `ICR_CPU.wb_code && `ICR_CPU.wb_address[31:5] == icr_phys[31:5];
+            if (same_owner && icr_offer < 0 &&
+                (`ICR_CPU.line_req || `ICR_CPU.wb_cyc))
+                icr_offer = clock;
+            if (same_owner && `ICR_CPU.refill.state == 1 && `ICR_CPU.line_valid) begin
+                icr_port = `ICR_CPU.line_wide ? 2 : 1;
+                if (icr_word < 0 &&
+                    int'(`ICR_CPU.refill.received) + (`ICR_CPU.line_wide ? 4 : 1) >
+                    int'({icr_phys[4:2],1'b1}))
+                    icr_word = clock;
+            end
+            if (icr_ack < 0 && `ICR_FSM.take &&
+                `ICR_FSM.o_wb_adr_ff[4:2] == icr_phys[4:2]) begin
+                icr_ack = clock;
+                if (icr_word < 0) icr_word = clock;
+            end
+            if (`ICR_FETCH.epoch != icr_epoch || `ICR_FETCH.i_redirect)
+                icr_killed = 1;
+            if (icr_push < 0 && !icr_killed && `ICR_FETCH.push &&
+                `ICR_FETCH.f2[31:0] == icr_pc)
+                icr_push = clock;
+            if (icr_pop < 0 && !icr_killed && icr_push >= 0 && `ICR_FETCH.pop &&
+                `ICR_FETCH.o_pc == icr_pc)
+                icr_pop = clock;
+            if (icr_ack >= 0 && `ICR_FSM.state_ff == `ICR_FSM.FETCH_SINGLE) begin
+                // Disjoint ownership for the remaining fill clocks, including
+                // overlap with active issue or a blocked older instruction.
+                icr_tail += 1;
+                pending_head = `ICR_FETCH.count != 0 && `ICR_FETCH.head_packet[47] &&
+                               `ICR_FETCH.head_packet[81:55] == icr_pc[31:5];
+                waiting_for_word = `ICR_FETCH.f2[35] &&
+                                   `ICR_FETCH.f2[31:0] == icr_pc && icr_push < 0 && !icr_killed;
+                backend = `ICR_CORE.request || `ICR_CORE.memory_state != 0 ||
+                          (`ICR_CORE.a_a_valid && !`ICR_A.finish) ||
+                          (`ICR_CORE.d_valid && !`ICR_A.o_ready_payload) || `ICR_CORE.d_hazard;
+                if (`ICR_A.accept || backend) icr_overlap += 1;
+                else if (`ICR_IC.tlb_busy) icr_tlb += 1;
+                else if (pending_head || waiting_for_word) icr_exposed += 1;
+                else if (icr_push >= 0 && !`ICR_IC.o_fill_pending) icr_released += 1;
+                else icr_other += 1;
+            end
+            if (icr_tracing)
+                $display("ICR_TRACE c=%0d start=%0d pc=%h phys=%h port=%0d beat=%b word=%b ack=%b push=%b fq=%h pop=%b release=%b complete=%b redirect=%b accept=%b issue=%h thumb=%b",
+                         clock, icr_start, icr_pc, icr_phys, icr_port,
+                         same_owner && `ICR_CPU.line_valid, icr_word == clock, icr_ack == clock,
+                         icr_push == clock, `ICR_FETCH.o_pc, `ICR_FETCH.pop,
+                         !`ICR_IC.o_fill_pending, `ICR_IC.o_fill_done,
+                         `ICR_FETCH.i_redirect, `ICR_A.accept, `ICR_CORE.d_pc, `ICR_CORE.d_thumb);
+            if (`ICR_IC.o_fill_done) begin
+                bucket = icr_port * 8 + int'(icr_phys[4:2]);
+                icr_fills[bucket] += 1;
+                icr_canceled[bucket] += int'(icr_killed);
+                if (icr_tail != icr_overlap + icr_tlb + icr_exposed + icr_released + icr_other)
+                    $fatal(1, "Incomplete I-cache tail accounting");
+                if (!icr_killed && !`ICR_IC.o_fill_fault && icr_word >= 0) begin
+                    if (icr_offer >= 0) begin
+                        icr_before_req[bucket] += icr_offer - icr_start;
+                        icr_wait_word[bucket] += icr_word - icr_offer;
+                    end
+                    icr_board_to_cpu[bucket] += icr_ack - icr_word;
+                    icr_word_to_end[bucket] += clock - icr_ack;
+                    icr_early[bucket] += int'(icr_pop >= 0 && icr_pop < clock);
+                    if (icr_push >= 0) begin
+                        icr_matched_pushes[bucket] += 1;
+                        icr_board_to_push[bucket] += icr_push - icr_word;
+                    end
+                    icr_exposed_tail[bucket] += icr_exposed;
+                    icr_overlap_tail[bucket] += icr_overlap;
+                    icr_tlb_tail[bucket] += icr_tlb;
+                    icr_other_tail[bucket] += icr_other;
+                    icr_released_tail[bucket] += icr_released;
+                end
+                icr_live = 0;
+            end
+        end else if (icr_tracing && `ICR_A.accept)
+            $display("ICR_ISSUE c=%0d issue=%h thumb=%b", clock, `ICR_CORE.d_pc, `ICR_CORE.d_thumb);
+    end
+endtask
+
+task automatic report_icache_restart(input integer window);
+    foreach (icr_fills[i]) if (icr_fills[i] != 0)
+        $display("ICR_BUCKET window=%0d port=%0d offset=%0d fills=%0d canceled=%0d offer=%0d wait_word=%0d bridge=%0d tail=%0d pushes=%0d board_to_push=%0d precomplete_pop=%0d exposed=%0d overlap=%0d tlb=%0d released=%0d other=%0d",
+                 window, i / 8, i % 8, icr_fills[i], icr_canceled[i], icr_before_req[i],
+                 icr_wait_word[i], icr_board_to_cpu[i], icr_word_to_end[i], icr_matched_pushes[i],
+                 icr_board_to_push[i], icr_early[i], icr_exposed_tail[i], icr_overlap_tail[i],
+                 icr_tlb_tail[i], icr_released_tail[i], icr_other_tail[i]);
+    icr_active = 0;
+endtask
+
+`undef ICR_A
+`undef ICR_FETCH
+`undef ICR_CORE
+`undef ICR_FSM
+`undef ICR_IC
+`undef ICR_ZAP
+`undef ICR_CPU
