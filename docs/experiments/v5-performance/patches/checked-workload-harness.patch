+`ifdef NGAGE_STORE_LIST_CONTRACT
+`define STORE_CPU cpu.u_arm925t
+`else
+`define STORE_CPU dut.board.upp.cpu_inside.cpu.u_arm925t
+`endif
+`define STORE_CORE `STORE_CPU.u_zap.g_arm9.u_arm9_core
+`define STORE_CACHE `STORE_CPU.u_zap.l_generate_with_cache_mmu.u_data_cache
+
+integer store_scalar, store_scalar_word, store_scalar_hit, store_list_words, store_lists;
+integer store_two_lists, store_long_lists, store_wb_lists, store_thumb_lists, store_stack_lists;
+integer store_list_hit, store_adjacent, store_pair_hit, store_pair_contiguous;
+integer store_pair_two, store_pair_two_no_wb, store_pair_long, store_pair_wb, store_pair_thumb, store_pair_stack;
+integer store_pair_plain, store_pair_stmia2, store_cross_line, store_pair_seen;
+integer store_previous_cycle, store_index, store_max_list;
+reg [31:0] store_previous_address;
+reg store_pending_hit;
+wire [31:0] store_instruction = `STORE_CORE.w[494:463];
+wire [31:0] store_address = `STORE_CORE.w[398:367];
+wire store_accepted = `STORE_CORE.wb_valid && !`STORE_CORE.wb_restore &&
+    `STORE_CORE.w[535] && `STORE_CORE.w[534] && `STORE_CORE.request_done && !`STORE_CORE.retry && !`STORE_CORE.resp_err;
+wire store_writable_hit = `STORE_CACHE.live_lookup && `STORE_CACHE.live_trust &&
+    `STORE_CACHE.o_short_hit && !`STORE_CACHE.tlb_wt && `STORE_CACHE.cf_cache_tag_wr_en &&
+    `STORE_CACHE.ram_write && !`STORE_CORE.i_dc_lock_any && !`STORE_CORE.w[529];
+wire store_stack = store_instruction[19:16] == 4'd13 && store_instruction[24:21] == 4'b1001;
+wire store_thumb = `STORE_CORE.w[539];
+wire store_ordinary = !store_instruction[22] && !store_instruction[15] &&
+    store_instruction[19:16] != 15 && !store_instruction[{1'b0, store_instruction[19:16]}] &&
+    (`STORE_CORE.w[435:431] == 5'h10 || `STORE_CORE.w[435:431] == 5'h1f ||
+     (`STORE_CORE.w[435:431] != 5'h11 && !(|store_instruction[14:13])) || !(|store_instruction[14:8]));
+
+function automatic integer store_list_length(input [15:0] list);
+    begin
+        store_list_length = 0;
+        for (integer bit_index = 0; bit_index < 16; bit_index += 1)
+            store_list_length += int'(list[bit_index]);
+    end
+endfunction
+
+task reset_store_list;
+    begin
+        store_scalar = 0; store_scalar_word = 0; store_scalar_hit = 0;
+        store_list_words = 0; store_lists = 0; store_two_lists = 0; store_long_lists = 0;
+        store_wb_lists = 0; store_thumb_lists = 0; store_stack_lists = 0;
+        store_list_hit = 0; store_adjacent = 0; store_pair_hit = 0; store_pair_contiguous = 0;
+        store_pair_two = 0; store_pair_two_no_wb = 0; store_pair_long = 0;
+        store_pair_wb = 0; store_pair_thumb = 0; store_pair_stack = 0;
+        store_pair_plain = 0; store_pair_stmia2 = 0; store_cross_line = 0; store_pair_seen = 0;
+        store_previous_cycle = -1; store_index = 0; store_max_list = 0; store_previous_address = 0;
+        store_pending_hit = 0;
+    end
+endtask
+
+task observe_store_list(input integer tick);
+    integer count;
+    begin
+        if (store_accepted) begin
+            if (`STORE_CORE.w[8:5] == 4'd5) begin
+                store_scalar += 1;
+                if (`STORE_CORE.w[19:16] == 4'b1111) store_scalar_word += 1;
+                if (store_writable_hit) store_scalar_hit += 1;
+            end
+            if (`STORE_CORE.w[8:5] == 4'd6) begin
+                count = store_list_length(store_instruction[15:0]);
+                store_list_words += 1;
+                if (`STORE_CORE.w[537]) begin
+                    store_lists += 1;
+                    if (count == 2) store_two_lists += 1;
+                    if (count > 2) store_long_lists += 1;
+                    if (count > store_max_list) store_max_list = count;
+                    if (store_instruction[21]) store_wb_lists += 1;
+                    if (store_thumb) store_thumb_lists += 1;
+                    if (store_stack) store_stack_lists += 1;
+                    store_pending_hit = 0;
+                    store_index = 0;
+                end
+                if (store_writable_hit) store_list_hit += 1;
+                if (store_index > 0 && store_previous_cycle + 1 == tick) store_adjacent += 1;
+                // Fixed disjoint pairs by transfer number. A pair cannot
+                // skip a word or use cacheability inferred from an address.
+                if ((store_index & 1) != 0) begin
+                    store_pair_seen += 1;
+                    if (store_previous_address[31:5] != store_address[31:5]) store_cross_line += 1;
+                    if (store_pending_hit && store_writable_hit && store_previous_address[31:5] == store_address[31:5] &&
+                        store_previous_address + 32'd4 == store_address && store_address[1:0] == 0) begin
+                        store_pair_hit += 1;
+                        if (store_previous_cycle + 1 == tick) store_pair_contiguous += 1;
+                        if (count == 2) store_pair_two += 1;
+                        if (count == 2 && !store_instruction[21]) store_pair_two_no_wb += 1;
+                        if (count > 2) store_pair_long += 1;
+                        if (store_instruction[21]) store_pair_wb += 1;
+                        if (store_thumb) store_pair_thumb += 1;
+                        if (store_stack) store_pair_stack += 1;
+                        if (store_ordinary) begin
+                            store_pair_plain += 1;
+                            if (count == 2 && !store_thumb && store_instruction[24:20] == 5'b01000)
+                                store_pair_stmia2 += 1;
+                        end
+                    end
+                end
+                store_pending_hit = store_writable_hit;
+                store_previous_cycle = tick;
+                store_previous_address = store_address;
+                store_index += 1;
+            end
+        end
+    end
