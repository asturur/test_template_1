+                waw_seen += 1;
+                if (!waw_seat) waw_busy += 1;
+                else if (blocked_source || |sources) waw_raw += 1;
+                else if (blocked_destination || `WAW_DECODE.fenced || |(waw_actual_hazards & ~repeating))
