+"""Isolate execute scheduling experiments from the v5 production netlist."""
+
+from frame_gap_early import swap
+
+
+def direct_accumulate(source):
+    # The registered DSP product holds until the next multiply. Accumulate
+    # directly from it and remove the redundant product-copy clock.
+    start = source.index('module ngage2_arm9v2_execute (')
+    end = source.index('\nendmodule', start)
+    execute = source[start:end]
+    obsolete = ('reg multiply_accumulate;', 'reg [63:0] product_saved;', 'wire mac_phase;',
+                'assign mac_phase =', 'multiply_accumulate <= 0;', 'product_saved <= 0;')
+    execute = ''.join(line for line in execute.splitlines(keepends=True)
+                      if not any(removed in line for removed in obsolete))
+    execute = swap(execute, '\t\t\tif (mac_phase) begin\n\t\t\t\tproduct_saved <= product;\n'
+                   '\t\t\t\tmultiply_accumulate <= 1;\n\t\t\tend\n', '')
+    assert execute.count('product_saved') == 3 and execute.count('mac_phase') == 3
+    execute = execute.replace('product_saved', 'product').replace(' && !mac_phase', '').replace(' || mac_phase', '')
+    return source[:start] + execute + source[end:]
