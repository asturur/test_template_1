+`define WAW_TLB `WAW_CACHE.u_zap_tlb.u_zap_tlb_check
+
+integer waw_seen, waw_sole, waw_busy, waw_raw, waw_other;
+integer waw_s, waw_a, waw_m, waw_w, waw_skid, waw_multiple, waw_m_precheck;
+wire [372:0] waw_d2 = `WAW_DECODE.d2;
+wire [5:0] waw_dst = waw_d2[80+:6];
+wire waw_scalar = waw_d2[131:128] == 4'd5 && waw_d2[329] &&
+                  waw_d2[78] && !waw_d2[149] && waw_dst != 15;
+wire [5:0] waw_older_scalar = {
+    `WAW_CORE.skid[8:5] == 4'd5, `WAW_CORE.w[8:5] == 4'd5,
+    `WAW_CORE.m[8:5] == 4'd5, 1'b0, `WAW_CORE.a_kind == 4'd5,
+    `WAW_CORE.d_kind == 4'd5
+};
+wire [5:0] waw_actual_hazards = `WAW_DECODE.producer_hazard;
+wire waw_seat = (!`WAW_DECODE.out_valid || `WAW_DECODE.i_ready) &&
+                !`WAW_DECODE.i_flush && (!`WAW_DECODE.redirect_ff[74] || `WAW_DECODE.redirect_in_d2);
+wire waw_m_cacheable = `WAW_CORE.o_data_wb_re_check && `WAW_CACHE.raw_cache_hit &&
+                       `WAW_TLB.cacheable_nxt && !`WAW_TLB.walk_nxt &&
+                       `WAW_TLB.fsr_nxt[3:0] == 0 && !`WAW_CORE.m[529] && !`WAW_CACHE.hold;
+
+task reset_load_waw;
