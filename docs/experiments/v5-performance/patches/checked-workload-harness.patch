+_start:
+    b boot
+    b failed
+    b failed
+    b failed
+    b failed
+    b failed
+    b failed
+    b failed
+
+boot:
+    ldr r2,=0x0a020000
+    mcr p15,0,r2,c2,c0,0
+    mov r2,#1
+    mcr p15,0,r2,c3,c0,0
+    mcr p15,0,r2,c8,c7,0
+    mrc p15,0,r2,c1,c0,0
+    orr r2,r2,#0x1000
+    orr r2,r2,#0x000d
+    mcr p15,0,r2,c1,c0,0
+    nop
+    nop
+    nop
+    ldr sp,=0x20020000
+    mov r8,#4
