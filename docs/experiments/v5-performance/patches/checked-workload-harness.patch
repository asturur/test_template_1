+def cache_overlay(cache):
+    cache = swap(cache, '\to_short_data,', '\to_short_data,\n    o_short_next_word,\n    o_short_next_valid,')
+    cache = swap(cache, '\toutput wire [31:0] o_short_data;', '''\toutput wire [31:0] o_short_data;
