+"""Replay the warm native torus with matched v5 memory RTL at 78 MHz."""
+
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import json
+from pathlib import Path
+import re
+import struct
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / 'tests/cpu/arm9v2_board'))
+sys.path.insert(0, str(ROOT / 'tools'))
+from payload_clocks import IMAGE, DOCKER, FIRMWARE, compile_phone, container_path, digest, find
+from frame_gap_donor_sdram import generate as wire_production_sdram
+from frame_gap_early import swap
+from capture import ROM_SHA, MODULE_SHA
+from paired_ldm import pair_resident_loads
+from issue_ldm import issue_paired_loads
+from predicate_block import predicate_block
+from load_waw import load_waw_overlay
+from gen_arm9v2_phone import direct_accumulate, schedule_early_smull, schedule_ready_register_shift
+
+FIXTURE = Path(__file__).resolve().parent
+PRODUCTION_NETLIST = ROOT / 'rtl/arm9v2/arm925t_phone.v'
+PIN_MODEL_SHA = '61af63207be722deaf2b97a892ee76cbb26e8cb21013db6b60a5566f6985952b'
+ISSUE_LDM_LEGS = ('issue-ldm', 'issue-ldm-one-gap', 'issue-ldm-address-hint')
+
+
+def prepare(out, capture, netlist, legs, trace_load_sites=False, load_waw_counts=False,
+            store_list_counts=False, control_flow_counts=False, icache_restart_counts=False, icache_hum_counts=False):
+    oracle = json.loads((capture / 'oracle.json').read_text())
+    assert oracle['rom_sha'] == ROM_SHA and oracle['module_sha'] == MODULE_SHA
+    frames = oracle['frames'][1:]
+    assert len(frames) == 4 and all(frame['draw'][:3] == [4, 14400, 0x1403] for frame in frames)
+    for frame in frames:
+        assert frame['jit'] == frames[0]['jit']
+        # No allocations or code generation in the steady windows. Only the
+        # native TLS service requires an equivalent guest stub in this replay.
+        assert frame['calls'] == {'0x503b363c': 15, '0x10101c9c': 1}
+    assert oracle['tls'] == {str(0x10100000): 0x20040000}
+
+    (out / 'arm925t-i16.v').write_text(netlist)
+    i32 = swap(netlist, 'ICACHE_SIZE = 16384;', 'ICACHE_SIZE = 32768;')
+    i32 = swap(i32, ".CP15_CTYPE(32'h0514a14a)", ".CP15_CTYPE(32'h0514a18a)")
+    (out / 'arm925t-i32.v').write_text(i32)
+    if 'direct-mac' in legs:
+        (out / 'arm925t-direct-mac.v').write_text(direct_accumulate(netlist))
+    if 'early-smull' in legs:
+        (out / 'arm925t-early-smull.v').write_text(schedule_early_smull(netlist))
+    if 'predicate-block' in legs:
+        (out / 'arm925t-predicate-block.v').write_text(predicate_block(netlist))
+    if 'load-waw' in legs:
+        (out / 'arm925t-load-waw.v').write_text(load_waw_overlay(netlist))
+    if 'ready-reg-shift' in legs:
+        (out / 'arm925t-ready-reg-shift.v').write_text(schedule_ready_register_shift(netlist))
+    if 'paired-ldm' in legs:
+        (out / 'arm925t-paired-ldm.v').write_text(pair_resident_loads(netlist))
+    for leg in ISSUE_LDM_LEGS:
+        if leg in legs:
+            candidate = issue_paired_loads(netlist, one_cycle_split=leg != 'issue-ldm',
+                                           address_hint=leg == 'issue-ldm-address-hint')
+            (out / f'arm925t-{leg}.v').write_text(candidate)
+
+    subprocess.run(['arm-none-eabi-gcc', '-c', '-mcpu=arm920t', '-marm', FIXTURE / 'replay.S',
+                    '-o', out / 'guest.o'], check=True)
+    subprocess.run(['arm-none-eabi-ld', '-T', ROOT / 'sim/programs/link.ld', out / 'guest.o',
+                    '-o', out / 'guest.elf'], check=True)
+    subprocess.run(['arm-none-eabi-objcopy', '-O', 'binary', out / 'guest.elf', out / 'guest.bin'], check=True)
+    symbols = {name: int(value, 16) for value, _, name in
+               (line.split() for line in subprocess.check_output(['arm-none-eabi-nm', out / 'guest.elf'],
+                                                                 text=True).splitlines())}
+    boot = (out / 'guest.bin').read_bytes()
+    core = bytearray((FIRMWARE / 'core.bin').read_bytes())
+    assert digest(core) == ROM_SHA and len(boot) < 0xa000
+    core[:len(boot)] = boot
+    (out / 'core.bin').write_bytes(core)
+    with (out / 'cdrive.bin').open('wb') as handle:
+        handle.truncate(4194304)
+    heap = (capture / 'heap.bin').read_bytes()
+    ram = bytearray(0x400000 + len(heap))
+    # ROM code remains XIP. E: application and GLES pages, guest heap,
+    # generated rasterizer and page tables use the production SDRAM decoder.
+    for virtual, physical in [(0, 0), (0x100, 0x0a100000), (0x101, 0x0a200000),
+                              (0x200, 0x0a400000), (0x503, 0x00300000)]:
+        struct.pack_into('<I', ram, 0x20000 + 4 * virtual, physical | 0xc0e)
+    patch_old = struct.pack('<I', 0x503b363c)
+    patch_new = struct.pack('<I', symbols['expected_tls'])
+    for name, addr in [('app', 0x100000), ('gles', 0x200000)]:
+        original = (capture / f'{name}.bin').read_bytes()
+        if name == 'gles':
+            assert original[0x19970:0x19974] == patch_old and original.count(patch_old) == 1
+            original = original.replace(patch_old, patch_new)
+        ram[addr:addr + len(original)] = original
+    ram[0x400000:] = heap
+    (out / 'snapshot.bin').write_bytes(ram)
+    for ideal_leg, geometry in (('ideal', 'i32'), ('ideal-i16', 'i16')):
+        if ideal_leg in legs:
+            prepare_ideal(out, core, ram, frames[0]['jit'], ideal_leg, geometry)
+    bench = (ROOT / 'tests/phone/hardware_boot/tb.v').read_text()
+    bench = wire_production_sdram(out, bench, production=True)
+    bench = swap(bench, 'if(cycles==BOUNDED_CYCLES)begin',
+                 'if(cycles==BOUNDED_CYCLES) $fatal(1,"PolyCount timeout PC=%h",fetch_pc);\n if(1\'b0) begin')
+    observe = (FIXTURE / 'replay.vh').read_text()
+    if icache_hum_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/icache_hum_observe.vh'
+        observe = '`define NGAGE_IC_HUM\n' + helper.read_text() + observe
+    if icache_restart_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/icache_restart_observe.vh'
+        observe = '`define NGAGE_IC_RESTART\n' + helper.read_text() + observe
+    if control_flow_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/control_flow_observe.vh'
+        observe = '`define NGAGE_CONTROL_FLOW\n' + helper.read_text() + observe
+    if store_list_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/store_list_observe.vh'
+        observe = '`define NGAGE_COUNT_STORE_LIST\n' + helper.read_text() + observe
+    if load_waw_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/waw_load_observe.vh'
+        observe = '`define NGAGE_COUNT_LOAD_WAW\n' + helper.read_text() + observe
+    if trace_load_sites:
+        observe = '`define POLYCOUNT_LOAD_TRACE\n' + swap(observe, '\n`undef PCOFF',
+                    '\n' + (FIXTURE / 'load_use.vh').read_text() + '\n`undef PCOFF')
+    if 'predicate-block' in legs:
+        helper = ROOT / 'tests/cpu/arm9v2_board/predicate_block_observe.vh'
+        observe = '`define NGAGE_COUNT_PREDICATE_BLOCKS\n' + helper.read_text() + observe
+    color, depth = frames[-1]['buffers']
+    for name, value in [('COLOR_REGION', int(color[0], 16)), ('DEPTH_REGION', int(depth[0], 16)),
+                        ('INDEX_REGION', frames[-1]['draw'][3])]:
+        observe = observe.replace(name, f"25'h{value - 0x20000000 + 0x400000:x}")
+    observe = observe.replace('COLOR_BYTES', str(color[1])).replace('DEPTH_BYTES', str(depth[1]))
+    (out / 'tb.v').write_text(bench.rsplit('endmodule', 1)[0] + '\n' + observe + '\nendmodule\n')
+    return symbols
+
+
+def prepare_ideal(out, core, ram, jit, leg, geometry):
+    # Serve a hit for known immutable instruction addresses, using the real
+    # cache's checked address and data latch. Leave its I-TLB and bus intact.
+    raster_begin = min(start for start, _ in jit) & ~0xfff
+    raster_end = (max(end for _, end in jit) + 0xfff) & ~0xfff
+    heap_offset = 0x400000 - 0x20000000
+    locations = [
+        ('boot', 0, core[:0x1000]),
+        ('app', 0x10000000, ram[0x100000:0x114000]),
+        ('gles', 0x10100000, ram[0x200000:0x21a000]),
+        ('raster', raster_begin, ram[heap_offset + raster_begin:heap_offset + raster_end]),
+        ('rom', 0x50300000, core[0x300000:0x400000]),
+    ]
+    hdl = ['\treg ideal_hit;', '\treg [31:0] ideal_word;']
+    predicates = []
+    for name, base, data in locations:
+        limit = base + len(data)
+        path = out / f'ideal-{name}.hex'
+        path.write_text(''.join(f'{word:08x}\n' for word, in struct.iter_unpack('<I', data)))
+        hdl += [f'\treg [31:0] ideal_{name}[0:{len(data)//4-1}];',
+                f'\tinitial $readmemh("{container_path(path)}", ideal_{name});']
+        lower = f"i_address_check >= 32'h{base:08x} && " if base else ''
+        predicates.append(f"if ({lower}i_address_check < 32'h{limit:08x}) begin\n"
+                          f"\t\t\tideal_word = ideal_{name}[(i_address_check - 32'h{base:08x}) >> 2];\n"
+                          '\t\t\tideal_hit = 1;\n\t\tend')
+    hdl += ['\talways @(*) begin', '\t\tideal_hit = 0;', '\t\tideal_word = 0;',
+            '\t\t' + '\n\t\telse '.join(predicates), '\tend',
+            "\twire [WAYS*32-1:0] device_words;",
+            '\twire device_hit, device_word_sel;',
+            "\tassign raw_cache_words = ideal_hit ? {{(WAYS-1)*32{1'b0}}, ideal_word} : device_words;",
+            '\tassign raw_cache_hit = ideal_hit || device_hit;',
+            "\tassign raw_cache_word_sel = ideal_hit ? 1'b0 : device_word_sel;", '']
+    source = (out / f'arm925t-{geometry}.v').read_text()
+    start = source.index('module ngage2_zap_cache (')
+    end = source.index('\nendmodule', start)
+    part = source[start:end]
+    for old, new in [('o_cache_words(raw_cache_words)', 'o_cache_words(device_words)'),
+                     ('o_cache_hit(raw_cache_hit)', 'o_cache_hit(device_hit)'),
+                     ('o_cache_word_sel(raw_cache_word_sel)', 'o_cache_word_sel(device_word_sel)')]:
+        part = swap(part, old, new)
+    part = swap(part, '\tassign o_data_early =', '\n'.join(hdl) + '\tassign o_data_early =')
+    (out / f'arm925t-{leg}.v').write_text(source[:start] + part + source[end:])
+
+
+def run_leg(run, capture, pin_model, symbols, leg, cpu_wrapper=None, board_overlay=None):
+    out = run / leg
+    out.mkdir()
+    bench = (run / 'tb.v').read_text()
+    if leg in ('paired-ldm', *ISSUE_LDM_LEGS):
+        bench = '`define POLYCOUNT_PAIRED_LDM\n' + bench
+    if leg in ISSUE_LDM_LEGS:
+        bench = '`define POLYCOUNT_ISSUE_LDM\n' + bench
+    (out / 'tb.v').write_text(bench)
+    netlist = run / f'arm925t-{leg}.v'
+    exe = compile_phone(out, divider=2, hz=64, arm9v2_netlist=netlist, flash_cache_bytes=32768,
+                        sdram_model=pin_model, cpu_wrapper=cpu_wrapper, posted_writes=False, interleave=False,
+                        pin_waits=False, handoff=None, donor_sdram=True, stream_sdram=True, block_writeback=True, board_overlay=board_overlay)
+    files = {'snapshot': run / 'snapshot.bin', 'results': out / 'result', 'core': run / 'core.bin',
+             'extension': FIRMWARE / 'extension.bin', 'cdrive': run / 'cdrive.bin'}
+    args = [f'+{name}={container_path(path)}' for name, path in files.items()]
+    for name, symbol in [('begin', 'frame_begin'), ('end', 'frame_end'),
+                         ('done', 'finished'), ('fail', 'failed')]:
+        args.append(f'+{name}_pc={symbols[symbol]:x}')
+    log = out / 'run.log'
+    with log.open('w') as handle:
+        subprocess.run(DOCKER + [container_path(exe), IMAGE, '+ngage-compact-trace', '+no-board-log', *args],
+                       cwd=ROOT, stdout=handle, stderr=subprocess.STDOUT, check=True)
+    names = ('object', 'indices', 'surface0', 'surface1')
+    expected = b''.join((capture / f'{name}.bin').read_bytes() for name in names)
+    actual = (out / 'result.bin').read_bytes()
+    assert actual == expected, (leg, digest(actual), digest(expected))
+    completion, = find(log, 'PASS_POLYCOUNT ')
+    frames = find(log, 'POLY_FRAME ')
+    assert completion['frames'] == len(frames) == 4
+    assert completion['d2_lines'] == 1024
+    if leg == 'ideal':
+        assert all(frame['ifills'] == 0 and frame['exposed_i'] == 0 for frame in frames)
+    if leg in ('paired-ldm', *ISSUE_LDM_LEGS):
+        pairs = find(log, 'POLY_PAIR ')
+        assert len(pairs) == 4 and all(frame['paired'] > 0 for frame in pairs)
+        for frame, pair in zip(frames, pairs, strict=True):
+            assert frame['frame'] == pair['frame']
+            frame.update(paired=pair['paired'], pair_shapes=pair['shape'])
+    if leg in ISSUE_LDM_LEGS:
+        for frame, split in zip(frames, find(log, 'POLY_SPLIT '), strict=True):
+            assert frame['frame'] == split['frame']
+            frame['pair_splits'] = split['splits']
+            frame['pair_address_splits'] = split['address']
+            frame['pair_dependency_wait'] = split['dependency_wait']
+    print(f'{leg} passed with output SHA-256 {digest(actual)}', flush=True)
+    result = dict(frames=frames, completion=completion, output_sha=digest(actual),
+                  netlist_sha=digest(netlist.read_bytes()))
+    predicates = find(log, 'PREDICATE_BLOCK ')
+    if predicates:
+        assert [row['window'] for row in predicates] == list(range(4))
+        result['predicate_blocks'] = predicates
+    waw = find(log, 'LOAD_WAW ')
+    if waw:
+        assert [row['window'] for row in waw] == list(range(4))
+        result['load_waw'] = waw
+    stores = find(log, 'STORE_LIST ')
+    if stores:
+        assert [row['window'] for row in stores] == list(range(4))
+        result['store_list'] = stores
+    hum = find(log, 'HUM_WINDOW ')
+    if hum:
+        assert [row['window'] for row in hum] == list(range(4))
+        result['icache_hum'] = hum
+    fills = find(log, 'ICR_BUCKET ')
+    if fills:
+        result['icache_restart'] = fills
+    flow = find(log, 'FLOW_WINDOW ')
+    if flow:
+        assert [row['window'] for row in flow] == list(range(4))
+        result['control_flow'] = dict(windows=flow, buckets=find(log, 'FLOW_BUCKET '))
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--name', required=True)
+    parser.add_argument('--capture', type=Path, required=True)
+    parser.add_argument('--pin-model', type=Path, required=True)
+    parser.add_argument('--netlist', type=Path, default=PRODUCTION_NETLIST,
+                        help='Base 16 KiB I-cache netlist (defaults to current production RTL)')
+    parser.add_argument('--trace-load-sites', action='store_true', help='trace known GLES scalar load-use sites')
+    parser.add_argument('--load-waw-counts', action='store_true', help='count repeated scalar-load destination interlocks')
+    parser.add_argument('--board-overlay', type=Path, help='alternate line-guarantee integration files')
+    parser.add_argument('--icache-hum-counts', action='store_true')
+    parser.add_argument('--icache-restart-counts', action='store_true')
+    parser.add_argument('--cpu-wrapper', type=Path)
+    parser.add_argument('--control-flow-counts', action='store_true', help='measure branch-to-successor issue clocks')
+    parser.add_argument('--store-list-counts', action='store_true', help='count passed store words and resident pairs')
+    parser.add_argument('--legs', nargs='+',
+                        choices=['i16', 'i32', 'ideal', 'ideal-i16', 'direct-mac', 'early-smull', 'ready-reg-shift',
+                                 'paired-ldm', 'predicate-block', 'load-waw', *ISSUE_LDM_LEGS],
+                        default=['i16', 'i32', 'ideal'])
+    args = parser.parse_args()
+    if not re.fullmatch(r'[a-zA-Z0-9_-]+', args.name) or len(set(args.legs)) != len(args.legs):
+        parser.error('Use an alphanumeric run name and distinct legs')
+    run = ROOT / 'build/sim/polycount' / args.name
+    run.mkdir(parents=True)
+    capture = args.capture.resolve()
+    model = run / 'mt48lc16m16a2.v'
+    pin_model = args.pin_model.read_bytes()
+    assert digest(pin_model) == PIN_MODEL_SHA
+    model.write_bytes(pin_model)
+    netlist = args.netlist.read_bytes()
+    wrapper = None
+    if args.cpu_wrapper:
+        wrapper = run / 'ngage_cpu.sv'
+        wrapper.write_bytes(args.cpu_wrapper.read_bytes())
+    symbols = prepare(run, capture, netlist.decode(), args.legs, args.trace_load_sites,
+                      args.load_waw_counts, args.store_list_counts, args.control_flow_counts, args.icache_restart_counts, args.icache_hum_counts)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        jobs = {leg: pool.submit(run_leg, run, capture, model, symbols, leg, wrapper, args.board_overlay.resolve() if args.board_overlay else None) for leg in args.legs}
+        results = {leg: job.result() for leg, job in jobs.items()}
+    assert len({tuple(frame['retired'] for frame in result['frames']) for result in results.values()}) == 1
+    (run / 'result.json').write_text(json.dumps(dict(status='PASS', results=results, pin_model_sha=PIN_MODEL_SHA,
+                                                     base_netlist_sha=digest(netlist),
+                                                     snapshot_sha=digest((run / 'snapshot.bin').read_bytes())),
+                                             indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
