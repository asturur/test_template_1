+    end
+endtask
+
+task observe_load_waw;
+    reg [5:0] repeating, sources;
+    reg blocked_source, blocked_destination, same_read;
+    reg [5:0] tag;
+    begin
+        if (`WAW_DECODE.d2_valid && waw_scalar && |waw_actual_hazards) begin
+            repeating = 0;
+            sources = 0;
+            blocked_source = |`WAW_DECODE.early_hazard;
+            blocked_destination = (waw_d2[78] && `WAW_DECODE.i_locked[waw_dst]) ||
+                                  (waw_d2[79] && `WAW_DECODE.i_locked[waw_d2[86+:6]]);
+            for (integer src = 0; src < 4; src += 1)
+                if (waw_d2[96+src] && `WAW_DECODE.i_locked[waw_d2[100+6*src+:6]]) blocked_source = 1;
+            for (integer stage = 0; stage < 6; stage += 1) begin
+                same_read = 0;
+                tag = `WAW_DECODE.i_load_tag[6*stage+:6];
+                for (integer src = 0; src < 4; src += 1)
+                    if (waw_d2[96+src] && waw_d2[100+6*src+:6] == tag) same_read = 1;
+                sources[stage] = same_read && waw_actual_hazards[stage];
+                repeating[stage] = !same_read && tag == waw_dst && waw_older_scalar[stage] &&
