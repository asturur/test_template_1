@@ -0,0 +1,156 @@
+"""Record A-stage product correctness and cycle cost on the joint RAM baseline."""
+from hashlib import sha256
+import json
+from math import exp, log
+from pathlib import Path
+import re
+import shlex
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+out = root / 'build/sim/v5-104-a-only-product-ram-combined'
+ram_runs = root / 'build/sim/v5-104-tlb-victims-mmc-fifo'
+product_runs = root / 'build/sim/v5-104-arm9-a-only-product'
+base_receipt = root / 'docs/evidence/v5-104-arm9-a-only-product.json'
+ram_receipt = root / 'docs/evidence/v5-104-tlb-victims-mmc-fifo.json'
+prep_path = area / 'dispatch-20261126/prepare.json'
+cpu = 'rtl/arm9v2/arm925t_phone.v'
+host = 'rtl/ngage_mmc_host.v'
+generator = 'tools/gen_arm9v2_phone.py'
+execute = 'ngage2_arm9v2_execute'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def fingerprint(path, suffix):
+    rows = [shlex.split(line) for line in path.read_text().splitlines()
+            if line.startswith('S ') and line.endswith(f'{suffix}"')]
+    (row,) = rows
+    return row[-2]
+
+
+def module(text, name):
+    return re.search(rb'^module ' + name.encode() + rb' \(.*?^endmodule\n', text, re.M | re.S)[0]
+
+
+def passes(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+prep, product, ram = (load(path) for path in (prep_path, base_receipt, ram_receipt))
+assert prep['status'] == product['status'] == ram['status'] == 'PASS'
+assert prep['product_qualification_sha256'] == digest(base_receipt)
+assert prep['ram_qualification_sha256'] == digest(ram_receipt)
+lineage = prep['variants']['a-only-plus-ram']
+assert lineage['parent'] == prep['active_ram']
+assert lineage['paths_since_parent'] == [cpu, generator]
+assert all(digest(area / 'source' / name) == value for name, value in lineage['source_sha256'].items())
+assert all(digest(area / 'reference' / name) == value for name, value in ram['source_sha256'].items())
+assert lineage['source_sha256'][host] == ram['source_sha256'][host]
+assert module((area / 'source' / cpu).read_bytes(), execute) == module(
+    (area.parent / 'arm9-a-only-product/source' / cpu).read_bytes(), execute)
+assert (area / 'source' / generator).read_bytes() == (area / 'reference' / generator).read_bytes().replace(
+    b'    generated = schedule_early_smull(generated)\n', b'')
+
+mixed = out / 'mixed'
+fingerprints = {name: fingerprint(mixed / 'obj/Vtb__verFiles.dat', name) for name in (cpu, host)}
+assert fingerprints[host] == ram['compiled_fingerprints'][host]
+assert fingerprint(out / 'board/source/obj/Vcontract__verFiles.dat', cpu) == fingerprints[cpu]
+assert fingerprints[cpu] != fingerprint(out / 'board/reference/obj/Vcontract__verFiles.dat', cpu)
+a, b = (load(deck / 'source-hashes.json') for deck in (mixed, ram_runs / 'mixed'))
+assert len(a) == len(b) == 114 and a.keys() == b.keys()
+assert {name: a[name] for name in a if a[name] != b[name]} == {cpu: lineage['source_sha256'][cpu]}
+
+board = {}
+for start, old in product['board_results'].items():
+    rows = {}
+    for leg in ('reference', 'source'):
+        trace = out / 'board' / leg / f'{start}.log'
+        text = trace.read_text()
+        arch = re.search(r'^MULTIPLY_ARCH commits=(\d+) digest=([a-f0-9]+)$', text, re.M)
+        phase = re.search(r'^MULTIPLY_PHASE products=(\d+) early=(\d+) early_w_operand=(\d+)$', text, re.M)
+        clocks = re.search(r'^PASS cycles=(\d+) scalar_wait_cycles=(\d+)', text, re.M)
+        assert (int(arch[1]), arch[2]) == (old['compared_commits'], old['architectural_digest'])
+        expected = old['runs'][leg]
+        cycles, wait_cycles = map(int, clocks.groups())
+        products, early, early_w = map(int, phase.groups())
+        assert (products, early, early_w) == (expected['a_phase_products'], expected['early_products'], expected['early_w_operand'])
+        rows[leg] = {'cycles': cycles, 'scalar_wait_cycles': wait_cycles, 'products': products,
+                     'early_products': early, 'early_w_operand': early_w, 'log_sha256': digest(trace)}
+    board[start] = {'runs': rows, 'cycles_added': rows['source']['cycles'] - rows['reference']['cycles'],
+                    'architectural_digest': old['architectural_digest']}
+
+work = {}
+for kind, count, key, units in (('fixed', 105, 'windows', 'cycles'), ('native', 4, 'frames', 'clocks')):
+    receipt = out / f'qualification/{kind}.json'
+    result = load(receipt)
+    baseline = load(ram_runs / f'qualification/{kind}.json')
+    standalone = load(product_runs / f'qualification/{kind}.json')
+    assert result['status'] == baseline['status'] == standalone['status'] == 'PASS'
+    assert result['netlist_sha256'] == lineage['source_sha256'][cpu]
+    assert result['source_sha256'][Path(host).name] == ram['source_sha256'][host]
+    assert sum(len(row['candidate'][key]) for row in result['rows']) == count
+    manifest = out / f'qualification/obj-{kind}/Vtb__verFiles.dat'
+    assert fingerprint(manifest, f'{kind}-candidate-cpu.v') == fingerprints[cpu]
+    assert fingerprint(manifest, host) == fingerprints[host]
+    cases = {}
+    for row, reference, prior in zip(result['rows'], baseline['rows'], standalone['rows'], strict=True):
+        candidate, control = row['candidate'], row['control']
+        assert control == reference['candidate']
+        assert candidate['case'] == prior['candidate']['case']
