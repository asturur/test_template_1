+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/a-only-product-ram-combined
+out=build/sim/v5-104-a-only-product-ram-combined
+mkdir -p "$out"
+docker image inspect -f '{{.Id}} {{.Os}}/{{.Architecture}}' jotego/simulator:arm64 > "$out/image.id"
+python3 -B "$area/replay.py" fixed --output qualification > "$out/fixed.log" 2>&1 &
+fixed=$!
+python3 -B "$area/replay.py" native --output qualification > "$out/native.log" 2>&1 &
+native=$!
+sh "$area/pins.sh" > "$out/pins.log" 2>&1 &
+pins=$!
+sh "$area/board.sh" > "$out/board.log" 2>&1 &
+board=$!
+status=0
+for slot in "$fixed" "$native" "$pins" "$board"; do wait "$slot" || status=1; done
+for log in fixed native pins board; do tail -8 "$out/$log.log"; done
+exit "$status"
