index 0000000..a173e13
--- /dev/null
+++ b/scratch/v5-fit-loop/a-only-product-ram-combined/prepare-fit.py
@@ -0,0 +1,264 @@
+"""Prepare A-stage multiply fits for either joint RAM outcome."""
+from hashlib import sha256
+import json
+import os
+import re
+from pathlib import Path
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+ram_stage = area.parent / 'tlb-fifo-refill-combined/dispatch-20261126'
+active_ram = 'ae3654c75c4ff5027d0bd146baf3c8f5f2280cde'
+active_timer = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+private = area / 'dispatch-20261126'
+objects = private / 'objects'
+objects.mkdir(parents=True, exist_ok=True)
+controls = {13: 45824513460, 43: 45824520116, 31337: 45824525843}
+
+
+def git(*args, env=None):
+    return subprocess.check_output(['git', '-C', str(root), *args], env=env)
+
+
+def sha(data):
+    return sha256(data).hexdigest()
+
+
+shared_objects = git('rev-parse', '--path-format=absolute', '--git-path', 'objects').decode().strip()
+older_objects = (ram_stage / 'alternate-objects.txt').read_text().strip().split(os.pathsep)
+alternates = os.pathsep.join(dict.fromkeys([shared_objects, str(ram_stage / 'objects'), *older_objects]))
+assert all(Path(path).is_absolute() and Path(path).is_dir() for path in alternates.split(os.pathsep))
+(private / 'alternate-objects.txt').write_text(alternates + '\n')
+
+
+def context(index):
+    return os.environ | {
+        'GIT_OBJECT_DIRECTORY': str(objects),
+        'GIT_ALTERNATE_OBJECT_DIRECTORIES': alternates,
+        'GIT_INDEX_FILE': str(private / f'index-{index}'),
+    }
+
+
+def subject(revision, env):
+    return git('rev-parse', revision, env=env).decode().strip()
+
+
+def tree(revision, env):
+    return subject(f'{revision}^{{tree}}', env)
+
+
+def changes(before, after, env):
+    records = git('diff', '--name-only', '-z', before, after, env=env).split(b'\0')
+    return sorted(name.decode() for name in records if name)
+
+
+def file_hashes(revision, paths, env):
+    return {name: sha(git('show', f'{revision}:{name}', env=env)) for name in paths}
+
+
+def stage_tree(base, patches, env):
+    git('read-tree', base, env=env)
+    for patch in patches:
+        git('apply', '--cached', '--check', str(patch), env=env)
+        git('apply', '--cached', str(patch), env=env)
+    return git('write-tree', env=env).decode().strip()
+
+
+def commit(tree_id, base, message, env):
+    timestamp = int(git('show', '-s', '--format=%ct', base, env=env)) + 1
+    date = f'@{timestamp} +0000'
+    dated = env | {'GIT_AUTHOR_DATE': date, 'GIT_COMMITTER_DATE': date}
+    result = git('commit-tree', tree_id, '-p', base, '-m', message, env=dated).decode().strip()
+    assert tree(result, env) == tree_id and subject(f'{result}^', env) == base
+    return result
+
+
+def read_json(path):
+    return json.loads(path.read_text())
+
+
+patches = root / 'docs/experiments/v5-performance/patches'
+proof_root = root / 'docs/evidence'
+ram_path = proof_root / 'v5-104-tlb-victims-mmc-fifo.json'
+ram_proof = read_json(ram_path)
+ram_patch = patches / 'tlb-victims-mmc-fifo.patch'
+assert sha(ram_patch.read_bytes()) == ram_proof['design_patch_sha256']
+assert ram_proof['status'] == 'PASS' and ram_proof['base'] == active_timer
+assert (ram_stage / 'published.sha').read_text().strip() == active_ram
+ram_dispatch = read_json(ram_stage / 'dispatch.json')
+assert ram_dispatch['status'] == 'VERIFIED_DISPATCH' and ram_dispatch['candidate'] == active_ram
+ram_hashes = ram_proof['source_sha256']
+
+product_path = proof_root / 'v5-104-arm9-a-only-product.json'
+product = read_json(product_path)
+product_patch = patches / 'arm9-a-only-product.patch'
+assert sha(product_patch.read_bytes()) == product['design_patch_sha256']
+assert product['status'] == 'PASS' and product['base'] == active_timer
+sources = product['candidate_source_sha256']
+cpu = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+host = 'rtl/ngage_mmc_host.v'
+assert set(sources) == {cpu, generator} and set(ram_hashes) == {cpu, generator, host}
+
+env = context('proof')
+timer_tree = tree(active_timer, env)
+assert timer_tree == ram_proof['base_tree']
+assert stage_tree(active_timer, [ram_patch], env) == tree(active_ram, env) == ram_proof['joint_tree']
+assert changes(active_timer, active_ram, env) == sorted(ram_hashes)
+assert file_hashes(active_ram, ram_hashes, env) == ram_hashes
+assert file_hashes(active_timer, sources, env) == product['reference_source_sha256']
+
+restore = commit(timer_tree, active_ram, 'revert: restore timer-only 104 MHz tree', env)
+assert changes(active_ram, restore, env) == sorted(ram_hashes)
+(private / 'restore.sha').write_text(restore + '\n')
+message = 'perf: launch multiply products in A stage'
+variants = {}
+execute = 'ngage2_arm9v2_execute'
+
+
+def modules(text):
+    sections = re.split(rb'(?=^module )', text, flags=re.M)
+    return {chunk.split()[1].decode(): chunk for chunk in sections if chunk.startswith(b'module ')}
+
+
+base_cpu = modules(git('show', f'{active_timer}:{cpu}', env=env))
+product_tree = stage_tree(active_timer, [product_patch], env)
+qualified_cpu = modules(git('show', f'{product_tree}:{cpu}', env=env))
+assert base_cpu.keys() == qualified_cpu.keys()
+assert [module for module in base_cpu if base_cpu[module] != qualified_cpu[module]] == [execute]
+
+def compose_with_ram(parent, env):
+    git('read-tree', parent, env=env)
+    # The TLB transform expands the neighboring generator call sequence.
+    # Apply the archived CPU hunk and delete only the same SMULL call.
+    git('apply', '--cached', '--check', f'--include={cpu}', str(product_patch), env=env)
+    git('apply', '--cached', f'--include={cpu}', str(product_patch), env=env)
+    old = git('show', f'{parent}:{generator}', env=env)
+    line = b'    generated = schedule_early_smull(generated)\n'
+    assert old.count(line) == 1
+    mode = git('ls-tree', parent, '--', generator, env=env).decode().split()[0]
+    new = old.replace(line, b'')
+    blob = subprocess.check_output(['git', '-C', str(root), 'hash-object', '-w', '--stdin'],
+                                   input=new, env=env).decode().strip()
+    git('update-index', '--cacheinfo', f'{mode},{blob},{generator}', env=env)
+    return git('write-tree', env=env).decode().strip()
+
+
+for label, parent in (('a-only-on-timer', restore), ('a-only-plus-ram', active_ram)):
+    env = context(label)
+    combined = label == 'a-only-plus-ram'
+    candidate_tree = compose_with_ram(parent, env) if combined else stage_tree(parent, [product_patch], env)
+    candidate = commit(candidate_tree, parent, message, env)
+    assert changes(parent, candidate, env) == sorted(sources)
+    inherited = modules(git('show', f'{parent}:{cpu}', env=env))
+    after = modules(git('show', f'{candidate}:{cpu}', env=env))
+    assert inherited.keys() == after.keys()
+    assert [module for module in inherited if inherited[module] != after[module]] == [execute]
+    assert after[execute] == qualified_cpu[execute]
+    assert b'launch_smull' not in after[execute] and b'assign mac_result = product +' in after[execute]
+    previous_gen = git('show', f'{parent}:{generator}', env=env)
+    new_gen = git('show', f'{candidate}:{generator}', env=env)
+    early_call = b'    generated = schedule_early_smull(generated)\n'
+    assert previous_gen.count(early_call) == 1
+    assert new_gen == previous_gen.replace(early_call, b'')
+    assert b'direct_accumulate(generated)' in new_gen
+    assert file_hashes(candidate, [host], env) == file_hashes(parent, [host], env)
+    if combined:
+        assert changes(active_timer, candidate, env) == sorted(ram_hashes)
+        patch = area / 'a-only-on-ram.patch'
+        patch.write_bytes(git('diff', '--binary', parent, candidate, env=env))
+        assert stage_tree(parent, [patch], context('compose')) == candidate_tree
+    else:
+        assert file_hashes(candidate, sources, env) == sources and candidate_tree == product_tree
+    variants[label] = {'sha': candidate, 'parent': parent, 'tree': candidate_tree,
+                       'paths_since_parent': sorted(sources), 'execute_sha256': sha(after[execute]),
+                       'source_sha256': file_hashes(candidate, ram_hashes, env)}
+    (private / f'{label}.sha').write_text(candidate + '\n')
+
+production_tools = ('set_quartus_seed', 'set_quartus_debug', 'record_fit_inputs')
+for label, metadata in variants.items():
+    env = context(label)
+    candidate = metadata['sha']
+    variant_dir = private / 'preflight' / label
+    variant_dir.mkdir(parents=True, exist_ok=True)
+    metadata['production'] = {}
+    for seed, run in controls.items():
+        control_dir = root / f'build/timing-audit-{run}/output_files'
+        control = read_json(control_dir / 'resident-fit-manifest.json')
+        basenames = control['compiled_source_sha256'].keys()
+        assert tree(control['actual_commit'], env) == timer_tree
+        assert control['seed'] == seed and control['physical_cpu_mhz'] == 104 and control['debugger'] is False
+        assert len(basenames) == 133 and 'Template.qsf' in basenames
+        seed_dir = variant_dir / str(seed)
+        output_dir = seed_dir / 'output_files'
+        output_dir.mkdir(parents=True, exist_ok=True)
+        source_graph = (control_dir / 'source-graph.txt').read_text()
+        graphed = {line.removeprefix('SOURCE /project/') for line in source_graph.splitlines()
+                   if line.startswith('SOURCE ')}
+        assert graphed == set(basenames), sorted(graphed ^ set(basenames))
+        (output_dir / 'source-graph.txt').write_text(source_graph)
+        for name in (*basenames, *(f'tools/{tool}.py' for tool in production_tools)):
+            assert not Path(name).is_absolute() and '..' not in Path(name).parts
+            path = seed_dir / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(git('show', f'{candidate}:{name}', env=env))
+        local_env = os.environ | {'GITHUB_SHA': candidate}
+        for name in ('GITHUB_STEP_SUMMARY', 'GITHUB_RUN_ID'):
+            local_env.pop(name, None)
+        for tool, *args in (
+            ('set_quartus_seed', 'Template.qsf', '--seed', str(seed)),
+            ('set_quartus_debug', 'Template.qsf', '--enabled', 'false'),
+        ):
+            subprocess.run(['python3', '-B', f'tools/{tool}.py', *args],
+                           cwd=seed_dir, env=local_env, check=True, stdout=subprocess.PIPE)
+        qsf = seed_dir / 'Template.qsf'
+        # Quartus on the runner rewrites the version line with LF, leaving
+        # the rest of the generated QSF at its original CRLF line endings.
+        qsf.write_bytes(qsf.read_bytes().replace(b'LAST_QUARTUS_VERSION "17.0.2 Standard Edition"\r\n',
+                                                 b'LAST_QUARTUS_VERSION "17.0.2 Lite Edition"\n'))
+        subprocess.run(['python3', '-B', 'tools/record_fit_inputs.py'],
+                       cwd=seed_dir, env=local_env, check=True, stdout=subprocess.PIPE)
+        effective = output_dir / 'resident-fit-manifest.json'
+        compiled = read_json(effective)
+        assert compiled['actual_commit'] == candidate
+        actual_hashes = compiled['compiled_source_sha256']
+        selected_run = run
+        selected_manifest = control_dir / 'resident-fit-manifest.json'
+        if label == 'a-only-plus-ram':
+            prior_run = ram_dispatch['runs'][str(seed)]
+            assert prior_run['head_sha'] == active_ram
+            selected_run = prior_run['id']
+            selected_manifest = ram_stage / f'preflight/ram-on-timer/{seed}/output_files/resident-fit-manifest.json'
+        match = read_json(selected_manifest)
+        expected_parent = active_ram if label == 'a-only-plus-ram' else control['actual_commit']
+        assert match['actual_commit'] == expected_parent
+        assert match['compiled_source_sha256'].keys() == basenames
+        expected_delta = {name: actual_hashes[name] for name in basenames
+                          if actual_hashes[name] != match['compiled_source_sha256'][name]}
+        assert expected_delta == {cpu: metadata['source_sha256'][cpu]}, (label, seed, expected_delta)
+        for field in control.keys() - {'actual_commit', 'compiled_source_sha256'}:
+            assert control[field] == match[field] == compiled[field], field
+        metadata['production'][seed] = {
+            'control_run': selected_run, 'control_commit': expected_parent,
+            'physical_cpu_mhz': compiled['physical_cpu_mhz'], 'ddr_debug': compiled['debugger'],
+            'compiled_source_count': len(basenames), 'compiled_input_delta': expected_delta,
+            'qsf_sha256': actual_hashes['Template.qsf'],
+            'manifest_sha256': sha(effective.read_bytes()),
+            'control_manifest_sha256': sha(selected_manifest.read_bytes()),
+        }
+        print(f'PASS {label} seed {seed}, 104 MHz, DDR debug off, {len(basenames)} inputs', flush=True)
+
+receipt = {'status': 'PASS', 'active_ram': active_ram, 'active_timer': active_timer,
+           'timer_tree': timer_tree, 'restore': restore, 'restore_parent': active_ram,
+           'ram_patch_sha256': sha(ram_patch.read_bytes()),
+           'product_patch_sha256': sha(product_patch.read_bytes()),
+           'ram_qualification_sha256': sha(ram_path.read_bytes()),
+           'product_qualification_sha256': sha(product_path.read_bytes()),
+           'changed_module': execute, 'private_objects': str(objects),
+           'alternate_objects': alternates, 'variants': variants}
+(private / 'prepare.json').write_text(json.dumps(receipt, indent=2) + '\n')
+for label, variant in variants.items():
+    print(label, variant['sha'], variant['parent'], variant['tree'])
+print('restore', restore, active_ram, timer_tree)
