     return ''.join(modules)
 
 
+def wait_for_w_load_retirement(phone):
+    """Remove same-destination release on a live trusted completion."""
+    phone = edit(phone, '\tparameter [0:0] LOAD_FORMATTED = 1\'d0;',
+                 '\tparameter [0:0] LOAD_FORMATTED = 1\'d0;\n'
+                 '\tparameter WAW_WAIT_RETIRE = 1\'b0;')
+    phone = edit(phone, '''    wire s_wait_w_hit = s_wait_w_nohit &&
+        !(load_trust && wb_valid && request_done && !retry && !resp_err);''',
+                 '''    // Only the same-destination guard waits for W to retire.
+    wire s_wait_w_hit = s_wait_w_nohit && (WAW_WAIT_RETIRE ||
+        !(load_trust && wb_valid && request_done && !retry && !resp_err));''')
+    phone = edit(phone,
+                 '(w_same_writer && !(w_load_hit && wb_valid && request_done && !retry && !resp_err)));',
+                 '(w_same_writer && (WAW_WAIT_RETIRE ||\n'
+                 '             !(w_load_hit && wb_valid && request_done && !retry && !resp_err))));')
+    return edit(phone, '\t\t\t\t.LOAD_FORMATTED(1\'b1),',
+                '\t\t\t\t.LOAD_FORMATTED(1\'b1),\n\t\t\t\t.WAW_WAIT_RETIRE(1\'b1),')
+
+
 def prepare_data_cache_beats(phone):
