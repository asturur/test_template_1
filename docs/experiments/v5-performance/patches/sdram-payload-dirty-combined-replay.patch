+        ]
+        pin_replays[label]['cpu_block_commands'] = blocks[2:]
+        pin_replays[label]['guest_sha256'] = digest(payload_runs / 'block-guest/block-guest.hex')
+
+receipt = {'status': 'PASS', 'candidate': trial['sha'], 'base': trial['parent'], 'tree': trial['tree'],
+           'source_sha256': passed_files, 'payload_qualification_sha256': digest(previous / 'qualification.json'),
+           'dirty_qualification_sha256': digest(dirty / 'qualification.json'),
+           'preflight_sha256': digest(followup / 'prepare.json'),
+           'paired_inputs_sha256': digest(followup / 'paired-inputs.json'),
+           'simulator': (out / 'image.id').read_text().strip(),
+           'compiled_fingerprints': compiled, 'mixed_sources': len(trial_hashes),
