+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/sdram-payload-dirty-combined
+out=build/sim/v5-104-sdram-payload-dirty-combined
+mkdir -p "$out"
+docker image inspect -f '{{.Id}} {{.Os}}/{{.Architecture}}' jotego/simulator:arm64 > "$out/image.id"
+python3 -B "$area/replay.py" fixed --output qualification > "$out/fixed.log" 2>&1 &
+fixed=$!
+python3 -B "$area/replay.py" native --output qualification > "$out/native.log" 2>&1 &
+native=$!
+sh "$area/pins.sh" > "$out/pins.log" 2>&1 &
+pins=$!
+status=0
+for slot in "$fixed" "$native" "$pins"; do wait "$slot" || status=1; done
+for log in fixed native pins; do tail -8 "$out/$log.log"; done
+exit "$status"
