@@ -0,0 +1,38 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/sdram-payload-dirty-combined
+out=build/sim/v5-104-sdram-payload-dirty-combined
+base=build/sim/v5-104-dcache-dirty-compact-combined/descriptor-on-timer
+guest_path=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed/stress.hex
+payload_guest=build/sim/v5-104-sdram-block-payload/block-guest/block-guest.hex
+mixed="$out/mixed"
+image=jotego/simulator:arm64
+mkdir -p "$out/coexistence" "$out/block-guest"
+python3 -B "$area/mixed.py"
+
+docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD:/work" -w /work --entrypoint sh "$image" -ec "sh '$mixed/build.sh'
+'$mixed/obj/Vtb' +upp_stress '+compare_trace=$mixed/traffic.log' > '$mixed/replay.log'"
+cmp "$base/mixed/traffic.log" "$mixed/traffic.log"
+grep '^PASS ' "$mixed/replay.log"
+
+docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD:/work" -v "$PWD/$base/coexistence/stress-timer.hex:/work/$guest_path:ro" \
+  -w /work --entrypoint "/work/$mixed/obj/Vtb" "$image" \
+  +upp_stress "+compare_trace=$out/coexistence/candidate.trace" > "$out/coexistence/candidate.log"
+cmp "$base/coexistence/candidate.trace" "$out/coexistence/candidate.trace"
+grep '^PASS ' "$out/coexistence/candidate.log"
+
+for leg in reference source; do
+  if [ "$leg" = reference ]; then executable="$base/mixed/obj/Vtb"; else executable="$mixed/obj/Vtb"; fi
+  docker run --rm --pull=never --network none --platform linux/arm64 -v "$PWD:/work" \
+    -v "$PWD/$payload_guest:/work/$guest_path:ro" -w /work \
+    --entrypoint "/work/$executable" "$image" +upp_stress \
+    "+compare_trace=$out/block-guest/$leg.trace" > "$out/block-guest/$leg.log"
+  grep '^PASS ' "$out/block-guest/$leg.log" > "$out/block-guest/$leg.pass"
+done
+cmp "$out/block-guest/reference.trace" "$out/block-guest/source.trace"
+cmp "$out/block-guest/reference.pass" "$out/block-guest/source.pass"
+awk '$1 == "Q" && $3 == "110" && ($4 == "001740" || $4 == "001744")' "$out/block-guest/source.trace"
+wc -l "$out/block-guest/source.trace"
+cat "$out/block-guest/source.pass"
diff --git a/scratch/v5-fit-loop/sdram-payload-dirty-combined/replay.py b/scratch/v5-fit-loop/sdram-payload-dirty-combined/replay.py
new file mode 100644
index 0000000..115123f
--- /dev/null
+++ b/scratch/v5-fit-loop/sdram-payload-dirty-combined/replay.py
@@ -0,0 +1,184 @@
+"""Replay SDRAM block-data capture against the retained 104 MHz control."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import statistics
+import subprocess
+import sys
+
+parser = argparse.ArgumentParser()
+parser.add_argument('kind', choices=('fixed', 'native'))
+parser.add_argument('--case', action='append')
+parser.add_argument('--workers', type=int, default=3)
+parser.add_argument('--output', default='replay')
+args = parser.parse_args()
+kind = args.kind
+stage = Path(__file__).resolve().parent
+repo = stage.parents[2]
+work = repo / 'build/sim/v5-104-sdram-payload-dirty-combined' / args.output
+work.mkdir(parents=True, exist_ok=True)
+baseline_name = 'v5-104-all-four-ram-candidate'
+fixed = repo / 'build/sim/payload-clocks' / baseline_name
+native = repo / 'build/sim/polycount' / baseline_name
+timing_baseline = repo / 'scratch/refill-issue-739d3bd'
+d_stage = stage / 'ngage_cpu.sv'
+candidate = stage / 'source/rtl/arm9v2/arm925t_phone.v'
+image = 'jotego/simulator:arm64'
+docker = ['docker', 'run', '--rm', '--pull=never', '--network', 'none', '--platform', 'linux/arm64',
+          '-v', f'{work}:/work', '-v', f'{repo}:/frozen:ro', '-w', '/work', '--entrypoint']
+sys.path.insert(0, str(stage / 'source/tests/cpu/arm9v2_board'))
+import payload_clocks
+payload_clocks.OUT = repo / "build/sim"
+from payload_clocks import qualified_inputs
+
+
+def frozen(path):
+    return '/frozen/' + str(path.relative_to(repo))
+
+
+def run(options, entrypoint, log):
+    with log.open('w') as handle:
+        return subprocess.run(docker + [entrypoint, image] + options, stdout=handle,
+                              stderr=subprocess.STDOUT, check=False).returncode
+
+
+def build():
+    compiled_netlist = work / f'{kind}-candidate-cpu.v'
+    compiled_netlist.write_bytes(candidate.read_bytes())
+    ref = fixed if kind == 'fixed' else native / 'i16'
+    bench = (ref / 'tb.v').read_text()
+    assert bench.count('.CPU_BLOCK_WRITES(1)') == 1
+    bench = bench.replace('.CPU_BLOCK_WRITES(1)', '.CPU_BLOCK_WRITES(1), .PRECAPTURE_BLOCK_DATA(1)')
+    observer = (stage / 'architectural_trace.vh').read_text() + (stage / 'wb-write-trace.vh').read_text()
+    (work / f'{kind}.sv').write_text(bench.rsplit('endmodule', 1)[0] + observer + '\nendmodule\n')
+    command = next(line for line in (ref / 'mmc3-nos64/Vtb__verFiles.dat').read_text().splitlines()
+                   if line.startswith('C '))
+    options = shlex.split(command.removeprefix('C "').removesuffix('"'))
+    net_hits, wrapper_hits, bench_hits = 0, 0, 0
+    for i, option in enumerate(options):
+        if option == 'rtl/ngage_cpu.sv':
+            options[i] = frozen(d_stage)
+            wrapper_hits += 1
+        elif option in {'rtl/ngage_ddr_stream.v', 'rtl/ngage_upp.v', 'rtl/ngage_dma_channels.v', 'rtl/ngage_upp_peripherals.v', 'rtl/ngage_keypad.v', 'rtl/ngage_upp_euart.v', 'rtl/ngage_timers.v', 'rtl/ngage_sdram_arbiter.v'}:
+            options[i] = frozen(stage / 'source' / option)
+        elif option.startswith('/work/') and option.endswith(('/arm925t_phone.v', '/arm925t-i16.v')):
+            options[i] = '/work/' + compiled_netlist.name
+            net_hits += 1
+        elif option.startswith('/work/') and option.endswith('/tb.v'):
+            options[i] = f'/work/{kind}.sv'
+            bench_hits += 1
+        elif option.startswith('/work/') and option.endswith(('.v', '.sv')):
+            options[i] = option.replace('/work/', '/frozen/', 1)
+        elif option.startswith('-Irtl/'):
+            options[i] = '-I' + frozen(timing_baseline / 'leg' / option[2:])
+        elif option.endswith(('.v', '.sv')):
+            source = timing_baseline / 'leg' / option
+            assert source.is_file(), source
+            options[i] = frozen(source)
+    assert net_hits == wrapper_hits == bench_hits == 1, (net_hits, wrapper_hits, bench_hits)
+    options[options.index('--Mdir') + 1] = f'obj-{kind}'
+    options.insert(0, '-I'+frozen(timing_baseline / 'leg'))
+    options[options.index('-j') + 1] = '3'
+    log = work / f'build-{kind}.log'
+    assert run(options, 'verilator', log) == 0, log
+    compiled = (work / f'obj-{kind}/Vtb__verFiles.dat').read_text().splitlines()
+    assert any(line.startswith('S ') and line.endswith('/sdram-payload-dirty-combined/source/rtl/ngage_ddr_stream.v\"') for line in compiled)
+    for changed in ('ngage_upp.v', 'ngage_dma_channels.v', 'ngage_upp_peripherals.v', 'ngage_keypad.v', 'ngage_upp_euart.v', 'ngage_timers.v', 'ngage_sdram_arbiter.v'):
+        assert any(line.startswith('S ') and line.endswith(f'/sdram-payload-dirty-combined/source/rtl/{changed}"') for line in compiled), changed
+    for source in (f'{kind}.sv', compiled_netlist.name):
+        assert any(line.startswith('S ') and line.endswith(f'"/work/{source}"') for line in compiled), source
+    for cache in (work / f'obj-{kind}').glob('*.gch'):
+        cache.unlink()
+
+
+def scan(log, prefix, hex_fields=False):
+    rows = []
+    for line in log.read_text().splitlines():
+        if line.startswith(prefix):
+            pairs = re.findall(r'(\w+)=(-?[0-9a-f]+)', line)
+            rows.append({k: int(v, 16 if hex_fields and k.endswith('_hash') else 10) for k, v in pairs})
+    return rows
+
+
+def digest(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def execute(profile, case, attempt=0, wrong=False):
+    delay, thumb = profile
+    inputs = ['+ngage-compact-trace', '+no-board-log',
+              '+extension=' + frozen(repo / 'build/firmware/nem4-factory/extension.bin')]
+    suffix = f'{delay}{thumb}-{attempt}{"-wrong" if wrong else ""}'
+    if kind == 'fixed':
+        name = case['name']
+        inputs += ['+core=' + frozen(fixed / f'{name}-{wrong}.bin'), '+cdrive=' + frozen(fixed / 'cdrive.bin'),
+                   f'+begin_pc={case["begin"]:x}', f'+end_pc={case["end"]:x}',
+                   f'+payload_base={case["payload_base"]:x}', f'+helper_base={case["helper_base"]:x}']
+    else:
+        name = 'native'
+        result = work / f'native-{suffix}.bin'
+        inputs += ['+core=' + frozen(native / 'core.bin'), '+cdrive=' + frozen(native / 'cdrive.bin'),
+                   '+snapshot=' + frozen(native / 'snapshot.bin'), f'+results=/work/native-{suffix}',
+                   '+begin_pc=68', '+end_pc=6c', '+done_pc=80', '+fail_pc=84']
+    log = work / f'{name}-{suffix}.log'
+    code = run(inputs, f'/work/obj-{kind}/Vtb', log)
+    if wrong:
+        assert code != 0 and 'Guest output check rejected payload' in log.read_text(), log
+        return None
+    assert code == 0, log
+    architecture = scan(log, 'RES_ARCH ', hex_fields=True)
+    wb_writes = scan(log, 'RES_WB ', hex_fields=True)
+    assert len(wb_writes) == len(architecture)
+    if kind == 'fixed':
+        windows = scan(log, 'PAYLOAD_RESULT ')
+        assert len(architecture) == len(windows) == 7, log
+        assert len(scan(log, 'PAYLOAD_PASS ')) == 1
+        for actual, expect in zip(windows, case['windows'], strict=True):
+            assert actual['payload_ops'] == expect['payload_retire_proxy']
+            assert actual['helper_ops'] == expect['helper_retire_proxy']
+        return dict(profile=profile, case=name, windows=windows, architecture=architecture, wb_writes=wb_writes,
+                    median=statistics.median(x['cycles'] for x in windows[2:]))
+    frames = scan(log, 'POLY_FRAME ')
+    assert len(architecture) == len(frames) == 4, log
+    assert len(scan(log, 'PASS_POLYCOUNT ')) == 1
+    assert digest(result) == digest(native / 'i16/result.bin')
+    return dict(profile=profile, case=name, frames=frames, architecture=architecture, wb_writes=wb_writes,
+                output_sha256=digest(result), median=statistics.median(f['clocks'] for f in frames[1:]))
+
+
+def architectural_work(row):
+    return [{k:v for k,v in entry.items() if k != 'recover'} for entry in row['architecture']]
+
+control = json.loads((stage.parent/'prepared-wb-write-data'/'candidate'/f'{kind}.json').read_text())
+assert control['status'] == 'PASS'
+assert control['ddr_stream_sha256'] == digest(stage/'source/rtl/ngage_ddr_stream.v')
+reference = {r['candidate']['case']:r['candidate'] for r in control['rows']}
+
+build()
+rows=[]
+with ThreadPoolExecutor(max_workers=args.workers) as pool:
+    cases = [None] if kind=='native' else [case for case in qualified_inputs()
+                                            if not args.case or case['name'] in args.case]
+    if kind=='fixed':
+        assert len(cases)==(len(args.case) if args.case else 15)
+        cases.sort(key=lambda r:r['name']!='sega-scan')
+    for case in cases:
+        primary = pool.submit(execute, (0,0), case)
+        repeat = pool.submit(execute, (0,0), case, attempt=1) if kind=='fixed' else None
+        wrong = pool.submit(execute,(0,0),case,wrong=True) if kind=='fixed' else None
+        trial=primary.result()
+        if repeat:
+            assert trial==repeat.result() and wrong.result() is None
+        name=trial['case']
+        expected = {**reference[name], 'profile': (0,0)}
+        assert trial == expected, (name, trial, expected)
+        rows.append(dict(candidate=trial, control=expected))
+        print(name, trial['median'], flush=True)
+(work/f'{kind}.json').write_text(json.dumps(dict(status='PASS', netlist_sha256=digest(candidate),
+                                                wrapper_sha256=digest(d_stage), ddr_stream_sha256=digest(stage / 'source/rtl/ngage_ddr_stream.v'),
+                                                dma_channels_sha256=digest(stage / 'source/rtl/ngage_dma_channels.v'),
+                                                source_sha256={name:digest(stage / 'source/rtl' / name) for name in ('ngage_upp.v','ngage_upp_peripherals.v','ngage_upp_euart.v', 'ngage_timers.v','ngage_keypad.v','ngage_sdram_arbiter.v')}, rows=rows),indent=2)+'\n')
diff --git a/scratch/v5-fit-loop/sdram-payload-dirty-combined/record.py b/scratch/v5-fit-loop/sdram-payload-dirty-combined/record.py
new file mode 100644
index 0000000..203f8c9
--- /dev/null
+++ b/scratch/v5-fit-loop/sdram-payload-dirty-combined/record.py
@@ -0,0 +1,118 @@
+"""Record exact qualification of block-payload capture on dirty-descriptor RTL."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shlex
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+out = root / 'build/sim/v5-104-sdram-payload-dirty-combined'
+previous = area.parent / 'sdram-block-payload'
+followup = previous / 'followup-20261126'
+payload_runs = root / 'build/sim/v5-104-sdram-block-payload'
+control = root / 'build/sim/v5-104-dcache-dirty-compact-combined/descriptor-on-timer'
+dirty = area.parent / 'dcache-dirty-compact-combined/descriptor-on-timer'
+rtl = 'rtl/ngage_sdram_arbiter.v'
+cpu = 'rtl/arm9v2/arm925t_phone.v'
+fixture = 'tests/phone/mmc_mister/tb.v'
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def passes(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+def fingerprint(path, suffix):
+    rows = [shlex.split(line) for line in path.read_text().splitlines()
+            if line.startswith('S ') and line.endswith(f'{suffix}"')]
+    (row,) = rows
+    return row[-2]
+
+
+def enabled(path):
+    assert path.read_text().count('.PRECAPTURE_BLOCK_DATA(1)') == 1, path
+
+
+pair = load(followup / 'paired-inputs.json')
+prep = load(followup / 'prepare.json')
+trial = prep['variants']['payload-plus-descriptor']
+payload = load(previous / 'qualification.json')
+descriptor = load(dirty / 'qualification.json')
+assert pair['status'] == prep['status'] == payload['status'] == descriptor['status'] == 'PASS'
+assert trial['parent'] == prep['active_tip'] == descriptor['candidate']
+assert trial['sha'] == pair['selection']['payload-plus-descriptor']['candidate']
+passed_files = payload['source_sha256'] | descriptor['source_sha256']
+assert trial['hashes_from_timer'] == passed_files
+assert all(digest(area / 'source' / name) == sha for name, sha in passed_files.items())
+enabled(area / 'source/Template.sv')
+enabled(out / 'mixed/source' / fixture)
+assert digest(out / 'mixed/source' / rtl) == passed_files[rtl]
+assert digest(out / 'mixed/source' / cpu) == passed_files[cpu]
+
+mix = out / 'mixed'
+compiled = {name: fingerprint(mix / 'obj/Vtb__verFiles.dat', name) for name in (rtl, cpu)}
+assert compiled[rtl] == payload['compiled_arbiter_fingerprint']
+assert compiled[cpu] == descriptor['compiled_cpu_fingerprint']
+trial_hashes, baseline_hashes = (load(path / 'source-hashes.json')
+                                for path in (mix, control / 'mixed'))
+assert len(trial_hashes) == 114 and trial_hashes.keys() == baseline_hashes.keys()
+assert {name for name in trial_hashes if trial_hashes[name] != baseline_hashes[name]} == {rtl, fixture}
+
+averages = {}
+for kind, key, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    result = load(receipt)
+    baseline = load(control / f'qualification/{kind}.json')
+    assert result['status'] == baseline['status'] == 'PASS' and result['rows'] == baseline['rows']
+    assert result['netlist_sha256'] == baseline['netlist_sha256'] == passed_files[cpu]
+    assert sum(len(row['candidate'][key]) for row in result['rows']) == count
+    enabled(out / f'qualification/{kind}.sv')
+    assert result['source_sha256'][Path(rtl).name] == passed_files[rtl]
+    manifest = out / f'qualification/obj-{kind}/Vtb__verFiles.dat'
+    assert fingerprint(manifest, rtl) == compiled[rtl]
+    assert fingerprint(manifest, f'{kind}-candidate-cpu.v') == compiled[cpu]
+    averages[kind] = {'count': count, 'receipt_sha256': digest(receipt)}
+native = result['rows'][0]['candidate']
+averages['native']['cycles'] = [frame['clocks'] for frame in native['frames']]
+averages['native']['guest_sha256'] = native['output_sha256']
+
+pin_replays = {}
+for label, reference, trace, log in (
+    ('normal', control / 'mixed/traffic.log', 'mixed/traffic.log', 'mixed/replay.log'),
+    ('timer_coexistence', control / 'coexistence/candidate.trace', 'coexistence/candidate.trace',
+     'coexistence/candidate.log'),
+    ('cpu_block_eviction', out / 'block-guest/reference.trace', 'block-guest/source.trace',
+     'block-guest/source.log'),
+):
+    actual = out / trace
+    assert digest(actual) == digest(reference)
+    rows = actual.read_text().splitlines()
+    clocks = next(int(line.split('cycles=')[1].split()[0]) for line in passes(out / log) if 'persisted512bytes' in line)
+    pin_replays[label] = {'events': len(rows), 'cycles': clocks, 'trace_sha256': digest(actual)}
+    if label == 'cpu_block_eviction':
+        blocks = [row.split() for row in rows if row.startswith('Q ') and row.split()[2] == '110']
