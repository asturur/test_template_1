@@ -0,0 +1,56 @@
+"""Compare payload-only selected source changes with each proper fit control."""
+from hashlib import sha256
+import json
+from pathlib import Path
+
+
+followup = Path(__file__).resolve().parent
+area = followup.parent
+root = area.parents[2]
+dirty = root / 'scratch/v5-fit-loop/dcache-dirty-compact-combined/dispatch-20261126'
+timer_runs = {13: 45824513460, 43: 45824520116, 31337: 45824525843}
+
+
+def read_json(path):
+    return json.loads(path.read_bytes())
+
+
+prep = read_json(followup / 'prepare.json')
+dirty_dispatch = read_json(dirty / 'dispatch.json')
+assert prep['status'] == 'PASS' and dirty_dispatch['status'] == 'VERIFIED_DISPATCH'
+assert prep['active_tip'] == dirty_dispatch['candidate']
+payload = read_json(area / 'qualification.json')
+assert payload['status'] == 'PASS'
+expected = payload['source_sha256']
+assert set(expected) == {'Template.sv', 'rtl/ngage_sdram_arbiter.v'}
+choices = {}
+for label, row in prep['variants'].items():
+    choices[label] = {'candidate': row['sha'], 'control': row['parent'], 'seeds': {}}
+    for seed, run in timer_runs.items():
+        candidate = followup / f'preflight/{label}/{seed}/output_files/resident-fit-manifest.json'
+        if label == 'payload-plus-descriptor':
+            selected = dirty / f'preflight/{prep["descriptor_variant"]}/{seed}/output_files/resident-fit-manifest.json'
+            run = dirty_dispatch['runs'][str(seed)]['id']
+            control_sha = prep['active_tip']
+        else:
+            selected = root / f'build/timing-audit-{run}/output_files/resident-fit-manifest.json'
+            control_sha = prep['active_timer']
+        test, control = read_json(candidate), read_json(selected)
+        assert test['actual_commit'] == row['sha'] and control['actual_commit'] == control_sha
+        assert test['seed'] == control['seed'] == seed
+        assert test['physical_cpu_mhz'] == control['physical_cpu_mhz'] == 104
+        assert test['debugger'] is control['debugger'] is False
+        a, b = test['compiled_source_sha256'], control['compiled_source_sha256']
+        assert a.keys() == b.keys() and len(a) == 133
+        assert a['Template.qsf'] == b['Template.qsf']
+        assert {name: value for name, value in a.items() if value != b[name]} == expected
+        assert all(test[k] == control[k] for k in control.keys() - {'actual_commit', 'compiled_source_sha256'})
+        choices[label]['seeds'][seed] = {'paired_run': run, 'control_commit': control_sha,
+                                         'changed_selected_sources': expected,
+                                         'qsf_sha256': a['Template.qsf'],
+                                         'candidate_manifest_sha256': sha256(candidate.read_bytes()).hexdigest(),
+                                         'control_manifest_sha256': sha256(selected.read_bytes()).hexdigest()}
+        print(label, seed, run, 'only Template.sv and ngage_sdram_arbiter.v')
+report = {'status': 'PASS', 'production_mhz': 104, 'debugger': False,
+          'selection': choices, 'dirty_manifest_from_preflight': True}
+(followup / 'paired-inputs.json').write_text(json.dumps(report, indent=2) + '\n')
