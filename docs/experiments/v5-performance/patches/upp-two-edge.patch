diff --git a/tests/phone/upp_two_edge/README.md b/tests/phone/upp_two_edge/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..ebe68576617cdc603850f8f79868797f76952b67
--- /dev/null
+++ b/tests/phone/upp_two_edge/README.md
@@ -0,0 +1,33 @@
+# Two-edge UPP register responses
+
+From the snapshot root, pass the unmodified `e7f1e31` source directory
+to the comparison. Both runs use the production bus bridge and
+request-stage modules. The test replaces only the upstream CPU master
+and the board fault register.
+
+```sh
+sh tests/phone/upp_two_edge/run.sh /path/to/control
+tclsh tests/phone/upp_two_edge/endpoints.tcl
+```
+
+The directed test compares ordered completions and owner/effect
+samples with keypad enabled and disabled. It observes every bit of
+the protected bank over E1. Both launch phases, repeated addresses
+and narrow/invalid byte lanes are exercised. It checks cancellation,
+a held response, warm reset, UART backpressure and coincident receive,
+SIMIF overlap, unclaimed traffic, Timer0 expiry/acknowledgment,
+MMC register access, and the unchanged fast comm-RAM path.
+
+For an immediate peripheral register access, E0 captures the held
+request, E1 matures it, E2 samples the live result and authorizes the
+effect, E3 registers the CPU response and E4 consumes it. Another
+immediate request can issue on E5. The original immediate sequence
+was E0 through E3 with the next request on E4. GPIO RAM and passive
+registers can prepare their synchronous data during E1. The separate
+comm-RAM data lane may capture at E1 and keeps single-cycle timing.
+
+The Tcl test exercises the endpoint selector with Quartus-style
+register names and known excluded cells. The production CI timing
+report enumerates the actual connected held-to-data setup/hold pairs
+and checks ordinary-cycle witnesses. The offline test covers the
+selector rules and protocol. It does not contain a routed netlist.
diff --git a/tests/phone/upp_two_edge/endpoints.tcl b/tests/phone/upp_two_edge/endpoints.tcl
new file mode 100644
index 0000000000000000000000000000000000000000..d785d96ae3d1cf4c4f7867bd6cdcc9564cc6175d
--- /dev/null
+++ b/tests/phone/upp_two_edge/endpoints.tcl
@@ -0,0 +1,47 @@
+# Check the SDC selector against Quartus-style register and replica names.
+# Timing path connectivity and clock relationships are audited post-fit.
+set prefix {emu:emu|ngage_mister:core|ngage_board:board|ngage_upp:upp}
+set stage $prefix|ngage_upp_request_stage:cpu_inside.request_stage
+set response $prefix|ngage_upp_peripherals:peripherals
+set held [list "$stage|held_address\[17\]" "$stage|held_sel\[3\]~DUPLICATE263" "$stage|held_we"]
+set late [list "$response|registered_response.local_results\[13\].two_edge_payload.data\[14\]" \
+               "$response|registered_response.local_results\[15\].two_edge_payload.data\[31\]"]
+set excluded [list "$response|registered_response.local_results\[10\].ordinary_payload.data\[14\]" \
+                   "$response|registered_response.local_results\[13\].owner" \
+                   "$response|registered_response.valid" "$stage|mature" \
+                   "other|ngage_upp_request_stage:cpu_inside.request_stage|held_address\[17\]"]
+set registers [concat $held $late $excluded]
+set constraints {}
+proc derive_pll_clocks {} {}
+proc derive_clock_uncertainty {} {}
+proc foreach_in_collection {var collection body} {uplevel 1 [list foreach $var $collection $body]}
+proc get_node_info {option name} {return $name}
+proc get_registers {option patterns} {
+    global registers
+    set result {}
+    foreach reg $registers {
+        foreach pattern $patterns {
+            if {[string match $pattern $reg]} {lappend result $reg; break}
+        }
+    }
+    return $result
+}
+proc set_multicycle_path {args} {
+    global constraints
+    lappend constraints $args
+}
+proc post_message {args} {}
+source Template.sdc
+if {$constraints ne [list [list -end -setup -from $held -to $late 2] \
+                         [list -end -hold -from $held -to $late 1]]} {
+    error "Wrong UPP exception scope $constraints"
+}
+lappend registers "$response|registered_response.local_results\[10\].two_edge_payload.data\[2\]"
+if {![catch {upp_mmio::endpoints} message] || ![string match {Unexpected UPP response sample register *} $message]} {
+    error "Wrong-lane named result was not rejected"
+}
+set registers $excluded
+set constraints {}
+source Template.sdc
+if {$constraints ne {}} {error "Empty selector emitted an exception"}
+puts "PASS exact held-packet SDC collection scope, fast-path exclusion and empty guard"
diff --git a/tests/phone/upp_two_edge/run.sh b/tests/phone/upp_two_edge/run.sh
new file mode 100755
index 0000000000000000000000000000000000000000..1dd6013f736409f2f00fcfb9130b3a7043ecca0b
--- /dev/null
+++ b/tests/phone/upp_two_edge/run.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+set -eu
+reference=$(realpath "$1")
+out=${UPP_TWO_EDGE_TEST_OUT:-build/sim/upp-two-edge}
+mkdir -p "$out"
+for keypad in 0 1; do
+    for leg in reference candidate; do
+        set --
+        source=.
+        if [ "$leg" = reference ]; then
+            source=$reference
+            set -- -DREFERENCE
+        fi
+        prefix="$out/$leg-$keypad"
+        iverilog -g2012 -s tb -Ptb.KEYPAD_ENABLE="$keypad" "$@" \
+            -y "$source/rtl" -I "$source/rtl" -o "$prefix" \
+            "$source/rtl/ngage_upp.v" "$source/rtl/ngage_upp_euart.v" \
+            tests/phone/upp_two_edge/tb.sv
+        if ! vvp "$prefix" > "$prefix.log"; then
+            tail -20 "$prefix.log"
+            exit 1
+        fi
+        sed -n 's/^DONE [0-9]* duration=[0-9]* //p; s/^SAMPLE [0-9]* //p' \
+            "$prefix.log" > "$prefix.sequence"
+        grep -E '^(APERTURE|PASS) ' "$prefix.log"
+    done
+    cmp "$out/reference-$keypad.sequence" "$out/candidate-$keypad.sequence"
+done
