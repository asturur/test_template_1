+           'physical_source_count': len(manifest), 'physical_replays': physical,
+           'timer_hot_witnesses': witnesses}
+(stage / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print('PASS exact LINE handshake, workload cycles, timer pin traces and routed witnesses')
