index 0000000..7fa07e0
--- /dev/null
+++ b/scratch/v5-fit-loop/refill-line-word-ready/prepare-miter.py
@@ -0,0 +1,53 @@
+"""Compare the exact retained and candidate refill modules at their interfaces."""
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-refill-line-word-ready/miter')
+out.mkdir(parents=True, exist_ok=True)
+rtl = 'rtl/ngage_cpu.sv'
+
+
+def wrapper(leg):
+    return (stage / leg / rtl).read_text()
+
+
+def refill(source):
+    return re.search(r'^module ngage_arm9v2_refill\s+#\(.*?^endmodule$', source, re.M | re.S)[0]
+
+
+old, new = (wrapper(leg) for leg in ('reference', 'source'))
+retained, candidate = refill(old), refill(new)
+assert old.replace(retained, candidate) == new
+assert retained.split('    localparam', 1)[0] == candidate.split('    localparam', 1)[0]
+assert retained.split('    always @(posedge clk) begin\n        if (reset) begin', 1)[1].split(
+    '    // synthesis translate_off', 1)[0] == candidate.split(
+        '    always @(posedge clk) begin\n        if (reset) begin', 1)[1].split(
+            '    // synthesis translate_off', 1)[0]
+for message in ('Donor changed the owned line burst', 'Guaranteed line returned an error',
+                'Line rejected after data', 'Bad board line framing'):
+    assert next(line for line in retained.splitlines() if message in line) in candidate
+ports = re.compile(r'^    (input|output)\s+wire\s*(\[[^]]+\])?\s*(\w+)\s*,?$', re.M)
+assert ports.findall(retained) == ports.findall(candidate)
+bench = (stage / 'refill-directed.sv').read_text()
+connections, declarations = [], []
+for label, module in (('retained', retained), ('trial', candidate)):
+    name = f'{label}_refill'
+    (out / f'{label}.v').write_text(module.replace('module ngage_arm9v2_refill', f'module {name}'))
+    mappings = []
+    for direction, width, port in ports.findall(module):
+        target = port
+        if direction == 'output':
+            target = f'{label}_{port}'
+            declarations.append(f'    wire {width} {target};\n')
+        mappings.append(f'        .{port}({target})')
+    port_map = ',\n'.join(mappings)
+    connections.append(f'''    {name} #(
+        .ENABLE(ENABLE), .REGISTERED_SCALAR_PEER(REGISTERED)
+    ) {label} (
+{port_map}
+    );
+''')
+assert bench.count('    // Exact adapters') == 1
+(out / 'tb.sv').write_text(bench.replace('    // Exact adapters', ''.join(declarations + connections)))
diff --git a/scratch/v5-fit-loop/refill-line-word-ready/refill-directed.sv b/scratch/v5-fit-loop/refill-line-word-ready/refill-directed.sv
new file mode 100644
index 0000000..e9677f7
--- /dev/null
+++ b/scratch/v5-fit-loop/refill-line-word-ready/refill-directed.sv
@@ -0,0 +1,322 @@
+`timescale 1ns / 1ps
+
+module tb;
+    parameter ENABLE = 1;
+    parameter REGISTERED = 1;
+    localparam [2:0] BURST = 3'b010, END_BEAT = 3'b111;
+    reg clk = 0, reset = 1;
+    reg cpu_cyc = 0, cpu_lock = 0, cpu_write = 0;
+    reg [31:0] cpu_address = 0;
+    reg [3:0] cpu_sel = 15;
+    reg [2:0] cpu_cti = END_BEAT;
+    reg [1:0] cpu_bte = 0;
+    wire cpu_line_candidate = !cpu_write && cpu_sel == 15 && cpu_cti == BURST &&
+                              cpu_bte == 0 && cpu_address[4:0] == 0 && cpu_address[31:24] == 8'h0a;
+    reg wb_ack = 0, wb_error = 0;
+    reg [31:0] wb_data = 0;
+    reg line_ready = 0, line_reject = 0, line_valid = 0;
+    reg line_wide = 0, line_last = 0, line_error = 0, line_no_late_error = 0;
+    reg [63:0] line_data = 0;
+    // Exact adapters
+
+    integer comparisons = 0, line_cases = 0, failed_lines = 0;
+    integer narrow_pop = 0, wide_pop = 0, withheld_line = 0, withheld_scalar = 0;
+    integer scalar_reads = 0, scalar_writes = 0, scalar_errors = 0;
+    integer halfwords = 0, retired = 0;
+    reg model_failed, model_guaranteed;
+    reg [31:0] staged_words [0:7];
+    reg [15:0] staged_half;
+    reg [31:0] prng = 32'h3b6ad275;
+    reg [31:0] line_base = 32'h0a000200;
+    integer sample;
+
+    function [31:0] advance_random;
+        input [31:0] previous;
+        reg [31:0] value;
+        begin
+            value = previous ^ (previous << 13);
+            value = value ^ (value >> 17);
+            advance_random = value ^ (value << 5);
+        end
+    endfunction
+
+    task compare_ports;
+        integer word;
+        begin
+            if ({retained_cpu_ack, retained_cpu_error, retained_cpu_no_late_error, retained_cpu_data,
+                 retained_wb_cyc, retained_wb_lock, retained_line_req, retained_line_addr} !==
+                {trial_cpu_ack, trial_cpu_error, trial_cpu_no_late_error, trial_cpu_data,
+                 trial_wb_cyc, trial_wb_lock, trial_line_req, trial_line_addr})
+                $fatal(1, "Refill interface differed at check %0d", comparisons);
+            if ({retained.state, retained.consumed, retained.received, retained.failed} !==
+                {trial.state, trial.consumed, trial.received, trial.failed})
+                $fatal(1, "Refill state differed at check %0d", comparisons);
+            if (retained.state == 1 && !retained.failed)
+                for (word = 0; word < 8; word = word + 1)
+                    if (trial.ready_words[word] !==
+                        (int'(retained.received[4:1]) > int'(retained.consumed) + word))
+                        $fatal(1, "Incorrect occupancy at check %0d word %0d", comparisons, word);
+            comparisons = comparisons + 1;
+        end
+    endtask
+
+    task cycle;
+        begin
+            #2;
+            compare_ports;
+            clk = 1;
+            #2;
+            compare_ports;
+            clk = 0;
+            #1;
+        end
+    endtask
+
+    task publish_line;
+        input guaranteed_reply;
+        begin
+            halfwords = 0;
+            retired = 0;
+            model_failed = 0;
+            model_guaranteed = guaranteed_reply;
+            line_base = line_base + 32;
+            cpu_address = line_base;
+            cpu_cti = BURST;
+            cpu_cyc = 1;
+            cpu_write = 0;
+            cpu_lock = 0;
+            line_no_late_error = guaranteed_reply;
+            line_ready = 1;
+            #1;
+            if (!retained_line_req || retained_wb_cyc)
+                $fatal(1, "LINE offer leaked to scalar bus");
+            cycle;
+            line_ready = 0;
+            if (retained.state != 1) $fatal(1, "LINE offer did not establish ownership");
+        end
+    endtask
+
+    task line_step;
+        reg expect_ack, expect_error;
+        begin
+            cpu_address = line_base + 4 * retired;
+            cpu_cti = retired == 7 ? END_BEAT : BURST;
+            #1;
+            expect_ack = !model_failed && (halfwords / 2 > retired);
+            expect_error = model_failed;
+            if ({retained_cpu_ack, retained_cpu_error, retained_cpu_no_late_error} !==
+                {expect_ack, expect_error, expect_ack && model_guaranteed})
+                $fatal(1, "Unexpected LINE handshake at received=%0d retired=%0d", halfwords, retired);
+            if (expect_ack && retained_cpu_data !== staged_words[retired])
+                $fatal(1, "Assembled word differed at %h", cpu_address);
+            if (line_valid) begin
+                if (line_wide) begin
+                    if (expect_ack) wide_pop = wide_pop + 1;
+                    staged_words[halfwords / 2] = line_data[31:0];
+                    staged_words[halfwords / 2 + 1] = line_data[63:32];
+                    halfwords = halfwords + 4;
+                end else begin
+                    if (halfwords % 2 != 0) begin
+                        if (expect_ack) narrow_pop = narrow_pop + 1;
+                        staged_words[halfwords / 2] = {line_data[15:0], staged_half};
+                    end else staged_half = line_data[15:0];
+                    halfwords = halfwords + 1;
+                end
+                if (line_error) model_failed = 1;
+            end
+            if (expect_ack || expect_error) retired = retired + 1;
+            cycle;
+        end
+    endtask
+
+    task run_line;
+        input integer layout, error_at;
+        input gaps;
+        integer steps;
+        begin
+            publish_line(error_at < 0);
+            steps = 0;
+            while (retired < 8 && steps < 100) begin
+                prng = advance_random(prng);
+                line_valid = halfwords < 16 && !model_failed && (!gaps || |prng[1:0]);
+                line_wide = layout == 1 || (layout == 2 && (halfwords == 0 || halfwords == 8));
+                line_error = line_valid && error_at >= 0 && halfwords + (line_wide ? 4 : 1) > error_at;
+                line_last = line_error || halfwords + (line_wide ? 4 : 1) == 16;
+                line_data = {prng ^ 32'h63a92b21, prng};
+                line_step;
+                steps = steps + 1;
+            end
+            if (retired != 8 || retained.state != 0 || model_failed != (error_at >= 0))
+                $fatal(1, "LINE did not finish layout=%0d error_at=%0d retired=%0d state=%0d failed=%0d",
+                       layout, error_at, retired, retained.state, model_failed);
+            line_valid = 0;
+            line_last = 0;
+            line_error = 0;
+            cpu_cyc = 0;
+            line_cases = line_cases + 1;
+            if (model_failed) failed_lines = failed_lines + 1;
+            cycle;
+        end
+    endtask
+
+    task cancel_live_line;
+        input integer phase;
+        begin
+            publish_line(0);
+            line_valid = 1;
+            line_wide = phase != 1;
+            line_error = phase == 2;
+            line_last = line_error;
+            line_data = 64'h10203040a0b0c0d0;
+            line_step;
+            line_valid = 0;
+            cpu_cyc = 0;
+            #1;
+            compare_ports;
+            if (retained_cpu_ack || retained_cpu_error || retained_wb_cyc || retained_line_req)
+                $fatal(1, "LINE response outlived same-edge CYC withdrawal");
+            withheld_line = withheld_line + 1;
+            cpu_cyc = 1;
+            #1;
+            if ({retained_cpu_ack, retained_cpu_error} !== {phase == 0, phase == 2})
+                $fatal(1, "LINE response did not follow restored CYC");
+            reset = 1;
+            cpu_cyc = 0;
+            cycle;
+            reset = 0;
+            line_last = 0;
+            line_error = 0;
+            if (retained.state != 0 || trial.ready_words != 0)
+                $fatal(1, "Reset left a live LINE owner");
+            cycle;
+        end
+    endtask
+
+    task scalar_reply;
+        input writes, rejects_with_error;
+        begin
+            cpu_cyc = 1;
+            cpu_write = writes;
+            cpu_lock = writes;
+            cpu_address = 32'h0c000010;
+            cpu_cti = END_BEAT;
+            wb_ack = !rejects_with_error;
+            wb_error = rejects_with_error;
+            wb_data = rejects_with_error ? 32'hd47aec10 : 32'h54b04d98;
+            #1;
+            compare_ports;
+            if (!retained_wb_cyc || retained_wb_lock != writes ||
+                retained_cpu_ack != (!REGISTERED && !rejects_with_error) ||
+                retained_cpu_error != (!REGISTERED && rejects_with_error) ||
+                retained_cpu_no_late_error || retained_cpu_data != wb_data)
+                $fatal(1, "Unexpected first scalar offer");
+            if (REGISTERED) cycle;
+            #1;
+            if (retained_cpu_ack != !rejects_with_error || retained_cpu_error != rejects_with_error)
+                $fatal(1, "Scalar peer did not acknowledge its registered owner");
+            cpu_cyc = 0;
+            #1;
+            compare_ports;
+            if (retained_cpu_ack || retained_cpu_error || retained_wb_cyc)
+                $fatal(1, "Scalar response outlived same-edge CYC withdrawal");
+            withheld_scalar = withheld_scalar + 1;
+            cpu_cyc = 1;
+            cycle;
+            wb_ack = 0;
+            wb_error = 0;
+            cpu_cyc = 0;
+            cpu_write = 0;
+            cpu_lock = 0;
+            cycle;
+            if (writes) scalar_writes = scalar_writes + 1;
+            else scalar_reads = scalar_reads + 1;
+            if (rejects_with_error) scalar_errors = scalar_errors + 1;
+        end
+    endtask
+
+    task rejected_line;
+        integer word;
+        begin
+            publish_line(1);
+            line_reject = 1;
+            cycle;
+            line_reject = 0;
+            if (retained.state != 2 || !retained_wb_cyc || retained_cpu_no_late_error)
+                $fatal(1, "Rejected LINE did not immediately hand the packet to scalar");
+            for (word = 0; word < 8; word = word + 1) begin
+                cpu_address = line_base + 4 * word;
+                cpu_cti = word == 7 ? END_BEAT : BURST;
+                wb_ack = 0;
+                cycle;
+                wb_data = 32'hdf110000 | word;
+                wb_ack = 1;
+                #1;
+                if (!retained_cpu_ack || retained_cpu_error || retained_cpu_no_late_error ||
+                    retained_cpu_data != wb_data)
+                    $fatal(1, "Scalar fallback did not deliver the rejected LINE word");
+                cycle;
+            end
+            wb_ack = 0;
+            cpu_cyc = 0;
+            if (retained.state != 0) $fatal(1, "Fallback burst did not release scalar ownership");
+            cycle;
+        end
+    endtask
+
+    task cancel_scalar;
+        begin
+            // Let the registered peer capture an offer, then drop CYC
+            // across the clock carrying the now-unowned error.
+            cpu_cyc = 1;
+            cpu_address = 32'h0c000020;
+            cpu_cti = END_BEAT;
+            cycle;
+            cpu_cyc = 0;
+            wb_error = 1;
+            cycle;
+            if (retained_cpu_ack || retained_cpu_error || retained_wb_cyc || retained.scalar_offered)
+                $fatal(1, "Canceled scalar transaction retained the previous owner");
+            wb_error = 0;
+            withheld_scalar = withheld_scalar + 1;
+            cycle;
+            scalar_reply(0, 0);
+        end
+    endtask
+
+    initial begin
+        cycle;
+        reset = 0;
+        cycle;
+        scalar_reply(0, 0);
+        scalar_reply(0, 1);
+        scalar_reply(1, 0);
+        scalar_reply(1, 1);
+        cancel_scalar;
+        if (ENABLE) begin
+            run_line(0, -1, 0);
+            run_line(1, -1, 0);
+            run_line(2, -1, 0);
+            run_line(0, 0, 0);
+            run_line(0, 15, 0);
+            run_line(1, 4, 0);
+            run_line(1, 12, 0);
+            run_line(2, 5, 0);
+            for (sample = 0; sample < 96; sample = sample + 1) begin
+                prng = advance_random(prng);
+                run_line(sample % 3, sample % 2 == 0 ? int'(prng[3:0]) : -1, 1);
+            end
+            rejected_line;
+            cancel_live_line(0);
+            cancel_live_line(1);
+            cancel_live_line(2);
+            run_line(0, -1, 0);
+            if (line_cases != 105 || failed_lines != 53 ||
+                narrow_pop == 0 || wide_pop == 0 || withheld_line != 3)
+                $fatal(1, "LINE directed coverage incomplete");
+        end
+        $display("PASS refill interface enable=%0d registered=%0d comparisons=%0d line=%0d errors=%0d narrow_pop=%0d wide_pop=%0d line_withdraw=%0d scalar_withdraw=%0d reads=%0d writes=%0d scalar_errors=%0d",
+                 ENABLE, REGISTERED, comparisons, line_cases, failed_lines, narrow_pop, wide_pop,
+                 withheld_line, withheld_scalar, scalar_reads, scalar_writes, scalar_errors);
+        $finish;
+    end
+endmodule
diff --git a/scratch/v5-fit-loop/refill-line-word-ready/record.py b/scratch/v5-fit-loop/refill-line-word-ready/record.py
