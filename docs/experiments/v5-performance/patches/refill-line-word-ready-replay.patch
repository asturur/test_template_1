@@ -0,0 +1,20 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/refill-line-word-ready
+out=build/sim/v5-104-refill-line-word-ready/coexistence
+retained=build/sim/v5-104-timer-write-prepare/mixed
+candidate=build/sim/v5-104-refill-line-word-ready/mixed
+python3 -B "$area/prepare-coexistence.py"
+guest_path=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed/stress.hex
+for leg in retained candidate; do
+  if [ "$leg" = retained ]; then replay=$retained; else replay=$candidate; fi
+  docker run --rm --pull=never --network none --platform linux/arm64 -v "$PWD:/work" \
+    -v "$PWD/$out/stress-timer.hex:/work/$guest_path:ro" -w /work \
+    --entrypoint "/work/$replay/obj/Vtb" jotego/simulator:arm64 \
+    +upp_stress "+compare_trace=$out/$leg.trace" > "$out/$leg.log"
+  grep '^PASS ' "$out/$leg.log" > "$out/$leg.pass"
+done
+cmp "$out/retained.trace" "$out/candidate.trace"
+cmp "$out/retained.pass" "$out/candidate.pass"
+wc -l "$out/candidate.trace"
+cat "$out/candidate.pass"
diff --git a/scratch/v5-fit-loop/refill-line-word-ready/prepare-miter.py b/scratch/v5-fit-loop/refill-line-word-ready/prepare-miter.py
