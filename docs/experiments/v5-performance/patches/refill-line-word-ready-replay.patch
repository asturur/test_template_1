index 0000000..4c1507c
--- /dev/null
+++ b/scratch/v5-fit-loop/refill-line-word-ready/record.py
@@ -0,0 +1,153 @@
+"""Verify the refill differential, compiled identities and timer route witnesses."""
+import csv
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-refill-line-word-ready')
+control = Path('build/sim/v5-104-timer-write-prepare')
+rtl = 'rtl/ngage_cpu.sv'
+base = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def match(left, right):
+    assert left.read_bytes() == right.read_bytes(), (left, right)
+    return digest(left)
+
+
+def fingerprint(manifest, file):
+    rows = [shlex.split(line) for line in manifest.read_text().splitlines()
+            if line.startswith('S ') and shlex.split(line)[-1].endswith(file)]
+    (row,) = rows
+    return row[-2]
+
+
+patch = stage / 'refill-line-word-ready.patch'
+stats = subprocess.check_output(['git', 'apply', '--numstat', str(patch)], text=True)
+assert [line.split('\t')[-1] for line in stats.splitlines()] == [rtl]
+candidate = digest(stage / 'source' / rtl)
+baseline = digest(stage / 'reference' / rtl)
+assert candidate != baseline and digest(stage / Path(rtl).name) == candidate
+
+miter = out / 'miter'
+extracted = {}
+for leg, name in (('reference', 'retained'), ('source', 'trial')):
+    text = (miter / f'{name}.v').read_text().replace(f'module {name}_refill', 'module ngage_arm9v2_refill')
+    assert text in (stage / leg / rtl).read_text()
+    extracted[name] = digest(miter / f'{name}.v')
+miter_cases = {}
+for enable in (0, 1):
+    for registered in (0, 1):
+        key = f'{enable}-{registered}'
+        log = miter / f'{key}.log'
+        lines = [line for line in log.read_text().splitlines() if line.startswith('PASS ')]
+        assert len(lines) == 1
+        fields = {k: int(v) for k, v in re.findall(r'(\w+)=(\d+)', lines[0])}
+        assert fields['enable'] == enable and fields['registered'] == registered
+        assert fields['comparisons'] == (3393 if enable else 40) + 10 * registered
+        assert fields['line'] == 105 * enable and fields['errors'] == 53 * enable
+        assert fields['narrow_pop'] == 29 * enable and fields['wide_pop'] == 110 * enable
+        assert fields['line_withdraw'] == 3 * enable and fields['scalar_withdraw'] == 6
+        assert (fields['reads'], fields['writes'], fields['scalar_errors']) == (3, 2, 2)
+        miter_cases[key] = fields | {'log_sha256': digest(log)}
+
+board_traces = {}
+for burst in (0, 1):
+    for wait in (0, 5):
+        key = f'burst-{burst}-wait-{wait}'
+        trace = out / 'board/source' / f'{key}.trace'
+        board_traces[key] = {'trace_sha256': match(trace, out / 'board/reference' / trace.name),
+                             'cycles': int(re.search(r'^PASS cycles=(\d+)', trace.read_text(), re.M)[1])}
+
+old_mixed = control / 'mixed'
+mixed = out / 'mixed'
+manifest = load(mixed / 'source-hashes.json')
+old_manifest = load(old_mixed / 'source-hashes.json')
+assert manifest.keys() == old_manifest.keys() and len(manifest) == 114
+assert {name: value for name, value in manifest.items() if value != old_manifest[name]} == {rtl: candidate}
+assert digest(mixed / 'source' / rtl) == manifest[rtl]
+compiled = fingerprint(mixed / 'obj/Vtb__verFiles.dat', f'{mixed}/source/{rtl}')
+assert fingerprint(out / 'board/source/obj/Vcontract__verFiles.dat', rtl) == compiled
+assert fingerprint(out / 'board/reference/obj/Vcontract__verFiles.dat', rtl) != compiled
+
+workloads = {}
+for kind, field, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    measured = out / f'qualification/{kind}.json'
+    result = load(measured)
+    timer = load(control / f'qualification/{kind}.json')
+    assert result['status'] == timer['status'] == 'PASS'
+    assert result['rows'] == timer['rows'] and result['netlist_sha256'] == timer['netlist_sha256']
+    assert result['source_sha256'] == timer['source_sha256']
+    assert result['wrapper_sha256'] == candidate and timer['wrapper_sha256'] == baseline
+    assert fingerprint(out / f'qualification/obj-{kind}/Vtb__verFiles.dat', '/ngage_cpu.sv') == compiled
+    assert sum(len(row['candidate'][field]) for row in result['rows']) == count
+    workloads[kind] = {'count': count, 'receipt_sha256': digest(measured)}
+    if kind == 'fixed':
+        cases = {row['candidate']['case'] for row in result['rows']}
+        assert len(cases) == 15
+        for name in cases:
+            assert (out / f'qualification/{name}-00-1.log').is_file()
+            wrong = out / f'qualification/{name}-00-0-wrong.log'
+            assert 'Guest output check rejected payload' in wrong.read_text()
+        workloads[kind].update(repeats=15, wrong_output_rejections=15)
+    else:
+        row = result['rows'][0]['candidate']
+        workloads[kind].update(frame_cycles=[frame['clocks'] for frame in row['frames']],
+                               guest_output_sha256=row['output_sha256'])
+
+physical = {}
+for name, trace, reference, log, count, clocks in (
+    ('normal', mixed / 'traffic.log', old_mixed / 'traffic.log', mixed / 'replay.log', 171496, 1201547),
+    ('overlap', out / 'coexistence/candidate.trace', control / 'coexistence/candidate.trace',
