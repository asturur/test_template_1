index 0000000..1951ed9
--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-count-prepare/check-arithmetic.py
@@ -0,0 +1,21 @@
+"""Check the transfer-byte calculation and counter representation."""
+
+for mask in range(16):
+    for remaining in range(8192):
+        legacy = 0
+        for lane in range(4):
+            if (mask >> lane) & 1 and legacy < remaining:
+                legacy += 1
+        assert legacy == min(remaining, mask.bit_count())
+
+for value in range(8192):
+    for moved in range(5):
+        low = (value & 7) + moved
+        group = value >> 3
+        successor = (group + 1) & 1023
+        next_value = ((successor if low & 8 else group) << 3) | (low & 7)
+        next_successor = (successor + bool(low & 8)) & 1023
+        assert next_value == (value + moved) & 8191
+        assert next_successor == ((next_value >> 3) + 1) & 1023
+
+print('PASS 131,072 write-length cases and 40,960 counter transitions')
diff --git a/scratch/v5-fit-loop/mmc-count-prepare/count-observer.vh b/scratch/v5-fit-loop/mmc-count-prepare/count-observer.vh
new file mode 100644
index 0000000..f219e8e
--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-count-prepare/count-observer.vh
@@ -0,0 +1,35 @@
+    reg [12:0] legacy_bus_count;
+    reg count_valid = 0;
+    reg [2:0] legacy_write_bytes;
+    integer count_lanes;
+    integer count_reads = 0;
+    integer count_writes = 0;
+    integer count_crossings = 0;
+
+    always @(posedge clk) begin
+        if (count_valid && (dut.nfifo !== legacy_bus_count ||
+            dut.nfifo_group_ahead !== (legacy_bus_count[12:3] + 10'd1)))
+            $fatal(1, "MMC bus byte count or prepared group differs at clock %0d", cycles);
+
+        if (reset || dut.start) begin
+            count_valid = 1;
+            legacy_bus_count = 0;
+        end else if (count_valid) begin
+            if (rd && dut.fifo_rd && dut.rx_phase) begin
+                count_reads = count_reads + 1;
+                if ({1'b0,legacy_bus_count[2:0]} + {1'b0,dut.fifo_take} >= 4'd8)
+                    count_crossings = count_crossings + 1;
+                legacy_bus_count = legacy_bus_count + {10'd0,dut.fifo_take};
+            end
+            if (wr && dut.fifo_wr && dut.tx_phase) begin
+                legacy_write_bytes = 0;
+                for (count_lanes = 0; count_lanes < 4; count_lanes = count_lanes + 1)
+                    if (be[count_lanes] && {10'd0,legacy_write_bytes} < dut.rem)
+                        legacy_write_bytes = legacy_write_bytes + 3'd1;
+                count_writes = count_writes + 1;
+                if ({1'b0,legacy_bus_count[2:0]} + {1'b0,legacy_write_bytes} >= 4'd8)
+                    count_crossings = count_crossings + 1;
+                legacy_bus_count = legacy_bus_count + {10'd0,legacy_write_bytes};
+            end
+        end
+    end
diff --git a/scratch/v5-fit-loop/mmc-count-prepare/mixed.py b/scratch/v5-fit-loop/mmc-count-prepare/mixed.py
