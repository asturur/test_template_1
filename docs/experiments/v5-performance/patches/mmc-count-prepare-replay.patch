--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-count-prepare/mixed.py
@@ -0,0 +1,30 @@
+"""Stage the retained mixed board replay with only the candidate MMC host replaced."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shutil
+
+
+stage = Path(__file__).resolve().parent
+base = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+trial = Path('build/sim/v5-104-mmc-count-prepare-pin-mixed/mixed')
+trial.mkdir(parents=True)
+for name in ('source', 'build.sh', 'stress.hex', 'image.hex', 'program.hex'):
+    original = base / name
+    if original.is_dir():
+        shutil.copytree(original, trial / name)
+    else:
+        shutil.copyfile(original, trial / name)
+
+netlist = 'rtl/ngage_mmc_host.v'
+shutil.copyfile(stage / 'source' / netlist, trial / 'source' / netlist)
+hashes = json.loads((base / 'source-hashes.json').read_text())
+assert netlist in hashes
+for name, reference in hashes.items():
+    file = trial / 'source' / name
+    actual = sha256((file if file.is_file() else Path(name)).read_bytes()).hexdigest()
+    assert (actual != reference) == (name == netlist), name
+    hashes[name] = actual
+(trial / 'source-hashes.json').write_text(json.dumps(hashes, indent=2) + '\n')
+build = trial / 'build.sh'
+build.write_text(build.read_text().replace(str(base), str(trial)))
diff --git a/scratch/v5-fit-loop/mmc-count-prepare/prepare-host-tests.py b/scratch/v5-fit-loop/mmc-count-prepare/prepare-host-tests.py
