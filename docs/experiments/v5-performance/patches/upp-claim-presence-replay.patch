+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/upp-claim-presence
+out=build/sim/v5-104-upp-claim-presence
+python3 -B "$area/prepare-lane.py"
+docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD:/work" -w /work --entrypoint sh jotego/simulator:arm64 -ec '
+    area=scratch/v5-fit-loop/upp-claim-presence
+    out=build/sim/v5-104-upp-claim-presence
+    for keypad in 0 1; do
+        for leg in reference source; do
+            rtl="$area/$leg/rtl"
+            name="$out/lane/$leg-$keypad"
+            iverilog -g2012 -s tb -Ptb.KEYPAD_ENABLE="$keypad" -y "$rtl" -I "$rtl" \
+                -o "$name" "$rtl/ngage_upp.v" "$rtl/ngage_upp_euart.v" "$out/lane/tb.sv"
+            vvp "$name" > "$name.log"
+            grep -E "^(TRACE|SAMPLE|DONE|PASS) " "$name.log" > "$name.trace"
+            grep "^PASS " "$name.trace"
+        done
+        cmp "$out/lane/reference-$keypad.trace" "$out/lane/source-$keypad.trace"
+    done
+    mkdir -p "$out/reset"
+    for leg in reference source; do
+        source="$area/$leg"
+        rtl="$source/rtl"
+        name="$out/reset/$leg-ddr"
+        iverilog -g2012 -s tb -y "$rtl" -I "$rtl" -o "$name" "$rtl/ngage_upp.v" "$rtl/ngage_adsp.v" \
+            "$source/tests/phone/upp_ddr_ram/peripherals_tb.v" "$source/tests/phone/upp_ddr_ram/peer.v"
+        vvp "$name" > "$name.log"
+        grep "^PASS " "$name.log"
+        name="$out/reset/$leg-lcd-dma"
+        iverilog -g2012 -s transport_tb -y "$rtl" -I "$rtl" -o "$name" "$rtl/ngage_upp.v" "$rtl/ngage_adsp.v" \
+            "$source/tests/phone/dma_handover/transport_tb.v"
+        vvp "$name" > "$name.log"
+        grep "^PASS " "$name.log"
+    done
+    for endpoint in ddr lcd-dma; do
+        sed "s@$area/reference/@$area/source/@" "$out/reset/reference-$endpoint.log" > "$out/reset/reference-$endpoint.normalized"
+        cmp "$out/reset/reference-$endpoint.normalized" "$out/reset/source-$endpoint.log"
+    done'
diff --git a/scratch/v5-fit-loop/upp-claim-presence/prepare-lane.py b/scratch/v5-fit-loop/upp-claim-presence/prepare-lane.py
new file mode 100644
index 0000000..41b52c4
--- /dev/null
+++ b/scratch/v5-fit-loop/upp-claim-presence/prepare-lane.py
@@ -0,0 +1,43 @@
+"""Use the archived lane differential through the actual held UPP stage."""
+from pathlib import Path
+import re
+
+
+out = Path('build/sim/v5-104-upp-claim-presence/lane')
+out.mkdir(parents=True, exist_ok=True)
+archive = Path('docs/experiments/v5-performance/patches/peripheral-lane13.patch').read_text()
+added = archive.split('diff --git a/tests/phone/upp_lane13/tb.sv', 1)[1]
+added = added.split('\ndiff --git ', 1)[0].split('\n@@ ', 1)[1]
+bench = '\n'.join(line[1:] for line in added.splitlines() if line.startswith('+')) + '\n'
+bench, count = re.subn(r'`ifndef REFERENCE\n.*?`endif\n', '', bench, flags=re.S)
+assert count == 4, count
+# Include the outer board's unclaimed-address error in the differential.
+original = 'invalid_response <= !invalid_response && packet && claim && ready && error;'
+assert bench.count(original) == 1
+bench = bench.replace(original, 'invalid_response <= !invalid_response && packet && (!claim || (ready && error));')
+anchor = "        access (0, 0, 'h0c150508, 0, 15, 'hffffffff, 'ha5b6c7df, 4);\n        cyc = 0;"
+assert bench.count(anchor) == 1
+bench = bench.replace(anchor, """
+        access (0, 0, 'h0c150508, 0, 15, 'hffffffff, 'ha5b6c7df, 4);
+        // Probe unclaimed and claimed-invalid responses independently.
+        access (0, 1, 'h0f000000, 0, 15, 0, 0, 0);
+        access (1, 1, 'h0c120a10, 3, 5, 0, 0, 4);
+        access (1, 0, 'h0c120a10, 3, 15, 0, 0, 3);
+
+        // Cancel on reset before the registered authorization edge. Also
+        // check immediately, between edges, after the already-valid reset.
+        offer(1, 'h0c150508, 'hbad0feed, 15);
+        tick;
+        #1;
+        reset = 1;
+        #1;
+        if (packet || ready || cpu_ack || cpu_error)
+            $fatal(1, "Reset did not immediately suppress the offered bus beat");
+        cyc = 0;
+        tick;
+        reset = 0;
+        if (pending) $fatal(1, "Canceled write became valid after reset");
+        access (0, 0, 'h0c150508, 0, 15, 'hffffffff, 'ha5b6c7df, 4);
+        cyc = 0;""")
+bench = bench.replace('PASS lane13 keypad=', 'PASS UPP claim/priority keypad=')
+(out / 'tb.sv').write_text(bench)
diff --git a/scratch/v5-fit-loop/upp-claim-presence/prepare-claim.py b/scratch/v5-fit-loop/upp-claim-presence/prepare-claim.py
new file mode 100644
index 0000000..d7c90c8
--- /dev/null
+++ b/scratch/v5-fit-loop/upp-claim-presence/prepare-claim.py
@@ -0,0 +1,59 @@
+"""Extract the exact claim selector and valid recurrence for four-state replay."""
+from pathlib import Path
+import re
+
+
+area = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-upp-claim-presence/claim')
+out.mkdir(parents=True, exist_ok=True)
+source = 'rtl/ngage_upp_peripherals.v'
+old, new = ((area / leg / source).read_text() for leg in ('reference', 'source'))
+
+
+def selection(text):
+    return text.split('    reg [15:0] selected_owner;', 1)[1].split('    wire [511:0] local_data', 1)[0]
+
+
+def valid_update(text):
+    pattern = r'            always @\(posedge clk\) begin\n                if \(rst \|\| !req\) valid <= 0;.*?(?=            assign response_pending = valid;)'
+    return re.search(pattern, text, re.S)[0]
+
+
+terms = re.findall(r'if \((.+)\) selected_owner\[(\d+)\] = 1;', selection(old))
+priority = [int(lane) for _, lane in terms]
+assert priority == [15, *range(15)]
+candidate_terms = re.search(r'wire \[15:0\] request_claims = \{([^}]+)\}', new)[1].split(',')
+assert {i: re.sub(r'\s+', '', term) for i, term in enumerate(reversed(candidate_terms))} == {
+    int(lane): re.sub(r'\s+', '', term) for term, lane in terms}
+assert [(int(raw), int(lane)) for raw, lane in re.findall(
+    r'if \(request_claims\[(\d+)\]\) selected_owner\[(\d+)\] = 1;', selection(new))] == [
+    (lane, lane) for lane in priority]
+assert 'reg [15:0] selected_owner;' not in selection(new)
+assert valid_update(old).replace('if (claim && local_ready && commit)',
+                                 'if (any_request_claim && local_ready && commit)') == valid_update(new)
+
+reference = selection(old)
+for predicate, lane in terms:
+    reference = reference.replace(f'if ({predicate}) selected_owner[{lane}]',
+                                  f'if (flags[{lane}]) selected_owner[{lane}]')
+trial = '    wire [15:0] request_claims = flags;\n    wire any_request_claim = |request_claims;\n' + selection(new)
+
+for leg, logic, text in (('reference', reference, old), ('trial', trial, new)):
+    (out / f'{leg}.v').write_text(f"""
+module {leg}_claim (
+    input wire clk, rst, req, local_ready, commit,
+    input wire [15:0] flags,
+    output reg [15:0] selected_owner,
+    output reg claim,
+    output wire response_pending, ready
+);
+    reg valid;
+    reg [15:0] result_owner;
+    always @(posedge clk)
+        if (!rst && req && !valid) result_owner <= selected_owner;
+{logic.replace('    wire [15:0] result_owner, result_bad;', '')}
+{valid_update(text)}
+    assign response_pending = valid;
+    assign ready = valid && req;
+endmodule
+""")
diff --git a/scratch/v5-fit-loop/upp-claim-presence/claim-miter.v b/scratch/v5-fit-loop/upp-claim-presence/claim-miter.v
new file mode 100644
index 0000000..9aef117
--- /dev/null
+++ b/scratch/v5-fit-loop/upp-claim-presence/claim-miter.v
@@ -0,0 +1,76 @@
+`timescale 1ns/1ps
+module tb;
+    reg clk = 0, rst = 1, req = 0, local_ready = 0, commit = 0;
+    reg [15:0] flags = 0;
+    wire [15:0] old_owner, new_owner;
+    wire old_claim, old_pending, old_ready, new_claim, new_pending, new_ready;
+    reference_claim reference_dut (
+        clk, rst, req, local_ready, commit, flags, old_owner, old_claim, old_pending, old_ready
+    );
+    trial_claim trial_dut (
+        clk, rst, req, local_ready, commit, flags, new_owner, new_claim, new_pending, new_ready
+    );
+    integer comparisons = 0;
+    integer vector, bit_index;
+    reg [31:0] prng = 32'hb536c091;
+
+    task compare;
+        begin
+            #1;
+            if ({old_owner, old_claim, old_pending, old_ready} !==
+                {new_owner, new_claim, new_pending, new_ready})
+                $fatal(1, "Claim or registered valid difference flags=%b req=%b reset=%b", flags, req, rst);
+            comparisons = comparisons + 1;
+        end
+    endtask
+
+    task clock_edge;
+        begin
+            compare;
+            clk = 1;
+            compare;
+            clk = 0;
+        end
+    endtask
+
+    task check_pattern;
+        begin
+            req = 0;
+            clock_edge;
+            req = 1;
+            compare;
+            clock_edge;
+            compare;
+        end
+    endtask
+
+    initial begin
+        clock_edge;
+        rst = 0;
+        local_ready = 1;
+        commit = 1;
+        for (vector = 0; vector < 65536; vector = vector + 1) begin
+            flags = vector[15:0];
+            check_pattern;
+        end
+        // A claim containing unknowns only must not become a positive claim.
+        // A definite lower-priority claimant still wins under unknowns above it.
+        for (vector = 0; vector < 65536; vector = vector + 1) begin
+            for (bit_index = 0; bit_index < 16; bit_index = bit_index + 1)
+                flags[bit_index] = vector[bit_index] ? 1'bx : 1'b0;
+            check_pattern;
+            flags[(vector ^ (vector >> 8)) & 15] = 1'b1;
+            check_pattern;
+        end
+        for (vector = 0; vector < 1024; vector = vector + 1) begin
+            prng = prng ^ (prng << 13);
+            prng = prng ^ (prng >> 17);
+            prng = prng ^ (prng << 5);
+            flags = prng[15:0];
+            {rst, req, local_ready, commit} = prng[20:17];
+            check_pattern;
+        end
+        $display("PASS exact claim selection and valid comparisons=%0d", comparisons);
+        $finish;
+    end
+endmodule
