diff --git a/scratch/v5-fit-loop/upp-claim-presence/prepare-hold.py b/scratch/v5-fit-loop/upp-claim-presence/prepare-hold.py
new file mode 100644
index 0000000..662513b
--- /dev/null
+++ b/scratch/v5-fit-loop/upp-claim-presence/prepare-hold.py
@@ -0,0 +1,29 @@
+"""Match both exact legs against the timer's measured PCM phase after CPU Hold."""
+from pathlib import Path
+
+
+build = Path('build/sim')
+base = build / 'v5-104-timer-write-prepare/mixed'
+candidate = build / 'v5-104-upp-claim-presence/mixed'
+out = candidate.parent / 'hold'
+out.mkdir(parents=True, exist_ok=True)
+bench = 'source/tests/phone/mmc_mister/tb.v'
+source = (base / bench).read_text()
+assert source == (candidate / bench).read_text()
+needle = "sample_hash !== 32'h175ee178"
+assert source.count(needle) == 1
+# The original no-hold pin fixture expects independently fixed PCM phase.
+# A verified compare of a warm hold uses the same baseline PCM witness.
+source = source.replace(needle, "sample_hash !== ($test$plusargs(\"hold\") ? 32'h015ec64f : 32'h175ee178)")
+patched = out / 'tb.v'
+patched.write_text(source)
+for label, leg in (('reference', base), ('trial', candidate)):
+    command = (leg / 'build.sh').read_text()
+    old_bench = str(leg / bench)
+    old_object = str(leg / 'obj')
+    old_log = str(leg / 'build.log')
+    assert all(command.count(text) == 1 for text in (old_bench, old_object, old_log))
+    command = command.replace(old_bench, str(patched))
+    command = command.replace(old_object, str(out / f'{label}-obj'))
+    command = command.replace(old_log, str(out / f'{label}-build.log'))
+    (out / f'{label}-build.sh').write_text(command)
