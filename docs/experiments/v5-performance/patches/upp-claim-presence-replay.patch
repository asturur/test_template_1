+"""Adapt archived flash reset stubs to the retained CPU wrapper's port list."""
+from pathlib import Path
+import re
+
+
+area = Path(__file__).resolve().parent
+source = area / 'reference'
+out = Path('build/sim/v5-104-upp-claim-presence/flash-reset').resolve()
+out.mkdir(parents=True, exist_ok=True)
+for name in ('tb.v', 'cold_tb.v', 'write_tb.v'):
+    bench = (source / 'tests/phone/flash_reset' / name).read_text()
+    assert bench.count('parameter LINE_REFILL=0') == 1
+    bench = bench.replace('parameter LINE_REFILL=0', 'parameter LINE_REFILL=0, EXPLICIT_LINE_GUARANTEE=0')
+    target = 'input wire line_wide,line_last,line_error,'
+    assert bench.count(target) == 1
+    bench = bench.replace(target, target + 'line_no_late_error,')
+    target = ' output wire wb_code,'
+    assert bench.count(target) == 1
+    bench = bench.replace(target, ' output wire wb_write_block, output wire [127:0] wb_block_data,\n' + target)
+    target = ' assign line_req=0;assign line_addr=0;'
+    assert bench.count(target) == 1
+    bench = bench.replace(target, target + '\n assign wb_write_block=0; assign wb_block_data=0;')
+    (out / name).write_text(bench)
+qip = (source / 'files.qip').read_text()
+files = [path for path in re.findall(r'-name (?:SYSTEMVERILOG_FILE|VERILOG_FILE) (rtl/ngage_\S+)', qip)
+         if path != 'rtl/ngage_cpu.sv']
+(out / 'common.f').write_text('\n'.join(files) + '\n')
