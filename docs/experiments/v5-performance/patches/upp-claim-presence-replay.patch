+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/upp-claim-presence
+out=build/sim/v5-104-upp-claim-presence/hold
+python3 -B "$area/prepare-hold.py"
+docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD:/work" -w /work --entrypoint sh jotego/simulator:arm64 -ec "
+    for leg in reference trial; do
+        sh '$out/'\$leg-build.sh
+        '$out/'\$leg-obj/Vtb +upp_stress +hold '+compare_trace=$out/'\$leg.trace > '$out/'\$leg.log
+        grep '^PASS ' '$out/'\$leg.log > '$out/'\$leg.pass
+    done"
+cmp "$out/reference.trace" "$out/trial.trace"
+cmp "$out/reference.pass" "$out/trial.pass"
+cat "$out/trial.pass"
+wc -l "$out/trial.trace"
diff --git a/scratch/v5-fit-loop/upp-claim-presence/routes.py b/scratch/v5-fit-loop/upp-claim-presence/routes.py
new file mode 100644
index 0000000..1fe3083
--- /dev/null
+++ b/scratch/v5-fit-loop/upp-claim-presence/routes.py
@@ -0,0 +1,111 @@
+"""Preserve sampled reset and registered-completion routes on exact fitted sources."""
+import csv
+import json
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+groups = {
+    'timer': {13: 45824513460, 43: 45824520116, 31337: 45824525843},
+    'a_only': {13: 45874467913, 43: 45874473714, 31337: 45874483394},
+    'joint_ram': {13: 45869671440, 43: 45869675764, 31337: 45869680539},
+    'retained': {13: 45771268571},
+}
+
+
+def reset_launch(row):
+    return '|reset_drain' in row['from']
+
+
+def peripheral(row):
+    return '|ngage_upp_peripherals:peripherals|' in row['to']
+
+
+def valid(row):
+    return '|registered_response.valid' in row['to']
+
+
+def summarize(rows):
+    return {'count': len(rows), 'below_minus_1p5_ns': sum(float(row['slack_ns']) < -1.5 for row in rows),
+            'worst': rows[0] if rows else None}
+
+
+def trace(report, row):
+    rank = int(row['rank'])
+    if rank not in report:
+        return {**row, 'class': 'outside detailed sample'}
+    chunk = report[rank]
+    cells = [line.split(';')[-2].strip().removesuffix('|combout')
+             for line in chunk.splitlines() if '|combout' in line and 'CELL' in line]
+    if any('selected_owner' in cell for cell in cells):
+        family = 'priority'
+    elif any(re.search(r'\|ready~', cell) for cell in cells):
+        family = 'readiness'
+    else:
+        family = 'other'
+    return {**row, 'class': family, 'cells': cells}
+
+
+results = {}
+for label, fits in groups.items():
+    rows_by_seed = {}
+    for seed, run in fits.items():
+        out = Path(f'build/timing-audit-{run}/output_files')
+        manifest = json.loads((out / 'resident-fit-manifest.json').read_bytes())
+        assert manifest['seed'] == seed and manifest['physical_cpu_mhz'] == 104 and not manifest['debugger']
+        corner_data = {}
+        for corner in sorted((out / 'timing/resident-store/104').glob('corner-*')):
+            with (corner / 'setup.csv').open() as handle:
+                rows = list(csv.DictReader(handle))
+            assert len(rows) == 1000
+            chunks = re.split(r'(?m)^Path #(\d+): Setup slack is ', (corner / 'setup.rpt').read_text(errors='replace'))
+            report = {int(rank): text for rank, text in zip(chunks[1::2], chunks[2::2], strict=True)}
+            reset_paths = [x for x in rows if reset_launch(x)]
+            peripheral_reset = [x for x in reset_paths if peripheral(x)]
+            response_valid = [x for x in rows if valid(x)]
+            corner_data[corner.name] = {
+                'condition': (corner / 'operating-condition.txt').read_text().splitlines()[1].split(': ', 1)[1],
+                'reset_launch': summarize(reset_paths), 'reset_to_peripheral': summarize(peripheral_reset),
+                'reset_to_valid': summarize([x for x in peripheral_reset if valid(x)]),
+                'reset_to_sdram_arbiter': summarize([x for x in reset_paths if '|ngage_sdram_arbiter:' in x['to']]),
+                'reset_to_dma_engine': summarize([x for x in reset_paths if '|ngage_dma_engine:' in x['to']]),
+                'registered_valid': summarize(response_valid),
+                'valid_paths': [trace(report, x) for x in response_valid],
+                'leading_reset_path': trace(report, reset_paths[0]) if reset_paths else None,
+            }
+        assert len(corner_data) == 4
+        rows_by_seed[str(seed)] = {'run': run, 'commit': manifest['actual_commit'], 'corners': corner_data}
+    results[label] = rows_by_seed
+
+timer = results['timer']
+for name, targets, worst in (
+    ('corner-1', (2, 1, 2), ('-1.513', '-1.668', '-1.867')),
+    ('corner-2', (2, 1, 2), ('-1.650', '-1.594', '-1.805')),
+):
+    for seed, count, slack in zip(('13', '43', '31337'), targets, worst, strict=True):
+        corner = timer[seed]['corners'][name]
+        assert corner['reset_to_peripheral']['count'] == 0
+        assert corner['registered_valid']['below_minus_1p5_ns'] == count
+        assert corner['registered_valid']['worst']['slack_ns'] == slack
+assert all(x['class'] == 'priority' for x in timer['31337']['corners']['corner-1']['valid_paths'])
+assert all(x['class'] == 'readiness' for x in timer['13']['corners']['corner-2']['valid_paths'])
+fast = timer['31337']['corners']['corner-3']
+assert fast['reset_to_peripheral']['count'] == 210
+assert fast['reset_to_peripheral']['worst']['slack_ns'] == '2.848'
+assert all(reset_launch(x) and x['class'] == 'priority' for x in fast['valid_paths'])
+assert timer['31337']['corners']['corner-4']['reset_to_peripheral']['count'] == 7
+
+a_only = results['a_only']
+peripheral_path = a_only['31337']['corners']['corner-1']['leading_reset_path']
+assert peripheral_path['slack_ns'] == '-3.204' and peripheral_path['class'] == 'priority'
+assert a_only['31337']['corners']['corner-1']['reset_to_peripheral']['below_minus_1p5_ns'] == 290
+block_path = a_only['13']['corners']['corner-1']['leading_reset_path']
+assert block_path['slack_ns'] == '-3.014' and block_path['to'].endswith('|mem_block_data[56]')
+assert any('line_mux|scalar_due' in cell for cell in block_path['cells'])
+dma_path = results['joint_ram']['13']['corners']['corner-1']['leading_reset_path']
+assert dma_path['slack_ns'] == '-3.080' and dma_path['to'].endswith('|done~DUPLICATE')
+assert any('phone_sdram|owner_ready' in cell for cell in dma_path['cells'])
+
+(stage / 'routes.json').write_text(json.dumps(results, indent=2) + '\n')
+print('PASS four-corner reset census and actual priority/readiness path families')
diff --git a/scratch/v5-fit-loop/upp-claim-presence/record.py b/scratch/v5-fit-loop/upp-claim-presence/record.py
new file mode 100644
index 0000000..5a1475a
--- /dev/null
+++ b/scratch/v5-fit-loop/upp-claim-presence/record.py
@@ -0,0 +1,142 @@
+"""Verify the UPP claim presence design, exact fixture source and replay results."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-upp-claim-presence')
+control = Path('build/sim/v5-104-timer-write-prepare')
+source = 'rtl/ngage_upp_peripherals.v'
+base = '9f16d1a5b5bd5b255eb8f0b1a131399b7dcfb56e'
+base_tree = '0ccd13d8cd502bc14d3b89c6431ff0ebe4745612'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def match(left, right):
+    assert left.read_bytes() == right.read_bytes(), (left, right)
+    return digest(left)
+
+
+def fingerprint(manifest, path):
+    [row] = [shlex.split(line) for line in manifest.read_text().splitlines()
+             if line.startswith('S ') and shlex.split(line)[-1].endswith(path)]
+    return row[-2]
+
+
+def passes(log):
+    return re.findall(r'^(?:SCRUB PASS|REFRESH PASS|PASS) .+$', log.read_text(), re.M)
+
+
+design = stage / 'upp-claim-presence.patch'
+replay = stage / 'upp-claim-presence-replay.patch'
+stats = subprocess.check_output(['git', 'apply', '--numstat', str(design)], text=True)
+assert [line.split('\t')[-1] for line in stats.splitlines()] == [source]
+candidate_tree = (stage / 'design-tree.sha').read_text().strip()
+assert re.fullmatch(r'[a-f0-9]{40}', candidate_tree)
+src_sha = digest(stage / 'source' / source)
+ref_sha = digest(stage / 'reference' / source)
+production = {}
+for seed, run in ((13, 45824513460), (43, 45824520116), (31337, 45824525843)):
+    report = load(Path(f'build/timing-audit-{run}/output_files/resident-fit-manifest.json'))
+    assert report['actual_commit'] == base and report['seed'] == seed
+    assert report['physical_cpu_mhz'] == 104 and report['debugger'] is False
+    assert len(report['compiled_source_sha256']) == 133 and report['compiled_source_sha256'][source] == ref_sha
+    production[seed] = run
+
+reference = control / 'mixed'
+mixed = out / 'mixed'
+manifest = load(mixed / 'source-hashes.json')
+ref_manifest = load(reference / 'source-hashes.json')
+assert len(manifest) == 114 and manifest.keys() == ref_manifest.keys()
+assert {path: sha for path, sha in manifest.items() if sha != ref_manifest[path]} == {source: src_sha}
+assert all(digest(mixed / 'source' / path) == sha for path, sha in manifest.items())
+compiled = fingerprint(mixed / 'obj/Vtb__verFiles.dat', source)
+assert fingerprint(out / 'hold/trial-obj/Vtb__verFiles.dat', source) == compiled
+assert fingerprint(out / 'hold/reference-obj/Vtb__verFiles.dat', source) != compiled
+
+physical = {}
+for mode, ref, trace, log, count, cycles, hash_qual in (
+    ('normal', reference / 'traffic.log', mixed / 'traffic.log', mixed / 'replay.log',
+     171496, 1201547, '175ee178'),
+    ('timer_mmc_lcd', control / 'coexistence/candidate.trace', out / 'coexistence/candidate.trace',
+     out / 'coexistence/candidate.log', 171497, 1201528, '175ee178'),
+    ('mmc_hps_warm_hold', out / 'hold/reference.trace', out / 'hold/trial.trace', out / 'hold/trial.log',
+     171518, 1203504, '015ec64f'),
+):
+    status = passes(log)
+    assert len(status) == 4 and any(f'PCM hash={hash_qual}' in line for line in status)
+    assert any(f'persisted512bytes+PIOreadback cycles={cycles}' in line for line in status)
+    assert len(trace.read_bytes().splitlines()) == count
+    physical[mode] = {'events': count, 'cycles': cycles, 'sha256': match(trace, ref), 'passes': status}
+assert match(out / 'coexistence/stress-timer.hex', control / 'coexistence/stress-timer.hex')
+exact_hold = match(out / 'hold/reference.pass', out / 'hold/trial.pass')
+
+claim_log = out / 'claim/miter.log'
+assert passes(claim_log) == ['PASS exact claim selection and valid comparisons=1185794']
+lanes = {}
+for keypad in (0, 1):
+    name = f'{keypad}.trace'
+    trace = out / f'lane/source-{name}'
+    [result] = passes(trace)
+    assert f'keypad={keypad} replies=311 samples=311' in result and 'overlap=11 nos=4' in result
+    lanes[keypad] = {'expected_result': result, 'trace_sha256': match(trace, out / f'lane/reference-{name}')}
+drains = {}
+for suffix, location in (('ddr', 'reset'), ('lcd-dma', 'reset'),
+                         ('tb', 'flash-reset'), ('cold_tb', 'flash-reset'), ('write_tb', 'flash-reset')):
+    controls = out / f'{location}/reference-{suffix}.log'
+    actual = out / f'{location}/source-{suffix}.log'
+    assert passes(actual) and passes(controls) == passes(actual)
+    if location == 'reset':
+        assert controls.read_text().replace(f'{stage.name}/reference/', f'{stage.name}/source/') == actual.read_text()
+    drains[suffix] = {'passes': passes(actual), 'log_sha256': digest(actual)}
+drain = out / 'sdram-drain/run.log'
+assert any('logical reset drain' in line for line in passes(drain))
+assert any('max_interval_clocks=758' in line for line in passes(drain))
+drains['physical_sdram'] = {'passes': passes(drain), 'log_sha256': digest(drain)}
+
+workloads = {}
+for kind, field, expected in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    data = load(receipt)
+    baseline = load(control / f'qualification/{kind}.json')
+    assert data['status'] == baseline['status'] == 'PASS' and data['rows'] == baseline['rows']
+    periph = Path(source).name
+    assert data['source_sha256'] == {**baseline['source_sha256'], periph: src_sha}
+    assert fingerprint(out / f'qualification/obj-{kind}/Vtb__verFiles.dat', source) == compiled
+    assert sum(len(row['candidate'][field]) for row in data['rows']) == expected
+    workloads[kind] = {'count': expected, 'receipt_sha256': digest(receipt)}
+    if kind == 'fixed':
+        cases = [row['candidate']['case'] for row in data['rows']]
+        assert len(set(cases)) == 15
+        for case in cases:
+            assert (out / f'qualification/{case}-00-1.log').is_file()
+            assert 'Guest output check rejected payload' in (out / f'qualification/{case}-00-0-wrong.log').read_text()
+        workloads[kind].update(repeats=15, rejected_wrong_outputs=15)
+    else:
+        native = data['rows'][0]['candidate']
+        clocks = [frame['clocks'] for frame in native['frames']]
+        assert clocks == [14391395, 14467552, 14346201, 14303223]
+        workloads[kind].update(frame_cycles=clocks, output_sha256=native['output_sha256'])
+
+summary = {'status': 'PASS', 'base': base, 'base_tree': base_tree, 'candidate_tree': candidate_tree,
+           'design_patch_sha256': digest(design), 'replay_patch_sha256': digest(replay),
+           'reference_sha256': ref_sha, 'source_sha256': src_sha,
+           'simulator': (out / 'image.id').read_text().strip(),
+           'exact_compiled_fingerprint': compiled, 'production_control_runs': production,
+           'routed_witness_sha256': digest(stage / 'routes.json'), 'candidate_routed': False,
+           'miter': {'comparisons': 1185794, 'sha256': digest(claim_log)},
+           'lanes': lanes, 'drains': drains, 'workloads': workloads, 'physical': physical,
+           'mmc_hps_hold_pass_sha256': exact_hold, 'physical_source_count': len(manifest)}
+(stage / 'qualification.json').write_text(json.dumps(summary, indent=2) + '\n')
+print('PASS claim/priority/valid, flash and board reset/drain, 105 fixed windows, four native frames and three physical replays')
