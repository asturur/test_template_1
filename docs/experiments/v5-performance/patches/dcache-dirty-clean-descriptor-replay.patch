@@ -0,0 +1,51 @@
+"""Insert a one-shot timer into the active physical MMC/LCD replay."""
+from pathlib import Path
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-dcache-dirty-clean-descriptor/coexistence')
+out.mkdir(parents=True, exist_ok=True)
+base = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+guest = (base / 'stress.S').read_text()
+marker = ' // Read/copy/partial-write round trips while LCD DMA and PCM are active.'
+assert guest.count(marker) == 1
+guest = guest.replace(marker, ''' // Timer4 must expire with both transfers still active.
+ mov r12,#83
+ ldr r0,=0x0c120a80
+ put r0,4,1
+ put r0,0x10,13
+timer4_wait:
+ ldr r4,[r0,#8]
+ tst r4,#1
+ beq timer4_wait
+ ldr r4,[r8,#0x18]
+ tst r4,#4
+ beq fail
+ ldr r1,=0x0c120348
+ ldr r4,[r1]
+ cmp r4,#0
+ beq fail
+ put r0,4,0
+ put r0,8,0
+ ldr r4,[r0,#8]
+ tst r4,#1
+ bne fail
+
+''' + marker)
+assembly = out / 'stress-timer.S'
+obj = assembly.with_suffix('.o')
+elf = assembly.with_suffix('.elf')
+binary = assembly.with_suffix('.bin')
+assembly.write_text(guest)
+for command in (
+    ['arm-none-eabi-gcc', '-c', '-mcpu=arm920t', '-marm', assembly, '-o', obj],
+    ['arm-none-eabi-ld', '-T', stage / 'source/sim/programs/link.ld', obj, '-o', elf],
+    ['arm-none-eabi-objcopy', '-O', 'binary', elf, binary],
+):
+    subprocess.run(command, check=True)
+raw = binary.read_bytes()
+assert len(raw) % 4 == 0 and len(raw) <= 8192
+assembly.with_suffix('.hex').write_text(''.join(
+    f'{int.from_bytes(raw[i:i+4], "little"):08x}\n' for i in range(0, len(raw), 4)
+))
