+++ b/scratch/v5-fit-loop/dcache-dirty-clean-descriptor/board.sh
@@ -0,0 +1,47 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/dcache-dirty-clean-descriptor
+out=build/sim/v5-104-dcache-dirty-clean-descriptor/board
+fixture=tests/cpu/arm9v2_board
+mkdir -p "$out"
+arm-none-eabi-gcc -c -mcpu=arm920t -marm -DEXPECTED_CTYPE=0x0514a14a -DASSOC_WAYS=2 \
+    -DSECTION_INDEX_TEST "$area/reference/$fixture/contract.S" -o "$out/guest.o"
+arm-none-eabi-ld -T "$area/reference/sim/programs/link.ld" "$out/guest.o" -o "$out/guest.elf"
+arm-none-eabi-objcopy -O binary "$out/guest.elf" "$out/guest.bin"
+python3 -B - "$out" <<'PY'
+from pathlib import Path
+import struct
+import sys
+
+out = Path(sys.argv[1])
+words = struct.iter_unpack('<I', (out / 'guest.bin').read_bytes())
+(out / 'guest.hex').write_text(''.join(f'{word:08x}\n' for (word,) in words))
+PY
+
+for leg in reference source; do
+    mkdir -p "$out/$leg"
+    docker run --rm --pull=never --network none --platform linux/arm64 \
+        -v "$PWD/$area/$leg:/work:ro" -v "$PWD/$out:/results" -w /work \
+        --entrypoint sh jotego/simulator:arm64 -ec '
+        out=/results/$1
+        verilator --binary --timing --assert -j 2 \
+            -Wno-fatal -Wno-lint -DNGAGE_ARM9V2 --top-module contract --Mdir "$out/obj" \
+            rtl/ngage_cpu.sv rtl/ngage_upp.v rtl/arm9v2/arm925t_phone.v \
+            rtl/arm9v2/upstream/sim/stubs/*.sv tests/cpu/arm9v2_board/contract.v > "$out/build.log" 2>&1
+        for burst in 0 1; do
+            for wait in 0 5; do
+                log="$out/burst-$burst-wait-$wait.log"
+                "$out/obj/Vcontract" +program=/results/guest.hex "+wait=$wait" "+burst=$burst" \
+                    +half-writeback +section-reads=2 > "$log" 2>&1
+                grep -E "^(PASS|LINES|ASSOC|SECTION|DATA_FAULT|REFILL_FAULT) " "$log" > "${log%.log}.trace"
+                grep -q "^PASS " "$log"
+            done
+        done' board "$leg"
+done
+for burst in 0 1; do
+    for wait in 0 5; do
+        name=burst-$burst-wait-$wait.trace
+        cmp "$out/reference/$name" "$out/source/$name"
+        grep '^PASS ' "$out/source/$name"
+    done
+done
