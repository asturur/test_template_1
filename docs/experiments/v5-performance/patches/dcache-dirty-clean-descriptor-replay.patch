+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/dcache-dirty-clean-descriptor
+out=build/sim/v5-104-dcache-dirty-clean-descriptor/cp15-phase
+fixture="$area/reference/tests/cpu/arm9v2_board"
+python3 -B "$area/prepare-cp15-phase.py"
+arm-none-eabi-gcc -c -I "$fixture" -mcpu=arm920t -marm -DEXPECTED_CTYPE=0x0514a14a -DASSOC_WAYS=2 \
+    -DSECTION_INDEX_TEST "$out/guest.S" -o "$out/guest.o"
+arm-none-eabi-ld -T "$area/reference/sim/programs/link.ld" "$out/guest.o" -o "$out/guest.elf"
+arm-none-eabi-objcopy -O binary "$out/guest.elf" "$out/guest.bin"
+python3 -B - "$out" <<'PY'
+from pathlib import Path
+import struct
+import sys
+
+out = Path(sys.argv[1])
+words = struct.iter_unpack('<I', (out / 'guest.bin').read_bytes())
+(out / 'guest.hex').write_text(''.join(f'{word:08x}\n' for (word,) in words))
+PY
+
+for leg in reference source; do
+    mkdir -p "$out/$leg"
+    docker run --rm --pull=never --network none --platform linux/arm64 \
+        -v "$PWD/$area/$leg:/work:ro" -v "$PWD/$out:/results" -w /work \
+        --entrypoint sh jotego/simulator:arm64 -ec '
+        out=/results/$1
+        verilator --binary --timing --assert -j 2 \
+            -Wno-fatal -Wno-lint -DNGAGE_ARM9V2 --top-module contract --Mdir "$out/obj" \
+            rtl/ngage_cpu.sv rtl/ngage_upp.v rtl/arm9v2/arm925t_phone.v \
+            rtl/arm9v2/upstream/sim/stubs/*.sv /results/contract.v > "$out/build.log" 2>&1
+        for burst in 0 1; do
+            for wait in 0 5; do
+                for mode in normal error; do
+                    set --
+                    if [ "$mode" = error ]; then set -- +maintenance-error; fi
+                    log="$out/burst-$burst-wait-$wait-$mode.log"
+                    "$out/obj/Vcontract" +program=/results/guest.hex "+wait=$wait" "+burst=$burst" \
+                        +half-writeback +section-reads=2 "$@" > "$log" 2>&1
+                    grep -E "^(PASS|LINES|ASSOC|SECTION|DATA_FAULT|REFILL_FAULT|CLEAN_[A-Z]+) " \
+                        "$log" > "${log%.log}.trace"
+                    grep -q "^PASS " "$log"
+                    grep -q "^CLEAN_PHASE PASS " "$log"
+                done
+            done
+        done' board "$leg"
+done
+for burst in 0 1; do
+    for wait in 0 5; do
+        for mode in normal error; do
+            name=burst-$burst-wait-$wait-$mode.trace
+            cmp "$out/reference/$name" "$out/source/$name"
+            grep -E '^(PASS|CLEAN_[A-Z]+) ' "$out/source/$name"
+        done
+    done
+done
diff --git a/scratch/v5-fit-loop/dcache-dirty-clean-descriptor/prepare-cp15-phase.py b/scratch/v5-fit-loop/dcache-dirty-clean-descriptor/prepare-cp15-phase.py
new file mode 100644
index 0000000..30352df
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-dirty-clean-descriptor/prepare-cp15-phase.py
@@ -0,0 +1,66 @@
+"""Add a repeated CP15 clean and one final-beat Wishbone error to the board deck."""
+from pathlib import Path
+
+
+area = Path(__file__).resolve().parent
+board = 'tests/cpu/arm9v2_board'
+out = Path('build/sim/v5-104-dcache-dirty-clean-descriptor/cp15-phase')
+out.mkdir(parents=True, exist_ok=True)
+
+
+def edit(text, before, after):
+    assert text.count(before) == 1, before
+    return text.replace(before, after)
+
+
+guest = (area / 'reference' / board / 'contract.S').read_text()
+# Clean the same line again before invalidation. The backing write is
+# counted below, so an already-clear line cannot emit another burst.
+guest = edit(guest, '    mcr p15,0,r8,c7,c10,1\n',
+             '    mcr p15,0,r8,c7,c10,1\n    mcr p15,0,r8,c7,c10,1\n')
+(out / 'guest.S').write_text(guest)
+
+bench = (area / 'reference' / board / 'contract.v').read_text()
+bench = edit(bench, '  wire slow_cyc, slow_stb, slow_idle, slow_ack, slow_error;',
+             '  wire route_ack, route_error;\n  wire slow_cyc, slow_stb, slow_idle, slow_ack, slow_error;')
+bench = edit(bench, '      .master_ack(ack),\n      .master_error(error),',
+             '      .master_ack(route_ack),\n      .master_error(route_error),')
+tag = 'cpu.u_arm925t.u_zap.l_generate_with_cache_mmu.u_data_cache.u_zap_cache_tag_ram'
+inject = f"""
+  integer clean_errors = 0, initial_clean_ends = 0, clean_stalls = 0;
+  wire inject_error = $test$plusargs("maintenance-error");
+  wire initial_clean_offer = cyc && stb && write && address == 32'h0a00000c &&
+      ({tag}.state_ff == 13'd32) && cti == 3'b111;
+  wire initial_clean_last = initial_clean_offer && route_ack && ram_ack &&
+      ram_saved_write && ram_index == 14'd3;
+  wire injected_clean_error = inject_error && initial_clean_last && clean_errors == 0;
+  assign ack = route_ack && !injected_clean_error;
+  assign error = route_error || injected_clean_error;
+  always @(posedge clk) if (!reset) begin
+    if (initial_clean_offer && !ack && !error) begin
+      if ({tag}.tag_ram_clean)
+        $fatal(1, "Stalled final beat completed dirty writeback");
+      clean_stalls <= clean_stalls + 1;
+    end
+    if (initial_clean_last) begin
+      // The production merger reports successful or errored Wishbone
+      // termination to the tag controller through its existing ACK input.
+      if (!{tag}.tag_ram_clean)
+        $fatal(1, "Final Wishbone termination did not complete dirty writeback");
+      if (injected_clean_error) clean_errors <= clean_errors + 1;
+      $display("CLEAN_END cycle=%0d address=%h error=%b", cycle, address, injected_clean_error);
+      initial_clean_ends <= initial_clean_ends + 1;
+    end
+    if (device_ack && device_write && device_address == 32'hf0000000) begin
+      if (clean_errors != int'(inject_error) || initial_clean_ends != 1 || clean_stalls == 0)
+        $fatal(1, "Expected one completed writeback, an observed stall and no repeat write");
+      $display("CLEAN_PHASE PASS errors=%0d completions=%0d stalled=%0d",
+               clean_errors, initial_clean_ends, clean_stalls);
+    end
+  end
+"""
+bench = edit(bench, '  assign ram_ack = ram_pending && ram_delay == 0;\n',
+             '  assign ram_ack = ram_pending && ram_delay == 0;\n' + inject)
+bench = edit(bench, '        if (ram_saved_write) begin\n',
+             '        if (ram_saved_write && !injected_clean_error) begin\n')
+(out / 'contract.v').write_text(bench)
diff --git a/scratch/v5-fit-loop/dcache-dirty-clean-descriptor/prepare-metadata-proof.py b/scratch/v5-fit-loop/dcache-dirty-clean-descriptor/prepare-metadata-proof.py
new file mode 100644
index 0000000..3bdd818
--- /dev/null
+++ b/scratch/v5-fit-loop/dcache-dirty-clean-descriptor/prepare-metadata-proof.py
@@ -0,0 +1,147 @@
+"""Build an exhaustive write-lane miter from the two exact tag modules."""
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-dcache-dirty-clean-descriptor/proof')
+out.mkdir(parents=True, exist_ok=True)
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+
+
+def tag(leg):
+    source = (stage / leg / rtl).read_text()
+    return re.search(r'^module ngage2_zap_dcache_half_tag_ram \(.*?^endmodule$', source, re.M | re.S)[0]
+
+
+def interval(source, first, after):
+    start = source.index(first)
+    return source[start:source.index(after, start)]
+
+
+reference = tag('reference')
+trial = tag('source')
+fsm = interval(reference, '\talways @(*) begin : blk1', '\tinitial _sv2v_0')
+assert fsm in trial
+defaults, arms = fsm.split('\t\tcase (state_ff)', 1)
+idle, other = arms.split("\t\t\t13'b0000010000000: begin", 1)
+legal, invalid = other.split('\t\t\tdefault: begin', 1)
+assert 'tag_ram_wr_en = 0;' in defaults
+assert re.findall(r'tag_ram_wr_en = ([^;]+);', idle) == ['i_cache_tag_wr_en', '0', '0', '0']
+assert 'tag_ram_wr_en =' not in legal
+assert "tag_ram_wr_en = 1'sbx;" in invalid
+exits = list(re.finditer(r'tag_ram_wr_en = 0;', idle))
+assert all('state_nxt =' in idle[match.end():exits[i + 1].start() if i + 1 < len(exits) else len(idle)]
+           for i, match in enumerate(exits))
+pending = interval(reference, '\talways @(posedge i_clk) begin\n\t\tif (i_reset)\n\t\t\tpend_en <=',
+                   '\tfunction automatic [DIRTY_GROUP_W - 1:0] sv2v_cast_3A332;')
+assert pending in trial and 'pend_en <= tag_ram_wr_en && !i_hold;' in pending
+
+inputs = """
+    input wire pend_en, tag_ram_clean, line_clear,
+    input wire [7:0] pend_addr,
+    input wire [1:0] pend_sel,
+    input wire pend_dirty,
+    input wire [1:0] pend_dirty_mask,
+    input wire [8:0] rd_flat_ff,
+    input wire [31:0] initialization,
+    output reg dirty_write_en, dirty_write_data,
+    output reg [7:0] dirty_write_set,
+    output reg [1:0] dirty_write_way, dirty_write_mask,
+    output wire [31:0] lane_we,
+    output wire [63:0] lane_mask
+);
+    localparam SET_W = 8, WAY_W = 1, WAYS = 2, DIRTY_BITS = 2;
+    localparam DIRTY_BIT_W = 4, DIRTY_GROUP_W = 4;
+    wire _sv2v_0 = 0;
+    wire [WAY_W - 1:0] rd_way = rd_flat_ff[8];
+"""
+names = ('sv2v_cast_19C97_signed', 'sv2v_cast_3A332')
+functions = [re.search(rf'^\s*function automatic [^\n]+ {name};.*?^\s*endfunction', reference,
+                       re.M | re.S)[0] + '\n' for name in names]
+for function in functions:
+    assert function.strip() in trial
+
+lines = ('wire [DIRTY_GROUP_W - 1:0] update_group =', 'wire write_bank = (dirty_write_en',
+         'wire [DIRTY_BITS - 1:0] write_mask = (dirty_write_set')
+update_group, write_bank, write_mask = (next(line.strip() for line in reference.splitlines()
+                                              if line.strip().startswith(name)) for name in lines)
+assert all(line in trial for line in (update_group, write_bank, write_mask))
+lanes = f"""
+    genvar w, bank;
+    generate
+        for (w = 0; w < WAYS; w = w + 1) begin : way
+            wire [15:0] dirty_initialized = initialization[w * 16+:16];
+            {update_group}
+            for (bank = 0; bank < 16; bank = bank + 1) begin : lane
+                localparam b = bank;
+                {write_bank}
+                {write_mask}
+                assign lane_we[w * 16 + bank] = write_bank;
+                assign lane_mask[(w * 16 + bank) * 2+:2] = write_mask;
+            end
+        end
+    endgenerate
+endmodule
+"""
+for name, module in (('retained', reference), ('trial', trial)):
+    descriptor = interval(module, '\t\tdirty_write_en =', '\t\tdirty_read_group =')
+    text = f'module {name}_descriptor (\n' + inputs + ''.join(functions)
+    text += '    always @(*) begin\n' + descriptor + '    end\n' + lanes
+    (out / f'{name}.v').write_text(text)
+
+bench = """
+module tb;
+    reg pend_en, tag_ram_clean, line_clear, pend_dirty;
+    reg [7:0] pend_addr;
+    reg [1:0] pend_sel, pend_dirty_mask;
+    reg [8:0] rd_flat_ff;
+    reg [31:0] initialization;
+    wire old_en, new_en, old_dirty, new_dirty;
+    wire [7:0] old_set, new_set;
+    wire [1:0] old_way, new_way, old_mask, new_mask;
+    wire [31:0] old_we, new_we;
+    wire [63:0] old_lanes, new_lanes;
+    integer checks = 0, index, way, store, mode, init_bits, lane;
+    retained_descriptor reference (
+        pend_en, tag_ram_clean, line_clear, pend_addr, pend_sel, pend_dirty,
+        pend_dirty_mask, rd_flat_ff, initialization, old_en, old_dirty,
+        old_set, old_way, old_mask, old_we, old_lanes
+    );
+    trial_descriptor trial (
+        pend_en, tag_ram_clean, line_clear, pend_addr, pend_sel, pend_dirty,
+        pend_dirty_mask, rd_flat_ff, initialization, new_en, new_dirty,
+        new_set, new_way, new_mask, new_we, new_lanes
+    );
+    initial begin
+        for (mode = 0; mode < 5; mode = mode + 1) begin
+            pend_en = mode == 1;
+            tag_ram_clean = mode == 2 || mode == 4;
+            line_clear = mode == 3 || mode == 4;
+            for (index = 0; index < 256; index = index + 1)
+                for (way = 0; way < 4; way = way + 1)
+                    for (store = 0; store < 8; store = store + 1)
+                        for (init_bits = 0; init_bits < 4; init_bits = init_bits + 1) begin
+                            pend_addr = 3 * index + 5;
+                            rd_flat_ff = {way[0], index[7:0]};
+                            pend_sel = way[1:0];
+                            {pend_dirty, pend_dirty_mask} = store[2:0];
+                            initialization = {{16{init_bits[1]}}, {16{init_bits[0]}}};
+                            #1;
+                            if (old_en !== new_en || old_we !== new_we)
+                                $fatal(1, "Dirty write enable differed");
+                            if (old_en && {old_set, old_way, old_dirty, old_mask} !==
+                                          {new_set, new_way, new_dirty, new_mask})
+                                $fatal(1, "Active dirty descriptor differed");
+                            for (lane = 0; lane < 32; lane = lane + 1)
+                                if (old_we[lane] && old_lanes[lane * 2+:2] !== new_lanes[lane * 2+:2])
+                                    $fatal(1, "Enabled RAM lane data differed");
+                            checks = checks + 1;
+                        end
+        end
+        $display("PASS dirty metadata lane comparisons=%0d", checks);
+        $finish;
+    end
+endmodule
+"""
+(out / 'tb.v').write_text(bench)
diff --git a/scratch/v5-fit-loop/dcache-dirty-clean-descriptor/replay.py b/scratch/v5-fit-loop/dcache-dirty-clean-descriptor/replay.py
