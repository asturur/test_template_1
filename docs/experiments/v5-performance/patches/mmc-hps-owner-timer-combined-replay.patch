+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/mmc-hps-owner-timer-combined
+variant=${1:?supply the candidate variant}
+out=build/sim/v5-104-mmc-hps-owner-timer-combined/$variant/coexistence
+retained=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed
+candidate=build/sim/v5-104-mmc-hps-owner-timer-combined/$variant/mixed
+python3 -B "$area/prepare-coexistence.py" "$variant"
+for leg in retained candidate; do
+  if [ "$leg" = retained ]; then replay=$retained; else replay=$candidate; fi
+  docker run --rm --pull=never --network none --platform linux/arm64 -v "$PWD:/work" \
+    -v "$PWD/$out/stress-timer.hex:/work/$retained/stress.hex:ro" -w /work \
+    --entrypoint "/work/$replay/obj/Vtb" jotego/simulator:arm64 \
+    +upp_stress "+compare_trace=$out/$leg.trace" > "$out/$leg.log"
+  grep '^PASS ' "$out/$leg.log" > "$out/$leg.pass"
+done
+cmp "$out/retained.trace" "$out/candidate.trace"
+cmp "$out/retained.pass" "$out/candidate.pass"
+wc -l "$out/candidate.trace"
+cat "$out/candidate.pass"
