+++ b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/replay.py
@@ -0,0 +1,185 @@
+"""Replay MMC footer CRC with prepared timer writes on retained 104 MHz."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import statistics
+import subprocess
+import sys
+
+parser = argparse.ArgumentParser()
+parser.add_argument('variant', choices=('owner-plus-timer', 'owner-plus-footer-timer'))
+parser.add_argument('kind', choices=('fixed', 'native'))
+parser.add_argument('--case', action='append')
+parser.add_argument('--workers', type=int, default=3)
+parser.add_argument('--output', default='replay')
+args = parser.parse_args()
+kind = args.kind
+area = Path(__file__).resolve().parent
+repo = area.parents[2]
+stage = area / args.variant
+work = repo / 'build/sim/v5-104-mmc-hps-owner-timer-combined' / args.variant / args.output
+work.mkdir(parents=True, exist_ok=True)
+baseline_name = 'v5-104-all-four-ram-candidate'
+fixed = repo / 'build/sim/payload-clocks' / baseline_name
+native = repo / 'build/sim/polycount' / baseline_name
+timing_baseline = repo / 'scratch/refill-issue-739d3bd'
+d_stage = stage / 'ngage_cpu.sv'
+candidate = stage / 'source/rtl/arm9v2/arm925t_phone.v'
+image = 'jotego/simulator:arm64'
+docker = ['docker', 'run', '--rm', '--pull=never', '--network', 'none', '--platform', 'linux/arm64',
+          '-v', f'{work}:/work', '-v', f'{repo}:/frozen:ro', '-w', '/work', '--entrypoint']
+sys.path.insert(0, str(stage / 'source/tests/cpu/arm9v2_board'))
+import payload_clocks
+payload_clocks.OUT = repo / "build/sim"
+from payload_clocks import qualified_inputs
+
+
+def frozen(path):
+    return '/frozen/' + str(path.relative_to(repo))
+
+
+def run(options, entrypoint, log):
+    with log.open('w') as handle:
+        return subprocess.run(docker + [entrypoint, image] + options, stdout=handle,
+                              stderr=subprocess.STDOUT, check=False).returncode
+
+
+def build():
+    compiled_netlist = work / f'{kind}-candidate-cpu.v'
+    compiled_netlist.write_bytes(candidate.read_bytes())
+    ref = fixed if kind == 'fixed' else native / 'i16'
+    bench = (ref / 'tb.v').read_text()
+    observer = (area / 'architectural_trace.vh').read_text() + (area / 'wb-write-trace.vh').read_text()
+    (work / f'{kind}.sv').write_text(bench.rsplit('endmodule', 1)[0] + observer + '\nendmodule\n')
+    command = next(line for line in (ref / 'mmc3-nos64/Vtb__verFiles.dat').read_text().splitlines()
+                   if line.startswith('C '))
+    options = shlex.split(command.removeprefix('C "').removesuffix('"'))
+    net_hits, wrapper_hits, bench_hits = 0, 0, 0
+    for i, option in enumerate(options):
+        if option == 'rtl/ngage_cpu.sv':
+            options[i] = frozen(d_stage)
+            wrapper_hits += 1
+        elif option in {'rtl/ngage_ddr_stream.v', 'rtl/ngage_upp.v', 'rtl/ngage_dma_channels.v', 'rtl/ngage_upp_peripherals.v', 'rtl/ngage_keypad.v', 'rtl/ngage_upp_euart.v', 'rtl/ngage_timers.v'}:
+            options[i] = frozen(stage / 'source' / option)
+        elif option.startswith('/work/') and option.endswith(('/arm925t_phone.v', '/arm925t-i16.v')):
+            options[i] = '/work/' + compiled_netlist.name
+            net_hits += 1
+        elif option.startswith('/work/') and option.endswith('/tb.v'):
+            options[i] = f'/work/{kind}.sv'
+            bench_hits += 1
+        elif option.startswith('/work/') and option.endswith(('.v', '.sv')):
+            options[i] = option.replace('/work/', '/frozen/', 1)
+        elif option.startswith('-Irtl/'):
+            options[i] = '-I' + frozen(timing_baseline / 'leg' / option[2:])
+        elif option.endswith(('.v', '.sv')):
+            source = timing_baseline / 'leg' / option
+            assert source.is_file(), source
+            options[i] = frozen(source)
+    assert net_hits == wrapper_hits == bench_hits == 1, (net_hits, wrapper_hits, bench_hits)
+    options[options.index('--Mdir') + 1] = f'obj-{kind}'
+    options.insert(options.index('--Mdir') + 2, frozen(stage / 'source/rtl/ngage_mmc_hps.v'))
+    options.insert(0, '-I'+frozen(timing_baseline / 'leg'))
+    options[options.index('-j') + 1] = '3'
+    log = work / f'build-{kind}.log'
+    assert run(options, 'verilator', log) == 0, log
+    compiled = (work / f'obj-{kind}/Vtb__verFiles.dat').read_text().splitlines()
+    assert any(line.startswith('S ') and line.endswith(f'/mmc-hps-owner-timer-combined/{args.variant}/source/rtl/ngage_ddr_stream.v\"') for line in compiled)
+    for changed in ('ngage_upp.v', 'ngage_dma_channels.v', 'ngage_upp_peripherals.v', 'ngage_keypad.v', 'ngage_upp_euart.v', 'ngage_timers.v', 'ngage_mmc_hps.v'):
+        assert any(line.startswith('S ') and line.endswith(f'/mmc-hps-owner-timer-combined/{args.variant}/source/rtl/{changed}"') for line in compiled), changed
+    for source in (f'{kind}.sv', compiled_netlist.name):
+        assert any(line.startswith('S ') and line.endswith(f'"/work/{source}"') for line in compiled), source
+    for cache in (work / f'obj-{kind}').glob('*.gch'):
+        cache.unlink()
+
+
+def scan(log, prefix, hex_fields=False):
+    rows = []
+    for line in log.read_text().splitlines():
+        if line.startswith(prefix):
+            pairs = re.findall(r'(\w+)=(-?[0-9a-f]+)', line)
+            rows.append({k: int(v, 16 if hex_fields and k.endswith('_hash') else 10) for k, v in pairs})
+    return rows
+
+
+def digest(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def execute(profile, case, attempt=0, wrong=False):
+    delay, thumb = profile
+    inputs = ['+ngage-compact-trace', '+no-board-log',
+              '+extension=' + frozen(repo / 'build/firmware/nem4-factory/extension.bin')]
+    suffix = f'{delay}{thumb}-{attempt}{"-wrong" if wrong else ""}'
+    if kind == 'fixed':
+        name = case['name']
+        inputs += ['+core=' + frozen(fixed / f'{name}-{wrong}.bin'), '+cdrive=' + frozen(fixed / 'cdrive.bin'),
+                   f'+begin_pc={case["begin"]:x}', f'+end_pc={case["end"]:x}',
+                   f'+payload_base={case["payload_base"]:x}', f'+helper_base={case["helper_base"]:x}']
+    else:
+        name = 'native'
+        result = work / f'native-{suffix}.bin'
+        inputs += ['+core=' + frozen(native / 'core.bin'), '+cdrive=' + frozen(native / 'cdrive.bin'),
+                   '+snapshot=' + frozen(native / 'snapshot.bin'), f'+results=/work/native-{suffix}',
+                   '+begin_pc=68', '+end_pc=6c', '+done_pc=80', '+fail_pc=84']
+    log = work / f'{name}-{suffix}.log'
+    code = run(inputs, f'/work/obj-{kind}/Vtb', log)
+    if wrong:
+        assert code != 0 and 'Guest output check rejected payload' in log.read_text(), log
+        return None
+    assert code == 0, log
+    architecture = scan(log, 'RES_ARCH ', hex_fields=True)
+    wb_writes = scan(log, 'RES_WB ', hex_fields=True)
+    assert len(wb_writes) == len(architecture)
+    if kind == 'fixed':
+        windows = scan(log, 'PAYLOAD_RESULT ')
+        assert len(architecture) == len(windows) == 7, log
+        assert len(scan(log, 'PAYLOAD_PASS ')) == 1
+        for actual, expect in zip(windows, case['windows'], strict=True):
+            assert actual['payload_ops'] == expect['payload_retire_proxy']
+            assert actual['helper_ops'] == expect['helper_retire_proxy']
+        return dict(profile=profile, case=name, windows=windows, architecture=architecture, wb_writes=wb_writes,
+                    median=statistics.median(x['cycles'] for x in windows[2:]))
+    frames = scan(log, 'POLY_FRAME ')
+    assert len(architecture) == len(frames) == 4, log
+    assert len(scan(log, 'PASS_POLYCOUNT ')) == 1
+    assert digest(result) == digest(native / 'i16/result.bin')
+    return dict(profile=profile, case=name, frames=frames, architecture=architecture, wb_writes=wb_writes,
+                output_sha256=digest(result), median=statistics.median(f['clocks'] for f in frames[1:]))
+
+
+def architectural_work(row):
+    return [{k:v for k,v in entry.items() if k != 'recover'} for entry in row['architecture']]
+
+control = json.loads((area.parent/'prepared-wb-write-data'/'candidate'/f'{kind}.json').read_text())
+assert control['status'] == 'PASS'
+assert control['ddr_stream_sha256'] == digest(stage/'source/rtl/ngage_ddr_stream.v')
+reference = {r['candidate']['case']:r['candidate'] for r in control['rows']}
+
+build()
+rows=[]
+with ThreadPoolExecutor(max_workers=args.workers) as pool:
+    cases = [None] if kind=='native' else [case for case in qualified_inputs()
+                                            if not args.case or case['name'] in args.case]
+    if kind=='fixed':
+        assert len(cases)==(len(args.case) if args.case else 15)
+        cases.sort(key=lambda r:r['name']!='sega-scan')
+    for case in cases:
+        primary = pool.submit(execute, (0,0), case)
+        repeat = pool.submit(execute, (0,0), case, attempt=1) if kind=='fixed' else None
+        wrong = pool.submit(execute,(0,0),case,wrong=True) if kind=='fixed' else None
+        trial=primary.result()
+        if repeat:
+            assert trial==repeat.result() and wrong.result() is None
+        name=trial['case']
+        expected = {**reference[name], 'profile': (0,0)}
+        assert trial == expected, (name, trial, expected)
+        rows.append(dict(candidate=trial, control=expected))
+        print(name, trial['median'], flush=True)
+(work/f'{kind}.json').write_text(json.dumps(dict(status='PASS', netlist_sha256=digest(candidate),
+                                                wrapper_sha256=digest(d_stage), ddr_stream_sha256=digest(stage / 'source/rtl/ngage_ddr_stream.v'),
+                                                dma_channels_sha256=digest(stage / 'source/rtl/ngage_dma_channels.v'),
+                                                source_sha256={name:digest(stage / 'source/rtl' / name) for name in ('ngage_upp.v','ngage_upp_peripherals.v','ngage_upp_euart.v', 'ngage_timers.v','ngage_keypad.v','ngage_mmc_hps.v')}, rows=rows),indent=2)+'\n')
diff --git a/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/timer-directed.sv b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/timer-directed.sv
new file mode 100644
index 0000000..f87ab96
--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/timer-directed.sv
@@ -0,0 +1,271 @@
+`timescale 1ns / 1ps
+module tb;
+    localparam KEYPAD_ENABLE = 0;
+    reg clk = 0;
+    always #4.807692 clk = ~clk;
+    reg reset = 1, cold_reset = 1, offered = 0, live = 0, we = 0, allow = 0;
+    wire packet_live = live;
+    wire tx_ready = 1, rx_valid = 0, card_busy = 0, cfg_keypad = 0;
+    wire [7:0] rx_data = 0;
+    wire [25:0] keys = 0;
+    reg [31:0] address = 0, data = 0;
+    reg [3:0] sel = 0;
+    wire packet, wr;
+    wire [31:0] addr, wdata, rdata;
+    wire [3:0] lanes;
+    wire claim, ready, error, init_done, pending, irq, fiq, tx_valid, rx_ready;
+    wire [7:0] tx_data;
+    wire [5:0] count_select, stop_select;
+    wire commit = packet && !reset && init_done && !pending && allow;
+    wire [31:0] count[0:5], reload[0:5];
+    wire [5:0] running, status, interrupt, expiry, writing, stopping;
+    wire timer_ce = dut.timers.timer_ce;
+    integer clocks = 0, samples = 0, decode_cases = 0;
+    integer idx, word, lane, alias_bits, direction, i;
+    localparam [31:0] BASE = 32'h0c120a00;
+    localparam [31:0] TIMER4 = BASE + 128;
+
+    // Fixture wiring
+
+    genvar unit_index;
+    generate
+        for (unit_index = 0; unit_index < 6; unit_index = unit_index + 1) begin : observed
+            assign count[unit_index] = dut.timers.g_timer[unit_index].count;
+            assign reload[unit_index] = dut.timers.g_timer[unit_index].reload;
+            assign running[unit_index] = dut.timers.g_timer[unit_index].running;
+            assign status[unit_index] = dut.timers.g_timer[unit_index].status;
+            assign interrupt[unit_index] = dut.timers.g_timer[unit_index].pending;
+            assign expiry[unit_index] = dut.timers.g_timer[unit_index].expiry;
+            assign writing[unit_index] = dut.timers.g_timer[unit_index].count_write;
+            assign stopping[unit_index] = dut.timers.g_timer[unit_index].stopping;
+        end
+    endgenerate
+
+    always @(posedge clk) begin
+        clocks <= clocks + 1;
+        if (!reset && init_done) begin
+            // Check each actual count/stop enable against the retained live
+            // predicate, including invalid lanes, unaligned aliases and wait.
+            for (i = 0; i < 6; i = i + 1) begin
+                if (writing[i] !== (commit && wr && lanes == 15 &&
+                      {addr[31:2], 2'b00} == BASE + 32*i + 16))
+                    $fatal(1, "Count write qualifier differed at %h unit %0d", addr, i);
+                if (stopping[i] !== (commit && wr && lanes == 15 && wdata[1:0] == 0 &&
+                      {addr[31:2], 2'b00} == BASE + 32*i + 4))
+                    $fatal(1, "Stop qualifier differed at %h unit %0d", addr, i);
+            end
+            if (commit && claim && dut.local_ready)
+                samples <= samples + 1;
+            if (packet || |expiry)
+                $display("TRACE %0d %b%b%b%b%b %h %h %h %h %h %h %h %h %h %h",
+                         clocks, commit, claim, ready, error, pending, addr,
+                         writing, stopping, expiry, status, interrupt, running,
+                         count[4], reload[4], pending && packet ? rdata : 32'b0);
+        end
+        if (clocks > 45000) $fatal(1, "Timer packet test timed out");
+    end
+
+    task tick;
+        @(negedge clk);
+    endtask
+
+    task offer;
+        input [31:0] target, value;
+        input [3:0] lanes_in;
+        input write_op;
+        begin
+            offered = 1;
+            live = 1;
+            allow = 0;
+            we = write_op;
+            address = target;
+            data = value;
+            sel = lanes_in;
+            tick;
+            offered = 0;
+            // The offered payload is unrelated to the held transaction now.
+            address = 32'h0c120a10;
+            data = ~value;
+            we = !write_op;
+            sel = ~lanes_in;
+            if (!packet || addr !== target || wdata !== value || lanes !== lanes_in || wr !== write_op)
+                $fatal(1, "Packet did not hold its captured fields");
+        end
+    endtask
+
+    task retire;
+        begin
+            allow = 0;
+            live = 0;
+            tick;
+            if (pending || packet) $fatal(1, "Retired request remained pending");
+        end
+    endtask
+
+    task grant;
+        input expected_error;
+        begin
+            allow = 1;
+            tick;
+            if (!claim || !pending || !ready || error !== expected_error)
+                $fatal(1, "Wrong response phase for %h, err=%b", addr, error);
+        end
+    endtask
+
+    task write4;
+        input [4:0] word_offset;
+        input [31:0] value;
+        begin
+            offer(TIMER4 + word_offset, value, 4'hf, 1);
+            grant(0);
+            retire;
+        end
+    endtask
+
+    task read_status;
+        input [31:0] expected;
+        integer waits;
+        begin
+            offer(TIMER4 + 8, 0, 4'hf, 0);
+            allow = 1;
+            waits = 0;
+            while (!ready && waits < 3) begin
+                tick;
+                waits = waits + 1;
+            end
+            if (!ready || error || rdata !== expected)
+                $fatal(1, "Status response %h expected %h", rdata, expected);
+            retire;
+        end
+    endtask
+
+    task wait_expiry_edge;
+        begin
+            while (!(count[4] == 1 && running[4] && timer_ce)) tick;
+        end
+    endtask
+
+    initial begin
+        repeat (3) tick;
+        cold_reset = 0;
+        wait (init_done);
+        tick;
+        reset = 0;
+
+        // Check the real held decode on every six-timer word, both directions,
+        // all 16 masks and each low-address alias. The extra units miss.
+        for (idx = 0; idx < 8; idx = idx + 1)
+            for (word = 0; word < 8; word = word + 1)
+                for (lane = 0; lane < 16; lane = lane + 1)
+                    for (direction = 0; direction < 2; direction = direction + 1)
+                        for (alias_bits = 0; alias_bits < 4; alias_bits = alias_bits + 1) begin
+                            offer(BASE + 32*idx + 4*word + alias_bits, alias_bits[0], lane[3:0], direction[0]);
+                            allow = 1;
+                            #1;
+                            if (dut.timer_claim !== (idx < 6) ||
+                                dut.timer_bad !== (idx < 6 && lane != 15))
+                                $fatal(1, "Timer ownership changed for %h mask %h", addr, lanes);
+                            tick;
+                            decode_cases = decode_cases + 1;
+                            retire;
+                        end
+        reset = 1;
+        tick;
+        reset = 0;
+        write4(16, 99);
+        repeat (5) tick;
+        if (count[4] != 99 || running[4]) $fatal(1, "Disabled timer counted");
+
+        // A new count replaces coincident expiry and clears passive status.
+        write4(8, 32'hface0001);
+        read_status(32'hface0001);
+        write4(4, 1);
+        write4(16, 8);
+        offer(TIMER4 + 16, 4, 4'hf, 1);
+        wait_expiry_edge;
+        grant(0);
+        if (count[4] != 4 || status[4] || interrupt[4])
+            $fatal(1, "Count write did not cancel expiry");
+        retire;
+        read_status(0);
+        wait_expiry_edge;
+        tick;
+        if (!status[4] || !interrupt[4] || running[4]) $fatal(1, "One-shot expiry missing");
+        write4(16, 8);
+        if (status[4] || !interrupt[4] || !running[4]) $fatal(1, "Count rearm acknowledged older IRQ");
+
+        // Stop suppresses expiry without acknowledging the old interrupt.
+        offer(TIMER4 + 4, 32'hffff0000, 4'hf, 1);
+        wait_expiry_edge;
+        grant(0);
+        if (count[4] != 1 || status[4] || !interrupt[4] || running[4])
+            $fatal(1, "Stop priority or count retention changed");
+        retire;
+        write4(8, 0);
+        if (interrupt[4]) $fatal(1, "Explicit ACK lost");
+
+        // Acknowledgement loses to a new expiry, including upper status bits.
+        write4(16, 8);
+        write4(4, 1);
+        offer(TIMER4 + 8, 32'hface0000, 4'hf, 1);
+        wait_expiry_edge;
+        grant(0);
+        if (!status[4] || !interrupt[4] || count[4] != 0) $fatal(1, "Expiry lost to ACK");
+        retire;
+        read_status(1);
+
+        // Periodic expiry uses the old reload on a coincident reload write.
+        write4(24, 17);
+        write4(16, 8);
+        write4(4, 2);
+        offer(TIMER4 + 24, 27, 4'hf, 1);
+        wait_expiry_edge;
+        grant(0);
+        if (count[4] != 17 || reload[4] != 27 || !status[4])
+            $fatal(1, "Reload and expiry ordering changed");
+        retire;
+
+        // Invalid mask and live cancellation both leave the old deadline.
+        write4(16, 8);
+        offer(TIMER4 + 16, 44, 4'h3, 1);
+        wait_expiry_edge;
+        grant(1);
+        if (count[4] != 27 || !status[4]) $fatal(1, "Bad count write suppressed expiry");
+        retire;
+        write4(16, 8);
+        offer(TIMER4 + 4, 0, 4'hf, 1);
+        wait_expiry_edge;
+        retire;
+        if (count[4] != 27 || !status[4] || !running[4]) $fatal(1, "Cancelled stop changed timer");
+
+        // Hold response over several clocks, so the programmed count may
+        // advance instead of getting written again on each held request.
+        offer(TIMER4 + 16, 20, 4'hf, 1);
+        grant(0);
+        repeat (8) tick;
+        if (count[4] != 18 || !pending) $fatal(1, "Held count write repeated");
+        retire;
+        write4(4, 0);
+        write4(16, 0);
+        write4(4, 1);
+        if (count[4] == 0) begin
+            while (!timer_ce) tick;
+            tick;
+        end
+        if (count[4] != 32'hffffffff) $fatal(1, "Zero counter did not wrap");
+
+        offer(TIMER4 + 16, 44, 4'hf, 1);
+        reset = 1;
+        allow = 1;
+        tick;
+        if (count[4] != 0 || status[4] || interrupt[4] || packet || pending)
+            $fatal(1, "Reset did not retire prepared write and clear timer");
+        allow = 0;
+        live = 0;
+        reset = 0;
+        repeat (5) tick;
+        if (count[4] != 0 || running[4]) $fatal(1, "Reset replayed a timer write");
+        $display("PASS timer held packet decode=%0d responses=%0d clocks=%0d", decode_cases, samples, clocks);
+        $finish;
+    end
+endmodule
diff --git a/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/owner-phase.vh b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/owner-phase.vh
new file mode 100644
index 0000000..917f42e
--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/owner-phase.vh
@@ -0,0 +1,144 @@
+  integer phase_context, event_mask, host_bits, random_edge, reserved_state;
+  integer event_cases = 0, wrapped_events = 0, recovery_cases = 0;
+  reg [31:0] random_word = 32'h9ea10b42;
+  reg used_wrap;
+
+  function [31:0] next_word;
+    input [31:0] word;
+    reg [31:0] value;
+    begin
+      value = word ^ (word << 13);
+      value = value ^ (value >> 17);
+      next_word = value ^ (value << 5);
+    end
+  endfunction
+
+  task drain_owner;
+    begin
+      @(negedge clk);
+      init_reset = 1;
+      guest_reset = 0;
+      mount = 0;
+      rd = 0;
+      wr = 0;
+      h_we = 0;
+      h_ack = dut.state == 1;
+      tick;
+      @(negedge clk);
+      h_ack = 0;
+      repeat (8) tick;
+      if (dut.state != 0) fail("phase fixture could not drain");
+      @(negedge clk);
+      init_reset = 0;
+      ro = 0;
+      repeat (5) tick;
+    end
+  endtask
+
+  task prime_owner;
+    input integer target;
+    input write_owner;
+    begin
+      drain_owner;
+      if (write_owner) begin
+        admission(2048, 0);
+        if (target == 1) offer_write(0);
+        else begin
+          begin_write(0);
+          write_progress(1);
+        end
+      end else begin
+        make_footer(0);
+        do_mount(2048);
+        wait_mount;
+        begin_read(3, 0);
+        if (target != 1) begin
+          accept_read;
+          if (target == 4) begin
+            for (n = 0; n < 256; n = n + 1) beat(n, {footer[2*n+1], footer[2*n]});
+          end else beat(0, {footer[1], footer[0]});
+        end
+      end
+      if (target >= 3) begin
+        @(negedge clk);
+        h_ack = 0;
+        tick;
+        if (target == 4) repeat (4) tick;
+        else if (random_word[0]) repeat (3) tick;
+      end
+      if (dut.state != target || dut.cancelled || dut.owned_write != write_owner)
+        fail("phase fixture did not reach an uncancelled owner");
+    end
+  endtask
+
+  task test_owner_events;
+    begin
+      owner_phase = 1;
+      // All reset/mount combinations, with and without selected ACK,
+      // shared-bus ingress, and valid/invalid address progress.
+      for (phase_context = 0; phase_context < 7; phase_context = phase_context + 1) begin
+        for (event_mask = 0; event_mask < 8; event_mask = event_mask + 1) begin
+          for (host_bits = 0; host_bits < 8; host_bits = host_bits + 1) begin
+            prime_owner(phase_context == 6 ? 4 : 1 + phase_context % 3,
+                phase_context >= 3 && phase_context < 6);
+            @(negedge clk);
+            used_wrap = event_mask != 0 && host_bits == 3;
+            if (used_wrap) begin
+              dut.generation = 32'hffffffff;
+              dut.request_generation = 32'hffffffff;
+            end
+            {mount, guest_reset, init_reset} = event_mask[2:0];
+            {h_we, h_ack} = host_bits[1:0];
+            h_addr = dut.received_words + dut.owned_write + (host_bits[2] ? 2 : 0);
+            random_word = next_word(random_word);
+            h_data = random_word[15:0];
+            size = random_word[0] ? 64'd4096 : 64'd1025;
+            ro = random_word[1];
+            tick;
+            if (used_wrap) begin
+              if (dut.generation !== 32'd0 || dut.request_generation !== 32'hffffffff ||
+                  !dut.cancelled) fail("wrap fixture did not cancel the old owner");
+              wrapped_events = wrapped_events + 1;
+            end
+            event_cases = event_cases + 1;
+            for (random_edge = 0; random_edge < 16; random_edge = random_edge + 1) begin
+              @(negedge clk);
+              random_word = next_word(random_word);
+              {init_reset, guest_reset, mount, h_ack, h_we, rd, wr, ro} = random_word[7:0];
+              h_addr = random_word[20:8];
+              h_data = random_word[31:16];
+              lba = {29'd0, random_word[10:8]};
+              count = {3'd0, random_word[13:11]};
+              tick;
+            end
+          end
+        end
+      end
+
+      // Exercise invalid encodings separately from the reachable-state
+      // induction, with deliberately unequal retained generation registers.
+      for (reserved_state = 5; reserved_state <= 7; reserved_state = reserved_state + 1) begin
+        for (event_mask = 0; event_mask < 8; event_mask = event_mask + 1) begin
+          drain_owner;
+          @(negedge clk);
+          dut.state = reserved_state[2:0];
+          trial.state = reserved_state[2:0];
+          dut.cancelled = 0;
+          trial.cancelled = 0;
+          dut.generation = 32'h21;
+          dut.request_generation = 32'h20;
+          {mount, guest_reset, init_reset} = event_mask[2:0];
+          h_ack = 1;
+          h_we = 1;
+          tick;
+          if (dut.state != 0 || !fault) fail("reserved state did not recover to IDLE and fault");
+          recovery_cases = recovery_cases + 1;
+        end
+      end
+
+      drain_owner;
+      @(negedge clk);
+      $display("PASS owner miter cases=%0d wrap=%0d reserved=%0d random_edges=%0d compared=%0d",
+          event_cases, wrapped_events, recovery_cases, event_cases * 16, comparison_points);
+    end
+  endtask
diff --git a/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/architectural_trace.vh b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/architectural_trace.vh
new file mode 100644
index 0000000..88b6546
--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/architectural_trace.vh
@@ -0,0 +1,69 @@
+`define RESUPP dut.board.upp.cpu_inside
+`define RESZAP `RESUPP.cpu.u_arm925t.u_zap
+`define RESCORE `RESZAP.g_arm9.u_arm9_core
+`define RESFETCH `RESCORE.u_front_decode.u_fetch
+
+reg [31:0] res_begin, res_end;
+integer res_window = 0;
+integer res_retired, res_data, res_mmio, res_recover;
+reg res_active = 0;
+reg [63:0] res_retire_hash, res_data_hash, res_mmio_hash;
+localparam [63:0] RES_INITIAL = 64'hcbf29ce484222325;
+initial begin
+    if (!$value$plusargs("begin_pc=%h", res_begin) || !$value$plusargs("end_pc=%h", res_end))
+        $fatal(1, "Missing architectural digest window");
+end
+
+function automatic [63:0] res_mix(input [63:0] digest, input [63:0] data);
+    res_mix = (digest ^ data) * 64'h00000100000001b3;
+endfunction
+
+always @(posedge clk) if (!reset) begin
+    if (retire && retire_pc == res_begin) begin
+        res_active = 1;
+        res_retired = 0;
+        res_data = 0;
+        res_mmio = 0;
+        res_recover = 0;
+        res_retire_hash = RES_INITIAL;
+        res_data_hash = RES_INITIAL;
+        res_mmio_hash = RES_INITIAL;
+    end else if (retire && retire_pc == res_end && res_active) begin
+        $display("RES_ARCH window=%0d retired=%0d data=%0d mmio=%0d recover=%0d retire_hash=%016x data_hash=%016x mmio_hash=%016x",
+                 res_window, res_retired, res_data, res_mmio, res_recover,
+                 res_retire_hash, res_data_hash, res_mmio_hash);
+        res_window++;
+        res_active = 0;
+    end else if (res_active) begin
+        if (`RESCORE.wb_complete) begin
+            res_retired++;
+            res_retire_hash = res_mix(res_retire_hash, {`RESCORE.w[526:495], `RESCORE.w[494:463]});
+            res_retire_hash = res_mix(res_retire_hash, {25'b0, exceptions, `RESCORE.cpsr_next});
+            if (`RESCORE.wb_valid) begin
+                if (`RESCORE.wb_tag0 != 6'd16)
+                    res_retire_hash = res_mix(res_retire_hash, {26'b0, `RESCORE.wb_tag0, `RESCORE.wb_data0});
+                if (`RESCORE.wb_pair && `RESCORE.wb_tag1 != 6'd16)
+                    res_retire_hash = res_mix(res_retire_hash, {25'b0, 1'b1, `RESCORE.wb_tag1, `RESCORE.wb_data1});
+            end
+        end
+        if (`RESZAP.o_dbg_d_done) begin
+            res_data++;
+            res_data_hash = res_mix(res_data_hash, {26'b0, `RESZAP.data_err, `RESZAP.o_dbg_d_we,
+                                                   `RESZAP.o_dbg_d_sel, `RESZAP.o_dbg_d_va});
+            res_data_hash = res_mix(res_data_hash, {32'b0, `RESZAP.o_dbg_d_we ?
+                                                   `RESZAP.o_dbg_d_wdata : `RESZAP.o_dbg_d_rdata});
+        end
+        if (`RESUPP.master_cyc && `RESUPP.master_stb && !`RESUPP.master_code &&
+            (`RESUPP.slow_ack || `RESUPP.slow_error)) begin
+            res_mmio++;
+            res_mmio_hash = res_mix(res_mmio_hash, {26'b0, `RESUPP.slow_error, `RESUPP.master_we,
+                                                   `RESUPP.master_sel, `RESUPP.master_address});
+            res_mmio_hash = res_mix(res_mmio_hash, {32'b0, `RESUPP.master_we ?
+                                                   `RESUPP.master_data : `RESUPP.slow_read_data});
+        end
+    end
+end
+`undef RESFETCH
+`undef RESCORE
+`undef RESZAP
+`undef RESUPP
diff --git a/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/wb-write-trace.vh b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/wb-write-trace.vh
new file mode 100644
index 0000000..e4ee4c7
--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/wb-write-trace.vh
@@ -0,0 +1,98 @@
+`define WC dut.board.upp.cpu_inside.cpu
+`define WZ `WC.u_arm925t.u_zap
+`define WD `WZ.l_generate_with_cache_mmu.u_data_cache
+`define WM `WZ.l_merger_for_core_with_cache_mmu.u_zap_wb_merger
+wire obs_bus_on = `WM.o_wb_cyc && `WM.o_wb_stb;
+wire obs_write = obs_bus_on && `WM.o_wb_wen;
+wire obs_ack = obs_bus_on && `WM.i_wb_ack && !`WM.i_wb_err;
+wire obs_err = obs_bus_on && `WM.i_wb_err;
+wire obs_native = obs_write && `WC.wb_write_block;
+wire [3:0] obs_owner = `WM.o_dbg_data_owner ? `WD.state_ff : 4'b0;
+wire [7:0] obs_ctl = {`WM.o_wb_cti, `WM.o_wb_sel, obs_native};
+wire [31:0] obs_adr = `WM.o_wb_adr;
+wire [31:0] obs_data = `WM.o_wb_dat;
+wire [127:0] obs_block = obs_native ? `WC.wb_block_data : 128'b0;
+wire [199:0] obs_payload = {obs_adr, obs_ctl, obs_data, obs_block};
+wire [2:0] obs_source = {obs_native, `WD.u_zap_cache_fsm.state_ff[`WD.u_zap_cache_fsm.CLEAN_SINGLE], `WM.o_dbg_data_owner};
+
+integer wbt_window = 0;
+integer wbt_clock, wbt_writes, wbt_stalls, wbt_read_acks, wbt_write_acks, wbt_errors;
+integer wbt_read_to_write, wbt_write_next_changed, wbt_owner_changes;
+integer wbt_tag_changed, wbt_cch_changed, wbt_native_changed, wbt_post_changed, wbt_unc_changed;
+integer wbt_tag, wbt_cch, wbt_native, wbt_post, wbt_unc;
+reg wbt_active = 0;
+reg wbt_prev_read_ack, wbt_prev_write_ack, wbt_prev_stalled;
+reg [3:0] wbt_prev_owner;
+reg [199:0] wbt_prev_payload;
+reg [63:0] wbt_digest;
+
+always @(posedge clk) if (!reset) begin
+    if (retire && retire_pc == res_begin) begin
+        wbt_active = 1;
+        wbt_clock = 0;
+        wbt_writes = 0; wbt_stalls = 0; wbt_read_acks = 0; wbt_write_acks = 0; wbt_errors = 0;
+        wbt_read_to_write = 0; wbt_write_next_changed = 0; wbt_owner_changes = 0;
+        wbt_tag_changed = 0; wbt_cch_changed = 0; wbt_native_changed = 0;
+        wbt_post_changed = 0; wbt_unc_changed = 0;
+        wbt_tag = 0; wbt_cch = 0; wbt_native = 0; wbt_post = 0; wbt_unc = 0;
+        wbt_prev_read_ack = 0; wbt_prev_write_ack = 0; wbt_prev_stalled = 0;
+        wbt_prev_owner = 0; wbt_prev_payload = 0;
+        wbt_digest = RES_INITIAL;
+    end else if (retire && retire_pc == res_end && wbt_active) begin
+        $display("RES_WB window=%0d offer=%0d stall=%0d read_ack=%0d write_ack=%0d write_error=%0d read_to_write=%0d changed_after_write_ack=%0d owner_changes=%0d tag=%0d evict_scalar=%0d evict_native=%0d post=%0d unc=%0d tag_changed=%0d evict_scalar_changed=%0d evict_native_changed=%0d post_changed=%0d unc_changed=%0d write_hash=%016x",
+                 wbt_window,wbt_writes,wbt_stalls,wbt_read_acks,wbt_write_acks,wbt_errors,
+                 wbt_read_to_write,wbt_write_next_changed,wbt_owner_changes,
+                 wbt_tag,wbt_cch,wbt_native,wbt_post,wbt_unc,wbt_tag_changed,
+                 wbt_cch_changed,wbt_native_changed,wbt_post_changed,wbt_unc_changed,wbt_digest);
+        wbt_window++;
+        wbt_active = 0;
+    end else if (wbt_active) begin
+        wbt_clock++;
+        if (obs_ack && !obs_write) wbt_read_acks++;
+        if (wbt_prev_stalled && !obs_write) $fatal(1, "write withdrawn while stalled");
+        if (obs_write) begin
+            wbt_writes++;
+            if (wbt_prev_stalled && obs_payload !== wbt_prev_payload)
+                $fatal(1, "stalled write changed payload");
+            if (obs_ack) begin
+                wbt_write_acks++;
+                case (obs_owner)
+                    4'b0010: wbt_tag++;
+                    4'b1000: wbt_post++;
+                    4'b0001: if (obs_native) wbt_native++; else if (obs_source[1]) wbt_cch++; else wbt_unc++;
+                    default: $fatal(1, "unexpected write owner %b", obs_owner);
+                endcase
+            end else if (obs_err) wbt_errors++;
+            else wbt_stalls++;
+            if (wbt_prev_read_ack) wbt_read_to_write++;
+            if (wbt_prev_write_ack) begin
+                if (wbt_prev_owner != obs_owner) wbt_owner_changes++;
+                if (obs_payload[159:0] != wbt_prev_payload[159:0]) begin
+                    wbt_write_next_changed++;
+                    if (wbt_prev_owner == obs_owner)
+                        case (obs_owner)
+                            4'b0010: wbt_tag_changed++;
+                            4'b1000: wbt_post_changed++;
+                            4'b0001: if (obs_native) wbt_native_changed++; else if (obs_source[1]) wbt_cch_changed++; else wbt_unc_changed++;
+                            default: ;
+                        endcase
+                end
+            end
+            wbt_digest = res_mix(wbt_digest, {obs_adr, wbt_clock[21:0], obs_ctl, obs_ack, obs_err});
+            wbt_digest = res_mix(wbt_digest, {31'b0, `WC.wb_lock, obs_data});
+            if (obs_native) begin
+                wbt_digest = res_mix(wbt_digest, obs_block[63:0]);
+                wbt_digest = res_mix(wbt_digest, obs_block[127:64]);
+            end
+        end
+        wbt_prev_read_ack = obs_ack && !obs_write;
+        wbt_prev_write_ack = obs_ack && obs_write;
+        wbt_prev_stalled = obs_write && !obs_ack && !obs_err;
+        wbt_prev_owner = obs_owner;
+        wbt_prev_payload = obs_payload;
+    end
+end
+`undef WM
+`undef WD
+`undef WZ
+`undef WC
