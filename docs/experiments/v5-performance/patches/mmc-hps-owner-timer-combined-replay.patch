@@ -0,0 +1,98 @@
+#!/bin/sh
+set -eu
+variant=${1:?supply the candidate variant}
+phase=${2:-all}
+case "$variant" in
+  owner-plus-timer|owner-plus-footer-timer) ;;
+  *) exit 2 ;;
+esac
+area=scratch/v5-fit-loop/mmc-hps-owner-timer-combined
+stage=$area/$variant
+out=build/sim/v5-104-mmc-hps-owner-timer-combined/$variant
+image=jotego/simulator:arm64
+mkdir -p "$out"
+
+hps() {
+  mkdir -p "$out/units/source"
+  docker image inspect -f '{{.Id}} {{.Os}}/{{.Architecture}}' "$image" > "$out/image.id"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$stage/source:/bench:ro" -v "$PWD/$out/units:/results" -w /bench \
+    -e MMC_HPS_OUT=/results/source --entrypoint sh "$image" \
+    -ec 'iverilog -g2001 -s ngage_mmc_hps -o /results/source/elaborate rtl/ngage_mmc_hps.v
+         sh tests/phone/mmc_hps/run.sh' > "$out/units/source.log"
+  grep '^PASS ' "$out/units/source.log"
+}
+
+owner_miter() {
+  python3 -B "$area/prepare-owner-miter.py" "$variant"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$out/owner-miter:/work" -w /work --entrypoint sh "$image" -ec '
+    iverilog -g2001 -s tb -o miter tb.v retained.v trial.v
+    vvp miter > miter.log
+    grep "^PASS owner miter " miter.log'
+}
+
+crc() {
+  python3 -B "$area/prepare-verify.py" "$variant"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$stage:/bench:ro" -v "$PWD/$out/verify:/results" -w /results \
+    --entrypoint sh "$image" -ec '
+    for leg in reference source; do
+      iverilog -g2001 -s tb -o "$leg" "/bench/$leg/rtl/ngage_mmc_hps.v" tb.v
+      vvp "$leg" > "$leg.log"
+      grep -E "^(CRC_EDGE|PASS) " "$leg.log" > "$leg.trace"
+      grep -q "^PASS MMC HPS direct " "$leg.trace"
+    done
+    cmp reference.trace source.trace
+    grep "^PASS " source.trace'
+}
+
+timer() {
+  python3 -B "$area/prepare-directed.py" "$variant"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$stage:/bench:ro" -v "$PWD/$out/directed:/results" -w /results \
+    --entrypoint sh "$image" -ec '
+    for leg in reference source; do
+      base=/bench/$leg/rtl
+      set --
+      if [ "$leg" = reference ]; then set -- -DREFERENCE; fi
+      iverilog -g2012 -s tb "$@" -y "$base" -I "$base" -o "$leg" \
+        "$base/ngage_upp.v" "$base/ngage_upp_euart.v" tb.sv
+      vvp "$leg" > "$leg.log"
+      grep -E "^(TRACE|PASS) " "$leg.log" > "$leg.trace"
+    done
+    cmp reference.trace source.trace
+    grep "^PASS " source.trace'
+}
+
+physical() {
+  python3 -B "$area/mixed.py" "$variant"
+  mixed="$out/mixed"
+  retained=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD:/work" -w /work --entrypoint sh "$image" -ec "sh '$mixed/build.sh'
+'$mixed/obj/Vtb' +upp_stress '+compare_trace=$mixed/traffic.log' > '$mixed/replay.log'"
+  cmp "$retained/traffic.log" "$mixed/traffic.log"
+  sh "$area/coexistence.sh" "$variant"
+}
+
+case "$phase" in
+  hps) hps ;;
+  miter) owner_miter ;;
+  crc) crc ;;
+  timer) timer ;;
+  physical) physical ;;
+  fixed|native) python3 -B "$area/replay.py" "$variant" "$phase" --output qualification ;;
+  all)
+    hps
+    owner_miter
+    crc
+    timer
+    for kind in fixed native; do
+      python3 -B "$area/replay.py" "$variant" "$kind" --output qualification
+    done
+    physical
+    python3 -B "$area/record.py" "$variant"
+    ;;
+  *) exit 2 ;;
+esac
diff --git a/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/record.py b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/record.py
new file mode 100644
index 0000000..cc4f432
--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-hps-owner-timer-combined/record.py
@@ -0,0 +1,140 @@
+"""Confirm the exact selected inputs and qualification traces for either MMC owner trial."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import sys
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+variant = sys.argv[1]
+assert variant in ('owner-plus-timer', 'owner-plus-footer-timer')
+stage = area / variant
+out = root / 'build/sim/v5-104-mmc-hps-owner-timer-combined' / variant
+original = root / 'docs/evidence/v5-104-mmc-hps-cancel-owner.json'
+footer = root / 'docs/evidence/v5-104-mmc-footer-crc-direct.json'
+prepared = area / 'dispatch-20261126/prepare.json'
+retained = root / 'build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed'
+footer_path = 'rtl/ngage_mmc_hps.v'
+owner_original = json.loads(original.read_bytes())
+footer_original = json.loads(footer.read_bytes())
+plan = json.loads(prepared.read_bytes())
+stack = plan['variants'][variant]
+pinned = {name: value for name, value in stack['hashes_from_retained'].items() if name.startswith('rtl/')}
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def read_json(path):
+    return json.loads(path.read_bytes())
+
+
+def passes(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+def fingerprints(manifest, sources):
+    items = [shlex.split(line) for line in manifest.read_text().splitlines() if line.startswith('S ')]
+    result = {}
+    for name in sources:
+        (row,) = [row for row in items if row[-1].endswith(name)]
+        result[name] = row[-2]
+    return result
+
+
+assert len(pinned) == 4 and all(digest(stage / 'source' / name) == sha for name, sha in pinned.items())
+assert owner_original['status'] == footer_original['status'] == plan['status'] == 'PASS'
+assert (pinned[footer_path] == owner_original['candidate_sha256']) == (variant == 'owner-plus-timer')
+assert pinned[footer_path] != footer_original['candidate_sha256']
+source = stage / 'source' / footer_path
+owner_reference = stage / 'hps-reference' / footer_path
+expected_ref_sha = footer_original['candidate_sha256'] if variant == 'owner-plus-footer-timer' else owner_original['reference_sha256']
+assert digest(owner_reference) == expected_ref_sha
+
+mixed = out / 'mixed'
+physical_hashes = read_json(mixed / 'source-hashes.json')
+baseline_hashes = read_json(retained / 'source-hashes.json')
+assert len(physical_hashes) == 114 and physical_hashes.keys() == baseline_hashes.keys()
+assert {name: value for name, value in physical_hashes.items() if baseline_hashes[name] != value} == pinned
+compiled = fingerprints(mixed / 'obj/Vtb__verFiles.dat', pinned)
+
+workloads = {}
+for kind, field, expected in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    results = read_json(receipt)
+    assert results['status'] == 'PASS'
+    assert all(row['candidate'] == row['control'] for row in results['rows'])
+    count = sum(len(row['candidate'][field]) for row in results['rows'])
+    assert count == expected
+    assert {name: results['source_sha256'][Path(name).name] for name in pinned} == pinned
+    assert fingerprints(out / f'qualification/obj-{kind}/Vtb__verFiles.dat', pinned) == compiled
+    workloads[kind] = {'count': count, 'receipt_sha256': digest(receipt)}
+    if kind == 'fixed':
+        cases = [row['candidate']['case'] for row in results['rows']]
+        assert len(cases) == len(set(cases)) == 15
+        for case in cases:
+            assert (out / f'qualification/{case}-00-1.log').is_file()
+            wrong = out / f'qualification/{case}-00-0-wrong.log'
+            assert 'Guest output check rejected payload' in wrong.read_text()
+        workloads[kind].update(repeated_cases=len(cases), rejected_wrong_outputs=len(cases))
+native = results['rows'][0]['candidate']
+workloads['native']['cycles'] = [row['clocks'] for row in native['frames']]
+workloads['native']['guest_result_sha256'] = native['output_sha256']
+
+suite = out / 'units/source.log'
+assert passes(suite) == owner_original['direct_and_native_hps']['passes']
+actual_hash = fingerprints(out / 'units/source/obj/Vactual_tb__verFiles.dat', [footer_path])
+assert actual_hash[footer_path] == compiled[footer_path]
+assert (actual_hash[footer_path] == owner_original['direct_and_native_hps']['candidate_source_fingerprint']) == (variant == 'owner-plus-timer')
+
+miter = out / 'owner-miter'
+assert (miter / 'retained.v').read_text().replace('module retained_hps (', 'module ngage_mmc_hps (') == owner_reference.read_text()
