+        (m_same_writer || skid_same_writer || (i_dc_lock_any && i_dc_lock_tag == s_writer_tag));
+    wire s_wait_w_nohit = s_order_load && w_same_writer;
+    wire s_wait_w_hit = s_wait_w_nohit &&
