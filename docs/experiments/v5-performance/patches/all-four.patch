diff --git a/tests/cpu/arm9v2_board/fetch_ram_tb.sv b/tests/cpu/arm9v2_board/fetch_ram_tb.sv
new file mode 100644
index 0000000000000000000000000000000000000000..0e8230891508b80d34c124e6929278fe72ec4d91
--- /dev/null
+++ b/tests/cpu/arm9v2_board/fetch_ram_tb.sv
@@ -0,0 +1,193 @@
+`timescale 1ns / 1ps
+
+module fetch_ram_tb;
+  reg clk = 0, reset = 1;
+  reg ack = 0, error = 0, retry = 0, ready = 0;
+  reg fill_pending = 0, fill_done = 0, fill_fault = 0;
+  reg redirect = 0, redirect_thumb = 0;
+  reg [31:0] redirect_target = 0;
+  reg [31:0] data = 0;
+  reg update = 0;
+  reg [31:0] update_pc = 0, update_target = 0;
+  reg update_taken = 0;
+  reg [1:0] update_kind = 0;
+
+  wire [102:0] fetch_state[0:1];
+  for (genvar leg = 0; leg < 2; leg++) begin : g_fetch
+    ngage2_arm9v2_fetch #(
+        .BRAM_QUEUE(leg == 1)
+    ) dut (
+        .i_clk(clk),
+        .i_reset(reset),
+        .i_redirect(redirect),
+        .i_redirect_thumb(redirect_thumb),
+        .i_redirect_target(redirect_target),
+        .i_redirect_pointer(3'd0),
+        .i_redirect_count(4'd0),
+        .i_redirect_action(2'd0),
+        .i_redirect_link(32'd0),
+        .i_predictor_clear(1'b0),
+        .i_update(update),
+        .i_update_pc(update_pc),
+        .i_update_target(update_target),
+        .i_update_thumb(redirect_thumb),
+        .i_update_taken(update_taken),
+        .i_update_hit(1'b0),
+        .i_update_state(2'd1),
+        .i_update_kind(update_kind),
+        .i_data(data),
+        .i_ack(ack),
+        .i_error(error),
+        .i_retry(retry),
+        .i_fill_pending(fill_pending),
+        .i_fill_done(fill_done),
+        .i_fill_fault(fill_fault),
+        .i_ready(ready),
+        .o_address_nxt(fetch_state[leg][102:71]),
+        .o_address_check(fetch_state[leg][70:39]),
+        .o_address(fetch_state[leg][38:7]),
+        .o_request(fetch_state[leg][6]),
+        .o_stall(fetch_state[leg][5]),
+        .o_dbg_fetch(fetch_state[leg][4:3]),
+        .o_valid(fetch_state[leg][2]),
+        .o_thumb(fetch_state[leg][1]),
+        .o_fault(fetch_state[leg][0])
+    );
+  end
+
+  integer cycles = 0;
+  integer empty_pushes = 0, one_entry_turns = 0, full_stalls = 0, wrapped_pushes = 0;
+  integer bypassed_reads = 0, fault_responses = 0, fills = 0;
+  integer redirect_stalls = 0, retry_responses = 0;
+  wire [3:0] count = g_fetch[1].dut.count;
+  wire push = g_fetch[1].dut.push;
+  wire pop = g_fetch[1].dut.pop;
+  always @(posedge clk) begin
+    cycles <= cycles + 1;
+    if (!reset) begin
+      // The word and metadata are architecturally visible only while
+      // owned. Include a pending head in the comparison before it can pop.
+      if (fetch_state[0][102:2] !== fetch_state[1][102:2] ||
+          {g_fetch[0].dut.count, g_fetch[0].dut.push, g_fetch[0].dut.pop} !==
+          {count, push, pop})
+        $fatal(1, "Fetch request, admission or dequeue changed at cycle %0d", cycles);
+      if (count != 0 && g_fetch[0].dut.head_packet !== g_fetch[1].dut.head_packet)
+        $fatal(1, "Owned fetch packet changed at cycle %0d", cycles);
+      if (count == 0 && push) empty_pushes <= empty_pushes + 1;
+      if (count == 1 && push && pop) one_entry_turns <= one_entry_turns + 1;
+      if (count == 8 && !ready) full_stalls <= full_stalls + 1;
+      if (push && g_fetch[1].dut.tail == 7) wrapped_pushes <= wrapped_pushes + 1;
+      if (g_fetch[1].dut.g_fetch_ram.bypass_prefetch && count > 1)
+        bypassed_reads <= bypassed_reads + 1;
+      if (pop && fetch_state[1][0]) fault_responses <= fault_responses + 1;
+      if (fill_done && count > 1) fills <= fills + 1;
+      if (redirect && fetch_state[1][5]) redirect_stalls <= redirect_stalls + 1;
+      if (g_fetch[1].dut.retry) retry_responses <= retry_responses + 1;
+    end
+  end
+
+  task step;
+    data = data + 32'h01011001;
+    #1 clk = 1;
+    #1 clk = 0;
+    #1;
+  endtask
+
+  task empty_queue;
+    ack   = 0;
+    ready = 1;
+    repeat (12) step();
+    if (count != 0) $fatal(1, "Queue did not drain");
+  endtask
+
+  task redirect_to(input logic thumb, input logic [31:0] target);
+    redirect = 1;
+    redirect_thumb = thumb;
+    redirect_target = target;
+    step();
+    redirect = 0;
+    if (count != 0) $fatal(1, "Redirect left old queue entries visible");
+  endtask
+
+  reg [31:0] pattern = 32'h7ae128fd;
+  initial begin
+    step();
+    reset = 0;
+    ack   = 1;
+    ready = 0;
+    repeat (56) step();
+    if (count != 8) $fatal(1, "Fetch queue capacity changed");
+    ready = 1;
+    repeat (96) step();
+
+    // Sustained turns with one and two entries exercise both bypass paths.
+    empty_queue();
+    ack = 1;
+    repeat (36) step();
+    if (count != 1) $fatal(1, "One-entry fall-through changed cadence");
+    ready = 0;
+    step();
+    ready = 1;
+    repeat (48) step();
+    if (count != 2) $fatal(1, "Concurrent pop/push changed cadence");
+
+    // Broadcast fill completion to several pending heads, including
+    // a new push on the same edge, then consume all faulted packets.
+    empty_queue();
+    fill_pending = 1;
+    ready = 0;
+    ack = 1;
+    repeat (4) step();
+    fill_done  = 1;
+    fill_fault = 1;
+    step();
+    fill_pending = 0;
+    fill_done = 0;
+    fill_fault = 0;
+    empty_queue();
+
+    // Wrap the fetch epoch repeatedly while an old F2 response is stalled.
+    ack = 0;
+    repeat (7) begin
+      redirect_to(1, 32'h0a008002 + 4 * cycles);
+      repeat (3) step();
+    end
+    ack = 1;
+    repeat (4) step();
+    retry = 1;
+    step();
+    retry = 0;
+
+    // Deterministic ARM/Thumb, predictor and bus activity with variable
+    // consumer and cache stalls. Redirect and retry remain order-sensitive.
+    repeat (8192) begin
+      pattern = {pattern[30:0], pattern[31] ^ pattern[21] ^ pattern[1] ^ pattern[0]};
+      ack = |pattern[1:0];
+      ready = &pattern[4:2] || pattern[19];
+      retry = &pattern[9:5];
+      error = &pattern[14:10];
+      redirect = &pattern[20:15];
+      redirect_thumb = pattern[22];
+      redirect_target = {pattern[31:1], 1'b0};
+      fill_pending = pattern[27];
+      fill_done = &pattern[26:23];
+      fill_fault = pattern[28];
+      update = &pattern[31:29];
+      update_pc = fetch_state[0][38:7];
+      update_target = {pattern[30:0], redirect_thumb};
+      update_taken = pattern[22];
+      update_kind = pattern[11:10];
+      step();
+    end
+
+    if (empty_pushes == 0 || one_entry_turns < 30 || full_stalls < 40 || wrapped_pushes < 16 ||
+        bypassed_reads < 32 || fills == 0 || fault_responses < 4 ||
+        redirect_stalls < 7 || retry_responses == 0)
+      $fatal(1, "Missing fetch queue coverage");
+    $display(
+        "PASS fetch RAM equivalence cycles=%0d empty=%0d turns=%0d full=%0d wraps=%0d bypass=%0d fills=%0d faults=%0d redirect_stalls=%0d retries=%0d",
+        cycles, empty_pushes, one_entry_turns, full_stalls, wrapped_pushes, bypassed_reads, fills,
+        fault_responses, redirect_stalls, retry_responses);
+    $finish;
+  end
+endmodule
diff --git a/tests/cpu/arm9v2_board/run-fetch-ram.sh b/tests/cpu/arm9v2_board/run-fetch-ram.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3a09506d65d17b9bfd90dbd2c991560a59ade1ce
--- /dev/null
+++ b/tests/cpu/arm9v2_board/run-fetch-ram.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+set -eu
+name="${1:?provide a fresh run name}"
+case "$name" in *[!A-Za-z0-9_.-]*) exit 2 ;; esac
+out="build/sim/$name"
+mkdir "$out"
+
+simulate() {
+    entrypoint=$1
+    shift
+    docker run --rm --pull=never --network none --platform linux/arm64 -v "$PWD:/work" \
+        -w /work --entrypoint "$entrypoint" jotego/simulator:arm64 "$@"
+}
+
+simulate verilator --binary --timing --assert -j 2 -Wno-fatal -Wno-lint \
+    --top-module fetch_ram_tb --Mdir "$out/obj" rtl/arm9v2/arm925t_phone.v \
+    rtl/arm9v2/upstream/sim/stubs/*.sv tests/cpu/arm9v2_board/fetch_ram_tb.sv > "$out/build.log" 2>&1
+simulate "/work/$out/obj/Vfetch_ram_tb" > "$out/run.log" 2>&1
+rg '^PASS fetch RAM equivalence' "$out/run.log"
diff --git a/tests/cpu/arm9v2_ras/run.sh b/tests/cpu/arm9v2_ras/run.sh
new file mode 100755
index 0000000000000000000000000000000000000000..f5af48a0f9899df53744a327f46dca6e0d8fb504
--- /dev/null
+++ b/tests/cpu/arm9v2_ras/run.sh
@@ -0,0 +1,25 @@
+#!/bin/sh
+set -eu
+cd "$(dirname "$0")/../../.."
+out=build/sim/arm9v2-ras
+mkdir -p "$out"
+
+git show 29479fecc32fe8a787378222f1ac2010a0eaf8a7:rtl/arm9v2/arm925t_phone.v | awk '
+    /^module ngage2_arm9v2_predict / { active = 1; sub(/ngage2_arm9v2_predict/, "reference_predict") }
+    active { print }
+    active && /^endmodule/ { exit }
+' > "$out/reference.v"
+grep -q '^module reference_predict' "$out/reference.v"
+
+docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD:/work" -w /work --entrypoint sh jotego/simulator:arm64 -ec '
+        src=tests/cpu/arm9v2_ras
+        out=build/sim/arm9v2-ras
+        for mode in 1 0; do
+            verilator --binary --timing --assert -j 2 -Wno-fatal -Wno-lint --top-module tb \
+                -GTOP_REGISTER="$mode" --Mdir "$out/obj-$mode" rtl/arm9v2/arm925t_phone.v \
+                "$out/reference.v" "$src/tb.sv" > "$out/build-$mode.log" 2>&1
+            "$out/obj-$mode/Vtb" > "$out/run-$mode.log" 2>&1
+            grep "^PASS" "$out/run-$mode.log"
+        done
+    '
diff --git a/tests/cpu/arm9v2_ras/tb.sv b/tests/cpu/arm9v2_ras/tb.sv
new file mode 100644
index 0000000000000000000000000000000000000000..ea4ae643a9224ce388463fc7e9fbcf2bf0d01d7c
--- /dev/null
+++ b/tests/cpu/arm9v2_ras/tb.sv
@@ -0,0 +1,138 @@
+module tb;
+  parameter TOP_REGISTER = 1;
+  localparam [1:0] CALL = 1, RETURN = 2;
+  reg clk = 0, reset = 0, clear = 0;
+  reg lookup = 0, thumb = 0, accept = 0;
+  reg update = 0, repair = 0;
+  reg [31:0] pc = 0, repair_link = 0;
+  reg [2:0] repair_pointer = 0;
+  reg [3:0] repair_count = 0;
+  reg [1:0] kind = 0, action = 0;
+
+  wire [44:0] actual, expected;
+  `define PREDICT_PORTS(result) \
+    .i_clk(clk), .i_reset(reset), .i_clear(clear), .i_lookup(lookup), \
+    .i_pc(pc), .i_pc_redirect(pc), .i_pc_sequential(pc), \
+    .i_sel_redirect(1'b0), .i_sel_predicted(1'b0), .i_thumb(thumb), .i_accept(accept), \
+    .i_update(update), .i_update_pc(pc), .i_update_target(32'hd00df000), \
+    .i_update_thumb(thumb), .i_update_taken(1'b1), .i_update_hit(1'b0), \
+    .i_update_state(2'b10), .i_update_kind(kind), \
+    .i_repair(repair), .i_repair_pointer(repair_pointer), .i_repair_count(repair_count), \
+    .i_repair_action(action), .i_repair_link(repair_link), \
+    .o_hit(result[44]), .o_taken(result[43]), .o_target(result[42:11]), \
+    .o_state(result[10:9]), .o_kind(result[8:7]), \
+    .o_pointer(result[6:4]), .o_count(result[3:0])
+
+  ngage2_arm9v2_predict #(
+      .RAS_TOP_FF(TOP_REGISTER)
+  ) candidate (
+      `PREDICT_PORTS(actual)
+  );
+  reference_predict #(
+      .RAS_TOP_FF(TOP_REGISTER)
+  ) original (
+      `PREDICT_PORTS(expected)
+  );
+  `undef PREDICT_PORTS
+
+  integer edges = 0;
+  integer i, p, n, a, c;
+
+  task tick;
+    begin
+      #1 clk = 1;
+      #1 clk = 0;
+      #1;
+      edges = edges + 1;
+      if (actual !== expected)
+        $fatal(1, "edge %0d predicted %h, expected %h", edges, actual, expected);
+      if (TOP_REGISTER && actual[3:0] != 0 && candidate.ras_top !== original.ras_top)
+        $fatal(1, "edge %0d top %h, expected %h", edges, candidate.ras_top, original.ras_top);
+    end
+  endtask
+
+  task select_branch;
+    input take_return, is_thumb;
+    begin
+      thumb = is_thumb;
+      pc = take_return ? (is_thumb ? 32'h402 : 32'h300) : (is_thumb ? 32'h202 : 32'h100);
+      kind = take_return ? RETURN : CALL;
+    end
+  endtask
+
+  task train;
+    begin
+      update = 1;
+      lookup = 1;
+      for (i = 0; i < 4; i = i + 1) begin
+        select_branch(i[1], i[0]);
+        tick;
+      end
+      update = 0;
+    end
+  endtask
+
+  initial begin
+    reset = 1;
+    tick;
+    reset = 0;
+    train;
+    // Saturation and underflow with consecutive ARM/Thumb calls and returns.
+    for (i = 0; i < 32; i = i + 1) begin
+      select_branch(i[4], i[0]);
+      lookup = 1;
+      tick;
+      lookup = 0;
+      accept = 1;
+      tick;
+      accept = 0;
+      if (i == 15 && actual[3:0] != 8 || i == 31 && actual[3:0] != 0)
+        $fatal(1, "Depth did not saturate/empty at edge %0d", edges);
+    end
+
+    // Advance a new lookup on every cycle while accepting the previous one.
+    lookup = 1;
+    for (i = 0; i < 32; i = i + 1) begin
+      select_branch(i[4], i[0]);
+      accept = i != 0;
+      tick;
+    end
+    lookup = 0;
+    accept = 1;
+    tick;
+    accept = 0;
+    if (actual[3:0] != 0) $fatal(1, "Consecutive returns failed to empty stack");
+
+    // Every pointer, depth, repair action, and simultaneous control combination.
+    // Insert known nonidentical entries before repairs to make addressing errors visible.
+    for (p = 0; p < 8; p = p + 1)
+    for (n = 0; n <= 8; n = n + 1)
+    for (a = 0; a < 4; a = a + 1)
+    for (c = 0; c < 32; c = c + 1) begin
+      for (i = 0; i < 8; i = i + 1) begin
+        repair = 1;
+        action = CALL;
+        repair_pointer = i[2:0];
+        repair_count = {1'b0, i[2:0]};
+        repair_link = 32'hf1000000 + 32'(i * 4) + 32'(i[0]);
+        tick;
+      end
+      select_branch(1, c[0]);
+      lookup = 1;
+      tick;
+      {reset, clear, repair, accept, lookup} = c[4:0];
+      action = a[1:0];
+      repair_pointer = p[2:0];
+      repair_count = n[3:0];
+      repair_link = 32'hdec0dead ^ edges;
+      tick;
+      {reset, clear, repair, accept, lookup} = 0;
+      tick;
+      if (c[4] || c[3]) train;
+    end
+    $display(
+        "PASS RAS registered mode=%0d, %0d matched edges, all repair pointers/depths/actions and control priorities",
+        TOP_REGISTER, edges);
+    $finish;
+  end
+endmodule
