index 0000000..51dc16d
--- /dev/null
+++ b/scratch/v5-fit-loop/w-completion-upp/stage.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/w-completion-upp
+standalone=scratch/v5-fit-loop/w-completion-prepare
+private="$area/dispatch-20261126"
+base=96d108d2e44b3e3b630820fe2fa43f9e13cce702
+candidate=$(cat "$private/w-on-upp.sha")
+mkdir -p "$area/reference" "$area/source"
+(
+    export GIT_OBJECT_DIRECTORY="$PWD/$private/objects"
+    export GIT_ALTERNATE_OBJECT_DIRECTORIES="$(cat "$private/alternate-objects.txt")"
+    test "$(git rev-parse "$candidate^")" = "$base"
+    for leg in reference source; do
+        tree="$base"
+        if [ "$leg" = source ]; then tree="$candidate"; fi
+        git archive "$tree" Template.sv rtl tools files.qip .rules.verible_format tests sim/programs/link.ld \
+            | tar -x -C "$area/$leg"
+        python3 -B "$area/$leg/tools/gen_arm9v2_phone.py" --stock build/arm9v2-assoc/stock-pinned.v --check
+    done
+)
+cp "$area/source/rtl/ngage_cpu.sv" "$area/ngage_cpu.sv"
+cmp "$standalone/source/rtl/arm9v2/arm925t_phone.v" "$area/source/rtl/arm9v2/arm925t_phone.v"
diff --git a/scratch/v5-fit-loop/w-completion-upp/record.py b/scratch/v5-fit-loop/w-completion-upp/record.py
new file mode 100644
index 0000000..2fe72fb
--- /dev/null
+++ b/scratch/v5-fit-loop/w-completion-upp/record.py
@@ -0,0 +1,123 @@
+"""Bind the stacked W completion qualification to the exact selected UPP parent."""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+repo = area.parents[2]
+out = Path('build/sim/v5-104-w-completion-upp')
+control = Path('build/sim/v5-104-upp-claim-refill-payload')
+solo = area.parent / 'w-completion-prepare'
+private = area / 'dispatch-20261126'
+netlist = 'rtl/arm9v2/arm925t_phone.v'
+upp = 'rtl/ngage_upp_peripherals.v'
+wrapper = 'rtl/ngage_cpu.sv'
+arbiter = 'rtl/ngage_sdram_arbiter.v'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def fingerprint(manifest, path):
+    [row] = [shlex.split(line) for line in manifest.read_text().splitlines()
+             if line.startswith('S ') and shlex.split(line)[-1].endswith(path)]
+    return row[-2]
+
+
+def match(trial, original):
+    assert trial.read_bytes() == original.read_bytes(), (trial, original)
+    return digest(trial)
+
+
+preflight_file = private / 'prepare.json'
+preflight = load(preflight_file)
+assert preflight['status'] == 'PASS'
+standalone = load(solo / 'qualification.json')
+old = load(area.parent / 'upp-claim-refill-payload/qualification.json')
+assert old['status'] == standalone['status'] == 'PASS'
+assert preflight['standalone_qualification_sha256'] == digest(solo / 'qualification.json')
+variant = preflight['variants']['w-on-upp']
+assert variant['parent'] == old['candidate']
+paths = standalone['source_sha256'] | old['source_sha256']
+env = os.environ | {'GIT_OBJECT_DIRECTORY': preflight['private_objects'],
+                    'GIT_ALTERNATE_OBJECT_DIRECTORIES': preflight['alternate_objects']}
+for path, expected in paths.items():
+    actual = subprocess.check_output(['git', '-C', str(repo), 'show', f"{variant['sha']}:{path}"], env=env)
+    assert actual == (area / 'source' / path).read_bytes()
+    assert sha256(actual).hexdigest() == expected
+
+mixed = out / 'mixed'
+previous_mixed = control / 'mixed'
+manifest = load(mixed / 'source-hashes.json')
+prior_manifest = load(previous_mixed / 'source-hashes.json')
+assert len(manifest) == 114 and manifest.keys() == prior_manifest.keys()
+assert {path: value for path, value in manifest.items() if value != prior_manifest[path]} == {netlist: paths[netlist]}
+assert all(digest(mixed / 'source' / path) == value for path, value in manifest.items())
+compiled = {name: fingerprint(mixed / 'obj/Vtb__verFiles.dat', name) for name in (netlist, upp, wrapper, arbiter)}
+assert compiled[netlist] == standalone['compiled_cpu_fingerprint']
+assert all(compiled[path] == old['compiled_fingerprints'][path] for path in (upp, wrapper, arbiter))
+assert all(fingerprint(out / 'hold/trial-obj/Vtb__verFiles.dat', path) == fp for path, fp in compiled.items())
+assert fingerprint(out / 'hold/reference-obj/Vtb__verFiles.dat', netlist) != compiled[netlist]
+
+physical = {}
+for mode, relative, log, reference in (
+    ('normal', 'mixed/traffic.log', 'mixed/replay.log', control / 'mixed/traffic.log'),
+    ('timer_mmc_lcd', 'coexistence/candidate.trace', 'coexistence/candidate.log', control / 'coexistence/candidate.trace'),
+    ('cpu_block_eviction', 'block-guest/source.trace', 'block-guest/source.log', control / 'block-guest/source.trace'),
+    ('warm_hold', 'hold/trial.trace', 'hold/trial.log', control / 'hold/trial.trace'),
+):
+    trace = out / relative
+    sha = match(trace, reference)
+    receipt = standalone['physical'][mode]
+    assert sha == receipt['sha256'] and len(trace.read_bytes().splitlines()) == receipt['events']
+    assert f"persisted512bytes+PIOreadback cycles={receipt['clocks']}" in (out / log).read_text()
+    physical[mode] = receipt
+assert match(out / 'hold/reference.pass', out / 'hold/trial.pass')
+
+workloads = {}
+for kind, field, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    trial, ref = [load(path) for path in (receipt, control / f'qualification/{kind}.json')]
+    assert trial['status'] == ref['status'] == 'PASS' and trial['rows'] == ref['rows']
+    assert trial['netlist_sha256'] == paths[netlist] and trial['wrapper_sha256'] == paths[wrapper]
+    assert trial['source_sha256'] == ref['source_sha256']
+    assert trial['source_sha256'][Path(upp).name] == paths[upp]
+    assert trial['source_sha256'][Path(arbiter).name] == paths[arbiter]
+    files = out / f'qualification/obj-{kind}/Vtb__verFiles.dat'
+    assert fingerprint(files, f'/work/{kind}-candidate-cpu.v') == compiled[netlist]
+    assert fingerprint(files, Path(wrapper).name) == compiled[wrapper]
+    for path in (upp, arbiter):
+        assert fingerprint(files, path) == compiled[path]
+    assert sum(len(row['candidate'][field]) for row in trial['rows']) == count
+    workloads[kind] = {'count': count, 'sha256': digest(receipt)}
+    if kind == 'fixed':
+        cases = [row['candidate']['case'] for row in trial['rows']]
+        assert len(set(cases)) == 15
+        for case in cases:
+            assert (out / f'qualification/{case}-00-1.log').is_file()
+            assert 'Guest output check rejected payload' in (out / f'qualification/{case}-00-0-wrong.log').read_text()
+        workloads[kind].update(repeated=15, wrong_output_checks=15)
+    else:
+        native = trial['rows'][0]['candidate']
+        workloads[kind].update(frame_cycles=[row['clocks'] for row in native['frames']],
+                               guest_output_sha256=native['output_sha256'])
+
+summary = {'status': 'PASS', 'base': old['candidate'], 'candidate': variant['sha'], 'tree': variant['tree'],
+           'source_sha256': paths, 'compiled_fingerprints': compiled, 'mixed_source_count': len(manifest),
+           'workloads': workloads, 'physical': physical,
+           'simulator': (out / 'image.id').read_text().strip(),
+           'preflight_sha256': digest(preflight_file),
+           'standalone_sha256': digest(solo / 'qualification.json'),
+           'helper_patch_sha256': digest(area / 'w-completion-upp-replay.patch')}
+(area / 'qualification.json').write_text(json.dumps(summary, indent=2) + '\n')
+print('PASS exact stacked W + UPP identities, all workloads and all four pin replays')
diff --git a/scratch/v5-fit-loop/w-completion-upp/replay.py b/scratch/v5-fit-loop/w-completion-upp/replay.py
new file mode 100644
index 0000000..6b46be2
--- /dev/null
+++ b/scratch/v5-fit-loop/w-completion-upp/replay.py
@@ -0,0 +1,184 @@
+"""Replay native refill occupancy and SDRAM block capture against the retained 104 MHz control."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import statistics
+import subprocess
+import sys
+
+parser = argparse.ArgumentParser()
+parser.add_argument('kind', choices=('fixed', 'native'))
+parser.add_argument('--case', action='append')
+parser.add_argument('--workers', type=int, default=3)
+parser.add_argument('--output', default='replay')
+args = parser.parse_args()
+kind = args.kind
+stage = Path(__file__).resolve().parent
+repo = stage.parents[2]
+work = repo / 'build/sim/v5-104-w-completion-upp' / args.output
+work.mkdir(parents=True, exist_ok=True)
+baseline_name = 'v5-104-all-four-ram-candidate'
+fixed = repo / 'build/sim/payload-clocks' / baseline_name
+native = repo / 'build/sim/polycount' / baseline_name
+timing_baseline = repo / 'scratch/refill-issue-739d3bd'
+d_stage = stage / 'ngage_cpu.sv'
+candidate = stage / 'source/rtl/arm9v2/arm925t_phone.v'
+image = 'jotego/simulator:arm64'
+docker = ['docker', 'run', '--rm', '--pull=never', '--network', 'none', '--platform', 'linux/arm64',
+          '-v', f'{work}:/work', '-v', f'{repo}:/frozen:ro', '-w', '/work', '--entrypoint']
+sys.path.insert(0, str(stage / 'source/tests/cpu/arm9v2_board'))
+import payload_clocks
+payload_clocks.OUT = repo / "build/sim"
+from payload_clocks import qualified_inputs
+
+
+def frozen(path):
+    return '/frozen/' + str(path.relative_to(repo))
+
+
+def run(options, entrypoint, log):
+    with log.open('w') as handle:
+        return subprocess.run(docker + [entrypoint, image] + options, stdout=handle,
+                              stderr=subprocess.STDOUT, check=False).returncode
+
+
+def build():
+    compiled_netlist = work / f'{kind}-candidate-cpu.v'
+    compiled_netlist.write_bytes(candidate.read_bytes())
+    ref = fixed if kind == 'fixed' else native / 'i16'
+    bench = (ref / 'tb.v').read_text()
+    assert bench.count('.CPU_BLOCK_WRITES(1)') == 1
+    bench = bench.replace('.CPU_BLOCK_WRITES(1)', '.CPU_BLOCK_WRITES(1), .PRECAPTURE_BLOCK_DATA(1)')
+    observer = (stage / 'architectural_trace.vh').read_text() + (stage / 'wb-write-trace.vh').read_text()
+    (work / f'{kind}.sv').write_text(bench.rsplit('endmodule', 1)[0] + observer + '\nendmodule\n')
+    command = next(line for line in (ref / 'mmc3-nos64/Vtb__verFiles.dat').read_text().splitlines()
+                   if line.startswith('C '))
+    options = shlex.split(command.removeprefix('C "').removesuffix('"'))
+    net_hits, wrapper_hits, bench_hits = 0, 0, 0
+    for i, option in enumerate(options):
+        if option == 'rtl/ngage_cpu.sv':
+            options[i] = frozen(d_stage)
+            wrapper_hits += 1
+        elif option in {'rtl/ngage_ddr_stream.v', 'rtl/ngage_upp.v', 'rtl/ngage_dma_channels.v', 'rtl/ngage_upp_peripherals.v', 'rtl/ngage_keypad.v', 'rtl/ngage_upp_euart.v', 'rtl/ngage_timers.v', 'rtl/ngage_sdram_arbiter.v'}:
+            options[i] = frozen(stage / 'source' / option)
+        elif option.startswith('/work/') and option.endswith(('/arm925t_phone.v', '/arm925t-i16.v')):
+            options[i] = '/work/' + compiled_netlist.name
+            net_hits += 1
+        elif option.startswith('/work/') and option.endswith('/tb.v'):
+            options[i] = f'/work/{kind}.sv'
+            bench_hits += 1
+        elif option.startswith('/work/') and option.endswith(('.v', '.sv')):
+            options[i] = option.replace('/work/', '/frozen/', 1)
+        elif option.startswith('-Irtl/'):
+            options[i] = '-I' + frozen(timing_baseline / 'leg' / option[2:])
+        elif option.endswith(('.v', '.sv')):
+            source = timing_baseline / 'leg' / option
+            assert source.is_file(), source
+            options[i] = frozen(source)
+    assert net_hits == wrapper_hits == bench_hits == 1, (net_hits, wrapper_hits, bench_hits)
+    options[options.index('--Mdir') + 1] = f'obj-{kind}'
+    options.insert(0, '-I'+frozen(timing_baseline / 'leg'))
+    options[options.index('-j') + 1] = '3'
+    log = work / f'build-{kind}.log'
+    assert run(options, 'verilator', log) == 0, log
+    compiled = (work / f'obj-{kind}/Vtb__verFiles.dat').read_text().splitlines()
+    assert any(line.startswith('S ') and line.endswith('/w-completion-upp/source/rtl/ngage_ddr_stream.v\"') for line in compiled)
+    for changed in ('ngage_upp.v', 'ngage_dma_channels.v', 'ngage_upp_peripherals.v', 'ngage_keypad.v', 'ngage_upp_euart.v', 'ngage_timers.v', 'ngage_sdram_arbiter.v'):
+        assert any(line.startswith('S ') and line.endswith(f'/w-completion-upp/source/rtl/{changed}"') for line in compiled), changed
+    for source in (f'{kind}.sv', compiled_netlist.name):
+        assert any(line.startswith('S ') and line.endswith(f'"/work/{source}"') for line in compiled), source
+    for cache in (work / f'obj-{kind}').glob('*.gch'):
+        cache.unlink()
+
+
+def scan(log, prefix, hex_fields=False):
+    rows = []
+    for line in log.read_text().splitlines():
+        if line.startswith(prefix):
+            pairs = re.findall(r'(\w+)=(-?[0-9a-f]+)', line)
+            rows.append({k: int(v, 16 if hex_fields and k.endswith('_hash') else 10) for k, v in pairs})
+    return rows
+
+
+def digest(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def execute(profile, case, attempt=0, wrong=False):
+    delay, thumb = profile
+    inputs = ['+ngage-compact-trace', '+no-board-log',
+              '+extension=' + frozen(repo / 'build/firmware/nem4-factory/extension.bin')]
+    suffix = f'{delay}{thumb}-{attempt}{"-wrong" if wrong else ""}'
+    if kind == 'fixed':
+        name = case['name']
+        inputs += ['+core=' + frozen(fixed / f'{name}-{wrong}.bin'), '+cdrive=' + frozen(fixed / 'cdrive.bin'),
+                   f'+begin_pc={case["begin"]:x}', f'+end_pc={case["end"]:x}',
+                   f'+payload_base={case["payload_base"]:x}', f'+helper_base={case["helper_base"]:x}']
+    else:
+        name = 'native'
+        result = work / f'native-{suffix}.bin'
+        inputs += ['+core=' + frozen(native / 'core.bin'), '+cdrive=' + frozen(native / 'cdrive.bin'),
+                   '+snapshot=' + frozen(native / 'snapshot.bin'), f'+results=/work/native-{suffix}',
+                   '+begin_pc=68', '+end_pc=6c', '+done_pc=80', '+fail_pc=84']
+    log = work / f'{name}-{suffix}.log'
+    code = run(inputs, f'/work/obj-{kind}/Vtb', log)
+    if wrong:
+        assert code != 0 and 'Guest output check rejected payload' in log.read_text(), log
+        return None
+    assert code == 0, log
+    architecture = scan(log, 'RES_ARCH ', hex_fields=True)
+    wb_writes = scan(log, 'RES_WB ', hex_fields=True)
+    assert len(wb_writes) == len(architecture)
+    if kind == 'fixed':
+        windows = scan(log, 'PAYLOAD_RESULT ')
+        assert len(architecture) == len(windows) == 7, log
+        assert len(scan(log, 'PAYLOAD_PASS ')) == 1
+        for actual, expect in zip(windows, case['windows'], strict=True):
+            assert actual['payload_ops'] == expect['payload_retire_proxy']
+            assert actual['helper_ops'] == expect['helper_retire_proxy']
+        return dict(profile=profile, case=name, windows=windows, architecture=architecture, wb_writes=wb_writes,
+                    median=statistics.median(x['cycles'] for x in windows[2:]))
+    frames = scan(log, 'POLY_FRAME ')
+    assert len(architecture) == len(frames) == 4, log
+    assert len(scan(log, 'PASS_POLYCOUNT ')) == 1
+    assert digest(result) == digest(native / 'i16/result.bin')
+    return dict(profile=profile, case=name, frames=frames, architecture=architecture, wb_writes=wb_writes,
+                output_sha256=digest(result), median=statistics.median(f['clocks'] for f in frames[1:]))
+
+
+def architectural_work(row):
+    return [{k:v for k,v in entry.items() if k != 'recover'} for entry in row['architecture']]
+
+control = json.loads((repo / 'build/sim/v5-104-upp-claim-refill-payload/qualification' / f'{kind}.json').read_text())
+assert control['status'] == 'PASS'
+assert control['ddr_stream_sha256'] == digest(stage/'source/rtl/ngage_ddr_stream.v')
+reference = {r['candidate']['case']:r['candidate'] for r in control['rows']}
+
+build()
+rows=[]
+with ThreadPoolExecutor(max_workers=args.workers) as pool:
+    cases = [None] if kind=='native' else [case for case in qualified_inputs()
+                                            if not args.case or case['name'] in args.case]
+    if kind=='fixed':
+        assert len(cases)==(len(args.case) if args.case else 15)
+        cases.sort(key=lambda r:r['name']!='sega-scan')
+    for case in cases:
+        primary = pool.submit(execute, (0,0), case)
+        repeat = pool.submit(execute, (0,0), case, attempt=1) if kind=='fixed' else None
+        wrong = pool.submit(execute,(0,0),case,wrong=True) if kind=='fixed' else None
+        trial=primary.result()
+        if repeat:
+            assert trial==repeat.result() and wrong.result() is None
+        name=trial['case']
+        expected = {**reference[name], 'profile': (0,0)}
+        assert trial == expected, (name, trial, expected)
+        rows.append(dict(candidate=trial, control=expected))
+        print(name, trial['median'], flush=True)
+(work/f'{kind}.json').write_text(json.dumps(dict(status='PASS', netlist_sha256=digest(candidate),
+                                                wrapper_sha256=digest(d_stage), ddr_stream_sha256=digest(stage / 'source/rtl/ngage_ddr_stream.v'),
+                                                dma_channels_sha256=digest(stage / 'source/rtl/ngage_dma_channels.v'),
+                                                source_sha256={name:digest(stage / 'source/rtl' / name) for name in ('ngage_upp.v','ngage_upp_peripherals.v','ngage_upp_euart.v', 'ngage_timers.v','ngage_keypad.v','ngage_sdram_arbiter.v')}, rows=rows),indent=2)+'\n')
