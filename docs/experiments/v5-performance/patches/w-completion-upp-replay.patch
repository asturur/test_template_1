diff --git a/scratch/v5-fit-loop/w-completion-upp/prepare-fit.py b/scratch/v5-fit-loop/w-completion-upp/prepare-fit.py
new file mode 100644
index 0000000..946c156
--- /dev/null
+++ b/scratch/v5-fit-loop/w-completion-upp/prepare-fit.py
@@ -0,0 +1,192 @@
+"""Prepare W completion lineages on the two-cut and UPP controls without refs."""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+standalone = area.parent / 'w-completion-prepare'
+prior = area.parent / 'upp-claim-refill-payload/dispatch-20261126'
+private = area / 'dispatch-20261126'
+objects = private / 'objects'
+objects.mkdir(parents=True, exist_ok=True)
+base = 'ab75a622a80a5aedae347f63ae195f3da965815a'
+active_upp = '96d108d2e44b3e3b630820fe2fa43f9e13cce702'
+base_runs = {13: 45879015397, 43: 45879019116, 31337: 45879022396}
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+changed = [rtl, 'tools/gen_arm9v2_phone.py']
+upp_rtl = 'rtl/ngage_upp_peripherals.v'
+design = standalone / 'w-completion-prepare.patch'
+proof_path = standalone / 'qualification.json'
+
+
+def sha(data):
+    return sha256(data).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+alternates = os.pathsep.join(dict.fromkeys(
+    [str(prior / 'objects'), *(prior / 'alternate-objects.txt').read_text().strip().split(os.pathsep)]))
+assert all(Path(path).is_absolute() and Path(path).is_dir() for path in alternates.split(os.pathsep))
+(private / 'alternate-objects.txt').write_text(alternates + '\n')
+
+
+def environment(label):
+    return os.environ | {'GIT_OBJECT_DIRECTORY': str(objects), 'GIT_ALTERNATE_OBJECT_DIRECTORIES': alternates,
+                         'GIT_INDEX_FILE': str(private / f'index-{label}')}
+
+
+def git(*args, env):
+    return subprocess.check_output(['git', '-C', str(root), *args], env=env)
+
+
+def revision(value, env):
+    return git('rev-parse', value, env=env).decode().strip()
+
+
+def tree(value, env):
+    return revision(f'{value}^{{tree}}', env)
+
+
+def files(before, after, env):
+    return git('diff', '--name-only', before, after, env=env).decode().splitlines()
+
+
+def commit(tree_id, parent, message, env):
+    timestamp = int(git('show', '-s', '--format=%ct', parent, env=env)) + 1
+    date = f'@{timestamp} +0000'
+    result = git('commit-tree', tree_id, '-p', parent, '-m', message,
+                 env=env | {'GIT_AUTHOR_DATE': date, 'GIT_COMMITTER_DATE': date}).decode().strip()
+    assert revision(f'{result}^', env) == parent and tree(result, env) == tree_id
+    return result
+
+
+proof = load(proof_path)
+upp_proof = load(prior.parent / 'qualification.json')
+dispatched = load(prior / 'dispatch.json')
+assert (prior / 'published.sha').read_text().strip() == dispatched['candidate'] == active_upp
+assert dispatched['previous_tip'] == base
+assert proof['status'] == upp_proof['status'] == 'PASS' and proof['base'] == upp_proof['base'] == base
+assert upp_proof['candidate'] == active_upp
+assert sha(design.read_bytes()) == proof['design_patch_sha256']
+common = environment('verify')
+assert tree(base, common) == proof['base_tree']
+assert tree(active_upp, common) == upp_proof['tree'] and files(base, active_upp, common) == [upp_rtl]
+assert revision(f'{active_upp}^', common) == base
+for path, expected in proof['reference_sha256'].items():
+    for item in (base, active_upp):
+        assert sha(git('show', f'{item}:{path}', env=common)) == expected
+
+restore = commit(proof['base_tree'], active_upp, '''revert: restore two-cut 104 MHz tree
+
+Restore the measured refill and block capture source for a separate
+comparison of W completion eligibility.''', common)
+assert files(active_upp, restore, common) == [upp_rtl]
+assert git('diff', '--quiet', base, restore, env=common) == b''
+(private / 'restore.sha').write_text(restore + '\n')
+
+variants = {}
+for label, parent in (('w-on-two-cut', restore), ('w-on-upp', active_upp)):
+    env = environment(label)
+    git('read-tree', parent, env=env)
+    git('apply', '--cached', '--check', str(design), env=env)
+    git('apply', '--cached', str(design), env=env)
+    candidate_tree = git('write-tree', env=env).decode().strip()
+    if parent == restore:
+        assert candidate_tree == proof['candidate_tree']
+    candidate = commit(candidate_tree, parent, 'perf(cpu): prepare W completion eligibility', env)
+    assert files(parent, candidate, env) == changed
+    exact = proof['source_sha256'].copy()
+    if parent == active_upp:
+        exact[upp_rtl] = upp_proof['source_sha256'][upp_rtl]
+    assert sorted(files(base, candidate, env)) == sorted(exact)
+    for path, value in exact.items():
+        staged_area = standalone if parent == restore else area
+        assert sha(git('show', f'{candidate}:{path}', env=env)) == sha((staged_area / 'source' / path).read_bytes()) == value
+    assert git('show', f'{candidate}:.github/workflows/ci_build.yml', env=env) == git(
+        'show', f'{base}:.github/workflows/ci_build.yml', env=env)
+    git('merge-base', '--is-ancestor', active_upp, candidate, env=env)
+    (private / f'{label}.sha').write_text(candidate + '\n')
+    variants[label] = {'sha': candidate, 'parent': parent, 'tree': candidate_tree, 'paths_since_parent': changed,
+                       'sha256_from_two_cut': exact, 'production': {}}
+
+tools = ('set_quartus_seed', 'set_quartus_debug', 'record_fit_inputs')
+for label, variant in variants.items():
+    env = environment(label)
+    candidate = variant['sha']
+    for seed, base_run in base_runs.items():
+        base_dir = root / f'build/timing-audit-{base_run}/output_files'
+        base_manifest = load(base_dir / 'resident-fit-manifest.json')
+        assert base_manifest['actual_commit'] == base
+        control = base_manifest
+        run = base_run
+        origin = 'routed two-cut control'
+        if label == 'w-on-upp':
+            upstream = dispatched['runs'][str(seed)]
+            assert upstream['head_sha'] == active_upp and upstream['control_run'] == base_run
+            run = upstream['id']
+            path = root / f'build/timing-audit-{run}/output_files/resident-fit-manifest.json'
+            origin = 'routed UPP control'
+            if not path.is_file():
+                origin = 'sealed UPP control preflight'
+                path = prior / f'preflight/claim-on-two-cut/{seed}/output_files/resident-fit-manifest.json'
+                assert sha(path.read_bytes()) == upstream['candidate_preflight_manifest_sha256']
+            control = load(path)
+            assert control['actual_commit'] == active_upp
+            assert {name: value for name, value in control['compiled_source_sha256'].items()
+                    if value != base_manifest['compiled_source_sha256'][name]} == {upp_rtl: upp_proof['source_sha256'][upp_rtl]}
+        selected = control['compiled_source_sha256']
+        assert control['seed'] == seed and control['physical_cpu_mhz'] == 104 and control['debugger'] is False
+        assert len(selected) == 133 and selected[rtl] == proof['reference_sha256'][rtl] and changed[1] not in selected
+        run_dir = private / 'preflight' / label / str(seed)
+        outputs = run_dir / 'output_files'
+        outputs.mkdir(parents=True, exist_ok=True)
+        graph = (base_dir / 'source-graph.txt').read_text()
+        assert {line.removeprefix('SOURCE /project/') for line in graph.splitlines()
+                if line.startswith('SOURCE ')} == selected.keys()
+        (outputs / 'source-graph.txt').write_text(graph)
+        for name in (*selected, *(f'tools/{tool}.py' for tool in tools)):
+            assert not Path(name).is_absolute() and '..' not in Path(name).parts
+            target = run_dir / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(git('show', f'{candidate}:{name}', env=env))
+        local = os.environ | {'GITHUB_SHA': candidate}
+        for name in ('GITHUB_STEP_SUMMARY', 'GITHUB_RUN_ID'):
+            local.pop(name, None)
+        for tool, *arguments in (('set_quartus_seed', 'Template.qsf', '--seed', str(seed)),
+                                  ('set_quartus_debug', 'Template.qsf', '--enabled', 'false')):
+            subprocess.run(['python3', '-B', f'tools/{tool}.py', *arguments],
+                           cwd=run_dir, env=local, check=True, stdout=subprocess.PIPE)
+        qsf = run_dir / 'Template.qsf'
+        qsf.write_bytes(qsf.read_bytes().replace(b'LAST_QUARTUS_VERSION "17.0.2 Standard Edition"\r\n',
+                                                 b'LAST_QUARTUS_VERSION "17.0.2 Lite Edition"\n'))
+        subprocess.run(['python3', '-B', 'tools/record_fit_inputs.py'],
+                       cwd=run_dir, env=local, check=True, stdout=subprocess.PIPE)
+        preflight = outputs / 'resident-fit-manifest.json'
+        actual = load(preflight)
+        assert actual['actual_commit'] == candidate
+        inputs = actual['compiled_source_sha256']
+        assert inputs.keys() == selected.keys()
+        delta = {name: value for name, value in inputs.items() if value != selected[name]}
+        assert delta == {rtl: proof['source_sha256'][rtl]}
+        assert all(actual[key] == control[key]
+                   for key in control.keys() - {'actual_commit', 'compiled_source_sha256'})
+        variant['production'][seed] = {'control_run': run, 'control_origin': origin, 'mhz': actual['physical_cpu_mhz'],
+                                       'debugger': actual['debugger'], 'source_count': len(inputs),
+                                       'delta': delta, 'manifest_sha256': sha(preflight.read_bytes())}
+        print(f'PASS {label} seed {seed} at 104 MHz DDR debug off, exact 133-input manifest', flush=True)
+
+receipt = {'status': 'PASS', 'two_cut': base, 'public_parent': active_upp, 'restore': restore,
+           'private_objects': str(objects), 'alternate_objects': alternates,
+           'standalone_qualification_sha256': sha(proof_path.read_bytes()),
+           'design_patch_sha256': sha(design.read_bytes()), 'variants': variants}
+(private / 'prepare.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print('Restore', restore)
+for label, value in variants.items():
+    print(label, value['sha'], value['tree'])
diff --git a/scratch/v5-fit-loop/w-completion-upp/stage.sh b/scratch/v5-fit-loop/w-completion-upp/stage.sh
