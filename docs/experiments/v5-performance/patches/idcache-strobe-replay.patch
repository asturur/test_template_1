index 0000000..2396b65
--- /dev/null
+++ b/scratch/v5-fit-loop/idcache-strobe/check-dcache-strobe.py
@@ -0,0 +1,129 @@
+"""Compare the generated D-cache strobe and EOB expressions."""
+from pathlib import Path
+import re
+import subprocess
+
+stage = Path(__file__).resolve().parent
+sources = {
+    'old': (stage / 'icache-reference.v').read_text(),
+    'new': (stage / 'source/rtl/arm9v2/arm925t_phone.v').read_text(),
+}
+
+def module(source, name):
+    return re.search(rf'^module ngage2_{name}\b.*?^endmodule', source, flags=re.M | re.S)[0]
+
+def statement(src, prefix):
+    return re.search(r'^[ \t]*' + re.escape(prefix) + r'[^;]*;', src, re.M)[0]
+
+blocks = []
+for tag, source in sources.items():
+    fsm = module(source, 'zap_dcache_fsm')
+    cache = module(source, 'zap_dcache')
+    controls = ('IDLE', 'UNCACHEABLE', 'UNCACHEABLE_PREPARE', 'CLEAN_SINGLE',
+                'FETCH_SINGLE', 'UNLOCK_REG', 'NUMBER_OF_STATES')
+    declarations = [statement(fsm, 'localparam ' + ('[31:0] ' if control == 'NUMBER_OF_STATES'
+                    else '[3:0] ') + control + ' =') for control in controls]
+    conditions = statement(fsm, 'assign take =') + '\n'
+    conditions += '\n'.join(statement(fsm, 'assign ' + name + ' =')
+                            for name in ('beat_cur_ok', 'beat_inc_ok'))
+    if tag == 'new':
+        start = fsm.index('    wire writeback_hold_valid')
+        end = fsm.index('\tassign o_wb_cyc_nxt', start)
+        conditions += '\n' + fsm[start:end]
+        last = 'writeback_next_last'
+    else:
+        conditions += '\n' + statement(fsm, 'wire writeback_next_valid =')
+        conditions += '\n' + statement(fsm, 'assign o_wb_stb_nxt =')
+        last = re.search(r'\(\(take \? adr_ctr_inc : adr_ctr_ff\) == last_writeback_word', fsm)[0][1:]
+    blocks.append(f"""
+module fsm_{tag} #(parameter CACHE_LINE = 32, WIDTH = $clog2(CACHE_LINE/4)+1)
+    (input [13:0] state_ff,
+     input [WIDTH-1:0] adr_ctr_ff, adr_ctr_inc, last_writeback_word,
+     input i_rd, i_wr, i_align_fault, i_fault, i_busy, i_cache_en, post_stream,
+     input o_writeback_busy, o_wb_stb_ff, i_wb_ack, i_wb_err,
+     output o_wb_stb_nxt, valid, last);
+    localparam ADR_PAD = 32 - WIDTH;
+    wire take, beat_cur_ok, beat_inc_ok;
+    {' '.join(declarations)}
+    {conditions}
+    assign valid = writeback_next_valid;
+    assign last = {last};
+endmodule
+""")
+    stb = statement(cache, 'assign o_wb_stb_nxt =')
+    cyc = statement(cache, 'assign o_wb_cyc_nxt =')
+    eligible = statement(cache, 'assign eligible_cyc =')
+    blocks.append(f"""
+module arb_{tag}(input [3:0] wb_cyc, state_ff,
+    input post_busy, post_push, o_wb_stb, i_wb_ack, i_wb_err,
+    output o_wb_stb_nxt, o_wb_cyc_nxt);
+    wire [3:0] wb_stb = wb_cyc;
+    wire [3:0] eligible_cyc;
+    {eligible}
+    {stb}
+    {cyc}
+endmodule
+""")
+blocks.append("""
+module tb #(parameter CACHE_LINE=32);
+localparam WIDTH=$clog2(CACHE_LINE/4)+1;
+reg [13:0] state=0;
+reg [WIDTH-1:0] current=0, advance=0, limit=0;
+reg [10:0] control=0;
+reg [3:0] requests=0, owner=0;
+reg [4:0] arb_control=0;
+wire [2:0] old_fsm, new_fsm;
+wire [1:0] old_arb, new_arb;
+fsm_old #(.CACHE_LINE(CACHE_LINE)) a(state,current,advance,limit,
+    control[0],control[1],control[2],control[3],control[4],control[5],
+    control[6],control[7],control[8],control[9],control[10],old_fsm[0],old_fsm[1],old_fsm[2]);
+fsm_new #(.CACHE_LINE(CACHE_LINE)) b(state,current,advance,limit,
+    control[0],control[1],control[2],control[3],control[4],control[5],
+    control[6],control[7],control[8],control[9],control[10],new_fsm[0],new_fsm[1],new_fsm[2]);
+arb_old c(requests,owner,arb_control[0],arb_control[1],arb_control[2],
+    arb_control[3],arb_control[4],old_arb[0],old_arb[1]);
+arb_new d(requests,owner,arb_control[0],arb_control[1],arb_control[2],
+    arb_control[3],arb_control[4],new_arb[0],new_arb[1]);
+integer s, p, q, n, m, addend, fsm_count=0, arb_count=0;
+task check_fsm;
+    begin
+        #1;
+        if (old_fsm !== new_fsm)
+            $fatal(1,"state=%h word=%d advance=%d last=%d control=%h",state,current,advance,limit,control);
+        fsm_count=fsm_count+1;
+    end
+endtask
+initial begin
+    for (s=0;s<14;s=s+1)
+        for (n=0;n<2048;n=n+1) begin
+            state=1<<s; control=n;
+            check_fsm;
+        end
+    for (s=3;s<=4;s=s+1)
+        for (p=0;p<2;p=p+1)
+            for (q=0;q<(1<<WIDTH);q=q+1)
+                for (n=0;n<(1<<WIDTH);n=n+1)
+                    for (m=0;m<8;m=m+1) begin
+                        state=1<<s; addend=p ? 4 : 1; current=q;
+                        advance=q+addend; limit=n; control={m[2:0],8'b0};
+                        check_fsm;
+                    end
+    for (s=0;s<4;s=s+1)
+        for (p=0;p<16;p=p+1)
+            for (n=0;n<32;n=n+1) begin
+                requests=p; owner=1<<s; arb_control=n;
+                #1;
+                if (old_arb !== new_arb) $fatal(1,"arbiter owner=%b requests=%b control=%b",owner,requests,arb_control);
+                arb_count=arb_count+1;
+            end
+    $display("PASS %0d-byte lines: %0d controller, %0d arbitration",CACHE_LINE,fsm_count,arb_count);
+    $finish;
+end
+endmodule
+""")
+test = stage/'dcache-strobe-miter.sv'
+test.write_text('\n'.join(blocks))
+for line in (16, 32):
+    output = stage/f'dcache-miter-{line}'
+    subprocess.run(['iverilog', '-g2012', '-s', 'tb', f'-Ptb.CACHE_LINE={line}', '-o', str(output), str(test)], check=True)
+    subprocess.run(['vvp', str(output)], check=True)
diff --git a/scratch/v5-fit-loop/idcache-strobe/replay.py b/scratch/v5-fit-loop/idcache-strobe/replay.py
