diff --git a/tests/phone/upp_ddr_ram/README.md b/tests/phone/upp_ddr_ram/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..32eb68ee669c2b962c84eb2b47a08571231335e7
--- /dev/null
+++ b/tests/phone/upp_ddr_ram/README.md
@@ -0,0 +1,28 @@
+# Production UPP DDR endpoint checks
+
+Run from the project root with the local ARM assembler and the existing offline
+simulator image. The mixed case reuses the adapted Micron model documented in
+[the retained latency replay](../../../docs/upp-ddr3-rtl-replay.md#reproduction).
+
+```sh
+sh tests/phone/upp_ddr_ram/run.sh
+```
+
+The registered board test checks authorization, held completions, every legal
+byte mask, invalid-mask rejection, distinct addresses and 32-bit lanes, and
+MDI, auxiliary and NOS4K ownership. It replaces an in-flight read with a read
+to the other bank and verifies that the first result cannot complete the
+second. A warm reset drains an accepted write without clearing memory. The
+next cold reset clears both banks again and keeps initialization incomplete
+until the DDR peer and local RAM sweep finish.
+
+The mixed case runs ARM9V2 with both production UPP DDR windows enabled.
+The guest checks raw reads and masked writes, executes an ARM `SWP` in each
+window with LCD DMA waiting and fetches instructions from each window. It also
+checks a full pin-level LCD transfer, an MMC write and readback, and the
+128-sample signed PCM hash and cadence. The tests use a byte-enabled delayed
+DDR endpoint peer. The
+[transport regression](../upp_ddr_transport/) exercises the production HPS
+transport and arbiter separately.
+
+Logs and the mixed source manifest are under `build/sim/upp-ddr-ram/`.
diff --git a/tests/phone/upp_ddr_ram/atomic.S b/tests/phone/upp_ddr_ram/atomic.S
new file mode 100644
index 0000000000000000000000000000000000000000..c541065c1e5662d19320abe7e625ce6c6fd7ab3f
--- /dev/null
+++ b/tests/phone/upp_ddr_ram/atomic.S
@@ -0,0 +1,40 @@
+ // ARM SWP on both raw DDR banks with the LCD transfer active.
+ mov r12,#81
+ ldr r0,=0x0c038000
+ ldr r1,=0x0c108000
+ mov r2,#0x5a
+ mov r3,#0x9c
+ str r2,[r0]
+ str r2,[r1]
+ swp r10,r3,[r0]
+ cmp r10,r2
+ bne fail
+ swp r10,r3,[r1]
+ cmp r10,r2
+ bne fail
+ ldr r10,[r0]
+ cmp r10,r3
+ bne fail
+ ldr r10,[r1]
+ cmp r10,r3
+ bne fail
+
+ // Both ranges retain ordinary instruction readback. The first word
+ // updates a scratch register and the second returns to code flash.
+ mov r12,#82
+ ldr r2,=0xe3a0a05a
+ ldr r3,=0xe12fff1e
+ str r2,[r0]
+ str r3,[r0,#4]
+ str r2,[r1]
+ str r3,[r1,#4]
+ mov r10,#0
+ mov lr,pc
+ bx r0
+ cmp r10,#0x5a
+ bne fail
+ mov r10,#0
+ mov lr,pc
+ bx r1
+ cmp r10,#0x5a
+ bne fail
diff --git a/tests/phone/upp_ddr_ram/mixed.vh b/tests/phone/upp_ddr_ram/mixed.vh
new file mode 100644
index 0000000000000000000000000000000000000000..d5b84fac3345a336a3cb9b4bbca80a9aefd5993e
--- /dev/null
+++ b/tests/phone/upp_ddr_ram/mixed.vh
@@ -0,0 +1,57 @@
+ wire ddr_req, ddr_we, ddr_ack, ddr_clear, ddr_clear_done;
+ wire [16:2] ddr_addr;
+ wire [31:0] ddr_wdata, ddr_rdata;
+ wire [3:0] ddr_be;
+ upp_ddr_test_peer upp_ddr (
+     .clk(clk), .cold(cold), .complete(1'b1), .req(ddr_req), .we(ddr_we),
+     .addr(ddr_addr), .wdata(ddr_wdata), .be(ddr_be), .ack(ddr_ack), .rdata(ddr_rdata),
+     .clear(ddr_clear), .clear_done(ddr_clear_done), .pending()
+ );
+
+ integer ddr_writes[0:1], ddr_reads[0:1];
+ reg [1:0] atomic_read=0, atomic_write=0, instruction_read=0, atomic_dma_overlap=0;
+ integer sample_count=0, first_sample=-1, last_sample=-1;
+ reg [31:0] sample_hash=32'h811c9dc5;
+ integer ram_bank;
+ initial begin
+     for (ram_bank=0; ram_bank<2; ram_bank=ram_bank+1) begin
+         ddr_writes[ram_bank]=0;
+         ddr_reads[ram_bank]=0;
+     end
+ end
+
+ always @(posedge clk) begin
+     if (ddr_req && ddr_ack) begin
+         if (ddr_we) ddr_writes[ddr_addr[16]] <= ddr_writes[ddr_addr[16]] + 1;
+         else ddr_reads[ddr_addr[16]] <= ddr_reads[ddr_addr[16]] + 1;
+         if (bus_lock) begin
+             if (ddr_we) atomic_write[ddr_addr[16]] <= 1;
+             else atomic_read[ddr_addr[16]] <= 1;
+             if (lcd_line_req && !lcd_line_ready) atomic_dma_overlap[ddr_addr[16]] <= 1;
+         end
+         if (!ddr_we && dut.wb_code) instruction_read[ddr_addr[16]] <= 1;
+     end
+     if (dut.game_pcm.player.tick && dut.game_pcm.player.play && !done_irq) begin
+         sample_count <= sample_count+1;
+         if (first_sample<0) first_sample <= cycles;
+         last_sample <= cycles;
+         sample_hash <= (sample_hash ^ {pcm_l,pcm_r}) * 32'd16777619;
+     end
+ end
+
+ task check_upp_ddr;
+     begin
+         if (atomic_read !== 2'b11 || atomic_write !== 2'b11 || atomic_dma_overlap !== 2'b11 ||
+             instruction_read !== 2'b11 || upp_ddr.clear_count != 1 ||
+             ddr_writes[0] != 260 || ddr_writes[1] != 260 || ddr_reads[0] < 260 || ddr_reads[1] < 260)
+             $fatal(1,"DDR owner counts upload=%0d/%0d NOS=%0d/%0d SWP=%b/%b with DMA=%b fetch=%b clears=%0d",
+                    ddr_reads[0],ddr_writes[0],ddr_reads[1],ddr_writes[1],
+                    atomic_read,atomic_write,atomic_dma_overlap,instruction_read,upp_ddr.clear_count);
+         if (sample_count != 128 || sample_hash !== 32'h175ee178 || last_sample-first_sample != 275167)
+             $fatal(1,"PCM samples=%0d hash=%h first=%0d last=%0d",
+                    sample_count,sample_hash,first_sample,last_sample);
+         $display("PASS production UPP DDR RAM upload=%0d/%0d NOS=%0d/%0d SWP with LCD DMA waiting=%b fetch=%b PCM hash=%h",
+                  ddr_reads[0],ddr_writes[0],ddr_reads[1],ddr_writes[1],
+                  atomic_dma_overlap,instruction_read,sample_hash);
+     end
+ endtask
diff --git a/tests/phone/upp_ddr_ram/peer.v b/tests/phone/upp_ddr_ram/peer.v
