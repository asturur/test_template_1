index 0000000..3753e6b
--- /dev/null
+++ b/scratch/v5-fit-loop/conservative-w-load-order/prepare-directed.py
@@ -0,0 +1,52 @@
+"""Add a measured warm WAW chain and precise external abort to the board guest."""
+from pathlib import Path
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-conservative-w-load-order/directed')
+out.mkdir(parents=True, exist_ok=True)
+fixture = stage / 'reference/tests/cpu/arm9v2_board'
+guest = (fixture / 'contract.S').read_text()
+fault = '    mov r6,#0\n    ldr r4,[r7,#32]\n    cmp r6,#1'
+assert guest.count(fault) == 1
+guest = guest.replace(fault, '''    mov r6,#0
+    mov r4,#0x55
+waw_fault:
+    ldr r4,[r7,#32]
+waw_fault_follower:
+    ldr r4,[r7,#40]
+    cmp r4,#0
+    bne fail
+    cmp r6,#1''')
+handler = 'data_abort:\n'
+assert guest.count(handler) == 1
+guest = guest.replace(handler, '''data_abort:
+    ldr r6,=waw_fault_follower+4
+    cmp lr,r6
+    bne 1f
+    cmp r4,#0x55
+    bne fail
+1:
+''')
+warm = '#ifdef SECTION_INDEX_TEST\n    mov r9,#0x10000000'
+assert guest.count(warm) == 1
+guest = guest.replace(warm, '''    ldr r2,=0x0a006040
+    mov r3,#0x37
+    str r3,[r2]
+    mov r3,#0x62
+    str r3,[r2,#4]
+    ldr r9,[r2]
+waw_begin:
+    .rept 32
+    ldr r9,[r2]
+    ldr r9,[r2,#4]
+    .endr
+waw_end:
+    cmp r9,#0x62
+    bne fail
+
+''' + warm)
+(out / 'guest.S').write_text(guest)
+bench = (fixture / 'contract.v').read_text()
+observer = (stage / 'board-waw.vh').read_text()
+(out / 'contract.v').write_text(bench.rsplit('endmodule', 1)[0] + observer + '\nendmodule\n')
diff --git a/scratch/v5-fit-loop/conservative-w-load-order/board-waw.vh b/scratch/v5-fit-loop/conservative-w-load-order/board-waw.vh
new file mode 100644
index 0000000..3cbff63
--- /dev/null
+++ b/scratch/v5-fit-loop/conservative-w-load-order/board-waw.vh
@@ -0,0 +1,89 @@
+`define WAW_CORE cpu.u_arm925t.u_zap.g_arm9.u_arm9_core
+`define WAW_EXEC `WAW_CORE.u_execute
+
+reg [31:0] waw_start, waw_stop, waw_fault_pc, waw_follower_pc;
+integer waw_wait_for_retirement;
+integer waw_first_cycle = -1, waw_retired = 0, waw_issued = 0;
+integer waw_opportunity_count = 0, waw_stall_count = 0;
+integer waw_fault_seen = 0, waw_fault_same_order = 0, waw_follower_seen = 0;
+reg [31:0] waw_previous_w, waw_previous_s;
+reg waw_release_held = 0;
+
+initial begin
+    if (!$value$plusargs("waw-start=%h", waw_start) ||
+        !$value$plusargs("waw-stop=%h", waw_stop) ||
+        !$value$plusargs("waw-fault=%h", waw_fault_pc) ||
+        !$value$plusargs("waw-follower=%h", waw_follower_pc) ||
+        !$value$plusargs("waw-conservative=%d", waw_wait_for_retirement))
+        $fatal(1, "Missing WAW test addresses");
+end
+
+wire [31:0] waw_w_pc = `WAW_CORE.w[526:495];
+wire [31:0] waw_s_pc = `WAW_CORE.d_pc;
+wire waw_s_in_range = waw_s_pc >= waw_start && waw_s_pc < waw_stop;
+wire waw_w_in_range = waw_w_pc >= waw_start && waw_w_pc < waw_stop;
+wire waw_release_opportunity = `WAW_CORE.s_wait_w_nohit && `WAW_CORE.w_load_hit &&
+    `WAW_CORE.wb_valid && `WAW_CORE.request_done && !`WAW_CORE.retry && !`WAW_CORE.resp_err &&
+    `WAW_EXEC.i_valid && `WAW_EXEC.s_admit_common &&
+    (!`WAW_EXEC.a_valid || `WAW_EXEC.a_finish_hit) &&
+    (!`WAW_EXEC.s_needs_w || !`WAW_EXEC.i_self_dep || `WAW_EXEC.i_load_trust) &&
+    !`WAW_EXEC.i_flush && !`WAW_EXEC.o_redirect;
+
+always @(posedge clk) if (!reset) begin
+    if (waw_release_held &&
+        (`WAW_CORE.w[541] && waw_w_pc == waw_previous_w ||
+         !`WAW_EXEC.accept || waw_s_pc != waw_previous_s))
+        $fatal(1, "Deferred WAW packet did not accept on the next edge");
+    waw_release_held <= 0;
+    if (waw_s_in_range && waw_release_opportunity) begin
+        if (!`WAW_CORE.wb_complete || !`WAW_CORE.done ||
+            `WAW_EXEC.accept !== (waw_wait_for_retirement == 0))
+            $fatal(1, "Unexpected trusted-load admission at %h", waw_s_pc);
+        waw_opportunity_count <= waw_opportunity_count + 1;
+        if (waw_wait_for_retirement != 0) begin
+            waw_stall_count <= waw_stall_count + 1;
+            waw_release_held <= 1;
+            waw_previous_w <= waw_w_pc;
+            waw_previous_s <= waw_s_pc;
+        end
+        $display("WAW_OPPORTUNITY cycle=%0d older=%h younger=%h stall=%b",
+                 cycle, waw_w_pc, waw_s_pc, !`WAW_EXEC.accept);
+    end
+    if (`WAW_EXEC.accept && waw_s_in_range) begin
+        if (waw_s_pc != waw_start + 4*waw_issued) $fatal(1, "WAW issue duplicated or reordered");
+        waw_issued <= waw_issued + 1;
+    end
+    if (`WAW_CORE.wb_complete && waw_w_in_range) begin
+        if (waw_w_pc != waw_start + 4*waw_retired || !`WAW_CORE.wb_valid || !`WAW_CORE.wb_pair ||
+            `WAW_CORE.wb_tag1 != 9 || `WAW_CORE.wb_data1 !== (waw_retired[0] ? 32'h62 : 32'h37))
+            $fatal(1, "WAW load retired out of order or with wrong value: %h data %h",
+                   waw_w_pc, `WAW_CORE.wb_data1);
+        if (waw_retired == 0) waw_first_cycle <= cycle;
+        waw_retired <= waw_retired + 1;
+        $display("WAW_RETIRED %h %h", waw_w_pc, `WAW_CORE.wb_data1);
+    end
+    if (`WAW_CORE.wb_complete && waw_w_pc == waw_fault_pc) begin
+        if (!`WAW_CORE.wb_dabt || `WAW_CORE.wb_valid || `WAW_EXEC.accept)
+            $fatal(1, "Faulting older writer did not flush younger execution");
+        waw_fault_seen <= waw_fault_seen + 1;
+        waw_fault_same_order <= waw_fault_same_order + `WAW_CORE.s_wait_w_nohit;
+    end
+    if (`WAW_CORE.wb_complete && waw_w_pc == waw_follower_pc) begin
+        if (waw_fault_seen != 1 || !`WAW_CORE.wb_valid || !`WAW_CORE.wb_pair ||
+            `WAW_CORE.wb_tag1 != 4 || `WAW_CORE.wb_data1 !== 0)
+            $fatal(1, "Wrong fault follower after %0d aborts: valid=%b load=%h",
+                   waw_fault_seen, `WAW_CORE.wb_valid, `WAW_CORE.wb_data1);
+        waw_follower_seen <= waw_follower_seen + 1;
+    end
+    if (`WAW_CORE.wb_complete && waw_w_pc == waw_stop) begin
+        if (waw_retired != 64 || waw_issued != 64 || waw_opportunity_count == 0 ||
+            waw_fault_seen != 1 || waw_follower_seen != 1)
+            $fatal(1, "Missing WAW coverage: issued=%0d retired=%0d opportunities=%0d faults=%0d follows=%0d",
+                   waw_issued, waw_retired, waw_opportunity_count, waw_fault_seen, waw_follower_seen);
+        $display("WAW_PASS clocks=%0d issued=%0d retired=%0d opportunities=%0d stalls=%0d fault=%0d fault_same_order=%0d follower=%0d",
+                 cycle-waw_first_cycle, waw_issued, waw_retired, waw_opportunity_count, waw_stall_count,
+                 waw_fault_seen, waw_fault_same_order, waw_follower_seen);
+    end
+end
+`undef WAW_EXEC
+`undef WAW_CORE
diff --git a/scratch/v5-fit-loop/conservative-w-load-order/directed.sh b/scratch/v5-fit-loop/conservative-w-load-order/directed.sh
new file mode 100644
index 0000000..1c918d1
--- /dev/null
+++ b/scratch/v5-fit-loop/conservative-w-load-order/directed.sh
@@ -0,0 +1,54 @@
+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/conservative-w-load-order
+out=build/sim/v5-104-conservative-w-load-order/directed
+fixture=$area/reference/tests/cpu/arm9v2_board
+python3 -B "$area/prepare-directed.py"
+arm-none-eabi-gcc -c -mcpu=arm920t -marm -DEXPECTED_CTYPE=0x0514a14a -DASSOC_WAYS=2 \
+  -DSECTION_INDEX_TEST -I "$fixture" "$out/guest.S" -o "$out/guest.o"
+arm-none-eabi-ld -T "$area/reference/sim/programs/link.ld" "$out/guest.o" -o "$out/guest.elf"
+arm-none-eabi-objcopy -O binary "$out/guest.elf" "$out/guest.bin"
+python3 -B - "$out" <<'PY'
+from pathlib import Path
+import struct
+import sys
+
+out = Path(sys.argv[1])
+words = struct.iter_unpack('<I', (out / 'guest.bin').read_bytes())
+(out / 'guest.hex').write_text(''.join(f'{word:08x}\n' for (word,) in words))
+PY
+entry() { arm-none-eabi-nm "$out/guest.elf" | awk -v "name=$1" '$3 == name { print $1 }'; }
+for leg in reference source; do
+  flag=0
+  if [ "$leg" = source ]; then flag=1; fi
+  mkdir -p "$out/$leg"
+  docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$area/$leg:/work:ro" -v "$PWD/$out:/results" -w /work \
+    --entrypoint sh jotego/simulator:arm64 -ec '
+      out=/results/$1
+      shift
+      verilator --binary --timing --assert -j 2 -Wno-fatal -Wno-lint -DNGAGE_ARM9V2 \
+        --top-module contract --Mdir "$out/obj" rtl/ngage_cpu.sv rtl/ngage_upp.v \
+        rtl/arm9v2/arm925t_phone.v rtl/arm9v2/upstream/sim/stubs/*.sv \
+        /results/contract.v > "$out/build.log" 2>&1
+      for burst in 0 1; do
+        for wait in 0 5; do
+          log="$out/burst-$burst-wait-$wait.log"
+          "$out/obj/Vcontract" +program=/results/guest.hex "+wait=$wait" "+burst=$burst" \
+            +half-writeback +section-reads=2 "$@" > "$log" 2>&1
+          grep "^PASS " "$log"
+          grep "^WAW_PASS " "$log"
+          grep "^WAW_RETIRED " "$log" > "${log%.log}.ordered"
+        done
+      done
+    ' directed "$leg" "+waw-conservative=$flag" "+waw-start=$(entry waw_begin)" \
+      "+waw-stop=$(entry waw_end)" "+waw-fault=$(entry waw_fault)" "+waw-follower=$(entry waw_fault_follower)" \
+      > "$out/$leg.pass"
+done
+for burst in 0 1; do
+  for wait in 0 5; do
+    name=burst-$burst-wait-$wait.ordered
+    cmp "$out/reference/$name" "$out/source/$name"
+  done
+done
+cat "$out/reference.pass" "$out/source.pass"
diff --git a/scratch/v5-fit-loop/conservative-w-load-order/guard-proof.py b/scratch/v5-fit-loop/conservative-w-load-order/guard-proof.py
new file mode 100644
index 0000000..a7c103a
--- /dev/null
+++ b/scratch/v5-fit-loop/conservative-w-load-order/guard-proof.py
@@ -0,0 +1,73 @@
+"""Extract the real RTL guard and generate its exhaustive binary comparison."""
+from pathlib import Path
+import re
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-conservative-w-load-order/guard-proof')
+out.mkdir(parents=True, exist_ok=True)
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+old = (stage / 'reference' / rtl).read_text()
+new = (stage / 'source' / rtl).read_text()
+old_guard = re.search(r'wire s_wait_w_hit = (.*?);', old, re.S)[1]
+new_guard = re.search(r'wire s_wait_w_hit = (.*?);', new, re.S)[1]
+parameter = re.search(r'parameter WAW_WAIT_RETIRE = [^;]+;', new)[0]
+assert parameter.endswith("1'b0;")
+assert new.count(".WAW_WAIT_RETIRE(1'b1)") == 1
+source = f"""
+module guard(input wire [6:0] controls, output wire wait_load);
+    {parameter}
+    wire s_wait_w_nohit = controls[0];
+    wire hit = controls[1];
+    wire load_trust = controls[2];
+    wire wb_valid = controls[3];
+    wire request_done = controls[4];
+    wire retry = controls[5];
+    wire resp_err = controls[6];
+    wire s_wait_w_hit = {new_guard};
+    assign wait_load = hit ? s_wait_w_hit : s_wait_w_nohit;
+endmodule
+
+module tb;
+    reg [6:0] controls;
+    wire old_wait, default_wait, conservative_wait;
+    wire s_wait_w_nohit = controls[0];
+    wire hit = controls[1];
+    wire load_trust = controls[2];
+    wire wb_valid = controls[3];
+    wire request_done = controls[4];
+    wire retry = controls[5];
+    wire resp_err = controls[6];
+    wire old_hit = {old_guard};
+    assign old_wait = hit ? old_hit : s_wait_w_nohit;
+    guard default_mode(controls, default_wait);
+    guard #(.WAW_WAIT_RETIRE(1'b1)) phone_mode(controls, conservative_wait);
+    integer vector, fault_cases = 0, added_cases = 0, empty_cases = 0;
+    initial begin
+        for (vector = 0; vector < 128; vector = vector + 1) begin
+            controls = vector[6:0];
+            #1;
+            if (default_wait !== old_wait || conservative_wait !== s_wait_w_nohit)
+                $fatal(1, "Guard mismatch for %b", controls);
+            if (s_wait_w_nohit && resp_err) begin
+                if (!old_wait || !conservative_wait) $fatal(1, "Fault bypassed an older writer");
+                fault_cases = fault_cases + 1;
+            end
+            if (!s_wait_w_nohit) begin
+                if (old_wait || conservative_wait) $fatal(1, "No W writer could still stall");
+                empty_cases = empty_cases + 1;
+            end
+            if (old_wait != conservative_wait) begin
+                if (controls !== 7'b0011111) $fatal(1, "Extra wait did not require a successful trusted hit");
+                added_cases = added_cases + 1;
+            end
+        end
+        if (fault_cases != 32 || added_cases != 1 || empty_cases != 64)
+            $fatal(1, "Coverage counters disagreed");
+        $display("PASS WAW guard vectors=128 same_destination_fault_cases=%0d changed_vectors=%0d no_writer_cases=%0d",
+                 fault_cases, added_cases, empty_cases);
+        $finish;
+    end
+endmodule
+"""
+(out / 'tb.v').write_text(source)
diff --git a/scratch/v5-fit-loop/conservative-w-load-order/record-qualification.py b/scratch/v5-fit-loop/conservative-w-load-order/record-qualification.py
new file mode 100644
index 0000000..2bf9bad
--- /dev/null
+++ b/scratch/v5-fit-loop/conservative-w-load-order/record-qualification.py
@@ -0,0 +1,150 @@
+"""Verify workload order and summarize the measured W-load admission cost."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-conservative-w-load-order')
+retained_mixed = Path('build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed')
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+
+
+def sha(file):
+    return sha256(file.read_bytes()).hexdigest()
+
+
+def match(trial, retained):
+    assert trial.read_bytes() == retained.read_bytes(), trial
+    return sha(trial)
+
+
+def record(line, prefix):
+    assert line.startswith(prefix)
+    return {key: int(value) for key, value in re.findall(r'(\w+)=(-?\d+)', line)}
+
+
+def line(file, prefix):
+    [found] = [row for row in file.read_text().splitlines() if row.startswith(prefix)]
+    return found
+
+
+def git(*args):
+    return subprocess.check_output(['git', *args], text=False)
+
+
+base = git('rev-parse', '11c4a0c').decode().strip()
+tree = git('rev-parse', '11c4a0c^{tree}').decode().strip()
+assert git('rev-parse', 'e9552bd^{tree}').decode().strip() == tree
+source_hashes = {name: sha(stage / 'source' / name) for name in (rtl, generator)}
+for name in source_hashes:
+    assert (stage / 'reference' / name).read_bytes() == git('show', f'{base}:{name}')
+receipt = {
+    'status': 'PASS',
+    'base': base,
+    'base_tree': tree,
+    'patch_sha256': sha(stage / 'conservative-w-load-order.patch'),
+    'fixture_sha256': sha(stage / 'conservative-w-load-order-replay.patch'),
+    'source_sha256': source_hashes,
+    'simulator': (out / 'image.id').read_text().strip(),
+}
+proof = record(line(out / 'guard-proof/run.log', 'PASS WAW guard '), 'PASS WAW guard ')
+assert proof == {'vectors': 128, 'same_destination_fault_cases': 32,
+                 'changed_vectors': 1, 'no_writer_cases': 64}
+receipt['guard'] = proof
+
+board = []
+directed = []
+for burst in (0, 1):
+    for wait in (0, 5):
+        name = f'burst-{burst}-wait-{wait}'
+        controls = out / 'board/reference'
+        candidate = out / 'board/source'
+        trace = match(candidate / f'{name}.trace', controls / f'{name}.trace')
+        board.append({'burst': burst, 'wait': wait, 'trace_sha256': trace,
+                      'clocks': record(line(candidate / f'{name}.log', 'PASS '), 'PASS ')['cycles']})
+        controls = out / 'directed/reference'
+        candidate = out / 'directed/source'
+        ordered = match(candidate / f'{name}.ordered', controls / f'{name}.ordered')
+        old = record(line(controls / f'{name}.log', 'WAW_PASS '), 'WAW_PASS ')
+        new = record(line(candidate / f'{name}.log', 'WAW_PASS '), 'WAW_PASS ')
+        assert old['issued'] == new['issued'] == old['retired'] == new['retired'] == 64
+        assert old['fault'] == new['fault'] == old['follower'] == new['follower'] == 1
+        assert old['stalls'] == 0 and new['stalls'] == new['opportunities'] > 0
+        directed.append({'burst': burst, 'wait': wait, 'ordered_retire_sha256': ordered,
+                         'retained': old, 'candidate': new, 'clock_delta': new['clocks'] - old['clocks']})
+receipt['board_profiles'] = board
+receipt['directed_waw'] = directed
+
+for kind, case_count in (('fixed', 15), ('native', 1)):
+    old_path = out / 'retained' / f'{kind}.json'
+    new_path = out / 'candidate' / f'{kind}.json'
+    old = json.loads(old_path.read_text())
+    new = json.loads(new_path.read_text())
+    assert old['status'] == new['status'] == 'PASS'
+    assert old['netlist_sha256'] == sha(stage / 'reference' / rtl)
+    assert new['netlist_sha256'] == source_hashes[rtl]
+    assert old['source_sha256'] == new['source_sha256']
+    for leg, expected in (('retained', old), ('candidate', new)):
+        leg_dir = out / leg
+        filename = f'{kind}-candidate-cpu.v'
+        assert sha(leg_dir / filename) == expected['netlist_sha256']
+        manifest = leg_dir / f'obj-{kind}/Vtb__verFiles.dat'
+        assert sum(row.startswith('S ') and row.endswith(f'"/work/{filename}"')
+                   for row in manifest.read_text().splitlines()) == 1
+    assert len(old['rows']) == len(new['rows']) == case_count
+    rows = []
+    window_name, clock_key, windows = ('windows', 'cycles', 7) if kind == 'fixed' else ('frames', 'clocks', 4)
+    for old_row, new_row in zip(old['rows'], new['rows'], strict=True):
+        before, after = old_row['candidate'], new_row['candidate']
+        assert before['case'] == after['case'] and old_row['control'] == new_row['control']
+        assert before['architecture'] == after['architecture']
+        assert len(before[window_name]) == len(after[window_name]) == windows
+        for name in ('wb_writes', 'waw', 'architecture'):
+            assert len(before[name]) == len(after[name]) == windows
+        ordered = [(item['writes'], item['ordered_hash']) for item in after['waw']]
+        assert ordered == [(item['writes'], item['ordered_hash']) for item in before['waw']]
+        timed = [x['write_hash'] == y['write_hash']
+                 for x, y in zip(before['wb_writes'], after['wb_writes'], strict=True)]
+        retained_cycles = [item[clock_key] for item in before[window_name]]
+        candidate_cycles = [item[clock_key] for item in after[window_name]]
+        delta = [b-a for a, b in zip(retained_cycles, candidate_cycles, strict=True)]
+        stalls = [item['blocked'] for item in after['waw']]
+        result = {'case': before['case'], 'retained_cycles': retained_cycles, 'candidate_cycles': candidate_cycles,
+                  'clock_delta': delta, 'median_delta': after['median'] - before['median'],
+                  'retained_median': before['median'], 'candidate_median': after['median'],
+                  'eligible_retained': [item['accepted'] for item in before['waw']],
+                  'held_candidate': stalls, 'ordered_write_counts': [count for count, _ in ordered],
+                  'ordered_write_hashes': [f'{digest:016x}' for _, digest in ordered],
+                  'cycle_stamped_write_hash_matches': timed}
+        if kind == 'native':
+            assert before['output_sha256'] == after['output_sha256']
+            result['output_sha256'] = after['output_sha256']
+            result['total_delta'] = sum(delta)
+            result['delta_pct'] = 100 * sum(delta) / sum(retained_cycles)
+        else:
+            for leg in ('retained', 'candidate'):
+                wrong = out / leg / f"{before['case']}-00-0-wrong.log"
+                assert 'Guest output check rejected payload' in wrong.read_text()
+            result['wrong_output_rejected'] = True
+        rows.append(result)
+    receipt[kind] = {'measured_windows': case_count * windows,
+                     'retained_receipt_sha256': sha(old_path), 'candidate_receipt_sha256': sha(new_path),
+                     'rows': rows}
+
+mixed = out / 'mixed'
+old_sources = json.loads((retained_mixed / 'source-hashes.json').read_text())
+new_sources = json.loads((mixed / 'source-hashes.json').read_text())
+assert old_sources.keys() == new_sources.keys() and len(new_sources) == 114
+assert {name: digest for name, digest in new_sources.items() if digest != old_sources[name]} == {rtl: source_hashes[rtl]}
+traffic = mixed / 'traffic.log'
+data = match(traffic, retained_mixed / 'traffic.log')
+assert len(traffic.read_bytes().splitlines()) == 171496
+mixed_summary = line(mixed / 'replay.log', 'PASS authored ARM CMD24 ')
+assert 'cycles=1201547' in mixed_summary
+receipt['mixed'] = {'events': 171496, 'clocks': 1201547, 'trace_sha256': data, 'source_count': 114}
+(stage / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
+print('PASS conservative W-load order: 128 guard vectors, four board and WAW profiles, 105 fixed windows, four native frames, 171496 mixed events')
