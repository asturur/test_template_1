+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/mmc-footer-timer-combined
+timer=scratch/v5-fit-loop/timer-write-prepare
+out=build/sim/v5-104-mmc-footer-timer-combined
+private="$area/dispatch-20261126"
+mkdir -p "$area/reference" "$area/source" "$out/units/source"
+for leg in reference source; do
+  revision=11c4a0c
+  if [ "$leg" = source ]; then revision=$(cat "$private/footer-plus-timer.sha"); fi
+  env GIT_OBJECT_DIRECTORY="$PWD/$private/objects" \
+    GIT_ALTERNATE_OBJECT_DIRECTORIES="$(cat "$private/alternate-objects.txt")" \
+    git archive "$revision" rtl tools sys .rules.verible_format tests/phone/mmc_hps \
+      tests/cpu/arm9v2_board tests/cpu/spmark_payload tests/phone/upp_ddr_ram/peer.v \
+      sim/programs/link.ld | tar -x -C "$area/$leg"
+done
+cp "$timer/architectural_trace.vh" "$timer/wb-write-trace.vh" "$area"
+cp "$area/source/rtl/ngage_cpu.sv" "$area/ngage_cpu.sv"
+python3 -B "$area/mixed.py"
+docker image inspect -f '{{.Id}} {{.Os}}/{{.Architecture}}' jotego/simulator:arm64 > "$out/image.id"
+
+for kind in fixed native; do
+  python3 -B "$area/replay.py" "$kind" --output qualification > "$out/$kind.log"
+done
+
+MMC_HPS_OUT=/results/source docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD/$area/source:/bench:ro" -v "$PWD/$out/units:/results" -w /bench \
+  -e MMC_HPS_OUT --entrypoint sh jotego/simulator:arm64 tests/phone/mmc_hps/run.sh > "$out/units/source.log"
+
+mixed="$out/mixed"
+retained=build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed
+docker run --rm --pull=never --network none --platform linux/arm64 \
+  -v "$PWD:/work" -w /work --entrypoint sh jotego/simulator:arm64 \
+  -ec "sh '$mixed/build.sh'
+'$mixed/obj/Vtb' +upp_stress '+compare_trace=$mixed/traffic.log' > '$mixed/replay.log'"
+cmp "$retained/traffic.log" "$mixed/traffic.log"
+sh "$area/coexistence.sh"
+python3 -B "$area/record.py"
diff --git a/scratch/v5-fit-loop/mmc-footer-timer-combined/record.py b/scratch/v5-fit-loop/mmc-footer-timer-combined/record.py
new file mode 100644
index 0000000..50edce2
--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-footer-timer-combined/record.py
@@ -0,0 +1,95 @@
+"""Confirm the combined MMC footer and UPP timer qualification inputs and traces."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shlex
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+out = root / 'build/sim/v5-104-mmc-footer-timer-combined'
+original = root / 'docs/evidence/v5-104-mmc-footer-crc-direct.json'
+prepared = area / 'dispatch-20261126/prepare.json'
+retained = root / 'build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed'
+footer_path = 'rtl/ngage_mmc_hps.v'
+crc_original = json.loads(original.read_bytes())
+plan = json.loads(prepared.read_bytes())
+stack = plan['variants']['footer-plus-timer']
+pinned = {name: value for name, value in stack['hashes_from_retained'].items() if name.startswith('rtl/')}
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def read_json(path):
+    return json.loads(path.read_bytes())
+
+
+def passes(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+def fingerprints(manifest, sources):
+    items = [shlex.split(line) for line in manifest.read_text().splitlines() if line.startswith('S ')]
+    result = {}
+    for name in sources:
+        (row,) = [row for row in items if row[-1].endswith(name)]
+        result[name] = row[-2]
+    return result
+
+
+assert len(pinned) == 4 and all(digest(area / 'source' / name) == sha for name, sha in pinned.items())
+assert crc_original['status'] == 'PASS'
+assert pinned[footer_path] == crc_original['candidate_sha256']
+
+mixed = out / 'mixed'
+physical_hashes = read_json(mixed / 'source-hashes.json')
+baseline_hashes = read_json(retained / 'source-hashes.json')
+assert len(physical_hashes) == 114 and physical_hashes.keys() == baseline_hashes.keys()
+assert {name: value for name, value in physical_hashes.items() if baseline_hashes[name] != value} == pinned
+compiled = fingerprints(mixed / 'obj/Vtb__verFiles.dat', pinned)
+
+workloads = {}
+for kind, field, expected in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    results = read_json(receipt)
+    assert results['status'] == 'PASS'
+    assert all(row['candidate'] == row['control'] for row in results['rows'])
+    count = sum(len(row['candidate'][field]) for row in results['rows'])
+    assert count == expected
+    assert {name: results['source_sha256'][Path(name).name] for name in pinned} == pinned
+    assert fingerprints(out / f'qualification/obj-{kind}/Vtb__verFiles.dat', pinned) == compiled
+    workloads[kind] = {'count': count, 'receipt_sha256': digest(receipt)}
+native = results['rows'][0]['candidate']
+workloads['native']['cycles'] = [row['clocks'] for row in native['frames']]
+workloads['native']['guest_result_sha256'] = native['output_sha256']
+
+suite = out / 'units/source.log'
+assert passes(suite) == crc_original['direct_and_native_hps']['passes']
+actual_hash = fingerprints(out / 'units/source/obj/Vactual_tb__verFiles.dat', [footer_path])
+assert actual_hash[footer_path] == compiled[footer_path]
+assert actual_hash[footer_path] == crc_original['direct_and_native_hps']['candidate_source_fingerprint']
+
+physical = {}
+overlap = out / 'coexistence'
+for name, base_trace, trace, log, count, cycles in (
+    ('normal', retained / 'traffic.log', mixed / 'traffic.log', mixed / 'replay.log', 171496, 1201547),
+    ('timer_mmc_lcd', overlap / 'retained.trace', overlap / 'candidate.trace',
+     overlap / 'candidate.log', 171497, 1201528),
+):
+    assert digest(base_trace) == digest(trace)
+    assert len(trace.read_bytes().splitlines()) == count
+    assert len(passes(log)) == 4 and f'cycles={cycles} reads=4 writes=1' in passes(log)[-1]
+    physical[name] = {'events': count, 'cycles': cycles, 'traffic_sha256': digest(trace),
+                      'passes': passes(log)}
+assert passes(overlap / 'retained.log') == passes(overlap / 'candidate.log')
+physical['timer_mmc_lcd']['guest_sha256'] = digest(overlap / 'stress-timer.hex')
+
+report = {'status': 'PASS', 'candidate': stack['sha'], 'tree': stack['tree'],
+          'fit_preflight_sha256': digest(prepared), 'standalone_footer_qualification_sha256': digest(original),
+          'simulator': (out / 'image.id').read_text().strip(), 'verified_source_sha256': pinned,
+          'compiled_source_fingerprints': compiled, 'physical_source_count': len(physical_hashes),
+          'native_hps_pass': passes(suite), 'workload_digest_controls': workloads,
+          'physical_replays': physical}
+(area / 'qualification.json').write_text(json.dumps(report, indent=2) + '\n')
