+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/a-right-payload
+out=build/sim/v5-104-a-right-payload/proof
+python3 -B "$area/prepare-proof.py"
+python3 - "$out" <<'PY'
+from pathlib import Path
+import sys
+
+out = Path(sys.argv[1])
+preamble = (out / 'tb.sv').read_text().split('    task compare;', 1)[0]
+preamble = preamble.replace('module execute_right_tb;', 'module vacant_address_tb;')
+preamble = preamble.replace('reference_execute old_dut', "reference_execute #(.S_AGU(1'b0)) old_dut")
+preamble = preamble.replace('.RIGHT_PAYLOAD_FREE(FREE)', ".RIGHT_PAYLOAD_FREE(FREE), .S_AGU(1'b0)")
+(out / 'vacant-address.sv').write_text(preamble + """
+    task pulse;
+        begin
+            #5 i_clk = 1;
+            #5 i_clk = 0;
+            #1;
+        end
+    endtask
+
+    initial begin
+        i_reset = 1;
+        pulse();
+        i_reset = 0;
+        i_admit = 1;
+        i_ready = 1;
+        i_valid = 1;
+        i_kind = 5;
+        i_condition = 4'he;
+        i_used = 4'b0011;
+        i_early = 4'b0011;
+        i_writes = 1;
+        i_dest = 6'd2;
+        i_instruction = 32'he5912004; // LDR r2, [r1, #4]
+        #1;
+        if (!old_dut.accept || !new_dut.accept)
+            $fatal(1, "The legal load was not admitted");
+        pulse();
+        if (!old_o_a_valid || !new_o_a_valid ||
+            old_o_address != 32'h4 || new_o_address != old_o_address)
+            $fatal(1, "The admitted load address differed old=%h new=%h left=%h right=%h",
+                   old_o_address, new_o_address, old_dut.left_a, old_dut.right_a);
+        i_valid = 0;
+        i_instruction = 32'he59120c4; // unused payload on the next S cycle
+        #1;
+        if (!old_dut.finish || !new_dut.finish || old_dut.accept || new_dut.accept)
+            $fatal(1, "The witness needs a finish edge without S admission");
+        pulse();
+        if (old_o_a_valid || new_o_a_valid || old_o_address != 32'h4 ||
+            new_o_address != (FREE ? 32'hc4 : 32'h4))
+            $fatal(1, "Unexpected non-S-AGU vacant address old=%h new=%h",
+                   old_o_address, new_o_address);
+        $display("PASS vacant address S_AGU=0 mode=%0d accepted=00000004 invalid_old=%h invalid_new=%h",
+                 FREE, old_o_address, new_o_address);
+        $finish;
+    end
+endmodule
+""")
+PY
+docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$area:/trial:ro" -v "$PWD/$out:/results" -w /results \
+    --entrypoint sh jotego/simulator:arm64 -ec '
+    for free in 0 1; do
+        verilator --binary --timing -DSYNTHESIS -j 2 -Wno-fatal --top-module vacant_address_tb \
+            --Mdir "obj-witness-$free" -GFREE="$free" /trial/source/rtl/arm9v2/arm925t_phone.v \
+            reference.v vacant-address.sv > "build-witness-$free.log" 2>&1
+        "./obj-witness-$free/Vvacant_address_tb" > "run-witness-$free.log"
+        grep "^PASS " "run-witness-$free.log"
+    done'
