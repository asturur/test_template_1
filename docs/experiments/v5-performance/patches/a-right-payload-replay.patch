index 0000000..c87d1bf
--- /dev/null
+++ b/scratch/v5-fit-loop/a-right-payload/prepare-fit.py
@@ -0,0 +1,246 @@
+"""Prepare both private A-right histories and verify the production source manifests."""
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+root = area.parents[2]
+w_area = area.parent / 'w-completion-prepare'
+prior = area.parent / 'w-completion-upp/dispatch-20261126'
+private = area / 'followup-20261126'
+objects = private / 'objects'
+objects.mkdir(parents=True, exist_ok=True)
+combined = area.parent / 'a-right-w-completion'
+base = 'ab75a622a80a5aedae347f63ae195f3da965815a'
+public_w = 'e2249e46c0bd47ab85539cff9416a51214c1ea05'
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+changed = [rtl, generator]
+design = area / 'a-right-payload.patch'
+
+
+def sha(data):
+    return sha256(data).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+alternates = os.pathsep.join(dict.fromkeys(
+    [str(prior / 'objects'), *(prior / 'alternate-objects.txt').read_text().strip().split(os.pathsep)]))
+assert all(Path(path).is_absolute() and Path(path).is_dir() for path in alternates.split(os.pathsep))
+(private / 'alternate-objects.txt').write_text(alternates + '\n')
+
+
+def env_for(label):
+    return os.environ | {'GIT_OBJECT_DIRECTORY': str(objects), 'GIT_ALTERNATE_OBJECT_DIRECTORIES': alternates,
+                         'GIT_INDEX_FILE': str(private / f'index-{label}')}
+
+
+def git(*args, env, data=None):
+    return subprocess.check_output(['git', '-C', str(root), *args], env=env, input=data)
+
+
+def revision(value, env):
+    return git('rev-parse', value, env=env).decode().strip()
+
+
+def tree(value, env):
+    return revision(f'{value}^{{tree}}', env)
+
+
+def files(before, after, env):
+    return git('diff', '--name-only', before, after, env=env).decode().splitlines()
+
+
+def blob(rev, path, env):
+    return git('show', f'{rev}:{path}', env=env)
+
+
+def commit(tree_id, parent, message, env):
+    timestamp = int(git('show', '-s', '--format=%ct', parent, env=env)) + 1
+    date = f'@{timestamp} +0000'
+    result = git('commit-tree', tree_id, '-p', parent, '-m', message,
+                 env=env | {'GIT_AUTHOR_DATE': date, 'GIT_COMMITTER_DATE': date}).decode().strip()
+    assert revision(f'{result}^', env) == parent and tree(result, env) == tree_id
+    return result
+
+
+def modules(source):
+    return {match[1]: match[0] for match in re.finditer(rb'^module (\w+) .*?^endmodule', source, re.M | re.S)}
+
+
+def replace_once(text, needle, replacement):
+    assert text.count(needle) == 1, needle
+    return text.replace(needle, replacement, 1)
+
+
+def combine_generator(base_blob, eager, prepared):
+    # The two adjacent functions and two adjacent dispatch calls are the
+    # only shared hunk. Prove each transform is otherwise exactly its own patch.
+    a_call = b'        generated = capture_a_right_payload(generated)\n'
+    w_call = b'        generated = prepare_w_completion(generated)\n'
+    anchor = b'def split_execute_readiness(phone):'
+    a_func = re.search(rb'^def capture_a_right_payload\(phone\):.*?(?=^def )', eager, re.M | re.S)[0]
+    w_func = re.search(rb'^def prepare_w_completion\(phone\):.*?(?=^def )', prepared, re.M | re.S)[0]
+    old_prefix = b'        generated = issue_hinted_ldm(generated, edit)\n'
+    for source, function, call in ((eager, a_func, a_call), (prepared, w_func, w_call)):
