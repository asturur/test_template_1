+assert match(out / 'hold/reference.trace', out / 'hold/trial.trace') == a_receipt['physical']['warm_hold']['sha256']
+match(out / 'hold/reference.pass', out / 'hold/trial.pass')
+
+for profile, rows in a_receipt['boards'].items():
+    for name, data in rows.items():
+        if profile == 'normal':
+            before, after = (f'board/{leg}/{name}' for leg in ('reference', 'source'))
+        else:
+            before, after = (f'board/trusted-waw/{leg}-{name}' for leg in ('reference', 'source'))
+        assert match(out / after, out / before) == data['trace_sha256']
+        assert match(out / after, standalone / after) == data['trace_sha256']
+        summary['board_trace_sha256'][after] = data['trace_sha256']
