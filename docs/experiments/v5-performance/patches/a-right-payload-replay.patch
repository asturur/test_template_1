+    summary['workloads'][kind] = {'count': expected_count, 'receipt_sha256': digest(out / relative)}
+(both / 'qualification.json').write_text(json.dumps(summary, indent=2) + '\n')
+print('PASS exact W plus A right generator, execute miter, eight board profiles, fixed/native and four pin modes')
