+docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD:/work" -w /work --entrypoint sh jotego/simulator:arm64 -ec "
+    for leg in reference trial; do
+        sh '$out/'\$leg-build.sh
+        '$out/'\$leg-obj/Vtb +upp_stress +hold '+compare_trace=$out/'\$leg.trace > '$out/'\$leg.log
