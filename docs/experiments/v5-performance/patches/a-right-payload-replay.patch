+"""Seal A right operand and exact workload/board replays on the two-cut control."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+
+
+area = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-a-right-payload')
+base_run = Path('build/sim/v5-104-refill-payload-combined')
+base = 'ab75a622a80a5aedae347f63ae195f3da965815a'
+base_tree = '57cc1a796acc9b15a61522ccf2397230f38e9799'
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+paths = [rtl, generator]
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def match(trial, original):
+    assert trial.read_bytes() == original.read_bytes(), (trial, original)
+    return digest(trial)
+
+
+def modules(source):
+    return {m[1]: m[0] for m in re.finditer(rb'^module (\w+) .*?^endmodule', source, re.M | re.S)}
+
+
+def fingerprint(manifest, path):
+    [row] = [shlex.split(line) for line in manifest.read_text().splitlines()
+             if line.startswith('S ') and shlex.split(line)[-1].endswith(path)]
+    return row[-2]
+
+
+patch = area / 'a-right-payload.patch'
+fixtures = area / 'a-right-payload-replay.patch'
+stat = subprocess.check_output(['git', 'apply', '--numstat', str(patch)], text=True)
+assert [line.split('\t')[-1] for line in stat.splitlines()] == paths
+candidate_tree = (area / 'design-tree.sha').read_text().strip()
+assert re.fullmatch(r'[a-f0-9]{40}', candidate_tree)
+before, after = [{path: digest(area / leg / path) for path in paths} for leg in ('reference', 'source')]
+reference, trial = [modules((area / leg / rtl).read_bytes()) for leg in ('reference', 'source')]
+assert reference.keys() == trial.keys()
+assert [name for name in reference if reference[name] != trial[name]] == [b'ngage2_arm9v2_core', b'ngage2_arm9v2_execute']
+hinted = match(area / 'hinted/source' / rtl, area / 'hinted/reference' / rtl)
+assert b'RIGHT_PAYLOAD_FREE' not in (area / 'hinted/source' / rtl).read_bytes()
+
+proof = {}
+for mode in (0, 1):
+    log = out / f'proof/run-{mode}.log'
+    contents = log.read_text()
+    assert f'PASS A right mode={mode}' in contents
+    [counters] = [line for line in contents.splitlines() if line.startswith('A right ')]
+    values = {name: int(value) for name, value in re.findall(r'(\w+)=(\d+)', counters)}
+    assert values['mode'] == mode and values['clocks'] == 50000
+    assert values['vacant_diff'] == (30566 if mode else 0)
+    proof[str(mode)] = {'counters': values, 'sha256': digest(log)}
+assert proof['0']['counters'].keys() == proof['1']['counters'].keys()
+assert all(proof['0']['counters'][key] == proof['1']['counters'][key]
+           for key in proof['0']['counters'].keys() - {'mode', 'vacant_diff'})
+witness = {}
+for mode, new in ((0, '00000004'), (1, '000000c4')):
+    log = out / f'proof/run-witness-{mode}.log'
+    assert f'PASS vacant address S_AGU=0 mode={mode} accepted=00000004 invalid_old=00000004 invalid_new={new}' in log.read_text()
+    witness[str(mode)] = {'prior_address': '00000004', 'vacant_address': new, 'sha256': digest(log)}
+
+boards = {}
+for suite in ('normal', 'abort_alignment'):
+    rows = {}
+    for burst in (0, 1):
+        for wait in (0, 5):
+            profile = f'burst-{burst}-wait-{wait}.trace'
+            if suite == 'normal':
+                ref = out / 'board/reference' / profile
+                new = out / 'board/source' / profile
+            else:
+                ref = out / 'board/trusted-waw' / f'reference-{profile}'
+                new = out / 'board/trusted-waw' / f'source-{profile}'
+            data = new.read_text()
+            cycles = int(re.search(r'^PASS cycles=(\d+)', data, re.M)[1])
+            assert 'swp_beats=2 clean_writes=1 walks=2 prefetch_aborts=1' in data
+            rows[profile] = {'cycles': cycles, 'trace_sha256': match(new, ref)}
+    boards[suite] = rows
+
+mixed = out / 'mixed'
+reference_mixed = base_run / 'mixed'
+manifest = load(mixed / 'source-hashes.json')
+original = load(reference_mixed / 'source-hashes.json')
+assert manifest.keys() == original.keys() and len(manifest) == 114
+assert {name: value for name, value in manifest.items() if value != original[name]} == {rtl: after[rtl]}
+assert all(digest(mixed / 'source' / name) == sha for name, sha in manifest.items())
+compiled = fingerprint(mixed / 'obj/Vtb__verFiles.dat', f'{mixed}/source/{rtl}')
+assert fingerprint(out / 'board/source/obj/Vcontract__verFiles.dat', rtl) == compiled
+assert fingerprint(out / 'board/reference/obj/Vcontract__verFiles.dat', rtl) != compiled
+assert fingerprint(out / 'hold/trial-obj/Vtb__verFiles.dat', rtl) == compiled
+
+physical = {}
+for label, name, prior, count, cycles in (
+    ('normal', 'mixed/traffic.log', base_run / 'mixed/traffic.log', 171496, 1201547),
+    ('timer_mmc_lcd', 'coexistence/candidate.trace', base_run / 'coexistence/candidate.trace', 171497, 1201528),
+    ('cpu_block_eviction', 'block-guest/source.trace', base_run / 'block-guest/source.trace', 172060, 1204706),
+    ('warm_hold', 'hold/trial.trace', out / 'hold/reference.trace', 171518, 1203504),
+):
+    trace = out / name
+    log = (mixed / 'replay.log' if label == 'normal' else trace.with_suffix('.log')).read_text()
+    assert len(trace.read_bytes().splitlines()) == count
+    assert f'persisted512bytes+PIOreadback cycles={cycles}' in log
+    physical[label] = {'events': count, 'clocks': cycles, 'sha256': match(trace, prior)}
+assert match(out / 'hold/reference.pass', out / 'hold/trial.pass')
+assert physical['warm_hold']['sha256'] == load(area.parent / 'upp-claim-refill-payload/qualification.json')['physical']['warm_hold']['trace_sha256']
+
+workloads = {}
+for kind, field, count in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    result, old = [load(path) for path in (receipt, base_run / f'qualification/{kind}.json')]
+    assert result['status'] == old['status'] == 'PASS'
+    assert result['rows'] == old['rows']
+    assert result['netlist_sha256'] == after[rtl] and old['netlist_sha256'] == before[rtl]
+    assert result['wrapper_sha256'] == old['wrapper_sha256'] and result['source_sha256'] == old['source_sha256']
+    copied = out / f'qualification/{kind}-candidate-cpu.v'
+    assert digest(copied) == after[rtl]
+    assert fingerprint(out / f'qualification/obj-{kind}/Vtb__verFiles.dat', f'/work/{copied.name}') == compiled
+    assert sum(len(row['candidate'][field]) for row in result['rows']) == count
+    workloads[kind] = {'count': count, 'receipt_sha256': digest(receipt)}
+    if kind == 'fixed':
+        cases = [row['candidate']['case'] for row in result['rows']]
+        assert len(set(cases)) == 15
+        for case in cases:
+            assert (out / f'qualification/{case}-00-1.log').is_file()
+            assert 'Guest output check rejected payload' in (out / f'qualification/{case}-00-0-wrong.log').read_text()
+        workloads[kind].update(repeated=15, wrong_output_checks=15)
+    else:
+        native = result['rows'][0]['candidate']
+        frame_cycles = [x['clocks'] for x in native['frames']]
+        assert frame_cycles == [14391395, 14467552, 14346201, 14303223]
+        workloads[kind].update(frame_cycles=frame_cycles, output_sha256=native['output_sha256'])
+
+summary = {'status': 'PASS', 'fit_disposition': 'PARK', 'production_capture_enabled': False,
+           'production_s_agu': False, 'base': base, 'base_tree': base_tree, 'candidate_tree': candidate_tree,
+           'design_patch_sha256': digest(patch), 'replay_patch_sha256': digest(fixtures),
+           'reference_sha256': before, 'source_sha256': after, 'unchanged_hinted_ldm_sha256': hinted,
+           'proof': proof, 'production_geometry_execute_witness': witness,
+           'boards': boards, 'workloads': workloads, 'physical': physical,
+           'mixed_source_count': len(manifest), 'compiled_cpu_fingerprint': compiled,
+           'simulator_image': (out / 'image.id').read_text().strip(), 'routes_sha256': digest(area / 'routes.json'),
+           'candidate_routed': False}
+(area / 'qualification.json').write_text(json.dumps(summary, indent=2) + '\n')
+print('PASS A right-operand miter, exact alternate generator, eight board profiles, fixed/native and four pin modes')
diff --git a/scratch/v5-fit-loop/a-right-payload/prepare-fit.py b/scratch/v5-fit-loop/a-right-payload/prepare-fit.py
