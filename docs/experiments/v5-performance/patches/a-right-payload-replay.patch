+#!/bin/sh
+set -eu
+area=scratch/v5-fit-loop/a-right-payload
+board=build/sim/v5-104-a-right-payload/board
+out=$board/trusted-waw
+fixture=$area/reference/tests/cpu/arm9v2_board
+mkdir -p "$out"
+python3 -B - "$fixture/contract.S" "$out/guest.S" <<'PY'
+from pathlib import Path
+import sys
+
+original, guest = map(Path, sys.argv[1:])
+source = original.read_text()
+marker = "    mov r6,#0\n    ldr r4,[r7,#32]\n"
+assert source.count(marker) == 1
+aligned = """    // An alignment abort must leave the older destination intact.
+    mrc p15,0,r3,c1,c0,0
+    orr r2,r3,#2
+    mcr p15,0,r2,c1,c0,0
+    mov r6,#0
+    mov r4,#0x51
+    add r2,r8,#1
+    ldr r4,[r2]
+    cmp r4,#0x51
+    bne fail
+    cmp r6,#1
+    bne fail
+    mrc p15,0,r4,c5,c0,0
+    and r4,r4,#15
+    cmp r4,#1
+    bne fail
+    mcr p15,0,r3,c1,c0,0
+
+"""
+waw = """    mov r6,#0
+    mov r4,#0x55
+    ldr r4,[r7,#32]
+trusted_waw_follower:
+    ldr r4,[r7,#40]
+    cmp r4,#0
+    bne fail
+"""
+handler_marker = "data_abort:\n"
+assert source.count(handler_marker) == 1
+handler_check = """    ldr r6,=trusted_waw_follower+4
+    cmp lr,r6
+    bne 1f
+    cmp r4,#0x55
+    bne fail
+1:
+"""
+guest.write_text(source.replace(marker, aligned + waw).replace(
+    handler_marker, handler_marker + handler_check))
+PY
+arm-none-eabi-gcc -c -mcpu=arm920t -marm -DEXPECTED_CTYPE=0x0514a14a -DASSOC_WAYS=2 \
+    -DSECTION_INDEX_TEST -I "$fixture" "$out/guest.S" -o "$out/guest.o"
+arm-none-eabi-ld -T "$area/reference/sim/programs/link.ld" "$out/guest.o" -o "$out/guest.elf"
+arm-none-eabi-objcopy -O binary "$out/guest.elf" "$out/guest.bin"
+python3 -B - "$out" <<'PY'
+from pathlib import Path
+import struct
+import sys
+
+out = Path(sys.argv[1])
+(out / 'guest.hex').write_text(''.join(f'{word:08x}\n'
+    for (word,) in struct.iter_unpack('<I', (out / 'guest.bin').read_bytes())))
+PY
+docker run --rm --pull=never --network none --platform linux/arm64 \
+    -v "$PWD/$board:/results" -w /results --entrypoint sh jotego/simulator:arm64 -ec '
+    for leg in reference source; do
+        for burst in 0 1; do
+            for wait in 0 5; do
+                log="trusted-waw/$leg-burst-$burst-wait-$wait.log"
+                "$leg/obj/Vcontract" +program=/results/trusted-waw/guest.hex \
+                    "+wait=$wait" "+burst=$burst" +half-writeback +section-reads=2 > "$log" 2>&1
+                grep -q "^PASS " "$log"
+            done
+        done
+    done'
+for burst in 0 1; do
+    for wait in 0 5; do
+        name=burst-$burst-wait-$wait.log
+        for leg in reference source; do
+            grep -E '^(PASS|LINES|ASSOC|SECTION|DATA_FAULT|REFILL_FAULT) ' \
+                "$out/$leg-$name" > "$out/$leg-${name%.log}.trace"
+        done
+        cmp "$out/reference-${name%.log}.trace" "$out/source-${name%.log}.trace"
+        grep '^PASS ' "$out/source-${name%.log}.trace"
+    done
+done
