+    assert w_control['netlist_sha256'] == w_receipt['source_sha256'][rtl]
+    assert trial['source_sha256'] == solo['source_sha256'] == w_control['source_sha256']
+    assert trial['wrapper_sha256'] == solo['wrapper_sha256'] == w_control['wrapper_sha256']
+    copied = f'{kind}-candidate-cpu.v'
+    assert digest(out / 'qualification' / copied) == trial['netlist_sha256']
