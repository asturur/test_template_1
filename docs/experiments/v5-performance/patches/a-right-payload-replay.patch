+"""Match exact stacked integration outputs and compiled provenance against W-only."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import re
+import shlex
+
+
+area = Path(__file__).resolve().parent
+both = area.parent / 'a-right-w-completion'
+out = Path('build/sim/v5-104-a-right-w-completion')
+upstream = Path('build/sim/v5-104-w-completion-prepare')
+standalone = Path('build/sim/v5-104-a-right-payload')
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+generator = 'tools/gen_arm9v2_phone.py'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def load(path):
+    return json.loads(path.read_bytes())
+
+
+def match(trial, before):
+    assert trial.read_bytes() == before.read_bytes(), (trial, before)
+    return digest(trial)
+
+
+def fingerprint(manifest, path):
+    [row] = [shlex.split(line) for line in manifest.read_text().splitlines()
+             if line.startswith('S ') and shlex.split(line)[-1].endswith(path)]
+    return row[-2]
+
+
+lineage = load(area / 'followup-20261126/prepare.json')['variants']['a-right-on-w']
+w_receipt = load(area.parent / 'w-completion-prepare/qualification.json')
+a_receipt = load(area / 'qualification.json')
+for name in (rtl, generator):
+    assert digest(both / 'source' / name) == lineage['sha256_from_two_cut'][name]
+    assert digest(both / 'reference' / name) == w_receipt['source_sha256'][name]
+hinted = match(both / 'hinted/source' / rtl, both / 'hinted/reference' / rtl)
+assert hinted == a_receipt['unchanged_hinted_ldm_sha256']
+assert 'RIGHT_PAYLOAD_FREE' not in (both / 'hinted/source' / rtl).read_text()
+assert 'w_completion_eligible' not in (both / 'hinted/source' / rtl).read_text()
+
+proof = {}
+for mode in (0, 1):
+    log = out / f'proof/run-{mode}.log'
+    contents = log.read_text()
+    assert f'PASS A right mode={mode}' in contents
+    [line] = [line for line in contents.splitlines() if line.startswith('A right ')]
+    counts = {name: int(value) for name, value in re.findall(r'(\w+)=(\d+)', line)}
+    assert counts == a_receipt['proof'][str(mode)]['counters']
+    proof[str(mode)] = {'counters': counts, 'sha256': digest(log)}
+
+mixed = load(out / 'mixed/source-hashes.json')
+old_mixed = load(upstream / 'mixed/source-hashes.json')
+assert mixed.keys() == old_mixed.keys() and len(mixed) == 114
+assert {name: sha for name, sha in mixed.items() if sha != old_mixed[name]} == {rtl: lineage['sha256_from_two_cut'][rtl]}
+assert all(digest(out / 'mixed/source' / name) == value for name, value in mixed.items())
+compiled = fingerprint(out / 'mixed/obj/Vtb__verFiles.dat', rtl)
+old_compiled = fingerprint(upstream / 'mixed/obj/Vtb__verFiles.dat', rtl)
+assert compiled != old_compiled
+assert fingerprint(out / 'hold/trial-obj/Vtb__verFiles.dat', rtl) == compiled
+assert fingerprint(out / 'hold/reference-obj/Vtb__verFiles.dat', rtl) == old_compiled
+assert fingerprint(out / 'board/source/obj/Vcontract__verFiles.dat', rtl) == compiled
+assert fingerprint(out / 'board/reference/obj/Vcontract__verFiles.dat', rtl) == old_compiled
+
+summary = {'status': 'PASS', 'fit_disposition': 'PARK', 'production_capture_enabled': False,
+           'production_s_agu': False, 'candidate': lineage['sha'], 'tree': lineage['tree'], 'parent': lineage['parent'],
+           'source_sha256': lineage['sha256_from_two_cut'], 'compiled_cpu_fingerprint': compiled,
+           'mixed_source_count': len(mixed), 'unchanged_hinted_ldm_sha256': hinted, 'miter': proof,
+           'physical': {}, 'board_trace_sha256': {}, 'workloads': {},
+           'simulator_image': (out / 'image.id').read_text().strip(), 'candidate_routed': False}
