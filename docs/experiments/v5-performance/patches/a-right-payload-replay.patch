diff --git a/scratch/v5-fit-loop/a-right-payload/prepare-proof.py b/scratch/v5-fit-loop/a-right-payload/prepare-proof.py
new file mode 100644
index 0000000..237369d
--- /dev/null
+++ b/scratch/v5-fit-loop/a-right-payload/prepare-proof.py
@@ -0,0 +1,197 @@
+"""Generate an exact dual-execute test that qualifies inactive A payload fields."""
+from pathlib import Path
+import re
+
+
+area = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-a-right-payload/proof')
+out.mkdir(parents=True, exist_ok=True)
+rtl = 'rtl/arm9v2/arm925t_phone.v'
+cpu_execute = 'ngage2_arm9v2_execute'
+
+
+def module(leg, name):
+    source = (area / leg / rtl).read_text()
+    return re.search(rf'^module {name} \(.*?^endmodule$', source, re.M | re.S)[0]
+
+
+def ports(source):
+    declarations = re.findall(
+        r'^\s*(?:\(\*[^\n]*\*\)\s*)?(input|output) (?:wire|reg) (?:signed )?'
+        r'(\[\d+:0\] )?(\w+);$', source, re.M)
+    names = {name.strip() for name in source.split('(', 1)[1].split(');', 1)[0].split(',')}
+    result = {name: (direction, width) for direction, width, name in declarations if name in names}
+    assert names == result.keys()
+    return result
+
+
+old, new = [module(leg, cpu_execute) for leg in ('reference', 'source')]
+interface = ports(old)
+assert interface == ports(new)
+core = [module(leg, 'ngage2_arm9v2_core') for leg in ('reference', 'source')]
+assert core[1].replace(',\n        .RIGHT_PAYLOAD_FREE(PAYLOAD_FREE && S_AGU)', '') == core[0]
+for name in ('ready_if_hit', 'ready_if_nohit', 'a_finish_hit', 'a_finish_nohit', 'product_phase', 'space'):
+    pattern = rf'\b{name} = [^;]*;'
+    assert re.search(pattern, old)[0] == re.search(pattern, new)[0]
+assert re.search(r'if \(capture_right_payload\)\n +a\[249-:32\] <= s_right_payload;', new)
+assert new.count('a[249-:32] <=') == 3
+(out / 'reference.v').write_text(old.replace(f'module {cpu_execute} (', 'module reference_execute (', 1))
+
+bench = ['`timescale 1ns/1ps', 'module execute_right_tb;', '    parameter FREE = 1;',
+         "    integer sample, seed = 32'h5224d9a8;",
+         '    integer admitted = 0, replaced = 0, blocked_space = 0, prepared_clocks = 0;',
+         '    integer valid_return = 0, held_return = 0, dual_return = 0;',
+         '    integer nohit_blocks = 0, hit_blocks = 0, hit_releases = 0;',
+         '    integer flushed = 0, redirected = 0, product_clocks = 0, smull_launch = 0;',
+         '    integer invalid_operand_difference = 0;',
+         '    integer mem_imm12 = 0, mem_imm8 = 0, block_offset = 0, bx_swp = 0, suffix = 0;']
+for name, (direction, width) in interface.items():
+    if direction == 'input':
+        bench.append(f"    reg {width}{name} = '0;")
+    else:
+        bench.append(f'    wire {width}old_{name}, new_{name};')
+for leg, instantiation in (('old', 'reference_execute'),
+                           ('new', f'{cpu_execute} #(.RIGHT_PAYLOAD_FREE(FREE))')):
+    bench.append(f'    {instantiation} {leg}_dut (')
+    bench.append(',\n'.join(f'        .{name}({name if direction == "input" else f"{leg}_{name}"})'
+                            for name, (direction, _) in interface.items()))
+    bench.append('    );')
+bench += ['    task compare;', '        begin']
+qualified = {'o_cpsr_next', 'o_result', 'o_alu_address', 'o_psr_source', 'o_store_data', 'o_record_thumb'}
+assert qualified <= interface.keys()
+for name, (direction, _) in interface.items():
+    if direction == 'output':
+        guard = '(!FREE || old_o_a_valid) && ' if name in qualified else ''
+        bench.append(f'            if ({guard}old_{name} !== new_{name}) '
+                     f'$fatal(1, "Changed {name} at cycle %0d", sample);')
+for field in ('a[515:250]', 'a[217:0]', 'held', 'held_amount', 'held_rot', 'held_offset', 'flags',
+              'interrupt_mask', 'block_base', 'prepared', 'holding', 's_pending', 'a_wait', 's_wait',
+              'return_a_match', 'multiply_product_ready', 'full_product', 'accept', 'finish', 'launch_smull'):
+    bench.append(f'            if (old_dut.{field} !== new_dut.{field}) '
+                 f'$fatal(1, "Changed {field} at cycle %0d", sample);')
+bench += [
+    '            if ((!FREE || old_o_a_valid) && old_dut.a[249:218] !== new_dut.a[249:218])',
+    '                $fatal(1, "Changed owned A right operand at cycle %0d", sample);',
+    '            if (new_dut.accept && !new_dut.space) $fatal(1, "Admission without A space");',
+    '            if (new_dut.space !== (i_load_hit ? (!new_o_a_valid || new_dut.a_finish_hit) :',
+    '                                                 (!new_o_a_valid || new_dut.a_finish_nohit)))',
+    '                $fatal(1, "A space mismatches its selected hit arm");',
+    '        end',
+    '    endtask',
+    '''    initial begin
+        i_reset = 1;
+        #5 i_clk = 1;
+        #5 i_clk = 0;
+        for (sample = 0; sample < 50000; sample++) begin''',
+]
+controlled = {'i_clk', 'i_reset', 'i_flush', 'i_kind', 'i_valid', 'i_ready', 'i_admit', 'i_load_wait'}
+for name, (direction, _) in interface.items():
+    if direction == 'input' and name not in controlled:
+        entropy = ', '.join('$random(seed)' for _ in range(4))
+        bench.append(f'            {name} = {{{entropy}}};')
+
+bench += [
+    '''            i_reset = sample % 97 == 0;
+            i_flush = sample % 61 == 0;
+            i_valid = sample % 5 != 0;
+            i_ready = sample % 7 != 0;
+            i_admit = sample % 11 != 0;
+            i_load_wait = sample % 13 == 0;
+            i_kind = sample % 15;
+            if (sample % 3 != 0) i_condition = 4'he;
+
+            // Force both late S-return ports with a definite vacant slot.
+            // Catch priority over the immediate form as the packet enters A.
+            if (sample % 128 == 0 || sample % 128 == 32 || sample % 128 == 63 || sample % 128 == 96)
+                i_reset = 1;
+            if (sample % 128 == 1 || sample % 128 == 33 || sample % 128 == 64 || sample % 128 == 97) begin
+                i_reset = 0;
+                i_flush = 0;
+                i_valid = 1;
+                i_kind = 5;
+                i_instruction = 32'he5900020;
+                i_condition = 4'he;
+                i_admit = 1;
+                i_pending = 4'b0010;
+                i_used = 4'b0010;
+                i_early = 4'b0000;
+                i_forward_match = 0;
+                i_next_load_owner = 0;
+                i_load_wait = 0;
+                i_load_wait_nohit = 0;
+                i_load_wait_hit = 0;
+                i_reg_shift = 0;
+                i_return_ready = sample % 128 == 1;
+                i_return_s_match = 4'b0010;
+                i_return_select = i_return_ready ? '1 : '0;
+                i_return_next_valid = 1;
+                i_return_next_tag = i_tag[6+:6];
+                if (sample % 128 == 33)
+                    i_instruction = 32'he1d002b8;
+                if (sample % 128 == 97) begin
+                    i_kind = 14;
+                    i_instruction = 32'he0c10392;
+                    i_fault = 0;
+                    i_thumb = 0;
+                    i_pending = 0;
+                    i_early = 4'b0110;
+                    i_used = 4'b0110;
+                end
+            end
+            if (sample % 128 == 65) begin
+                i_reset = 0;
+                i_flush = 0;
+                i_ready = 0;
+                i_return_ready = 1;
+                i_return_select = '1;
+            end
+
+            #4;
+            compare();
+            if (new_dut.accept) begin
+                admitted++;
+                if (new_dut.finish) replaced++;
+                if (!new_dut.ready_if_nohit) hit_releases++;
+                if (i_kind == 5 && i_instruction[27:26] == 1 && !i_instruction[25]) mem_imm12++;
+                if (i_kind == 5 && i_instruction[27:26] == 0 && i_instruction[22]) mem_imm8++;
+                if (i_kind == 6) block_offset++;
+                if (i_kind == 4 || i_kind == 12) bx_swp++;
+                if (i_kind == 11) suffix++;
+                if (i_used[1] && !i_early[1] && new_dut.s_wait[1] && !(|i_forward_match[4+:4]) &&
+                    |new_dut.s_return_match[3:2]) begin
+                    valid_return++;
+                    if (&new_dut.s_return_match[3:2]) dual_return++;
+                end
+            end
+            if (new_o_a_valid && !new_dut.finish && new_dut.a_wait[1] &&
+                !(|new_dut.a[133+:4]) && |new_dut.a_return_match[3:2]) held_return++;
+            if (i_valid && new_dut.space && !new_dut.accept) blocked_space++;
+            if (i_valid && new_dut.space && !new_dut.accept && !i_load_hit && i_load_wait_nohit) nohit_blocks++;
+            if (i_valid && new_dut.space && !new_dut.accept && i_load_hit && i_load_wait_hit) hit_blocks++;
+            if (new_dut.prepared) prepared_clocks++;
+            if (new_dut.launch_smull) smull_launch++;
+            if (new_dut.product_phase) product_clocks++;
+            if (i_flush) flushed++;
+            if (new_o_redirect) redirected++;
+            #1 i_clk = 1;
+            #4 compare();
+            if (!new_o_a_valid && old_dut.a[249:218] !== new_dut.a[249:218]) invalid_operand_difference++;
+            #1 i_clk = 0;
+        end
+        $display("A right mode=%0d clocks=%0d admitted=%0d replaced=%0d blocked_space=%0d prepared=%0d live_return=%0d held_return=%0d dual_return=%0d nohit_block=%0d hit_block=%0d hit_release=%0d flush=%0d redirect=%0d product=%0d smull=%0d imm12=%0d imm8=%0d block=%0d bx_swp=%0d suffix=%0d vacant_diff=%0d",
+             FREE, sample, admitted, replaced, blocked_space, prepared_clocks, valid_return, held_return, dual_return,
+             nohit_blocks, hit_blocks, hit_releases, flushed, redirected, product_clocks, smull_launch,
+             mem_imm12, mem_imm8, block_offset, bx_swp, suffix, invalid_operand_difference);
+        if (!(admitted > 0 && replaced > 0 && blocked_space > 0 && prepared_clocks > 0 &&
+              valid_return > 0 && held_return > 0 && dual_return > 0 && nohit_blocks > 0 &&
+              hit_blocks > 0 && hit_releases > 0 && flushed > 0 && redirected > 0 &&
+              product_clocks > 0 && smull_launch > 0 && mem_imm12 > 0 && mem_imm8 > 0 &&
+              block_offset > 0 && bx_swp > 0 && suffix > 0))
+            $fatal(1, "Missing directed operand phase");
+        if ((invalid_operand_difference > 0) != FREE) $fatal(1, "Unexpected vacant payload behavior");
+        $display("PASS A right mode=%0d", FREE);
+        $finish;
+    end
+endmodule''',
+]
+(out / 'tb.sv').write_text('\n'.join(bench) + '\n')
