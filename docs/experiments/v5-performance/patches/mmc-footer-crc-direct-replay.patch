+++ b/scratch/v5-fit-loop/mmc-footer-crc-direct/prepare-verify.py
@@ -0,0 +1,74 @@
+"""Extend the pinned HPS direct test with CRC cycle and interruption checks."""
+from pathlib import Path
+
+
+stage = Path(__file__).resolve().parent
+out = Path('build/sim/v5-104-mmc-footer-crc-direct/verify')
+out.mkdir(parents=True, exist_ok=True)
+bench = (stage / 'reference/tests/phone/mmc_hps/tb.v').read_text()
+summary = '    $display("PASS MMC HPS direct cases=%0d mounts=%0d copies=%0d clocks=%0d"'
+assert bench.count(summary) == 1
+bench = bench.replace(summary, '''    // Corrupt each data byte in both protected footer records.
+    for (j = 0; j < 30; j = j + 1) begin
+      make_footer(0);
+      if (j < 15) footer[16+j] = footer[16+j] ^ 1;
+      else footer[32+j-15] = footer[32+j-15] ^ 1;
+      do_mount(2048);
+      wait_mount;
+      base_falls = ack_falls;
+      footer_read(256);
+      expect_fault;
+      if (ack_falls != base_falls) fail("corrupted CRC payload completed");
+    end
+
+    // Interrupt the CRC pass with each ownership-changing event, then check a new footer.
+    for (j = 0; j < 3; j = j + 1) begin
+      make_footer(0);
+      do_mount(2048);
+      wait_mount;
+      begin_read((size >> 9) - 1, 0);
+      accept_read;
+      for (n = 0; n < 256; n = n + 1) beat(n, {footer[n*2+1], footer[n*2]});
+      @(negedge clk);
+      h_ack = 0;
+      repeat (8) tick;
+      if (dut.state != dut.VERIFY || !ack || fault || dut.crc_left >= 15)
+        fail("missing active VERIFICATION pass");
+      // Another unselected slot's shared bus strobe cannot modify the footer.
+      base_copies = copies;
+      beat(8, 16'hbadd);
+      if (dut.state != dut.VERIFY || copies != base_copies || fault)
+        fail("shared bus strobe entered VERIFY");
+      base_falls = ack_falls;
+      base_mounts = mounts;
+      @(negedge clk);
+      case (j)
+        0: guest_reset = 1;
+        1: init_reset = 1;
+        2: begin size = 1024; mount = 1; end
+      endcase
+      tick;
+      if (dut.state != dut.IDLE || ack || dut.admitted || fault)
+        fail("interrupted CRC verification completed");
+      @(negedge clk);
+      guest_reset = 0;
+      init_reset = 0;
+      mount = 0;
+      settle;
+      if (ack_falls != base_falls) fail("interrupted CRC exposed an ACK fall");
+      if (j == 1) begin
+        if (!card_reset || mounts != base_mounts) fail("init inferred a stale remount");
+        do_mount(2048);
+        wait_mount;
+      end else if (mounts != base_mounts + 1 || card_size != size)
+        fail("CRC cancellation lost retained/remounted media");
+      footer_read(256);
+      if (fault || !dut.admitted) fail("fresh CRC verification failed");
+    end
+''' + summary)
+monitor = '''
+  always @(negedge clk) if (dut.state == dut.VERIFY)
+    $display("CRC_EDGE clock=%0d byte=%0d cid=%h csd=%h ack=%b admitted=%b fault=%b",
+             cycles, dut.crc_left, dut.cid_crc, dut.csd_crc, ack, dut.admitted, fault);
+'''
+(out / 'tb.v').write_text(bench.rsplit('endmodule', 1)[0] + monitor + 'endmodule\n')
diff --git a/scratch/v5-fit-loop/mmc-footer-crc-direct/record-qualification.py b/scratch/v5-fit-loop/mmc-footer-crc-direct/record-qualification.py
new file mode 100644
index 0000000..f6224c3
--- /dev/null
+++ b/scratch/v5-fit-loop/mmc-footer-crc-direct/record-qualification.py
@@ -0,0 +1,107 @@
+"""Verify compressed evidence and record the MMC footer CRC qualification."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import shlex
+import subprocess
+
+
+stage = Path(__file__).resolve().parent
+root = stage.parents[2]
+out = root / 'build/sim/v5-104-mmc-footer-crc-direct'
+old_mixed = root / 'build/sim/v5-104-more-ram-prepared-wb-write-data-pin-mixed/mixed'
+rtl = 'rtl/ngage_mmc_hps.v'
+base = '11c4a0c32983cc9aba89cae986684558583a33f2'
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def git(*args):
+    return subprocess.check_output(['git', *args], cwd=root)
+
+
+def fingerprint(path):
+    rows = [shlex.split(line) for line in path.read_text().splitlines()
+            if line.startswith('S ') and line.endswith(f'{rtl}"')]
+    (row,) = rows
+    return row[-2]
+
+
+def pass_lines(path):
+    return [line for line in path.read_text().splitlines() if line.startswith('PASS ')]
+
+
+assert git('show', f'{base}:{rtl}') == (stage / 'reference' / rtl).read_bytes()
+patch = stage / 'mmc-footer-crc-direct.patch'
+assert git('apply', '--numstat', str(patch)).decode().rstrip().split('\t')[-1] == rtl
+assert digest(stage / 'reference' / rtl) != digest(stage / 'source' / rtl)
+assert (stage / 'source' / rtl).read_bytes() == (out / 'mixed/source' / rtl).read_bytes()
+assert b'ngage_mmc_hps backing' in (out / 'mixed/source/tests/phone/mmc_mister/tb.v').read_bytes()
+
+units = out / 'units'
+candidate_passes = pass_lines(units / 'source.pass')
+assert candidate_passes == pass_lines(units / 'reference.pass')
+assert len(candidate_passes) == 2 and 'cases=48' in candidate_passes[0]
+assert 'card_reads=20 writes=4' in candidate_passes[1]
+unit_trial = fingerprint(units / 'source/obj/Vactual_tb__verFiles.dat')
+unit_reference = fingerprint(units / 'reference/obj/Vactual_tb__verFiles.dat')
+mixed_trial = fingerprint(out / 'mixed/obj/Vtb__verFiles.dat')
+assert unit_trial == mixed_trial and unit_trial != unit_reference
+
+crc_trace = out / 'verify/source.trace'
+assert crc_trace.read_bytes() == (out / 'verify/reference.trace').read_bytes()
+crc_edges = sum(line.startswith('CRC_EDGE ') for line in crc_trace.read_text().splitlines())
+crc_passes = pass_lines(crc_trace)
+assert crc_edges == 1186 and len(crc_passes) == 1 and 'cases=82' in crc_passes[0]
+
+mixed = out / 'mixed'
+traffic = mixed / 'traffic.log'
+traffic_entries = len(traffic.read_bytes().splitlines())
+assert traffic_entries == 171496 and digest(traffic) == digest(old_mixed / traffic.name)
+mixed_passes = pass_lines(mixed / 'replay.log')
+assert len(mixed_passes) == 4
+assert 'persisted512bytes+PIOreadback cycles=1201547 reads=4 writes=1' in mixed_passes[-1]
+mixed_hashes = json.loads((mixed / 'source-hashes.json').read_bytes())
+ref_hashes = json.loads((old_mixed / 'source-hashes.json').read_bytes())
+assert len(mixed_hashes) == 114 and mixed_hashes.keys() == ref_hashes.keys()
+assert [name for name, value in mixed_hashes.items() if value != ref_hashes[name]] == [rtl]
+assert mixed_hashes[rtl] == digest(stage / 'source' / rtl)
+
+workload = {}
+for kind, key, expected in (('fixed', 'windows', 105), ('native', 'frames', 4)):
+    receipt = out / f'qualification/{kind}.json'
+    data = json.loads(receipt.read_bytes())
+    assert data['status'] == 'PASS'
+    assert all(row['candidate'] == row['control'] for row in data['rows'])
+    count = sum(len(row['candidate'][key]) for row in data['rows'])
+    assert count == expected
+    workload[kind] = {'count': count, 'upstream_receipt_sha256': digest(receipt)}
+native = data['rows'][0]['candidate']
+workload['native']['cycle_counts'] = [frame['clocks'] for frame in native['frames']]
+workload['native']['guest_result_sha256'] = native['output_sha256']
+
+receipt = {
+    'status': 'PASS',
+    'base': base,
+    'base_tree': git('rev-parse', f'{base}^{{tree}}').decode().strip(),
+    'changed_source': rtl,
+    'reference_sha256': digest(stage / 'reference' / rtl),
+    'candidate_sha256': digest(stage / 'source' / rtl),
+    'design_patch_sha256': digest(patch),
+    'fixture_patch_sha256': digest(stage / 'mmc-footer-crc-direct-replay.patch'),
+    'simulator': (out / 'image.id').read_text().strip(),
+    'direct_and_native_hps': {'passes': candidate_passes,
+                              'reference_source_fingerprint': unit_reference,
+                              'candidate_source_fingerprint': unit_trial},
+    'crc_cancel_and_corroboration': {'verify_edge_rows': crc_edges, 'passes': crc_passes,
+                                    'fixture_sha256': digest(out / 'verify/tb.v'),
+                                    'trace_sha256': digest(crc_trace)},
+    'workload_digest_controls': workload,
+    'physical_sdram_mixed': {'source_count': len(mixed_hashes),
+                             'source_fingerprint': mixed_trial,
+                             'traffic_events': traffic_entries,
+                             'traffic_sha256': digest(traffic), 'passes': mixed_passes},
+}
+(stage / 'qualification.json').write_text(json.dumps(receipt, indent=2) + '\n')
