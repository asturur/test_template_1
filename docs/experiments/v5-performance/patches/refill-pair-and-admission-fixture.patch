+`timescale 1ns/1ps
+
+module stage_tb;
+    reg clk = 0, reset = 1, request = 0, code = 0, candidate = 0;
+    reg [31:0] address = 0;
+    reg [2:0] cti = 0;
+    reg valid = 0, last = 0;
+    reg [63:0] data = 0;
+    always #5 clk = !clk;
+    wire accepted, error, trusted, scalar, line_req;
+    wire [31:0] delivered, line_addr;
+    ngage_arm9v2_refill #(.ENABLE(1)) dut (
+        .clk(clk), .reset(reset), .study_cpu_code(code), .cpu_cyc(request),
+        .cpu_lock(1'b0), .cpu_line_candidate(candidate), .cpu_address(address),
+        .cpu_write(1'b0), .cpu_sel(4'hf), .cpu_cti(cti), .cpu_bte(2'b0),
+        .cpu_ack(accepted), .cpu_error(error), .cpu_no_late_error(trusted),
+        .cpu_data(delivered), .wb_cyc(scalar), .wb_ack(1'b1), .wb_error(1'b0),
+        .wb_data(32'haaaa5555), .line_req(line_req), .line_addr(line_addr),
+        .line_ready(1'b1), .line_reject(1'b0), .line_valid(valid),
+        .line_data(data), .line_wide(1'b1), .line_last(last), .line_error(1'b0),
+        .line_no_late_error(1'b1)
+    );
+    integer clocks = 0;
+    always @(posedge clk) clocks <= clocks+1;
+    task automatic burst(input bit fetch, input int base);
+        int delay, grant, first;
+        @(negedge clk);
+        candidate = 1;
+        request = 1;
+        code = fetch;
+        address = base;
+        cti = 3'b010;
+        delay = 0;
+        forever begin
+            @(posedge clk);
+            if (scalar || accepted || error) $fatal(1, "line admission leaked to scalar");
+            if (line_req) begin
+                if (line_addr != base) $fatal(1, "wrong line address");
+                break;
+            end
+            delay++;
+        end
+        if (delay != (($test$plusargs("delay_d_refill") && !fetch) ? 1 : 0))
+            $fatal(1, "D-only stage had wrong cost code=%0d delay=%0d", fetch, delay);
+        grant = clocks;
+        fork
+            begin
+                for (integer i = 0; i < 4; i++) begin
+                    @(negedge clk);
+                    valid = 1;
+                    data = {32'(32'h12340001 + 2*i), 32'(32'h12340000 + 2*i)};
+                    last = i == 3;
+                end
+                @(negedge clk);
+                valid = 0;
+                last = 0;
+            end
+            begin
+                for (integer i = 0; i < 8; i++) begin
+                    do @(posedge clk); while (!accepted);
+                    if (i == 0) first = clocks-grant;
+                    if (clocks-grant != 2+i || delivered !== 32'h12340000 + i || !trusted)
+                        $fatal(1, "critical/return cadence changed at word %0d", i);
+                    @(negedge clk);
+                    address = address + 4;
+                    candidate = 0;
+                    cti = i == 6 ? 3'b111 : 3'b010;
+                end
+            end
+        join
+        request = 0;
+        $display("STAGE code=%0d offer_wait=%0d first_after_grant=%0d", fetch, delay, first);
+    endtask
+
+    initial begin
+        repeat (3) @(negedge clk);
+        reset = 0;
+        burst(0, 'h0a000000);
+        burst(1, 'h200);
+        @(negedge clk);
+        request = 1;
+        address = 'h0c120400;
+        candidate= 0;
+        cti = 0;
+        @(posedge clk);
+        if (!scalar || !accepted || line_req || trusted || delivered != 'haaaa5555)
+            $fatal(1, "scalar/MMIO response timing changed");
+        $display("PASS D-only admission and unchanged scalar and refill cadence");
+        $finish;
+    end
+    initial begin #5000; $fatal(1, "stage watchdog"); end
+endmodule
