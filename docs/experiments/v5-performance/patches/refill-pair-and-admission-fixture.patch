+`define RF_CORE dut.board.upp.cpu_inside.cpu
+`define RF_DONOR `RF_CORE.u_arm925t
+`define RF_BRIDGE `RF_CORE.refill
+`define RF_ZAP `RF_DONOR.u_zap
+reg rf_instruction = 0, rf_wide = 0;
+reg [31:0] rf_lines [0:1];
+reg [31:0] rf_delayed;
+reg [31:0] rf_pairs [0:7], rf_exposed [0:7], rf_word_acks [0:7];
+wire rf_older_work = retire || `RF_DONOR.dbg_wb_valid || `RF_DONOR.dbg_wb_dvalid;
+wire rf_data_demand = `RF_DONOR.dbg_stall[0] || `RF_ZAP.g_arm9.u_arm9_core.request;
+wire rf_d_exposed = !rf_older_work && rf_data_demand &&
+    !`RF_ZAP.l_generate_with_cache_mmu.u_data_cache.tlb_busy;
+wire rf_i_exposed = !rf_older_work && !rf_data_demand && !(|`RF_DONOR.dbg_stall[7:3]) &&
+    `RF_DONOR.dbg_stall[2] && `RF_DONOR.dbg_icache[5] &&
+    !`RF_ZAP.l_generate_with_cache_mmu.u_code_cache.tlb_busy;
+wire [2:0] rf_bucket = {rf_instruction, `RF_BRIDGE.guaranteed, rf_wide};
+wire [4:0] rf_pair_end = {2'b0, `RF_BRIDGE.consumed} + 5'd2;
+
+always @(posedge clk) begin
+    if (`RF_BRIDGE.line_req && `RF_BRIDGE.line_ready) begin
+        rf_instruction <= `RF_CORE.wb_code;
+        rf_wide <= 0;
+    end else if (`RF_BRIDGE.state == 1 && `RF_BRIDGE.line_valid && `RF_BRIDGE.line_wide)
+        rf_wide <= 1;
+end
+
+task automatic reset_refill_measurement;
+    rf_delayed = 0;
+    for (integer i = 0; i < 2; i++) rf_lines[i] = 0;
+    for (integer i = 0; i < 8; i++) begin
+        rf_word_acks[i] = 0;
+        rf_pairs[i] = 0;
+        rf_exposed[i] = 0;
+    end
+endtask
+
+task automatic observe_refill;
+    if (`RF_BRIDGE.line_req && `RF_BRIDGE.line_ready)
+        rf_lines[`RF_CORE.wb_code]++;
+    if (`RF_BRIDGE.study_stage_hold)
+        rf_delayed++;
+    if (`RF_BRIDGE.state == 1 && `RF_BRIDGE.cpu_ack) begin
+        rf_word_acks[rf_bucket]++;
+        // Both aligned words must already be buffered before the ACK edge.
+        // Even consumer indices partition the burst into four disjoint pairs.
+        if (!`RF_BRIDGE.consumed[0] && `RF_BRIDGE.received[4:1] >= rf_pair_end) begin
+            rf_pairs[rf_bucket]++;
+            if (rf_instruction ? rf_i_exposed : rf_d_exposed)
+                rf_exposed[rf_bucket]++;
+        end
+    end
+endtask
+
+task automatic report_refill(input integer interval);
+    $display("REFILL_ADMIT interval=%0d data=%0d code=%0d held=%0d",
+        interval, rf_lines[0], rf_lines[1], rf_delayed);
+    for (integer i = 0; i < 8; i++)
+        if (rf_word_acks[i])
+            $display("REFILL_DELIVERY interval=%0d code=%0d guarantee=%0d wide=%0d words=%0d pairs=%0d exposed=%0d",
+                interval, (i >> 2) & 1, (i >> 1) & 1, i & 1, rf_word_acks[i], rf_pairs[i], rf_exposed[i]);
+endtask
