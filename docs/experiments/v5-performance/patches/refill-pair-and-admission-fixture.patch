+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+from statistics import median
+import subprocess
+
+root = Path(__file__).resolve().parent
+repo = root.parents[1]
+base_revision = "739d3bdb6a10ad975df500576bbde39f7676ff47"
+
+def read_json(path):
+    return json.loads(path.read_text())
+
+def hash_file(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def aggregate(rows):
+    sums = {}
+    for row in rows:
+        key = (("I" if row["code"] else "D") + "_" +
+               ("guaranteed" if row["guarantee"] else "untrusted") + "_" +
+               ("wide" if row["wide"] else "narrow"))
+        counters = sums.setdefault(key, Counter())
+        counters.update({field: row[field] for field in ("words", "pairs", "exposed")})
+    return sums
+
+def case_result(baseline, delayed, windows, field):
+    a = [row[field] for row in baseline[windows]]
+    b = [row[field] for row in delayed[windows]]
+    held = sum(row["held"] for row in delayed["admit"])
+    assert sum(row["held"] for row in baseline["admit"]) == 0
+    assert all(row["held"] == row["data"] for row in delayed["admit"])
+    return {
+        "baseline_cycles": a,
+        "delayed_cycles": b,
+        "elapsed_delta": [new-old for old, new in zip(a, b, strict=True)],
+        "delta_clocks": sum(b) - sum(a),
+        "delta_pct": (sum(b)-sum(a)) * 100 / sum(a),
+        "held_D_offers": held,
+        "baseline_admissions": baseline["admit"],
+        "delayed_admissions": delayed["admit"],
+        "baseline_delivery": baseline["delivery"],
+        "delayed_delivery": delayed["delivery"],
+    }
+
+payload_path = repo / "build/sim/payload-clocks/v5-104-all-four-ram-candidate"
+native_path = repo / "build/sim/polycount/v5-104-all-four-ram-candidate"
+payload_ref = {row["case"]: row for row in read_json(payload_path / "result.json")["rows"]}
+both = {delay: {} for delay in (0, 1)}
+for name, delay, measure in read_json(root / "payload.json"):
+    both[delay][name] = measure
+assert both[0].keys() == both[1].keys() == payload_ref.keys() and len(both[0]) == 15
+result = {
+    "base_revision": base_revision,
+    "system_clock_hz": 104_000_000,
+    "netlist_sha256": hash_file(root / "leg/rtl/arm9v2/arm925t_phone.v"),
+    "base_cpu_wrapper_sha256": hashlib.sha256(subprocess.check_output(
+        ["git", "show", f"{base_revision}:rtl/ngage_cpu.sv"], cwd=repo)).hexdigest(),
+    "simulation_cpu_wrapper_sha256": hash_file(root / "leg/rtl/ngage_cpu.sv"),
+    "pin_model_sha256": hash_file(payload_path / "mt48lc16m16a2.v"),
+    "observer_sha256": hash_file(root / "refill_observe.vh"),
+    "metric_note": "Pairs are disjoint aligned even-head ACKs with two buffered words; exposed is the existing CPU wait bucket on the first ACK edge, not an IPC estimate.",
+    "payloads": {},
+}
+print("case all7_delta_pct warm_median_before/after held_D same_SDRAM_trace")
+for name in both[0]:
+    old, new = both[0][name], both[1][name]
+    assert old["windows"] == payload_ref[name]["windows"], name
+    ref_trace = payload_path / f"{name}-3-64-requests.txt"
+    assert old["trace_hash"] == hash_file(ref_trace), name
+    assert old["input_hash"] == new["input_hash"]
+    assert all(all(a[k] == b[k] for k in ("window", "payload_ops", "helper_ops"))
+               for a, b in zip(old["windows"], new["windows"], strict=True))
+    row = case_result(old, new, "windows", "cycles")
+    row["warm_median"] = [median(row["baseline_cycles"][2:]), median(row["delayed_cycles"][2:])]
+    row["input_sha256"] = old["input_hash"]
+    row["sdram_trace_sha256"] = [old["trace_hash"], new["trace_hash"]]
+    result["payloads"][name] = row
+    print(name, f'{row["delta_pct"]:+.4f}%', row["warm_median"], row["held_D_offers"],
+          old["trace_hash"] == new["trace_hash"])
+result["payload_baseline_delivery"] = aggregate(row for measure in both[0].values() for row in measure["delivery"])
+print("Payload delivery", result["payload_baseline_delivery"])
+
+if (root / "native.json").exists():
+    original, delayed = read_json(root / "native.json")
+    old = read_json(native_path / "result.json")["results"]["i16"]
+    assert original["frames"] == old["frames"]
+    assert original["passed"] == old["completion"]
+    assert original["output_hash"] == delayed["output_hash"] == old["output_sha"]
+    for a, b in zip(original["frames"], delayed["frames"], strict=True):
+        assert all(a[k] == b[k] for k in ("frame", "retired", "uops", "draws", "swaps"))
+    native = case_result(original, delayed, "frames", "clocks")
+    native["output_sha256"] = original["output_hash"]
+    native["baseline_total_cycles"] = original["passed"]["cycles"]
+    native["delayed_total_cycles"] = delayed["passed"]["cycles"]
+    native["baseline_delivery_total"] = aggregate(original["delivery"])
+    native["input_sha256"] = {name: hash_file(native_path / name)
+                              for name in ("core.bin", "snapshot.bin", "cdrive.bin")}
+    result["native"] = native
+    print("Native", native["baseline_cycles"], native["elapsed_delta"],
+          f'{native["delta_pct"]:+.4f}%', native["held_D_offers"], native["baseline_delivery_total"])
+
+(root / "comparison.json").write_text(json.dumps(result, indent=2) + "\n")
