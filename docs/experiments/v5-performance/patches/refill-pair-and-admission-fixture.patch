+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import sys
+
+root = Path(__file__).resolve().parent
+repo = root.parents[1]
+leg = root / "leg"
+frozen = repo / "build/sim"
+paths = {
+    "payload": frozen / "payload-clocks/v5-104-all-four-ram-candidate",
+    "native": frozen / "polycount/v5-104-all-four-ram-candidate/i16",
+}
+image = "jotego/simulator:arm64"
+docker = ["docker", "run", "--rm", "--pull=never", "--network", "none", "--platform", "linux/arm64",
+          "-v", f"{leg}:/work", "-v", f"{repo}:/frozen:ro", "-w", "/work", "--entrypoint"]
+
+def frozen_path(path):
+    return "/frozen/" + str(path.relative_to(repo))
+
+def run(args, operation, log):
+    with log.open("w") as handle:
+        return subprocess.run(docker + [operation, image] + args, stdout=handle, stderr=subprocess.STDOUT,
+                              check=True)
+
+def compile_kind(kind):
+    profile = paths[kind]
+    command = next(line for line in (profile / "mmc3-nos64/Vtb__verFiles.dat").read_text().splitlines()
+                   if line.startswith("C "))
+    options = shlex.split(command.removeprefix('C "').removesuffix('"'))
+    for index, argument in enumerate(options):
+        if argument.startswith("/work/") and argument.endswith("/tb.v"):
+            options[index] = kind + ".sv"
+        elif argument.startswith("/work/") and argument.endswith((".v", ".sv")):
+            options[index] = argument.replace("/work/", "/frozen/", 1)
+    options[options.index("--Mdir") + 1] = f"obj-{kind}"
+    run(options, "verilator", root / f"build-{kind}.log")
+
+def parse_log(log, prefix):
+    return [{key: int(value) for key, value in re.findall(r"(\w+)=(-?\d+)", line)}
+            for line in log.read_text().splitlines() if line.startswith(prefix)]
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+def payload_case(case, delay):
+    name = case["name"]
+    src = paths["payload"]
+    log = root / f"payload-{name}-{delay}.log"
+    options = [
+        "+ngage-compact-trace", "+no-board-log",
+        "+core=" + frozen_path(src / f"{name}-False.bin"),
+        "+extension=/frozen/build/firmware/nem4-factory/extension.bin",
+        "+cdrive=" + frozen_path(src / "cdrive.bin"),
+        f'+begin_pc={case["begin"]:x}', f'+end_pc={case["end"]:x}',
+        f'+payload_base={case["payload_base"]:x}', f'+helper_base={case["helper_base"]:x}']
+    trace = f"payload-{name}-{delay}-requests.txt"
+    options += ["+sdram-trace=/work/" + trace]
+    if delay:
+        options += ["+delay_d_refill"]
+    run(options, "/work/obj-payload/Vtb", log)
+    results = parse_log(log, "PAYLOAD_RESULT ")
+    admitted = parse_log(log, "REFILL_ADMIT ")
+    delivery = parse_log(log, "REFILL_DELIVERY ")
+    passed, = parse_log(log, "PAYLOAD_PASS ")
+    assert len(results) == len(admitted) == 7
+    for row, expected in zip(results, case["windows"], strict=True):
+        assert row["payload_ops"] == expected["payload_retire_proxy"]
+        assert row["helper_ops"] == expected["helper_retire_proxy"]
+    return name, delay, dict(windows=results, admit=admitted, delivery=delivery, passed=passed,
+                             trace_hash=sha(leg / trace), input_hash=sha(src / f"{name}-False.bin"))
+
+def native_case(delay):
+    src = paths["native"].parent
+    log = root / f"native-{delay}.log"
+    args = ["+ngage-compact-trace", "+no-board-log",
+            "+core=" + frozen_path(src / "core.bin"),
+            "+extension=/frozen/build/firmware/nem4-factory/extension.bin",
+            "+cdrive=" + frozen_path(src / "cdrive.bin"),
+            "+snapshot=" + frozen_path(src / "snapshot.bin"),
+            f"+results=/work/native-{delay}",
+            "+begin_pc=68", "+end_pc=6c", "+done_pc=80", "+fail_pc=84"]
+    if delay:
+        args += ["+delay_d_refill"]
+    run(args, "/work/obj-native/Vtb", log)
+    frames = parse_log(log, "POLY_FRAME ")
+    admitted = parse_log(log, "REFILL_ADMIT ")
+    delivery = parse_log(log, "REFILL_DELIVERY ")
+    passed, = parse_log(log, "PASS_POLYCOUNT ")
+    assert len(frames) == len(admitted) == 4
+    assert sha(leg / f"native-{delay}.bin") == sha(paths["native"] / "result.bin")
+    return dict(frames=frames, admit=admitted, delivery=delivery, passed=passed,
+                output_hash=sha(leg / f"native-{delay}.bin"))
+
+kind = sys.argv[1]
+assert kind in paths
+compile_kind(kind)
+if kind == "native":
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        rows = list(pool.map(native_case, (0, 1)))
+else:
+    sys.path.insert(0, str(repo / "tests/cpu/arm9v2_board"))
+    from payload_clocks import qualified_inputs
+    cases = list(qualified_inputs())
+    assert len(cases) == 15
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        futures = [pool.submit(payload_case, case, delay) for case in cases for delay in (0, 1)]
+        rows = [future.result() for future in futures]
+(root / f"{kind}.json").write_text(json.dumps(rows, indent=2) + "\n")
+print(f"PASS {kind} paired measurements on 739d3bd")
