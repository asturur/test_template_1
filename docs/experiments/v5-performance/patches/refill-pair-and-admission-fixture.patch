+from pathlib import Path
+import hashlib
+import subprocess
+
+root = Path(__file__).resolve().parent
+repo = root.parents[1]
+out = root / "leg"
+frozen = repo / "build/sim"
+paths = {
+    "payload": frozen / "payload-clocks/v5-104-all-four-ram-candidate",
+    "native": frozen / "polycount/v5-104-all-four-ram-candidate/i16",
+}
+
+def edit(text, before, after):
+    assert text.count(before) == 1, before
+    return text.replace(before, after)
+
+wrapper = out / "rtl/ngage_cpu.sv"
+source = subprocess.check_output(["git", "show", "739d3bd:rtl/ngage_cpu.sv"], cwd=repo, text=True)
+source = edit(source, "        .cpu_cyc           (donor_cyc),",
+              "        .study_cpu_code    (wb_code),\n        .cpu_cyc           (donor_cyc),")
+index = source.index("module ngage_arm9v2_refill #(")
+a, b = source[:index], source[index:]
+b = edit(b, "    input  wire        cpu_cyc,", "    input  wire        study_cpu_code,\n    input  wire        cpu_cyc,")
+b = edit(b, """    assign line_req  = ENABLE && !reset && state == IDLE && cpu_cyc && !cpu_lock &&
+                       cpu_line_candidate;
+    assign line_addr = cpu_address;
+    assign wb_cyc = !reset && cpu_cyc && state != LINE && !line_req;""",
+"""    wire study_offer = ENABLE && !reset && state == IDLE && cpu_cyc &&
+                       !cpu_lock && cpu_line_candidate;
+    reg study_delay;
+    reg study_pending = 0;
+    reg [31:0] study_address;
+    initial study_delay = $test$plusargs("delay_d_refill");
+    wire study_stage_hold = study_delay && study_offer && !study_cpu_code && !study_pending;
+    always @(posedge clk) begin
+        if (reset) study_pending <= 0;
+        else if (study_stage_hold) begin
+            study_pending <= 1;
+            study_address <= cpu_address;
+        end else if (study_pending) begin
+            if (!study_offer || study_cpu_code || cpu_address != study_address)
+                $fatal(1, "D refill changed while held in the additional admission stage");
+            if (line_req && line_ready) study_pending <= 0;
+        end
+    end
+    assign line_req = study_offer && !study_stage_hold;
+    assign line_addr = study_pending ? study_address : cpu_address;
+    assign wb_cyc = !reset && cpu_cyc && state != LINE && !study_offer;""")
+wrapper.write_text(a+b)
+
+hook = (root / "refill_observe.vh").read_text()
+for flavor, path in paths.items():
+    body = (path / "tb.v").read_text()
+    if flavor == "payload":
+        body = edit(body, "        first_clock = cycles;", "        first_clock = cycles;\n        reset_refill_measurement();")
+        body = edit(body, "    if (first_clock >= 0) begin", "    if (first_clock >= 0 && cycles != first_clock) observe_refill();\n    if (first_clock >= 0) begin")
+        body = edit(body, '            $display("PAYLOAD_RESULT', '            report_refill(window);\n            $display("PAYLOAD_RESULT')
+    else:
+        body = edit(body, "        start_clock = cycles;", "        start_clock = cycles;\n        reset_refill_measurement();")
+        body = edit(body, "    end else if (start_clock >= 0) begin", "    end else if (start_clock >= 0) begin\n        observe_refill();")
+        body = edit(body, '            $display("POLY_FRAME', '            report_refill(int\'(frame));\n            $display("POLY_FRAME')
+    assert body.count("endmodule") >= 1
+    (out / f"{flavor}.sv").write_text(body.rsplit("endmodule", 1)[0] + hook + "\nendmodule\n")
+
+commit_path = out / "rtl/arm9v2/arm925t_phone.v"
+assert hashlib.sha256(commit_path.read_bytes()).hexdigest() == (
+    "01088c86f4c9f14ce36b71f2ba1ab0fbf5c491de2b0664ab2121f9a7be370b4f")
