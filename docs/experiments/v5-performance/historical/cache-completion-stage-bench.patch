+"""Classify the original instructions seen in a captured PolyCount frame."""
+
+import argparse
+from collections import Counter
+import json
+from pathlib import Path
+
+from capstone import CS_ARCH_ARM, CS_MODE_ARM, CS_MODE_THUMB, Cs
+from unicorn.arm_const import UC_ARM_REG_CPSR
+
+from capture import APP, GLES, MODULE_SHA, OBJECT, RAM, ROM_SHA, Capture, checked_input
+
+
+class InstructionCapture(Capture):
+    def __init__(self, app, gles, rom):
+        self.instruction_modes = {}
+        super().__init__(app, gles, rom)
+
+    def observe(self, cpu, pc, size, data):
+        if self.count_pcs and pc not in self.instruction_modes:
+            thumb = bool(cpu.reg_read(UC_ARM_REG_CPSR) & (1 << 5))
+            self.instruction_modes[pc] = (thumb, size)
+        super().observe(cpu, pc, size, data)
+
+
+def classify(replay):
+    arm, thumb = (Cs(CS_ARCH_ARM, mode) for mode in (CS_MODE_ARM, CS_MODE_THUMB))
+    histogram = Counter()
+    modes = Counter()
+    block_registers = {'load': Counter(), 'store': Counter()}
+    register_shifts = 0
+    instructions = []
+    for pc, count in replay.instructions.most_common():
+        is_thumb, size = replay.instruction_modes[pc]
+        decoder = thumb if is_thumb else arm
+        raw = replay.read(pc, size)
+        instruction, = decoder.disasm(raw, pc, count=1)
+        name = instruction.insn_name()
+        modes['thumb' if is_thumb else 'arm'] += count
+        histogram[name] += count
+        if name.startswith(('ldm', 'stm')) or name in ('push', 'pop'):
+            registers = instruction.op_str.split('{', 1)[1].split('}', 1)[0].split(',')
+            direction = 'load' if name.startswith('ldm') or name == 'pop' else 'store'
+            block_registers[direction][len(registers)] += count
+        if (not is_thumb and name in ('adc', 'add', 'and', 'asr', 'bic', 'cmn', 'cmp', 'eor', 'lsl', 'lsr',
+                                     'mov', 'mvn', 'orr', 'ror', 'rsb', 'rsc', 'sbc', 'sub', 'teq', 'tst')
+                and (int.from_bytes(raw, 'little') & 0x0e000090) == 0x10):
+            register_shifts += count
+        instructions.append(dict(pc=f'0x{pc:08x}', count=count, kind=name,
+                                 instruction=f'{instruction.mnemonic} {instruction.op_str}'.strip()))
+    return dict(histogram=dict(histogram.most_common()), modes=dict(modes), instructions=instructions,
+                register_shifts=register_shifts, block_registers=block_registers)
+
+
+def main():
+    root = Path(__file__).resolve().parents[3]
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--payload-dir', type=Path, required=True)
+    parser.add_argument('--rom', type=Path, default=root / 'build/firmware/nem4-factory/core.bin')
+    parser.add_argument('--capture', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+
+    files = [checked_input(args.payload_dir / name, MODULE_SHA[name]) for name in ('SPMark.app', 'libGLES_CM.dll')]
+    replay = InstructionCapture(*files, checked_input(args.rom, ROM_SHA))
+    capture = args.capture
+    oracle = json.loads((capture / 'oracle.json').read_text())
+    assert oracle['module_sha'] == MODULE_SHA and oracle['rom_sha'] == ROM_SHA
+    replay.tls = {int(key): value for key, value in oracle['tls'].items()}
+    for name, address in [('app', APP), ('gles', GLES), ('heap', RAM)]:
+        replay.cpu.mem_write(address, (capture / f'{name}.bin').read_bytes())
+
+    # The snapshot follows frame 0. Advance to the same median-scored
+    # frame used in the RTL experiment, then decode the PCs in their ISA.
+    for _ in range(2):
+        replay.call(APP + 0x1e00, OBJECT, 0)
+    replay.count_pcs = True
+    replay.call(APP + 0x1e00, OBJECT, 0)
+    assert sorted(replay.instructions.items()) == [tuple(row) for row in oracle['frames'][3]['pc_with_counts']]
+    result = classify(replay)
+    result['capture_frame'] = 3
+    result['callbacks'] = sum(replay.instructions.values())
+    args.output.write_text(json.dumps(result, indent=2) + '\n')
+    print('Architectural encounters including failed conditions', result['callbacks'])
+    print('ISA', result['modes'])
+    print('Top 30 opcodes', list(result['histogram'].items())[:30])
+    print('Register-controlled shifts', result['register_shifts'])
+
+
+if __name__ == '__main__':
+    main()
