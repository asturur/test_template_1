+                '--arm9v2-netlist', netlist, '--flash-cache-bytes', '32768', '--stream-sdram', '--block-writeback', '--sdram-model', pin]
+    exec(compile(source, str(payloads), 'exec'), {'__file__': str(payloads), '__name__': '__main__'})
+else:
+    native_dir = root / 'tests/cpu/polycount_v5'
