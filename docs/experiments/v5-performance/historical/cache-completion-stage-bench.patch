+leg, workload = sys.argv[1:3]
+assert leg in {'parent', 'reg-cache', 'owned-ack', 'active'} and workload in {'payloads', 'native'}
+profile = f'v5-104-backend-alt-b-{leg}'
+netlist = ('rtl/arm9v2/arm925t_phone.v' if leg == 'active' else f'scratch/v5-fit-loop/backend-alt-b/{leg}.v')
+pin = 'build/sim/unit-hardware-boot-real-sdram/mt48lc16m16a2-verilator.v'
+payloads = root / 'tests/cpu/arm9v2_board/payload_clocks.py'
