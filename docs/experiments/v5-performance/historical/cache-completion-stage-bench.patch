+def prepare_ideal(out, core, ram, jit, leg, geometry):
+    # Serve a hit for known immutable instruction addresses, using the real
+    # cache's checked address and data latch. Leave its I-TLB and bus intact.
+    raster_begin = min(start for start, _ in jit) & ~0xfff
+    raster_end = (max(end for _, end in jit) + 0xfff) & ~0xfff
+    heap_offset = 0x400000 - 0x20000000
+    locations = [
+        ('boot', 0, core[:0x1000]),
+        ('app', 0x10000000, ram[0x100000:0x114000]),
+        ('gles', 0x10100000, ram[0x200000:0x21a000]),
+        ('raster', raster_begin, ram[heap_offset + raster_begin:heap_offset + raster_end]),
+        ('rom', 0x50300000, core[0x300000:0x400000]),
+    ]
+    hdl = ['\treg ideal_hit;', '\treg [31:0] ideal_word;']
+    predicates = []
+    for name, base, data in locations:
+        limit = base + len(data)
+        path = out / f'ideal-{name}.hex'
+        path.write_text(''.join(f'{word:08x}\n' for word, in struct.iter_unpack('<I', data)))
+        hdl += [f'\treg [31:0] ideal_{name}[0:{len(data)//4-1}];',
+                f'\tinitial $readmemh("{container_path(path)}", ideal_{name});']
+        lower = f"i_address_check >= 32'h{base:08x} && " if base else ''
+        predicates.append(f"if ({lower}i_address_check < 32'h{limit:08x}) begin\n"
+                          f"\t\t\tideal_word = ideal_{name}[(i_address_check - 32'h{base:08x}) >> 2];\n"
+                          '\t\t\tideal_hit = 1;\n\t\tend')
+    hdl += ['\talways @(*) begin', '\t\tideal_hit = 0;', '\t\tideal_word = 0;',
+            '\t\t' + '\n\t\telse '.join(predicates), '\tend',
+            "\twire [WAYS*32-1:0] device_words;",
+            '\twire device_hit, device_word_sel;',
+            "\tassign raw_cache_words = ideal_hit ? {{(WAYS-1)*32{1'b0}}, ideal_word} : device_words;",
+            '\tassign raw_cache_hit = ideal_hit || device_hit;',
+            "\tassign raw_cache_word_sel = ideal_hit ? 1'b0 : device_word_sel;", '']
+    source = (out / f'arm925t-{geometry}.v').read_text()
+    start = source.index('module ngage2_zap_cache (')
+    end = source.index('\nendmodule', start)
+    part = source[start:end]
+    for old, new in [('o_cache_words(raw_cache_words)', 'o_cache_words(device_words)'),
+                     ('o_cache_hit(raw_cache_hit)', 'o_cache_hit(device_hit)'),
+                     ('o_cache_word_sel(raw_cache_word_sel)', 'o_cache_word_sel(device_word_sel)')]:
+        part = swap(part, old, new)
+    part = swap(part, '\tassign o_data_early =', '\n'.join(hdl) + '\tassign o_data_early =')
+    (out / f'arm925t-{leg}.v').write_text(source[:start] + part + source[end:])
+
+
+def run_leg(run, capture, pin_model, symbols, leg, cpu_wrapper=None, board_overlay=None):
+    out = run / leg
