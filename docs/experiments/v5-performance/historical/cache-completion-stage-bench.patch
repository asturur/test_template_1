+task reset_load_trace;
+    load_trace_lines = 0;
+    for (integer slot = 0; slot < 4; slot += 1) begin
+        load_retired[slot] = 0;
+        load_hit[slot] = 0;
+        load_same_cycle[slot] = 0;
