+                        ('INDEX_REGION', frames[-1]['draw'][3])]:
+        observe = observe.replace(name, f"25'h{value - 0x20000000 + 0x400000:x}")
+    observe = observe.replace('COLOR_BYTES', str(color[1])).replace('DEPTH_BYTES', str(depth[1]))
+    (out / 'tb.v').write_text(bench.rsplit('endmodule', 1)[0] + '\n' + observe + '\nendmodule\n')
