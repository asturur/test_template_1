+task automatic dump_region(input integer fd, input [24:0] address, input integer bytes);
+    reg [23:0] pin_cell;
+    reg [15:0] word_half;
+    for (integer i = 0; i < bytes; i = i + 2) begin
+        pin_cell = sdram_cell(address + i);
+        case (pin_cell[23:22])
+            0: word_half = memory.Bank0[pin_cell[21:0]];
+            1: word_half = memory.Bank1[pin_cell[21:0]];
+            2: word_half = memory.Bank2[pin_cell[21:0]];
+            3: word_half = memory.Bank3[pin_cell[21:0]];
