+    if (load_trace_lines < 32 && `PCORE.u_front_decode.u_decode.d2_valid &&
+        load_d2_pc >= 32'h10106c54 && load_d2_pc <= 32'h10106c70) begin
+        $display("POLY_LOAD_TRACE frame=%0d cycle=%0d d2=%h hazard=%b s=%h s_valid=%b accept=%b a=%h a_valid=%b use=%b w=%h w_valid=%b hit=%b bypass=%b",
