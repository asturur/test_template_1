+"""Build a simulation overlay for two already-decoded resident LDM words."""
+
+from frame_gap_early import swap
+
+
+def pair_resident_loads(source):
+    return wire_paired_load_data(source, core_overlay)
+
+
+def wire_paired_load_data(source, transform_core):
+    start = source.index('module ngage2_arm9v2_core (')
+    end = source.index('\nendmodule', start)
+    source = source[:start] + transform_core(source[start:end]) + source[end:]
+    start = source.index('module ngage2_zap_dcache (')
+    end = source.index('\nendmodule', start)
+    source = source[:start] + cache_overlay(source[start:end]) + source[end:]
+    source = swap(source, '\twire [31:0] dc_short_data;', '''\twire [31:0] dc_short_data;
+    wire [31:0] dc_short_next_word;
+    wire dc_short_next_valid;''')
+    source = swap(source, '.i_data_short_data(dc_short_data),', '''.i_data_short_data(dc_short_data),
+                .i_data_short_next_word(dc_short_next_word),
+                .i_data_short_next_valid(dc_short_next_valid),''')
+    return swap(source, '.o_short_data(dc_short_data),', '''.o_short_data(dc_short_data),
+                .o_short_next_word(dc_short_next_word),
+                .o_short_next_valid(dc_short_next_valid),''')
+
+
+def core_overlay(core):
+    core = swap(core, '\ti_data_short_data,', '\ti_data_short_data,\n    i_data_short_next_word,\n    i_data_short_next_valid,')
+    core = swap(core, '\tinput wire [31:0] i_data_short_data;', '''\tinput wire [31:0] i_data_short_data;
+    input wire [31:0] i_data_short_next_word;
+    input wire i_data_short_next_valid;''')
+    core = swap(core, '\twire load_trust =', '''    // The decoder still emits both ordinary beats. Join them only once both
+    // are in order in W/M and the first would complete from a live D hit.
+    wire paired_ldm_shape = w[541] && m[541] && w[540] && m[540] &&
+        w[8-:4] == BLOCK && m[8-:4] == BLOCK && w[537] && !w[536] && !m[537] && m[536] &&
+        !w[539] && w[487:483] == 5'b01001 &&
+        w[526-:32] == m[526-:32] && w[494-:32] == m[494-:32] &&
+        w[92+:6] < 15 && m[92+:6] < 15 && w[92+:6] < m[92+:6];
+    wire paired_ldm_address = w[336:335] == 0 && w[339:337] != 7 &&
+        m[366-:32] == w[366-:32] + 32'd4;
+    wire paired_ldm = paired_ldm_shape && paired_ldm_address && memory_state == 0 &&
+        complete_class[0] && ack_now && !resp_err && !retry && !w_exception &&
+        !i_dc_lock_any && w_load_hit && i_data_short_next_valid;
+\twire load_trust =''')
+    core = swap(core, '\t\tnext_load_tag = {forward_tag[0+:6], a_a_dest[0+:6]};', '''        if (paired_ldm)
+            forward_load[1] = 0;
+\t\tnext_load_tag = {forward_tag[0+:6], a_a_dest[0+:6]};''')
+    core = swap(core, '\t\t\t\t\tw_cls_next = w_cls_of(m);\n\t\t\t\tend\n\t\t\t\telse begin', '''\t\t\t\t\tw_cls_next = w_cls_of(m);
+                    if (paired_ldm) begin
+                        // Keep the younger result visible on the normal W
+                        // forwarding lane for one clock. The beat already
+                        // committed, so it has no request or retire token.
+                        w_next[541] = 0;
+                        w_next[535] = 0;
+                        w_next[527] = 0;
+                        w_next[28+:32] = i_data_short_next_word;
+                        w_next[27-:2] = 2'b01;
+                        w_next[1:0] = 0;
+                        w_cls_next = 0;
+                    end
+\t\t\t\tend
+\t\t\t\telse begin''')
