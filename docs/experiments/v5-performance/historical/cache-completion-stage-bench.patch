+function automatic [31:0] load_site(input integer slot);
+    case (slot)
+        0: load_site = 32'h10106c54;
+        1: load_site = 32'h10106c5c;
+        2: load_site = 32'h10106c60;
+        default: load_site = 32'h10106c6c;
+    endcase
+endfunction
