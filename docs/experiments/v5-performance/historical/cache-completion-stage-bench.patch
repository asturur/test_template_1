+    bench = (ROOT / 'tests/phone/hardware_boot/tb.v').read_text()
+    bench = wire_production_sdram(out, bench, production=True)
+    bench = swap(bench, 'if(cycles==BOUNDED_CYCLES)begin',
+                 'if(cycles==BOUNDED_CYCLES) $fatal(1,"PolyCount timeout PC=%h",fetch_pc);\n if(1\'b0) begin')
+    observe = (FIXTURE / 'replay.vh').read_text()
+    if icache_hum_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/icache_hum_observe.vh'
+        observe = '`define NGAGE_IC_HUM\n' + helper.read_text() + observe
+    if icache_restart_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/icache_restart_observe.vh'
+        observe = '`define NGAGE_IC_RESTART\n' + helper.read_text() + observe
+    if control_flow_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/control_flow_observe.vh'
+        observe = '`define NGAGE_CONTROL_FLOW\n' + helper.read_text() + observe
+    if store_list_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/store_list_observe.vh'
+        observe = '`define NGAGE_COUNT_STORE_LIST\n' + helper.read_text() + observe
+    if load_waw_counts:
+        helper = ROOT / 'tests/cpu/arm9v2_board/waw_load_observe.vh'
+        observe = '`define NGAGE_COUNT_LOAD_WAW\n' + helper.read_text() + observe
+    if trace_load_sites:
+        observe = '`define POLYCOUNT_LOAD_TRACE\n' + swap(observe, '\n`undef PCOFF',
+                    '\n' + (FIXTURE / 'load_use.vh').read_text() + '\n`undef PCOFF')
+    if 'predicate-block' in legs:
+        helper = ROOT / 'tests/cpu/arm9v2_board/predicate_block_observe.vh'
+        observe = '`define NGAGE_COUNT_PREDICATE_BLOCKS\n' + helper.read_text() + observe
