+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--name', required=True)
+    parser.add_argument('--capture', type=Path, required=True)
+    parser.add_argument('--pin-model', type=Path, required=True)
+    parser.add_argument('--netlist', type=Path, default=PRODUCTION_NETLIST,
+                        help='Base 16 KiB I-cache netlist (defaults to current production RTL)')
+    parser.add_argument('--trace-load-sites', action='store_true', help='trace known GLES scalar load-use sites')
+    parser.add_argument('--load-waw-counts', action='store_true', help='count repeated scalar-load destination interlocks')
+    parser.add_argument('--board-overlay', type=Path, help='alternate line-guarantee integration files')
+    parser.add_argument('--icache-hum-counts', action='store_true')
+    parser.add_argument('--icache-restart-counts', action='store_true')
+    parser.add_argument('--cpu-wrapper', type=Path)
+    parser.add_argument('--control-flow-counts', action='store_true', help='measure branch-to-successor issue clocks')
+    parser.add_argument('--store-list-counts', action='store_true', help='count passed store words and resident pairs')
+    parser.add_argument('--legs', nargs='+',
+                        choices=['i16', 'i32', 'ideal', 'ideal-i16', 'direct-mac', 'early-smull', 'ready-reg-shift',
+                                 'paired-ldm', 'predicate-block', 'load-waw', *ISSUE_LDM_LEGS],
+                        default=['i16', 'i32', 'ideal'])
+    args = parser.parse_args()
+    if not re.fullmatch(r'[a-zA-Z0-9_-]+', args.name) or len(set(args.legs)) != len(args.legs):
+        parser.error('Use an alphanumeric run name and distinct legs')
+    run = ROOT / 'build/sim/polycount' / args.name
+    run.mkdir(parents=True)
+    capture = args.capture.resolve()
+    model = run / 'mt48lc16m16a2.v'
+    pin_model = args.pin_model.read_bytes()
+    assert digest(pin_model) == PIN_MODEL_SHA
+    model.write_bytes(pin_model)
+    netlist = args.netlist.read_bytes()
+    wrapper = None
+    if args.cpu_wrapper:
+        wrapper = run / 'ngage_cpu.sv'
+        wrapper.write_bytes(args.cpu_wrapper.read_bytes())
+    symbols = prepare(run, capture, netlist.decode(), args.legs, args.trace_load_sites,
+                      args.load_waw_counts, args.store_list_counts, args.control_flow_counts, args.icache_restart_counts, args.icache_hum_counts)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        jobs = {leg: pool.submit(run_leg, run, capture, model, symbols, leg, wrapper, args.board_overlay.resolve() if args.board_overlay else None) for leg in args.legs}
+        results = {leg: job.result() for leg, job in jobs.items()}
+    assert len({tuple(frame['retired'] for frame in result['frames']) for result in results.values()}) == 1
+    (run / 'result.json').write_text(json.dumps(dict(status='PASS', results=results, pin_model_sha=PIN_MODEL_SHA,
+                                                     base_netlist_sha=digest(netlist),
+                                                     snapshot_sha=digest((run / 'snapshot.bin').read_bytes())),
+                                             indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
