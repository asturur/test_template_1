+"""Issue a two-word LDM once, with a serial fallback in writeback."""
+
+from frame_gap_early import swap
+from paired_ldm import wire_paired_load_data
+
+
+def issue_paired_loads(source, one_cycle_split=False, address_hint=False):
+    source = wire_paired_load_data(source, issue_core_overlay)
+    if one_cycle_split:
+        source = swap(source, "w_cls_next = w_cls_of(w_next);\n            memory_state_next = 4'd4;",
+                      "w_cls_next = w_cls_of(w_next);\n            memory_state_next = 4'd5;")
+        source = swap(source, 'wire [31:2] lookup_address =', 'wire [31:2] nominal_lookup_address =')
+        source = swap(source, '\tassign o_data_wb_adr_nxt =', '''    // Point the D-cache RAM at the second word on the split edge. Its
+    // registered tag/data then align with the second request's check address.
+    wire [31:2] lookup_address = paired_ldm_split ? w[398:369] + 30'd1 : nominal_lookup_address;
+\tassign o_data_wb_adr_nxt =''')
+    start = source.index('module ngage2_arm9v2_decode (')
+    end = source.index('\nendmodule', start)
+    decode = issue_decode_overlay(source[start:end])
+    if address_hint:
+        decode = avoid_known_crossings(decode)
+    source = source[:start] + decode + source[end:]
+    start = source.index('module ngage2_arm9v2_front_decode (')
+    end = source.index('\nendmodule', start)
+    front = pair_dependency_port(source[start:end])
