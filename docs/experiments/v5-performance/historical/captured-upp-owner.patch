+    tick;
+    cyc = 1;
+    stb = 1;
+    #1;
+    if (oc) $fatal(1, "canceled packet replay");
+    tick;
+    live = 1;
+    #1;
+    if ({ow, oi, oa, od, ob} !== {1'b0, 1'b1, 32'hffffffff, 32'h12345678, 4'h3})
+      $fatal(1, "next packet identity");
