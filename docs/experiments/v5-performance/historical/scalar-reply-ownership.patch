-                SCALAR:  if (wb_cyc && !burst && (wb_ack || wb_error)) state <= IDLE;
+                SCALAR:  if (scalar_reply && !burst && (wb_ack || wb_error)) state <= IDLE;
                 default: state <= IDLE;
             endcase
         end
