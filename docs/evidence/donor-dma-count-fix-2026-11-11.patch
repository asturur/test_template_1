--- /dev/null
+++ b/sim/dma-count/tb.v
@@ -0,0 +1,185 @@
+`timescale 1ns/1ps
+// Verilog-2001 testbench; the imported DMA and RAM use SystemVerilog.
+module tb;
+    reg clk = 0;
+    always #5 clk = ~clk;
+    reg reset = 1, acc = 0, wr = 0;
+    reg [11:0] off = 0;
+    reg [31:0] wdata = 0;
+    wire [31:0] rmask, rdata;
+    wire [7:0] irq;
+    wire m_cyc, m_stb, m_we;
+    wire [31:0] m_adr, m_dat_o;
+    wire [3:0] m_sel;
+    reg [31:0] m_dat_i;
+    integer clocks = 0;
+    wire m_ack = m_cyc && clocks % 5 >= 2;
+    upp_dma dut (
+        .clk(clk), .reset(reset), .acc(acc), .wr(wr), .off(off), .wdata(wdata),
+        .rmask(rmask), .rdata(rdata), .irq(irq),
+        .mmc_rx_ready(clocks % 7 >= 3), .mmc_tx_ready(clocks % 11 >= 5),
+        .lcd_tx_ready(clocks % 13 >= 4),
+        .m_cyc(m_cyc), .m_stb(m_stb), .m_we(m_we), .m_adr(m_adr),
+        .m_dat_o(m_dat_o), .m_sel(m_sel), .m_ack(m_ack), .m_err(1'b0), .m_dat_i(m_dat_i)
+    );
+    localparam [31:0] MMC_FIFO = 32'h0c120624, LCD_FIFO = 32'h0c121208;
+    reg [7:0] memory [0:4095];
+    reg [7:0] expected [0:4095];
+    reg [7:0] stream [0:2047];
+    integer cases = 0, words = 0, read_total = 0, written = 0;
+    integer sw, dw, total, sa, da, kind;
+    reg si, di;
+    integer j;
+    always @* begin
+        m_dat_i = 0;
+        if (m_adr == MMC_FIFO)
+            for (j = 0; j < 4; j = j + 1)
+                m_dat_i[j*8 +: 8] = (read_total + j) * 17 + 8'h35;
+        else if (m_adr < 4093)
+            for (j = 0; j < 4; j = j + 1)
+                m_dat_i[j*8 +: 8] = memory[m_adr+j];
+    end
+    integer logical_addr, bytes, mask, i;
+    reg [31:0] data;
+    reg stalled = 0;
+    reg [68:0] packet;
+    always @(posedge clk) begin
+        clocks = clocks + 1;
+        if (reset) stalled = 0;
+        else begin
+            if (stalled && (!m_cyc || {m_we, m_adr, m_dat_o, m_sel} !== packet))
+                $fatal(1, "held master packet changed");
+            stalled = m_cyc && !m_ack;
+            packet = {m_we, m_adr, m_dat_o, m_sel};
+            if (m_ack) begin
+                words = words + 1;
+                if (m_we) begin
+                    bytes = total - written;
+                    if (bytes > dw) bytes = dw;
+                    if (bytes <= 0) $fatal(1, "write exceeded byte budget case=%0d", cases);
+                    logical_addr = da + (di ? written : 0);
+                    mask = ((1 << bytes) - 1) << (logical_addr % 4);
+                    data = 0;
+                    for (i = 0; i < bytes; i = i + 1)
+                        data[((logical_addr % 4)+i)*8 +: 8] = stream[written+i];
+                    if (m_adr !== (logical_addr & 32'hfffffffc) || m_sel !== mask[3:0])
+                        $fatal(1, "write packet extent case=%0d byte=%0d", cases, written);
+                    for (i = 0; i < 4; i = i + 1)
+                        if (m_sel[i] && m_dat_o[i*8 +: 8] !== data[i*8 +: 8])
+                            $fatal(1, "write byte mismatch case=%0d byte=%0d", cases, written+i);
+                    if (written + bytes > read_total) $fatal(1, "write consumed unread bytes");
+                    if (kind != 1 && kind != 3)
+                        for (i = 0; i < 4; i = i + 1)
+                            if (m_sel[i]) memory[m_adr+i] = m_dat_o[i*8 +: 8];
+                    written = written + bytes;
+                end else begin
+                    bytes = total - read_total;
+                    if (bytes > sw) bytes = sw;
+                    if (bytes <= 0) $fatal(1, "read exceeded byte budget case=%0d", cases);
+                    logical_addr = sa + (si ? read_total : 0);
+                    mask = ((1 << bytes) - 1) << (logical_addr % 4);
+                    if (m_adr !== (logical_addr & 32'hfffffffc) || m_sel !== mask[3:0])
+                        $fatal(1, "read packet extent case=%0d byte=%0d gotmask=%h expected=%h",
+                               cases, read_total, m_sel, mask[3:0]);
+                    read_total = read_total + bytes;
+                end
+            end
+        end
+    end
+
+    task reg_write;
+        input [11:0] address;
+        input [31:0] value;
+        begin
+            @(negedge clk);
+            off = address;
+            wdata = value;
+            wr = 1;
+            acc = 1;
+            @(negedge clk);
+            wr = 0;
+            acc = 0;
+        end
+    endtask
+
+    // Unit count is deliberately independent of the memory access width.
+    // control 1 counts halfwords. control 2 counts the fixed peripheral side.
+    task run_case;
+        input integer source_width, destination_width, units, control;
+        input source_inc, destination_inc;
+        input integer source_lane, destination_lane, fifo_kind;
+        integer n, b, target, timeout_count;
+        begin
+            cases = cases + 1;
+            sw = source_width;
+            dw = destination_width;
+            si = source_inc;
+            di = destination_inc;
+            kind = fifo_kind;
+            sa = fifo_kind == 2 ? MMC_FIFO : 256 + source_lane;
+            da = fifo_kind == 1 ? MMC_FIFO : fifo_kind == 3 ? LCD_FIFO : 2048 + destination_lane;
+            total = units * (control == 1 ? 2 : di ? sw : dw);
+            read_total = 0;
+            written = 0;
+            for (n = 0; n < 4096; n = n + 1) begin
+                memory[n] = (n * 29 + cases * 13 + n / 7) % 256;
+                expected[n] = memory[n];
+            end
+            for (n = 0; n < total; n = n + 1)
+                stream[n] = fifo_kind == 2 ? (n * 17 + 8'h35) % 256 :
+                            memory[sa + (si ? n : n % sw)];
+            if (fifo_kind != 1 && fifo_kind != 3)
+                for (n = 0; n < total; n = n + dw)
+                    for (b = 0; b < dw && n+b < total; b = b + 1) begin
+                        target = da + (di ? n : 0) + b;
+                        expected[target] = stream[n+b];
+                    end
+            reg_write(12'h304, 1);
+            reg_write(12'h314, sa);
+            reg_write(12'h318, si ? 4 : 0);
+            reg_write(12'h31c, sw * 8);
+            reg_write(12'h320, da == MMC_FIFO ? 32'h10120624 : da == LCD_FIFO ? 32'h10121208 : da);
+            reg_write(12'h324, di ? 4 : 0);
+            reg_write(12'h328, dw * 8);
+            reg_write(12'h32c, units - 1);
+            reg_write(12'h308, control);
+            timeout_count = 0;
+            while (!irq[0]) begin
+                @(negedge clk);
+                timeout_count = timeout_count + 1;
+                if (timeout_count > 100000) $fatal(1, "completion timeout case=%0d", cases);
+            end
+            if (read_total != total || written != total || m_cyc)
+                $fatal(1, "incomplete success case=%0d moved=%0d/%0d expected=%0d", cases, read_total, written, total);
+            for (n = 0; n < 4096; n = n + 1)
+                if (memory[n] !== expected[n]) $fatal(1, "memory guard mismatch case=%0d byte=%0d", cases, n);
+            reg_write(12'h308, 0);
+            reg_write(12'h304, 0);
+            if (irq[0]) $fatal(1, "IRQ did not clear");
+        end
+    endtask
+    integer selected = 0, s, d, count, mode, sl, dl;
+    initial begin
+        if (!$value$plusargs("case=%d", selected)) selected = 0;
+        repeat (4) @(negedge clk);
+        reset = 0;
+        if (selected == 0 || selected == 1) run_case(4, 4, 5, 1, 1, 1, 0, 0, 0);
+        if (selected == 0 || selected == 2) run_case(4, 1, 512, 2, 1, 0, 0, 0, 1);
+        if (selected == 0 || selected == 3) run_case(1, 4, 10, 2, 0, 1, 0, 0, 2);
+        if (selected == 0 || selected == 4) run_case(4, 4, 7, 2, 1, 0, 0, 0, 3);
+        if (selected == 0) begin
+            for (s = 1; s <= 4; s = s * 2)
+                for (d = 1; d <= 4; d = d * 2)
+                    for (count = 1; count <= 9; count = count + 1)
+                        for (sl = 0; sl < 4; sl = sl + s)
+                            for (dl = 0; dl < 4; dl = dl + d) begin
+                                for (mode = 0; mode < 4; mode = mode + 1)
+                                    run_case(s, d, count, 1, mode[0], mode[1], sl, dl, 0);
+                                run_case(s, d, count, 2, 1, 0, sl, dl, 0);
+                                run_case(s, d, count, 2, 0, 1, sl, dl, 0);
+                            end
+        end
+        $display("PASS donor DMA count: %0d cases, %0d words", cases, words);
+        $finish;
+    end
+endmodule
diff --git a/sim/dma-count/model_test.c b/sim/dma-count/model_test.c
new file mode 100644
--- /dev/null
+++ b/sim/dma-count/model_test.c
@@ -0,0 +1,133 @@
+// Executes the real dma_phys(), width_bytes() and dma_run() from ngage_dma.c.
+// Only QEMU memory/IRQ/allocation dependencies are stubbed, not the transfer.
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef uint64_t hwaddr;
+typedef struct { uint32_t regs[8][16]; FILE *log; } NGageDma;
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+#define MEMTXATTRS_UNSPECIFIED 0
+#define NGAGE_IRQ_DMA(ch) (6 + (ch))
+#define g_malloc malloc
+static void release(void *p) { free(*(void **)p); }
+#define g_autofree __attribute__((cleanup(release)))
+
+static uint8_t memory[4096], expected[4096], stream[2048];
+static unsigned cases, reads, writes, moved_read, moved_write;
+static unsigned sw, dw, total, sa, da, kind;
+static bool si, di;
+static int address_space_memory, interrupt;
+static void require(bool condition, const char *message)
+{
+    if (!condition) {
+        fprintf(stderr, "FAIL donor DMA C case=%u read=%u written=%u budget=%u: %s\n",
+                cases, moved_read, moved_write, total, message);
+        exit(1);
+    }
+}
+static unsigned ngage_guest_pc(void) { return 0; }
+static void ngage_intc_set_source(int source, int level)
+{
+    require(source == 6, "unexpected interrupt source");
+    interrupt = level;
+}
+static void address_space_read(void *space, hwaddr address, int attrs, void *data, size_t length)
+{
+    (void)space;
+    (void)attrs;
+    unsigned n = MIN(sw, total - moved_read);
+    require(moved_read < total && length == n, "source extent exceeds byte budget");
+    require(address == sa + (si ? moved_read : 0), "source address sequence");
+    if (kind == 2) memcpy(data, stream + moved_read, length);
+    else {
+        require(address + length <= sizeof memory, "source address bounds");
+        memcpy(data, memory + address, length);
+    }
+    moved_read += length;
+    reads++;
+}
+static void address_space_write(void *space, hwaddr address, int attrs, const void *data, size_t length)
+{
+    (void)space;
+    (void)attrs;
+    unsigned n = MIN(dw, total - moved_write);
+    require(moved_write < total && length == n, "destination extent exceeds byte budget");
+    require(address == da + (di ? moved_write : 0), "destination address sequence");
+    require(moved_write + length <= moved_read, "write consumed unread bytes");
+    require(memcmp(data, stream + moved_write, length) == 0, "ordered write payload");
+    if (kind != 1 && kind != 3) {
+        require(address + length <= sizeof memory, "destination address bounds");
+        memcpy(memory + address, data, length);
+    }
+    moved_write += length;
+    writes++;
+}
+
+// Generated by run.sh directly from the maintained C source, without rewriting
+// these functions. This is a focused unit test, not a complete QEMU build.
+#include "dma_run.inc"
+
+static void run_case(unsigned source_width, unsigned destination_width, unsigned units,
+                     unsigned control, bool source_inc, bool destination_inc,
+                     unsigned source_lane, unsigned destination_lane, unsigned fifo_kind)
+{
+    NGageDma state = {0};
+    cases++;
+    sw = source_width;
+    dw = destination_width;
+    si = source_inc;
+    di = destination_inc;
+    kind = fifo_kind;
+    sa = kind == 2 ? 0x0c120624 : 256 + source_lane;
+    da = kind == 1 ? 0x0c120624 : kind == 3 ? 0x0c121208 : 2048 + destination_lane;
+    total = units * (control == 1 ? 2 : di ? sw : dw);
+    reads = writes = moved_read = moved_write = 0;
+    interrupt = 0;
+    for (unsigned i = 0; i < sizeof memory; i++)
+        memory[i] = expected[i] = (i * 29 + cases * 13 + i / 7) % 256;
+    for (unsigned i = 0; i < total; i++)
+        stream[i] = kind == 2 ? (i * 17 + 0x35) % 256 : memory[sa + (si ? i : i % sw)];
+    if (kind != 1 && kind != 3)
+        for (unsigned i = 0; i < total; i += dw)
+            for (unsigned j = 0; j < dw && i+j < total; j++)
+                expected[da + (di ? i : 0) + j] = stream[i+j];
+    state.regs[0][0x08 / 4] = control;
+    state.regs[0][0x14 / 4] = sa;
+    state.regs[0][0x18 / 4] = si ? 4 : 0;
+    state.regs[0][0x1c / 4] = sw * 8;
+    state.regs[0][0x20 / 4] = kind == 1 ? 0x10120624 : kind == 3 ? 0x10121208 : da;
+    state.regs[0][0x24 / 4] = di ? 4 : 0;
+    state.regs[0][0x28 / 4] = dw * 8;
+    state.regs[0][0x2c / 4] = units - 1;
+    dma_run(&state, 0);
+    require(interrupt == 1 && state.regs[0][0x08 / 4] == 0, "terminal state");
+    require(moved_read == total && moved_write == total, "incomplete transfer");
+    require(reads == (total + sw - 1) / sw && writes == (total + dw - 1) / dw,
+            "access count");
+    require(memcmp(memory, expected, sizeof memory) == 0, "destination/tail guards");
+}
+
+int main(int argc, char **argv)
+{
+    int selected = argc > 1 ? atoi(argv[1]) : 0;
+    if (selected == 0 || selected == 1) run_case(4, 4, 5, 1, true, true, 0, 0, 0);
+    if (selected == 0 || selected == 2) run_case(4, 1, 512, 2, true, false, 0, 0, 1);
+    if (selected == 0 || selected == 3) run_case(1, 4, 10, 2, false, true, 0, 0, 2);
+    if (selected == 0 || selected == 4) run_case(4, 4, 7, 2, true, false, 0, 0, 3);
+    if (selected == 0)
+        for (unsigned s = 1; s <= 4; s *= 2)
+            for (unsigned d = 1; d <= 4; d *= 2)
+                for (unsigned count = 1; count <= 9; count++)
+                    for (unsigned sl = 0; sl < 4; sl += s)
+                        for (unsigned dl = 0; dl < 4; dl += d) {
+                            for (unsigned mode = 0; mode < 4; mode++)
+                                run_case(s, d, count, 1, mode & 1, mode & 2, sl, dl, 0);
+                            run_case(s, d, count, 2, true, false, sl, dl, 0);
+                            run_case(s, d, count, 2, false, true, sl, dl, 0);
+                        }
+    printf("PASS donor DMA C count: %u cases, exact read/write extents and memory guards\n", cases);
+    return 0;
+}
diff --git a/sim/dma-count/run.sh b/sim/dma-count/run.sh
new file mode 100755
--- /dev/null
+++ b/sim/dma-count/run.sh
@@ -0,0 +1,25 @@
+#!/bin/sh
+set -eu
+root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+cd "$root"
+out=${DMA_COUNT_OUT:-sim/build/dma-count}
+mkdir -p "$out"
+python3 - "$out/dma_run.inc" <<'PY'
+from pathlib import Path
+import sys
+source = Path('model/hw/ngage_dma.c').read_text()
+start = source.index('static hwaddr dma_phys(')
+end = source.index('static uint64_t dma_read(', start)
+Path(sys.argv[1]).write_text(source[start:end])
+PY
+${CC:-cc} -std=c11 -Wall -Wextra -Werror -I"$out" sim/dma-count/model_test.c -o "$out/model_test"
+iverilog -g2012 -s tb -o "$out/rtl_test" rtl/board/sdp_ram.sv rtl/upp/upp_dma.sv sim/dma-count/tb.v
+if ! "$out/model_test" "${DMA_COUNT_CASE:-0}" > "$out/model.log" 2>&1; then
+    cat "$out/model.log"
+    exit 1
+fi
+if ! vvp "$out/rtl_test" +case="${DMA_COUNT_CASE:-0}" > "$out/rtl.log" 2>&1; then
+    cat "$out/rtl.log"
+    exit 1
+fi
+cat "$out/model.log" "$out/rtl.log"
diff --git a/sim/dma-count/README.md b/sim/dma-count/README.md
new file mode 100644
--- /dev/null
+++ b/sim/dma-count/README.md
@@ -0,0 +1,50 @@
+# DMA count contract regression
+
+From the repository root:
+
+```sh
+make -C sim dma-count
+```
+
+Requirements: Python 3, a C11 compiler, and Icarus Verilog. The imported DMA
+and RAM are compiled in SystemVerilog mode; `tb.v` uses Verilog-2001 syntax.
+Output is under `sim/build/dma-count/`. `DMA_COUNT_OUT` selects another output
+directory, relative to the repository root. `DMA_COUNT_CASE=1`, `2`, `3` or
+`4` selects one directed case instead of the complete matrix.
+
+The count register has two contracts, independent of memory access width:
+
+| Control | Total bytes |
+| --- | --- |
+| 1, memory-to-memory | `(raw_count + 1) * 2` |
+| 2, paced TX to a fixed destination | `(raw_count + 1) * destination_width_bytes` |
+| 2, paced RX from a fixed source | `(raw_count + 1) * source_width_bytes` |
+
+The directed cases are a 10-byte 32-to-32 M2M copy (raw count 4), 512-byte
+32-to-8 MMC TX (raw count 511), 10-byte 8-to-32 MMC RX (raw count 9), and
+seven 32-bit LCD FIFO words (raw count 6). The original source-unit-count
+implementation fails the first two by reading beyond the requested budget;
+the RX and LCD cases retain their original byte counts.
+
+The full 2,650-case matrix includes all nine native width combinations,
+every naturally aligned lane, fixed/incrementing M2M modes and both paced
+directions, with 1 through 9 count units. A byte oracle independently derives
+all source bytes, source/destination address sequences, exact access sizes or
+lane masks, FIFO output and complete destination memory plus untouched guards.
+This catches undercopy, overcopy, source overread and final partial units.
+The RTL bench also stalls responses and paced endpoints, checks immutable
+held bus packets and observes completion/acknowledgment.
+
+`model_test.c` executes the actual `dma_phys()`, `width_bytes()` and `dma_run()`
+functions extracted verbatim from `model/hw/ngage_dma.c` at test time. It
+stubs QEMU allocation, memory and IRQ dependencies. It does not rebuild or
+boot QEMU. The full peripheral regression remains `make -C sim periph`,
+including real SDRAM/card models, simultaneous channels, CPU traffic, stop,
+LCD and MMC paths. Its M2M setup counts halfwords and MMC phases count fixed
+FIFO bytes regardless of SDRAM width.
+
+Evidence: original NEM-4 DMA code shifts the byte argument right by one at
+`0x50321424` for M2M, and by the peripheral table shift at `0x503215C4` for
+paced transfers. These are software contract observations; exact physical
+UPP timing and error status remain unverified. This change does not alter
+the donor's existing bus-error handling, address aliases or IRQ map.
