 .PHONY: test $(BENCHES) coreboot flashcopy hps-read-test clean
 
@@ -283,3 +283,7 @@ phoenix: $(BUILD)/phoenix/Vphoenix_load | $(OUT)
 	cd $(ROOT) && $<
 phoenix-real: $(BUILD)/phoenix/Vphoenix_load | $(OUT)
